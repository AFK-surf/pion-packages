///| W3C Content Security Policy Level 3 (CSP3) parser, serializer, and evaluator.
///| Built on `packages/url` (pure-Pion WHATWG URL Standard) for spec-compliant URL,
///| host, port, and path normalization. Zero `extern "C"`, zero `World` dependency.

import "url"

// ============================================================================
// Internal ASCII / String Helpers (Low-Allocation Hot Paths)
// ============================================================================

#verify
pub fn csp_is_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 12
}

#verify
pub fn csp_is_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

#verify
pub fn csp_is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn csp_ascii_lower(s : String) -> String {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      let mut out = Bytes::new(n)
      let mut j = 0
      while j < i {
        out[j] = (s.code_unit_at(j) & 0xFF).to_byte()
        j = j + 1
      }
      while j < n {
        let ch = s.code_unit_at(j)
        if ch >= 65 && ch <= 90 {
          out[j] = (ch + 32).to_byte()
        } else {
          out[j] = (ch & 0xFF).to_byte()
        }
        j = j + 1
      }
      return out.to_string()
    }
    i = i + 1
  }
  s
}

fn csp_ascii_lower_slice(s : String, start : Int, end : Int) -> String {
  let len = end - start
  if len <= 0 {
    return ""
  }
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      let mut out = Bytes::new(len)
      let mut j = start
      while j < i {
        out[j - start] = (s.code_unit_at(j) & 0xFF).to_byte()
        j = j + 1
      }
      while j < end {
        let ch = s.code_unit_at(j)
        if ch >= 65 && ch <= 90 {
          out[j - start] = (ch + 32).to_byte()
        } else {
          out[j - start] = (ch & 0xFF).to_byte()
        }
        j = j + 1
      }
      return out.to_string()
    }
    i = i + 1
  }
  if start == 0 && end == s.length() {
    s
  } else {
    s.slice(start, end)
  }
}

fn csp_eq_ascii_ci(s : String, start : Int, end : Int, lower_lit : String) -> Bool {
  let len = end - start
  if len != lower_lit.length() {
    return false
  }
  let mut i = 0
  while i < len {
    let mut c = s.code_unit_at(start + i)
    if c >= 65 && c <= 90 {
      c = c + 32
    }
    if c != lower_lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn csp_starts_with_ascii_ci(s : String, lower_prefix : String) -> Bool {
  let plen = lower_prefix.length()
  if s.length() < plen {
    return false
  }
  let mut i = 0
  while i < plen {
    let mut c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      c = c + 32
    }
    if c != lower_prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn csp_intern_scheme_slice(s : String, start : Int, end : Int, has_upper : Bool) -> String {
  let len = end - start
  if len == 5 && csp_eq_ascii_ci(s, start, end, "https") {
    return "https"
  }
  if len == 4 {
    if csp_eq_ascii_ci(s, start, end, "http") {
      return "http"
    }
    if csp_eq_ascii_ci(s, start, end, "data") {
      return "data"
    }
    if csp_eq_ascii_ci(s, start, end, "blob") {
      return "blob"
    }
  }
  if len == 3 && csp_eq_ascii_ci(s, start, end, "wss") {
    return "wss"
  }
  if len == 2 && csp_eq_ascii_ci(s, start, end, "ws") {
    return "ws"
  }
  if !has_upper {
    s.slice(start, end)
  } else {
    csp_ascii_lower_slice(s, start, end)
  }
}

fn csp_find_byte(s : String, ch : Int, from : Int, end : Int) -> Int {
  let mut i = from
  while i < end {
    if s.code_unit_at(i) == ch {
      return i
    }
    i = i + 1
  }
  -1
}

fn csp_find_scheme_sep(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  while i + 2 < n {
    if s.code_unit_at(i) == 58 &&
    s.code_unit_at(i + 1) == 47 &&
    s.code_unit_at(i + 2) == 47 {
      return i
    }
    i = i + 1
  }
  -1
}

#verify
pub fn csp_port_step(acc : Int, c : Int) -> Int {
  if c < 48 || c > 57 {
    -1
  } else {
    let next = acc * 10 + (c - 48)
    if next > 65535 {
      -1
    } else {
      next
    }
  }
}

fn csp_parse_port_slice(s : String, start : Int, end : Int) -> Int {
  if start >= end {
    return -1
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let next = csp_port_step(acc, s.code_unit_at(i))
    if next < 0 {
      return -1
    }
    acc = next
    i = i + 1
  }
  acc
}

fn csp_is_valid_scheme(s : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  if !csp_is_alpha(s.code_unit_at(start)) {
    return false
  }
  let mut i = start + 1
  while i < end {
    let c = s.code_unit_at(i)
    if !csp_is_alpha(c) && !csp_is_digit(c) && c != 43 && c != 45 && c != 46 {
      return false
    }
    i = i + 1
  }
  true
}

fn csp_is_valid_host_part(host : String) -> Bool {
  let n = host.length()
  if n == 0 {
    return false
  }
  if host == "*" {
    return true
  }
  // IPv6 literal: [hex/colon/dot]
  if host.code_unit_at(0) == 91 {
    if n < 3 || host.code_unit_at(n - 1) != 93 {
      return false
    }
    let mut i = 1
    while i < n - 1 {
      let c = host.code_unit_at(i)
      let ok = (c >= 48 && c <= 57) ||
      (c >= 65 && c <= 70) ||
      (c >= 97 && c <= 102) ||
      c == 58 ||
      c == 46
      if !ok {
        return false
      }
      i = i + 1
    }
    return true
  }
  // Optional wildcard subdomain prefix "*."
  let mut start = 0
  if n >= 2 && host.code_unit_at(0) == 42 {
    if host.code_unit_at(1) != 46 || n == 2 {
      return false
    }
    start = 2
  }
  let mut i = start
  while i < n {
    let c = host.code_unit_at(i)
    // Valid domain / IPv4 chars: a-z, A-Z, 0-9, '-', '.'
    let ok = csp_is_alpha(c) || csp_is_digit(c) || c == 45 || c == 46
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

fn csp_is_ascii_token(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c > 127 {
      return false
    }
    i = i + 1
  }
  true
}

#verify
pub fn csp_is_safe_serialized_byte(c : Int) -> Bool {
  !(c <= 32 || c >= 127 || c == 59 || c == 44)
}

fn csp_is_safe_serialized_token(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    // Reject controls, whitespace, DEL, non-ASCII, ';', ','
    if !csp_is_safe_serialized_byte(c) {
      return false
    }
    i = i + 1
  }
  true
}

#verify
pub fn csp_is_safe_directive_byte(c : Int) -> Bool {
  csp_is_alpha(c) || csp_is_digit(c) || c == 45
}

fn csp_is_safe_directive_name(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if !csp_is_safe_directive_byte(c) {
      return false
    }
    i = i + 1
  }
  true
}

fn csp_default_port(scheme : String) -> Int {
  if scheme == "http" || scheme == "ws" {
    80
  } else if scheme == "https" || scheme == "wss" {
    443
  } else if scheme == "ftp" {
    21
  } else {
    -1
  }
}

// ============================================================================
// Limits & Header Validation
// ============================================================================

fn validate_limits(limits : ParseLimits) -> Result[Unit, CspError] {
  if parse_limits_all_nonneg(limits) {
    return Result::Ok(())
  }
  if limits.max_header_bytes < 0 {
    return Result::Err(CspError::InvalidLimits("max_header_bytes must be >= 0"))
  }
  if limits.max_policies < 0 {
    return Result::Err(CspError::InvalidLimits("max_policies must be >= 0"))
  }
  if limits.max_directives_per_policy < 0 {
    return Result::Err(
      CspError::InvalidLimits("max_directives_per_policy must be >= 0"),
    )
  }
  if limits.max_sources_per_directive < 0 {
    return Result::Err(
      CspError::InvalidLimits("max_sources_per_directive must be >= 0"),
    )
  }
  Result::Ok(())
}

///| Pure byte predicate for illegal HTTP header injection / C0 control bytes.
#verify
pub fn csp_is_illegal_header_byte(c : Int) -> Bool {
  c == 0 || c == 10 || c == 13 || c == 127 || (c < 32 && c != 9 && c != 12)
}

///| Reject HTTP header injection / C0 control bytes (NUL, CR, LF, VT, DEL, etc.).
///| Non-ASCII bytes (> 0x7F) are NOT fatal here: per W3C CSP3 §2.2.1 step 2.1,
///| individual non-ASCII tokens are skipped so strict directives are preserved.
fn validate_header_control_chars(header : String) -> Result[Unit, CspError] {
  let n = header.length()
  let mut i = 0
  while i < n {
    let c = header.code_unit_at(i)
    if c < 32 || c == 127 {
      if csp_is_illegal_header_byte(c) {
        return Result::Err(
          CspError::InvalidHeader(
            "illegal control byte " + c.to_string() + " at offset " + i.to_string(),
          ),
        )
      }
    }
    i = i + 1
  }
  Result::Ok(())
}

fn validate_header_control_chars_and_comma(header : String) -> Result[Int, CspError] {
  let n = header.length()
  let mut first_comma = -1
  let mut i = 0
  while i < n {
    let c = header.code_unit_at(i)
    if c < 32 || c == 127 {
      if csp_is_illegal_header_byte(c) {
        return Result::Err(
          CspError::InvalidHeader(
            "illegal control byte " + c.to_string() + " at offset " + i.to_string(),
          ),
        )
      }
    } else if c == 44 && first_comma < 0 {
      first_comma = i
    }
    i = i + 1
  }
  Result::Ok(first_comma)
}

// ============================================================================
// Source Expression Parsing & Formatting
// ============================================================================

///| Format a `SourceExpression` into its canonical W3C CSP3 string representation.
pub fn format_source_expression(expr : SourceExpression) -> String {
  match expr {
    SourceExpression::NoneExpr => "'none'"
    SourceExpression::SelfExpr => "'self'"
    SourceExpression::UnsafeInline => "'unsafe-inline'"
    SourceExpression::UnsafeEval => "'unsafe-eval'"
    SourceExpression::StrictDynamic => "'strict-dynamic'"
    SourceExpression::UnsafeHashes => "'unsafe-hashes'"
    SourceExpression::WasmUnsafeEval => "'wasm-unsafe-eval'"
    SourceExpression::ReportSample => "'report-sample'"
    SourceExpression::Nonce(v) => "'nonce-" + v + "'"
    SourceExpression::Hash(alg, v) => "'" + alg + "-" + v + "'"
    SourceExpression::Scheme(sch) => sch + ":"
    SourceExpression::Host(opt_scheme, host, opt_port, port_wild, path) => {
      if !port_wild && path.length() == 0 {
        match opt_port {
          Option::None =>
          match opt_scheme {
            Option::None => return host
            Option::Some(sch) => {
              if sch == "https" {
                return "https://" + host
              } else if sch == "http" {
                return "http://" + host
              } else if sch == "wss" {
                return "wss://" + host
              } else if sch == "ws" {
                return "ws://" + host
              }
            }
          }
          Option::Some(_) => ()
        }
      }
      let sb = StringBuilder::new()
      match opt_scheme {
        Option::Some(sch) => {
          sb.write_string(sch)
          sb.write_string("://")
        }
        Option::None => ()
      }
      sb.write_string(host)
      if port_wild {
        sb.write_string(":*")
      } else {
        match opt_port {
          Option::Some(p) => {
            sb.write_string(":")
            sb.write_string(p.to_string())
          }
          Option::None => ()
        }
      }
      if path.length() > 0 {
        sb.write_string(path)
      }
      sb.to_string()
    }
  }
}

fn csp_validate_host_slice(s : String, start : Int, end : Int) -> Bool {
  let n = end - start
  if n <= 0 {
    return false
  }
  if n == 1 && s.code_unit_at(start) == 42 {
    return true
  }
  // IPv6 literal: [hex/colon/dot]
  if s.code_unit_at(start) == 91 {
    if n < 3 || s.code_unit_at(end - 1) != 93 {
      return false
    }
    let mut i = start + 1
    while i < end - 1 {
      let c = s.code_unit_at(i)
      let ok = (c >= 48 && c <= 57) ||
      (c >= 65 && c <= 70) ||
      (c >= 97 && c <= 102) ||
      c == 58 ||
      c == 46
      if !ok {
        return false
      }
      i = i + 1
    }
    return true
  }
  let mut i = start
  if n >= 2 && s.code_unit_at(start) == 42 {
    if s.code_unit_at(start + 1) != 46 || n == 2 {
      return false
    }
    i = start + 2
  }
  while i < end {
    let c = s.code_unit_at(i)
    if !((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 46) {
      return false
    }
    i = i + 1
  }
  true
}

fn parse_source_expression_slice(
  s : String,
  start : Int,
  end : Int,
  has_upper : Bool,
  raw_tok : String,
) -> Option[SourceExpression] {
  let n = end - start
  if n <= 0 {
    return Option::None
  }
  let c0 = s.code_unit_at(start)
  // Quoted keywords, nonces, and hashes
  if c0 == 39 {
    if n < 2 || s.code_unit_at(end - 1) != 39 {
      return Option::None
    }
    if n == 6 {
      if !has_upper {
        if raw_tok == "'self'" {
          return Option::Some(SourceExpression::SelfExpr)
        }
        if raw_tok == "'none'" {
          return Option::Some(SourceExpression::NoneExpr)
        }
      } else {
        if csp_eq_ascii_ci(s, start, end, "'self'") {
          return Option::Some(SourceExpression::SelfExpr)
        }
        if csp_eq_ascii_ci(s, start, end, "'none'") {
          return Option::Some(SourceExpression::NoneExpr)
        }
      }
      return Option::None
    }
    if n == 15 {
      if !has_upper {
        if raw_tok == "'unsafe-inline'" {
          return Option::Some(SourceExpression::UnsafeInline)
        }
        if raw_tok == "'unsafe-hashes'" {
          return Option::Some(SourceExpression::UnsafeHashes)
        }
        if raw_tok == "'report-sample'" {
          return Option::Some(SourceExpression::ReportSample)
        }
      } else {
        if csp_eq_ascii_ci(s, start, end, "'unsafe-inline'") {
          return Option::Some(SourceExpression::UnsafeInline)
        }
        if csp_eq_ascii_ci(s, start, end, "'unsafe-hashes'") {
          return Option::Some(SourceExpression::UnsafeHashes)
        }
        if csp_eq_ascii_ci(s, start, end, "'report-sample'") {
          return Option::Some(SourceExpression::ReportSample)
        }
      }
    } else if n == 16 {
      if (!has_upper && raw_tok == "'strict-dynamic'") ||
      (has_upper && csp_eq_ascii_ci(s, start, end, "'strict-dynamic'")) {
        return Option::Some(SourceExpression::StrictDynamic)
      }
    } else if n == 13 {
      if (!has_upper && raw_tok == "'unsafe-eval'") ||
      (has_upper && csp_eq_ascii_ci(s, start, end, "'unsafe-eval'")) {
        return Option::Some(SourceExpression::UnsafeEval)
      }
    } else if n == 18 {
      if (!has_upper && raw_tok == "'wasm-unsafe-eval'") ||
      (has_upper && csp_eq_ascii_ci(s, start, end, "'wasm-unsafe-eval'")) {
        return Option::Some(SourceExpression::WasmUnsafeEval)
      }
    }
    if n > 8 && csp_eq_ascii_ci(s, start, start + 7, "'nonce-") {
      return Option::Some(SourceExpression::Nonce(s.slice(start + 7, end - 1)))
    }
    if n > 9 {
      if csp_eq_ascii_ci(s, start, start + 8, "'sha256-") {
        return Option::Some(SourceExpression::Hash("sha256", s.slice(start + 8, end - 1)))
      }
      if csp_eq_ascii_ci(s, start, start + 8, "'sha384-") {
        return Option::Some(SourceExpression::Hash("sha384", s.slice(start + 8, end - 1)))
      }
      if csp_eq_ascii_ci(s, start, start + 8, "'sha512-") {
        return Option::Some(SourceExpression::Hash("sha512", s.slice(start + 8, end - 1)))
      }
    }
    return Option::None
  }

  // Bare wildcard '*'
  if n == 1 && c0 == 42 {
    return Option::Some(
      SourceExpression::Host(Option::None, "*", Option::None, false, ""),
    )
  }

  // Fast scheme-source check for common lowercase schemes ("data:", "blob:", "https:", "http:")
  if !has_upper && s.code_unit_at(end - 1) == 58 {
    if n == 5 {
      if raw_tok == "data:" {
        return Option::Some(SourceExpression::Scheme("data"))
      }
      if raw_tok == "blob:" {
        return Option::Some(SourceExpression::Scheme("blob"))
      }
      if raw_tok == "http:" {
        return Option::Some(SourceExpression::Scheme("http"))
      }
    } else if n == 6 && raw_tok == "https:" {
      return Option::Some(SourceExpression::Scheme("https"))
    }
  }

  // Fast scheme prefix check for "https://", "http://", "wss://", "ws://"
  let mut opt_scheme : Option[String] = Option::None
  let mut rest_start = start
  let mut fast_scheme = false
  if !has_upper {
    if c0 == 104 && n >= 8 && s.code_unit_at(start + 1) == 116 &&
    s.code_unit_at(start + 2) == 116 && s.code_unit_at(start + 3) == 112 {
      if n > 8 && s.code_unit_at(start + 4) == 115 && s.code_unit_at(start + 5) == 58 &&
      s.code_unit_at(start + 6) == 47 && s.code_unit_at(start + 7) == 47 {
        opt_scheme = Option::Some("https")
        rest_start = start + 8
        fast_scheme = true
      } else if s.code_unit_at(start + 4) == 58 && s.code_unit_at(start + 5) == 47 &&
      s.code_unit_at(start + 6) == 47 {
        opt_scheme = Option::Some("http")
        rest_start = start + 7
        fast_scheme = true
      }
    } else if c0 == 119 && n >= 6 && s.code_unit_at(start + 1) == 115 {
      if n > 6 && s.code_unit_at(start + 2) == 115 && s.code_unit_at(start + 3) == 58 &&
      s.code_unit_at(start + 4) == 47 && s.code_unit_at(start + 5) == 47 {
        opt_scheme = Option::Some("wss")
        rest_start = start + 6
        fast_scheme = true
      } else if s.code_unit_at(start + 2) == 58 && s.code_unit_at(start + 3) == 47 &&
      s.code_unit_at(start + 4) == 47 {
        opt_scheme = Option::Some("ws")
        rest_start = start + 5
        fast_scheme = true
      }
    }
  }

  let mut first_slash = -1
  let mut host_colon = -1
  let mut host_valid_fast = true
  if fast_scheme {
    // Single-pass scan over host[:port][/path] after known scheme://
    let mut i = rest_start
    if i < end && s.code_unit_at(i) == 91 {
      host_valid_fast = false
    } else if i + 1 < end && s.code_unit_at(i) == 42 {
      if s.code_unit_at(i + 1) != 46 || i + 2 >= end {
        host_valid_fast = false
      } else {
        i = i + 2
      }
    }
    while i < end {
      let c = s.code_unit_at(i)
      if c == 44 {
        return Option::None
      }
      if first_slash < 0 {
        if c == 47 {
          first_slash = i
        } else if c == 58 {
          if host_colon < 0 {
            host_colon = i
          }
        } else if host_colon < 0 {
          if !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46) {
            host_valid_fast = false
          }
        }
      }
      i = i + 1
    }
  } else {
    // General single-pass scan for ',', first '://', first '/'
    let mut sep = -1
    let mut i = start
    while i < end {
      let c = s.code_unit_at(i)
      if c == 44 {
        return Option::None
      }
      if c == 58 && sep < 0 && first_slash < 0 && i + 2 < end &&
      s.code_unit_at(i + 1) == 47 && s.code_unit_at(i + 2) == 47 {
        sep = i
        i = i + 3
        continue
      }
      if c == 47 && first_slash < 0 {
        first_slash = i
      }
      i = i + 1
    }
    // Scheme-source: e.g. "https:", "data:", "blob:", "mediastream:"
    if s.code_unit_at(end - 1) == 58 && first_slash < 0 && sep < 0 {
      if csp_is_valid_scheme(s, start, end - 1) {
        return Option::Some(
          SourceExpression::Scheme(csp_intern_scheme_slice(s, start, end - 1, has_upper)),
        )
      }
      return Option::None
    }
    if sep >= 0 {
      if !csp_is_valid_scheme(s, start, sep) {
        return Option::None
      }
      opt_scheme = Option::Some(csp_intern_scheme_slice(s, start, sep, has_upper))
      rest_start = sep + 3
    }
    host_valid_fast = false
  }

  if rest_start >= end {
    return Option::None
  }

  // Split path (and strip query/fragment per CSP3 §6.7.2.4)
  let slash = first_slash
  let hostport_end = if slash >= 0 { slash } else { end }
  let mut path = ""
  if slash >= 0 {
    let mut path_end = end
    let mut pi = slash
    while pi < end {
      let pc = s.code_unit_at(pi)
      if pc == 63 || pc == 35 {
        path_end = pi
        break
      }
      pi = pi + 1
    }
    path = s.slice(slash, path_end)
  }

  // Parse host and optional port (supporting IPv6 bracketed hosts)
  if rest_start >= hostport_end {
    return Option::None
  }
  let host_start = rest_start
  let mut host_end = hostport_end
  let mut opt_port : Option[Int] = Option::None
  let mut port_wild = false

  if s.code_unit_at(rest_start) == 91 {
    // IPv6 literal [addr]
    let rb = csp_find_byte(s, 93, rest_start + 1, hostport_end)
    if rb < 0 {
      return Option::None
    }
    host_end = rb + 1
    if rb + 1 < hostport_end {
      if s.code_unit_at(rb + 1) != 58 {
        return Option::None
      }
      let pstart = rb + 2
      if pstart + 1 == hostport_end && s.code_unit_at(pstart) == 42 {
        port_wild = true
      } else {
        let p = csp_parse_port_slice(s, pstart, hostport_end)
        if p < 0 {
          return Option::None
        }
        opt_port = Option::Some(p)
      }
    }
  } else {
    let colon = if fast_scheme {
      host_colon
    } else {
      csp_find_byte(s, 58, rest_start, hostport_end)
    }
    if colon >= 0 {
      host_end = colon
      let pstart = colon + 1
      if pstart + 1 == hostport_end && s.code_unit_at(pstart) == 42 {
        port_wild = true
      } else {
        let p = csp_parse_port_slice(s, pstart, hostport_end)
        if p < 0 {
          return Option::None
        }
        opt_port = Option::Some(p)
      }
    }
  }

  if !(fast_scheme && host_valid_fast && host_end > host_start) {
    if !csp_validate_host_slice(s, host_start, host_end) {
      return Option::None
    }
  }
  let host = if !has_upper && host_start == start && host_end == end {
    raw_tok
  } else if !has_upper {
    s.slice(host_start, host_end)
  } else {
    csp_ascii_lower_slice(s, host_start, host_end)
  }
  Option::Some(SourceExpression::Host(opt_scheme, host, opt_port, port_wild, path))
}

fn csp_intern_common_raw_token(s : String, start : Int, end : Int) -> String {
  let n = end - start
  let c0 = s.code_unit_at(start)
  if c0 == 39 {
    if n == 6 {
      if csp_slice_eq(s, start, end, "'self'", 0, 6) {
        return "'self'"
      }
      if csp_slice_eq(s, start, end, "'none'", 0, 6) {
        return "'none'"
      }
    } else if n == 15 {
      if csp_slice_eq(s, start, end, "'unsafe-inline'", 0, 15) {
        return "'unsafe-inline'"
      }
      if csp_slice_eq(s, start, end, "'unsafe-hashes'", 0, 15) {
        return "'unsafe-hashes'"
      }
      if csp_slice_eq(s, start, end, "'report-sample'", 0, 15) {
        return "'report-sample'"
      }
    } else if n == 16 && csp_slice_eq(s, start, end, "'strict-dynamic'", 0, 16) {
      return "'strict-dynamic'"
    } else if n == 13 && csp_slice_eq(s, start, end, "'unsafe-eval'", 0, 13) {
      return "'unsafe-eval'"
    } else if n == 18 && csp_slice_eq(s, start, end, "'wasm-unsafe-eval'", 0, 18) {
      return "'wasm-unsafe-eval'"
    }
  } else if n == 5 {
    if c0 == 100 && csp_slice_eq(s, start, end, "data:", 0, 5) {
      return "data:"
    }
    if c0 == 98 && csp_slice_eq(s, start, end, "blob:", 0, 5) {
      return "blob:"
    }
    if c0 == 104 && csp_slice_eq(s, start, end, "http:", 0, 5) {
      return "http:"
    }
  } else if n == 6 && c0 == 104 && csp_slice_eq(s, start, end, "https:", 0, 6) {
    return "https:"
  } else if n == 1 && c0 == 42 {
    return "*"
  }
  s.slice(start, end)
}

// ============================================================================
// CSP Parsing & Serialization
// ============================================================================

val struct InternedDir {
  id : Int
  name : String
  parse_sources : Bool
}

fn csp_intern_directive(header : String, start : Int, end : Int, has_upper : Bool) -> InternedDir {
  let n = end - start
  let c0 = header.code_unit_at(start)
  let l0 = if c0 >= 65 && c0 <= 90 { c0 + 32 } else { c0 }
  if n == 11 {
    if l0 == 100 && csp_eq_ascii_ci(header, start, end, "default-src") {
      return InternedDir::{ id: 0, name: "default-src", parse_sources: true }
    }
    if l0 == 99 && csp_eq_ascii_ci(header, start, end, "connect-src") {
      return InternedDir::{ id: 4, name: "connect-src", parse_sources: true }
    }
    if l0 == 102 && csp_eq_ascii_ci(header, start, end, "form-action") {
      return InternedDir::{ id: 12, name: "form-action", parse_sources: true }
    }
  } else if n == 10 {
    if l0 == 115 && csp_eq_ascii_ci(header, start, end, "script-src") {
      return InternedDir::{ id: 1, name: "script-src", parse_sources: true }
    }
    if l0 == 111 && csp_eq_ascii_ci(header, start, end, "object-src") {
      return InternedDir::{ id: 8, name: "object-src", parse_sources: true }
    }
    if l0 == 119 && csp_eq_ascii_ci(header, start, end, "worker-src") {
      return InternedDir::{ id: 9, name: "worker-src", parse_sources: true }
    }
    if l0 == 114 && csp_eq_ascii_ci(header, start, end, "report-uri") {
      return InternedDir::{ id: 18, name: "report-uri", parse_sources: false }
    }
  } else if n == 9 {
    if l0 == 115 && csp_eq_ascii_ci(header, start, end, "style-src") {
      return InternedDir::{ id: 2, name: "style-src", parse_sources: true }
    }
    if l0 == 102 && csp_eq_ascii_ci(header, start, end, "frame-src") {
      return InternedDir::{ id: 6, name: "frame-src", parse_sources: true }
    }
    if l0 == 109 && csp_eq_ascii_ci(header, start, end, "media-src") {
      return InternedDir::{ id: 7, name: "media-src", parse_sources: true }
    }
    if l0 == 99 && csp_eq_ascii_ci(header, start, end, "child-src") {
      return InternedDir::{ id: 10, name: "child-src", parse_sources: true }
    }
    if l0 == 114 && csp_eq_ascii_ci(header, start, end, "report-to") {
      return InternedDir::{ id: 19, name: "report-to", parse_sources: false }
    }
  } else if n == 8 {
    if l0 == 102 && csp_eq_ascii_ci(header, start, end, "font-src") {
      return InternedDir::{ id: 5, name: "font-src", parse_sources: true }
    }
    if l0 == 98 && csp_eq_ascii_ci(header, start, end, "base-uri") {
      return InternedDir::{ id: 11, name: "base-uri", parse_sources: true }
    }
  } else if n == 7 {
    if l0 == 105 && csp_eq_ascii_ci(header, start, end, "img-src") {
      return InternedDir::{ id: 3, name: "img-src", parse_sources: true }
    }
    if l0 == 115 && csp_eq_ascii_ci(header, start, end, "sandbox") {
      return InternedDir::{ id: 17, name: "sandbox", parse_sources: false }
    }
  } else if n == 15 {
    if l0 == 102 && csp_eq_ascii_ci(header, start, end, "frame-ancestors") {
      return InternedDir::{ id: 13, name: "frame-ancestors", parse_sources: true }
    }
    if l0 == 115 {
      if csp_eq_ascii_ci(header, start, end, "script-src-elem") {
        return InternedDir::{ id: 20, name: "script-src-elem", parse_sources: true }
      }
      if csp_eq_ascii_ci(header, start, end, "script-src-attr") {
        return InternedDir::{ id: 21, name: "script-src-attr", parse_sources: true }
      }
    }
  } else if n == 12 && l0 == 109 && csp_eq_ascii_ci(header, start, end, "manifest-src") {
    return InternedDir::{ id: 14, name: "manifest-src", parse_sources: true }
  } else if n == 25 && l0 == 117 && csp_eq_ascii_ci(header, start, end, "upgrade-insecure-requests") {
    return InternedDir::{ id: 15, name: "upgrade-insecure-requests", parse_sources: false }
  } else if n == 23 && l0 == 98 && csp_eq_ascii_ci(header, start, end, "block-all-mixed-content") {
    return InternedDir::{ id: 16, name: "block-all-mixed-content", parse_sources: false }
  } else if n == 14 && l0 == 115 {
    if csp_eq_ascii_ci(header, start, end, "style-src-elem") {
      return InternedDir::{ id: 22, name: "style-src-elem", parse_sources: true }
    }
    if csp_eq_ascii_ci(header, start, end, "style-src-attr") {
      return InternedDir::{ id: 23, name: "style-src-attr", parse_sources: true }
    }
  } else if n == 16 && l0 == 102 && csp_eq_ascii_ci(header, start, end, "fenced-frame-src") {
    return InternedDir::{ id: 24, name: "fenced-frame-src", parse_sources: true }
  }
  let name = if has_upper {
    csp_ascii_lower_slice(header, start, end)
  } else {
    header.slice(start, end)
  }
  InternedDir::{ id: -1, name: name, parse_sources: is_source_list_directive(name) }
}

fn is_source_list_directive(name : String) -> Bool {
  let n = name.length()
  if n == 0 {
    return true
  }
  let c0 = name.code_unit_at(0)
  if c0 == 117 {
    return name != "upgrade-insecure-requests"
  }
  if c0 == 98 {
    return name != "block-all-mixed-content"
  }
  if c0 == 115 {
    return name != "sandbox"
  }
  if c0 == 114 {
    return name != "report-uri" && name != "report-to" && name != "require-trusted-types-for"
  }
  if c0 == 116 {
    return name != "trusted-types"
  }
  true
}

fn parse_single_policy_slice(
  header : String,
  seg_start : Int,
  seg_end : Int,
  limits : ParseLimits,
) -> Result[CspPolicy, CspError] {
  let dirs : Array[CspDirective] = []
  let mut seen_mask = 0
  let mut seen_dirs : Option[Map[String, Bool]] = Option::None
  let mut upgrade_insecure = false
  let mut block_mixed = false
  let mut sandbox_tokens : Option[Array[String]] = Option::None
  let mut report_uri : Array[String] = []
  let mut report_to : Option[String] = Option::None

  let mut dir_seen_count = 0
  let mut pos = seg_start
  while pos < seg_end {
    let semi = csp_find_byte(header, 59, pos, seg_end)
    let part_end = if semi >= 0 { semi } else { seg_end }
    let mut a = pos
    let mut b = part_end
    while a < b && csp_is_ws(header.code_unit_at(a)) {
      a = a + 1
    }
    while b > a && csp_is_ws(header.code_unit_at(b - 1)) {
      b = b - 1
    }
    pos = if semi >= 0 { semi + 1 } else { seg_end }
    if a >= b {
      continue
    }

    dir_seen_count = dir_seen_count + 1
    if dir_seen_count > limits.max_directives_per_policy {
      return Result::Err(
        CspError::LimitExceeded(
          "directive count exceeds max_directives_per_policy (" +
          limits.max_directives_per_policy.to_string() + ")",
        ),
      )
    }

    // Extract directive name (first whitespace-delimited token) in a single pass
    let mut name_end = a
    let mut name_non_ascii = false
    let mut name_has_upper = false
    while name_end < b {
      let nc = header.code_unit_at(name_end)
      if csp_is_ws(nc) {
        break
      }
      if nc > 127 {
        name_non_ascii = true
      } else if nc >= 65 && nc <= 90 {
        name_has_upper = true
      }
      name_end = name_end + 1
    }
    // W3C CSP3 §2.2.1 step 2.1: skip directives with non-ASCII directive names
    if name_non_ascii {
      continue
    }
    let interned = csp_intern_directive(header, a, name_end, name_has_upper)
    let name = interned.name

    // W3C CSP3 §2.2.1: duplicate directive within same policy is ignored (first wins).
    // O(1) bitmask for all 25 standard directives; lazy Map for unknown/large directive sets.
    if interned.id >= 0 {
      let bit = 1 << interned.id
      if (seen_mask & bit) != 0 {
        continue
      }
      seen_mask = seen_mask | bit
    } else {
      let mut is_dup = false
      match seen_dirs {
        Option::Some(m) => {
          if m.contains(name) {
            is_dup = true
          } else {
            m.set(name, true)
          }
        }
        Option::None => {
          let mut di = 0
          let dn = dirs.length()
          while di < dn {
            if dirs[di].name == name {
              is_dup = true
              break
            }
            di = di + 1
          }
          if !is_dup && dn >= 24 {
            let m : Map[String, Bool] = Map::new()
            let mut mi = 0
            while mi < dn {
              m.set(dirs[mi].name, true)
              mi = mi + 1
            }
            m.set(name, true)
            seen_dirs = Option::Some(m)
          }
        }
      }
      if is_dup {
        continue
      }
    }

    let sources : Array[SourceExpression] = []
    let raw_values : Array[String] = []
    let parse_sources = interned.parse_sources

    let mut cur = name_end
    let mut src_count = 0
    while cur < b {
      while cur < b && csp_is_ws(header.code_unit_at(cur)) {
        cur = cur + 1
      }
      if cur >= b {
        break
      }
      let tok_start = cur
      let mut tok_non_ascii = false
      let mut tok_has_upper = false
      while cur < b {
        let tc = header.code_unit_at(cur)
        if csp_is_ws(tc) {
          break
        }
        if tc > 127 {
          tok_non_ascii = true
        } else if tc >= 65 && tc <= 90 {
          tok_has_upper = true
        }
        cur = cur + 1
      }
      src_count = src_count + 1
      if src_count > limits.max_sources_per_directive {
        return Result::Err(
          CspError::LimitExceeded(
            "source count in '" + name + "' exceeds max_sources_per_directive (" +
            limits.max_sources_per_directive.to_string() + ")",
          ),
        )
      }
      // W3C CSP3 §2.2.1 step 2.1: skip non-ASCII tokens without aborting the policy
      if tok_non_ascii {
        continue
      }
      let raw_tok = if !tok_has_upper {
        csp_intern_common_raw_token(header, tok_start, cur)
      } else {
        header.slice(tok_start, cur)
      }
      raw_values.push(raw_tok)
      if parse_sources {
        match parse_source_expression_slice(header, tok_start, cur, tok_has_upper, raw_tok) {
          Option::Some(expr) => sources.push(expr)
          Option::None => ()
        }
      }
    }

    if !parse_sources {
      if interned.id == 15 {
        upgrade_insecure = true
      } else if interned.id == 16 {
        block_mixed = true
      } else if interned.id == 17 {
        let toks : Array[String] = []
        let mut k = 0
        while k < raw_values.length() {
          toks.push(csp_ascii_lower(raw_values[k]))
          k = k + 1
        }
        sandbox_tokens = Option::Some(toks)
      } else if interned.id == 18 {
        report_uri = raw_values
      } else if interned.id == 19 {
        if raw_values.length() > 0 {
          report_to = Option::Some(raw_values[0])
        }
      }
    }

    dirs.push(CspDirective::{ name, sources, raw_values })
  }

  Result::Ok(
    CspPolicy::{
      directives: dirs,
      upgrade_insecure_requests: upgrade_insecure,
      block_all_mixed_content: block_mixed,
      sandbox_tokens: sandbox_tokens,
      report_uri: report_uri,
      report_to: report_to,
    },
  )
}

///| Parse a single `Content-Security-Policy` header with explicit resource limits.
///| Per W3C CSP3 §2.2.2 / RFC 9110 §5.3, if a comma `,` is present (multiple combined
///| policies), only the first policy segment is parsed so policies are never merged into
///| a union; use `parse_csp_list` / `parse_csp_list_with_limits` for multi-policy headers.
pub fn parse_csp_with_limits(
  header : String,
  limits : ParseLimits,
) -> Result[CspPolicy, CspError] {
  match validate_limits(limits) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(_) => ()
  }
  if limits.max_policies < 1 {
    return Result::Err(
      CspError::LimitExceeded("policy count exceeds max_policies (0)"),
    )
  }
  if header.length() > limits.max_header_bytes {
    return Result::Err(
      CspError::LimitExceeded(
        "header length " + header.length().to_string() +
        " exceeds max_header_bytes (" + limits.max_header_bytes.to_string() + ")",
      ),
    )
  }
  let comma = match validate_header_control_chars_and_comma(header) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(c) => c
  }
  let n = header.length()
  let seg_end = if comma >= 0 { comma } else { n }
  parse_single_policy_slice(header, 0, seg_end, limits)
}

///| Parse a single `Content-Security-Policy` header using `ParseLimits::default()`.
pub fn parse_csp(header : String) -> Result[CspPolicy, CspError] {
  parse_csp_with_limits(header, ParseLimits::default())
}

///| Parse multiple `Content-Security-Policy` headers (including comma-separated policies)
///| with explicit resource limits.
pub fn parse_csp_list_with_limits(
  headers : Array[String],
  limits : ParseLimits,
) -> Result[Array[CspPolicy], CspError] {
  match validate_limits(limits) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(_) => ()
  }
  let mut total_bytes = 0
  let out : Array[CspPolicy] = []
  let mut hi = 0
  while hi < headers.length() {
    let h = headers[hi]
    total_bytes = total_bytes + h.length()
    if total_bytes > limits.max_header_bytes {
      return Result::Err(
        CspError::LimitExceeded(
          "total header bytes " + total_bytes.to_string() +
          " exceeds max_header_bytes (" + limits.max_header_bytes.to_string() + ")",
        ),
      )
    }
    match validate_header_control_chars(h) {
      Result::Err(e) => return Result::Err(e)
      Result::Ok(_) => ()
    }
    let n = h.length()
    let mut pos = 0
    while pos < n {
      let comma = csp_find_byte(h, 44, pos, n)
      let seg_end = if comma >= 0 { comma } else { n }
      let mut a = pos
      let mut b = seg_end
      while a < b && csp_is_ws(h.code_unit_at(a)) {
        a = a + 1
      }
      while b > a && csp_is_ws(h.code_unit_at(b - 1)) {
        b = b - 1
      }
      pos = if comma >= 0 { comma + 1 } else { n }
      if a >= b {
        continue
      }
      if out.length() >= limits.max_policies {
        return Result::Err(
          CspError::LimitExceeded(
            "policy count exceeds max_policies (" +
            limits.max_policies.to_string() + ")",
          ),
        )
      }
      match parse_single_policy_slice(h, a, b, limits) {
        Result::Ok(p) => out.push(p)
        Result::Err(e) => return Result::Err(e)
      }
    }
    hi = hi + 1
  }
  Result::Ok(out)
}

///| Parse multiple `Content-Security-Policy` headers using `ParseLimits::default()`.
pub fn parse_csp_list(headers : Array[String]) -> Result[Array[CspPolicy], CspError] {
  parse_csp_list_with_limits(headers, ParseLimits::default())
}

///| Deterministically serialize a `CspPolicy` back into a canonical, injection-safe CSP3 header string.
///| Drops any unsafe directive names or tokens containing CR/LF/controls/`;`/`,`/whitespace so
///| programmatically constructed policies cannot inject headers or directives.
pub fn serialize_csp(policy : CspPolicy) -> String {
  let sb = StringBuilder::new()
  let mut written_dirs = 0
  let mut i = 0
  let n = policy.directives.length()
  while i < n {
    let d = policy.directives[i]
    let dname = csp_ascii_lower(d.name)
    if !csp_is_safe_directive_name(dname) {
      i = i + 1
      continue
    }
    if written_dirs > 0 {
      sb.write_string("; ")
    }
    written_dirs = written_dirs + 1
    sb.write_string(dname)
    if is_source_list_directive(dname) {
      let mut j = 0
      while j < d.sources.length() {
        let tok = format_source_expression(d.sources[j])
        if csp_is_safe_serialized_token(tok) {
          sb.write_string(" ")
          sb.write_string(tok)
        }
        j = j + 1
      }
    } else {
      let mut j = 0
      while j < d.raw_values.length() {
        let tok = d.raw_values[j]
        if csp_is_safe_serialized_token(tok) {
          sb.write_string(" ")
          sb.write_string(tok)
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  sb.to_string()
}

// ============================================================================
// WHATWG URL-Backed Matching Helpers (W3C CSP3 §6.7.2)
// ============================================================================

val struct CspOriginTuple {
  scheme : String
  host_src : String
  host_start : Int
  host_end : Int
  port : Int
}

val struct ParsedTargetUrl {
  scheme : String
  has_host : Bool
  host_src : String
  host_start : Int
  host_end : Int
  explicit_port : Int
  eff_port : Int
  path_src : String
  path_start : Int
  path_end : Int
  path_lazy : Bool
}

fn csp_parse_page_origin(page_origin : String) -> Option[CspOriginTuple] {
  let n = page_origin.length()
  if n >= 8 {
    let mut sch = ""
    let mut def_port = -1
    let mut host_start = 0
    let c0 = page_origin.code_unit_at(0)
    if c0 == 104 && page_origin.code_unit_at(1) == 116 &&
    page_origin.code_unit_at(2) == 116 && page_origin.code_unit_at(3) == 112 {
      if page_origin.code_unit_at(4) == 115 && page_origin.code_unit_at(5) == 58 &&
      page_origin.code_unit_at(6) == 47 && page_origin.code_unit_at(7) == 47 {
        sch = "https"
        def_port = 443
        host_start = 8
      } else if page_origin.code_unit_at(4) == 58 && page_origin.code_unit_at(5) == 47 &&
      page_origin.code_unit_at(6) == 47 {
        sch = "http"
        def_port = 80
        host_start = 7
      }
    }
    if host_start > 0 {
      let mut i = host_start
      let mut last_label_start = host_start
      let mut prev_dash = false
      let mut ok = true
      while i < n {
        let c = page_origin.code_unit_at(i)
        if c == 58 || c == 47 || c == 92 || c == 63 || c == 35 {
          break
        }
        if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
          prev_dash = false
        } else if c == 46 {
          last_label_start = i + 1
          prev_dash = false
        } else if c == 45 {
          if prev_dash {
            ok = false
            break
          }
          prev_dash = true
        } else {
          ok = false
          break
        }
        i = i + 1
      }
      if ok && i > host_start && i > last_label_start {
        let lc = page_origin.code_unit_at(last_label_start)
        if lc >= 97 && lc <= 122 {
          let host_end = i
          let mut port = def_port
          let mut port_ok = true
          if i < n && page_origin.code_unit_at(i) == 58 {
            let pstart = i + 1
            let mut pi = pstart
            let mut acc = 0
            while pi < n {
              let pc = page_origin.code_unit_at(pi)
              if pc == 47 || pc == 92 || pc == 63 || pc == 35 {
                break
              }
              let next = csp_port_step(acc, pc)
              if next < 0 {
                port_ok = false
                break
              }
              acc = next
              pi = pi + 1
            }
            if port_ok && pi > pstart {
              port = acc
            }
          }
          if port_ok {
            return Option::Some(
              CspOriginTuple::{
                scheme: sch,
                host_src: page_origin,
                host_start: host_start,
                host_end: host_end,
                port: port,
              },
            )
          }
        }
      }
    }
  }
  match url::Url::parse(page_origin) {
    Result::Ok(u) =>
    match u.origin() {
      url::Origin::Tuple(sch, host, port) => {
        let hs = url::host_to_string(host)
        Option::Some(
          CspOriginTuple::{
            scheme: sch,
            host_src: hs,
            host_start: 0,
            host_end: hs.length(),
            port: port,
          },
        )
      }
      url::Origin::Opaque => Option::None
    }
    Result::Err(_) => Option::None
  }
}

fn csp_parse_target_url_fast(target_url : String) -> Option[ParsedTargetUrl] {
  let n = target_url.length()
  if n < 5 {
    return Option::None
  }
  let c0 = target_url.code_unit_at(0)
  // Fast path for "data:..." (WHATWG non-special opaque-path URL: always valid, no host)
  if c0 == 100 && target_url.code_unit_at(1) == 97 &&
  target_url.code_unit_at(2) == 116 && target_url.code_unit_at(3) == 97 &&
  target_url.code_unit_at(4) == 58 {
    return Option::Some(
      ParsedTargetUrl::{
        scheme: "data",
        has_host: false,
        host_src: "",
        host_start: 0,
        host_end: 0,
        explicit_port: -1,
        eff_port: -1,
        path_src: "",
        path_start: 0,
        path_end: 0,
        path_lazy: false,
      },
    )
  }
  let mut sch = ""
  let mut def_port = -1
  let mut host_start = 0
  if c0 == 104 && n >= 7 && target_url.code_unit_at(1) == 116 &&
  target_url.code_unit_at(2) == 116 && target_url.code_unit_at(3) == 112 {
    if n >= 8 && target_url.code_unit_at(4) == 115 && target_url.code_unit_at(5) == 58 &&
    target_url.code_unit_at(6) == 47 && target_url.code_unit_at(7) == 47 {
      sch = "https"
      def_port = 443
      host_start = 8
    } else if target_url.code_unit_at(4) == 58 && target_url.code_unit_at(5) == 47 &&
    target_url.code_unit_at(6) == 47 {
      sch = "http"
      def_port = 80
      host_start = 7
    }
  } else if c0 == 119 && target_url.code_unit_at(1) == 115 {
    if n >= 6 && target_url.code_unit_at(2) == 115 && target_url.code_unit_at(3) == 58 &&
    target_url.code_unit_at(4) == 47 && target_url.code_unit_at(5) == 47 {
      sch = "wss"
      def_port = 443
      host_start = 6
    } else if target_url.code_unit_at(2) == 58 && target_url.code_unit_at(3) == 47 &&
    target_url.code_unit_at(4) == 47 {
      sch = "ws"
      def_port = 80
      host_start = 5
    }
  }
  if host_start == 0 {
    return Option::None
  }
  let mut i = host_start
  let mut last_label_start = host_start
  let mut prev_dash = false
  while i < n {
    let c = target_url.code_unit_at(i)
    if c == 58 || c == 47 || c == 92 || c == 63 || c == 35 {
      break
    }
    if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
      prev_dash = false
    } else if c == 46 {
      last_label_start = i + 1
      prev_dash = false
    } else if c == 45 {
      if prev_dash {
        return Option::None
      }
      prev_dash = true
    } else {
      return Option::None
    }
    i = i + 1
  }
  if i <= host_start || i <= last_label_start {
    return Option::None
  }
  let lc = target_url.code_unit_at(last_label_start)
  if lc < 97 || lc > 122 {
    return Option::None
  }
  let host_end = i
  let mut explicit_port = -1
  let mut eff_port = def_port
  if i < n && target_url.code_unit_at(i) == 58 {
    let pstart = i + 1
    let mut pi = pstart
    let mut acc = 0
    while pi < n {
      let pc = target_url.code_unit_at(pi)
      if pc == 47 || pc == 92 || pc == 63 || pc == 35 {
        break
      }
      let next = csp_port_step(acc, pc)
      if next < 0 {
        return Option::None
      }
      acc = next
      pi = pi + 1
    }
    if pi > pstart {
      eff_port = acc
      if acc != def_port {
        explicit_port = acc
      }
    }
    i = pi
  }
  // For special schemes with valid host & port, path/query/fragment NEVER cause a fatal URL parse error.
  // Mark complex paths (backslash, dot-segments, controls) as lazy so host mismatches skip Url::parse!
  let mut path_src = "/"
  let mut path_start = 0
  let mut path_end = 1
  let mut path_lazy = false
  if i < n {
    let tc = target_url.code_unit_at(i)
    if tc == 47 {
      let mut pi = i + 1
      let mut prev_slash = true
      while pi < n {
        let pc = target_url.code_unit_at(pi)
        if pc == 63 || pc == 35 {
          break
        }
        if pc <= 32 || pc >= 127 || pc == 92 || pc == 34 || pc == 60 ||
        pc == 62 || pc == 96 || pc == 123 || pc == 125 ||
        (prev_slash && (pc == 46 || pc == 37)) {
          path_lazy = true
          break
        }
        prev_slash = pc == 47
        pi = pi + 1
      }
      if !path_lazy {
        path_src = target_url
        path_start = i
        path_end = pi
      }
    } else if tc == 92 {
      path_lazy = true
    }
  }
  Option::Some(
    ParsedTargetUrl::{
      scheme: sch,
      has_host: true,
      host_src: target_url,
      host_start: host_start,
      host_end: host_end,
      explicit_port: explicit_port,
      eff_port: eff_port,
      path_src: path_src,
      path_start: path_start,
      path_end: path_end,
      path_lazy: path_lazy,
    },
  )
}

fn csp_parse_target_url(target_url : String) -> Option[ParsedTargetUrl] {
  match csp_parse_target_url_fast(target_url) {
    Option::Some(t) => Option::Some(t)
    Option::None =>
    match url::Url::parse(target_url) {
      Result::Ok(u) => {
        let ep = match u.port() {
          Option::Some(p) => p
          Option::None => -1
        }
        let eff = match u.port_or_known_default() {
          Option::Some(p) => p
          Option::None => -1
        }
        let hn = u.hostname()
        let pth = u.path()
        Option::Some(
          ParsedTargetUrl::{
            scheme: u.scheme(),
            has_host: u.has_host(),
            host_src: hn,
            host_start: 0,
            host_end: hn.length(),
            explicit_port: ep,
            eff_port: eff,
            path_src: pth,
            path_start: 0,
            path_end: pth.length(),
            path_lazy: false,
          },
        )
      }
      Result::Err(_) => Option::None
    }
  }
}

///| W3C CSP3 §6.7.2.6 Scheme-part match.
fn csp_scheme_matches(expr_scheme : String, target_scheme : String) -> Bool {
  if expr_scheme == target_scheme {
    return true
  }
  if expr_scheme == "http" && target_scheme == "https" {
    return true
  }
  if expr_scheme == "ws" &&
  (target_scheme == "wss" || target_scheme == "http" || target_scheme == "https") {
    return true
  }
  if expr_scheme == "wss" && target_scheme == "https" {
    return true
  }
  false
}

///| W3C CSP3 §6.7.2.7 Host-part match against slice `host_src[h0..h1]`.
fn csp_host_matches_slice(pat : String, host_src : String, h0 : Int, h1 : Int) -> Bool {
  let host_len = h1 - h0
  let plen = pat.length()
  if plen == 1 && pat.code_unit_at(0) == 42 {
    return host_len > 0
  }
  if plen > 2 && pat.code_unit_at(0) == 42 && pat.code_unit_at(1) == 46 {
    // "*.example.com" -> suffix ".example.com"
    let suffix_len = plen - 1
    if host_len <= suffix_len {
      return false
    }
    let offset = h1 - suffix_len
    let mut i = 0
    while i < suffix_len {
      if host_src.code_unit_at(offset + i) != pat.code_unit_at(1 + i) {
        return false
      }
      i = i + 1
    }
    return true
  }
  csp_slice_eq(pat, 0, plen, host_src, h0, h1)
}

fn csp_slice_eq(a : String, a0 : Int, a1 : Int, b : String, b0 : Int, b1 : Int) -> Bool {
  let len = a1 - a0
  if len != b1 - b0 {
    return false
  }
  let mut i = 0
  while i < len {
    if a.code_unit_at(a0 + i) != b.code_unit_at(b0 + i) {
      return false
    }
    i = i + 1
  }
  true
}

///| W3C CSP3 §6.7.2.9 Path-part match with percent-decoding on both sides (zero-alloc slice).
fn csp_path_matches_slice(expr_path : String, target_src : String, t0 : Int, t1 : Int) -> Bool {
  let en = expr_path.length()
  if en == 0 {
    return true
  }
  let tn = t1 - t0
  if en == 1 && expr_path.code_unit_at(0) == 47 && tn == 0 {
    return true
  }
  // Scan target_path for '\', '%', and encoded slashes (%2f / %5c)
  let mut target_has_pct = false
  let mut ti = t0
  while ti < t1 {
    let c = target_src.code_unit_at(ti)
    if c == 92 {
      return false
    }
    if c == 37 {
      target_has_pct = true
      if ti + 2 < t1 {
        let c1 = target_src.code_unit_at(ti + 1)
        let c2 = target_src.code_unit_at(ti + 2)
        if (c1 == 50 && (c2 == 102 || c2 == 70)) ||
        (c1 == 53 && (c2 == 99 || c2 == 67)) {
          return false
        }
      }
    }
    ti = ti + 1
  }
  let exact = expr_path.code_unit_at(en - 1) != 47
  let expr_has_pct = csp_find_byte(expr_path, 37, 0, en) >= 0
  if !target_has_pct && !expr_has_pct {
    if exact {
      return csp_slice_eq(expr_path, 0, en, target_src, t0, t1)
    }
    return tn >= en && csp_slice_eq(expr_path, 0, en, target_src, t0, t0 + en)
  }

  // Two-cursor segment-by-segment comparison with percent-decoding (zero Array allocation)
  let mut epos = 0
  let mut tpos = t0
  while true {
    let es = csp_find_byte(expr_path, 47, epos, en)
    let ts = csp_find_byte(target_src, 47, tpos, t1)
    if es < 0 && !exact {
      return true
    }
    let eend = if es >= 0 { es } else { en }
    let tend = if ts >= 0 { ts } else { t1 }
    let e_seg_pct = expr_has_pct && csp_find_byte(expr_path, 37, epos, eend) >= 0
    let t_seg_pct = target_has_pct && csp_find_byte(target_src, 37, tpos, tend) >= 0
    if !e_seg_pct && !t_seg_pct {
      if !csp_slice_eq(expr_path, epos, eend, target_src, tpos, tend) {
        return false
      }
    } else {
      let da = if e_seg_pct {
        url::percent_decode_str(expr_path.slice(epos, eend))
      } else {
        expr_path.slice(epos, eend)
      }
      let db = if t_seg_pct {
        url::percent_decode_str(target_src.slice(tpos, tend))
      } else {
        target_src.slice(tpos, tend)
      }
      if da != db {
        return false
      }
    }
    if es < 0 {
      return ts < 0
    }
    if ts < 0 {
      return false
    }
    epos = es + 1
    tpos = ts + 1
  }
  true
}

pub fn csp_explicit_port_matches(ep : Int, eff : Int, is_secure : Bool) -> Bool {
  eff == ep || (ep == 80 && is_secure && eff == 443)
}

fn csp_expr_matches_target(
  expr : SourceExpression,
  page : Option[CspOriginTuple],
  target : ParsedTargetUrl,
  raw_target_url : String,
) -> Bool {
  let ts = target.scheme
  let hlen = target.host_end - target.host_start
  match expr {
    SourceExpression::NoneExpr => false
    SourceExpression::SelfExpr => {
      let pg = match page {
        Option::Some(o) => o
        Option::None => return false
      }
      if !target.has_host || hlen == 0 {
        return false
      }
      if !csp_slice_eq(pg.host_src, pg.host_start, pg.host_end, target.host_src, target.host_start, target.host_end) {
        return false
      }
      let tp = target.eff_port
      // Exact same-origin tuple
      if pg.scheme == ts && pg.port == tp {
        return true
      }
      // W3C CSP3 §6.7.2.4 'self' upgrade & WebSocket matching
      let pg_def = csp_default_port(pg.scheme)
      let ts_def = csp_default_port(ts)
      let port_ok = pg.port == tp ||
      (pg.port == pg_def && pg_def >= 0 && tp == ts_def && ts_def >= 0)
      if !port_ok {
        return false
      }
      ts == "https" || ts == "wss" || (pg.scheme == "http" && (ts == "http" || ts == "ws"))
    }
    SourceExpression::Scheme(sch) => csp_scheme_matches(sch, ts)
    SourceExpression::Host(opt_scheme, host_pat, opt_port, port_wild, path_pat) => {
      // Bare '*' per W3C CSP3 §6.7.2.5
      let is_bare_star = match opt_scheme {
        Option::None =>
        match opt_port {
          Option::None => host_pat.length() == 1 && host_pat.code_unit_at(0) == 42 && !port_wild && path_pat.length() == 0
          Option::Some(_) => false
        }
        Option::Some(_) => false
      }
      if is_bare_star {
        if ts == "data" ||
        ts == "blob" ||
        ts == "filesystem" ||
        ts == "javascript" ||
        ts == "about" {
          return false
        }
        if ts == "http" || ts == "https" || ts == "ws" || ts == "wss" {
          return true
        }
        return match page {
          Option::Some(pg) => ts == pg.scheme
          Option::None => false
        }
      }

      if !target.has_host || hlen == 0 {
        return false
      }

      // Host check first (fast reject before scheme/page/port/path)
      if !csp_host_matches_slice(host_pat, target.host_src, target.host_start, target.host_end) {
        return false
      }

      // Scheme check (W3C CSP3 §6.7.2.8: opaque/empty page origin MUST NOT match scheme-less host-source)
      match opt_scheme {
        Option::Some(es) => {
          if !csp_scheme_matches(es, ts) {
            return false
          }
        }
        Option::None =>
        match page {
          Option::Some(pg) => {
            if !csp_scheme_matches(pg.scheme, ts) {
              return false
            }
          }
          Option::None => return false
        }
      }

      // Port check (W3C CSP3 §6.7.2.8)
      if !port_wild {
        match opt_port {
          Option::Some(ep) => {
            if !csp_explicit_port_matches(ep, target.eff_port, ts == "https" || ts == "wss") {
              return false
            }
          }
          Option::None => {
            // Empty port-part matches ONLY when url.port is null (WHATWG elides default ports).
            if target.explicit_port >= 0 {
              return false
            }
          }
        }
      }

      // Path check (lazily resolve complex paths via Url::parse only when path_pat is non-empty)
      if path_pat.length() == 0 {
        return true
      }
      if target.path_lazy {
        match url::Url::parse(raw_target_url) {
          Result::Ok(u) => {
            let p = u.path()
            return csp_path_matches_slice(path_pat, p, 0, p.length())
          }
          Result::Err(_) => return false
        }
      }
      csp_path_matches_slice(path_pat, target.path_src, target.path_start, target.path_end)
    }
    _ => false
  }
}

fn csp_expr_needs_page(expr : SourceExpression, target : ParsedTargetUrl) -> Bool {
  match expr {
    SourceExpression::SelfExpr => target.has_host && target.host_end > target.host_start
    SourceExpression::Host(opt_scheme, host_pat, opt_port, port_wild, path_pat) =>
    match opt_scheme {
      Option::Some(_) => false
      Option::None => {
        let is_bare_star = match opt_port {
          Option::None => host_pat.length() == 1 && host_pat.code_unit_at(0) == 42 && !port_wild && path_pat.length() == 0
          Option::Some(_) => false
        }
        if is_bare_star {
          let ts = target.scheme
          !(ts == "http" || ts == "https" || ts == "ws" || ts == "wss" ||
            ts == "data" || ts == "blob" || ts == "filesystem" || ts == "javascript" || ts == "about")
        } else {
          target.has_host &&
          target.host_end > target.host_start &&
          csp_host_matches_slice(host_pat, target.host_src, target.host_start, target.host_end)
        }
      }
    }
    _ => false
  }
}

// ============================================================================
// Directive Fallback Chain & Lookup
// ============================================================================

fn policy_find_directive(policy : CspPolicy, name : String) -> Option[CspDirective] {
  let mut i = 0
  let n = policy.directives.length()
  let tlen = name.length()
  while i < n {
    let d = policy.directives[i]
    if d.name.length() == tlen && d.name == name {
      return Option::Some(d)
    }
    i = i + 1
  }
  Option::None
}

fn is_non_fetch_directive(d : String) -> Bool {
  let n = d.length()
  if n == 0 {
    return false
  }
  let c0 = d.code_unit_at(0)
  if c0 == 98 {
    return d == "base-uri" || d == "block-all-mixed-content"
  }
  if c0 == 102 {
    return d == "form-action" || d == "frame-ancestors"
  }
  if c0 == 114 {
    return d == "report-uri" || d == "report-to" || d == "require-trusted-types-for" || d == "referrer"
  }
  if c0 == 115 {
    return d == "sandbox"
  }
  if c0 == 110 {
    return d == "navigate-to"
  }
  if c0 == 117 {
    return d == "upgrade-insecure-requests"
  }
  if c0 == 116 {
    return d == "trusted-types"
  }
  if c0 == 112 {
    return d == "plugin-types"
  }
  if c0 == 100 {
    return d == "disown-opener"
  }
  false
}

fn find_effective_directive_lower(policy : CspPolicy, d : String) -> Option[CspDirective] {
  let dirs = policy.directives
  let n = dirs.length()
  if n == 0 {
    return Option::None
  }
  let mut fb1 = ""
  let mut fb2 = ""
  let mut allow_default = true
  if d == "script-src-elem" || d == "script-src-attr" {
    fb1 = "script-src"
  } else if d == "style-src-elem" || d == "style-src-attr" {
    fb1 = "style-src"
  } else if d == "worker-src" {
    fb1 = "child-src"
    fb2 = "script-src"
  } else if d == "fenced-frame-src" {
    fb1 = "frame-src"
    fb2 = "child-src"
  } else if d == "frame-src" {
    fb1 = "child-src"
  } else if is_non_fetch_directive(d) {
    allow_default = false
  }

  let dlen = d.length()
  let fb1_len = fb1.length()
  let fb2_len = fb2.length()
  let mut idx_fb1 = -1
  let mut idx_fb2 = -1
  let mut idx_def = -1
  let mut i = 0
  while i < n {
    let name = dirs[i].name
    let nl = name.length()
    if nl == dlen && name == d {
      return Option::Some(dirs[i])
    }
    if fb1_len > 0 && idx_fb1 < 0 && nl == fb1_len && name == fb1 {
      idx_fb1 = i
    } else if fb2_len > 0 && idx_fb2 < 0 && nl == fb2_len && name == fb2 {
      idx_fb2 = i
    } else if allow_default && idx_def < 0 && nl == 11 && name == "default-src" {
      idx_def = i
    }
    i = i + 1
  }
  if idx_fb1 >= 0 {
    return Option::Some(dirs[idx_fb1])
  }
  if idx_fb2 >= 0 {
    return Option::Some(dirs[idx_fb2])
  }
  if idx_def >= 0 {
    return Option::Some(dirs[idx_def])
  }
  Option::None
}

fn find_effective_directive(policy : CspPolicy, directive : String) -> Option[CspDirective] {
  find_effective_directive_lower(policy, csp_ascii_lower(directive))
}

fn sources_ignore_unsafe_inline(
  sources : Array[SourceExpression],
  is_script : Bool,
) -> Bool {
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::Nonce(_) => return true
      SourceExpression::Hash(_, _) => return true
      SourceExpression::StrictDynamic => {
        // W3C CSP3 §6.7.3.3: 'strict-dynamic' disables 'unsafe-inline' ONLY for scripts, never styles.
        if is_script {
          return true
        }
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn sources_has_strict_dynamic(sources : Array[SourceExpression]) -> Bool {
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::StrictDynamic => return true
      _ => ()
    }
    i = i + 1
  }
  false
}

fn sources_has_unsafe_hashes(sources : Array[SourceExpression]) -> Bool {
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::UnsafeHashes => return true
      _ => ()
    }
    i = i + 1
  }
  false
}

fn sources_match_nonce(sources : Array[SourceExpression], nonce : String) -> Option[String] {
  if nonce.length() == 0 {
    return Option::None
  }
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::Nonce(v) => {
        if v == nonce {
          return Option::Some("'nonce-" + v + "'")
        }
      }
      _ => ()
    }
    i = i + 1
  }
  Option::None
}

fn sources_match_hashes(
  sources : Array[SourceExpression],
  hashes : Array[(String, String)],
) -> Option[String] {
  if hashes.length() == 0 {
    return Option::None
  }
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::Hash(alg, digest) => {
        let mut j = 0
        while j < hashes.length() {
          let (halg, hval) = hashes[j]
          if csp_ascii_lower(halg) == alg && hval == digest {
            return Option::Some("'" + alg + "-" + digest + "'")
          }
          j = j + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  Option::None
}

fn is_script_directive(d : String) -> Bool {
  d == "script-src" || d == "script-src-elem" || d == "worker-src"
}

// ============================================================================
// Public CSP3 Evaluation API
// ============================================================================

///| Evaluate a single `CspPolicy` for `directive` against `target_url`.
pub fn check_source(
  policy : CspPolicy,
  directive : String,
  page_origin : String,
  target_url : String,
  nonce : String,
  hashes : Array[(String, String)],
  is_parser_inserted : Bool,
) -> CspDecision {
  let eff_name = csp_ascii_lower(directive)
  let dir = match find_effective_directive_lower(policy, eff_name) {
    Option::Some(d) => d
    Option::None =>
    return CspDecision::{
      allowed: true,
      violated_directive: "",
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }
  let sources = dir.sources
  if sources.length() == 0 {
    return CspDecision::{
      allowed: false,
      violated_directive: dir.name,
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }

  let script_dir = is_script_directive(eff_name)
  if script_dir {
    match sources_match_nonce(sources, nonce) {
      Option::Some(m) =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(m),
      }
      Option::None => ()
    }
    match sources_match_hashes(sources, hashes) {
      Option::Some(m) =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(m),
      }
      Option::None => ()
    }
    if sources_has_strict_dynamic(sources) {
      if !is_parser_inserted {
        return CspDecision::{
          allowed: true,
          violated_directive: "",
          effective_directive: eff_name,
          matched_source: Option::Some("'strict-dynamic'"),
        }
      }
      // W3C CSP3 §6.7.2: 'strict-dynamic' ignores host/scheme/'self' allowlists for parser-inserted scripts.
      return CspDecision::{
        allowed: false,
        violated_directive: dir.name,
        effective_directive: eff_name,
        matched_source: Option::None,
      }
    }
  }

  // Parse target URL using WHATWG URL Standard (with zero-alloc fast path); unparsable target URLs fail closed.
  let target = match csp_parse_target_url(target_url) {
    Option::Some(u) => u
    Option::None =>
    return CspDecision::{
      allowed: false,
      violated_directive: dir.name,
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }
  let mut page_parsed = false
  let mut page : Option[CspOriginTuple] = Option::None
  let mut i = 0
  let sn = sources.length()
  while i < sn {
    let expr = sources[i]
    if !page_parsed && csp_expr_needs_page(expr, target) {
      page = csp_parse_page_origin(page_origin)
      page_parsed = true
    }
    if csp_expr_matches_target(expr, page, target, target_url) {
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(format_source_expression(expr)),
      }
    }
    i = i + 1
  }

  CspDecision::{
    allowed: false,
    violated_directive: dir.name,
    effective_directive: eff_name,
    matched_source: Option::None,
  }
}

///| Evaluate multiple `CspPolicy` headers (strict intersection: ALL policies must allow).
pub fn check_source_all(
  policies : Array[CspPolicy],
  directive : String,
  page_origin : String,
  target_url : String,
  nonce : String,
  hashes : Array[(String, String)],
  is_parser_inserted : Bool,
) -> CspDecision {
  let eff_name = csp_ascii_lower(directive)
  let mut last_matched : Option[String] = Option::None
  let mut i = 0
  while i < policies.length() {
    let d = check_source(
      policies[i],
      eff_name,
      page_origin,
      target_url,
      nonce,
      hashes,
      is_parser_inserted,
    )
    if !d.allowed {
      return d
    }
    match d.matched_source {
      Option::Some(m) => last_matched = Option::Some(m)
      Option::None => ()
    }
    i = i + 1
  }
  CspDecision::{
    allowed: true,
    violated_directive: "",
    effective_directive: eff_name,
    matched_source: last_matched,
  }
}

fn check_inline_common(
  policy : CspPolicy,
  eff_name : String,
  nonce : String,
  hashes : Array[(String, String)],
  is_attribute : Bool,
  is_script : Bool,
) -> CspDecision {
  let dir = match find_effective_directive_lower(policy, eff_name) {
    Option::Some(d) => d
    Option::None =>
    return CspDecision::{
      allowed: true,
      violated_directive: "",
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }
  let sources = dir.sources
  if sources.length() == 0 {
    return CspDecision::{
      allowed: false,
      violated_directive: dir.name,
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }

  // Nonce applies only to elements, never inline attributes (CSP3 §6.7.3).
  if !is_attribute {
    match sources_match_nonce(sources, nonce) {
      Option::Some(m) =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(m),
      }
      Option::None => ()
    }
  }

  // Hashes apply to elements directly, or to attributes only when 'unsafe-hashes' is present.
  if !is_attribute || sources_has_unsafe_hashes(sources) {
    match sources_match_hashes(sources, hashes) {
      Option::Some(m) =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(m),
      }
      Option::None => ()
    }
  }

  // 'unsafe-inline' is strictly ignored if any nonce, hash, or (for scripts) 'strict-dynamic' is present.
  if !sources_ignore_unsafe_inline(sources, is_script) {
    let mut i = 0
    while i < sources.length() {
      match sources[i] {
        SourceExpression::UnsafeInline =>
        return CspDecision::{
          allowed: true,
          violated_directive: "",
          effective_directive: eff_name,
          matched_source: Option::Some("'unsafe-inline'"),
        }
        _ => ()
      }
      i = i + 1
    }
  }

  CspDecision::{
    allowed: false,
    violated_directive: dir.name,
    effective_directive: eff_name,
    matched_source: Option::None,
  }
}

///| Evaluate inline script element (`is_attribute = false`) or inline event handler (`is_attribute = true`).
pub fn check_inline_script(
  policy : CspPolicy,
  nonce : String,
  hashes : Array[(String, String)],
  is_attribute : Bool,
) -> CspDecision {
  let eff = if is_attribute { "script-src-attr" } else { "script-src-elem" }
  check_inline_common(policy, eff, nonce, hashes, is_attribute, true)
}

///| Evaluate inline style element (`is_attribute = false`) or inline `style=""` attribute (`is_attribute = true`).
pub fn check_inline_style(
  policy : CspPolicy,
  nonce : String,
  hashes : Array[(String, String)],
  is_attribute : Bool,
) -> CspDecision {
  let eff = if is_attribute { "style-src-attr" } else { "style-src-elem" }
  check_inline_common(policy, eff, nonce, hashes, is_attribute, false)
}

///| Evaluate JavaScript `eval()` / `new Function()` against `script-src` -> `default-src`.
pub fn check_eval(policy : CspPolicy) -> CspDecision {
  let eff_name = "script-src"
  let dir = match find_effective_directive_lower(policy, eff_name) {
    Option::Some(d) => d
    Option::None =>
    return CspDecision::{
      allowed: true,
      violated_directive: "",
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }
  let mut i = 0
  while i < dir.sources.length() {
    match dir.sources[i] {
      SourceExpression::UnsafeEval =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some("'unsafe-eval'"),
      }
      _ => ()
    }
    i = i + 1
  }
  CspDecision::{
    allowed: false,
    violated_directive: dir.name,
    effective_directive: eff_name,
    matched_source: Option::None,
  }
}

///| Evaluate WebAssembly compilation (`WebAssembly.compile` / `instantiate`) against `script-src` -> `default-src`.
///| Permitted by either `'wasm-unsafe-eval'` or `'unsafe-eval'`.
pub fn check_wasm_eval(policy : CspPolicy) -> CspDecision {
  let eff_name = "script-src"
  let dir = match find_effective_directive_lower(policy, eff_name) {
    Option::Some(d) => d
    Option::None =>
    return CspDecision::{
      allowed: true,
      violated_directive: "",
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }
  let mut i = 0
  while i < dir.sources.length() {
    match dir.sources[i] {
      SourceExpression::WasmUnsafeEval =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some("'wasm-unsafe-eval'"),
      }
      SourceExpression::UnsafeEval =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some("'unsafe-eval'"),
      }
      _ => ()
    }
    i = i + 1
  }
  CspDecision::{
    allowed: false,
    violated_directive: dir.name,
    effective_directive: eff_name,
    matched_source: Option::None,
  }
}
