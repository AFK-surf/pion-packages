///| W3C Content Security Policy Level 3 (CSP3) parser, serializer, and evaluator.
///| Zero external dependencies; 100% pure Pion; zero `World` dependency.

// ============================================================================
// Internal ASCII / String Helpers (Low-Allocation Hot Paths)
// ============================================================================

fn csp_is_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 12
}

fn csp_is_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn csp_is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn csp_ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let mut out = Bytes::new(n)
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = (c & 0xFF).to_byte()
    }
    i = i + 1
  }
  out.to_string()
}

fn csp_trim_bounds(s : String, start_in : Int, end_in : Int) -> (Int, Int) {
  let mut a = start_in
  let mut b = end_in
  while a < b && csp_is_ws(s.code_unit_at(a)) {
    a = a + 1
  }
  while b > a && csp_is_ws(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  (a, b)
}

fn csp_find_byte(s : String, ch : Int, from : Int, end : Int) -> Int {
  let mut i = from
  while i < end {
    if s.code_unit_at(i) == ch {
      return i
    }
    i = i + 1
  }
  -1
}

fn csp_find_scheme_sep(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  while i + 2 < n {
    if s.code_unit_at(i) == 58 &&
    s.code_unit_at(i + 1) == 47 &&
    s.code_unit_at(i + 2) == 47 {
      return i
    }
    i = i + 1
  }
  -1
}

fn csp_parse_port_slice(s : String, start : Int, end : Int) -> Int {
  if start >= end || end - start > 5 {
    return -1
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return -1
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  if acc > 65535 {
    return -1
  }
  acc
}

fn csp_is_valid_scheme(s : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  if !csp_is_alpha(s.code_unit_at(start)) {
    return false
  }
  let mut i = start + 1
  while i < end {
    let c = s.code_unit_at(i)
    if !csp_is_alpha(c) && !csp_is_digit(c) && c != 43 && c != 45 && c != 46 {
      return false
    }
    i = i + 1
  }
  true
}

fn csp_default_port(scheme : String) -> Int {
  if scheme == "http" || scheme == "ws" {
    80
  } else if scheme == "https" || scheme == "wss" {
    443
  } else if scheme == "ftp" {
    21
  } else {
    -1
  }
}

// ============================================================================
// Limits & Header Validation
// ============================================================================

fn validate_limits(limits : ParseLimits) -> Result[Unit, CspError] {
  if limits.max_header_bytes < 0 {
    return Result::Err(CspError::InvalidLimits("max_header_bytes must be >= 0"))
  }
  if limits.max_policies < 0 {
    return Result::Err(CspError::InvalidLimits("max_policies must be >= 0"))
  }
  if limits.max_directives_per_policy < 0 {
    return Result::Err(
      CspError::InvalidLimits("max_directives_per_policy must be >= 0"),
    )
  }
  if limits.max_sources_per_directive < 0 {
    return Result::Err(
      CspError::InvalidLimits("max_sources_per_directive must be >= 0"),
    )
  }
  Result::Ok(())
}

fn validate_header_chars(header : String) -> Result[Unit, CspError] {
  let n = header.length()
  let mut i = 0
  while i < n {
    let c = header.code_unit_at(i)
    if c == 0 || c == 10 || c == 13 || c == 127 || c > 127 || (c < 32 && c != 9 && c != 12) {
      return Result::Err(
        CspError::InvalidHeader(
          "illegal control or non-ASCII byte " + c.to_string() + " at offset " + i.to_string(),
        ),
      )
    }
    i = i + 1
  }
  Result::Ok(())
}

// ============================================================================
// Source Expression Parsing & Formatting
// ============================================================================

///| Format a `SourceExpression` into its canonical W3C CSP3 string representation.
pub fn format_source_expression(expr : SourceExpression) -> String {
  match expr {
    SourceExpression::NoneExpr => "'none'"
    SourceExpression::SelfExpr => "'self'"
    SourceExpression::UnsafeInline => "'unsafe-inline'"
    SourceExpression::UnsafeEval => "'unsafe-eval'"
    SourceExpression::StrictDynamic => "'strict-dynamic'"
    SourceExpression::UnsafeHashes => "'unsafe-hashes'"
    SourceExpression::WasmUnsafeEval => "'wasm-unsafe-eval'"
    SourceExpression::ReportSample => "'report-sample'"
    SourceExpression::Nonce(v) => "'nonce-" + v + "'"
    SourceExpression::Hash(alg, v) => "'" + alg + "-" + v + "'"
    SourceExpression::Scheme(sch) => sch + ":"
    SourceExpression::Host(opt_scheme, host, opt_port, port_wild, path) => {
      let sb = StringBuilder::new()
      match opt_scheme {
        Option::Some(sch) => {
          sb.write_string(sch)
          sb.write_string("://")
        }
        Option::None => ()
      }
      sb.write_string(host)
      if port_wild {
        sb.write_string(":*")
      } else {
        match opt_port {
          Option::Some(p) => {
            sb.write_string(":")
            sb.write_string(p.to_string())
          }
          Option::None => ()
        }
      }
      if path.length() > 0 {
        sb.write_string(path)
      }
      sb.to_string()
    }
  }
}

fn parse_source_expression(tok : String) -> Option[SourceExpression] {
  let n = tok.length()
  if n == 0 {
    return Option::None
  }
  // Quoted keywords, nonces, and hashes
  if n >= 2 && tok.code_unit_at(0) == 39 && tok.code_unit_at(n - 1) == 39 {
    let lower = csp_ascii_lower(tok)
    if lower == "'none'" {
      return Option::Some(SourceExpression::NoneExpr)
    }
    if lower == "'self'" {
      return Option::Some(SourceExpression::SelfExpr)
    }
    if lower == "'unsafe-inline'" {
      return Option::Some(SourceExpression::UnsafeInline)
    }
    if lower == "'unsafe-eval'" {
      return Option::Some(SourceExpression::UnsafeEval)
    }
    if lower == "'strict-dynamic'" {
      return Option::Some(SourceExpression::StrictDynamic)
    }
    if lower == "'unsafe-hashes'" {
      return Option::Some(SourceExpression::UnsafeHashes)
    }
    if lower == "'wasm-unsafe-eval'" {
      return Option::Some(SourceExpression::WasmUnsafeEval)
    }
    if lower == "'report-sample'" {
      return Option::Some(SourceExpression::ReportSample)
    }
    if lower.starts_with("'nonce-") && n > 8 {
      return Option::Some(SourceExpression::Nonce(tok.slice(7, n - 1)))
    }
    if lower.starts_with("'sha256-") && n > 9 {
      return Option::Some(SourceExpression::Hash("sha256", tok.slice(8, n - 1)))
    }
    if lower.starts_with("'sha384-") && n > 9 {
      return Option::Some(SourceExpression::Hash("sha384", tok.slice(8, n - 1)))
    }
    if lower.starts_with("'sha512-") && n > 9 {
      return Option::Some(SourceExpression::Hash("sha512", tok.slice(8, n - 1)))
    }
    return Option::None
  }

  // Bare wildcard '*'
  if tok == "*" {
    return Option::Some(
      SourceExpression::Host(Option::None, "*", Option::None, false, ""),
    )
  }

  // Scheme-source: e.g. "https:", "data:", "blob:"
  if tok.code_unit_at(n - 1) == 58 && csp_find_byte(tok, 47, 0, n) < 0 {
    if csp_is_valid_scheme(tok, 0, n - 1) {
      return Option::Some(
        SourceExpression::Scheme(csp_ascii_lower(tok.slice(0, n - 1))),
      )
    }
    return Option::None
  }

  // Host-source: [scheme://]host[:port|*][/path]
  let mut opt_scheme : Option[String] = Option::None
  let mut rest_start = 0
  let sep = csp_find_scheme_sep(tok)
  if sep >= 0 {
    if !csp_is_valid_scheme(tok, 0, sep) {
      return Option::None
    }
    opt_scheme = Option::Some(csp_ascii_lower(tok.slice(0, sep)))
    rest_start = sep + 3
  }
  if rest_start >= n {
    return Option::None
  }

  // Split path (and strip query/fragment per CSP3 §6.7.2.4)
  let slash = csp_find_byte(tok, 47, rest_start, n)
  let hostport_end = if slash >= 0 { slash } else { n }
  let mut path = ""
  if slash >= 0 {
    let mut path_end = n
    let q = csp_find_byte(tok, 63, slash, n)
    if q >= 0 && q < path_end {
      path_end = q
    }
    let h = csp_find_byte(tok, 35, slash, n)
    if h >= 0 && h < path_end {
      path_end = h
    }
    path = tok.slice(slash, path_end)
  }

  // Parse host and optional port (supporting IPv6 bracketed hosts)
  if rest_start >= hostport_end {
    return Option::None
  }
  let mut host = ""
  let mut opt_port : Option[Int] = Option::None
  let mut port_wild = false

  if tok.code_unit_at(rest_start) == 91 {
    // IPv6 literal [addr]
    let rb = csp_find_byte(tok, 93, rest_start + 1, hostport_end)
    if rb < 0 {
      return Option::None
    }
    host = csp_ascii_lower(tok.slice(rest_start, rb + 1))
    if rb + 1 < hostport_end {
      if tok.code_unit_at(rb + 1) != 58 {
        return Option::None
      }
      let pstart = rb + 2
      if pstart + 1 == hostport_end && tok.code_unit_at(pstart) == 42 {
        port_wild = true
      } else {
        let p = csp_parse_port_slice(tok, pstart, hostport_end)
        if p < 0 {
          return Option::None
        }
        opt_port = Option::Some(p)
      }
    }
  } else {
    let colon = csp_find_byte(tok, 58, rest_start, hostport_end)
    if colon >= 0 {
      host = csp_ascii_lower(tok.slice(rest_start, colon))
      let pstart = colon + 1
      if pstart + 1 == hostport_end && tok.code_unit_at(pstart) == 42 {
        port_wild = true
      } else {
        let p = csp_parse_port_slice(tok, pstart, hostport_end)
        if p < 0 {
          return Option::None
        }
        opt_port = Option::Some(p)
      }
    } else {
      host = csp_ascii_lower(tok.slice(rest_start, hostport_end))
    }
  }

  if host.length() == 0 {
    return Option::None
  }
  Option::Some(SourceExpression::Host(opt_scheme, host, opt_port, port_wild, path))
}

// ============================================================================
// CSP Parsing & Serialization
// ============================================================================

fn policy_has_directive(dirs : Array[CspDirective], name : String) -> Bool {
  let mut i = 0
  let n = dirs.length()
  while i < n {
    if dirs[i].name == name {
      return true
    }
    i = i + 1
  }
  false
}

fn is_source_list_directive(name : String) -> Bool {
  name != "upgrade-insecure-requests" &&
  name != "block-all-mixed-content" &&
  name != "sandbox" &&
  name != "report-uri" &&
  name != "report-to" &&
  name != "require-trusted-types-for" &&
  name != "trusted-types"
}

fn parse_single_policy_slice(
  header : String,
  seg_start : Int,
  seg_end : Int,
  limits : ParseLimits,
) -> Result[CspPolicy, CspError] {
  let dirs : Array[CspDirective] = []
  let mut upgrade_insecure = false
  let mut block_mixed = false
  let mut sandbox_tokens : Option[Array[String]] = Option::None
  let mut report_uri : Array[String] = []
  let mut report_to : Option[String] = Option::None

  let mut dir_seen_count = 0
  let mut pos = seg_start
  while pos < seg_end {
    let semi = csp_find_byte(header, 59, pos, seg_end)
    let part_end = if semi >= 0 { semi } else { seg_end }
    let (a, b) = csp_trim_bounds(header, pos, part_end)
    pos = if semi >= 0 { semi + 1 } else { seg_end }
    if a >= b {
      continue
    }

    dir_seen_count = dir_seen_count + 1
    if dir_seen_count > limits.max_directives_per_policy {
      return Result::Err(
        CspError::LimitExceeded(
          "directive count exceeds max_directives_per_policy (" +
          limits.max_directives_per_policy.to_string() + ")",
        ),
      )
    }

    // Extract directive name (first whitespace-delimited token)
    let mut name_end = a
    while name_end < b && !csp_is_ws(header.code_unit_at(name_end)) {
      name_end = name_end + 1
    }
    let name = csp_ascii_lower(header.slice(a, name_end))

    // W3C CSP3 §2.2.1: duplicate directive within same policy is ignored (first wins).
    if policy_has_directive(dirs, name) {
      continue
    }

    let sources : Array[SourceExpression] = []
    let raw_values : Array[String] = []
    let parse_sources = is_source_list_directive(name)

    let mut cur = name_end
    let mut src_count = 0
    while cur < b {
      while cur < b && csp_is_ws(header.code_unit_at(cur)) {
        cur = cur + 1
      }
      if cur >= b {
        break
      }
      let tok_start = cur
      while cur < b && !csp_is_ws(header.code_unit_at(cur)) {
        cur = cur + 1
      }
      src_count = src_count + 1
      if src_count > limits.max_sources_per_directive {
        return Result::Err(
          CspError::LimitExceeded(
            "source count in '" + name + "' exceeds max_sources_per_directive (" +
            limits.max_sources_per_directive.to_string() + ")",
          ),
        )
      }
      let tok = header.slice(tok_start, cur)
      raw_values.push(tok)
      if parse_sources {
        match parse_source_expression(tok) {
          Option::Some(expr) => sources.push(expr)
          Option::None => ()
        }
      }
    }

    if name == "upgrade-insecure-requests" {
      upgrade_insecure = true
    } else if name == "block-all-mixed-content" {
      block_mixed = true
    } else if name == "sandbox" {
      let toks : Array[String] = []
      let mut k = 0
      while k < raw_values.length() {
        toks.push(csp_ascii_lower(raw_values[k]))
        k = k + 1
      }
      sandbox_tokens = Option::Some(toks)
    } else if name == "report-uri" {
      report_uri = raw_values
    } else if name == "report-to" {
      if raw_values.length() > 0 {
        report_to = Option::Some(raw_values[0])
      }
    }

    dirs.push(CspDirective::{ name, sources, raw_values })
  }

  Result::Ok(
    CspPolicy::{
      directives: dirs,
      upgrade_insecure_requests: upgrade_insecure,
      block_all_mixed_content: block_mixed,
      sandbox_tokens: sandbox_tokens,
      report_uri: report_uri,
      report_to: report_to,
    },
  )
}

///| Parse a single `Content-Security-Policy` header with explicit resource limits.
pub fn parse_csp_with_limits(
  header : String,
  limits : ParseLimits,
) -> Result[CspPolicy, CspError] {
  match validate_limits(limits) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(_) => ()
  }
  if limits.max_policies < 1 {
    return Result::Err(
      CspError::LimitExceeded("policy count exceeds max_policies (0)"),
    )
  }
  if header.length() > limits.max_header_bytes {
    return Result::Err(
      CspError::LimitExceeded(
        "header length " + header.length().to_string() +
        " exceeds max_header_bytes (" + limits.max_header_bytes.to_string() + ")",
      ),
    )
  }
  match validate_header_chars(header) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(_) => ()
  }
  parse_single_policy_slice(header, 0, header.length(), limits)
}

///| Parse a single `Content-Security-Policy` header using `ParseLimits::default()`.
pub fn parse_csp(header : String) -> Result[CspPolicy, CspError] {
  parse_csp_with_limits(header, ParseLimits::default())
}

///| Parse multiple `Content-Security-Policy` headers (including comma-separated policies)
///| with explicit resource limits.
pub fn parse_csp_list_with_limits(
  headers : Array[String],
  limits : ParseLimits,
) -> Result[Array[CspPolicy], CspError] {
  match validate_limits(limits) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(_) => ()
  }
  let mut total_bytes = 0
  let out : Array[CspPolicy] = []
  let mut hi = 0
  while hi < headers.length() {
    let h = headers[hi]
    total_bytes = total_bytes + h.length()
    if total_bytes > limits.max_header_bytes {
      return Result::Err(
        CspError::LimitExceeded(
          "total header bytes " + total_bytes.to_string() +
          " exceeds max_header_bytes (" + limits.max_header_bytes.to_string() + ")",
        ),
      )
    }
    match validate_header_chars(h) {
      Result::Err(e) => return Result::Err(e)
      Result::Ok(_) => ()
    }
    let n = h.length()
    let mut pos = 0
    while pos < n {
      let comma = csp_find_byte(h, 44, pos, n)
      let seg_end = if comma >= 0 { comma } else { n }
      let (a, b) = csp_trim_bounds(h, pos, seg_end)
      pos = if comma >= 0 { comma + 1 } else { n }
      if a >= b {
        continue
      }
      if out.length() >= limits.max_policies {
        return Result::Err(
          CspError::LimitExceeded(
            "policy count exceeds max_policies (" +
            limits.max_policies.to_string() + ")",
          ),
        )
      }
      match parse_single_policy_slice(h, a, b, limits) {
        Result::Ok(p) => out.push(p)
        Result::Err(e) => return Result::Err(e)
      }
    }
    hi = hi + 1
  }
  Result::Ok(out)
}

///| Parse multiple `Content-Security-Policy` headers using `ParseLimits::default()`.
pub fn parse_csp_list(headers : Array[String]) -> Result[Array[CspPolicy], CspError] {
  parse_csp_list_with_limits(headers, ParseLimits::default())
}

///| Deterministically serialize a `CspPolicy` back into a canonical CSP3 header string.
pub fn serialize_csp(policy : CspPolicy) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  let n = policy.directives.length()
  while i < n {
    if i > 0 {
      sb.write_string("; ")
    }
    let d = policy.directives[i]
    sb.write_string(d.name)
    if is_source_list_directive(d.name) {
      let mut j = 0
      while j < d.sources.length() {
        sb.write_string(" ")
        sb.write_string(format_source_expression(d.sources[j]))
        j = j + 1
      }
    } else {
      let mut j = 0
      while j < d.raw_values.length() {
        sb.write_string(" ")
        sb.write_string(d.raw_values[j])
        j = j + 1
      }
    }
    i = i + 1
  }
  sb.to_string()
}

// ============================================================================
// URL Parsing & Matching Helpers (W3C CSP3 §6.7.2)
// ============================================================================

struct CspUrlParts {
  scheme : String
  host : String
  port : Int
  path : String
  has_host : Bool
}

fn csp_parse_url_parts(raw : String) -> CspUrlParts {
  let (a, b) = csp_trim_bounds(raw, 0, raw.length())
  if a >= b {
    return CspUrlParts::{ scheme: "", host: "", port: -1, path: "", has_host: false }
  }
  let s = if a == 0 && b == raw.length() { raw } else { raw.slice(a, b) }
  let n = s.length()
  let colon = csp_find_byte(s, 58, 0, n)
  if colon <= 0 {
    return CspUrlParts::{ scheme: "", host: "", port: -1, path: s, has_host: false }
  }
  let scheme = csp_ascii_lower(s.slice(0, colon))
  let after_colon = colon + 1
  if after_colon + 1 >= n ||
  s.code_unit_at(after_colon) != 47 ||
  s.code_unit_at(after_colon + 1) != 47 {
    return CspUrlParts::{
      scheme,
      host: "",
      port: -1,
      path: s.slice(after_colon, n),
      has_host: false,
    }
  }

  let auth_start = after_colon + 2
  let mut auth_end = n
  let mut i = auth_start
  while i < n {
    let c = s.code_unit_at(i)
    if c == 47 || c == 63 || c == 35 {
      auth_end = i
      break
    }
    i = i + 1
  }

  // Extract path (strip query & fragment)
  let mut path = "/"
  if auth_end < n && s.code_unit_at(auth_end) == 47 {
    let mut path_end = n
    let q = csp_find_byte(s, 63, auth_end, n)
    if q >= 0 && q < path_end {
      path_end = q
    }
    let h = csp_find_byte(s, 35, auth_end, n)
    if h >= 0 && h < path_end {
      path_end = h
    }
    path = s.slice(auth_end, path_end)
  }

  // Strip optional userinfo@
  let at = csp_find_byte(s, 64, auth_start, auth_end)
  let hp_start = if at >= 0 { at + 1 } else { auth_start }

  let mut host = ""
  let mut port = csp_default_port(scheme)
  if hp_start < auth_end {
    if s.code_unit_at(hp_start) == 91 {
      let rb = csp_find_byte(s, 93, hp_start + 1, auth_end)
      if rb >= 0 {
        host = csp_ascii_lower(s.slice(hp_start, rb + 1))
        if rb + 1 < auth_end && s.code_unit_at(rb + 1) == 58 {
          let p = csp_parse_port_slice(s, rb + 2, auth_end)
          if p >= 0 {
            port = p
          }
        }
      }
    } else {
      let pc = csp_find_byte(s, 58, hp_start, auth_end)
      if pc >= 0 {
        host = csp_ascii_lower(s.slice(hp_start, pc))
        let p = csp_parse_port_slice(s, pc + 1, auth_end)
        if p >= 0 {
          port = p
        }
      } else {
        host = csp_ascii_lower(s.slice(hp_start, auth_end))
      }
    }
  }

  CspUrlParts::{ scheme, host, port, path, has_host: host.length() > 0 }
}

fn csp_scheme_matches(expr_scheme : String, target_scheme : String) -> Bool {
  if expr_scheme == target_scheme {
    return true
  }
  // W3C CSP3 §6.7.2.1 / §6.7.2.4: allow upgrade http->https and ws->wss; NEVER downgrade.
  if expr_scheme == "http" && target_scheme == "https" {
    return true
  }
  if expr_scheme == "ws" && target_scheme == "wss" {
    return true
  }
  false
}

fn csp_host_matches(pat : String, target_host : String) -> Bool {
  if pat == "*" {
    return target_host.length() > 0
  }
  if pat.length() > 2 && pat.code_unit_at(0) == 42 && pat.code_unit_at(1) == 46 {
    // "*.example.com" -> suffix ".example.com"
    let suffix_len = pat.length() - 1
    let host_len = target_host.length()
    if host_len <= suffix_len {
      return false
    }
    let offset = host_len - suffix_len
    let mut i = 0
    while i < suffix_len {
      if target_host.code_unit_at(offset + i) != pat.code_unit_at(1 + i) {
        return false
      }
      i = i + 1
    }
    return true
  }
  pat == target_host
}

fn csp_is_hex_2e(s : String, pos : Int, end : Int) -> Bool {
  if pos + 2 >= end {
    return false
  }
  let c0 = s.code_unit_at(pos)
  let c1 = s.code_unit_at(pos + 1)
  let c2 = s.code_unit_at(pos + 2)
  c0 == 37 && c1 == 50 && (c2 == 101 || c2 == 69)
}

fn csp_has_path_traversal(path : String) -> Bool {
  let n = path.length()
  let mut i = 0
  while i < n {
    let c = path.code_unit_at(i)
    // Reject backslashes and percent-encoded slashes (%2f / %2F / %5c / %5C)
    if c == 92 {
      return true
    }
    if c == 37 && i + 2 < n {
      let c1 = path.code_unit_at(i + 1)
      let c2 = path.code_unit_at(i + 2)
      if (c1 == 50 && (c2 == 102 || c2 == 70)) || (c1 == 53 && (c2 == 99 || c2 == 67)) {
        return true
      }
    }
    i = i + 1
  }
  // Check each '/' delimited segment for '..' (literal or %2e-encoded)
  let mut seg_start = 0
  while seg_start <= n {
    let slash = csp_find_byte(path, 47, seg_start, n)
    let seg_end = if slash >= 0 { slash } else { n }
    if seg_end > seg_start {
      let mut dots = 0
      let mut p = seg_start
      let mut all_dots = true
      while p < seg_end {
        if path.code_unit_at(p) == 46 {
          dots = dots + 1
          p = p + 1
        } else if csp_is_hex_2e(path, p, seg_end) {
          dots = dots + 1
          p = p + 3
        } else {
          all_dots = false
          break
        }
      }
      if all_dots && dots == 2 {
        return true
      }
    }
    if slash < 0 {
      break
    }
    seg_start = slash + 1
  }
  false
}

fn csp_path_matches(expr_path : String, target_path : String) -> Bool {
  if expr_path.length() == 0 {
    return true
  }
  if csp_has_path_traversal(target_path) {
    return false
  }
  if expr_path.code_unit_at(expr_path.length() - 1) == 47 {
    return target_path.starts_with(expr_path)
  }
  expr_path == target_path
}

fn csp_expr_matches_url(
  expr : SourceExpression,
  page : CspUrlParts,
  target : CspUrlParts,
) -> Bool {
  match expr {
    SourceExpression::NoneExpr => false
    SourceExpression::SelfExpr => {
      if !page.has_host || !target.has_host {
        return false
      }
      if !csp_scheme_matches(page.scheme, target.scheme) {
        return false
      }
      if page.host != target.host {
        return false
      }
      if page.port == target.port {
        return true
      }
      if (page.scheme == "http" && target.scheme == "https" && page.port == 80 && target.port == 443) ||
      (page.scheme == "ws" && target.scheme == "wss" && page.port == 80 && target.port == 443) {
        return true
      }
      false
    }
    SourceExpression::Scheme(sch) => csp_scheme_matches(sch, target.scheme)
    SourceExpression::Host(opt_scheme, host_pat, opt_port, port_wild, path_pat) => {
      // Bare '*' per W3C CSP3 §6.7.2.5
      let is_bare_star = match opt_scheme {
        Option::None =>
        match opt_port {
          Option::None => host_pat == "*" && !port_wild && path_pat.length() == 0
          Option::Some(_) => false
        }
        Option::Some(_) => false
      }
      if is_bare_star {
        if target.scheme == "data" ||
        target.scheme == "blob" ||
        target.scheme == "filesystem" ||
        target.scheme == "javascript" ||
        target.scheme == "about" {
          return false
        }
        return target.scheme == "http" ||
        target.scheme == "https" ||
        target.scheme == "ws" ||
        target.scheme == "wss" ||
        (page.scheme.length() > 0 && target.scheme == page.scheme)
      }

      if !target.has_host {
        return false
      }

      // Scheme check
      let eff_scheme = match opt_scheme {
        Option::Some(es) => es
        Option::None => page.scheme
      }
      if eff_scheme.length() > 0 && !csp_scheme_matches(eff_scheme, target.scheme) {
        return false
      }

      // Host check
      if !csp_host_matches(host_pat, target.host) {
        return false
      }

      // Port check
      if !port_wild {
        match opt_port {
          Option::Some(ep) => {
            if target.port != ep {
              let upgraded_def = (eff_scheme == "http" && target.scheme == "https" && ep == 80 && target.port == 443) ||
              (eff_scheme == "ws" && target.scheme == "wss" && ep == 80 && target.port == 443)
              if !upgraded_def {
                return false
              }
            }
          }
          Option::None => {
            let def_p = csp_default_port(target.scheme)
            if def_p >= 0 && target.port != def_p {
              return false
            }
          }
        }
      }

      // Path check
      csp_path_matches(path_pat, target.path)
    }
    _ => false
  }
}

// ============================================================================
// Directive Fallback Chain & Lookup
// ============================================================================

fn policy_find_directive(policy : CspPolicy, name : String) -> Option[CspDirective] {
  let mut i = 0
  let n = policy.directives.length()
  while i < n {
    if policy.directives[i].name == name {
      return Option::Some(policy.directives[i])
    }
    i = i + 1
  }
  Option::None
}

fn find_effective_directive(policy : CspPolicy, directive : String) -> Option[CspDirective] {
  let d = csp_ascii_lower(directive)
  match policy_find_directive(policy, d) {
    Option::Some(dir) => return Option::Some(dir)
    Option::None => ()
  }
  if d == "script-src-elem" || d == "script-src-attr" {
    match policy_find_directive(policy, "script-src") {
      Option::Some(dir) => return Option::Some(dir)
      Option::None => return policy_find_directive(policy, "default-src")
    }
  }
  if d == "style-src-elem" || d == "style-src-attr" {
    match policy_find_directive(policy, "style-src") {
      Option::Some(dir) => return Option::Some(dir)
      Option::None => return policy_find_directive(policy, "default-src")
    }
  }
  if d == "worker-src" {
    match policy_find_directive(policy, "child-src") {
      Option::Some(dir) => return Option::Some(dir)
      Option::None => ()
    }
    match policy_find_directive(policy, "script-src") {
      Option::Some(dir) => return Option::Some(dir)
      Option::None => return policy_find_directive(policy, "default-src")
    }
  }
  if d == "frame-src" {
    match policy_find_directive(policy, "child-src") {
      Option::Some(dir) => return Option::Some(dir)
      Option::None => return policy_find_directive(policy, "default-src")
    }
  }
  if d == "child-src" ||
  d == "script-src" ||
  d == "style-src" ||
  d == "img-src" ||
  d == "connect-src" ||
  d == "media-src" ||
  d == "font-src" ||
  d == "object-src" ||
  d == "manifest-src" ||
  d == "prefetch-src" {
    return policy_find_directive(policy, "default-src")
  }
  // base-uri, form-action, frame-ancestors, sandbox, navigate-to NEVER fall back to default-src.
  Option::None
}

fn sources_has_nonce_or_hash_or_strict(sources : Array[SourceExpression]) -> Bool {
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::Nonce(_) => return true
      SourceExpression::Hash(_, _) => return true
      SourceExpression::StrictDynamic => return true
      _ => ()
    }
    i = i + 1
  }
  false
}

fn sources_has_strict_dynamic(sources : Array[SourceExpression]) -> Bool {
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::StrictDynamic => return true
      _ => ()
    }
    i = i + 1
  }
  false
}

fn sources_has_unsafe_hashes(sources : Array[SourceExpression]) -> Bool {
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::UnsafeHashes => return true
      _ => ()
    }
    i = i + 1
  }
  false
}

fn sources_match_nonce(sources : Array[SourceExpression], nonce : String) -> Option[String] {
  if nonce.length() == 0 {
    return Option::None
  }
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::Nonce(v) => {
        if v == nonce {
          return Option::Some("'nonce-" + v + "'")
        }
      }
      _ => ()
    }
    i = i + 1
  }
  Option::None
}

fn sources_match_hashes(
  sources : Array[SourceExpression],
  hashes : Array[(String, String)],
) -> Option[String] {
  if hashes.length() == 0 {
    return Option::None
  }
  let mut i = 0
  while i < sources.length() {
    match sources[i] {
      SourceExpression::Hash(alg, digest) => {
        let mut j = 0
        while j < hashes.length() {
          let (halg, hval) = hashes[j]
          if csp_ascii_lower(halg) == alg && hval == digest {
            return Option::Some("'" + alg + "-" + digest + "'")
          }
          j = j + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  Option::None
}

fn is_script_directive(d : String) -> Bool {
  d == "script-src" || d == "script-src-elem" || d == "worker-src"
}

// ============================================================================
// Public CSP3 Evaluation API
// ============================================================================

///| Evaluate a single `CspPolicy` for `directive` against `target_url`.
pub fn check_source(
  policy : CspPolicy,
  directive : String,
  page_origin : String,
  target_url : String,
  nonce : String,
  hashes : Array[(String, String)],
  is_parser_inserted : Bool,
) -> CspDecision {
  let eff_name = csp_ascii_lower(directive)
  let dir = match find_effective_directive(policy, eff_name) {
    Option::Some(d) => d
    Option::None =>
    return CspDecision::{
      allowed: true,
      violated_directive: "",
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }
  let sources = dir.sources
  if sources.length() == 0 {
    return CspDecision::{
      allowed: false,
      violated_directive: dir.name,
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }

  let script_dir = is_script_directive(eff_name)
  if script_dir {
    match sources_match_nonce(sources, nonce) {
      Option::Some(m) =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(m),
      }
      Option::None => ()
    }
    match sources_match_hashes(sources, hashes) {
      Option::Some(m) =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(m),
      }
      Option::None => ()
    }
    if sources_has_strict_dynamic(sources) {
      if !is_parser_inserted {
        return CspDecision::{
          allowed: true,
          violated_directive: "",
          effective_directive: eff_name,
          matched_source: Option::Some("'strict-dynamic'"),
        }
      }
      // W3C CSP3 §6.7.2: 'strict-dynamic' ignores host/scheme/'self' allowlists for parser-inserted scripts.
      return CspDecision::{
        allowed: false,
        violated_directive: dir.name,
        effective_directive: eff_name,
        matched_source: Option::None,
      }
    }
  }

  let page = csp_parse_url_parts(page_origin)
  let target = csp_parse_url_parts(target_url)
  let mut i = 0
  while i < sources.length() {
    let expr = sources[i]
    if csp_expr_matches_url(expr, page, target) {
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(format_source_expression(expr)),
      }
    }
    i = i + 1
  }

  CspDecision::{
    allowed: false,
    violated_directive: dir.name,
    effective_directive: eff_name,
    matched_source: Option::None,
  }
}

///| Evaluate multiple `CspPolicy` headers (strict intersection: ALL policies must allow).
pub fn check_source_all(
  policies : Array[CspPolicy],
  directive : String,
  page_origin : String,
  target_url : String,
  nonce : String,
  hashes : Array[(String, String)],
  is_parser_inserted : Bool,
) -> CspDecision {
  let eff_name = csp_ascii_lower(directive)
  let mut last_matched : Option[String] = Option::None
  let mut i = 0
  while i < policies.length() {
    let d = check_source(
      policies[i],
      eff_name,
      page_origin,
      target_url,
      nonce,
      hashes,
      is_parser_inserted,
    )
    if !d.allowed {
      return d
    }
    match d.matched_source {
      Option::Some(m) => last_matched = Option::Some(m)
      Option::None => ()
    }
    i = i + 1
  }
  CspDecision::{
    allowed: true,
    violated_directive: "",
    effective_directive: eff_name,
    matched_source: last_matched,
  }
}

fn check_inline_common(
  policy : CspPolicy,
  eff_name : String,
  nonce : String,
  hashes : Array[(String, String)],
  is_attribute : Bool,
) -> CspDecision {
  let dir = match find_effective_directive(policy, eff_name) {
    Option::Some(d) => d
    Option::None =>
    return CspDecision::{
      allowed: true,
      violated_directive: "",
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }
  let sources = dir.sources
  if sources.length() == 0 {
    return CspDecision::{
      allowed: false,
      violated_directive: dir.name,
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }

  // Nonce applies only to elements, never inline attributes (CSP3 §6.7.3).
  if !is_attribute {
    match sources_match_nonce(sources, nonce) {
      Option::Some(m) =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(m),
      }
      Option::None => ()
    }
  }

  // Hashes apply to elements directly, or to attributes only when 'unsafe-hashes' is present.
  if !is_attribute || sources_has_unsafe_hashes(sources) {
    match sources_match_hashes(sources, hashes) {
      Option::Some(m) =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some(m),
      }
      Option::None => ()
    }
  }

  // 'unsafe-inline' is strictly ignored if any nonce, hash, or 'strict-dynamic' is present.
  if !sources_has_nonce_or_hash_or_strict(sources) {
    let mut i = 0
    while i < sources.length() {
      match sources[i] {
        SourceExpression::UnsafeInline =>
        return CspDecision::{
          allowed: true,
          violated_directive: "",
          effective_directive: eff_name,
          matched_source: Option::Some("'unsafe-inline'"),
        }
        _ => ()
      }
      i = i + 1
    }
  }

  CspDecision::{
    allowed: false,
    violated_directive: dir.name,
    effective_directive: eff_name,
    matched_source: Option::None,
  }
}

///| Evaluate inline script element (`is_attribute = false`) or inline event handler (`is_attribute = true`).
pub fn check_inline_script(
  policy : CspPolicy,
  nonce : String,
  hashes : Array[(String, String)],
  is_attribute : Bool,
) -> CspDecision {
  let eff = if is_attribute { "script-src-attr" } else { "script-src-elem" }
  check_inline_common(policy, eff, nonce, hashes, is_attribute)
}

///| Evaluate inline style element (`is_attribute = false`) or inline `style=""` attribute (`is_attribute = true`).
pub fn check_inline_style(
  policy : CspPolicy,
  nonce : String,
  hashes : Array[(String, String)],
  is_attribute : Bool,
) -> CspDecision {
  let eff = if is_attribute { "style-src-attr" } else { "style-src-elem" }
  check_inline_common(policy, eff, nonce, hashes, is_attribute)
}

///| Evaluate JavaScript `eval()` / `new Function()` against `script-src` -> `default-src`.
pub fn check_eval(policy : CspPolicy) -> CspDecision {
  let eff_name = "script-src"
  let dir = match find_effective_directive(policy, eff_name) {
    Option::Some(d) => d
    Option::None =>
    return CspDecision::{
      allowed: true,
      violated_directive: "",
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }
  let mut i = 0
  while i < dir.sources.length() {
    match dir.sources[i] {
      SourceExpression::UnsafeEval =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some("'unsafe-eval'"),
      }
      _ => ()
    }
    i = i + 1
  }
  CspDecision::{
    allowed: false,
    violated_directive: dir.name,
    effective_directive: eff_name,
    matched_source: Option::None,
  }
}

///| Evaluate WebAssembly compilation (`WebAssembly.compile` / `instantiate`) against `script-src` -> `default-src`.
///| Permitted by either `'wasm-unsafe-eval'` or `'unsafe-eval'`.
pub fn check_wasm_eval(policy : CspPolicy) -> CspDecision {
  let eff_name = "script-src"
  let dir = match find_effective_directive(policy, eff_name) {
    Option::Some(d) => d
    Option::None =>
    return CspDecision::{
      allowed: true,
      violated_directive: "",
      effective_directive: eff_name,
      matched_source: Option::None,
    }
  }
  let mut i = 0
  while i < dir.sources.length() {
    match dir.sources[i] {
      SourceExpression::WasmUnsafeEval =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some("'wasm-unsafe-eval'"),
      }
      SourceExpression::UnsafeEval =>
      return CspDecision::{
        allowed: true,
        violated_directive: "",
        effective_directive: eff_name,
        matched_source: Option::Some("'unsafe-eval'"),
      }
      _ => ()
    }
    i = i + 1
  }
  CspDecision::{
    allowed: false,
    violated_directive: dir.name,
    effective_directive: eff_name,
    matched_source: Option::None,
  }
}
