///| Red-team differential / fuzz / DoS oracle for `packages/csp` (Pion side).
///|
///| Modes:
///|   eval <corpus.tsv>     one line per "<id>\t<kind>\t<hex f1>\t<hex f2>\t<hex f3>\t<hex f4>" record:
///|                         kind=src    -> "<id>\t0|1"  check_source(parse_csp(f2), f1, f3, f4, "", [], true)
///|                         kind=origin -> "<id>\t<format_origin(parse_origin(f1))>"
///|   fuzz <seed> <n>       deterministic grammar+mutation fuzzing of every public API; prints counters
///|                         and a SHA-256 over all decisions (must be identical native == wasm32)
///|   dos <kind> <n> [m]    resource-exhaustion probes; prints counters and elapsed ms

import "csp"
import "crypto"

///|
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
fn unhex(buf : Bytes, start : Int, end : Int) -> String {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = ((hex_val(buf[start + 2 * i].to_int()) << 4) | hex_val(buf[start + 2 * i + 1].to_int())).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn find_byte(buf : Bytes, from : Int, end : Int, c : Int) -> Int {
  let mut i = from
  while i < end && buf[i].to_int() != c {
    i = i + 1
  }
  i
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

// ---------------------------------------------------------------------------
// eval
// ---------------------------------------------------------------------------

///|
fn run_eval(world : World, path : String) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "cannot read " + path)
      return 1
    }
  }
  let n = buf.length()
  let sb = StringBuilder::new()
  let mut pos = 0
  while pos < n {
    let le = find_byte(buf, pos, n, 10)
    let f : Array[Int] = [pos]
    let mut p = pos
    while p < le {
      if buf[p].to_int() == 9 {
        f.push(p + 1)
      }
      p = p + 1
    }
    f.push(le + 1)
    // f[k] = start of field k; field k ends at f[k+1]-1
    let id = buf.slice(f[0], f[1] - 1).to_string()
    let kind = buf.slice(f[1], f[2] - 1).to_string()
    if kind == "src" && f.length() >= 7 {
      let directive = unhex(buf, f[2], f[3] - 1)
      let header = unhex(buf, f[3], f[4] - 1)
      let page = unhex(buf, f[4], f[5] - 1)
      let url = unhex(buf, f[5], f[6] - 1)
      let v = match csp::parse_csp(header) {
        Ok(pol) =>
        if csp::check_source(pol, directive, page, url, "", [], true).allowed {
          "1"
        } else {
          "0"
        }
        Err(_) => "E"
      }
      sb.write_string(id + "\t" + v + "\n")
    } else if kind == "origin" && f.length() >= 4 {
      let url = unhex(buf, f[2], f[3] - 1)
      sb.write_string(id + "\t" + csp::format_origin(csp::parse_origin(url)) + "\n")
    } else {
      sb.write_string(id + "\t?\n")
    }
    pos = le + 1
  }
  io_print(world, sb.to_string())
  0
}

// ---------------------------------------------------------------------------
// fuzz
// ---------------------------------------------------------------------------

///|
struct Rng {
  mut s : UInt64
}

///|
fn Rng::next(self : Rng) -> Int {
  let mut x = self.s
  x = x ^ (x << 13)
  x = x ^ (x >> 7)
  x = x ^ (x << 17)
  self.s = x
  ((x >> 33) & 0x7FFFFFFFUL).to_int()
}

///|
fn Rng::below(self : Rng, n : Int) -> Int {
  if n <= 0 {
    0
  } else {
    self.next() % n
  }
}

///|
fn Rng::pick(self : Rng, xs : Array[String]) -> String {
  xs[self.below(xs.length())]
}

///|
let directives : Array[String] = [
  "default-src", "script-src", "script-src-elem", "script-src-attr", "style-src", "style-src-elem",
  "style-src-attr", "img-src", "connect-src", "font-src", "media-src", "object-src", "worker-src",
  "child-src", "frame-src", "manifest-src", "base-uri", "form-action", "frame-ancestors", "sandbox",
  "report-uri", "report-to", "upgrade-insecure-requests", "block-all-mixed-content", "SCRIPT-SRC",
  "fenced-frame-src", "trusted-types", "x-unknown",
]

///|
let sources : Array[String] = [
  "'self'", "'none'", "'unsafe-inline'", "'unsafe-eval'", "'strict-dynamic'", "'unsafe-hashes'",
  "'wasm-unsafe-eval'", "'report-sample'", "'nonce-abc123'", "'NONCE-AbC'", "'nonce-'", "'sha256-AbC='",
  "'SHA384-x'", "'sha512-'", "*", "https:", "http:", "data:", "blob:", "ws:", "wss:", "javascript:",
  "https://trusted.com", "trusted.com", "*.trusted.com", "https://*.trusted.com:*", "http://trusted.com:80",
  "https://trusted.com:8443", "https://cdn.trusted.com/safe/", "https://cdn.trusted.com/file.js",
  "[::1]:8443", "https://[::1]", "*:*", "https://*", "trusted.com:0", "trusted.com:65536",
  "https://trusted.com/a?b#c", "'self'''", "https://", "://x", "*.", "*.com", "a b", "https://trusted.com.",
]

///|
let url_pool : Array[String] = [
  "https://trusted.com/x.js", "http://trusted.com/x.js", "https://a.trusted.com/x.js",
  "https://trusted.com:8443/x.js", "https://evil.com/x.js", "https://evil.com\\@trusted.com/x.js",
  "https://u@trusted.com:1@evil.com/x.js", "https://trusted.com:00008443/x.js",
  "https://trusted.com.evil.com/", "https://evilTRUSTED.com/", "https://cdn.trusted.com/safe/../evil.js",
  "https://cdn.trusted.com/safe/%2e%2e/evil.js", "https://cdn.trusted.com/safe/ok.js?x#y",
  "data:text/javascript,alert(1)", "blob:https://trusted.com/uuid", "javascript:alert(1)", "about:blank",
  "filesystem:https://trusted.com/temporary/x", "wss://trusted.com/s", "ws://trusted.com/s",
  "https://[::1]:8443/x", "HTTPS://TRUSTED.COM/X.JS", "https://trusted.com.:443/", "/relative.js",
  "//trusted.com/x.js", "", "null", "https://trusted.com:65536/", "https://trusted.com:0/",
]

///|
let pages : Array[String] = [
  "https://trusted.com", "http://trusted.com", "https://app.com", "null", "", "data:text/html,x",
  "https://[::1]:8443",
]

///|
let mut_alpha : String = "\\@:/.%?#*';, \t\u{0c}\r\n\u{00}-_0123456789ABCabcé"

///|
fn mutate(r : Rng, s : String) -> String {
  let b = s.to_bytes()
  let n = b.length()
  let k = r.below(4)
  if n == 0 || k == 0 {
    return s
  }
  let sb = StringBuilder::new()
  let pos = r.below(n)
  let op = r.below(3)
  let ins = mut_alpha.to_bytes()
  let mut i = 0
  while i < n {
    if i == pos {
      let ch = Bytes::new(1)
      ch[0] = ins[r.below(ins.length())]
      if op == 0 {
        sb.write_string(ch.to_string())
        sb.write_string(b.slice(i, i + 1).to_string())
      } else if op == 1 {
        sb.write_string(ch.to_string())
      }
      // op == 2: delete
    } else {
      sb.write_string(b.slice(i, i + 1).to_string())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn gen_header(r : Rng) -> String {
  let sb = StringBuilder::new()
  let nd = r.below(6)
  let mut d = 0
  while d < nd {
    if d > 0 {
      sb.write_string(if r.below(8) == 0 { ", " } else { "; " })
    }
    sb.write_string(r.pick(directives))
    let ns = r.below(5)
    let mut s = 0
    while s < ns {
      sb.write_string(" ")
      sb.write_string(mutate(r, r.pick(sources)))
      s = s + 1
    }
    d = d + 1
  }
  mutate(r, sb.to_string())
}

///|
fn dec_str(d : csp::CspDecision) -> String {
  (if d.allowed { "A" } else { "D" }) +
  d.violated_directive +
  "|" +
  d.effective_directive +
  "|" +
  (match d.matched_source {
    Some(m) => m
    None => "-"
  })
}

///|
fn feed(h : crypto::Sha256, s : String) -> Unit {
  h.update(s.to_bytes())
  h.update("\n".to_bytes())
}

///|
fn run_fuzz(world : World, seed : Int, n : Int) -> Int {
  let r = Rng::{ s: (seed.to_int64() * 2654435761L + 88172645463325252L).to_uint64() }
  let h = crypto::Sha256::new()
  let mut parsed = 0
  let mut errors = 0
  let mut allowed = 0
  let mut idem_viol = 0
  let mut sem_viol = 0
  let mut i = 0
  while i < n {
    let header = gen_header(r)
    match csp::parse_csp(header) {
      Ok(p) => {
        parsed = parsed + 1
        let ser = csp::serialize_csp(p)
        feed(h, ser)
        // serialize must be a fixed point and must not change any decision
        match csp::parse_csp(ser) {
          Ok(p2) => {
            if csp::serialize_csp(p2) != ser {
              idem_viol = idem_viol + 1
            }
            let mut k = 0
            while k < 4 {
              let dir = r.pick(directives)
              let page = r.pick(pages)
              let url = mutate(r, r.pick(url_pool))
              let nonce = if r.below(2) == 0 { "abc123" } else { "" }
              let hashes : Array[(String, String)] = if r.below(2) == 0 { [("SHA256", "AbC=")] } else { [] }
              let pi = r.below(2) == 0
              let d1 = csp::check_source(p, dir, page, url, nonce, hashes, pi)
              let d2 = csp::check_source(p2, dir, page, url, nonce, hashes, pi)
              if d1.allowed != d2.allowed {
                sem_viol = sem_viol + 1
              }
              if d1.allowed {
                allowed = allowed + 1
              }
              feed(h, dec_str(d1))
              k = k + 1
            }
          }
          Err(_) => idem_viol = idem_viol + 1
        }
        feed(h, dec_str(csp::check_inline_script(p, "abc123", [("sha256", "AbC=")], r.below(2) == 0)))
        feed(h, dec_str(csp::check_inline_style(p, "", [], r.below(2) == 0)))
        feed(h, dec_str(csp::check_eval(p)))
        feed(h, dec_str(csp::check_wasm_eval(p)))
      }
      Err(e) => {
        errors = errors + 1
        feed(h, csp::csp_error_message(e))
      }
    }
    // list API with random limits around the boundaries
    let lim = csp::ParseLimits::new(r.below(300) - 5, r.below(6) - 1, r.below(8) - 1, r.below(8) - 1)
    match csp::parse_csp_list_with_limits([header, gen_header(r)], lim) {
      Ok(ps) => {
        feed(h, "L" + ps.length().to_string())
        feed(h, dec_str(csp::check_source_all(ps, r.pick(directives), r.pick(pages), mutate(r, r.pick(url_pool)), "", [], true)))
      }
      Err(e) => feed(h, csp::csp_error_message(e))
    }
    // CORS
    let o = mutate(r, r.pick(url_pool))
    feed(h, csp::format_origin(csp::parse_origin(o)))
    let o2 = mutate(r, r.pick(url_pool))
    feed(h, csp::origin_equals(csp::parse_origin(o), csp::parse_origin(o2)).to_string())
    let req_origin = mutate(r, r.pick(["https://app.com", "null", "https://APP.com", ""]))
    let mode = match r.below(3) {
      0 => csp::CredentialsMode::Omit
      1 => csp::CredentialsMode::SameOrigin
      _ => csp::CredentialsMode::Include
    }
    let acao : Option[String] = if r.below(6) == 0 { None } else { Some(mutate(r, r.pick(["*", "https://app.com", "null", "https://app.com, https://b.com", " https://app.com "]))) }
    let acac : Option[String] = if r.below(4) == 0 { None } else { Some(mutate(r, r.pick(["true", "TRUE", " true", "false"]))) }
    let aceh : Option[String] = if r.below(3) == 0 { None } else { Some(mutate(r, r.pick(["*", "X-A, x-b", "*, authorization", ",,"]))) }
    let cr = csp::check_cors_response(req_origin, mode, acao, acac, aceh)
    feed(h, cr.allowed.to_string() + cr.wildcard_exposed.to_string() + cr.exposed_headers.length().to_string() + cr.reason)
    let pf = csp::check_cors_preflight(
      req_origin,
      mode,
      mutate(r, r.pick(["GET", "PUT", "patch", "DELETE", "*"])),
      [mutate(r, r.pick(["authorization", "x-a", "Content-Type", ""]))],
      acao,
      acac,
      Some(mutate(r, r.pick(["PUT, DELETE", "*", "patch", ""]))),
      Some(mutate(r, r.pick(["*", "x-a, authorization", "X-A", ""]))),
      Some(mutate(r, r.pick(["600", "-1", "99999999999", "+5", " 7 ", "1e3"]))),
    )
    feed(h, pf.allowed.to_string() + pf.max_age.to_string() + pf.reason)
    feed(h, csp::is_cors_safelisted_request_header(r.pick(["accept", "Content-Type", "accept-language", "range"]), mutate(r, r.pick(["text/plain", "application/json", "en-US", "text/plain;charset=utf-8", "bytes=0-"]))).to_string())
    i = i + 1
  }
  io_println(
    world,
    "fuzz seed=" + seed.to_string() + " n=" + n.to_string() + " parsed=" + parsed.to_string() +
    " errors=" + errors.to_string() + " allowed_checks=" + allowed.to_string() + " serialize_not_fixpoint=" +
    idem_viol.to_string() + " serialize_changes_decision=" + sem_viol.to_string() + " sha256=" + h.finalize_hex(),
  )
  0
}

// ---------------------------------------------------------------------------
// dos
// ---------------------------------------------------------------------------

///|
fn big_limits() -> csp::ParseLimits {
  csp::ParseLimits::new(2147483647, 2147483647, 2147483647, 2147483647)
}

///|
fn run_dos(world : World, args : Array[String]) -> Int {
  let what = args[2]
  let n = parse_int(args[3])
  let t0 = clock_now_ms(world)
  let mut out = ""
  if what == "sources" {
    // one directive with n host-sources (limits lifted), then a check that scans all of them
    let sb = StringBuilder::new()
    sb.write_string("script-src")
    let mut k = 0
    while k < n {
      sb.write_string(" https://h" + k.to_string() + ".example.com/p/")
      k = k + 1
    }
    let hdr = sb.to_string()
    let r = csp::parse_csp_with_limits(hdr, big_limits())
    let r_def = match csp::parse_csp(hdr) {
      Ok(_) => "ok"
      Err(e) => csp::csp_error_message(e)
    }
    match r {
      Ok(p) => {
        let d = csp::check_source(p, "script-src-elem", "https://app.com", "https://nomatch.com/x.js", "", [], true)
        out = "bytes=" + hdr.length().to_string() + " sources=" + p.directives[0].sources.length().to_string() + " allowed=" + d.allowed.to_string() + " default_limits=[" + r_def + "]"
      }
      Err(e) => out = "err " + csp::csp_error_message(e)
    }
  } else if what == "directives" {
    // n distinct directive names (limits lifted): first-wins lookup is O(n^2)
    let sb = StringBuilder::new()
    let mut k = 0
    while k < n {
      sb.write_string("x-d" + k.to_string() + " a; ")
      k = k + 1
    }
    sb.write_string("script-src 'none'")
    let hdr = sb.to_string()
    match csp::parse_csp_with_limits(hdr, big_limits()) {
      Ok(p) => {
        let d = csp::check_source(p, "script-src", "https://app.com", "https://x.com/", "", [], true)
        out = "bytes=" + hdr.length().to_string() + " directives=" + p.directives.length().to_string() + " allowed=" + d.allowed.to_string()
      }
      Err(e) => out = "err " + csp::csp_error_message(e)
    }
  } else if what == "dups" {
    // n duplicate directives, the case an injector uses: all skipped by first-wins
    let sb = StringBuilder::new()
    let mut k = 0
    while k < n {
      sb.write_string("script-src *; ")
      k = k + 1
    }
    let hdr = sb.to_string()
    match csp::parse_csp_with_limits(hdr, big_limits()) {
      Ok(p) => out = "bytes=" + hdr.length().to_string() + " directives=" + p.directives.length().to_string()
      Err(e) => out = "err " + csp::csp_error_message(e)
    }
  } else if what == "default" {
    // worst case within ParseLimits::default(): 64 KiB, 64 directives x 256 sources, repeated n times
    let sb = StringBuilder::new()
    let mut len = 0
    let mut d = 0
    while d < 64 && len < 65000 {
      let name = (if d == 0 { "" } else { ";" }) + "script-src" + d.to_string()
      sb.write_string(name)
      len = len + name.length()
      let mut s = 0
      while s < 256 && len < 65000 {
        sb.write_string(" a")
        len = len + 2
        s = s + 1
      }
      d = d + 1
    }
    let hdr = sb.to_string()
    let mut ok = 0
    let mut it = 0
    while it < n {
      match csp::parse_csp(hdr) {
        Ok(_) => ok = ok + 1
        Err(_) => ()
      }
      it = it + 1
    }
    out = "bytes=" + hdr.length().to_string() + " iters=" + n.to_string() + " ok=" + ok.to_string()
  } else if what == "list" {
    // n comma-separated policies in one header (limits lifted) + intersection check
    let sb = StringBuilder::new()
    let mut k = 0
    while k < n {
      sb.write_string("script-src https://a.com, ")
      k = k + 1
    }
    match csp::parse_csp_list_with_limits([sb.to_string()], big_limits()) {
      Ok(ps) => {
        let d = csp::check_source_all(ps, "script-src", "https://app.com", "https://a.com/x", "", [], true)
        out = "policies=" + ps.length().to_string() + " allowed=" + d.allowed.to_string()
      }
      Err(e) => out = "err " + csp::csp_error_message(e)
    }
  } else if what == "cors" {
    // Access-Control-Allow-Headers with n names x m request headers (no size limit in the API)
    let m = parse_int(args[4])
    let sb = StringBuilder::new()
    let mut k = 0
    while k < n {
      sb.write_string("x-h" + k.to_string() + ", ")
      k = k + 1
    }
    let req : Array[String] = []
    k = 0
    while k < m {
      req.push("x-r" + k.to_string())
      k = k + 1
    }
    let d = csp::check_cors_preflight("https://app.com", csp::CredentialsMode::Omit, "PUT", req, Some("https://app.com"), None, Some("PUT"), Some(sb.to_string()), None)
    out = "allow_headers_bytes=" + sb.to_string().length().to_string() + " req=" + m.to_string() + " allowed=" + d.allowed.to_string()
  } else if what == "url" {
    // check_source on an n-byte target URL (path traversal scan) against a path source
    let p = match csp::parse_csp("img-src https://a.com/p/") {
      Ok(p) => p
      Err(_) => return 1
    }
    let sb = StringBuilder::new()
    sb.write_string("https://a.com/p/")
    let mut k = 0
    while k < n {
      sb.write_string("%2e/")
      k = k + 1
    }
    let u = sb.to_string()
    let d = csp::check_source(p, "img-src", "https://a.com", u, "", [], true)
    out = "url_bytes=" + u.length().to_string() + " allowed=" + d.allowed.to_string()
  } else {
    io_eprintln(world, "unknown dos kind " + what)
    return 2
  }
  io_println(world, "dos " + what + " n=" + n.to_string() + " " + out + " ms=" + (clock_now_ms(world) - t0).to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() > 1 { args[1] } else { "" }
  if mode == "eval" && args.length() > 2 {
    run_eval(world, args[2])
  } else if mode == "fuzz" && args.length() > 3 {
    run_fuzz(world, parse_int(args[2]), parse_int(args[3]))
  } else if mode == "dos" && args.length() > 3 {
    run_dos(world, args)
  } else {
    io_eprintln(world, "usage: oracle eval <tsv> | fuzz <seed> <n> | dos sources|directives|dups|default|list|cors|url <n> [m]")
    2
  }
}
