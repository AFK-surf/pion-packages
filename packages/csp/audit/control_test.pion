///| Red-team CONTROL tests for `packages/csp` @ 65d3864 (feat/pkg-csp).
///|
///| Every `control_*` test pins an attack the package already defeats (or a spec rule it already
///| follows). They MUST PASS on the audited baseline and after any fix: a failure is a regression.

import "csp"

///|
fn lim_err(r : Result[csp::CspPolicy, csp::CspError]) -> String {
  match r {
    Ok(_) => "ok"
    Err(csp::CspError::InvalidLimits(_)) => "invalid"
    Err(csp::CspError::LimitExceeded(_)) => "exceeded"
    Err(csp::CspError::InvalidHeader(_)) => "header"
  }
}

///|
fn list_err(r : Result[Array[csp::CspPolicy], csp::CspError]) -> String {
  match r {
    Ok(ps) => "ok" + ps.length().to_string()
    Err(csp::CspError::InvalidLimits(_)) => "invalid"
    Err(csp::CspError::LimitExceeded(_)) => "exceeded"
    Err(csp::CspError::InvalidHeader(_)) => "header"
  }
}

// ---------------------------------------------------------------------------
// ParseLimits: negative / 0 / exact / exact+1
// ---------------------------------------------------------------------------

///|
test "control_limits_negative_zero_exact_and_exact_plus_one" {
  let h = "script-src a b" // 14 bytes, 1 directive, 2 sources
  debug_assert(lim_err(csp::parse_csp_with_limits(h, csp::ParseLimits::new(-1, 1, 1, 2))) == "invalid", "neg bytes")
  debug_assert(lim_err(csp::parse_csp_with_limits(h, csp::ParseLimits::new(14, -1, 1, 2))) == "invalid", "neg policies")
  debug_assert(lim_err(csp::parse_csp_with_limits(h, csp::ParseLimits::new(14, 1, -1, 2))) == "invalid", "neg dirs")
  debug_assert(lim_err(csp::parse_csp_with_limits(h, csp::ParseLimits::new(14, 1, 1, -1))) == "invalid", "neg srcs")
  debug_assert(lim_err(csp::parse_csp_with_limits(h, csp::ParseLimits::new(14, 1, 1, 2))) == "ok", "exact")
  debug_assert(lim_err(csp::parse_csp_with_limits(h, csp::ParseLimits::new(13, 1, 1, 2))) == "exceeded", "bytes exact-1")
  debug_assert(lim_err(csp::parse_csp_with_limits(h, csp::ParseLimits::new(14, 0, 1, 2))) == "exceeded", "policies 0")
  debug_assert(lim_err(csp::parse_csp_with_limits(h, csp::ParseLimits::new(14, 1, 0, 2))) == "exceeded", "dirs 0")
  debug_assert(lim_err(csp::parse_csp_with_limits(h, csp::ParseLimits::new(14, 1, 1, 1))) == "exceeded", "srcs exact-1")
  // duplicates count toward the directive limit (an injector cannot hide a flood behind first-wins)
  debug_assert(lim_err(csp::parse_csp_with_limits("a; a; a", csp::ParseLimits::new(100, 1, 2, 0))) == "exceeded", "dup flood")
  // list: policies exact / exact+1, total bytes across headers exact / exact+1
  let l2 = csp::ParseLimits::new(100, 2, 4, 4)
  debug_assert(list_err(csp::parse_csp_list_with_limits(["a, b"], l2)) == "ok2", "2 policies")
  debug_assert(list_err(csp::parse_csp_list_with_limits(["a, b", "c"], l2)) == "exceeded", "3 policies")
  let l9 = csp::ParseLimits::new(9, 8, 4, 4)
  debug_assert(list_err(csp::parse_csp_list_with_limits(["abcd", "efghi"], l9)) == "ok2", "9 bytes total")
  debug_assert(list_err(csp::parse_csp_list_with_limits(["abcd", "efghij"], l9)) == "exceeded", "10 bytes total")
  // empty / whitespace-only list members produce no policy (not an error)
  debug_assert(list_err(csp::parse_csp_list([" , ,", ""])) == "ok0", "empty members")
}

///|
test "control_header_injection_bytes_rejected" {
  debug_assert(lim_err(csp::parse_csp("script-src 'self'\r\nX: y")) == "header", "CRLF")
  debug_assert(lim_err(csp::parse_csp("script-src 'self'\u{00}*")) == "header", "NUL")
  debug_assert(lim_err(csp::parse_csp("script-src 'self'\u{0b}*")) == "header", "VT")
  debug_assert(lim_err(csp::parse_csp("script-src 'self'\u{7f}")) == "header", "DEL")
  debug_assert(list_err(csp::parse_csp_list(["img-src *", "script-src\n*"])) == "header", "LF in list")
}

// ---------------------------------------------------------------------------
// CSP3 source matching boundaries that hold
// ---------------------------------------------------------------------------

///|
test "control_wildcard_subdomain_boundaries" {
  let p = pol("img-src *.example.com")
  let pg = "https://app.com"
  debug_assert(allows(p, "img-src", pg, "https://a.example.com/x"), "subdomain")
  debug_assert(allows(p, "img-src", pg, "https://a.b.EXAMPLE.com/x"), "deep + case")
  debug_assert(!allows(p, "img-src", pg, "https://example.com/x"), "bare domain")
  debug_assert(!allows(p, "img-src", pg, "https://evilexample.com/x"), "suffix spoof")
  debug_assert(!allows(p, "img-src", pg, "https://a.example.com.evil.com/x"), "suffix in the middle")
  debug_assert(!allows(p, "img-src", pg, "https://a.example.com./x"), "trailing dot is a different host string")
}

///|
test "control_bare_star_never_matches_local_schemes" {
  let p = pol("img-src *")
  let pg = "https://app.com"
  debug_assert(allows(p, "img-src", pg, "https://any.com/x"), "https")
  debug_assert(allows(p, "img-src", pg, "http://any.com/x"), "http")
  let bad = ["data:image/png;base64,AA", "blob:https://app.com/1", "filesystem:https://app.com/t/x", "javascript:alert(1)", "about:blank"]
  let mut i = 0
  while i < bad.length() {
    debug_assert(!allows(p, "img-src", pg, bad[i]), "* matched " + bad[i])
    i = i + 1
  }
}

///|
test "control_scheme_upgrade_never_downgrade_and_default_ports" {
  let pg = "https://app.com"
  debug_assert(allows(pol("img-src http://a.com"), "img-src", pg, "https://a.com/x"), "http -> https upgrade")
  debug_assert(!allows(pol("img-src https://a.com"), "img-src", pg, "http://a.com/x"), "https !-> http")
  debug_assert(!allows(pol("img-src https:"), "img-src", pg, "http://a.com/x"), "https: !-> http")
  debug_assert(!allows(pol("connect-src wss://a.com"), "connect-src", pg, "ws://a.com/s"), "wss !-> ws")
  debug_assert(allows(pol("connect-src ws://a.com"), "connect-src", pg, "wss://a.com/s"), "ws -> wss")
  debug_assert(allows(pol("img-src https://a.com"), "img-src", pg, "https://a.com:443/x"), "explicit default port")
  debug_assert(allows(pol("img-src https://a.com:443"), "img-src", pg, "https://a.com/x"), "default port in expr")
  debug_assert(!allows(pol("img-src https://a.com"), "img-src", pg, "https://a.com:8443/x"), "other port")
  debug_assert(allows(pol("img-src http://a.com:80"), "img-src", pg, "https://a.com/x"), "http:80 -> https:443")
  debug_assert(!allows(pol("img-src https://a.com:443"), "img-src", pg, "http://a.com:80/x"), "no downgrade with ports")
  debug_assert(allows(pol("img-src https://a.com:*"), "img-src", pg, "https://a.com:9/x"), ":*")
  debug_assert(allows(pol("img-src [::1]:8443"), "img-src", pg, "https://[::1]:8443/x"), "IPv6")
  debug_assert(!allows(pol("img-src [::1]:8443"), "img-src", pg, "https://[::2]:8443/x"), "IPv6 other")
  debug_assert(allows(pol("img-src HTTPS://A.COM"), "img-src", pg, "hTTps://a.Com/X"), "case-insensitive")
  // out-of-range ports in the EXPRESSION drop the source (fail closed)
  debug_assert(!allows(pol("img-src https://a.com:65536"), "img-src", pg, "https://a.com/x"), "65536")
  debug_assert(!allows(pol("img-src https://a.com:999999"), "img-src", pg, "https://a.com/x"), "999999")
}

///|
test "control_userinfo_single_at_and_path_traversal" {
  let pg = "https://app.com"
  let p = pol("script-src https://trusted.com")
  debug_assert(!allows(p, "script-src", pg, "https://trusted.com@evil.com/a.js"), "userinfo spoof")
  debug_assert(!allows(p, "script-src", pg, "https://trusted.com:443@evil.com/a.js"), "userinfo with port spoof")
  debug_assert(!allows(p, "script-src", pg, "https://evil.com#@trusted.com/"), "fragment @")
  debug_assert(!allows(p, "script-src", pg, "https://evil.com?@trusted.com/"), "query @")
  let q = pol("script-src https://cdn.example.com/safe/")
  debug_assert(allows(q, "script-src", pg, "https://cdn.example.com/safe/a.js?x#y"), "prefix + query")
  debug_assert(!allows(q, "script-src", pg, "https://cdn.example.com/safe/../../evil.js"), "..")
  debug_assert(!allows(q, "script-src", pg, "https://cdn.example.com/safe/%2e%2e/evil.js"), "%2e%2e")
  debug_assert(!allows(q, "script-src", pg, "https://cdn.example.com/safe/.%2E/evil.js"), ".%2E")
  debug_assert(!allows(q, "script-src", pg, "https://cdn.example.com/safe/..%2fevil.js"), "%2f")
  debug_assert(!allows(q, "script-src", pg, "https://cdn.example.com/safe\\..\\evil.js"), "backslash")
  debug_assert(!allows(q, "script-src", pg, "https://cdn.example.com/safeX/a.js"), "prefix needs /")
  let f = pol("script-src https://cdn.example.com/safe/a.js")
  debug_assert(!allows(f, "script-src", pg, "https://cdn.example.com/safe/a.js/x"), "exact file")
}

// ---------------------------------------------------------------------------
// nonce / hash / 'strict-dynamic' / 'unsafe-inline' / 'none'
// ---------------------------------------------------------------------------

///|
test "control_nonce_hash_strict_dynamic_inline" {
  let p = pol("script-src 'unsafe-inline' 'nonce-AbC123' 'SHA256-Dg==' https://cdn.com")
  debug_assert(!csp::check_inline_script(p, "", [], false).allowed, "unsafe-inline ignored when nonce/hash present")
  debug_assert(csp::check_inline_script(p, "AbC123", [], false).allowed, "nonce ok")
  debug_assert(!csp::check_inline_script(p, "abc123", [], false).allowed, "nonce is case-sensitive")
  debug_assert(csp::check_inline_script(p, "", [("sha256", "Dg==")], false).allowed, "hash alg prefix is case-insensitive")
  debug_assert(!csp::check_inline_script(p, "", [("sha256", "dg==")], false).allowed, "digest is case-sensitive")
  debug_assert(!csp::check_inline_script(p, "AbC123", [], true).allowed, "nonce never on attributes")
  debug_assert(!csp::check_inline_script(p, "", [("sha256", "Dg==")], true).allowed, "hash on attribute needs unsafe-hashes")
  let uh = pol("script-src 'unsafe-hashes' 'sha256-Dg=='")
  debug_assert(csp::check_inline_script(uh, "", [("sha256", "Dg==")], true).allowed, "unsafe-hashes")
  let empty_nonce = pol("script-src 'nonce-' 'sha256-'")
  debug_assert(!csp::check_inline_script(empty_nonce, "", [("sha256", "")], false).allowed, "empty nonce/hash never match")
  let sd = pol("script-src 'strict-dynamic' 'nonce-n1' https://cdn.com 'self' 'unsafe-inline'")
  let pg = "https://app.com"
  debug_assert(!csp::check_source(sd, "script-src-elem", pg, "https://cdn.com/a.js", "", [], true).allowed, "strict-dynamic ignores host allowlist")
  debug_assert(!csp::check_source(sd, "script-src-elem", pg, "https://app.com/a.js", "", [], true).allowed, "strict-dynamic ignores 'self'")
  debug_assert(csp::check_source(sd, "script-src-elem", pg, "https://x.com/a.js", "n1", [], true).allowed, "nonce'd parser-inserted")
  debug_assert(csp::check_source(sd, "script-src-elem", pg, "https://x.com/a.js", "", [], false).allowed, "non-parser-inserted")
  debug_assert(!csp::check_inline_script(sd, "", [], false).allowed, "unsafe-inline ignored with strict-dynamic")
  // 'strict-dynamic' in style-src does not drop the style allowlist
  debug_assert(allows(pol("style-src 'strict-dynamic' https://cdn.com"), "style-src", pg, "https://cdn.com/a.css"), "style allowlist kept")
  // 'none' with other sources is ignored; alone or empty list blocks
  debug_assert(allows(pol("img-src 'none' https://a.com"), "img-src", pg, "https://a.com/x"), "'none' + others")
  debug_assert(!allows(pol("img-src 'none'"), "img-src", pg, "https://a.com/x"), "'none'")
  debug_assert(!allows(pol("img-src"), "img-src", pg, "https://a.com/x"), "empty list")
  debug_assert(!allows(pol("img-src https://a.com:99999"), "img-src", pg, "https://a.com/x"), "list of only invalid sources")
  debug_assert(!csp::check_eval(pol("default-src 'self'")).allowed, "eval via default-src")
  debug_assert(csp::check_wasm_eval(pol("script-src 'wasm-unsafe-eval'")).allowed && !csp::check_eval(pol("script-src 'wasm-unsafe-eval'")).allowed, "wasm vs eval")
}

///|
test "control_fallback_chains_and_first_wins_and_intersection" {
  let pg = "https://app.com"
  let p = pol("default-src 'none'; script-src https://s.com; child-src https://c.com")
  debug_assert(allows(p, "script-src-elem", pg, "https://s.com/x"), "elem -> script-src")
  debug_assert(allows(p, "worker-src", pg, "https://c.com/x") && !allows(p, "worker-src", pg, "https://s.com/x"), "worker -> child first")
  debug_assert(allows(p, "frame-src", pg, "https://c.com/x"), "frame -> child")
  debug_assert(!allows(p, "img-src", pg, "https://s.com/x"), "img -> default")
  let nd = pol("default-src 'none'")
  let never = ["base-uri", "form-action", "frame-ancestors"]
  let mut i = 0
  while i < never.length() {
    debug_assert(allows(nd, never[i], pg, "https://evil.com/"), never[i] + " must not fall back to default-src")
    i = i + 1
  }
  let fw = pol("script-src 'none'; SCRIPT-SRC *; script-src https:")
  debug_assert(!allows(fw, "script-src", pg, "https://evil.com/x.js"), "first directive wins (case-insensitive)")
  let ps = match csp::parse_csp_list(["script-src *", "script-src https://a.com, img-src *"]) {
    Ok(ps) => ps
    Err(_) => []
  }
  debug_assert(ps.length() == 3, "3 policies")
  debug_assert(!csp::check_source_all(ps, "script-src", pg, "https://b.com/x", "", [], true).allowed, "intersection")
  debug_assert(csp::check_source_all(ps, "script-src", pg, "https://a.com/x", "", [], true).allowed, "intersection allow")
}

// ---------------------------------------------------------------------------
// WHATWG Fetch CORS
// ---------------------------------------------------------------------------

///|
test "control_cors_credentials_and_acao" {
  let o = "https://app.com"
  let inc = csp::CredentialsMode::Include
  let omit = csp::CredentialsMode::Omit
  debug_assert(!csp::check_cors_response(o, inc, Some("*"), Some("true"), None).allowed, "* + include")
  debug_assert(!csp::check_cors_response(o, inc, Some(o), Some("TRUE"), None).allowed, "TRUE")
  debug_assert(!csp::check_cors_response(o, inc, Some(o), None, None).allowed, "no ACAC")
  debug_assert(!csp::check_cors_response(o, inc, Some(o), Some("true, true"), None).allowed, "ACAC list")
  debug_assert(csp::check_cors_response(o, inc, Some(o), Some("true"), None).allowed, "include ok")
  debug_assert(!csp::check_cors_response(o, omit, Some("https://app.com, https://b.com"), None, None).allowed, "multi ACAO")
  debug_assert(!csp::check_cors_response(o, omit, Some(",https://app.com"), None, None).allowed, "leading comma")
  debug_assert(!csp::check_cors_response(o, omit, Some("https://APP.com"), None, None).allowed, "byte-exact ACAO")
  debug_assert(!csp::check_cors_response(o, omit, Some("https://app.com/"), None, None).allowed, "ACAO with path")
  debug_assert(!csp::check_cors_response(o, omit, None, None, None).allowed, "missing ACAO")
  debug_assert(csp::check_cors_response(o, omit, Some("*"), None, None).allowed, "* without credentials")
  // Fetch §4.10 CORS check compares the byte-serialised request origin: `null` == `null` PASSES (spec).
  debug_assert(csp::check_cors_response("null", omit, Some("null"), None, None).allowed, "Fetch: null/null passes")
  debug_assert(!csp::origin_equals(csp::parse_origin("null"), csp::parse_origin("null")), "opaque != opaque")
  let ex = csp::check_cors_response(o, inc, Some(o), Some("true"), Some("*, X-A"))
  debug_assert(!ex.wildcard_exposed && ex.exposed_headers.length() == 1, "* not expanded with include")
  let ex2 = csp::check_cors_response(o, omit, Some("*"), None, Some("*"))
  debug_assert(ex2.wildcard_exposed, "* expanded without include")
}

///|
fn pf(mode : csp::CredentialsMode, method : String, hdrs : Array[String], am : String, ah : String, ma : String) -> csp::CorsPreflightDecision {
  let o = "https://app.com"
  let acao = match mode {
    csp::CredentialsMode::Include => o
    _ => "*"
  }
  csp::check_cors_preflight(o, mode, method, hdrs, Some(acao), Some("true"), Some(am), Some(ah), Some(ma))
}

///|
test "control_cors_preflight_authorization_and_max_age" {
  let inc = csp::CredentialsMode::Include
  let omit = csp::CredentialsMode::Omit
  debug_assert(!pf(omit, "GET", ["authorization"], "", "*", "").allowed, "* never covers Authorization")
  debug_assert(pf(omit, "GET", ["Authorization"], "", "*, AUTHORIZATION", "").allowed, "explicit Authorization")
  debug_assert(pf(omit, "GET", ["x-a"], "", "*", "").allowed, "* covers x-a without credentials")
  debug_assert(!pf(inc, "GET", ["x-a"], "", "*", "").allowed, "* literal with include")
  debug_assert(!pf(inc, "PUT", [], "*", "", "").allowed, "methods * literal with include")
  debug_assert(pf(omit, "PUT", [], "*", "", "").allowed, "methods * without include")
  debug_assert(!pf(omit, "put", [], "PUT", "", "").allowed, "method byte-case-sensitive")
  debug_assert(pf(omit, "GET", [], "", "", "-1").max_age == 0, "negative max-age")
  debug_assert(pf(omit, "GET", [], "", "", "99999999999999999999").max_age == 0, "overflowing max-age")
  debug_assert(pf(omit, "GET", [], "", "", "1e3").max_age == 0, "non-numeric max-age")
  debug_assert(pf(omit, "GET", [], "", "", "600").max_age == 600, "max-age")
}

///|
test "control_cors_safelisted_request_headers" {
  debug_assert(csp::is_cors_safelisted_request_header("Content-Type", "text/plain;charset=UTF-8"), "text/plain")
  debug_assert(!csp::is_cors_safelisted_request_header("content-type", "application/json"), "json")
  debug_assert(!csp::is_cors_safelisted_request_header("content-type", "text/plain, application/json"), "two types")
  debug_assert(!csp::is_cors_safelisted_request_header("content-type", "text/plain; x=\"a\""), "quote byte")
  debug_assert(!csp::is_cors_safelisted_request_header("accept", "a\u{01}"), "C0 byte")
  debug_assert(!csp::is_cors_safelisted_request_header("accept", "a\u{7f}"), "DEL")
  debug_assert(csp::is_cors_safelisted_request_header("accept", "a\tb"), "HTAB allowed")
  let mut v = ""
  let mut i = 0
  while i < 128 {
    v = v + "a"
    i = i + 1
  }
  debug_assert(csp::is_cors_safelisted_request_header("accept", v), "128 B")
  debug_assert(!csp::is_cors_safelisted_request_header("accept", v + "a"), "129 B")
  debug_assert(!csp::is_cors_safelisted_request_header("accept-language", "en_US"), "language byte")
  debug_assert(!csp::is_cors_safelisted_request_header("authorization", "x"), "authorization")
}

///|
test "control_parse_origin_normalisation" {
  let a = csp::parse_origin("HTTPS://App.Example.COM:443/p?q#f")
  debug_assert(csp::format_origin(a) == "https://app.example.com", "normalised")
  debug_assert(csp::origin_equals(a, csp::parse_origin("https://app.example.com")), "default port")
  debug_assert(!csp::origin_equals(a, csp::parse_origin("http://app.example.com")), "scheme")
  debug_assert(!csp::origin_equals(a, csp::parse_origin("https://app.example.com:8443")), "port")
  debug_assert(csp::format_origin(csp::parse_origin("https://trusted.com@evil.com/")) == "https://evil.com", "userinfo")
  let opaque = ["data:text/html,x", "file:///etc/passwd", "javascript:alert(1)", "about:blank", "null", "https://a.com:99999"]
  let mut i = 0
  while i < opaque.length() {
    debug_assert(csp::format_origin(csp::parse_origin(opaque[i])) == "null", "opaque " + opaque[i])
    i = i + 1
  }
}
