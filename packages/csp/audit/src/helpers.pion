///| Shared helpers for the `packages/csp` red-team audit tests (audit-only code, never shipped).

import "csp"

///| An empty policy (no directives): what a caller has after a parse error it ignores.
pub fn empty_policy() -> csp::CspPolicy {
  csp::CspPolicy::{
    directives: [],
    upgrade_insecure_requests: false,
    block_all_mixed_content: false,
    sandbox_tokens: None,
    report_uri: [],
    report_to: None,
  }
}

///| Parse one header with default limits; asserts success.
pub fn pol(header : String) -> csp::CspPolicy {
  match csp::parse_csp(header) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "fixture: parse_csp failed: " + csp::csp_error_message(e))
      empty_policy()
    }
  }
}

///| `check_source` for an external parser-inserted fetch with no nonce and no hashes.
pub fn allows(policy : csp::CspPolicy, directive : String, page : String, url : String) -> Bool {
  csp::check_source(policy, directive, page, url, "", [], true).allowed
}
