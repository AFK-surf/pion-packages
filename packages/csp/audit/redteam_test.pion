///| Red-team FINDING tests for `packages/csp` @ 65d3864 (feat/pkg-csp).
///|
///| Every `p0_*` / `p1_*` / `p2_*` test asserts what W3C CSP3 / WHATWG URL / WHATWG Fetch require
///| and therefore FAILS on the audited baseline: the failure (its assertion message) is the
///| evidence. A fix is complete when the test turns green without weakening it. See README.md.
///| The expected browser behaviour of every URL below was checked with Node's WHATWG `URL`
///| (diff/cspref.mjs).

import "csp"

///|
let page : String = "https://app.com"

// ---------------------------------------------------------------------------
// P0: allowlisted-host bypass (raw URL strings, the form the package's own tests use)
// ---------------------------------------------------------------------------

///| P0-1 csp.pion:681-691 + 709: the authority ends only at / ? #, so for a special scheme the `\`
///| (which WHATWG URL treats as `/`) stays inside it and the first `@` after it is taken as the
///| userinfo end. A browser fetches https://evil.com/@trusted.com/x.js.
test "p0_backslash_authority_confusion_allows_evil_host" {
  let p = pol("script-src https://trusted.com")
  debug_assert(
    !allows(p, "script-src-elem", page, "https://evil.com\\@trusted.com/x.js"),
    "P0-1: script-src https://trusted.com ALLOWS https://evil.com\\@trusted.com/x.js (browser host: evil.com)",
  )
}

///| P0-1 (wildcard form): `*.trusted.com` is bypassed the same way.
test "p0_backslash_authority_confusion_wildcard_host" {
  let p = pol("script-src *.trusted.com")
  debug_assert(
    !allows(p, "script-src-elem", page, "https://evil.com\\@cdn.trusted.com/x.js"),
    "P0-1: script-src *.trusted.com ALLOWS https://evil.com\\@cdn.trusted.com/x.js (browser host: evil.com)",
  )
}

///| P0-2 csp.pion:709 + 727-733: userinfo ends at the FIRST `@` (WHATWG: the LAST), and the
///| unparsable port "1@evil.com" is silently replaced by the default port. Host = trusted.com:443;
///| a browser fetches https://evil.com/x.js (userinfo "u%40trusted.com:1").
test "p0_multi_at_userinfo_plus_port_fallback_allows_evil_host" {
  let p = pol("script-src https://trusted.com")
  debug_assert(
    !allows(p, "script-src-elem", page, "https://u@trusted.com:1@evil.com/x.js"),
    "P0-2: script-src https://trusted.com ALLOWS https://u@trusted.com:1@evil.com/x.js (browser host: evil.com)",
  )
}

// ---------------------------------------------------------------------------
// P1
// ---------------------------------------------------------------------------

///| P1-3 csp.pion:86-104 (`end - start > 5` -> -1) + 720-733 (-1 keeps the default port): every
///| unparsable URL port fails OPEN to the default. WHATWG URL accepts leading zeros
///| (`:00008443` = 8443) and strips tabs (`:8<TAB>443` = 8443): a port-pinned allowlist is
///| bypassed to another port on the same host.
test "p1_url_port_parse_failure_fails_open_to_default_port" {
  let p = pol("script-src https://trusted.com")
  debug_assert(!allows(p, "script-src-elem", page, "https://trusted.com:8443/x.js"), "fixture: 8443 is blocked")
  debug_assert(
    !allows(p, "script-src-elem", page, "https://trusted.com:00008443/x.js"),
    "P1-3: https://trusted.com:00008443 (= port 8443) matched https://trusted.com (443 only)",
  )
}

///| P1-3 (tab variant).
test "p1_url_port_with_tab_fails_open_to_default_port" {
  let p = pol("script-src https://trusted.com")
  debug_assert(
    !allows(p, "script-src-elem", page, "https://trusted.com:8\t443/x.js"),
    "P1-3: https://trusted.com:8<TAB>443 (= port 8443) matched https://trusted.com (443 only)",
  )
}

///| P1-4 csp.pion:791-840: ASCII tab / LF / CR are not removed before the `..` segment scan, but
///| WHATWG URL removes them first: `.<TAB>.` IS `..` to the browser, which fetches /evil.js.
test "p1_tab_inside_dot_segment_bypasses_path_restriction" {
  let p = pol("script-src https://cdn.trusted.com/safe/")
  debug_assert(!allows(p, "script-src-elem", page, "https://cdn.trusted.com/safe/../evil.js"), "fixture: .. blocked")
  debug_assert(
    !allows(p, "script-src-elem", page, "https://cdn.trusted.com/safe/.\t./evil.js"),
    "P1-4: /safe/.<TAB>./evil.js (browser path /evil.js) matched script-src https://cdn.trusted.com/safe/",
  )
}

///| P1-5 csp.pion:401-545: `parse_csp` (the single-header API) never splits on `,`. A combined field
///| value (RFC 9110 §5.3 joins repeated headers with ", ") becomes ONE policy whose source list is
///| the UNION: here https://cdn.com is allowed although the first policy only allows 'self'.
///| CSP3 §2.2.2 makes it two policies that must BOTH allow.
test "p1_parse_csp_merges_comma_separated_policies_into_a_union" {
  let p = pol("script-src 'self', script-src https://cdn.com")
  debug_assert(
    !allows(p, "script-src-elem", page, "https://cdn.com/a.js"),
    "P1-5: parse_csp(\"script-src 'self', script-src https://cdn.com\") ALLOWS https://cdn.com/a.js (browser: blocked by the 1st policy)",
  )
}

///| P1-5 (the stray token becomes a host-source): `script-src` from the second policy is parsed as
///| a host-source "script-src", which matches the single-label intranet host https://script-src/.
test "p1_parse_csp_comma_turns_directive_name_into_host_source" {
  let p = pol("script-src 'none', script-src 'none'")
  debug_assert(
    !allows(p, "script-src-elem", page, "https://script-src/x.js"),
    "P1-5: script-src 'none', script-src 'none' ALLOWS https://script-src/x.js",
  )
}

///| P1-6 csp.pion:160-175 / 565-579: one non-ASCII byte ANYWHERE rejects the whole header AND every
///| other policy of the list (CSP3 §2.2.1 step 2.1 only skips the non-ASCII token). An injector who
///| can place one byte in any header (a reflected report-uri, a policy assembled from a template)
///| turns the strict policy into an Err; a caller that treats Err as "no CSP" loads anything.
test "p1_one_non_ascii_byte_discards_every_policy" {
  let r = csp::parse_csp_list(["script-src 'none'", "report-uri https://r.example/\u{e9}"])
  let strict = match r {
    Ok(ps) => !csp::check_source_all(ps, "script-src-elem", page, "https://evil.com/x.js", "", [], true).allowed
    Err(_) => false
  }
  debug_assert(strict, "P1-6: a non-ASCII byte in the 2nd header made parse_csp_list fail: script-src 'none' is lost")
}

///| P1-6 (limits): ParseLimits overflow is also all-or-nothing: 257 sources in one directive drop
///| an unrelated `default-src 'none'` policy. Real allowlists of ad-heavy sites exceed 256 hosts.
test "p1_limit_overflow_in_one_directive_discards_the_policy" {
  let sb = StringBuilder::new()
  sb.write_string("default-src 'none'; img-src")
  let mut k = 0
  while k < 257 {
    sb.write_string(" https://h" + k.to_string() + ".com")
    k = k + 1
  }
  let strict = match csp::parse_csp(sb.to_string()) {
    Ok(p) => !allows(p, "script-src-elem", page, "https://evil.com/x.js")
    Err(_) => false
  }
  debug_assert(strict, "P1-6: 257 img-src sources made parse_csp fail: default-src 'none' is lost")
}

///| P1-7 csp.pion:969-1017 + 1122-1131: a directive name outside the hard-coded list has no
///| fallback and check_source answers allowed:true. CSP3 (fenced-frame-src -> frame-src -> child-src
///| -> default-src) blocks it under default-src 'none'; so must any unknown fetch directive.
test "p1_unknown_fetch_directive_fails_open_under_default_src_none" {
  let p = pol("default-src 'none'")
  debug_assert(
    !allows(p, "fenced-frame-src", page, "https://evil.com/"),
    "P1-7: default-src 'none' ALLOWS fenced-frame-src https://evil.com/",
  )
}

///| P1-8 (CORS half of P0-1) cors.pion:187-207: parse_origin keeps `\` in the authority and takes
///| the first `@`: the origin of https://evil.com\@trusted.com/ is reported as https://trusted.com.
///| Any caller doing same-origin decisions with origin_equals(parse_origin(url), ...) is fooled.
test "p1_parse_origin_backslash_reports_trusted_origin" {
  let o = csp::parse_origin("https://evil.com\\@trusted.com/")
  debug_assert(
    !csp::origin_equals(o, csp::parse_origin("https://trusted.com")),
    "P1-8: parse_origin(\"https://evil.com\\\\@trusted.com/\") == https://trusted.com (WHATWG: https://evil.com)",
  )
}

// ---------------------------------------------------------------------------
// P2
// ---------------------------------------------------------------------------

///| P2-9 csp.pion:912-918: with an opaque / empty page origin (sandboxed document, `null`) a
///| scheme-less host-source skips the scheme check entirely: `img-src trusted.com` matches
///| http:// (downgrade) and any scheme. CSP3 §6.7.2.8: no scheme-part match -> Does Not Match.
test "p2_opaque_page_origin_skips_scheme_check" {
  let p = pol("img-src trusted.com")
  debug_assert(!allows(p, "img-src", "https://app.com", "foo://trusted.com/x"), "fixture: foo: blocked with a real origin")
  debug_assert(
    !allows(p, "img-src", "null", "foo://trusted.com:9999/x"),
    "P2-9: page origin null + img-src trusted.com ALLOWS foo://trusted.com:9999/x",
  )
}

///| P2-10 csp.pion:937-942: a host-source with no port for a scheme without a default port accepts
///| every port (CSP3 §6.7.2.8 port-part: empty port matches only url.port == null).
test "p2_scheme_without_default_port_accepts_any_port" {
  let p = pol("img-src foo://trusted.com")
  debug_assert(
    !allows(p, "img-src", page, "foo://trusted.com:9999/x"),
    "P2-10: img-src foo://trusted.com ALLOWS foo://trusted.com:9999/x",
  )
}

///| P2-11 csp.pion:1019-1031 + 1303: 'strict-dynamic' disables 'unsafe-inline' for styles too.
///| CSP3 §6.7.3.3 does so only for script / script attribute / navigation types.
test "p2_strict_dynamic_wrongly_blocks_inline_style" {
  let p = pol("style-src 'strict-dynamic' 'unsafe-inline'")
  debug_assert(
    csp::check_inline_style(p, "", [], false).allowed,
    "P2-11: style-src 'strict-dynamic' 'unsafe-inline' BLOCKS an inline <style>",
  )
}

///| P2-12 csp.pion:743-755: CSP3 §6.7.2.6 scheme-part match also lets ws match wss/http/https and
///| wss match https; csp.pion:862-880 'self' also matches wss:/ws: of the same host. Both missing
///| (over-blocks WebSocket and fetch to the own host).
test "p2_scheme_part_match_and_self_websocket_incomplete" {
  debug_assert(
    allows(pol("connect-src 'self'"), "connect-src", "https://app.com", "wss://app.com/s"),
    "P2-12: connect-src 'self' on https://app.com BLOCKS wss://app.com/s",
  )
}

///| P2-13 csp.pion:842-853: path parts are compared raw; CSP3 §6.7.2.9 percent-decodes both sides.
test "p2_path_match_not_percent_decoded" {
  let p = pol("img-src https://a.com/safe/")
  debug_assert(allows(p, "img-src", page, "https://a.com/saf%65/x.png"), "P2-13: /saf%65/ (= /safe/) BLOCKED")
}

///| P2-14 cors.pion:224-238: port 0 (valid in WHATWG URL) makes the origin opaque, and blob: URLs
///| (origin = the inner URL's origin) are opaque.
test "p2_parse_origin_port_zero_and_blob" {
  debug_assert(csp::format_origin(csp::parse_origin("https://a.com:0/")) == "https://a.com:0", "P2-14: port 0 -> null")
  debug_assert(
    csp::format_origin(csp::parse_origin("blob:https://a.com/uuid")) == "https://a.com",
    "P2-14: blob:https://a.com/uuid -> " + csp::format_origin(csp::parse_origin("blob:https://a.com/uuid")),
  )
}

///| P2-15 csp.pion:614-642: serialize_csp writes names / hosts / raw values verbatim. A policy built
///| in code (all fields are pub) from untrusted input injects directives or header lines.
test "p2_serialize_csp_does_not_escape_constructed_policies" {
  let d = csp::CspDirective::{
    name: "report-uri",
    sources: [],
    raw_values: ["https://r.example/\r\nSet-Cookie: s=1"],
  }
  let h = csp::CspDirective::{
    name: "img-src",
    sources: [csp::SourceExpression::Host(None, "a.com; script-src *", None, false, "")],
    raw_values: [],
  }
  let p = csp::CspPolicy::{
    directives: [h, d],
    upgrade_insecure_requests: false,
    block_all_mixed_content: false,
    sandbox_tokens: None,
    report_uri: [],
    report_to: None,
  }
  let s = csp::serialize_csp(p)
  debug_assert(
    match csp::parse_csp(s) {
      Ok(_) => true
      Err(_) => false
    },
    "P2-15: serialize_csp emitted a header its own parser rejects (CR/LF injection): " + s,
  )
}

///| P2-16 cors.pion:102-118 + 486-496: Access-Control-Max-Age has no upper bound (999,999,999 s =
///| 31 years is returned) and absent/invalid values give 0 instead of Fetch's default of 5.
test "p2_max_age_uncapped_and_wrong_default" {
  let d = csp::check_cors_preflight("https://app.com", csp::CredentialsMode::Omit, "GET", [], Some("*"), None, None, None, Some("999999999"))
  debug_assert(d.max_age <= 86400, "P2-16: max_age " + d.max_age.to_string() + " s accepted (engines cap at 7200 / 86400)")
}
