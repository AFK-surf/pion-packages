///| W3C Content Security Policy Level 3 (CSP3) & WHATWG Fetch CORS
///| compliance, security, and edge-case test suite.

fn must_parse(header : String) -> CspPolicy {
  match parse_csp(header) {
    Result::Ok(p) => p
    Result::Err(e) => {
      debug_assert(false, "expected parse_csp Ok, got: " + csp_error_message(e))
      CspPolicy::{
        directives: [],
        upgrade_insecure_requests: false,
        block_all_mixed_content: false,
        sandbox_tokens: Option::None,
        report_uri: [],
        report_to: Option::None,
      }
    }
  }
}

fn must_parse_list(headers : Array[String]) -> Array[CspPolicy] {
  match parse_csp_list(headers) {
    Result::Ok(ps) => ps
    Result::Err(e) => {
      debug_assert(false, "expected parse_csp_list Ok, got: " + csp_error_message(e))
      []
    }
  }
}

// ============================================================================
// 1. ParseLimits & Error Handling Tests
// ============================================================================

test "limits_reject_negative_values" {
  match parse_csp_with_limits("default-src 'self'", ParseLimits::new(-1, 10, 10, 10)) {
    Result::Err(CspError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "expected InvalidLimits for negative max_header_bytes")
  }
  match parse_csp_with_limits("default-src 'self'", ParseLimits::new(100, -1, 10, 10)) {
    Result::Err(CspError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "expected InvalidLimits for negative max_policies")
  }
  match parse_csp_with_limits("default-src 'self'", ParseLimits::new(100, 10, -1, 10)) {
    Result::Err(CspError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "expected InvalidLimits for negative max_directives_per_policy")
  }
  match parse_csp_with_limits("default-src 'self'", ParseLimits::new(100, 10, 10, -1)) {
    Result::Err(CspError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "expected InvalidLimits for negative max_sources_per_directive")
  }
}

test "limits_zero_means_strictly_zero" {
  // max_header_bytes == 0 allows empty header, rejects 1+ bytes
  match parse_csp_with_limits("", ParseLimits::new(0, 1, 0, 0)) {
    Result::Ok(p) => debug_assert(p.directives.length() == 0, "expected 0 directives")
    Result::Err(e) => debug_assert(false, "unexpected err: " + csp_error_message(e))
  }
  match parse_csp_with_limits("a", ParseLimits::new(0, 1, 10, 10)) {
    Result::Err(CspError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_header_bytes == 0")
  }
  // max_policies == 0 allows empty list, rejects any policy
  match parse_csp_list_with_limits([], ParseLimits::new(100, 0, 10, 10)) {
    Result::Ok(ps) => debug_assert(ps.length() == 0, "expected 0 policies")
    Result::Err(e) => debug_assert(false, "unexpected err: " + csp_error_message(e))
  }
  match parse_csp_list_with_limits(["default-src 'self'"], ParseLimits::new(100, 0, 10, 10)) {
    Result::Err(CspError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_policies == 0")
  }
  // max_directives_per_policy == 0 rejects 1 directive
  match parse_csp_with_limits("default-src 'self'", ParseLimits::new(100, 1, 0, 10)) {
    Result::Err(CspError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_directives_per_policy == 0")
  }
  // max_sources_per_directive == 0 allows valueless directive, rejects 1 source
  match parse_csp_with_limits("upgrade-insecure-requests", ParseLimits::new(100, 1, 1, 0)) {
    Result::Ok(p) => debug_assert(p.upgrade_insecure_requests, "expected upgrade_insecure_requests")
    Result::Err(e) => debug_assert(false, "unexpected err: " + csp_error_message(e))
  }
  match parse_csp_with_limits("default-src 'self'", ParseLimits::new(100, 1, 1, 0)) {
    Result::Err(CspError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_sources_per_directive == 0")
  }
}

test "invalid_header_rejects_crlf_and_nul" {
  match parse_csp("default-src 'self'\r\nX-Injected: 1") {
    Result::Err(CspError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "expected InvalidHeader on CRLF")
  }
  match parse_csp("default-src 'self'\n") {
    Result::Err(CspError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "expected InvalidHeader on LF")
  }
}

// ============================================================================
// 2. W3C CSP3 Parsing, Duplicate Directives & Serialization
// ============================================================================

test "csp_duplicate_directive_first_wins_and_flags" {
  let p = must_parse(
    "default-src 'none'; script-src 'self' https://cdn.example.com; script-src 'unsafe-inline' *; upgrade-insecure-requests; block-all-mixed-content; sandbox allow-scripts allow-same-origin; report-uri /csp-report /backup; report-to csp-endpoint",
  )
  debug_assert(p.upgrade_insecure_requests, "upgrade_insecure_requests")
  debug_assert(p.block_all_mixed_content, "block_all_mixed_content")
  debug_assert(p.report_uri.length() == 2, "report_uri count")
  debug_assert(p.report_uri[0] == "/csp-report", "report_uri[0]")
  match p.report_to {
    Option::Some(v) => debug_assert(v == "csp-endpoint", "report_to")
    Option::None => debug_assert(false, "expected report_to")
  }
  match p.sandbox_tokens {
    Option::Some(toks) => {
      debug_assert(toks.length() == 2, "sandbox token count")
      debug_assert(toks[0] == "allow-scripts", "sandbox[0]")
      debug_assert(toks[1] == "allow-same-origin", "sandbox[1]")
    }
    Option::None => debug_assert(false, "expected sandbox_tokens")
  }
  // Second script-src must be ignored (first wins)
  let d = check_source(
    p,
    "script-src",
    "https://app.example.com",
    "https://evil.com/x.js",
    "",
    [],
    true,
  )
  debug_assert(!d.allowed, "duplicate script-src '*' must be ignored")
  debug_assert(d.violated_directive == "script-src", "violated_directive")
  debug_assert(d.effective_directive == "script-src", "effective_directive")
}

test "csp_serialize_roundtrip" {
  let raw = "default-src 'none'; script-src 'self' 'nonce-AbCdEf123' 'sha256-xyz+==' https://cdn.example.com:8443/js/; img-src data: *.img.example.com; upgrade-insecure-requests"
  let p = must_parse(raw)
  let s = serialize_csp(p)
  let p2 = must_parse(s)
  debug_assert(serialize_csp(p2) == s, "serialize_csp must be idempotent")
  // Verify nonce base64 case was preserved
  let d = check_inline_script(p2, "AbCdEf123", [], false)
  debug_assert(d.allowed, "nonce case must survive roundtrip")
  let d_bad = check_inline_script(p2, "abcdef123", [], false)
  debug_assert(!d_bad.allowed, "nonce must be case-sensitive")
}

// ============================================================================
// 3. W3C CSP3 Fallback Chains & Non-Fallback Directives
// ============================================================================

test "csp_fallback_chains" {
  let p_default = must_parse("default-src https://a.example")
  // script-src-elem -> script-src -> default-src
  let d1 = check_source(p_default, "script-src-elem", "https://a.example", "https://b.example/x.js", "", [], true)
  debug_assert(!d1.allowed, "script-src-elem falls back to default-src")
  debug_assert(d1.violated_directive == "default-src", "violated default-src")
  debug_assert(d1.effective_directive == "script-src-elem", "effective script-src-elem")

  // worker-src -> child-src -> script-src -> default-src
  let p_worker = must_parse("default-src 'none'; script-src https://s.example; child-src https://c.example")
  let dw1 = check_source(p_worker, "worker-src", "https://app.example", "https://c.example/w.js", "", [], true)
  debug_assert(dw1.allowed, "worker-src should fall back to child-src before script-src")
  let dw2 = check_source(p_worker, "worker-src", "https://app.example", "https://s.example/w.js", "", [], true)
  debug_assert(!dw2.allowed, "worker-src should not skip child-src to script-src")
  debug_assert(dw2.violated_directive == "child-src", "violated child-src")

  let p_worker2 = must_parse("default-src 'none'; script-src https://s.example")
  let dw3 = check_source(p_worker2, "worker-src", "https://app.example", "https://s.example/w.js", "", [], true)
  debug_assert(dw3.allowed, "worker-src falls back to script-src when child-src absent")

  // frame-src -> child-src -> default-src (NOT script-src)
  let df = check_source(p_worker2, "frame-src", "https://app.example", "https://s.example/f.html", "", [], true)
  debug_assert(!df.allowed, "frame-src must fall back to default-src, not script-src")
  debug_assert(df.violated_directive == "default-src", "frame-src violated default-src")

  // Non-fallback directives: base-uri, form-action, frame-ancestors NEVER fall back to default-src
  let p_none = must_parse("default-src 'none'")
  debug_assert(
    check_source(p_none, "base-uri", "https://app.example", "https://other.example/", "", [], true).allowed,
    "base-uri must NOT fall back to default-src",
  )
  debug_assert(
    check_source(p_none, "form-action", "https://app.example", "https://other.example/submit", "", [], true).allowed,
    "form-action must NOT fall back to default-src",
  )
  debug_assert(
    check_source(p_none, "frame-ancestors", "https://app.example", "https://other.example/", "", [], true).allowed,
    "frame-ancestors must NOT fall back to default-src",
  )
}

// ============================================================================
// 4. Security Semantics: Nonce/Hash/Strict-Dynamic, Wildcard, Host/Port/Path, Upgrade
// ============================================================================

test "csp_nonce_hash_strict_dynamic_ignore_unsafe_inline" {
  // Nonce disables 'unsafe-inline'
  let p1 = must_parse("script-src 'unsafe-inline' 'nonce-secret123'")
  debug_assert(!check_inline_script(p1, "", [], false).allowed, "nonce must disable unsafe-inline")
  debug_assert(check_inline_script(p1, "secret123", [], false).allowed, "matching nonce allowed")
  // Nonce never allows inline event handler attributes
  debug_assert(!check_inline_script(p1, "secret123", [], true).allowed, "nonce must not allow inline attr")

  // Hash disables 'unsafe-inline'
  let p2 = must_parse("script-src 'unsafe-inline' 'sha256-abc123='")
  debug_assert(!check_inline_script(p2, "", [], false).allowed, "hash must disable unsafe-inline")
  debug_assert(
    check_inline_script(p2, "", [("sha256", "abc123=")], false).allowed,
    "matching hash allowed for element",
  )
  // Attribute requires 'unsafe-hashes'
  debug_assert(
    !check_inline_script(p2, "", [("sha256", "abc123=")], true).allowed,
    "hash without unsafe-hashes must block inline attr",
  )
  let p3 = must_parse("script-src 'unsafe-hashes' 'sha256-abc123='")
  debug_assert(
    check_inline_script(p3, "", [("sha256", "abc123=")], true).allowed,
    "hash with unsafe-hashes allows inline attr",
  )

  // 'strict-dynamic' ignores host/scheme/'self' for parser-inserted scripts, allows dynamic scripts
  let p4 = must_parse("script-src 'strict-dynamic' 'nonce-n1' https://cdn.example.com 'unsafe-inline'")
  debug_assert(!check_inline_script(p4, "", [], false).allowed, "strict-dynamic disables unsafe-inline")
  debug_assert(
    !check_source(p4, "script-src", "https://app.example.com", "https://cdn.example.com/a.js", "", [], true).allowed,
    "strict-dynamic ignores host allowlist for parser-inserted script",
  )
  debug_assert(
    check_source(p4, "script-src", "https://app.example.com", "https://cdn.example.com/a.js", "n1", [], true).allowed,
    "strict-dynamic allows parser-inserted script with valid nonce",
  )
  debug_assert(
    check_source(p4, "script-src", "https://app.example.com", "https://any.example.org/dyn.js", "", [], false).allowed,
    "strict-dynamic allows non-parser-inserted dynamic script",
  )
}

test "csp_eval_and_wasm_eval" {
  let p_none = must_parse("script-src 'self'")
  debug_assert(!check_eval(p_none).allowed, "eval blocked without unsafe-eval")
  debug_assert(!check_wasm_eval(p_none).allowed, "wasm eval blocked without wasm-unsafe-eval")

  let p_wasm = must_parse("script-src 'self' 'wasm-unsafe-eval'")
  debug_assert(!check_eval(p_wasm).allowed, "wasm-unsafe-eval must NOT allow JS eval")
  debug_assert(check_wasm_eval(p_wasm).allowed, "wasm-unsafe-eval allows Wasm eval")

  let p_eval = must_parse("script-src 'self' 'unsafe-eval'")
  debug_assert(check_eval(p_eval).allowed, "unsafe-eval allows JS eval")
  debug_assert(check_wasm_eval(p_eval).allowed, "unsafe-eval also allows Wasm eval")
}

test "csp_wildcard_scheme_and_subdomain_boundaries" {
  let p_star = must_parse("default-src *")
  debug_assert(check_source(p_star, "img-src", "https://a.com", "https://b.com/1.png", "", [], true).allowed, "* matches https")
  debug_assert(!check_source(p_star, "img-src", "https://a.com", "data:image/png;base64,AA==", "", [], true).allowed, "* must NOT match data:")
  debug_assert(!check_source(p_star, "img-src", "https://a.com", "blob:https://a.com/123", "", [], true).allowed, "* must NOT match blob:")
  debug_assert(!check_source(p_star, "img-src", "https://a.com", "filesystem:https://a.com/tmp", "", [], true).allowed, "* must NOT match filesystem:")
  debug_assert(!check_source(p_star, "script-src", "https://a.com", "javascript:alert(1)", "", [], true).allowed, "* must NOT match javascript:")

  let p_sub = must_parse("script-src *.example.com")
  debug_assert(
    check_source(p_sub, "script-src", "https://app.example.com", "https://sub.example.com/a.js", "", [], true).allowed,
    "*.example.com matches sub.example.com",
  )
  debug_assert(
    check_source(p_sub, "script-src", "https://app.example.com", "https://a.b.example.com/a.js", "", [], true).allowed,
    "*.example.com matches nested subdomain",
  )
  debug_assert(
    !check_source(p_sub, "script-src", "https://app.example.com", "https://example.com/a.js", "", [], true).allowed,
    "*.example.com must reject bare example.com",
  )
  debug_assert(
    !check_source(p_sub, "script-src", "https://app.example.com", "https://evilexample.com/a.js", "", [], true).allowed,
    "*.example.com must reject evilexample.com",
  )
}

test "csp_ports_paths_traversal_and_scheme_upgrade" {
  // Default port normalization & wildcard port
  let p = must_parse("connect-src https://api.example.com/v1/ https://exact.example.com/app.js https://anyport.example.com:*")
  debug_assert(
    check_source(p, "connect-src", "https://app.example.com", "https://api.example.com:443/v1/users", "", [], true).allowed,
    "explicit default port 443 normalized",
  )
  debug_assert(
    !check_source(p, "connect-src", "https://app.example.com", "https://api.example.com:8443/v1/users", "", [], true).allowed,
    "non-default port 8443 rejected when port omitted",
  )
  debug_assert(
    check_source(p, "connect-src", "https://app.example.com", "https://anyport.example.com:9000/ws", "", [], true).allowed,
    ":* matches any port",
  )

  // Path prefix (/v1/) vs exact file (/app.js) vs traversal (..)
  debug_assert(
    !check_source(p, "connect-src", "https://app.example.com", "https://api.example.com/v1/../admin", "", [], true).allowed,
    "path traversal .. must be rejected",
  )
  debug_assert(
    !check_source(p, "connect-src", "https://app.example.com", "https://api.example.com/v1/%2e%2e/admin", "", [], true).allowed,
    "percent-encoded path traversal %2e%2e must be rejected",
  )
  debug_assert(
    check_source(p, "connect-src", "https://app.example.com", "https://exact.example.com/app.js", "", [], true).allowed,
    "exact file match allowed",
  )
  debug_assert(
    !check_source(p, "connect-src", "https://app.example.com", "https://exact.example.com/app.js/extra", "", [], true).allowed,
    "exact file path must not match prefix",
  )

  // Scheme upgrade: http -> https allowed; https -> http NEVER allowed
  let p_http = must_parse("img-src http://cdn.example.com")
  debug_assert(
    check_source(p_http, "img-src", "http://app.example.com", "https://cdn.example.com/pic.png", "", [], true).allowed,
    "http policy allows upgrade to https",
  )
  let p_https = must_parse("img-src https://cdn.example.com")
  debug_assert(
    !check_source(p_https, "img-src", "https://app.example.com", "http://cdn.example.com/pic.png", "", [], true).allowed,
    "https policy must NEVER downgrade to http",
  )
}

test "csp_multiple_policies_intersection" {
  let policies = must_parse_list([
    "default-src https://a.example https://b.example, default-src https://b.example https://c.example",
    "default-src https://b.example",
  ])
  debug_assert(policies.length() == 3, "expected 3 parsed policies")
  debug_assert(
    check_source_all(policies, "img-src", "https://a.example", "https://b.example/1.png", "", [], true).allowed,
    "origin allowed by ALL policies must pass",
  )
  debug_assert(
    !check_source_all(policies, "img-src", "https://a.example", "https://a.example/1.png", "", [], true).allowed,
    "origin blocked by any policy must fail intersection",
  )
}

// ============================================================================
// 5. WHATWG Fetch CORS Tests
// ============================================================================

test "cors_safelisted_methods_and_headers" {
  debug_assert(is_cors_safelisted_method("GET"), "GET")
  debug_assert(is_cors_safelisted_method("HEAD"), "HEAD")
  debug_assert(is_cors_safelisted_method("POST"), "POST")
  debug_assert(!is_cors_safelisted_method("PUT"), "PUT not safelisted")
  debug_assert(!is_cors_safelisted_method("DELETE"), "DELETE not safelisted")
  debug_assert(!is_cors_safelisted_method("PATCH"), "PATCH not safelisted")
  debug_assert(!is_cors_safelisted_method("OPTIONS"), "OPTIONS not safelisted")

  // Content-Type MIME essence
  debug_assert(is_cors_safelisted_request_header("Content-Type", "text/plain; charset=utf-8"), "text/plain")
  debug_assert(is_cors_safelisted_request_header("content-type", "application/x-www-form-urlencoded"), "form-urlencoded")
  debug_assert(is_cors_safelisted_request_header("Content-Type", "multipart/form-data; boundary=---123"), "multipart")
  debug_assert(!is_cors_safelisted_request_header("Content-Type", "application/json"), "json not safelisted")

  // Accept / Accept-Language / Content-Language
  debug_assert(is_cors_safelisted_request_header("Accept", "text/html,application/xhtml+xml"), "accept")
  debug_assert(!is_cors_safelisted_request_header("Accept", "text/html; \"quoted\""), "unsafe byte quote in Accept")
  debug_assert(is_cors_safelisted_request_header("Accept-Language", "en-US,en;q=0.9"), "accept-language")
  debug_assert(!is_cors_safelisted_request_header("Accept-Language", "en-US/bad"), "invalid char in Accept-Language")

  // Length > 128 rejected
  let long_val = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  debug_assert(long_val.length() == 129, "129 bytes")
  debug_assert(!is_cors_safelisted_request_header("Accept", long_val), "value > 128 bytes rejected")

  // Non-safelisted headers
  debug_assert(!is_cors_safelisted_request_header("Authorization", "Bearer tok"), "Authorization not safelisted")
  debug_assert(!is_cors_safelisted_request_header("X-Custom", "1"), "X-Custom not safelisted")
}

test "cors_origin_parsing_and_opaque_inequality" {
  let o1 = parse_origin("https://Example.COM:443/path?q=1")
  let o2 = parse_origin("https://example.com")
  debug_assert(origin_equals(o1, o2), "default port 443 normalized")
  debug_assert(format_origin(o1) == "https://example.com", "formatted origin omits default port")

  let o3 = parse_origin("https://example.com:8443/api")
  debug_assert(!origin_equals(o1, o3), "different ports not equal")
  debug_assert(format_origin(o3) == "https://example.com:8443", "non-default port preserved")

  let op1 = parse_origin("null")
  let op2 = parse_origin("data:text/html,hi")
  debug_assert(!origin_equals(op1, op1), "opaque origin NEVER equals itself")
  debug_assert(!origin_equals(op1, op2), "opaque origin NEVER equals another opaque origin")
  debug_assert(format_origin(op1) == "null", "opaque formats as null")
}

test "cors_response_validation" {
  // Credentials: Omit + wildcard + expose *
  let r1 = check_cors_response(
    "https://app.example",
    CredentialsMode::Omit,
    Option::Some("*"),
    Option::None,
    Option::Some("X-Request-Id, *"),
  )
  debug_assert(r1.allowed, "wildcard allowed without credentials")
  debug_assert(r1.wildcard_exposed, "wildcard exposed without credentials")

  // Credentials: Include forbids '*'
  let r2 = check_cors_response(
    "https://app.example",
    CredentialsMode::Include,
    Option::Some("*"),
    Option::Some("true"),
    Option::None,
  )
  debug_assert(!r2.allowed, "credentials Include must reject ACAO *")

  // Credentials: Include requires exact ACAC == "true"
  let r3 = check_cors_response(
    "https://app.example",
    CredentialsMode::Include,
    Option::Some("https://app.example"),
    Option::Some("TRUE"),
    Option::None,
  )
  debug_assert(!r3.allowed, "ACAC must be case-sensitive 'true'")

  // Credentials: Include succeeds and does NOT expand '*' in expose-headers
  let r4 = check_cors_response(
    "https://app.example",
    CredentialsMode::Include,
    Option::Some("https://app.example"),
    Option::Some("true"),
    Option::Some("X-RateLimit, *"),
  )
  debug_assert(r4.allowed, "exact origin + ACAC true allowed")
  debug_assert(!r4.wildcard_exposed, "wildcard expose must NOT expand with credentials Include")
  debug_assert(r4.exposed_headers.length() >= 1 && r4.exposed_headers[0] == "x-ratelimit", "exposed header lowercased")

  // Multi-value ACAO rejected
  let r5 = check_cors_response(
    "https://app.example",
    CredentialsMode::Omit,
    Option::Some("https://app.example, https://other.example"),
    Option::None,
    Option::None,
  )
  debug_assert(!r5.allowed, "multi-value ACAO must be rejected")
}

test "cors_preflight_validation" {
  // Wildcard header does NOT cover Authorization!
  let p1 = check_cors_preflight(
    "https://app.example",
    CredentialsMode::Omit,
    "PUT",
    ["X-Custom", "Authorization"],
    Option::Some("*"),
    Option::None,
    Option::Some("PUT, DELETE"),
    Option::Some("*"),
    Option::Some("600"),
  )
  debug_assert(!p1.allowed, "wildcard ACAH must NOT cover Authorization")

  // Explicit Authorization allowed
  let p2 = check_cors_preflight(
    "https://app.example",
    CredentialsMode::Omit,
    "PUT",
    ["X-Custom", "Authorization"],
    Option::Some("*"),
    Option::None,
    Option::Some("PUT, DELETE"),
    Option::Some("*, Authorization"),
    Option::Some("600"),
  )
  debug_assert(p2.allowed, "explicit Authorization allowed")
  debug_assert(p2.max_age == 600, "max_age 600")

  // Credentials Include forbids wildcard methods/headers
  let p3 = check_cors_preflight(
    "https://app.example",
    CredentialsMode::Include,
    "DELETE",
    ["X-Token"],
    Option::Some("https://app.example"),
    Option::Some("true"),
    Option::Some("*"),
    Option::Some("*"),
    Option::Some("300"),
  )
  debug_assert(!p3.allowed, "credentials Include forbids wildcard ACAM/ACAH")

  let p4 = check_cors_preflight(
    "https://app.example",
    CredentialsMode::Include,
    "DELETE",
    ["X-Token"],
    Option::Some("https://app.example"),
    Option::Some("true"),
    Option::Some("DELETE"),
    Option::Some("X-Token"),
    Option::Some("300"),
  )
  debug_assert(p4.allowed, "explicit DELETE + X-Token + ACAC true allowed")
  debug_assert(p4.max_age == 300, "max_age 300")
}

// ============================================================================
// 6. Extended Compliance: IPv6, Self Upgrade/Downgrade, Style, Real-World Sites
// ============================================================================

test "csp_ipv6_self_upgrade_and_ws_upgrade" {
  let p_ipv6 = must_parse("script-src http://[::1]:8080/js/")
  debug_assert(
    check_source(p_ipv6, "script-src", "http://[::1]:8080", "http://[::1]:8080/js/app.js", "", [], true).allowed,
    "IPv6 host+port+path prefix allowed",
  )
  debug_assert(
    !check_source(p_ipv6, "script-src", "http://[::1]:8080", "http://[::1]:9090/js/app.js", "", [], true).allowed,
    "IPv6 wrong port rejected",
  )

  let p_self = must_parse("default-src 'self'")
  debug_assert(
    check_source(p_self, "img-src", "http://example.com", "https://example.com/a.png", "", [], true).allowed,
    "'self' allows http -> https upgrade",
  )
  debug_assert(
    !check_source(p_self, "img-src", "https://example.com", "http://example.com/a.png", "", [], true).allowed,
    "'self' forbids https -> http downgrade",
  )

  let p_ws = must_parse("connect-src ws://rt.example.com")
  debug_assert(
    check_source(p_ws, "connect-src", "http://app.example.com", "wss://rt.example.com/sock", "", [], true).allowed,
    "ws -> wss upgrade allowed",
  )
  let p_wss = must_parse("connect-src wss://rt.example.com")
  debug_assert(
    !check_source(p_wss, "connect-src", "https://app.example.com", "ws://rt.example.com/sock", "", [], true).allowed,
    "wss -> ws downgrade rejected",
  )
}

test "csp_inline_style_and_empty_sandbox" {
  let p = must_parse("default-src 'none'; style-src 'unsafe-inline'; sandbox")
  debug_assert(check_inline_style(p, "", [], false).allowed, "inline style elem allowed by unsafe-inline")
  debug_assert(check_inline_style(p, "", [], true).allowed, "inline style attr allowed by unsafe-inline")
  match p.sandbox_tokens {
    Option::Some(toks) => debug_assert(toks.length() == 0, "empty sandbox has 0 tokens")
    Option::None => debug_assert(false, "expected Some([]) for bare sandbox")
  }

  let p_nonce = must_parse("style-src 'unsafe-inline' 'nonce-st1'")
  debug_assert(!check_inline_style(p_nonce, "", [], false).allowed, "nonce disables unsafe-inline for style")
  debug_assert(check_inline_style(p_nonce, "st1", [], false).allowed, "matching style nonce allowed")
  debug_assert(!check_inline_style(p_nonce, "st1", [], true).allowed, "style nonce does not allow style attr")
}

test "csp_real_world_sites_smoke" {
  // Twitter/X, YouTube, GitHub, Google Meet, Figma representative CSP3 headers
  let gh = must_parse(
    "default-src 'none'; base-uri 'self'; connect-src 'self' https://uploads.github.com wss://alive.github.com; font-src github.githubassets.com; form-action 'self' https://github.com; frame-ancestors 'none'; img-src 'self' data: blob: https://avatars.githubusercontent.com *.githubusercontent.com; script-src github.githubassets.com; style-src 'unsafe-inline' github.githubassets.com; worker-src github.com/assets-cdn/worker/",
  )
  debug_assert(
    check_source(gh, "img-src", "https://github.com", "https://avatars.githubusercontent.com/u/1", "", [], true).allowed,
    "GitHub avatar allowed",
  )
  debug_assert(
    check_source(gh, "worker-src", "https://github.com", "https://github.com/assets-cdn/worker/sw.js", "", [], true).allowed,
    "GitHub worker path prefix allowed",
  )
  debug_assert(
    !check_source(gh, "worker-src", "https://github.com", "https://github.com/assets-cdn/worker/../evil.js", "", [], true).allowed,
    "GitHub worker traversal blocked",
  )

  let figma = must_parse(
    "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.figma.com; connect-src 'self' wss://www.figma.com https://api.figma.com; img-src 'self' data: blob: https://*.figma.com; upgrade-insecure-requests",
  )
  debug_assert(check_wasm_eval(figma).allowed, "Figma wasm-unsafe-eval allowed")
  debug_assert(!check_eval(figma).allowed, "Figma JS eval blocked")
  debug_assert(figma.upgrade_insecure_requests, "Figma upgrade-insecure-requests")

  // IPv6 origin parsing
  let o6 = parse_origin("http://[::1]:8080/api")
  debug_assert(format_origin(o6) == "http://[::1]:8080", "IPv6 origin formatted")
  debug_assert(origin_equals(o6, parse_origin("HTTP://[::1]:8080/other")), "IPv6 origin equals")
}
