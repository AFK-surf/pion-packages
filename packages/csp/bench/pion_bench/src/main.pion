///| Pion Native head-to-head benchmark for `packages/csp` vs Rust (`url = 2.5` + W3C CSP3 / Fetch CORS).
///| Modes:
///|   csp  - Parse & evaluate real-world CSP3 headers (Twitter/X, YouTube, GitHub, Google Meet, Figma)
///|   cors - Batch evaluate WHATWG Fetch CORS preflight, response, safelist & origin checks
///|
///| Uses full byte-by-byte FNV-1a 64-bit hashing over every decision field (allowed,
///| violated_directive, effective_directive, matched_source, exposed_headers, origin, max_age).

import "csp"

fn fnv1a_byte(h : UInt64, b : Int) -> UInt64 {
  let x = h ^ (b & 0xFF).to_int64().to_uint64()
  x * 1099511628211UL
}

fn fnv1a_str(h_in : UInt64, s : String) -> UInt64 {
  let mut h = h_in
  let n = s.length()
  let mut i = 0
  while i < n {
    h = fnv1a_byte(h, s.code_unit_at(i))
    i = i + 1
  }
  fnv1a_byte(h, 0xFF)
}

fn hash_decision(h_in : UInt64, d : csp::CspDecision) -> UInt64 {
  let mut h = fnv1a_byte(h_in, if d.allowed { 1 } else { 0 })
  h = fnv1a_str(h, d.violated_directive)
  h = fnv1a_str(h, d.effective_directive)
  match d.matched_source {
    Option::Some(s) => fnv1a_str(fnv1a_byte(h, 1), s)
    Option::None => fnv1a_byte(h, 0)
  }
}

fn hex_u64(v : UInt64) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut shift = 60
  while shift >= 0 {
    let nib = ((v >> shift) & 15UL).to_int()
    sb.write_byte(digits.code_unit_at(nib).to_byte())
    shift = shift - 4
  }
  sb.to_string()
}

fn bench_csp(world : World, rounds : Int) -> Int {
  // 5 complex real-world CSP3 policies: Twitter/X, YouTube, GitHub, Google Meet, Figma
  let h_twitter = "default-src 'none'; connect-src 'self' https://api.x.com https://api.twitter.com wss://*.x.com https://upload.twitter.com/1.1/; font-src 'self' https://abs.twimg.com data:; frame-src https://twitter.com https://mobile.twitter.com https://accounts.google.com; img-src https: blob: data: *.twimg.com; media-src https://video.twimg.com blob:; object-src 'none'; script-src 'self' 'nonce-TwItTeR99' 'strict-dynamic' https://abs.twimg.com/responsive-web/ 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://abs.twimg.com; worker-src 'self' blob:; base-uri 'self'; form-action 'self' https://x.com; frame-ancestors 'none'; report-uri https://x.com/i/csp_report"
  let h_youtube = "default-src 'none'; script-src 'nonce-YtNoNcE42' 'strict-dynamic' 'unsafe-eval' https://www.youtube.com/s/ https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https://i.ytimg.com https://*.ggpht.com data: blob:; media-src 'self' https://*.googlevideo.com blob:; connect-src 'self' https://*.googlevideo.com https://www.youtube.com https://play.google.com; font-src https://fonts.gstatic.com; frame-src https://accounts.google.com https://www.youtube.com; worker-src 'self' blob:; base-uri 'self'; object-src 'none'; upgrade-insecure-requests; report-to yt-csp"
  let h_github = "default-src 'none'; base-uri 'self'; child-src github.com/assets-cdn/worker/ gist.github.com/assets-cdn/worker/; connect-src 'self' https://uploads.github.com https://api.github.com wss://alive.github.com https://collector.github.com; font-src github.githubassets.com; form-action 'self' github.com gist.github.com; frame-ancestors 'none'; frame-src render.githubusercontent.com viewscreen.githubusercontent.com; img-src 'self' data: blob: https://avatars.githubusercontent.com *.githubusercontent.com github.githubassets.com; manifest-src 'self'; media-src github.com user-images.githubusercontent.com; script-src github.githubassets.com; style-src 'unsafe-inline' github.githubassets.com; worker-src github.com/assets-cdn/worker/ gist.github.com/assets-cdn/worker/"
  let h_meet = "default-src 'self'; script-src 'nonce-MeEt2026' 'strict-dynamic' 'wasm-unsafe-eval' https://meet.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https://lh3.googleusercontent.com https://*.gstatic.com data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' https://meet.google.com wss://*.google.com https://*.googleapis.com; font-src https://fonts.gstatic.com; frame-src https://docs.google.com https://accounts.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
  let h_figma = "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.figma.com/webpack/ 'sha256-FigMaHash01='; style-src 'self' 'unsafe-inline' https://static.figma.com; img-src 'self' data: blob: https://*.figma.com https://s3-alpha.figma.com; connect-src 'self' wss://www.figma.com https://api.figma.com https://static.figma.com; font-src 'self' https://static.figma.com data:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  let headers = [h_twitter, h_youtube, h_github, h_meet, h_figma]
  let origins = [
    "https://x.com",
    "https://www.youtube.com",
    "https://github.com",
    "https://meet.google.com",
    "https://www.figma.com",
  ]

  let mut digest = 14695981039346656037UL
  let mut allowed_count = 0
  let mut blocked_count = 0
  let mut total_directives = 0
  let mut total_sources = 0

  let mut r = 0
  while r < rounds {
    let mut s = 0
    while s < 5 {
      let p = match csp::parse_csp(headers[s]) {
        Result::Ok(pol) => pol
        Result::Err(_) => return 1
      }
      total_directives = total_directives + p.directives.length()
      let mut di = 0
      while di < p.directives.length() {
        total_sources = total_sources + p.directives[di].sources.length()
        di = di + 1
      }
      let orig = origins[s]

      // 10 realistic + adversarial policy evaluations per site per round = 50 checks / round
      let d1 = csp::check_source(p, "script-src-elem", orig, "https://abs.twimg.com/responsive-web/app.js", "TwItTeR99", [], true)
      let d2 = csp::check_source(p, "script-src", orig, "https://static.figma.com/webp%61ck/main.js", "", [("sha256", "FigMaHash01=")], true)
      let d3 = csp::check_source(p, "script-src", orig, "https://evil.example\\@abs.twimg.com/xss.js", "", [], true)
      let d4 = csp::check_source(p, "img-src", orig, "https://avatars.githubusercontent.com/u/42", "", [], true)
      let d5 = csp::check_source(p, "img-src", orig, "data:image/png;base64,AA==", "", [], true)
      let d6 = csp::check_source(p, "connect-src", orig, "wss://www.figma.com/ws", "", [], true)
      let d7 = csp::check_source(p, "worker-src", orig, "https://github.com/assets-cdn/worker/.\t./escape.js", "", [], true)
      let d8 = csp::check_inline_script(p, "YtNoNcE42", [], false)
      let d9 = csp::check_eval(p)
      let d10 = csp::check_wasm_eval(p)

      let ds = [d1, d2, d3, d4, d5, d6, d7, d8, d9, d10]
      let mut k = 0
      while k < 10 {
        let d = ds[k]
        if d.allowed {
          allowed_count = allowed_count + 1
        } else {
          blocked_count = blocked_count + 1
        }
        digest = hash_decision(digest, d)
        k = k + 1
      }
      s = s + 1
    }
    r = r + 1
  }

  io_println(world, "mode=csp")
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "directives=" + total_directives.to_string())
  io_println(world, "sources=" + total_sources.to_string())
  io_println(world, "allowed=" + allowed_count.to_string())
  io_println(world, "blocked=" + blocked_count.to_string())
  io_println(world, "fnv1a64=" + hex_u64(digest))
  0
}

fn bench_cors(world : World, rounds : Int) -> Int {
  let mut digest = 14695981039346656037UL
  let mut allowed_count = 0
  let mut blocked_count = 0
  let mut max_age_sum = 0L

  let mut r = 0
  while r < rounds {
    // 10 CORS operations per round
    let o1 = csp::parse_origin("https://App.Example.COM:443/v1/feed")
    let o2 = csp::parse_origin("blob:https://app.example.com/550e8400")
    let o3 = csp::parse_origin("https://evil.com\\@app.example.com/")
    let eq12 = csp::origin_equals(o1, o2)
    let eq13 = csp::origin_equals(o1, o3)
    digest = fnv1a_str(digest, csp::format_origin(o1))
    digest = fnv1a_str(digest, csp::format_origin(o2))
    digest = fnv1a_str(digest, csp::format_origin(o3))
    if eq12 && !eq13 {
      allowed_count = allowed_count + 1
      digest = fnv1a_byte(digest, 1)
    } else {
      blocked_count = blocked_count + 1
      digest = fnv1a_byte(digest, 0)
    }

    let safe1 = csp::is_cors_safelisted_method("POST") &&
    csp::is_cors_safelisted_request_header("Content-Type", "text/plain; charset=utf-8")
    let safe2 = csp::is_cors_safelisted_request_header("Content-Type", "application/json")
    if safe1 && !safe2 {
      allowed_count = allowed_count + 1
      digest = fnv1a_byte(digest, 1)
    } else {
      blocked_count = blocked_count + 1
      digest = fnv1a_byte(digest, 0)
    }

    let r1 = csp::check_cors_response(
      "https://x.com",
      csp::CredentialsMode::Include,
      Option::Some("https://x.com"),
      Option::Some("true"),
      Option::Some("X-Rate-Limit-Remaining, X-Request-Id, *"),
    )
    if r1.allowed && !r1.wildcard_exposed {
      allowed_count = allowed_count + 1
    } else {
      blocked_count = blocked_count + 1
    }
    digest = fnv1a_byte(digest, if r1.allowed { 1 } else { 0 })
    digest = fnv1a_byte(digest, if r1.wildcard_exposed { 1 } else { 0 })
    let mut ei = 0
    while ei < r1.exposed_headers.length() {
      digest = fnv1a_str(digest, r1.exposed_headers[ei])
      ei = ei + 1
    }

    let r2 = csp::check_cors_response(
      "https://x.com",
      csp::CredentialsMode::Include,
      Option::Some("*"),
      Option::Some("true"),
      Option::None,
    )
    if r2.allowed {
      allowed_count = allowed_count + 1
    } else {
      blocked_count = blocked_count + 1
    }
    digest = fnv1a_byte(digest, if r2.allowed { 1 } else { 0 })

    let r3 = csp::check_cors_response(
      "https://github.com",
      csp::CredentialsMode::Omit,
      Option::Some("*"),
      Option::None,
      Option::Some("ETag, *"),
    )
    if r3.allowed && r3.wildcard_exposed {
      allowed_count = allowed_count + 1
    } else {
      blocked_count = blocked_count + 1
    }
    digest = fnv1a_byte(digest, if r3.allowed { 1 } else { 0 })
    digest = fnv1a_byte(digest, if r3.wildcard_exposed { 1 } else { 0 })
    ei = 0
    while ei < r3.exposed_headers.length() {
      digest = fnv1a_str(digest, r3.exposed_headers[ei])
      ei = ei + 1
    }

    let r4 = csp::check_cors_response(
      "https://github.com",
      csp::CredentialsMode::Omit,
      Option::Some("https://github.com, https://evil.com"),
      Option::None,
      Option::None,
    )
    if r4.allowed {
      allowed_count = allowed_count + 1
    } else {
      blocked_count = blocked_count + 1
    }
    digest = fnv1a_byte(digest, if r4.allowed { 1 } else { 0 })

    let pf1 = csp::check_cors_preflight(
      "https://www.figma.com",
      csp::CredentialsMode::Omit,
      "PUT",
      ["X-Figma-Token", "Authorization"],
      Option::Some("*"),
      Option::None,
      Option::Some("GET, POST, PUT, DELETE"),
      Option::Some("*"),
      Option::Some("600"),
    )
    if pf1.allowed {
      allowed_count = allowed_count + 1
    } else {
      blocked_count = blocked_count + 1
    }
    max_age_sum = max_age_sum + pf1.max_age.to_int64()
    digest = fnv1a_byte(digest, if pf1.allowed { 1 } else { 0 })
    digest = fnv1a_str(digest, pf1.max_age.to_string())

    let pf2 = csp::check_cors_preflight(
      "https://www.figma.com",
      csp::CredentialsMode::Omit,
      "PUT",
      ["X-Figma-Token", "Authorization"],
      Option::Some("*"),
      Option::None,
      Option::Some("GET, POST, PUT, DELETE"),
      Option::Some("*, Authorization"),
      Option::Some("999999999"),
    )
    if pf2.allowed {
      allowed_count = allowed_count + 1
    } else {
      blocked_count = blocked_count + 1
    }
    max_age_sum = max_age_sum + pf2.max_age.to_int64()
    digest = fnv1a_byte(digest, if pf2.allowed { 1 } else { 0 })
    digest = fnv1a_str(digest, pf2.max_age.to_string())

    let pf3 = csp::check_cors_preflight(
      "https://meet.google.com",
      csp::CredentialsMode::Include,
      "PATCH",
      ["Content-Type", "X-Goog-AuthUser"],
      Option::Some("https://meet.google.com"),
      Option::Some("true"),
      Option::Some("GET, POST, PATCH"),
      Option::Some("Content-Type, X-Goog-AuthUser"),
      Option::Some("3600"),
    )
    if pf3.allowed {
      allowed_count = allowed_count + 1
    } else {
      blocked_count = blocked_count + 1
    }
    max_age_sum = max_age_sum + pf3.max_age.to_int64()
    digest = fnv1a_byte(digest, if pf3.allowed { 1 } else { 0 })
    digest = fnv1a_str(digest, pf3.max_age.to_string())

    let pf4 = csp::check_cors_preflight(
      "https://meet.google.com",
      csp::CredentialsMode::Include,
      "DELETE",
      ["X-Custom"],
      Option::Some("https://meet.google.com"),
      Option::Some("true"),
      Option::Some("*"),
      Option::Some("*"),
      Option::Some("600"),
    )
    if pf4.allowed {
      allowed_count = allowed_count + 1
    } else {
      blocked_count = blocked_count + 1
    }
    max_age_sum = max_age_sum + pf4.max_age.to_int64()
    digest = fnv1a_byte(digest, if pf4.allowed { 1 } else { 0 })
    digest = fnv1a_str(digest, pf4.max_age.to_string())

    r = r + 1
  }

  io_println(world, "mode=cors")
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "allowed=" + allowed_count.to_string())
  io_println(world, "blocked=" + blocked_count.to_string())
  io_println(world, "max_age_sum=" + max_age_sum.to_string())
  io_println(world, "fnv1a64=" + hex_u64(digest))
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: csp_bench <csp|cors>")
    return 1
  }
  let mode = args[1]
  if mode == "csp" {
    bench_csp(world, 2000)
  } else if mode == "cors" {
    bench_cors(world, 20000)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
