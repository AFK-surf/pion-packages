///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/csp`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "csp"

///|
pub fn main(world : World) -> Int {
  // 1. ParseLimits negative & zero enforcement
  match csp::parse_csp_with_limits("default-src 'self'", csp::ParseLimits::new(-1, 1, 1, 1)) {
    Err(csp::CspError::InvalidLimits(_)) => ()
    _ => return 1
  }
  match csp::parse_csp_with_limits("default-src 'self'", csp::ParseLimits::new(100, 1, 0, 10)) {
    Err(csp::CspError::LimitExceeded(_)) => ()
    _ => return 2
  }
  match csp::parse_csp("default-src 'self'\r\nEvil: 1") {
    Err(csp::CspError::InvalidHeader(_)) => ()
    _ => return 3
  }

  // 2. Parse complex multi-policy CSP3 header
  let policies = match csp::parse_csp_list([
    "default-src 'none'; script-src 'strict-dynamic' 'nonce-SmOkE123' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.example.com/js/; img-src * data: *.img.example.com; connect-src http://api.example.com:80/v1/; upgrade-insecure-requests; sandbox allow-scripts; report-to csp-ep",
    "default-src 'self' https://cdn.example.com https://api.example.com https://sub.img.example.com data: 'nonce-SmOkE123' 'strict-dynamic'",
  ]) {
    Ok(ps) => ps
    Err(_) => return 4
  }
  if policies.length() != 2 {
    return 5
  }

  let p0 = policies[0]
  let ser = csp::serialize_csp(p0)

  // Verify security invariants
  let d_inline_no_nonce = csp::check_inline_script(p0, "", [], false)
  let d_inline_ok = csp::check_inline_script(p0, "SmOkE123", [], false)
  let d_eval = csp::check_eval(p0)
  let d_wasm = csp::check_wasm_eval(p0)
  let d_trav = csp::check_source(p0, "connect-src", "http://app.example.com", "https://api.example.com/v1/../secret", "", [], true)
  let d_upgrade = csp::check_source(p0, "connect-src", "http://app.example.com", "https://api.example.com/v1/items", "", [], true)
  let d_star_blob = csp::check_source(p0, "img-src", "https://app.example.com", "blob:https://app.example.com/1", "", [], true)
  let d_sub_bare = csp::check_source(p0, "img-src", "https://app.example.com", "https://img.example.com/a.png", "", [], true)
  let d_all = csp::check_source_all(policies, "img-src", "https://app.example.com", "https://sub.img.example.com/a.png", "", [], true)

  if d_inline_no_nonce.allowed || !d_inline_ok.allowed || d_eval.allowed || !d_wasm.allowed {
    return 6
  }
  if d_trav.allowed || !d_upgrade.allowed || d_star_blob.allowed || !d_all.allowed {
    return 7
  }
  // Note: d_sub_bare is allowed by '*' in img-src; check dedicated *.example.com policy
  let p_sub = match csp::parse_csp("img-src *.img.example.com") {
    Ok(p) => p
    Err(_) => return 8
  }
  if csp::check_source(p_sub, "img-src", "https://app.example.com", "https://img.example.com/a.png", "", [], true).allowed {
    return 9
  }
  let _ = d_sub_bare

  // 3. WHATWG Fetch CORS checks
  let o1 = csp::parse_origin("https://App.Example.COM:443/path")
  let o2 = csp::parse_origin("https://app.example.com")
  let op = csp::parse_origin("null")
  if !csp::origin_equals(o1, o2) || csp::origin_equals(op, op) {
    return 10
  }
  let r_inc_star = csp::check_cors_response(
    "https://app.example.com",
    csp::CredentialsMode::Include,
    Option::Some("*"),
    Option::Some("true"),
    Option::None,
  )
  let r_inc_ok = csp::check_cors_response(
    "https://app.example.com",
    csp::CredentialsMode::Include,
    Option::Some("https://app.example.com"),
    Option::Some("true"),
    Option::Some("X-Trace-Id, *"),
  )
  let pf_auth_star = csp::check_cors_preflight(
    "https://app.example.com",
    csp::CredentialsMode::Omit,
    "PUT",
    ["Authorization"],
    Option::Some("*"),
    Option::None,
    Option::Some("PUT"),
    Option::Some("*"),
    Option::Some("600"),
  )
  let pf_ok = csp::check_cors_preflight(
    "https://app.example.com",
    csp::CredentialsMode::Omit,
    "PUT",
    ["X-Custom", "Authorization"],
    Option::Some("*"),
    Option::None,
    Option::Some("PUT"),
    Option::Some("*, Authorization"),
    Option::Some("600"),
  )
  if r_inc_star.allowed || !r_inc_ok.allowed || r_inc_ok.wildcard_exposed || pf_auth_star.allowed || !pf_ok.allowed || pf_ok.max_age != 600 {
    return 11
  }

  io_println(world, "csp_wasm_smoke:ok")
  io_println(world, "ser=" + ser)
  io_println(world, "origin=" + csp::format_origin(o1))
  io_println(world, "cors_exposed=" + r_inc_ok.exposed_headers[0])
  io_println(world, "preflight_max_age=" + pf_ok.max_age.to_string())
  0
}
