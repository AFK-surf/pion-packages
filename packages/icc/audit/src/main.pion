///| Red-team CLI for `packages/icc` (native + wasm32).
///|   dump <file>...              -> `== <file>` then the rt_dump_file record (src/dump.pion)
///|   dumplist <listfile>         -> same for every path listed (one per line)
///|   grid <icc> <in.rgb> <out>   -> parse + Transform::to_srgb + transform_rgb_in_place, write the result
///|   time <file> <iters>         -> (extract +) parse + to_srgb <iters> times: `<verdict> us=<total>`
///|   list | case <name>          -> red-team / control cases (src/cases.pion)

import "icc"

///|
fn parse_uint(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///| Split on '\n', dropping empty lines.
fn split_lines(b : Bytes) -> Array[String] {
  let out : Array[String] = []
  let mut sb = StringBuilder::new()
  let mut any = false
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    if c == 10 {
      if any {
        out.push(sb.to_string())
      }
      sb = StringBuilder::new()
      any = false
    } else {
      sb.write_byte(b[i])
      any = true
    }
    i = i + 1
  }
  if any {
    out.push(sb.to_string())
  }
  out
}

///|
fn dump_one(world : World, path : String) -> Unit {
  match fs_read_bytes(world, path) {
    Ok(d) => io_print(world, "== " + path + "\n" + rt_dump_file(path, d))
    Err(_) => io_print(world, "== " + path + "\nREADFAIL\n")
  }
}

///| One timed iteration: extractor (by extension), parse, transform build.
fn time_once(path : String, d : Bytes) -> String {
  let raw = if rt_ends_with(path, ".jpg") {
    match icc::extract_jpeg_icc(d) {
      Ok(Some(b)) => b
      Ok(None) => return "NONE"
      Err(e) => return "CERR " + rt_err_name(e)
    }
  } else if rt_ends_with(path, ".webp") {
    match icc::extract_webp_icc(d) {
      Ok(Some(b)) => b
      Ok(None) => return "NONE"
      Err(e) => return "CERR " + rt_err_name(e)
    }
  } else {
    d
  }
  match icc::parse(raw) {
    Err(e) => "PERR " + rt_err_name(e)
    Ok(p) =>
    match icc::Transform::to_srgb(p) {
      Ok(_) => "OK"
      Err(e) => "TERR " + rt_err_name(e)
    }
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: icc_audit dump <file>... | dumplist <list> | grid <icc> <in> <out> | time <file> <iters> | list | case <name>")
    return 2
  }
  let mode = args[1]
  if mode == "dump" {
    let mut i = 2
    while i < args.length() {
      dump_one(world, args[i])
      i = i + 1
    }
    return 0
  }
  if mode == "dumplist" && args.length() >= 3 {
    let lst = match fs_read_bytes(world, args[2]) {
      Ok(b) => split_lines(b)
      Err(_) => return 3
    }
    let mut i = 0
    while i < lst.length() {
      dump_one(world, lst[i])
      i = i + 1
    }
    return 0
  }
  if mode == "grid" && args.length() >= 5 {
    let icc_bytes = match fs_read_bytes(world, args[2]) {
      Ok(x) => x
      Err(_) => return 3
    }
    let src = match fs_read_bytes(world, args[3]) {
      Ok(x) => x
      Err(_) => return 3
    }
    let p = match icc::parse(icc_bytes) {
      Ok(p) => p
      Err(e) => {
        io_println(world, "PERR " + rt_err_name(e))
        return 4
      }
    }
    let tf = match icc::Transform::to_srgb(p) {
      Ok(t) => t
      Err(e) => {
        io_println(world, "TERR " + rt_err_name(e))
        return 4
      }
    }
    let n = src.length()
    let buf : Array[Byte] = []
    let mut i = 0
    while i < n {
      buf.push(src[i])
      i = i + 1
    }
    match tf.transform_rgb_in_place(buf) {
      Ok(_) => ()
      Err(e) => {
        io_println(world, "BERR " + rt_err_name(e))
        return 4
      }
    }
    let out = Bytes::new(n)
    i = 0
    while i < n {
      out[i] = buf[i]
      i = i + 1
    }
    match fs_write_bytes(world, args[4], out) {
      Ok(_) => ()
      Err(_) => return 3
    }
    io_println(world, "OK id=" + (if tf.is_identity() { "1" } else { "0" }))
    return 0
  }
  if mode == "time" && args.length() >= 4 {
    let d = match fs_read_bytes(world, args[2]) {
      Ok(x) => x
      Err(_) => return 3
    }
    let iters = parse_uint(args[3])
    let mut verdict = ""
    let t0 = clock_monotonic_us()
    let mut k = 0
    while k < iters {
      verdict = time_once(args[2], d)
      k = k + 1
    }
    let t1 = clock_monotonic_us()
    io_println(world, verdict + " us=" + (t1 - t0).to_string())
    return 0
  }
  if mode == "list" {
    let names = rt_all_cases()
    let mut i = 0
    while i < names.length() {
      io_println(world, names[i])
      i = i + 1
    }
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = rt_run_case(args[2])
    if r == "" {
      io_println(world, "PASS " + args[2])
      return 0
    }
    io_println(world, "FAIL " + args[2] + " :: " + r)
    return 1
  }
  io_println(world, "bad arguments")
  2
}
