///| Deterministic, mode-independent dump of `icc::parse` / `icc::Transform::to_srgb` results.
///| One record per input file:
///|   `C OK <len>` | `C NONE` | `C ERR <Variant>`           (only for .jpg / .webp inputs)
///|   `P ERR <Variant>` or
///|   `P OK size=<n> ver=<a.b.c> class=<sig> cs=<sig> pcs=<sig> intent=<i> ntags=<n> desc=<hex|->`
///|   `X <rXYZ> <gXYZ> <bXYZ> <wtpt> <bkpt> <chad>`         (binary64 bits, `-` when absent)
///|   `K <rTRC> <gTRC> <bTRC> <kTRC>`                       (I | G<bits> | T<n>:<fnv> | P<t>:<bits>x7 | -)
///|   `S <is_srgb_like>`
///|   `T ERR <Variant>` or `T OK id=<0|1> gray=<0|1> fnv=<fnv64 of the probe-set output>`
///| Doubles are printed as IEEE-754 bits so native and wasm32 records compare byte for byte.

import "icc"

///|
fn hexd(v : Int) -> Int {
  if v < 10 {
    48 + v
  } else {
    87 + v
  }
}

///| Lower-case hex of the low `digits` nibbles of `v`.
pub fn rt_hex64(v : Int64, digits : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = digits - 1
  while i >= 0 {
    sb.write_byte(hexd(((v >> (i * 4)) & 0xFL).to_int()).to_byte())
    i = i - 1
  }
  sb.to_string()
}

///| Hex of every byte of `s`.
pub fn rt_hex_str(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i) & 0xFF
    sb.write_byte(hexd(c >> 4).to_byte())
    sb.write_byte(hexd(c & 0xF).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn rt_err_name(e : icc::IccError) -> String {
  match e {
    icc::IccError::UnexpectedEof(_) => "UnexpectedEof"
    icc::IccError::InvalidHeader(_) => "InvalidHeader"
    icc::IccError::InvalidTagTable(_) => "InvalidTagTable"
    icc::IccError::InvalidTag(_) => "InvalidTag"
    icc::IccError::InvalidContainer(_) => "InvalidContainer"
    icc::IccError::UnsupportedProfile(_) => "UnsupportedProfile"
    icc::IccError::InvalidBuffer(_) => "InvalidBuffer"
  }
}

///| FNV-1a 64 over a byte sequence, continued from `h`.
pub fn rt_fnv_byte(h : Int64, b : Int) -> Int64 {
  (h ^ (b & 0xFF).to_int64()) * 0x100000001B3L
}

///|
pub let rt_fnv_init : Int64 = 0xCBF29CE484222325L

///|
fn dbits(d : Double) -> String {
  rt_hex64(d.to_bits(), 16)
}

///|
fn xyz_str(x : Option[icc::Xyz]) -> String {
  match x {
    Some(v) => dbits(v.x) + "," + dbits(v.y) + "," + dbits(v.z)
    None => "-"
  }
}

///|
fn mat_str(m : Option[icc::Matrix3x3]) -> String {
  match m {
    Some(v) =>
    dbits(v.m00) + "," + dbits(v.m01) + "," + dbits(v.m02) + "," + dbits(v.m10) + "," + dbits(v.m11) + "," +
    dbits(v.m12) + "," + dbits(v.m20) + "," + dbits(v.m21) + "," + dbits(v.m22)
    None => "-"
  }
}

///|
pub fn rt_curve_str(c : Option[icc::ToneCurve]) -> String {
  match c {
    None => "-"
    Some(icc::ToneCurve::Identity) => "I"
    Some(icc::ToneCurve::Gamma(g)) => "G" + dbits(g)
    Some(icc::ToneCurve::Table(t)) => {
      let mut h = rt_fnv_init
      let mut i = 0
      while i < t.length() {
        h = rt_fnv_byte(h, t[i] >> 8)
        h = rt_fnv_byte(h, t[i])
        i = i + 1
      }
      "T" + t.length().to_string() + ":" + rt_hex64(h, 16)
    }
    Some(icc::ToneCurve::Parametric(t, g, a, b, cc, d, e, f)) =>
    "P" + t.to_string() + ":" + dbits(g) + "," + dbits(a) + "," + dbits(b) + "," + dbits(cc) + "," + dbits(d) +
    "," + dbits(e) + "," + dbits(f)
  }
}

///| The probe set: 4 x 256 ramps (R, G, B, gray) followed by a 9x9x9 grid (0, 32, ..., 255).
pub fn rt_probe_rgb() -> Array[Byte] {
  let out : Array[Byte] = []
  let mut ch = 0
  while ch < 4 {
    let mut v = 0
    while v < 256 {
      let r = if ch == 0 || ch == 3 { v } else { 0 }
      let g = if ch == 1 || ch == 3 { v } else { 0 }
      let b = if ch == 2 || ch == 3 { v } else { 0 }
      out.push(r.to_byte())
      out.push(g.to_byte())
      out.push(b.to_byte())
      v = v + 1
    }
    ch = ch + 1
  }
  let lv = [0, 32, 64, 96, 128, 160, 192, 224, 255]
  let mut i = 0
  while i < 9 {
    let mut j = 0
    while j < 9 {
      let mut k = 0
      while k < 9 {
        out.push(lv[i].to_byte())
        out.push(lv[j].to_byte())
        out.push(lv[k].to_byte())
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  out
}

///|
pub fn rt_dump_profile(data : Bytes) -> String {
  let sb = StringBuilder::new()
  match icc::parse(data) {
    Err(e) => sb.write_string("P ERR " + rt_err_name(e) + "\n")
    Ok(p) => {
      let v = p.version()
      sb.write_string(
        "P OK size=" + p.profile_size.to_string() + " ver=" + v.to_string() + " class=" +
        rt_hex_str(p.device_class().signature()) +
        " cs=" +
        rt_hex_str(p.color_space().signature()) +
        " pcs=" +
        rt_hex_str(p.pcs().signature()) +
        " intent=" +
        p.rendering_intent().to_int().to_string() +
        " ntags=" +
        p.tags().length().to_string() +
        " desc=" +
        (match p.description() {
          Some(s) => rt_hex_str(s)
          None => "-"
        }) +
        "\n",
      )
      sb.write_string(
        "X " + xyz_str(p.red_xyz) + " " + xyz_str(p.green_xyz) + " " + xyz_str(p.blue_xyz) + " " +
        xyz_str(p.white_point()) +
        " " +
        xyz_str(p.black_point()) +
        " " +
        mat_str(p.chad()) +
        "\n",
      )
      sb.write_string(
        "K " + rt_curve_str(p.red_trc()) + " " + rt_curve_str(p.green_trc()) + " " + rt_curve_str(p.blue_trc()) +
        " " +
        rt_curve_str(p.gray_trc()) +
        "\n",
      )
      sb.write_string("S " + (if p.is_srgb_like() { "1" } else { "0" }) + "\n")
      match icc::Transform::to_srgb(p) {
        Err(e) => sb.write_string("T ERR " + rt_err_name(e) + "\n")
        Ok(tf) => {
          let buf = rt_probe_rgb()
          let ok = match tf.transform_rgb_in_place(buf) {
            Ok(_) => true
            Err(_) => false
          }
          let mut h = rt_fnv_init
          let mut i = 0
          while i < buf.length() {
            h = rt_fnv_byte(h, buf[i].to_int())
            i = i + 1
          }
          sb.write_string(
            "T OK id=" + (if tf.is_identity() { "1" } else { "0" }) + " gray=" +
            (if tf.is_gray { "1" } else { "0" }) +
            " fnv=" +
            (if ok { rt_hex64(h, 16) } else { "BUFERR" }) +
            "\n",
          )
        }
      }
    }
  }
  sb.to_string()
}

///| Suffix test without allocation tricks.
pub fn rt_ends_with(s : String, suf : String) -> Bool {
  let n = s.length()
  let m = suf.length()
  if m > n {
    return false
  }
  let mut i = 0
  while i < m {
    if s.code_unit_at(n - m + i) != suf.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Dump one input: `.jpg` / `.webp` go through the extractor first, everything else is a raw profile.
pub fn rt_dump_file(path : String, data : Bytes) -> String {
  let is_jpg = rt_ends_with(path, ".jpg")
  let is_webp = rt_ends_with(path, ".webp")
  if !is_jpg && !is_webp {
    return rt_dump_profile(data)
  }
  let r = if is_jpg { icc::extract_jpeg_icc(data) } else { icc::extract_webp_icc(data) }
  match r {
    Err(e) => "C ERR " + rt_err_name(e) + "\n"
    Ok(None) => "C NONE\n"
    Ok(Some(b)) => {
      let mut h = rt_fnv_init
      let mut i = 0
      while i < b.length() {
        h = rt_fnv_byte(h, b[i].to_int())
        i = i + 1
      }
      "C OK " + b.length().to_string() + " " + rt_hex64(h, 16) + "\n" + rt_dump_profile(b)
    }
  }
}
