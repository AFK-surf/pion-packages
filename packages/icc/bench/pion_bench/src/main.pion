///| Pion Native head-to-head benchmark for `packages/icc`.
///| Usage:
///|   icc_pion_bench parse <icc_path> <iters>
///|   icc_pion_bench rgba  <icc_path> <rgba_path> <frames> [dump_out_path]

import "icc"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: icc_pion_bench <parse|rgba> ...")
    return 1
  }
  let mode = args[1]
  let icc_bytes = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read icc")
      return 1
    }
  }

  if mode == "parse" {
    let iters = parse_int(args[3])
    let mut acc : Int64 = 0L
    let mut it = 0
    while it < iters {
      let prof = match icc::parse(icc_bytes) {
        Ok(p) => p
        Err(e) => {
          io_println(world, "parse err: " + e.to_string())
          return 1
        }
      }
      let tf = match icc::Transform::to_srgb(prof) {
        Ok(t) => t
        Err(e) => {
          io_println(world, "transform err: " + e.to_string())
          return 1
        }
      }
      let (r, g, b) = tf.transform_rgb_pixel(128.to_byte(), 128.to_byte(), 128.to_byte())
      acc = acc + r.to_int().to_int64() + g.to_int().to_int64() + b.to_int().to_int64()
      it = it + 1
    }
    io_println(world, "PARSE_OK iters=" + iters.to_string() + " probe_sum=" + acc.to_string())
    return 0
  }

  if mode == "rgba" {
    if args.length() < 5 {
      io_println(world, "usage: icc_pion_bench rgba <icc_path> <rgba_path> <frames> [dump_out]")
      return 1
    }
    let src_bytes = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read rgba")
        return 1
      }
    }
    let frames = parse_int(args[4])
    let prof = match icc::parse(icc_bytes) {
      Ok(p) => p
      Err(e) => {
        io_println(world, "parse err: " + e.to_string())
        return 1
      }
    }
    let tf = match icc::Transform::to_srgb(prof) {
      Ok(t) => t
      Err(e) => {
        io_println(world, "transform err: " + e.to_string())
        return 1
      }
    }
    let n = src_bytes.length()
    let work : Array[Byte] = Array::new()
    let mut i = 0
    while i < n {
      work.push(src_bytes[i])
      i = i + 1
    }
    let mut alpha_sum : Int64 = 0L
    let mut f = 0
    while f < frames {
      // Restore source bytes into work buffer before each frame transform?
      // To benchmark pure transform throughput (matching Rust in-place/out-buf), transform work in place.
      // Note: to keep exact same input every frame without memcpy bias, copy only if dump_out requested (frames=1).
      match tf.transform_rgba_in_place(work) {
        Ok(_) => ()
        Err(e) => {
          io_println(world, "rgba err: " + e.to_string())
          return 1
        }
      }
      alpha_sum = alpha_sum + work[3].to_int().to_int64() + work[n - 1].to_int().to_int64()
      f = f + 1
    }
    if args.length() >= 6 {
      let out = Bytes::new(n)
      i = 0
      while i < n {
        out[i] = work[i]
        i = i + 1
      }
      let _ = fs_write_bytes(world, args[5], out)
    }
    // Print deterministic summary (alpha sum + frame count + pixel count)
    io_println(
      world,
      "RGBA_OK frames=" +
      frames.to_string() +
      " pixels=" +
      (n / 4).to_string() +
      " alpha_check=" +
      alpha_sum.to_string(),
    )
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
