///| Pion Native head-to-head benchmark for `packages/icc`.
///| Usage:
///|   icc_pion_bench parse <icc_path> <iters>
///|   icc_pion_bench rgba  <icc_path> <rgba_path> <frames> [dump_out_path]

import "icc"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: icc_pion_bench <parse|rgba> ...")
    return 1
  }
  let mode = args[1]
  let icc_bytes = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read icc")
      return 1
    }
  }

  if mode == "parse" {
    let iters = parse_int(args[3])
    let mut acc : Int64 = 0L
    let mut it = 0
    while it < iters {
      let prof = match icc::parse(icc_bytes) {
        Ok(p) => p
        Err(e) => {
          io_println(world, "parse err: " + e.to_string())
          return 1
        }
      }
      let tf = match icc::Transform::to_srgb(prof) {
        Ok(t) => t
        Err(e) => {
          io_println(world, "transform err: " + e.to_string())
          return 1
        }
      }
      // Saturated non-neutral probe (200, 70, 40): moves significantly under P3/AdobeRGB/Rec.2020
      // and distinguishes real gamut transforms from identity sRGB.
      let (r, g, b) = tf.transform_rgb_pixel(200.to_byte(), 70.to_byte(), 40.to_byte())
      // Pack per-channel >> 4 buckets so <= 1 LSB engine rounding matches while gamut shifts diverge sharply.
      acc = acc + (((r.to_int() >> 4) << 8) | ((g.to_int() >> 4) << 4) | (b.to_int() >> 4)).to_int64()
      it = it + 1
    }
    io_println(world, "PARSE_OK iters=" + iters.to_string() + " probe_qsum=" + acc.to_string())
    return 0
  }

  if mode == "rgba" {
    if args.length() < 5 {
      io_println(world, "usage: icc_pion_bench rgba <icc_path> <rgba_path> <frames> [dump_out]")
      return 1
    }
    let src_bytes = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read rgba")
        return 1
      }
    }
    let frames = parse_int(args[4])
    let prof = match icc::parse(icc_bytes) {
      Ok(p) => p
      Err(e) => {
        io_println(world, "parse err: " + e.to_string())
        return 1
      }
    }
    let tf = match icc::Transform::to_srgb(prof) {
      Ok(t) => t
      Err(e) => {
        io_println(world, "transform err: " + e.to_string())
        return 1
      }
    }
    let n = src_bytes.length()
    let work : Array[Byte] = Array::make(n, b'\x00')
    let mut i = 0
    while i < n {
      work[i] = src_bytes[i]
      i = i + 1
    }
    let mut alpha_sum : Int64 = 0L
    let mut f = 0
    while f < frames {
      match tf.transform_rgba_in_place(work) {
        Ok(_) => ()
        Err(e) => {
          io_println(world, "rgba err: " + e.to_string())
          return 1
        }
      }
      alpha_sum = alpha_sum + work[3].to_int().to_int64() + work[n - 1].to_int().to_int64()
      f = f + 1
    }
    // Tolerance-stable whole-frame color digest (mean RGB rounded to integer, ~0.001 LSB sensitivity
    // to real gamut shifts while immune to <= 1 LSB engine rounding).
    let mut sum_r : Int64 = 0L
    let mut sum_g : Int64 = 0L
    let mut sum_b : Int64 = 0L
    i = 0
    while i < n {
      sum_r = sum_r + work[i].to_int().to_int64()
      sum_g = sum_g + work[i + 1].to_int().to_int64()
      sum_b = sum_b + work[i + 2].to_int().to_int64()
      i = i + 4
    }
    let px_cnt = (n / 4).to_int64()
    let avg_r = (sum_r + px_cnt / 2L) / px_cnt
    let avg_g = (sum_g + px_cnt / 2L) / px_cnt
    let avg_b = (sum_b + px_cnt / 2L) / px_cnt
    if args.length() >= 6 {
      let out = Bytes::new(n)
      i = 0
      while i < n {
        out[i] = work[i]
        i = i + 1
      }
      let _ = fs_write_bytes(world, args[5], out)
    }
    io_println(
      world,
      "RGBA_OK frames=" +
      frames.to_string() +
      " pixels=" +
      px_cnt.to_string() +
      " alpha_check=" +
      alpha_sum.to_string() +
      " avg_rgb=" +
      avg_r.to_string() +
      "," +
      avg_g.to_string() +
      "," +
      avg_b.to_string(),
    )
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
