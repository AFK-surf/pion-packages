///| Wasm32 + Native 4-mode smoke entry for `packages/icc`.

import "icc"

fn push_u8(buf : Array[Int], v : Int) -> Unit {
  buf.push(v & 0xFF)
}

fn push_u16_be(buf : Array[Int], v : Int) -> Unit {
  buf.push((v >> 8) & 0xFF)
  buf.push(v & 0xFF)
}

fn push_u32_be(buf : Array[Int], v : Int64) -> Unit {
  buf.push(((v >> 24) & 0xFFL).to_int())
  buf.push(((v >> 16) & 0xFFL).to_int())
  buf.push(((v >> 8) & 0xFFL).to_int())
  buf.push((v & 0xFFL).to_int())
}

fn push_s15f16(buf : Array[Int], v : Double) -> Unit {
  let scaled = if v >= 0.0 {
    (v * 65536.0 + 0.5).to_int64()
  } else {
    (v * 65536.0 - 0.5).to_int64()
  }
  let u = if scaled < 0L { scaled + 0x100000000L } else { scaled }
  push_u32_be(buf, u)
}

fn push_str(buf : Array[Int], s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    buf.push(s.code_unit_at(i) & 0xFF)
    i = i + 1
  }
}

fn to_bytes(arr : Array[Int]) -> Bytes {
  let n = arr.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = arr[i].to_byte()
    i = i + 1
  }
  out
}

fn build_p3_bytes() -> Bytes {
  let tags : Array[(String, Array[Int])] = []
  // rXYZ, gXYZ, bXYZ
  let rx : Array[Int] = []
  push_str(rx, "XYZ ")
  push_u32_be(rx, 0L)
  push_s15f16(rx, 0.515121)
  push_s15f16(rx, 0.241196)
  push_s15f16(rx, -0.001053)
  tags.push(("rXYZ", rx))

  let gx : Array[Int] = []
  push_str(gx, "XYZ ")
  push_u32_be(gx, 0L)
  push_s15f16(gx, 0.291977)
  push_s15f16(gx, 0.692245)
  push_s15f16(gx, 0.041885)
  tags.push(("gXYZ", gx))

  let bx : Array[Int] = []
  push_str(bx, "XYZ ")
  push_u32_be(bx, 0L)
  push_s15f16(bx, 0.157104)
  push_s15f16(bx, 0.066574)
  push_s15f16(bx, 0.784073)
  tags.push(("bXYZ", bx))

  let trc : Array[Int] = []
  push_str(trc, "para")
  push_u32_be(trc, 0L)
  push_u16_be(trc, 3)
  push_u16_be(trc, 0)
  push_s15f16(trc, 2.4)
  push_s15f16(trc, 1.0 / 1.055)
  push_s15f16(trc, 0.055 / 1.055)
  push_s15f16(trc, 1.0 / 12.92)
  push_s15f16(trc, 0.04045)
  tags.push(("rTRC", trc))

  let total_tags = 6
  let mut off = 128 + 4 + total_tags * 12
  let offs : Array[Int] = []
  let szs : Array[Int] = []
  let mut i = 0
  while i < tags.length() {
    let (_, p) = tags[i]
    offs.push(off)
    szs.push(p.length())
    off = off + p.length()
    while off % 4 != 0 {
      off = off + 1
    }
    i = i + 1
  }

  let buf : Array[Int] = []
  push_u32_be(buf, off.to_int64())
  push_str(buf, "pion")
  push_u8(buf, 4)
  push_u8(buf, 0)
  push_u8(buf, 0)
  push_u8(buf, 0)
  push_str(buf, "mntr")
  push_str(buf, "RGB ")
  push_str(buf, "XYZ ")
  let mut z = 0
  while z < 12 {
    push_u8(buf, 0)
    z = z + 1
  }
  push_str(buf, "acsp")
  push_str(buf, "APPL")
  z = 0
  while z < 24 {
    push_u8(buf, 0)
    z = z + 1
  }
  push_s15f16(buf, 0.96420288)
  push_s15f16(buf, 1.0)
  push_s15f16(buf, 0.82490540)
  z = 0
  while z < 48 {
    push_u8(buf, 0)
    z = z + 1
  }
  push_u32_be(buf, total_tags.to_int64())
  i = 0
  while i < tags.length() {
    let (sig, _) = tags[i]
    push_str(buf, sig)
    push_u32_be(buf, offs[i].to_int64())
    push_u32_be(buf, szs[i].to_int64())
    i = i + 1
  }
  push_str(buf, "gTRC")
  push_u32_be(buf, offs[3].to_int64())
  push_u32_be(buf, szs[3].to_int64())
  push_str(buf, "bTRC")
  push_u32_be(buf, offs[3].to_int64())
  push_u32_be(buf, szs[3].to_int64())

  i = 0
  while i < tags.length() {
    let (_, p) = tags[i]
    while buf.length() < offs[i] {
      push_u8(buf, 0)
    }
    let mut k = 0
    while k < p.length() {
      push_u8(buf, p[k])
      k = k + 1
    }
    i = i + 1
  }
  while buf.length() < off {
    push_u8(buf, 0)
  }
  to_bytes(buf)
}

fn fnv1a64_bytes(arr : Array[Byte]) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = arr.length()
  let mut i = 0
  while i < n {
    h = h ^ arr[i].to_int().to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

pub fn main(world : World) -> Int {
  let p3_bytes = build_p3_bytes()
  let prof = match icc::parse(p3_bytes) {
    Ok(p) => p
    Err(e) => {
      io_println(world, "icc_wasm_smoke: FAIL parse " + e.to_string())
      return 1
    }
  }
  let tf = match icc::Transform::to_srgb(prof) {
    Ok(t) => t
    Err(e) => {
      io_println(world, "icc_wasm_smoke: FAIL transform " + e.to_string())
      return 1
    }
  }
  let rgba : Array[Byte] = []
  let mut r = 0
  while r <= 255 {
    let mut g = 0
    while g <= 255 {
      let mut b = 0
      while b <= 255 {
        rgba.push(r.to_byte())
        rgba.push(g.to_byte())
        rgba.push(b.to_byte())
        rgba.push(213.to_byte())
        b = b + 51
      }
      g = g + 51
    }
    r = r + 51
  }
  match tf.transform_rgba_in_place(rgba) {
    Ok(_) => ()
    Err(e) => {
      io_println(world, "icc_wasm_smoke: FAIL rgba " + e.to_string())
      return 1
    }
  }
  let h = fnv1a64_bytes(rgba)
  io_println(
    world,
    "icc_wasm_smoke: OK pixels=" + (rgba.length() / 4).to_string() + " fnv64=" + h.to_string(),
  )
  0
}
