///| Public types, errors, ICC v2/v4 metadata structures, and read-only accessors for `packages/icc`.
///| Pure Pion ICC.1:2022 parser, JPEG/WebP ICC extractor, and sRGB color transform engine.

///| Maximum number of tags accepted in an ICC profile tag table (DoS guard).
pub let max_tag_count : Int = 4096

///| Maximum number of records accepted in an `mluc` tag (DoS guard).
pub let max_mluc_records : Int = 4096

///| Maximum number of entries accepted in a `curv` 16-bit table (DoS guard).
pub let max_curve_entries : Int = 65536

///| Error returned when extracting, parsing, or applying an ICC profile.
pub enum IccError {
  UnexpectedEof(String)
  InvalidHeader(String)
  InvalidTagTable(String)
  InvalidTag(String)
  InvalidContainer(String)
  UnsupportedProfile(String)
  InvalidBuffer(String)
}

///| Human-readable error message for `IccError`.
pub fn icc_error_message(err : IccError) -> String {
  match err {
    IccError::UnexpectedEof(msg) => "unexpected EOF: " + msg
    IccError::InvalidHeader(msg) => "invalid ICC header: " + msg
    IccError::InvalidTagTable(msg) => "invalid ICC tag table: " + msg
    IccError::InvalidTag(msg) => "invalid ICC tag: " + msg
    IccError::InvalidContainer(msg) => "invalid image container: " + msg
    IccError::UnsupportedProfile(msg) => "unsupported ICC profile: " + msg
    IccError::InvalidBuffer(msg) => "invalid pixel buffer: " + msg
  }
}

///|
pub fn IccError::to_string(self : IccError) -> String {
  icc_error_message(self)
}

///| ICC profile version (`major.minor.bugfix`).
pub val struct Version {
  pub major : Int
  pub minor : Int
  pub bugfix : Int
}

///|
pub fn Version::to_string(self : Version) -> String {
  self.major.to_string() + "." + self.minor.to_string() + "." + self.bugfix.to_string()
}

///| ICC header creation date and time (UTC).
pub val struct DateTime {
  pub year : Int
  pub month : Int
  pub day : Int
  pub hour : Int
  pub minute : Int
  pub second : Int
}

///| ICC profile device class signature.
pub enum DeviceClass {
  Input
  Display
  Output
  DeviceLink
  ColorSpace
  Abstract
  NamedColor
  Other(String)
}

///|
pub fn DeviceClass::signature(self : DeviceClass) -> String {
  match self {
    DeviceClass::Input => "scnr"
    DeviceClass::Display => "mntr"
    DeviceClass::Output => "prtr"
    DeviceClass::DeviceLink => "link"
    DeviceClass::ColorSpace => "spac"
    DeviceClass::Abstract => "abst"
    DeviceClass::NamedColor => "nmcl"
    DeviceClass::Other(s) => s
  }
}

///|
pub fn DeviceClass::to_string(self : DeviceClass) -> String {
  self.signature()
}

///| ICC data color space or PCS signature.
pub enum ColorSpace {
  Rgb
  Gray
  Cmyk
  Xyz
  Lab
  Other(String)
}

///|
pub fn ColorSpace::signature(self : ColorSpace) -> String {
  match self {
    ColorSpace::Rgb => "RGB "
    ColorSpace::Gray => "GRAY"
    ColorSpace::Cmyk => "CMYK"
    ColorSpace::Xyz => "XYZ "
    ColorSpace::Lab => "Lab "
    ColorSpace::Other(s) => s
  }
}

///|
pub fn ColorSpace::to_string(self : ColorSpace) -> String {
  self.signature()
}

///| ICC rendering intent (header bytes 64..68).
pub enum RenderingIntent {
  Perceptual
  RelativeColorimetric
  Saturation
  AbsoluteColorimetric
}

///|
pub fn RenderingIntent::to_int(self : RenderingIntent) -> Int {
  match self {
    RenderingIntent::Perceptual => 0
    RenderingIntent::RelativeColorimetric => 1
    RenderingIntent::Saturation => 2
    RenderingIntent::AbsoluteColorimetric => 3
  }
}

///|
pub fn RenderingIntent::to_string(self : RenderingIntent) -> String {
  match self {
    RenderingIntent::Perceptual => "Perceptual"
    RenderingIntent::RelativeColorimetric => "RelativeColorimetric"
    RenderingIntent::Saturation => "Saturation"
    RenderingIntent::AbsoluteColorimetric => "AbsoluteColorimetric"
  }
}

///| CIE XYZ tristimulus value decoded from `s15Fixed16Number`.
pub val struct Xyz {
  pub x : Double
  pub y : Double
  pub z : Double
}

///|
pub fn Xyz::new(x : Double, y : Double, z : Double) -> Xyz {
  Xyz::{ x: x, y: y, z: z }
}

///| Row-major 3x3 matrix.
pub val struct Matrix3x3 {
  pub m00 : Double
  pub m01 : Double
  pub m02 : Double
  pub m10 : Double
  pub m11 : Double
  pub m12 : Double
  pub m20 : Double
  pub m21 : Double
  pub m22 : Double
}

///|
pub fn Matrix3x3::new(
  m00 : Double,
  m01 : Double,
  m02 : Double,
  m10 : Double,
  m11 : Double,
  m12 : Double,
  m20 : Double,
  m21 : Double,
  m22 : Double,
) -> Matrix3x3 {
  Matrix3x3::{
    m00: m00,
    m01: m01,
    m02: m02,
    m10: m10,
    m11: m11,
    m12: m12,
    m20: m20,
    m21: m21,
    m22: m22,
  }
}

///| ICC Tone Reproduction Curve (`curv` or `para`).
pub enum ToneCurve {
  Identity
  Gamma(Double)
  Table(Array[Int])
  Parametric(Int, Double, Double, Double, Double, Double, Double, Double)
}

///| Raw tag table entry.
pub val struct TagRecord {
  pub signature : String
  pub offset : Int
  pub size : Int
}

///| Parsed ICC v2/v4 color profile (immutable value).
pub struct Profile {
  pub profile_size : Int
  pub cmm_type : String
  pub version : Version
  pub device_class : DeviceClass
  pub color_space : ColorSpace
  pub pcs : ColorSpace
  pub created : DateTime
  pub platform : String
  pub flags : Int64
  pub device_manufacturer : String
  pub device_model : String
  pub rendering_intent : RenderingIntent
  pub pcs_illuminant : Xyz
  pub creator : String
  pub profile_id : Bytes
  pub tags : Array[TagRecord]
  pub description : Option[String]
  pub red_xyz : Option[Xyz]
  pub green_xyz : Option[Xyz]
  pub blue_xyz : Option[Xyz]
  pub white_point : Option[Xyz]
  pub black_point : Option[Xyz]
  pub chad : Option[Matrix3x3]
  pub red_trc : Option[ToneCurve]
  pub green_trc : Option[ToneCurve]
  pub blue_trc : Option[ToneCurve]
  pub gray_trc : Option[ToneCurve]
}

///| Return profile description (`desc` v2 or `mluc` v4).
pub fn Profile::description(self : Profile) -> Option[String] {
  self.description
}

///| Return profile data color space.
pub fn Profile::color_space(self : Profile) -> ColorSpace {
  self.color_space
}

///| Return profile connection space (PCS).
pub fn Profile::pcs(self : Profile) -> ColorSpace {
  self.pcs
}

///| Return profile device class.
pub fn Profile::device_class(self : Profile) -> DeviceClass {
  self.device_class
}

///| Return profile version.
pub fn Profile::version(self : Profile) -> Version {
  self.version
}

///| Return header rendering intent.
pub fn Profile::rendering_intent(self : Profile) -> RenderingIntent {
  self.rendering_intent
}

///| Return header PCS illuminant.
pub fn Profile::pcs_illuminant(self : Profile) -> Xyz {
  self.pcs_illuminant
}

///| Return media white point (`wtpt`), if present.
pub fn Profile::white_point(self : Profile) -> Option[Xyz] {
  self.white_point
}

///| Return media black point (`bkpt`), if present.
pub fn Profile::black_point(self : Profile) -> Option[Xyz] {
  self.black_point
}

///| Return chromatic adaptation matrix (`chad`), if present.
pub fn Profile::chad(self : Profile) -> Option[Matrix3x3] {
  self.chad
}

///| Return the 3x3 RGB-to-PCS(D50) primary matrix `[rXYZ, gXYZ, bXYZ]` as columns, if all three are present.
pub fn Profile::matrix(self : Profile) -> Option[Matrix3x3] {
  match (self.red_xyz, self.green_xyz, self.blue_xyz) {
    (Some(r), Some(g), Some(b)) =>
    Some(Matrix3x3::new(r.x, g.x, b.x, r.y, g.y, b.y, r.z, g.z, b.z))
    _ => None
  }
}

///| Return all raw tag table records.
pub fn Profile::tags(self : Profile) -> Array[TagRecord] {
  self.tags
}

///| Return whether the profile contains a tag with the given 4-byte signature.
pub fn Profile::has_tag(self : Profile, sig : String) -> Bool {
  let n = self.tags.length()
  let mut i = 0
  while i < n {
    if self.tags[i].signature == sig {
      return true
    }
    i = i + 1
  }
  false
}

///| Return the 16-byte Profile ID from header bytes 84..100.
pub fn Profile::profile_id(self : Profile) -> Bytes {
  self.profile_id
}

///| Return `rTRC`, if present.
pub fn Profile::red_trc(self : Profile) -> Option[ToneCurve] {
  self.red_trc
}

///| Return `gTRC`, if present.
pub fn Profile::green_trc(self : Profile) -> Option[ToneCurve] {
  self.green_trc
}

///| Return `bTRC`, if present.
pub fn Profile::blue_trc(self : Profile) -> Option[ToneCurve] {
  self.blue_trc
}

///| Return `kTRC`, if present.
pub fn Profile::gray_trc(self : Profile) -> Option[ToneCurve] {
  self.gray_trc
}
