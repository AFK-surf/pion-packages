///| Return precomputed sRGB EOTF value in Q14 (`0..16384`) for 8-bit input `i` (`0..255`).
fn srgb_eotf_at(i : Int) -> Int {
  if i >= 255 {
    16384
  } else {
    let p = i << 1
    srgb_eotf_enc.code_unit_at(p) | (srgb_eotf_enc.code_unit_at(p + 1) << 7)
  }
}

///| Build a fresh 256-entry Q14 sRGB EOTF `FixedArray[Int]` from the immutable constant table.
fn build_srgb_eotf_q14() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let s = srgb_eotf_enc
  let mut i = 0
  while i < 255 {
    let p = i << 1
    lut[i] = s.code_unit_at(p) | (s.code_unit_at(p + 1) << 7)
    i = i + 1
  }
  lut[255] = 16384
  lut
}

///| Return precomputed sRGB OETF 8-bit value for linear index `idx` in `0..8192`.
fn srgb_oetf_at(idx : Int) -> Byte {
  let lo = srgb_oetf_lo7.code_unit_at(idx)
  (if idx >= 1754 { lo | 128 } else { lo }).to_byte()
}

///| Materialize a local 8193-entry sRGB OETF `FixedArray[Byte]` for bulk pixel loops.
fn decode_srgb_oetf_8193() -> FixedArray[Byte] {
  let out : FixedArray[Byte] = FixedArray::make(8193, b'\x00')
  let s = srgb_oetf_lo7
  let mut i = 0
  while i < 1754 {
    out[i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  while i < 8193 {
    out[i] = (s.code_unit_at(i) | 128).to_byte()
    i = i + 1
  }
  out
}
