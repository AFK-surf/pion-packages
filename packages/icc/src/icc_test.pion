///| Comprehensive unit, ICC.1:2022 compliance, container, color transform accuracy,
///| and red-team adversarial test suite for `packages/icc`.

fn assert_eq_int(a : Int, b : Int, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn assert_eq_str(a : String, b : String, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got '" + a + "', expected '" + b + "'")
}

fn assert_eq_bool(a : Bool, b : Bool, msg : String) -> Unit {
  debug_assert(a == b, msg)
}

fn assert_near(a : Double, b : Double, eps : Double, msg : String) -> Unit {
  let diff = if a >= b { a - b } else { b - a }
  debug_assert(diff <= eps, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn assert_near_u8(a : Int, b : Int, tol : Int, msg : String) -> Unit {
  let diff = if a >= b { a - b } else { b - a }
  debug_assert(
    diff <= tol,
    msg + ": got " + a.to_string() + ", expected " + b.to_string() + " (tol=" + tol.to_string() + ")",
  )
}

fn push_u8(buf : Array[Int], v : Int) -> Unit {
  buf.push(v & 0xFF)
}

fn push_u16_be(buf : Array[Int], v : Int) -> Unit {
  buf.push((v >> 8) & 0xFF)
  buf.push(v & 0xFF)
}

fn push_u32_be(buf : Array[Int], v : Int64) -> Unit {
  buf.push(((v >> 24) & 0xFFL).to_int())
  buf.push(((v >> 16) & 0xFFL).to_int())
  buf.push(((v >> 8) & 0xFFL).to_int())
  buf.push((v & 0xFFL).to_int())
}

fn push_u32_le(buf : Array[Int], v : Int64) -> Unit {
  buf.push((v & 0xFFL).to_int())
  buf.push(((v >> 8) & 0xFFL).to_int())
  buf.push(((v >> 16) & 0xFFL).to_int())
  buf.push(((v >> 24) & 0xFFL).to_int())
}

fn push_s15fixed16(buf : Array[Int], v : Double) -> Unit {
  let scaled = if v >= 0.0 {
    (v * 65536.0 + 0.5).to_int64()
  } else {
    (v * 65536.0 - 0.5).to_int64()
  }
  let u = if scaled < 0L { scaled + 0x100000000L } else { scaled }
  push_u32_be(buf, u)
}

fn push_fourcc(buf : Array[Int], s : String) -> Unit {
  let mut i = 0
  while i < 4 {
    buf.push(s.code_unit_at(i) & 0xFF)
    i = i + 1
  }
}

fn push_str(buf : Array[Int], s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    buf.push(s.code_unit_at(i) & 0xFF)
    i = i + 1
  }
}

fn to_bytes(arr : Array[Int]) -> Bytes {
  let n = arr.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = arr[i].to_byte()
    i = i + 1
  }
  out
}

fn make_xyz_tag(x : Double, y : Double, z : Double) -> Array[Int] {
  let b : Array[Int] = []
  push_fourcc(b, "XYZ ")
  push_u32_be(b, 0L)
  push_s15fixed16(b, x)
  push_s15fixed16(b, y)
  push_s15fixed16(b, z)
  b
}

fn make_desc_tag(ascii : String) -> Array[Int] {
  let b : Array[Int] = []
  push_fourcc(b, "desc")
  push_u32_be(b, 0L)
  push_u32_be(b, (ascii.length() + 1).to_int64())
  push_str(b, ascii)
  push_u8(b, 0)
  // Minimal trailing fields (unicode lang/count + scriptcode)
  push_u32_be(b, 0L)
  push_u32_be(b, 0L)
  push_u16_be(b, 0)
  push_u8(b, 0)
  let mut i = 0
  while i < 67 {
    push_u8(b, 0)
    i = i + 1
  }
  b
}

fn make_mluc_tag(utf16_units : Array[Int]) -> Array[Int] {
  let b : Array[Int] = []
  push_fourcc(b, "mluc")
  push_u32_be(b, 0L)
  push_u32_be(b, 1L) // 1 record
  push_u32_be(b, 12L) // record size
  push_str(b, "enUS")
  push_u32_be(b, (utf16_units.length() * 2).to_int64())
  push_u32_be(b, 28L) // offset = 16 + 12
  let mut i = 0
  while i < utf16_units.length() {
    push_u16_be(b, utf16_units[i])
    i = i + 1
  }
  b
}

fn make_curv_gamma(gamma : Double) -> Array[Int] {
  let b : Array[Int] = []
  push_fourcc(b, "curv")
  push_u32_be(b, 0L)
  push_u32_be(b, 1L)
  let u8f8 = (gamma * 256.0 + 0.5).to_int()
  push_u16_be(b, u8f8)
  b
}

fn make_curv_identity() -> Array[Int] {
  let b : Array[Int] = []
  push_fourcc(b, "curv")
  push_u32_be(b, 0L)
  push_u32_be(b, 0L)
  b
}

fn make_curv_table(entries : Array[Int]) -> Array[Int] {
  let b : Array[Int] = []
  push_fourcc(b, "curv")
  push_u32_be(b, 0L)
  push_u32_be(b, entries.length().to_int64())
  let mut i = 0
  while i < entries.length() {
    push_u16_be(b, entries[i])
    i = i + 1
  }
  b
}

fn make_para_tag(func_type : Int, params : Array[Double]) -> Array[Int] {
  let b : Array[Int] = []
  push_fourcc(b, "para")
  push_u32_be(b, 0L)
  push_u16_be(b, func_type)
  push_u16_be(b, 0)
  let mut i = 0
  while i < params.length() {
    push_s15fixed16(b, params[i])
    i = i + 1
  }
  b
}

fn make_sf32_tag(vals : Array[Double]) -> Array[Int] {
  let b : Array[Int] = []
  push_fourcc(b, "sf32")
  push_u32_be(b, 0L)
  let mut i = 0
  while i < vals.length() {
    push_s15fixed16(b, vals[i])
    i = i + 1
  }
  b
}

///| Build a valid synthetic ICC profile from tag payloads.
///| `shared_aliases`: list of `(new_sig, existing_sig)` sharing the same offset & size.
fn build_icc_profile(
  major : Int,
  minor : Int,
  device_class : String,
  color_space : String,
  pcs : String,
  intent : Int,
  tags : Array[(String, Array[Int])],
  shared_aliases : Array[(String, String)],
) -> Bytes {
  let total_tags = tags.length() + shared_aliases.length()
  let header_and_table = 128 + 4 + total_tags * 12
  let mut cur_off = header_and_table
  // Align to 4 bytes
  while cur_off % 4 != 0 {
    cur_off = cur_off + 1
  }

  let offsets : Array[Int] = []
  let sizes : Array[Int] = []
  let mut i = 0
  while i < tags.length() {
    let (_, payload) = tags[i]
    offsets.push(cur_off)
    sizes.push(payload.length())
    cur_off = cur_off + payload.length()
    while cur_off % 4 != 0 {
      cur_off = cur_off + 1
    }
    i = i + 1
  }
  let profile_size = cur_off

  let buf : Array[Int] = []
  // 0..4 profile size
  push_u32_be(buf, profile_size.to_int64())
  // 4..8 CMM type
  push_fourcc(buf, "pion")
  // 8..12 version
  push_u8(buf, major)
  push_u8(buf, (minor & 0x0F) << 4)
  push_u8(buf, 0)
  push_u8(buf, 0)
  // 12..16 device class
  push_fourcc(buf, device_class)
  // 16..20 color space
  push_fourcc(buf, color_space)
  // 20..24 PCS
  push_fourcc(buf, pcs)
  // 24..36 DateTime: 2026-11-24 12:34:56
  push_u16_be(buf, 2026)
  push_u16_be(buf, 11)
  push_u16_be(buf, 24)
  push_u16_be(buf, 12)
  push_u16_be(buf, 34)
  push_u16_be(buf, 56)
  // 36..40 magic 'acsp'
  push_fourcc(buf, "acsp")
  // 40..44 platform
  push_fourcc(buf, "APPL")
  // 44..48 flags
  push_u32_be(buf, 0L)
  // 48..52 manufacturer
  push_fourcc(buf, "PION")
  // 52..56 model
  push_fourcc(buf, "TEST")
  // 56..64 device attributes
  push_u32_be(buf, 0L)
  push_u32_be(buf, 0L)
  // 64..68 rendering intent
  push_u32_be(buf, intent.to_int64())
  // 68..80 PCS illuminant D50
  push_s15fixed16(buf, 0.96420288)
  push_s15fixed16(buf, 1.0)
  push_s15fixed16(buf, 0.82490540)
  // 80..84 creator
  push_fourcc(buf, "pion")
  // 84..100 profile ID (16 bytes)
  let mut pid_i = 0
  while pid_i < 16 {
    push_u8(buf, pid_i + 1)
    pid_i = pid_i + 1
  }
  // 100..128 reserved (28 bytes)
  let mut res_i = 0
  while res_i < 28 {
    push_u8(buf, 0)
    res_i = res_i + 1
  }

  // Tag table
  push_u32_be(buf, total_tags.to_int64())
  i = 0
  while i < tags.length() {
    let (sig, _) = tags[i]
    push_fourcc(buf, sig)
    push_u32_be(buf, offsets[i].to_int64())
    push_u32_be(buf, sizes[i].to_int64())
    i = i + 1
  }
  let mut a = 0
  while a < shared_aliases.length() {
    let (new_sig, target_sig) = shared_aliases[a]
    let mut found_off = 0
    let mut found_sz = 0
    let mut j = 0
    while j < tags.length() {
      let (s, _) = tags[j]
      if s == target_sig {
        found_off = offsets[j]
        found_sz = sizes[j]
      }
      j = j + 1
    }
    push_fourcc(buf, new_sig)
    push_u32_be(buf, found_off.to_int64())
    push_u32_be(buf, found_sz.to_int64())
    a = a + 1
  }

  // Pad to first tag
  while buf.length() < cur_off && tags.length() > 0 && buf.length() < offsets[0] {
    push_u8(buf, 0)
  }

  // Tag payloads
  i = 0
  while i < tags.length() {
    let (_, payload) = tags[i]
    while buf.length() < offsets[i] {
      push_u8(buf, 0)
    }
    let mut k = 0
    while k < payload.length() {
      push_u8(buf, payload[k])
      k = k + 1
    }
    i = i + 1
  }
  while buf.length() < profile_size {
    push_u8(buf, 0)
  }
  to_bytes(buf)
}

fn build_synthetic_display_p3() -> Bytes {
  // Display P3 D50-adapted primaries (Apple Display P3 / ICC v4)
  let trc = make_para_tag(3, [2.4, 1.0 / 1.055, 0.055 / 1.055, 1.0 / 12.92, 0.04045])
  let chad = make_sf32_tag([
    1.047882, 0.022919, -0.050201,
    0.029587, 0.990479, -0.017059,
    -0.009232, 0.015076, 0.751678,
  ])
  // "Display P3" in UTF-16BE
  let mluc = make_mluc_tag([0x44, 0x69, 0x73, 0x70, 0x6C, 0x61, 0x79, 0x20, 0x50, 0x33])
  build_icc_profile(
    4,
    0,
    "mntr",
    "RGB ",
    "XYZ ",
    0,
    [
      ("desc", mluc),
      ("wtpt", make_xyz_tag(0.950455, 1.0, 1.089050)),
      ("rXYZ", make_xyz_tag(0.515121, 0.241196, -0.001053)),
      ("gXYZ", make_xyz_tag(0.291977, 0.692245, 0.041885)),
      ("bXYZ", make_xyz_tag(0.157104, 0.066574, 0.784073)),
      ("rTRC", trc),
      ("chad", chad),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
}

fn build_synthetic_srgb() -> Bytes {
  let trc = make_para_tag(3, [2.4, 1.0 / 1.055, 0.055 / 1.055, 1.0 / 12.92, 0.04045])
  build_icc_profile(
    2,
    1,
    "mntr",
    "RGB ",
    "XYZ ",
    0,
    [
      ("desc", make_desc_tag("sRGB IEC61966-2.1")),
      ("wtpt", make_xyz_tag(0.950455, 1.0, 1.089050)),
      ("bkpt", make_xyz_tag(0.0, 0.0, 0.0)),
      ("rXYZ", make_xyz_tag(0.436066, 0.222488, 0.013916)),
      ("gXYZ", make_xyz_tag(0.385147, 0.716873, 0.097076)),
      ("bXYZ", make_xyz_tag(0.143066, 0.060608, 0.714096)),
      ("rTRC", trc),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
}

fn build_synthetic_adobergb() -> Bytes {
  // AdobeRGB 1998: gamma 563/256 = 2.19921875
  let trc = make_curv_gamma(563.0 / 256.0)
  build_icc_profile(
    2,
    1,
    "mntr",
    "RGB ",
    "XYZ ",
    0,
    [
      ("desc", make_desc_tag("Adobe RGB (1998)")),
      ("wtpt", make_xyz_tag(0.950455, 1.0, 1.089050)),
      ("rXYZ", make_xyz_tag(0.609741, 0.311111, 0.019470)),
      ("gXYZ", make_xyz_tag(0.205276, 0.625671, 0.060867)),
      ("bXYZ", make_xyz_tag(0.149185, 0.063217, 0.744568)),
      ("rTRC", trc),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
}

fn build_synthetic_gray_gamma22() -> Bytes {
  build_icc_profile(
    2,
    0,
    "mntr",
    "GRAY",
    "XYZ ",
    0,
    [
      ("desc", make_desc_tag("Generic Gray Gamma 2.2")),
      ("wtpt", make_xyz_tag(0.950455, 1.0, 1.089050)),
      ("kTRC", make_curv_gamma(2.2)),
    ],
    [],
  )
}

test "parse_display_p3_v4_header_and_tags" {
  let bytes = build_synthetic_display_p3()
  let prof = match parse(bytes) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse Display P3 failed: " + e.to_string())
      return ()
    }
  }
  assert_eq_int(prof.version().major, 4, "version major")
  assert_eq_int(prof.version().minor, 0, "version minor")
  assert_eq_str(prof.device_class().signature(), "mntr", "device_class")
  assert_eq_str(prof.color_space().signature(), "RGB ", "color_space")
  assert_eq_str(prof.pcs().signature(), "XYZ ", "pcs")
  assert_eq_int(prof.rendering_intent().to_int(), 0, "intent")
  assert_eq_str(prof.description().unwrap_or(""), "Display P3", "mluc desc")
  assert_eq_bool(is_srgb_like(prof), false, "Display P3 is not sRGB-like")
  // Negative s15Fixed16 check: rXYZ.z = -0.001053
  match prof.red_xyz {
    Some(r) => {
      assert_near(r.x, 0.515121, 0.0001, "rXYZ.x")
      assert_near(r.z, -0.001053, 0.0001, "rXYZ.z negative")
    }
    None => debug_assert(false, "missing rXYZ")
  }
  // chad negative entries
  match prof.chad() {
    Some(m) => {
      assert_near(m.m00, 1.047882, 0.0001, "chad.m00")
      assert_near(m.m02, -0.050201, 0.0001, "chad.m02 negative")
    }
    None => debug_assert(false, "missing chad")
  }
  // Shared TRC tags
  assert_eq_bool(prof.red_trc().is_some(), true, "has rTRC")
  assert_eq_bool(prof.green_trc().is_some(), true, "has gTRC")
  assert_eq_bool(prof.blue_trc().is_some(), true, "has bTRC")
  assert_eq_int(prof.profile_id().length(), 16, "profile_id len")
  assert_eq_int(prof.profile_id()[0].to_int(), 1, "profile_id[0]")
}

test "parse_mluc_bmp_and_surrogate_pairs" {
  // "色🎨" -> U+8272 (BMP), U+1F3A8 (surrogate pair 0xD83C, 0xDFA8)
  let mluc = make_mluc_tag([0x8272, 0xD83C, 0xDFA8])
  let bytes = build_icc_profile(4, 3, "mntr", "RGB ", "XYZ ", 1, [("desc", mluc)], [])
  match parse(bytes) {
    Ok(p) => assert_eq_str(p.description().unwrap_or(""), "色🎨", "mluc utf16be surrogate")
    Err(e) => debug_assert(false, "parse mluc failed: " + e.to_string())
  }
}

test "parse_all_parametric_and_curve_types" {
  // Test para types 0, 1, 2, 3, 4 and curv count=0, count=1, count=5
  let p0 = build_icc_profile(4, 0, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_para_tag(0, [2.2]))], [])
  let p1 = build_icc_profile(4, 0, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_para_tag(1, [2.2, 1.0, 0.0]))], [])
  let p2 = build_icc_profile(4, 0, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_para_tag(2, [2.2, 1.0, 0.0, 0.0]))], [])
  let p3 = build_icc_profile(4, 0, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_para_tag(3, [2.4, 0.94786, 0.05214, 0.07739, 0.04045]))], [])
  let p4 = build_icc_profile(4, 0, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_para_tag(4, [2.4, 0.94786, 0.05214, 0.07739, 0.04045, 0.0, 0.0]))], [])
  let c0 = build_icc_profile(2, 1, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_curv_identity())], [])
  let c1 = build_icc_profile(2, 1, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_curv_gamma(1.8))], [])
  let c5 = build_icc_profile(2, 1, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_curv_table([0, 4096, 16384, 36864, 65535]))], [])

  let profiles = [p0, p1, p2, p3, p4, c0, c1, c5]
  let mut i = 0
  while i < profiles.length() {
    match parse(profiles[i]) {
      Ok(prof) => {
        match Transform::to_srgb(prof) {
          Ok(tf) => {
            let out = tf.transform_gray_pixel(128.to_byte()).to_int()
            debug_assert(out > 0 && out < 255, "gray output in range")
          }
          Err(e) => debug_assert(false, "transform failed for curve #" + i.to_string() + ": " + e.to_string())
        }
      }
      Err(e) => debug_assert(false, "parse failed for curve #" + i.to_string() + ": " + e.to_string())
    }
    i = i + 1
  }
}

test "transform_srgb_identity_fast_path" {
  let bytes = build_synthetic_srgb()
  let prof = match parse(bytes) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse sRGB failed: " + e.to_string())
      return ()
    }
  }
  assert_eq_bool(is_srgb_like(prof), true, "sRGB is_srgb_like")
  let tf = match Transform::to_srgb(prof) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "sRGB Transform failed: " + e.to_string())
      return ()
    }
  }
  assert_eq_bool(tf.is_identity(), true, "sRGB identity fast path")
  let (r, g, b) = tf.transform_rgb_pixel(123.to_byte(), 45.to_byte(), 210.to_byte())
  assert_eq_int(r.to_int(), 123, "id r")
  assert_eq_int(g.to_int(), 45, "id g")
  assert_eq_int(b.to_int(), 210, "id b")
}

test "transform_display_p3_and_adobergb_and_alpha_preserved" {
  let p3 = match parse(build_synthetic_display_p3()) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  let tf_p3 = match Transform::to_srgb(p3) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  assert_eq_bool(tf_p3.is_identity(), false, "P3 not identity")
  // Neutral gray stays neutral gray
  let (gr, gg, gb) = tf_p3.transform_rgb_pixel(128.to_byte(), 128.to_byte(), 128.to_byte())
  assert_near_u8(gr.to_int(), 128, 1, "P3 gray r")
  assert_near_u8(gg.to_int(), 128, 1, "P3 gray g")
  assert_near_u8(gb.to_int(), 128, 1, "P3 gray b")
  // Display-P3 saturated red (255, 0, 0) clips to sRGB red (255, 0, 0);
  // Display-P3 mid-red (200, 60, 60) becomes MORE saturated in sRGB (higher R, lower G/B)
  let (pr, pg, pb) = tf_p3.transform_rgb_pixel(200.to_byte(), 60.to_byte(), 60.to_byte())
  debug_assert(pr.to_int() > 210, "P3 red boosts in sRGB")
  debug_assert(pg.to_int() < 55, "P3 red lowers G in sRGB")
  debug_assert(pb.to_int() < 55, "P3 red lowers B in sRGB")

  // RGBA in-place preserves alpha strictly
  let rgba : Array[Byte] = [
    200.to_byte(), 60.to_byte(), 60.to_byte(), 77.to_byte(),
    128.to_byte(), 128.to_byte(), 128.to_byte(), 201.to_byte(),
  ]
  match tf_p3.transform_rgba_in_place(rgba) {
    Ok(_) => ()
    Err(e) => debug_assert(false, e.to_string())
  }
  assert_eq_int(rgba[0].to_int(), pr.to_int(), "rgba[0]")
  assert_eq_int(rgba[1].to_int(), pg.to_int(), "rgba[1]")
  assert_eq_int(rgba[2].to_int(), pb.to_int(), "rgba[2]")
  assert_eq_int(rgba[3].to_int(), 77, "alpha 0 preserved")
  assert_eq_int(rgba[7].to_int(), 201, "alpha 1 preserved")

  // AdobeRGB green (0, 200, 0) boosts green in sRGB
  let adobe = match parse(build_synthetic_adobergb()) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  let tf_adobe = match Transform::to_srgb(adobe) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  let (ar, ag, ab) = tf_adobe.transform_rgb_pixel(40.to_byte(), 180.to_byte(), 40.to_byte())
  debug_assert(ag.to_int() > 175, "AdobeRGB green maps to vivid sRGB green")
  let _ = ar
  let _ = ab

  // Grayscale gamma 2.2 -> sRGB
  let gray_p = match parse(build_synthetic_gray_gamma22()) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  let tf_gray = match Transform::to_srgb(gray_p) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  let (kr, kg, kb) = tf_gray.transform_rgb_pixel(128.to_byte(), 128.to_byte(), 128.to_byte())
  assert_eq_int(kr.to_int(), kg.to_int(), "gray r==g")
  assert_eq_int(kg.to_int(), kb.to_int(), "gray g==b")
  assert_near_u8(kr.to_int(), 129, 2, "gamma 2.2 mid-gray to sRGB")
}

test "container_jpeg_single_and_multi_segment_out_of_order" {
  let icc = build_synthetic_display_p3()
  // 1. Single-segment JPEG with 0xFF fill bytes + APP0 + APP2 ICC + SOS
  let jpg1 : Array[Int] = []
  push_u8(jpg1, 0xFF)
  push_u8(jpg1, 0xD8) // SOI
  push_u8(jpg1, 0xFF)
  push_u8(jpg1, 0xE0) // APP0
  push_u16_be(jpg1, 6)
  push_fourcc(jpg1, "JFIF")
  push_u8(jpg1, 0xFF)
  push_u8(jpg1, 0xFF) // fill byte
  push_u8(jpg1, 0xE2) // APP2
  push_u16_be(jpg1, 2 + 12 + 2 + icc.length())
  push_str(jpg1, "ICC_PROFILE")
  push_u8(jpg1, 0)
  push_u8(jpg1, 1) // seq 1
  push_u8(jpg1, 1) // total 1
  let mut i = 0
  while i < icc.length() {
    push_u8(jpg1, icc[i].to_int())
    i = i + 1
  }
  push_u8(jpg1, 0xFF)
  push_u8(jpg1, 0xDA) // SOS
  push_u8(jpg1, 0xFF)
  push_u8(jpg1, 0xD9) // EOI

  match extract_jpeg_icc(to_bytes(jpg1)) {
    Ok(Some(extracted)) => {
      assert_eq_int(extracted.length(), icc.length(), "single-seg jpeg icc len")
      match parse(extracted) {
        Ok(p) => assert_eq_str(p.description().unwrap_or(""), "Display P3", "single-seg jpeg parsed")
        Err(e) => debug_assert(false, e.to_string())
      }
    }
    _ => debug_assert(false, "expected Some(icc) from single-seg JPEG")
  }

  // 2. Multi-segment JPEG in reverse order (seq 2 then seq 1)
  let split = 200
  let jpg2 : Array[Int] = []
  push_u8(jpg2, 0xFF)
  push_u8(jpg2, 0xD8)
  // Chunk 2 of 2 first
  push_u8(jpg2, 0xFF)
  push_u8(jpg2, 0xE2)
  push_u16_be(jpg2, 2 + 12 + 2 + (icc.length() - split))
  push_str(jpg2, "ICC_PROFILE")
  push_u8(jpg2, 0)
  push_u8(jpg2, 2)
  push_u8(jpg2, 2)
  i = split
  while i < icc.length() {
    push_u8(jpg2, icc[i].to_int())
    i = i + 1
  }
  // Chunk 1 of 2 second
  push_u8(jpg2, 0xFF)
  push_u8(jpg2, 0xE2)
  push_u16_be(jpg2, 2 + 12 + 2 + split)
  push_str(jpg2, "ICC_PROFILE")
  push_u8(jpg2, 0)
  push_u8(jpg2, 1)
  push_u8(jpg2, 2)
  i = 0
  while i < split {
    push_u8(jpg2, icc[i].to_int())
    i = i + 1
  }
  push_u8(jpg2, 0xFF)
  push_u8(jpg2, 0xD9)

  match extract_jpeg_icc(to_bytes(jpg2)) {
    Ok(Some(extracted)) => {
      assert_eq_int(extracted.length(), icc.length(), "multi-seg jpeg icc len")
      match parse(extracted) {
        Ok(p) => assert_eq_str(p.description().unwrap_or(""), "Display P3", "multi-seg jpeg parsed")
        Err(e) => debug_assert(false, e.to_string())
      }
    }
    _ => debug_assert(false, "expected Some(icc) from multi-seg JPEG")
  }

  // 3. JPEG with no ICC -> Ok(None)
  let jpg_none = to_bytes([0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x04, 0x00, 0x00, 0xFF, 0xD9])
  match extract_jpeg_icc(jpg_none) {
    Ok(None) => ()
    _ => debug_assert(false, "expected Ok(None) for JPEG without ICC")
  }
}

test "container_webp_iccp_and_vp8x" {
  let icc = build_synthetic_display_p3()
  let odd_chunk : Array[Int] = [0xAA, 0xBB, 0xCC] // 3 bytes + 1 pad byte
  let riff_payload_len = 4 + (8 + 10) + (8 + 4) + (8 + icc.length())
  let webp : Array[Int] = []
  push_fourcc(webp, "RIFF")
  push_u32_le(webp, riff_payload_len.to_int64())
  push_fourcc(webp, "WEBP")
  // VP8X chunk (10 bytes)
  push_fourcc(webp, "VP8X")
  push_u32_le(webp, 10L)
  push_u8(webp, 0x20) // ICC flag
  let mut z = 0
  while z < 9 {
    push_u8(webp, 0)
    z = z + 1
  }
  // Odd-sized dummy chunk to verify even-byte padding
  push_fourcc(webp, "JUNK")
  push_u32_le(webp, 3L)
  let mut k = 0
  while k < odd_chunk.length() {
    push_u8(webp, odd_chunk[k])
    k = k + 1
  }
  push_u8(webp, 0) // padding byte
  // ICCP chunk
  push_fourcc(webp, "ICCP")
  push_u32_le(webp, icc.length().to_int64())
  k = 0
  while k < icc.length() {
    push_u8(webp, icc[k].to_int())
    k = k + 1
  }

  match extract_webp_icc(to_bytes(webp)) {
    Ok(Some(extracted)) => {
      assert_eq_int(extracted.length(), icc.length(), "webp icc len")
      match parse(extracted) {
        Ok(p) => assert_eq_str(p.description().unwrap_or(""), "Display P3", "webp icc parsed")
        Err(e) => debug_assert(false, e.to_string())
      }
    }
    _ => debug_assert(false, "expected Some(icc) from WebP")
  }
}

test "adversarial_dos_overflow_and_malformed_inputs" {
  // 1. Truncated prefixes of valid profile (0..131 bytes) -> Err, no panic
  let valid = build_synthetic_display_p3()
  let mut cut = 0
  while cut < 132 {
    match parse(valid.slice(0, cut)) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "truncated profile len=" + cut.to_string() + " must fail")
    }
    cut = cut + 1
  }

  // 2. Malicious tag_count = 0xFFFFFFFF -> Err, no OOM/panic
  let huge_tc : Array[Int] = []
  let mut i = 0
  while i < 128 {
    push_u8(huge_tc, valid[i].to_int())
    i = i + 1
  }
  // Patch profile_size = 132
  huge_tc[0] = 0
  huge_tc[1] = 0
  huge_tc[2] = 0
  huge_tc[3] = 132
  push_u32_be(huge_tc, 0xFFFFFFFFL)
  match parse(to_bytes(huge_tc)) {
    Err(IccError::InvalidTagTable(_)) => ()
    _ => debug_assert(false, "tag_count=0xFFFFFFFF must return InvalidTagTable")
  }

  // 3. offset + size 32-bit wraparound (offset = 144, size = 0xFFFFFF80) -> Err
  let wrap : Array[Int] = []
  i = 0
  while i < 128 {
    push_u8(wrap, valid[i].to_int())
    i = i + 1
  }
  wrap[0] = 0
  wrap[1] = 0
  wrap[2] = 0
  wrap[3] = 144
  push_u32_be(wrap, 1L) // 1 tag
  push_fourcc(wrap, "rXYZ")
  push_u32_be(wrap, 144L)
  push_u32_be(wrap, 0xFFFFFF80L)
  match parse(to_bytes(wrap)) {
    Err(IccError::InvalidTagTable(_)) => ()
    _ => debug_assert(false, "offset+size wraparound must return InvalidTagTable")
  }

  // 4. Invalid para func_type = 5 -> Err
  let bad_para = build_icc_profile(4, 0, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_para_tag(5, [2.2]))], [])
  match parse(bad_para) {
    Err(IccError::InvalidTag(_)) => ()
    _ => debug_assert(false, "para func_type=5 must fail")
  }

  // 5. CMYK profile -> parse Ok, Transform::to_srgb Err(UnsupportedProfile)
  let cmyk = build_icc_profile(2, 2, "prtr", "CMYK", "Lab ", 0, [("desc", make_desc_tag("CMYK"))], [])
  match parse(cmyk) {
    Ok(p) => {
      match Transform::to_srgb(p) {
        Err(IccError::UnsupportedProfile(_)) => ()
        _ => debug_assert(false, "CMYK transform must return UnsupportedProfile")
      }
    }
    Err(e) => debug_assert(false, "CMYK parse should succeed: " + e.to_string())
  }

  // 6. Malformed JPEG APP2: seq_no == 0, duplicate seq_no, missing chunk, mismatched total
  let jpg_seq0 = to_bytes([
    0xFF, 0xD8, 0xFF, 0xE2, 0x00, 0x11,
    0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0x00,
    0x00, 0x01, 0xAA,
    0xFF, 0xD9,
  ])
  match extract_jpeg_icc(jpg_seq0) {
    Err(IccError::InvalidContainer(_)) => ()
    _ => debug_assert(false, "JPEG seq_no=0 must fail")
  }
  let jpg_missing = to_bytes([
    0xFF, 0xD8, 0xFF, 0xE2, 0x00, 0x11,
    0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0x00,
    0x01, 0x02, 0xAA,
    0xFF, 0xD9,
  ])
  match extract_jpeg_icc(jpg_missing) {
    Err(IccError::InvalidContainer(_)) => ()
    _ => debug_assert(false, "JPEG missing chunk 2/2 must fail")
  }
  let jpg_dup = to_bytes([
    0xFF, 0xD8,
    0xFF, 0xE2, 0x00, 0x11,
    0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0x00,
    0x01, 0x02, 0xAA,
    0xFF, 0xE2, 0x00, 0x11,
    0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0x00,
    0x01, 0x02, 0xBB,
    0xFF, 0xD9,
  ])
  match extract_jpeg_icc(jpg_dup) {
    Err(IccError::InvalidContainer(_)) => ()
    _ => debug_assert(false, "JPEG duplicate seq_no must fail")
  }

  // 7. Out-of-bounds WebP ICCP chunk
  let bad_webp = to_bytes([
    0x52, 0x49, 0x46, 0x46, 0x10, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50,
    0x49, 0x43, 0x43, 0x50, 0xFF, 0x00, 0x00, 0x00, 0x01, 0x02,
  ])
  match extract_webp_icc(bad_webp) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "out-of-bounds WebP ICCP must fail")
  }

  // 8. Buffer length not multiple of 3 / 4 -> InvalidBuffer
  let p3 = match parse(valid) {
    Ok(p) => p
    Err(_) => return ()
  }
  let tf = match Transform::to_srgb(p3) {
    Ok(t) => t
    Err(_) => return ()
  }
  let bad_rgb : Array[Byte] = [0.to_byte(), 1.to_byte()]
  match tf.transform_rgb_in_place(bad_rgb) {
    Err(IccError::InvalidBuffer(_)) => ()
    _ => debug_assert(false, "non-multiple-of-3 RGB buffer must fail")
  }
  let bad_rgba : Array[Byte] = [0.to_byte(), 1.to_byte(), 2.to_byte()]
  match tf.transform_rgba_in_place(bad_rgba) {
    Err(IccError::InvalidBuffer(_)) => ()
    _ => debug_assert(false, "non-multiple-of-4 RGBA buffer must fail")
  }
}

test "extended_prophoto_rec2020_mluc_locale_and_edge_cases" {
  // 1. Rec.2020 (ITU-2020) v4 synthetic profile
  let trc_2020 = make_para_tag(3, [2.4, 1.0 / 1.055, 0.055 / 1.055, 1.0 / 12.92, 0.04045])
  let rec2020 = build_icc_profile(
    4,
    0,
    "mntr",
    "RGB ",
    "XYZ ",
    0,
    [
      ("desc", make_desc_tag("Rec.2020")),
      ("rXYZ", make_xyz_tag(0.673462, 0.279037, -0.001938)),
      ("gXYZ", make_xyz_tag(0.165665, 0.675339, 0.029984)),
      ("bXYZ", make_xyz_tag(0.125046, 0.045609, 0.796860)),
      ("rTRC", trc_2020),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
  match parse(rec2020) {
    Ok(p) => {
      assert_eq_bool(p.is_srgb_like(), false, "Rec.2020 not sRGB-like")
      match Transform::to_srgb(p) {
        Ok(tf) => {
          let (r, g, b) = tf.transform_rgb_pixel(128.to_byte(), 128.to_byte(), 128.to_byte())
          assert_near_u8(r.to_int(), 128, 1, "Rec.2020 gray r")
          assert_near_u8(g.to_int(), 128, 1, "Rec.2020 gray g")
          assert_near_u8(b.to_int(), 128, 1, "Rec.2020 gray b")
          // Empty buffers succeed
          let empty : Array[Byte] = []
          match tf.transform_rgb_in_place(empty) {
            Ok(_) => ()
            Err(e) => debug_assert(false, e.to_string())
          }
          match tf.transform_rgba_in_place(empty) {
            Ok(_) => ()
            Err(e) => debug_assert(false, e.to_string())
          }
        }
        Err(e) => debug_assert(false, e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }

  // 2. ProPhoto / ROMM RGB v4 synthetic profile (gamma 1.8 parametric type 3)
  let trc_romm = make_para_tag(3, [1.8, 1.0, 0.0, 1.0 / 16.0, 1.0 / 32.0])
  let romm = build_icc_profile(
    4,
    0,
    "mntr",
    "RGB ",
    "XYZ ",
    0,
    [
      ("desc", make_desc_tag("ROMM RGB")),
      ("rXYZ", make_xyz_tag(0.797668, 0.288040, 0.0)),
      ("gXYZ", make_xyz_tag(0.135193, 0.711884, 0.0)),
      ("bXYZ", make_xyz_tag(0.031342, 0.000092, 0.824905)),
      ("rTRC", trc_romm),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
  match parse(romm) {
    Ok(p) => {
      match Transform::to_srgb(p) {
        Ok(tf) => {
          let (r, g, b) = tf.transform_rgb_pixel(255.to_byte(), 255.to_byte(), 255.to_byte())
          assert_eq_int(r.to_int(), 255, "ROMM white r")
          assert_eq_int(g.to_int(), 255, "ROMM white g")
          assert_eq_int(b.to_int(), 255, "ROMM white b")
        }
        Err(e) => debug_assert(false, e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }

  // 3. mluc multi-locale preference (frFR first, enUS second -> picks enUS) + unpaired surrogate -> U+FFFD
  let mluc_multi : Array[Int] = []
  push_fourcc(mluc_multi, "mluc")
  push_u32_be(mluc_multi, 0L)
  push_u32_be(mluc_multi, 2L) // 2 records
  push_u32_be(mluc_multi, 12L)
  // Record 0: frFR "FR" at offset 40 (len 4)
  push_str(mluc_multi, "frFR")
  push_u32_be(mluc_multi, 4L)
  push_u32_be(mluc_multi, 40L)
  // Record 1: enUS "OK" at offset 44 (len 4)
  push_str(mluc_multi, "enUS")
  push_u32_be(mluc_multi, 4L)
  push_u32_be(mluc_multi, 44L)
  push_u16_be(mluc_multi, 0x46) // F
  push_u16_be(mluc_multi, 0x52) // R
  push_u16_be(mluc_multi, 0x4F) // O
  push_u16_be(mluc_multi, 0x4B) // K
  let p_mluc = build_icc_profile(4, 0, "mntr", "RGB ", "XYZ ", 0, [("desc", mluc_multi)], [])
  match parse(p_mluc) {
    Ok(p) => assert_eq_str(p.description().unwrap_or(""), "OK", "mluc prefers enUS over frFR")
    Err(e) => debug_assert(false, e.to_string())
  }

  // 4. WebP without ICCP chunk -> Ok(None)
  let webp_none = to_bytes([
    0x52, 0x49, 0x46, 0x46, 0x10, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50,
    0x56, 0x50, 0x38, 0x20, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  ])
  match extract_webp_icc(webp_none) {
    Ok(None) => ()
    _ => debug_assert(false, "WebP without ICCP must return Ok(None)")
  }

  // 5. JPEG mismatched total_count -> Err
  let jpg_mismatch = to_bytes([
    0xFF, 0xD8,
    0xFF, 0xE2, 0x00, 0x11,
    0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0x00,
    0x01, 0x02, 0xAA,
    0xFF, 0xE2, 0x00, 0x11,
    0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0x00,
    0x02, 0x03, 0xBB,
    0xFF, 0xD9,
  ])
  match extract_jpeg_icc(jpg_mismatch) {
    Err(IccError::InvalidContainer(_)) => ()
    _ => debug_assert(false, "JPEG mismatched total_count must fail")
  }
}

test "redteam_regressions_dup_tags_version_srgb_identity_a2b0_webp" {
  // 1. P0-1: duplicate tag signature rejected with InvalidTagTable
  let srgb_trc = make_para_tag(3, [2.4, 1.0 / 1.055, 0.055 / 1.055, 1.0 / 12.92, 0.04045])
  let dup_prof = build_icc_profile(
    4,
    0,
    "mntr",
    "RGB ",
    "XYZ ",
    0,
    [
      ("rXYZ", make_xyz_tag(0.515121, 0.241196, -0.001053)),
      ("gXYZ", make_xyz_tag(0.291977, 0.692245, 0.041885)),
      ("bXYZ", make_xyz_tag(0.157104, 0.066574, 0.784073)),
      ("rTRC", srgb_trc),
      ("rTRC", make_curv_identity()),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
  match parse(dup_prof) {
    Err(IccError::InvalidTagTable(_)) => ()
    _ => debug_assert(false, "duplicate tag signature must return InvalidTagTable")
  }

  // 2. P2-6: unsupported major version (v0, v5 iccMAX) rejected with InvalidHeader
  let v5_prof = build_icc_profile(5, 0, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_curv_identity())], [])
  match parse(v5_prof) {
    Err(IccError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "ICC v5 must return InvalidHeader")
  }
  let v0_prof = build_icc_profile(0, 0, "mntr", "GRAY", "XYZ ", 0, [("kTRC", make_curv_identity())], [])
  match parse(v0_prof) {
    Err(IccError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "ICC v0 must return InvalidHeader")
  }

  // 3. P2-1: is_srgb_like rejects 0.35% flare para4
  let flare_trc = make_para_tag(
    4,
    [2.4, 1.0 / 1.055, 0.055 / 1.055, 1.0 / 12.92, 0.04045, 0.0035, 0.0035],
  )
  let flare_prof = build_icc_profile(
    4,
    0,
    "mntr",
    "RGB ",
    "XYZ ",
    0,
    [
      ("rXYZ", make_xyz_tag(0.436066, 0.222488, 0.013916)),
      ("gXYZ", make_xyz_tag(0.385147, 0.716873, 0.097076)),
      ("bXYZ", make_xyz_tag(0.143066, 0.060608, 0.714096)),
      ("rTRC", flare_trc),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
  match parse(flare_prof) {
    Ok(p) => assert_eq_bool(p.is_srgb_like(), false, "0.35% flare must not be srgb-like")
    Err(e) => debug_assert(false, e.to_string())
  }

  // 4. P2-2: is_identity rejects +0.0019 off-diagonal leakage
  let leak_prof = build_icc_profile(
    4,
    0,
    "mntr",
    "RGB ",
    "XYZ ",
    0,
    [
      ("rXYZ", make_xyz_tag(0.4367977794799805, 0.22385005902099608, 0.014100445190429687)),
      ("gXYZ", make_xyz_tag(0.385147, 0.716873, 0.097076)),
      ("bXYZ", make_xyz_tag(0.143066, 0.060608, 0.714096)),
      ("rTRC", srgb_trc),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
  match parse(leak_prof) {
    Ok(p) =>
    match Transform::to_srgb(p) {
      Ok(tf) => {
        assert_eq_bool(tf.is_identity(), false, "0.0019 leakage must not hit identity fast path")
        let (_, g, _) = tf.transform_rgb_pixel(243.to_byte(), 0.to_byte(), 0.to_byte())
        assert_near_u8(g.to_int(), 6, 1, "0.0019 leakage green channel")
      }
      Err(e) => debug_assert(false, e.to_string())
    }
    Err(e) => debug_assert(false, e.to_string())
  }

  // 5. P2-3: A2B0 LUT + Matrix/TRC returns UnsupportedProfile
  let a2b0_dummy = [0x6D, 0x66, 0x74, 0x32, 0, 0, 0, 0, 3, 3, 2, 0]
  let a2b0_prof = build_icc_profile(
    4,
    0,
    "mntr",
    "RGB ",
    "XYZ ",
    0,
    [
      ("rXYZ", make_xyz_tag(0.515121, 0.241196, -0.001053)),
      ("gXYZ", make_xyz_tag(0.291977, 0.692245, 0.041885)),
      ("bXYZ", make_xyz_tag(0.157104, 0.066574, 0.784073)),
      ("rTRC", srgb_trc),
      ("A2B0", a2b0_dummy),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
  match parse(a2b0_prof) {
    Ok(p) =>
    match Transform::to_srgb(p) {
      Err(IccError::UnsupportedProfile(_)) => ()
      _ => debug_assert(false, "A2B0 profile must return UnsupportedProfile")
    }
    Err(e) => debug_assert(false, e.to_string())
  }

  // 6. P2-4: WebP ICCP without VP8X 0x20 flag returns Ok(None)
  let icc = build_synthetic_display_p3()
  let riff_len = 4 + (8 + 10) + (8 + icc.length())
  let webp_no_flag : Array[Int] = []
  push_fourcc(webp_no_flag, "RIFF")
  push_u32_le(webp_no_flag, riff_len.to_int64())
  push_fourcc(webp_no_flag, "WEBP")
  push_fourcc(webp_no_flag, "VP8X")
  push_u32_le(webp_no_flag, 10L)
  let mut z = 0
  while z < 10 {
    push_u8(webp_no_flag, 0) // flags = 0x00 (no 0x20 ICCP bit)
    z = z + 1
  }
  push_fourcc(webp_no_flag, "ICCP")
  push_u32_le(webp_no_flag, icc.length().to_int64())
  let mut k = 0
  while k < icc.length() {
    push_u8(webp_no_flag, icc[k].to_int())
    k = k + 1
  }
  match extract_webp_icc(to_bytes(webp_no_flag)) {
    Ok(None) => ()
    _ => debug_assert(false, "WebP ICCP without VP8X 0x20 flag must return Ok(None)")
  }
}
