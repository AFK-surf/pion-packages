///| ICC.1:2022 (v2 / v4) profile parser.
///| Overflow-safe tag table validation, `desc`/`mluc` (UTF-16BE with BMP & surrogate pairs),
///| `XYZ `, `sf32`, `curv`, and `para` (function types 0..4).

fn read_u16_be(data : Bytes, pos : Int) -> Int {
  (data[pos].to_int() << 8) | data[pos + 1].to_int()
}

fn read_u32_be(data : Bytes, pos : Int) -> Int64 {
  (data[pos].to_int().to_int64() << 24) |
  (data[pos + 1].to_int().to_int64() << 16) |
  (data[pos + 2].to_int().to_int64() << 8) |
  data[pos + 3].to_int().to_int64()
}

///| Decode ICC `s15Fixed16Number` (signed 32-bit two's complement / 65536.0).
fn read_s15fixed16(data : Bytes, pos : Int) -> Double {
  let u = read_u32_be(data, pos)
  let s = if u >= 0x80000000L { u - 0x100000000L } else { u }
  s.to_double() / 65536.0
}

///| Decode ICC `u8Fixed8Number` (unsigned 16-bit / 256.0).
fn read_u8fixed8(data : Bytes, pos : Int) -> Double {
  read_u16_be(data, pos).to_double() / 256.0
}

fn read_fourcc(data : Bytes, pos : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_byte(data[pos])
  sb.write_byte(data[pos + 1])
  sb.write_byte(data[pos + 2])
  sb.write_byte(data[pos + 3])
  sb.to_string()
}

fn parse_device_class(sig : String) -> DeviceClass {
  match sig {
    "scnr" => DeviceClass::Input
    "mntr" => DeviceClass::Display
    "prtr" => DeviceClass::Output
    "link" => DeviceClass::DeviceLink
    "spac" => DeviceClass::ColorSpace
    "abst" => DeviceClass::Abstract
    "nmcl" => DeviceClass::NamedColor
    _ => DeviceClass::Other(sig)
  }
}

fn parse_color_space(sig : String) -> ColorSpace {
  match sig {
    "RGB " => ColorSpace::Rgb
    "GRAY" => ColorSpace::Gray
    "CMYK" => ColorSpace::Cmyk
    "XYZ " => ColorSpace::Xyz
    "Lab " => ColorSpace::Lab
    _ => ColorSpace::Other(sig)
  }
}

fn write_utf8_codepoint(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0x10FFFF {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    // U+FFFD replacement character
    sb.write_byte(0xEF.to_byte())
    sb.write_byte(0xBF.to_byte())
    sb.write_byte(0xBD.to_byte())
  }
}

///| Decode a UTF-16BE byte slice into a UTF-8 Pion `String`, handling BMP and surrogate pairs.
fn decode_utf16be(data : Bytes, start : Int, byte_len : Int) -> String {
  let units = byte_len / 2
  // Strip trailing NUL code units
  let mut end_units = units
  while end_units > 0 {
    let u = read_u16_be(data, start + (end_units - 1) * 2)
    if u == 0 {
      end_units = end_units - 1
    } else {
      break
    }
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < end_units {
    let u1 = read_u16_be(data, start + i * 2)
    if u1 >= 0xD800 && u1 <= 0xDBFF {
      if i + 1 < end_units {
        let u2 = read_u16_be(data, start + (i + 1) * 2)
        if u2 >= 0xDC00 && u2 <= 0xDFFF {
          let cp = 0x10000 + ((u1 - 0xD800) << 10) + (u2 - 0xDC00)
          write_utf8_codepoint(sb, cp)
          i = i + 2
          continue
        }
      }
      // Unpaired high surrogate -> U+FFFD
      write_utf8_codepoint(sb, 0xFFFD)
      i = i + 1
    } else if u1 >= 0xDC00 && u1 <= 0xDFFF {
      // Unpaired low surrogate -> U+FFFD
      write_utf8_codepoint(sb, 0xFFFD)
      i = i + 1
    } else {
      write_utf8_codepoint(sb, u1)
      i = i + 1
    }
  }
  sb.to_string()
}

fn parse_desc_tag(data : Bytes, off : Int, size : Int) -> Result[String, IccError] {
  if size < 12 {
    return Err(IccError::InvalidTag("desc tag shorter than 12 bytes"))
  }
  let ascii_count = read_u32_be(data, off + 8)
  if ascii_count > (size - 12).to_int64() {
    return Err(IccError::InvalidTag("desc ASCII count exceeds tag size"))
  }
  let mut len = ascii_count.to_int()
  while len > 0 && data[off + 12 + len - 1].to_int() == 0 {
    len = len - 1
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let b = data[off + 12 + i].to_int()
    if b == 0 {
      break
    }
    sb.write_byte(b.to_byte())
    i = i + 1
  }
  Ok(sb.to_string())
}

fn parse_mluc_tag(data : Bytes, off : Int, size : Int) -> Result[String, IccError] {
  if size < 16 {
    return Err(IccError::InvalidTag("mluc tag shorter than 16 bytes"))
  }
  let record_count = read_u32_be(data, off + 8)
  let record_size = read_u32_be(data, off + 12)
  if record_count > max_mluc_records.to_int64() {
    return Err(IccError::InvalidTag("mluc record count exceeds limit"))
  }
  if record_count == 0L {
    return Ok("")
  }
  if record_size < 12L {
    return Err(IccError::InvalidTag("mluc record size < 12"))
  }
  let size64 = size.to_int64()
  let table_bytes = record_count * record_size
  if table_bytes > size64 - 16L {
    return Err(IccError::InvalidTag("mluc record table exceeds tag size"))
  }

  let mut best_rank = -1
  let mut best_off = 0
  let mut best_len = 0
  let count = record_count.to_int()
  let rsize = record_size.to_int()
  let mut i = 0
  while i < count {
    let rec = off + 16 + i * rsize
    let lang0 = data[rec].to_int()
    let lang1 = data[rec + 1].to_int()
    let ctry0 = data[rec + 2].to_int()
    let ctry1 = data[rec + 3].to_int()
    let str_len = read_u32_be(data, rec + 4)
    let str_off = read_u32_be(data, rec + 8)
    if str_off > size64 || str_len > size64 - str_off {
      return Err(IccError::InvalidTag("mluc string slice out of bounds"))
    }
    let rank = if lang0 == 0x65 && lang1 == 0x6E && ctry0 == 0x55 && ctry1 == 0x53 {
      // enUS
      2
    } else if lang0 == 0x65 && lang1 == 0x6E {
      // en*
      1
    } else {
      0
    }
    if rank > best_rank {
      best_rank = rank
      best_off = off + str_off.to_int()
      best_len = str_len.to_int()
    }
    i = i + 1
  }
  if best_rank < 0 {
    return Ok("")
  }
  Ok(decode_utf16be(data, best_off, best_len))
}

fn parse_xyz_tag(data : Bytes, off : Int, size : Int) -> Result[Xyz, IccError] {
  if size < 20 {
    return Err(IccError::InvalidTag("XYZ tag shorter than 20 bytes"))
  }
  if read_fourcc(data, off) != "XYZ " {
    return Err(IccError::InvalidTag("expected 'XYZ ' type signature"))
  }
  Ok(
    Xyz::new(
      read_s15fixed16(data, off + 8),
      read_s15fixed16(data, off + 12),
      read_s15fixed16(data, off + 16),
    ),
  )
}

fn parse_sf32_matrix(data : Bytes, off : Int, size : Int) -> Result[Matrix3x3, IccError] {
  if size < 44 {
    return Err(IccError::InvalidTag("chad sf32 tag shorter than 44 bytes"))
  }
  if read_fourcc(data, off) != "sf32" {
    return Err(IccError::InvalidTag("expected 'sf32' type signature for chad"))
  }
  Ok(
    Matrix3x3::new(
      read_s15fixed16(data, off + 8),
      read_s15fixed16(data, off + 12),
      read_s15fixed16(data, off + 16),
      read_s15fixed16(data, off + 20),
      read_s15fixed16(data, off + 24),
      read_s15fixed16(data, off + 28),
      read_s15fixed16(data, off + 32),
      read_s15fixed16(data, off + 36),
      read_s15fixed16(data, off + 40),
    ),
  )
}

fn parse_trc_tag(data : Bytes, off : Int, size : Int) -> Result[ToneCurve, IccError] {
  if size < 12 {
    return Err(IccError::InvalidTag("TRC tag shorter than 12 bytes"))
  }
  let sig = read_fourcc(data, off)
  if sig == "curv" {
    let count = read_u32_be(data, off + 8)
    if count == 0L {
      return Ok(ToneCurve::Identity)
    }
    if count == 1L {
      if size < 14 {
        return Err(IccError::InvalidTag("curv gamma tag shorter than 14 bytes"))
      }
      return Ok(ToneCurve::Gamma(read_u8fixed8(data, off + 12)))
    }
    if count > max_curve_entries.to_int64() {
      return Err(IccError::InvalidTag("curv entry count exceeds limit"))
    }
    if count * 2L > (size - 12).to_int64() {
      return Err(IccError::InvalidTag("curv table truncated"))
    }
    let n = count.to_int()
    let entries : Array[Int] = []
    let mut i = 0
    while i < n {
      entries.push(read_u16_be(data, off + 12 + i * 2))
      i = i + 1
    }
    return Ok(ToneCurve::Table(entries))
  }
  if sig == "para" {
    let func_type = read_u16_be(data, off + 8)
    let min_size = match func_type {
      0 => 16
      1 => 24
      2 => 28
      3 => 32
      4 => 40
      _ =>
      return Err(
        IccError::InvalidTag(
          "unsupported parametricCurveType function type " + func_type.to_string(),
        ),
      )
    }
    if size < min_size {
      return Err(
        IccError::InvalidTag(
          "parametricCurveType type " + func_type.to_string() + " truncated",
        ),
      )
    }
    let g = read_s15fixed16(data, off + 12)
    let a = if func_type >= 1 { read_s15fixed16(data, off + 16) } else { 0.0 }
    let b = if func_type >= 1 { read_s15fixed16(data, off + 20) } else { 0.0 }
    let c = if func_type >= 2 { read_s15fixed16(data, off + 24) } else { 0.0 }
    let d = if func_type >= 3 { read_s15fixed16(data, off + 28) } else { 0.0 }
    let e = if func_type >= 4 { read_s15fixed16(data, off + 32) } else { 0.0 }
    let f = if func_type >= 4 { read_s15fixed16(data, off + 36) } else { 0.0 }
    return Ok(ToneCurve::Parametric(func_type, g, a, b, c, d, e, f))
  }
  Err(IccError::InvalidTag("unexpected TRC tag type '" + sig + "'"))
}

///| Parse an ICC v2 or v4 color profile from raw bytes.
pub fn parse(data : Bytes) -> Result[Profile, IccError] {
  let n = data.length()
  if n < 128 {
    return Err(IccError::UnexpectedEof("ICC profile shorter than 128-byte header"))
  }
  let profile_size64 = read_u32_be(data, 0)
  if profile_size64 < 128L {
    return Err(IccError::InvalidHeader("declared profile size < 128"))
  }
  if profile_size64 > n.to_int64() {
    return Err(IccError::UnexpectedEof("declared profile size exceeds input length"))
  }
  let profile_size = profile_size64.to_int()

  // Magic signature 'acsp' at bytes 36..40
  if read_fourcc(data, 36) != "acsp" {
    return Err(IccError::InvalidHeader("missing 'acsp' magic signature"))
  }

  let cmm_type = read_fourcc(data, 4)
  let ver_major = data[8].to_int()
  let ver_minor_byte = data[9].to_int()
  let version = Version::{
    major: ver_major,
    minor: (ver_minor_byte >> 4) & 0x0F,
    bugfix: ver_minor_byte & 0x0F,
  }
  let device_class = parse_device_class(read_fourcc(data, 12))
  let color_space = parse_color_space(read_fourcc(data, 16))
  let pcs = parse_color_space(read_fourcc(data, 20))
  let created = DateTime::{
    year: read_u16_be(data, 24),
    month: read_u16_be(data, 26),
    day: read_u16_be(data, 28),
    hour: read_u16_be(data, 30),
    minute: read_u16_be(data, 32),
    second: read_u16_be(data, 34),
  }
  let platform = read_fourcc(data, 40)
  let flags = read_u32_be(data, 44)
  let device_manufacturer = read_fourcc(data, 48)
  let device_model = read_fourcc(data, 52)

  let intent_raw = read_u32_be(data, 64)
  let rendering_intent = if intent_raw == 0L {
    RenderingIntent::Perceptual
  } else if intent_raw == 1L {
    RenderingIntent::RelativeColorimetric
  } else if intent_raw == 2L {
    RenderingIntent::Saturation
  } else if intent_raw == 3L {
    RenderingIntent::AbsoluteColorimetric
  } else {
    return Err(
      IccError::InvalidHeader("invalid rendering intent " + intent_raw.to_string()),
    )
  }

  let pcs_illuminant = Xyz::new(
    read_s15fixed16(data, 68),
    read_s15fixed16(data, 72),
    read_s15fixed16(data, 76),
  )
  let creator = read_fourcc(data, 80)
  let profile_id = data.slice(84, 100)

  // Tag table starts at offset 128
  if profile_size < 132 {
    return Err(IccError::UnexpectedEof("missing tag count at offset 128"))
  }
  let tag_count64 = read_u32_be(data, 128)
  if tag_count64 > max_tag_count.to_int64() {
    return Err(
      IccError::InvalidTagTable(
        "tag_count " + tag_count64.to_string() + " exceeds limit " + max_tag_count.to_string(),
      ),
    )
  }
  if 132L + tag_count64 * 12L > profile_size64 {
    return Err(IccError::InvalidTagTable("tag table exceeds profile size"))
  }

  let tag_count = tag_count64.to_int()
  let tags : Array[TagRecord] = []
  let mut description : Option[String] = None
  let mut red_xyz : Option[Xyz] = None
  let mut green_xyz : Option[Xyz] = None
  let mut blue_xyz : Option[Xyz] = None
  let mut white_point : Option[Xyz] = None
  let mut black_point : Option[Xyz] = None
  let mut chad : Option[Matrix3x3] = None
  let mut red_trc : Option[ToneCurve] = None
  let mut green_trc : Option[ToneCurve] = None
  let mut blue_trc : Option[ToneCurve] = None
  let mut gray_trc : Option[ToneCurve] = None

  let mut i = 0
  while i < tag_count {
    let rec_pos = 132 + i * 12
    let sig = read_fourcc(data, rec_pos)
    let off64 = read_u32_be(data, rec_pos + 4)
    let sz64 = read_u32_be(data, rec_pos + 8)
    // Overflow-safe bounds checks: never compute off64 + sz64 in 32-bit
    if off64 < 128L || sz64 <= 0L || off64 > profile_size64 || sz64 > profile_size64 - off64 {
      return Err(
        IccError::InvalidTagTable(
          "tag '" + sig + "' offset/size out of bounds",
        ),
      )
    }
    let off = off64.to_int()
    let sz = sz64.to_int()
    tags.push(TagRecord::{ signature: sig, offset: off, size: sz })

    if sig == "desc" {
      if sz >= 4 {
        let ttype = read_fourcc(data, off)
        if ttype == "desc" {
          match parse_desc_tag(data, off, sz) {
            Ok(s) => description = Some(s)
            Err(e) => return Err(e)
          }
        } else if ttype == "mluc" {
          match parse_mluc_tag(data, off, sz) {
            Ok(s) => description = Some(s)
            Err(e) => return Err(e)
          }
        }
      }
    } else if sig == "rXYZ" {
      match parse_xyz_tag(data, off, sz) {
        Ok(v) => red_xyz = Some(v)
        Err(e) => return Err(e)
      }
    } else if sig == "gXYZ" {
      match parse_xyz_tag(data, off, sz) {
        Ok(v) => green_xyz = Some(v)
        Err(e) => return Err(e)
      }
    } else if sig == "bXYZ" {
      match parse_xyz_tag(data, off, sz) {
        Ok(v) => blue_xyz = Some(v)
        Err(e) => return Err(e)
      }
    } else if sig == "wtpt" {
      match parse_xyz_tag(data, off, sz) {
        Ok(v) => white_point = Some(v)
        Err(e) => return Err(e)
      }
    } else if sig == "bkpt" {
      match parse_xyz_tag(data, off, sz) {
        Ok(v) => black_point = Some(v)
        Err(e) => return Err(e)
      }
    } else if sig == "chad" {
      match parse_sf32_matrix(data, off, sz) {
        Ok(m) => chad = Some(m)
        Err(e) => return Err(e)
      }
    } else if sig == "rTRC" {
      match parse_trc_tag(data, off, sz) {
        Ok(c) => red_trc = Some(c)
        Err(e) => return Err(e)
      }
    } else if sig == "gTRC" {
      match parse_trc_tag(data, off, sz) {
        Ok(c) => green_trc = Some(c)
        Err(e) => return Err(e)
      }
    } else if sig == "bTRC" {
      match parse_trc_tag(data, off, sz) {
        Ok(c) => blue_trc = Some(c)
        Err(e) => return Err(e)
      }
    } else if sig == "kTRC" {
      match parse_trc_tag(data, off, sz) {
        Ok(c) => gray_trc = Some(c)
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }

  Ok(
    Profile::{
      profile_size: profile_size,
      cmm_type: cmm_type,
      version: version,
      device_class: device_class,
      color_space: color_space,
      pcs: pcs,
      created: created,
      platform: platform,
      flags: flags,
      device_manufacturer: device_manufacturer,
      device_model: device_model,
      rendering_intent: rendering_intent,
      pcs_illuminant: pcs_illuminant,
      creator: creator,
      profile_id: profile_id,
      tags: tags,
      description: description,
      red_xyz: red_xyz,
      green_xyz: green_xyz,
      blue_xyz: blue_xyz,
      white_point: white_point,
      black_point: black_point,
      chad: chad,
      red_trc: red_trc,
      green_trc: green_trc,
      blue_trc: blue_trc,
      gray_trc: gray_trc,
    },
  )
}

fn curve_is_srgb_like(curve : ToneCurve) -> Bool {
  let mut i = 0
  while i < 256 {
    let x = i.to_double() / 255.0
    let y = eval_tone_curve(curve, x)
    let ref_y = srgb_eotf(x)
    if f64_abs(y - ref_y) > 0.004 {
      return false
    }
    i = i + 8
  }
  true
}

///| Return whether `profile` is effectively equivalent to sRGB IEC61966-2.1.
pub fn is_srgb_like(profile : Profile) -> Bool {
  match (profile.color_space, profile.pcs) {
    (ColorSpace::Rgb, ColorSpace::Xyz) => ()
    _ => return false
  }
  let src_m = match profile.matrix() {
    Some(m) => m
    None => return false
  }
  let (rt, gt, bt) = match (profile.red_trc, profile.green_trc, profile.blue_trc) {
    (Some(r), Some(g), Some(b)) => (r, g, b)
    _ => return false
  }
  let m = mat3_mul(xyz_d50_to_srgb_linear(), src_m)
  let eps = 0.005
  if f64_abs(m.m00 - 1.0) > eps ||
  f64_abs(m.m01) > eps ||
  f64_abs(m.m02) > eps ||
  f64_abs(m.m10) > eps ||
  f64_abs(m.m11 - 1.0) > eps ||
  f64_abs(m.m12) > eps ||
  f64_abs(m.m20) > eps ||
  f64_abs(m.m21) > eps ||
  f64_abs(m.m22 - 1.0) > eps {
    return false
  }
  curve_is_srgb_like(rt) && curve_is_srgb_like(gt) && curve_is_srgb_like(bt)
}

///| Method wrapper for `is_srgb_like`.
pub fn Profile::is_srgb_like(self : Profile) -> Bool {
  is_srgb_like(self)
}
