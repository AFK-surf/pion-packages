///| Zero-dependency JPEG APP2 (`ICC_PROFILE\0`) and WebP RIFF (`ICCP`) ICC extractor.

fn match_bytes4(data : Bytes, pos : Int, a : Int, b : Int, c : Int, d : Int) -> Bool {
  data[pos].to_int() == a &&
  data[pos + 1].to_int() == b &&
  data[pos + 2].to_int() == c &&
  data[pos + 3].to_int() == d
}

fn match_icc_profile_prefix(data : Bytes, pos : Int) -> Bool {
  // "ICC_PROFILE\0" (12 bytes)
  data[pos].to_int() == 0x49 &&
  data[pos + 1].to_int() == 0x43 &&
  data[pos + 2].to_int() == 0x43 &&
  data[pos + 3].to_int() == 0x5F &&
  data[pos + 4].to_int() == 0x50 &&
  data[pos + 5].to_int() == 0x52 &&
  data[pos + 6].to_int() == 0x4F &&
  data[pos + 7].to_int() == 0x46 &&
  data[pos + 8].to_int() == 0x49 &&
  data[pos + 9].to_int() == 0x4C &&
  data[pos + 10].to_int() == 0x45 &&
  data[pos + 11].to_int() == 0x00
}

///| Extract an embedded ICC profile from a JPEG byte stream.
///| Supports single-segment zero-copy `Bytes::slice` and out-of-order multi-segment reassembly.
pub fn extract_jpeg_icc(data : Bytes) -> Result[Option[Bytes], IccError] {
  let n = data.length()
  if n < 2 {
    return Err(IccError::InvalidContainer("JPEG shorter than 2 bytes"))
  }
  if data[0].to_int() != 0xFF || data[1].to_int() != 0xD8 {
    return Err(IccError::InvalidContainer("missing JPEG SOI marker (0xFFD8)"))
  }

  let mut expected_total = 0
  let mut seen_count = 0
  let chunk_starts : FixedArray[Int] = FixedArray::make(256, -1)
  let chunk_lens : FixedArray[Int] = FixedArray::make(256, 0)

  let mut pos = 2
  while pos < n {
    // Resynchronize to next 0xFF marker prefix before SOS
    while pos < n && data[pos].to_int() != 0xFF {
      pos = pos + 1
    }
    if pos >= n {
      break
    }
    // Skip any number of 0xFF fill bytes
    while pos < n && data[pos].to_int() == 0xFF {
      pos = pos + 1
    }
    if pos >= n {
      return Err(IccError::InvalidContainer("truncated JPEG marker"))
    }
    let marker = data[pos].to_int()
    pos = pos + 1

    // Stop at SOS (0xDA) or EOI (0xD9)
    if marker == 0xD9 || marker == 0xDA {
      break
    }
    // Standalone markers without length: 0x00, TEM (0x01), RST0..RST7 (0xD0..0xD7), SOI (0xD8)
    if marker == 0x00 || marker == 0x01 || (marker >= 0xD0 && marker <= 0xD8) {
      continue
    }
    if n - pos < 2 {
      return Err(IccError::InvalidContainer("truncated JPEG segment length"))
    }
    let seg_len = (data[pos].to_int() << 8) | data[pos + 1].to_int()
    if seg_len < 2 {
      return Err(IccError::InvalidContainer("JPEG segment length < 2"))
    }
    let payload_len = seg_len - 2
    let payload_start = pos + 2
    if payload_len > n - payload_start {
      return Err(IccError::InvalidContainer("truncated JPEG segment payload"))
    }

    if marker == 0xE2 && payload_len >= 14 && match_icc_profile_prefix(data, payload_start) {
      let seq_no = data[payload_start + 12].to_int()
      let total_count = data[payload_start + 13].to_int()
      if total_count == 0 || seq_no == 0 || seq_no > total_count {
        return Err(
          IccError::InvalidContainer(
            "invalid JPEG ICC chunk sequence " +
            seq_no.to_string() +
            "/" +
            total_count.to_string(),
          ),
        )
      }
      if expected_total == 0 {
        expected_total = total_count
      } else if expected_total != total_count {
        return Err(
          IccError::InvalidContainer("inconsistent JPEG ICC total chunk count"),
        )
      }
      if chunk_starts[seq_no] != -1 {
        return Err(
          IccError::InvalidContainer(
            "duplicate JPEG ICC chunk sequence " + seq_no.to_string(),
          ),
        )
      }
      chunk_starts[seq_no] = payload_start + 14
      chunk_lens[seq_no] = payload_len - 14
      seen_count = seen_count + 1
    }

    pos = payload_start + payload_len
  }

  if expected_total == 0 {
    return Ok(None)
  }
  if seen_count != expected_total {
    return Err(
      IccError::InvalidContainer(
        "incomplete JPEG ICC chunks: got " +
        seen_count.to_string() +
        " of " +
        expected_total.to_string(),
      ),
    )
  }
  if expected_total == 1 {
    let start = chunk_starts[1]
    let len = chunk_lens[1]
    return Ok(Some(data.slice(start, start + len)))
  }

  let mut total_bytes = 0
  let mut seq = 1
  while seq <= expected_total {
    if chunk_starts[seq] == -1 {
      return Err(IccError::InvalidContainer("missing JPEG ICC chunk " + seq.to_string()))
    }
    total_bytes = total_bytes + chunk_lens[seq]
    seq = seq + 1
  }
  let out = Bytes::new(total_bytes)
  let mut dst = 0
  seq = 1
  while seq <= expected_total {
    let src = chunk_starts[seq]
    let len = chunk_lens[seq]
    let mut k = 0
    while k < len {
      out[dst + k] = data[src + k]
      k = k + 1
    }
    dst = dst + len
    seq = seq + 1
  }
  Ok(Some(out))
}

///| Extract an embedded ICC profile from a WebP RIFF container (`ICCP` chunk).
///| Zero-copy `Bytes::slice` on the input buffer.
pub fn extract_webp_icc(data : Bytes) -> Result[Option[Bytes], IccError] {
  let n = data.length()
  if n < 12 {
    return Err(IccError::InvalidContainer("WebP shorter than 12 bytes"))
  }
  if !match_bytes4(data, 0, 0x52, 0x49, 0x46, 0x46) {
    return Err(IccError::InvalidContainer("missing RIFF magic"))
  }
  if !match_bytes4(data, 8, 0x57, 0x45, 0x42, 0x50) {
    return Err(IccError::InvalidContainer("missing WEBP form type"))
  }
  let riff_size : Int64 = data[4].to_int().to_int64() |
  (data[5].to_int().to_int64() << 8) |
  (data[6].to_int().to_int64() << 16) |
  (data[7].to_int().to_int64() << 24)
  if riff_size < 4L {
    return Err(IccError::InvalidContainer("RIFF size < 4"))
  }
  let n64 = n.to_int64()
  let declared_end = 8L + riff_size
  let limit_end = if declared_end < n64 { declared_end } else { n64 }

  let mut pos = 12L
  let mut first_chunk = true
  while pos + 8L <= limit_end {
    let p = pos.to_int()
    let chunk_size : Int64 = data[p + 4].to_int().to_int64() |
    (data[p + 5].to_int().to_int64() << 8) |
    (data[p + 6].to_int().to_int64() << 16) |
    (data[p + 7].to_int().to_int64() << 24)
    let payload_start = pos + 8L
    if chunk_size > limit_end - payload_start {
      return Err(IccError::InvalidContainer("truncated WebP chunk"))
    }
    if first_chunk {
      first_chunk = false
      // Per WebP container spec and libwebp demux: ICCP is only valid in extended format
      // when the first chunk is "VP8X" (>= 10 bytes) with the ICCP flag bit (0x20) set.
      if !match_bytes4(data, p, 0x56, 0x50, 0x38, 0x58) {
        return Ok(None)
      }
      if chunk_size < 10L {
        return Ok(None)
      }
      let vp8x_flags = data[payload_start.to_int()].to_int()
      if (vp8x_flags & 0x20) == 0 {
        return Ok(None)
      }
      let pad = chunk_size & 1L
      pos = payload_start + chunk_size + pad
      continue
    }
    // "ICCP"
    if match_bytes4(data, p, 0x49, 0x43, 0x43, 0x50) {
      let start = payload_start.to_int()
      let len = chunk_size.to_int()
      return Ok(Some(data.slice(start, start + len)))
    }
    let pad = chunk_size & 1L
    pos = payload_start + chunk_size + pad
  }
  Ok(None)
}
