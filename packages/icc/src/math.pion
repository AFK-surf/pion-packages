///| Pure-Pion IEEE-754 math, colorimetry matrices, and sRGB / ICC TRC evaluation.
///| Zero `extern "C"`, zero `World`, zero mutable globals.

fn f64_is_finite(x : Double) -> Bool {
  x == x && x != 1.0 / 0.0 && x != -1.0 / 0.0
}

fn f64_abs(x : Double) -> Double {
  if x < 0.0 {
    -x
  } else {
    x
  }
}

fn f64_clamp01(x : Double) -> Double {
  if x <= 0.0 || x != x {
    0.0
  } else if x >= 1.0 {
    1.0
  } else {
    x
  }
}

fn f64_floor(x : Double) -> Double {
  if !f64_is_finite(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let t = x.to_int64().to_double()
  if t > x {
    t - 1.0
  } else {
    t
  }
}

fn f64_trunc(x : Double) -> Double {
  if !f64_is_finite(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  x.to_int64().to_double()
}

fn f64_ln(x : Double) -> Double {
  if x != x || x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return -1.0 / 0.0
  }
  if x == 1.0 / 0.0 {
    return 1.0 / 0.0
  }
  let ln2 = 0.693147180559945309417232121458176568
  let mut m = x
  let mut k = 0
  while m >= 1.4142135623730951 {
    m = m * 0.5
    k = k + 1
  }
  while m < 0.7071067811865476 {
    m = m * 2.0
    k = k - 1
  }
  let t = (m - 1.0) / (m + 1.0)
  let t2 = t * t
  let poly = 1.0 +
  t2 * (
    0.3333333333333333 +
    t2 * (
      0.2 +
      t2 * (
        0.14285714285714285 +
        t2 * (
          0.1111111111111111 +
          t2 * (
            0.09090909090909091 +
            t2 * (0.07692307692307693 + t2 * 0.06666666666666667)
          )
        )
      )
    )
  )
  2.0 * t * poly + k.to_double() * ln2
}

fn f64_exp(x : Double) -> Double {
  if x != x {
    return x
  }
  if x > 709.782712893384 {
    return 1.0 / 0.0
  }
  if x < -745.1332191019412 {
    return 0.0
  }
  let ln2 = 0.693147180559945309417232121458176568
  let ln2_hi = 0.693147180369123816490
  let ln2_lo = 1.90821492927058770002e-10
  let kf = f64_floor(x / ln2 + 0.5)
  let k = kf.to_int64().to_int()
  let r = (x - kf * ln2_hi) - kf * ln2_lo
  let mut res = 1.0 +
  r * (
    1.0 +
    r * (
      0.5 +
      r * (
        0.16666666666666666 +
        r * (
          0.041666666666666664 +
          r * (
            0.008333333333333333 +
            r * (
              0.001388888888888889 +
              r * (
                0.0001984126984126984 +
                r * (
                  0.0000248015873015873 +
                  r * (
                    0.0000027557319223985893 +
                    r * (0.0000002755731922398589 + r * 0.00000002505210838544172)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  if k > 0 {
    let mut rem = k
    let mut base = 2.0
    while rem > 0 {
      if (rem & 1) != 0 {
        res = res * base
      }
      rem = rem >> 1
      if rem > 0 {
        base = base * base
      }
    }
  } else if k < 0 {
    let mut rem = -k
    let mut base = 0.5
    while rem > 0 {
      if (rem & 1) != 0 {
        res = res * base
      }
      rem = rem >> 1
      if rem > 0 {
        base = base * base
      }
    }
  }
  res
}

fn f64_pow(x : Double, y : Double) -> Double {
  if y == 0.0 {
    return 1.0
  }
  if x == 1.0 {
    return 1.0
  }
  if x != x || y != y {
    return 0.0 / 0.0
  }
  if f64_is_finite(y) && y == f64_trunc(y) && y >= -1074.0 && y <= 1074.0 {
    let mut exp_i = y.to_int64().to_int()
    let neg_exp = exp_i < 0
    if neg_exp {
      exp_i = -exp_i
    }
    let mut base = x
    let mut acc = 1.0
    while exp_i > 0 {
      if (exp_i & 1) != 0 {
        acc = acc * base
      }
      exp_i = exp_i >> 1
      if exp_i > 0 {
        base = base * base
      }
    }
    return if neg_exp { 1.0 / acc } else { acc }
  }
  if x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return if y > 0.0 { 0.0 } else { 1.0 / 0.0 }
  }
  f64_exp(y * f64_ln(x))
}

///| Fast `x^y` for `x in (0, 1]` and finite `y` (relative error < 1e-7, >100x tighter than Q14).
///| Pure IEEE-754 bit manipulation — zero range-reduction loops, 100% deterministic across Native & Wasm32.
fn f64_pow_unit_fast(x : Double, y : Double) -> Double {
  if y == 0.0 || x == 1.0 {
    return 1.0
  }
  if x < 1.0e-300 {
    return if y > 0.0 { 0.0 } else { 1.0 }
  }
  let bits = x.to_bits()
  let mut k = ((bits >> 52) & 0x7FFL) - 1023L
  let mut m = Double::from_bits((bits & 0x000FFFFFFFFFFFFFL) | 0x3FF0000000000000L)
  if m >= 1.4142135623730951 {
    m = m * 0.5
    k = k + 1L
  }
  let t = (m - 1.0) / (m + 1.0)
  let t2 = t * t
  let ln_x = 2.0 * t * (1.0 + t2 * (0.3333333333333333 + t2 * (0.2 + t2 * 0.14285714285714285))) +
  k.to_double() * 0.6931471805599453
  let z = y * ln_x
  if z < -30.0 {
    return 0.0
  }
  if z > 30.0 {
    return 1.0
  }
  let s = z * 1.4426950408889634
  let ek = (if s >= 0.0 { s + 0.5 } else { s - 0.5 }).to_int64()
  let r = z - ek.to_double() * 0.6931471805599453
  let poly = 1.0 +
  r * (
    1.0 +
    r * (
      0.5 +
      r * (
        0.16666666666666666 +
        r * (0.041666666666666664 + r * (0.008333333333333333 + r * 0.001388888888888889))
      )
    )
  )
  Double::from_bits((ek + 1023L) << 52) * poly
}

fn round_to_int(x : Double) -> Int {
  if x >= 0.0 {
    (x + 0.5).to_int64().to_int()
  } else {
    (x - 0.5).to_int64().to_int()
  }
}

///| Multiply two 3x3 matrices `a * b`.
fn mat3_mul(a : Matrix3x3, b : Matrix3x3) -> Matrix3x3 {
  Matrix3x3::new(
    a.m00 * b.m00 + a.m01 * b.m10 + a.m02 * b.m20,
    a.m00 * b.m01 + a.m01 * b.m11 + a.m02 * b.m21,
    a.m00 * b.m02 + a.m01 * b.m12 + a.m02 * b.m22,
    a.m10 * b.m00 + a.m11 * b.m10 + a.m12 * b.m20,
    a.m10 * b.m01 + a.m11 * b.m11 + a.m12 * b.m21,
    a.m10 * b.m02 + a.m11 * b.m12 + a.m12 * b.m22,
    a.m20 * b.m00 + a.m21 * b.m10 + a.m22 * b.m20,
    a.m20 * b.m01 + a.m21 * b.m11 + a.m22 * b.m21,
    a.m20 * b.m02 + a.m21 * b.m12 + a.m22 * b.m22,
  )
}

///| Combined ICC PCS XYZ (D50: 0.96420288, 1.0, 0.82490540) -> linear sRGB (D65) matrix.
///| Inverse of the s15Fixed16-rounded Bradford-adapted sRGB D50 colorants (within 3.7e-4 of exact Bradford
///| inverse) so standard sRGB ICC profiles map cleanly to the identity matrix.
fn xyz_d50_to_srgb_linear() -> Matrix3x3 {
  Matrix3x3::new(
    3.134112153323845, -1.6173924595518705, -0.49063340456472027,
    -0.9787872961391832, 1.9162795864266209, 0.03345471423138195,
    0.07198304438569493, -0.22898585024754495, 1.4053851315844992,
  )
}

///| Standard sRGB EOTF (encoded [0, 1] -> linear [0, 1]).
fn srgb_eotf(x : Double) -> Double {
  let c = f64_clamp01(x)
  if c <= 0.04045 {
    c / 12.92
  } else {
    f64_pow((c + 0.055) / 1.055, 2.4)
  }
}

///| Standard sRGB OETF (linear [0, 1] -> encoded [0, 1]).
fn srgb_oetf(x : Double) -> Double {
  let c = f64_clamp01(x)
  if c <= 0.0031308 {
    12.92 * c
  } else {
    1.055 * f64_pow(c, 1.0 / 2.4) - 0.055
  }
}

///| Evaluate an ICC `ToneCurve` at normalized input `x` in `[0.0, 1.0]`.
fn eval_tone_curve(curve : ToneCurve, x : Double) -> Double {
  let v = f64_clamp01(x)
  match curve {
    ToneCurve::Identity => v
    ToneCurve::Gamma(g) => {
      if g <= 0.0 || !f64_is_finite(g) {
        v
      } else if v <= 0.0 {
        0.0
      } else if v >= 1.0 {
        1.0
      } else {
        f64_clamp01(f64_pow(v, g))
      }
    }
    ToneCurve::Table(entries) => {
      let n = entries.length()
      if n == 0 {
        return v
      }
      if n == 1 {
        return f64_clamp01(entries[0].to_double() / 65535.0)
      }
      let scaled = v * (n - 1).to_double()
      let idx = f64_floor(scaled).to_int64().to_int()
      if idx >= n - 1 {
        return f64_clamp01(entries[n - 1].to_double() / 65535.0)
      }
      let lo = if idx < 0 { 0 } else { idx }
      let frac = scaled - lo.to_double()
      let y0 = entries[lo].to_double() / 65535.0
      let y1 = entries[lo + 1].to_double() / 65535.0
      f64_clamp01(y0 + (y1 - y0) * frac)
    }
    ToneCurve::Parametric(func_type, g, a, b, c, d, e, f) => {
      let y = match func_type {
        0 => if v <= 0.0 { 0.0 } else { f64_pow(v, g) }
        1 => {
          let base = a * v + b
          if a != 0.0 && v >= -b / a && base > 0.0 {
            f64_pow(base, g)
          } else {
            0.0
          }
        }
        2 => {
          let base = a * v + b
          if a != 0.0 && v >= -b / a && base > 0.0 {
            f64_pow(base, g) + c
          } else {
            c
          }
        }
        3 => {
          if v >= d {
            let base = a * v + b
            if base > 0.0 {
              f64_pow(base, g)
            } else {
              0.0
            }
          } else {
            c * v
          }
        }
        4 => {
          if v >= d {
            let base = a * v + b
            if base > 0.0 {
              f64_pow(base, g) + e
            } else {
              e
            }
          } else {
            c * v + f
          }
        }
        _ => v
      }
      f64_clamp01(y)
    }
  }
}
