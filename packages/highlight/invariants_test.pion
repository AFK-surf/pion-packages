///| Incremental LineState equivalence, full byte-coverage, UTF-8, unclosed delimiter, and O(n) stress invariants.

///|
fn inv_assert_coverage_and_roundtrip(lang : Language, src : String, label : String) -> Unit {
  let spans = highlight(lang, src)
  let n = src.length()
  if n == 0 {
    debug_assert(spans.length() == 0, label + ": empty input must produce 0 spans")
    return
  }
  debug_assert(spans.length() > 0, label + ": non-empty input must produce >=1 span")
  let mut cursor = 0
  let rebuilt = StringBuilder::new()
  let mut i = 0
  while i < spans.length() {
    let sp = spans[i]
    debug_assert(sp.start == cursor, label + ": gap or overlap at span " + i.to_string())
    debug_assert(sp.end > sp.start, label + ": empty or inverted span at " + i.to_string())
    debug_assert(sp.end <= n, label + ": span end out of bounds at " + i.to_string())
    rebuilt.write_string(src.slice(sp.start, sp.end))
    cursor = sp.end
    i = i + 1
  }
  debug_assert(cursor == n, label + ": spans did not reach end of input")
  debug_assert(rebuilt.to_string() == src, label + ": round-trip text mismatch")
}

///|
fn inv_assert_incremental_equiv(lang : Language, src : String, label : String) -> Unit {
  inv_assert_coverage_and_roundtrip(lang, src, label)
  let full = highlight(lang, src)
  let inc : Array[Span] = Array::new()
  let mut state = LineState::initial()
  let n = src.length()
  let mut pos = 0
  while pos < n {
    let mut end = pos
    while end < n && src[end] != 10 {
      end = end + 1
    }
    if end < n && src[end] == 10 {
      end = end + 1
    }
    let line = src.slice(pos, end)
    let (line_spans, next_state) = highlight_line(lang, state, line)
    let mut j = 0
    while j < line_spans.length() {
      let sp = line_spans[j]
      inc.push(Span::{ start: pos + sp.start, end: pos + sp.end, kind: sp.kind })
      j = j + 1
    }
    state = next_state
    pos = end
  }
  debug_assert(
    full.length() == inc.length(),
    label + ": full spans (" + full.length().to_string() + ") != incremental spans (" + inc.length().to_string() + ")",
  )
  let mut i = 0
  while i < full.length() {
    debug_assert(
      span_eq(full[i], inc[i]),
      label + ": span mismatch at index " + i.to_string(),
    )
    i = i + 1
  }
}

// ============================================================================
// Incremental LineState == Full Highlight Equivalence (all 17 languages!)
// ============================================================================

///|
test "invariant incremental: pion with nested comments and #| strings" {
  let src = "/* outer\n/* inner\nstill inner */\nouter end */\n#verify\npub fn f(x : Int) -> String {\n  let s =\n    #|line one\n    #|line two\n  \"val=\\{x + 1}\"\n}\n"
  inv_assert_incremental_equiv(Language::Pion, src, "pion")
}

///|
test "invariant incremental: rust with nested comments and r#\"...\"#" {
  let src = "/* a\n/* b */\nc */\n#[derive(Debug)]\npub fn main() {\n    let s = r#\"line 1\n\"quoted\"\nline 3\"#;\n    println!(\"{}\", s);\n}\n"
  inv_assert_incremental_equiv(Language::Rust, src, "rust")
}

///|
test "invariant incremental: go with block comment and backtick raw string" {
  let src = "package main\n/* multi\nline */\nfunc main() {\n\ts := `raw\nmulti\nline`\n\tfmt.Println(s)\n}\n"
  inv_assert_incremental_equiv(Language::Go, src, "go")
}

///|
test "invariant incremental: typescript with multiline template string" {
  let src = "/* doc\ncomment */\nexport const msg = `hello\n${user.name + 1}\nworld`;\ninterface Foo { a: number }\n"
  inv_assert_incremental_equiv(Language::TypeScript, src, "ts")
}

///|
test "invariant incremental: javascript with multiline template and block comment" {
  let src = "/* block\ncomment */\nconst f = (x) => `a\n${x * 2}\nb`;\n"
  inv_assert_incremental_equiv(Language::JavaScript, src, "js")
}

///|
test "invariant incremental: python with triple double and single strings" {
  let src = "# top\n@dataclass\ndef f():\n    \"\"\"doc\n    line 2\"\"\"\n    s = '''a\n    b'''\n    return True\n"
  inv_assert_incremental_equiv(Language::Python, src, "python")
}

///|
test "invariant incremental: c with block comments and preprocessor" {
  let src = "#include <stdio.h>\n/* multi\n * line\n */\nint main(void) {\n  printf(\"hi\\n\");\n  return 0;\n}\n"
  inv_assert_incremental_equiv(Language::C, src, "c")
}

///|
test "invariant incremental: cpp with block comments and templates" {
  let src = "/* multi\ncomment */\ntemplate<typename T>\nclass Box {\n  std::vector<T> v;\n};\n"
  inv_assert_incremental_equiv(Language::Cpp, src, "cpp")
}

///|
test "invariant incremental: json multiline" {
  let src = "{\n  \"name\": \"highlight\",\n  \"count\": 42,\n  \"ok\": true,\n  \"items\": [1, 2, null]\n}\n"
  inv_assert_incremental_equiv(Language::Json, src, "json")
}

///|
test "invariant incremental: toml with multiline strings" {
  let src = "[package]\nname = \"hl\"\ndesc = \"\"\"\nline 1\nline 2\n\"\"\"\nlit = '''\na\nb\n'''\n"
  inv_assert_incremental_equiv(Language::Toml, src, "toml")
}

///|
test "invariant incremental: yaml with block scalar" {
  let src = "---\n# config\nname: demo\nscript: |\n  echo hello\n  echo world\ncount: 3\n"
  inv_assert_incremental_equiv(Language::Yaml, src, "yaml")
}

///|
test "invariant incremental: sql with block comments and strings" {
  let src = "/* query\nheader */\nSELECT id, 'O''Brien'\nFROM users -- table\nWHERE active = TRUE;\n"
  inv_assert_incremental_equiv(Language::Sql, src, "sql")
}

///|
test "invariant incremental: shell script" {
  let src = "#!/bin/sh\n# loop\nfor x in 1 2 3; do\n  echo \"$x ${HOME}\"\ndone\n"
  inv_assert_incremental_equiv(Language::Shell, src, "shell")
}

///|
test "invariant incremental: html with multiline comment, script, and style" {
  let src = "<!DOCTYPE html>\n<!-- multi\nline comment -->\n<style>\n.a { color: #fff; }\n</style>\n<script>\nconst x = 1;\n</script>\n<div\n  class=\"ok\">hi</div>\n"
  inv_assert_incremental_equiv(Language::Html, src, "html")
}

///|
test "invariant incremental: css with multiline comment" {
  let src = "/* header\nblock */\n@media (min-width: 600px) {\n  .btn {\n    color: #09f;\n    padding: 8px;\n  }\n}\n"
  inv_assert_incremental_equiv(Language::Css, src, "css")
}

///|
test "invariant incremental: diff unified patch" {
  let src = "diff --git a/a.rs b/a.rs\n--- a/a.rs\n+++ b/a.rs\n@@ -1,3 +1,3 @@\n fn main() {\n-  let x = 1;\n+  let x = 2;\n }\n"
  inv_assert_incremental_equiv(Language::Diff, src, "diff")
}

///|
test "invariant incremental: markdown with fenced code block" {
  let src = "# Heading\n\nSome `code` text.\n\n```rust\nlet x = 1;\nlet y = 2;\n```\n\nDone.\n"
  inv_assert_incremental_equiv(Language::Markdown, src, "markdown")
}

// ============================================================================
// Edge Cases, Unclosed Delimiters, UTF-8, and O(n) Adversarial Stress (19 tests)
// ============================================================================

///|
test "invariant edge: empty string across languages" {
  inv_assert_coverage_and_roundtrip(Language::Pion, "", "empty pion")
  inv_assert_coverage_and_roundtrip(Language::Rust, "", "empty rust")
  inv_assert_coverage_and_roundtrip(Language::Html, "", "empty html")
  inv_assert_coverage_and_roundtrip(Language::Diff, "", "empty diff")
  inv_assert_coverage_and_roundtrip(Language::Json, "", "empty json")
}

///|
test "invariant edge: single newline and CRLF" {
  inv_assert_incremental_equiv(Language::Rust, "\n", "nl")
  inv_assert_incremental_equiv(Language::Rust, "\r\n", "crlf")
  inv_assert_incremental_equiv(Language::Python, "x = 1\r\ny = 2\r\n", "py crlf")
}

///|
test "invariant edge: whitespace only" {
  inv_assert_incremental_equiv(Language::TypeScript, "   \t  \n  \t ", "ws")
}

///|
test "invariant edge: unclosed double-quoted string" {
  inv_assert_incremental_equiv(Language::Rust, "let s = \"unterminated\nlet x = 1;", "rust unclosed str")
  inv_assert_incremental_equiv(Language::Json, "{\"a\": \"unterminated", "json unclosed str")
}

///|
test "invariant edge: unclosed single-quoted string" {
  inv_assert_incremental_equiv(Language::Python, "s = 'unterminated\nx = 1", "py unclosed single")
  inv_assert_incremental_equiv(Language::Sql, "SELECT 'unterminated", "sql unclosed single")
}

///|
test "invariant edge: unclosed triple-quoted string" {
  inv_assert_incremental_equiv(Language::Python, "s = \"\"\"unclosed\nline 2\nline 3", "py unclosed triple")
  inv_assert_incremental_equiv(Language::Toml, "s = '''unclosed\nline 2", "toml unclosed triple")
}

///|
test "invariant edge: unclosed Rust raw string" {
  inv_assert_incremental_equiv(Language::Rust, "let s = r###\"never ends\n\"## still open", "rust unclosed raw")
}

///|
test "invariant edge: unclosed nested block comment" {
  inv_assert_incremental_equiv(Language::Pion, "/* outer /* inner */\nstill open", "pion unclosed nested")
  inv_assert_incremental_equiv(Language::Rust, "/* a /* b */\nstill open", "rust unclosed nested")
}

///|
test "invariant edge: unclosed JS template string with ${" {
  inv_assert_incremental_equiv(Language::JavaScript, "const s = `open ${a + b\nstill open", "js unclosed template")
}

///|
test "invariant edge: unclosed HTML comment and script tag" {
  inv_assert_incremental_equiv(Language::Html, "<!-- never closed\n<div>x</div>", "html unclosed comment")
  inv_assert_incremental_equiv(Language::Html, "<script>\nconst x = 1;\n// no close", "html unclosed script")
}

///|
test "invariant edge: trailing backslash at EOF" {
  inv_assert_incremental_equiv(Language::C, "const char *s = \"abc\\", "c trailing backslash")
  inv_assert_incremental_equiv(Language::Shell, "echo \"hi\\", "sh trailing backslash")
}

///|
test "invariant edge: UTF-8 CJK in comments strings and identifiers" {
  inv_assert_incremental_equiv(Language::Pion, "// 你好世界\nlet 名字 = \"测试\";\n", "pion cjk")
  inv_assert_incremental_equiv(Language::Python, "# 中文注释\nmsg = \"你好，世界\"\n", "py cjk")
  inv_assert_incremental_equiv(Language::Json, "{\"键\": \"值\", \"数字\": 123}\n", "json cjk")
}

///|
test "invariant edge: UTF-8 emoji and ZWJ sequences" {
  inv_assert_incremental_equiv(Language::TypeScript, "const e = \"🚀🔥👨‍👩‍👧‍👦\"; // ✅\n", "ts emoji")
  inv_assert_incremental_equiv(Language::Diff, "+🚀 added\n-🔥 removed\n", "diff emoji")
  inv_assert_incremental_equiv(Language::Html, "<p title=\"🎉\">你好 🌍</p>\n", "html emoji")
}

///|
test "invariant edge: line without trailing newline" {
  inv_assert_incremental_equiv(Language::Go, "func main() { x := 1 }", "go no trailing nl")
  inv_assert_incremental_equiv(Language::Css, ".a { color: #fff }", "css no trailing nl")
}

///|
test "invariant edge: consecutive empty lines" {
  inv_assert_incremental_equiv(Language::Yaml, "\n\n\na: 1\n\n\nb: 2\n\n", "yaml empty lines")
}

///|
test "invariant edge: LineState returns to initial after closed constructs" {
  let (_, st1) = highlight_line(Language::Rust, LineState::initial(), "/* open\n")
  debug_assert(!line_state_eq(st1, LineState::initial()), "state should be in block comment")
  let (_, st2) = highlight_line(Language::Rust, st1, "close */\n")
  debug_assert(line_state_eq(st2, LineState::initial()), "state should return to initial")
}

///|
test "invariant stress: 10KB single line of repeated operators and identifiers" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 500 {
    sb.write_string("foo + bar * 42 == ")
    i = i + 1
  }
  let big = sb.to_string()
  inv_assert_coverage_and_roundtrip(Language::Rust, big, "10KB rust")
  inv_assert_coverage_and_roundtrip(Language::TypeScript, big, "10KB ts")
}

///|
test "invariant stress: 10KB pathological slashes and quotes" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 1000 {
    sb.write_string("/*a*//*b*/")
    i = i + 1
  }
  let big = sb.to_string()
  inv_assert_coverage_and_roundtrip(Language::Pion, big, "10KB comments")
  inv_assert_coverage_and_roundtrip(Language::Css, big, "10KB css comments")
}

///|
test "invariant stress: 10KB HTML tags and unclosed angle brackets" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 1000 {
    sb.write_string("<a b=\"c\">d")
    i = i + 1
  }
  let big = sb.to_string()
  inv_assert_coverage_and_roundtrip(Language::Html, big, "10KB html")
}
