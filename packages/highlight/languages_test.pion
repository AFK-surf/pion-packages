///|
test "resolve: css" {
  assert_lang_resolves("css", Language::Css)
  assert_lang_resolves("scss", Language::Css)
}

///|
test "resolve: diff and patch" {
  assert_lang_resolves("diff", Language::Diff)
  assert_lang_resolves("patch", Language::Diff)
