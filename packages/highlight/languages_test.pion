///|
test "resolve: case insensitivity" {
  assert_lang_resolves("RUST", Language::Rust)
  assert_lang_resolves("TypeScript", Language::TypeScript)
  assert_lang_resolves("PyThOn", Language::Python)
  assert_lang_resolves("JSON", Language::Json)
  assert_lang_resolves("HTML", Language::Html)
  assert_lang_resolves("C++", Language::Cpp)
}

///|
test "resolve: trims surrounding whitespace" {
  assert_lang_resolves("  rs  ", Language::Rust)
  assert_lang_resolves("\tpy\n", Language::Python)
  assert_lang_resolves(" yml ", Language::Yaml)
}

///|
test "resolve: unknown languages return None" {
  assert_lang_none("")
  assert_lang_none("   ")
  assert_lang_none("unknown_lang_xyz")
  assert_lang_none("brainfuck")
}

///|
test "token_kind_class: all variants" {
  debug_assert(token_kind_class(TokenKind::Plain) == "", "Plain class empty")
  debug_assert(token_kind_class(TokenKind::Keyword) == "hl-keyword", "Keyword")
  debug_assert(token_kind_class(TokenKind::Type) == "hl-type", "Type")
  debug_assert(token_kind_class(TokenKind::Function) == "hl-function", "Function")
  debug_assert(token_kind_class(TokenKind::String) == "hl-string", "String")
  debug_assert(token_kind_class(TokenKind::Number) == "hl-number", "Number")
  debug_assert(token_kind_class(TokenKind::Comment) == "hl-comment", "Comment")
  debug_assert(token_kind_class(TokenKind::Operator) == "hl-operator", "Operator")
  debug_assert(token_kind_class(TokenKind::Punctuation) == "hl-punctuation", "Punctuation")
  debug_assert(token_kind_class(TokenKind::Constant) == "hl-constant", "Constant")
  debug_assert(token_kind_class(TokenKind::Attribute) == "hl-attribute", "Attribute")
  debug_assert(token_kind_class(TokenKind::Property) == "hl-property", "Property")
  debug_assert(token_kind_class(TokenKind::Tag) == "hl-tag", "Tag")
  debug_assert(token_kind_class(TokenKind::Variable) == "hl-variable", "Variable")
  debug_assert(token_kind_class(TokenKind::Namespace) == "hl-namespace", "Namespace")
  debug_assert(token_kind_class(TokenKind::DiffAdd) == "hl-diff-add", "DiffAdd")
  debug_assert(token_kind_class(TokenKind::DiffDel) == "hl-diff-del", "DiffDel")
  debug_assert(token_kind_class(TokenKind::DiffHeader) == "hl-diff-header", "DiffHeader")
}

///|
test "highlight_html: empty string" {
  debug_assert(highlight_html(Language::Rust, "") == "", "empty html")
}

///|
test "highlight_html: wraps keyword and number spans" {
  let html = highlight_html(Language::Rust, "let x = 42;")
  debug_assert(html.contains("<span class=\"hl-keyword\">let</span>"), "keyword span")
  debug_assert(html.contains("<span class=\"hl-number\">42</span>"), "number span")
}

///|
test "highlight_html: escapes ampersand and angle brackets" {
  let html = highlight_html(Language::Cpp, "a < b && c > d")
  debug_assert(html.contains("&lt;"), "escapes <")
  debug_assert(html.contains("&gt;"), "escapes >")
  debug_assert(html.contains("&amp;&amp;"), "escapes &&")
}

///|
test "highlight_html: escapes quotes in strings" {
  let html = highlight_html(Language::Json, "{\"k\": \"v\"}")
  debug_assert(html.contains("&quot;k&quot;"), "escapes double quotes in property")
  debug_assert(html.contains("&quot;v&quot;"), "escapes double quotes in string")
}

///|
test "highlight_html: escapes html tags in html mode" {
  let html = highlight_html(Language::Html, "<div class=\"a\">hi</div>")
  debug_assert(html.contains("&lt;"), "escaped <")
  debug_assert(html.contains("&gt;"), "escaped >")
  debug_assert(html.contains("<span class=\"hl-tag\">div</span>"), "tag span")
  debug_assert(html.contains("<span class=\"hl-attribute\">class</span>"), "attr span")
}

///|
test "highlight_html: plain whitespace is not wrapped in span" {
  let html = highlight_html(Language::Rust, "   \n")
  debug_assert(!html.contains("<span"), "plain text should not be wrapped")
  debug_assert(html == "   \n", "plain text preserved")
}

///|
test "highlight_html: diff classes" {
  let html = highlight_html(Language::Diff, "@@ -1 +1 @@\n-old\n+new\n")
  debug_assert(html.contains("hl-diff-header"), "diff header class")
  debug_assert(html.contains("hl-diff-del"), "diff del class")
  debug_assert(html.contains("hl-diff-add"), "diff add class")
}

///|
test "highlight_html: preserves single quotes escaped" {
  let html = highlight_html(Language::Sql, "SELECT 'O''Brien'")
  debug_assert(html.contains("hl-keyword"), "SELECT keyword")
  debug_assert(html.contains("hl-string"), "SQL string")
  debug_assert(html.contains("&#39;"), "single quote escaped")
}

///|
test "highlight_html: utf8 CJK and emoji preserved verbatim" {
  let html = highlight_html(Language::Python, "# 你好 🚀\nmsg = \"世界\"")
  debug_assert(html.contains("你好 🚀"), "CJK + emoji in comment")
  debug_assert(html.contains("世界"), "CJK in string")
}

///|
test "highlight_html: comment with script tag is escaped" {
  let html = highlight_html(Language::JavaScript, "// <script>alert(1)</script>")
  debug_assert(!html.contains("<script>"), "no raw script tag")
  debug_assert(html.contains("&lt;script&gt;"), "escaped script tag")
}

///|
test "highlight_html: multiline preserves newlines outside spans" {
  let html = highlight_html(Language::Rust, "// line1\n// line2")
  debug_assert(html == "<span class=\"hl-comment\">// line1</span>\n<span class=\"hl-comment\">// line2</span>", "newline between comment spans")
}
