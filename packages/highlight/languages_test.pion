///| Language resolution, CSS class mapping, and HTML rendering tests for `highlight`.

///|
fn assert_lang_resolves(name : String, expected : Language) -> Unit {
  match resolve_language(name) {
    Some(got) => debug_assert(language_eq(got, expected), "resolve_language(" + name + ") mismatch")
    None => debug_assert(false, "resolve_language(" + name + ") returned None")
  }
}

///|
fn assert_lang_none(name : String) -> Unit {
  match resolve_language(name) {
    Some(_) => debug_assert(false, "resolve_language(" + name + ") expected None")
    None => ()
  }
}

///|
test "resolve: pion and aliases" {
  assert_lang_resolves("pion", Language::Pion)
  assert_lang_resolves("mbt", Language::Pion)
  assert_lang_resolves("moonbit", Language::Pion)
}

///|
test "resolve: rust and aliases" {
  assert_lang_resolves("rust", Language::Rust)
  assert_lang_resolves("rs", Language::Rust)
}

///|
test "resolve: go and aliases" {
  assert_lang_resolves("go", Language::Go)
  assert_lang_resolves("golang", Language::Go)
}

///|
test "resolve: typescript and aliases" {
  assert_lang_resolves("typescript", Language::TypeScript)
  assert_lang_resolves("ts", Language::TypeScript)
  assert_lang_resolves("tsx", Language::TypeScript)
  assert_lang_resolves("mts", Language::TypeScript)
  assert_lang_resolves("cts", Language::TypeScript)
}

///|
test "resolve: javascript and aliases" {
  assert_lang_resolves("javascript", Language::JavaScript)
  assert_lang_resolves("js", Language::JavaScript)
  assert_lang_resolves("jsx", Language::JavaScript)
  assert_lang_resolves("mjs", Language::JavaScript)
  assert_lang_resolves("cjs", Language::JavaScript)
}

