///| Scripting language tokenizer tests: TypeScript, JavaScript, Python, Shell.

///|
fn scr_has_token(
  lang : Language,
  src : String,
  text : String,
  kind : TokenKind,
) -> Bool {
  let spans = highlight(lang, src)
  let mut i = 0
  while i < spans.length() {
    let sp = spans[i]
    if token_kind_eq(sp.kind, kind) && src.slice(sp.start, sp.end) == text {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn scr_assert_tok(lang : Language, src : String, text : String, kind : TokenKind) -> Unit {
  debug_assert(
    scr_has_token(lang, src, text, kind),
    "expected token `" + text + "` with class `" + token_kind_class(kind) + "` in `" + src + "`",
  )
}

// ============================================================================
// TypeScript (12 tests)
// ============================================================================

///|
test "ts: keywords" {
  let src = "export async function load(): Promise<void> { const x = await fetch(); return }"
  scr_assert_tok(Language::TypeScript, src, "export", TokenKind::Keyword)
  scr_assert_tok(Language::TypeScript, src, "async", TokenKind::Keyword)
  scr_assert_tok(Language::TypeScript, src, "function", TokenKind::Keyword)
  scr_assert_tok(Language::TypeScript, src, "const", TokenKind::Keyword)
  scr_assert_tok(Language::TypeScript, src, "await", TokenKind::Keyword)
  scr_assert_tok(Language::TypeScript, src, "return", TokenKind::Keyword)
}

///|
test "ts: type keywords interface type readonly" {
  let src = "interface User { readonly id: number; name: string; active: boolean }"
  scr_assert_tok(Language::TypeScript, src, "interface", TokenKind::Keyword)
  scr_assert_tok(Language::TypeScript, src, "readonly", TokenKind::Keyword)
  scr_assert_tok(Language::TypeScript, src, "number", TokenKind::Type)
  scr_assert_tok(Language::TypeScript, src, "string", TokenKind::Type)
  scr_assert_tok(Language::TypeScript, src, "boolean", TokenKind::Type)
}

///|
test "ts: builtin types unknown never void Promise" {
  let src = "type Handler = (x: unknown) => Promise<never | void>"
  scr_assert_tok(Language::TypeScript, src, "type", TokenKind::Keyword)
  scr_assert_tok(Language::TypeScript, src, "unknown", TokenKind::Type)
  scr_assert_tok(Language::TypeScript, src, "Promise", TokenKind::Type)
  scr_assert_tok(Language::TypeScript, src, "never", TokenKind::Type)
  scr_assert_tok(Language::TypeScript, src, "void", TokenKind::Type)
}

///|
test "ts: template string with interpolation" {
  let src = "const msg = `hello ${user.name}, count=${1 + 2}!`"
  scr_assert_tok(Language::TypeScript, src, "`hello ", TokenKind::String)
  scr_assert_tok(Language::TypeScript, src, "${", TokenKind::Punctuation)
  scr_assert_tok(Language::TypeScript, src, "1", TokenKind::Number)
  scr_assert_tok(Language::TypeScript, src, "2", TokenKind::Number)
  scr_assert_tok(Language::TypeScript, src, "!`", TokenKind::String)
}

///|
test "ts: template string with nested object braces" {
  let src = "const s = `val=${({ a: 1 }).a}end`"
  scr_assert_tok(Language::TypeScript, src, "`val=", TokenKind::String)
  scr_assert_tok(Language::TypeScript, src, "1", TokenKind::Number)
  scr_assert_tok(Language::TypeScript, src, "end`", TokenKind::String)
}

///|
test "ts: decorator @Component" {
  let src = "@Component\nclass App {}"
  scr_assert_tok(Language::TypeScript, src, "@Component", TokenKind::Attribute)
  scr_assert_tok(Language::TypeScript, src, "class", TokenKind::Keyword)
}

///|
test "ts: operators === !== => ?? ?." {
  let src = "const f = (a, b) => a === b ? a?.x : b ?? 0"
  scr_assert_tok(Language::TypeScript, src, "=>", TokenKind::Operator)
  scr_assert_tok(Language::TypeScript, src, "===", TokenKind::Operator)
  scr_assert_tok(Language::TypeScript, src, "?.", TokenKind::Operator)
  scr_assert_tok(Language::TypeScript, src, "??", TokenKind::Operator)
}

///|
test "ts: numbers bigint hex binary underscore" {
  let src = "const a = 1_000_000n; const b = 0xFF; const c = 0b1010; const d = 3.14e2"
  scr_assert_tok(Language::TypeScript, src, "1_000_000n", TokenKind::Number)
  scr_assert_tok(Language::TypeScript, src, "0xFF", TokenKind::Number)
  scr_assert_tok(Language::TypeScript, src, "0b1010", TokenKind::Number)
  scr_assert_tok(Language::TypeScript, src, "3.14e2", TokenKind::Number)
}

///|
test "ts: constants true false null undefined" {
  let src = "const a = true, b = false, c = null, d = undefined"
  scr_assert_tok(Language::TypeScript, src, "true", TokenKind::Constant)
  scr_assert_tok(Language::TypeScript, src, "false", TokenKind::Constant)
  scr_assert_tok(Language::TypeScript, src, "null", TokenKind::Constant)
  scr_assert_tok(Language::TypeScript, src, "undefined", TokenKind::Constant)
}

///|
test "ts: comments line and block" {
  let src = "// one\n/* two */ const x = 1"
  scr_assert_tok(Language::TypeScript, src, "// one", TokenKind::Comment)
  scr_assert_tok(Language::TypeScript, src, "/* two */", TokenKind::Comment)
}

///|
test "ts: function calls and method calls" {
  let src = "console.log(compute(42))"
  scr_assert_tok(Language::TypeScript, src, "log", TokenKind::Function)
  scr_assert_tok(Language::TypeScript, src, "compute", TokenKind::Function)
}

///|
test "ts: single and double quoted strings with escapes" {
  let src = "const a = 'it\\'s'; const b = \"say \\\"hi\\\"\""
  scr_assert_tok(Language::TypeScript, src, "'it\\'s'", TokenKind::String)
  scr_assert_tok(Language::TypeScript, src, "\"say \\\"hi\\\"\"", TokenKind::String)
}

// ============================================================================
// JavaScript (10 tests)
// ============================================================================

///|
test "js: keywords" {
  let src = "import x from 'y'; export default class A extends B { async *gen() { yield 1 } }"
  scr_assert_tok(Language::JavaScript, src, "import", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "from", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "export", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "default", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "class", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "extends", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "yield", TokenKind::Keyword)
}

///|
test "js: multiline template literal" {
  let src = "const t = `line1\nline2 ${42}\nline3`"
  scr_assert_tok(Language::JavaScript, src, "`line1", TokenKind::String)
  scr_assert_tok(Language::JavaScript, src, "42", TokenKind::Number)
  scr_assert_tok(Language::JavaScript, src, "line3`", TokenKind::String)
}

///|
test "js: constants" {
  let src = "let x = null ?? undefined ?? NaN ?? Infinity"
  scr_assert_tok(Language::JavaScript, src, "null", TokenKind::Constant)
  scr_assert_tok(Language::JavaScript, src, "undefined", TokenKind::Constant)
  scr_assert_tok(Language::JavaScript, src, "NaN", TokenKind::Constant)
  scr_assert_tok(Language::JavaScript, src, "Infinity", TokenKind::Constant)
}

///|
test "js: builtin types" {
  let src = "new Map(); new Set(); Promise.resolve(1)"
  scr_assert_tok(Language::JavaScript, src, "new", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "Map", TokenKind::Type)
  scr_assert_tok(Language::JavaScript, src, "Set", TokenKind::Type)
  scr_assert_tok(Language::JavaScript, src, "Promise", TokenKind::Type)
}

///|
test "js: numbers" {
  let src = "const a = 0x1f; const b = 1.5e3; const c = 99n"
  scr_assert_tok(Language::JavaScript, src, "0x1f", TokenKind::Number)
  scr_assert_tok(Language::JavaScript, src, "1.5e3", TokenKind::Number)
  scr_assert_tok(Language::JavaScript, src, "99n", TokenKind::Number)
}

///|
test "js: spread and strict inequality" {
  let src = "const arr = [...a]; if (x !== y) {}"
  scr_assert_tok(Language::JavaScript, src, "...", TokenKind::Operator)
  scr_assert_tok(Language::JavaScript, src, "!==", TokenKind::Operator)
}

///|
test "js: comments" {
  let src = "// hi\n/* multi\nline */ 1"
  scr_assert_tok(Language::JavaScript, src, "// hi", TokenKind::Comment)
  scr_assert_tok(Language::JavaScript, src, "/* multi", TokenKind::Comment)
  scr_assert_tok(Language::JavaScript, src, "line */", TokenKind::Comment)
}

///|
test "js: function call" {
  let src = "parseInt('42', 10)"
  scr_assert_tok(Language::JavaScript, src, "parseInt", TokenKind::Function)
  scr_assert_tok(Language::JavaScript, src, "'42'", TokenKind::String)
  scr_assert_tok(Language::JavaScript, src, "10", TokenKind::Number)
}

///|
test "js: try catch finally throw" {
  let src = "try { throw new Error('x') } catch (e) {} finally {}"
  scr_assert_tok(Language::JavaScript, src, "try", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "throw", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "catch", TokenKind::Keyword)
  scr_assert_tok(Language::JavaScript, src, "finally", TokenKind::Keyword)
}

///|
test "js: template string without interpolation" {
  let src = "const s = `plain template`"
  scr_assert_tok(Language::JavaScript, src, "`plain template`", TokenKind::String)
}

// ============================================================================
// Python (10 tests)
// ============================================================================

///|
test "python: keywords" {
  let src = "async def fetch(x):\n  with open(x) as f:\n    yield await f.read()"
  scr_assert_tok(Language::Python, src, "async", TokenKind::Keyword)
  scr_assert_tok(Language::Python, src, "def", TokenKind::Keyword)
  scr_assert_tok(Language::Python, src, "with", TokenKind::Keyword)
  scr_assert_tok(Language::Python, src, "as", TokenKind::Keyword)
  scr_assert_tok(Language::Python, src, "yield", TokenKind::Keyword)
  scr_assert_tok(Language::Python, src, "await", TokenKind::Keyword)
}

///|
test "python: decorators" {
  let src = "@dataclass\n@staticmethod\ndef build(): pass"
  scr_assert_tok(Language::Python, src, "@dataclass", TokenKind::Attribute)
  scr_assert_tok(Language::Python, src, "@staticmethod", TokenKind::Attribute)
  scr_assert_tok(Language::Python, src, "pass", TokenKind::Keyword)
}

///|
test "python: triple double-quoted multiline string" {
  let src = "doc = \"\"\"hello\nworld\"\"\"\nx = 1"
  scr_assert_tok(Language::Python, src, "\"\"\"hello", TokenKind::String)
  scr_assert_tok(Language::Python, src, "world\"\"\"", TokenKind::String)
  scr_assert_tok(Language::Python, src, "1", TokenKind::Number)
}

///|
test "python: triple single-quoted multiline string" {
  let src = "doc = '''line1\nline2'''"
  scr_assert_tok(Language::Python, src, "'''line1", TokenKind::String)
  scr_assert_tok(Language::Python, src, "line2'''", TokenKind::String)
}

///|
test "python: prefixed strings f r b" {
  let src = "a = f\"val={x}\"; b = r\"\\d+\"; c = b\"raw\""
  scr_assert_tok(Language::Python, src, "f\"val={x}\"", TokenKind::String)
  scr_assert_tok(Language::Python, src, "r\"\\d+\"", TokenKind::String)
  scr_assert_tok(Language::Python, src, "b\"raw\"", TokenKind::String)
}

///|
test "python: hash comments" {
  let src = "# comment line\nx = 1 # inline"
  scr_assert_tok(Language::Python, src, "# comment line", TokenKind::Comment)
  scr_assert_tok(Language::Python, src, "# inline", TokenKind::Comment)
}

///|
test "python: constants True False None" {
  let src = "a = True; b = False; c = None"
  scr_assert_tok(Language::Python, src, "True", TokenKind::Constant)
  scr_assert_tok(Language::Python, src, "False", TokenKind::Constant)
  scr_assert_tok(Language::Python, src, "None", TokenKind::Constant)
}

///|
test "python: builtin types" {
  let src = "def f(a: int, b: str, c: list, d: dict) -> bool:"
  scr_assert_tok(Language::Python, src, "int", TokenKind::Type)
  scr_assert_tok(Language::Python, src, "str", TokenKind::Type)
  scr_assert_tok(Language::Python, src, "list", TokenKind::Type)
  scr_assert_tok(Language::Python, src, "dict", TokenKind::Type)
  scr_assert_tok(Language::Python, src, "bool", TokenKind::Type)
}

///|
test "python: numbers hex bin oct underscore imaginary" {
  let src = "n = 1_000 + 0xFF + 0b1010 + 0o77 + 3.14j"
  scr_assert_tok(Language::Python, src, "1_000", TokenKind::Number)
  scr_assert_tok(Language::Python, src, "0xFF", TokenKind::Number)
  scr_assert_tok(Language::Python, src, "0b1010", TokenKind::Number)
  scr_assert_tok(Language::Python, src, "0o77", TokenKind::Number)
  scr_assert_tok(Language::Python, src, "3.14j", TokenKind::Number)
}

///|
test "python: operators // ** := ->" {
  let src = "if (n := a // b ** 2) > 0: print(n)"
  scr_assert_tok(Language::Python, src, ":=", TokenKind::Operator)
  scr_assert_tok(Language::Python, src, "//", TokenKind::Operator)
  scr_assert_tok(Language::Python, src, "**", TokenKind::Operator)
  scr_assert_tok(Language::Python, src, "print", TokenKind::Function)
}

// ============================================================================
// Shell (8 tests)
// ============================================================================

///|
test "shell: shebang and comments" {
  let src = "#!/usr/bin/env bash\n# setup\necho hi"
  scr_assert_tok(Language::Shell, src, "#!/usr/bin/env bash", TokenKind::Comment)
  scr_assert_tok(Language::Shell, src, "# setup", TokenKind::Comment)
}

///|
test "shell: control keywords" {
  let src = "if [ -f a ]; then for x in 1 2; do echo $x; done; fi"
  scr_assert_tok(Language::Shell, src, "if", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "then", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "for", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "in", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "do", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "done", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "fi", TokenKind::Keyword)
}

///|
test "shell: variables $VAR and ${VAR:-default}" {
  let src = "echo $HOME ${PATH:-/usr/bin} $1 $?"
  scr_assert_tok(Language::Shell, src, "$HOME", TokenKind::Variable)
  scr_assert_tok(Language::Shell, src, "${PATH:-/usr/bin}", TokenKind::Variable)
  scr_assert_tok(Language::Shell, src, "$1", TokenKind::Variable)
  scr_assert_tok(Language::Shell, src, "$?", TokenKind::Variable)
}

///|
test "shell: single and double quoted strings" {
  let src = "echo \"hello \\\"world\\\"\" 'literal $VAR'"
  scr_assert_tok(Language::Shell, src, "\"hello \\\"world\\\"\"", TokenKind::String)
  scr_assert_tok(Language::Shell, src, "'literal $VAR'", TokenKind::String)
}

///|
test "shell: pipes and logical operators" {
  let src = "cat a | grep foo && echo ok || exit 1"
  scr_assert_tok(Language::Shell, src, "|", TokenKind::Operator)
  scr_assert_tok(Language::Shell, src, "&&", TokenKind::Operator)
  scr_assert_tok(Language::Shell, src, "||", TokenKind::Operator)
}

///|
test "shell: export local return" {
  let src = "export PATH=/bin; local x=42; return 0"
  scr_assert_tok(Language::Shell, src, "export", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "local", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "return", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "42", TokenKind::Number)
}

///|
test "shell: redirect operators" {
  let src = "cmd >> out.log"
  scr_assert_tok(Language::Shell, src, ">>", TokenKind::Operator)
}

///|
test "shell: case esac" {
  let src = "case $1 in start) echo ok ;; esac"
  scr_assert_tok(Language::Shell, src, "case", TokenKind::Keyword)
  scr_assert_tok(Language::Shell, src, "esac", TokenKind::Keyword)
}
