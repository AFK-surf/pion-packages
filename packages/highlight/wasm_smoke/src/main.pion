///| Wasm32 compilation smoke entry for `highlight`.
import "highlight"

///|
pub fn smoke() -> Int {
  match highlight::resolve_language("rust") {
    Some(lang) => {
      let src = "pub fn add(a: i32, b: i32) -> i32 { a + b }\n"
      let spans = highlight::highlight(lang, src)
      let html = highlight::highlight_html(lang, src)
      if spans.length() > 0 && html.length() > src.length() {
        spans.length()
      } else {
        -1
      }
    }
    None => -2
  }
}

///|
pub fn main(_world : World) -> Int {
  let n = smoke()
  if n > 0 { 0 } else { 1 }
}
