///| Systems language tokenizer tests: Pion, Rust, Go, C, C++.

///|
fn sys_has_token(
  lang : Language,
  src : String,
  text : String,
  kind : TokenKind,
) -> Bool {
  let spans = highlight(lang, src)
  let mut i = 0
  while i < spans.length() {
    let sp = spans[i]
    if token_kind_eq(sp.kind, kind) && src.slice(sp.start, sp.end) == text {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn sys_assert_tok(lang : Language, src : String, text : String, kind : TokenKind) -> Unit {
  debug_assert(
    sys_has_token(lang, src, text, kind),
    "expected token `" + text + "` with class `" + token_kind_class(kind) + "` in `" + src + "`",
  )
}

// ============================================================================
// Pion (12 tests)
// ============================================================================

///|
test "pion: keywords pub fn let mut match while return" {
  let src = "pub fn f(x : Int) -> Int { let mut a = x; while a > 0 { return a } match a { _ => 0 } }"
  sys_assert_tok(Language::Pion, src, "pub", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "fn", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "let", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "mut", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "while", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "return", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "match", TokenKind::Keyword)
}

///|
test "pion: val struct and enum keywords" {
  let src = "pub val struct Span { pub start : Int }\npub enum Kind { Plain }"
  sys_assert_tok(Language::Pion, src, "val", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "struct", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "enum", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "Span", TokenKind::Type)
  sys_assert_tok(Language::Pion, src, "Int", TokenKind::Type)
}

///|
test "pion: builtin types" {
  let src = "let a : Array[Option[Result[String, Double]]] = Array::new()"
  sys_assert_tok(Language::Pion, src, "Array", TokenKind::Type)
  sys_assert_tok(Language::Pion, src, "Option", TokenKind::Type)
  sys_assert_tok(Language::Pion, src, "Result", TokenKind::Type)
  sys_assert_tok(Language::Pion, src, "String", TokenKind::Type)
  sys_assert_tok(Language::Pion, src, "Double", TokenKind::Type)
}

///|
test "pion: multiline raw string #|" {
  let src = "let s =\n  #|hello world\n  #|second line"
  sys_assert_tok(Language::Pion, src, "#|hello world", TokenKind::String)
  sys_assert_tok(Language::Pion, src, "#|second line", TokenKind::String)
}

///|
test "pion: string interpolation \\{expr}" {
  let src = "let s = \"hello \\{name + 1}!\""
  sys_assert_tok(Language::Pion, src, "\"hello ", TokenKind::String)
  sys_assert_tok(Language::Pion, src, "1", TokenKind::Number)
  sys_assert_tok(Language::Pion, src, "!\"", TokenKind::String)
}

///|
test "pion: nested block comments /* /* */ */" {
  let src = "/* outer /* inner */ still comment */ let x = 1"
  sys_assert_tok(Language::Pion, src, "/* outer /* inner */ still comment */", TokenKind::Comment)
  sys_assert_tok(Language::Pion, src, "let", TokenKind::Keyword)
  sys_assert_tok(Language::Pion, src, "1", TokenKind::Number)
}

///|
test "pion: doc comments ///| and line comments //" {
  let src = "///| doc comment\n// regular\nlet x = 1"
  sys_assert_tok(Language::Pion, src, "///| doc comment", TokenKind::Comment)
  sys_assert_tok(Language::Pion, src, "// regular", TokenKind::Comment)
}

///|
test "pion: #verify attribute" {
  let src = "#verify\npub fn add(a : Int, b : Int) -> Int { a + b }"
  sys_assert_tok(Language::Pion, src, "#verify", TokenKind::Attribute)
  sys_assert_tok(Language::Pion, src, "add", TokenKind::Function)
}

///|
test "pion: function calls and namespace" {
  let src = "let r = texmath::parse(input, opts)"
  sys_assert_tok(Language::Pion, src, "texmath", TokenKind::Namespace)
  sys_assert_tok(Language::Pion, src, "parse", TokenKind::Function)
}

///|
test "pion: numbers hex bin oct float underscore" {
  let src = "let a = 0xFF_00 + 0b1010_0101 + 0o755 + 3.14e-2 + 1_000"
  sys_assert_tok(Language::Pion, src, "0xFF_00", TokenKind::Number)
  sys_assert_tok(Language::Pion, src, "0b1010_0101", TokenKind::Number)
  sys_assert_tok(Language::Pion, src, "0o755", TokenKind::Number)
  sys_assert_tok(Language::Pion, src, "3.14e-2", TokenKind::Number)
  sys_assert_tok(Language::Pion, src, "1_000", TokenKind::Number)
}

///|
test "pion: boolean and option constants" {
  let src = "let a = true; let b = false; let c = None"
  sys_assert_tok(Language::Pion, src, "true", TokenKind::Constant)
  sys_assert_tok(Language::Pion, src, "false", TokenKind::Constant)
  sys_assert_tok(Language::Pion, src, "None", TokenKind::Constant)
}

///|
test "pion: operators" {
  let src = "a == b && c != d || e <= f"
  sys_assert_tok(Language::Pion, src, "==", TokenKind::Operator)
  sys_assert_tok(Language::Pion, src, "&&", TokenKind::Operator)
  sys_assert_tok(Language::Pion, src, "!=", TokenKind::Operator)
  sys_assert_tok(Language::Pion, src, "||", TokenKind::Operator)
  sys_assert_tok(Language::Pion, src, "<=", TokenKind::Operator)
}

// ============================================================================
// Rust (14 tests)
// ============================================================================

///|
test "rust: keywords" {
  let src = "pub async unsafe fn run() -> () { let mut x = 1; match x { _ => return } }"
  sys_assert_tok(Language::Rust, src, "pub", TokenKind::Keyword)
  sys_assert_tok(Language::Rust, src, "async", TokenKind::Keyword)
  sys_assert_tok(Language::Rust, src, "unsafe", TokenKind::Keyword)
  sys_assert_tok(Language::Rust, src, "fn", TokenKind::Keyword)
  sys_assert_tok(Language::Rust, src, "let", TokenKind::Keyword)
  sys_assert_tok(Language::Rust, src, "mut", TokenKind::Keyword)
  sys_assert_tok(Language::Rust, src, "match", TokenKind::Keyword)
  sys_assert_tok(Language::Rust, src, "return", TokenKind::Keyword)
}

///|
test "rust: primitive and std types" {
  let src = "fn f(a: i32, b: u64, c: usize, d: &str) -> Result<Vec<String>, Box<dyn Error>>"
  sys_assert_tok(Language::Rust, src, "i32", TokenKind::Type)
  sys_assert_tok(Language::Rust, src, "u64", TokenKind::Type)
  sys_assert_tok(Language::Rust, src, "usize", TokenKind::Type)
  sys_assert_tok(Language::Rust, src, "str", TokenKind::Type)
  sys_assert_tok(Language::Rust, src, "Result", TokenKind::Type)
  sys_assert_tok(Language::Rust, src, "Vec", TokenKind::Type)
  sys_assert_tok(Language::Rust, src, "String", TokenKind::Type)
}

///|
test "rust: macros with bang" {
  let src = "println!(\"hi\"); let v = vec![1, 2]; format!(\"{}\", 3);"
  sys_assert_tok(Language::Rust, src, "println!", TokenKind::Function)
  sys_assert_tok(Language::Rust, src, "vec!", TokenKind::Function)
  sys_assert_tok(Language::Rust, src, "format!", TokenKind::Function)
}

///|
test "rust: outer and inner attributes" {
  let src = "#![no_std]\n#[derive(Debug, Clone)]\nstruct Foo;"
  sys_assert_tok(Language::Rust, src, "#![no_std]", TokenKind::Attribute)
  sys_assert_tok(Language::Rust, src, "#[derive(Debug, Clone)]", TokenKind::Attribute)
  sys_assert_tok(Language::Rust, src, "struct", TokenKind::Keyword)
}

///|
test "rust: lifetimes vs char literals" {
  let src = "fn first<'a>(s: &'a str) -> char { let c = 'x'; let nl = '\\n'; c }"
  sys_assert_tok(Language::Rust, src, "'a", TokenKind::Attribute)
  sys_assert_tok(Language::Rust, src, "'x'", TokenKind::String)
  sys_assert_tok(Language::Rust, src, "'\\n'", TokenKind::String)
}

///|
test "rust: raw string r\"...\"" {
  let src = "let s = r\"raw\\nstring\";"
  sys_assert_tok(Language::Rust, src, "r\"raw\\nstring\"", TokenKind::String)
}

///|
test "rust: raw string with hashes r#\"...\"#" {
  let src = "let s = r#\"hello \"world\"!\"#;"
  sys_assert_tok(Language::Rust, src, "r#\"hello \"world\"!\"#", TokenKind::String)
}

///|
test "rust: raw string with double hashes r##\"...\"##" {
  let src = "let s = r##\"has \"# inside\"##;"
  sys_assert_tok(Language::Rust, src, "r##\"has \"# inside\"##", TokenKind::String)
}

///|
test "rust: nested block comments" {
  let src = "/* a /* b /* c */ b */ a */ fn main() {}"
  sys_assert_tok(Language::Rust, src, "/* a /* b /* c */ b */ a */", TokenKind::Comment)
  sys_assert_tok(Language::Rust, src, "fn", TokenKind::Keyword)
}

///|
test "rust: numbers with type suffixes" {
  let src = "let a = 42u64; let b = 0xdead_beefusize; let c = 0b1010_0101u8; let d = 1.5e+10f64;"
  sys_assert_tok(Language::Rust, src, "42u64", TokenKind::Number)
  sys_assert_tok(Language::Rust, src, "0xdead_beefusize", TokenKind::Number)
  sys_assert_tok(Language::Rust, src, "0b1010_0101u8", TokenKind::Number)
  sys_assert_tok(Language::Rust, src, "1.5e+10f64", TokenKind::Number)
}

///|
test "rust: namespace path std::collections::HashMap" {
  let src = "use std::collections::HashMap;"
  sys_assert_tok(Language::Rust, src, "use", TokenKind::Keyword)
  sys_assert_tok(Language::Rust, src, "std", TokenKind::Namespace)
  sys_assert_tok(Language::Rust, src, "collections", TokenKind::Namespace)
  sys_assert_tok(Language::Rust, src, "HashMap", TokenKind::Type)
}

///|
test "rust: constants true false Some None Ok Err" {
  let src = "let a = true; let b = false; let c = Some(1); let d = None; let e = Ok(0);"
  sys_assert_tok(Language::Rust, src, "true", TokenKind::Constant)
  sys_assert_tok(Language::Rust, src, "false", TokenKind::Constant)
  sys_assert_tok(Language::Rust, src, "Some", TokenKind::Constant)
  sys_assert_tok(Language::Rust, src, "None", TokenKind::Constant)
  sys_assert_tok(Language::Rust, src, "Ok", TokenKind::Constant)
}

///|
test "rust: function definitions and calls" {
  let src = "fn compute(x: i32) -> i32 { helper(x) }"
  sys_assert_tok(Language::Rust, src, "compute", TokenKind::Function)
  sys_assert_tok(Language::Rust, src, "helper", TokenKind::Function)
}

///|
test "rust: byte string literal b\"abc\"" {
  let src = "let b = b\"hello\";"
  sys_assert_tok(Language::Rust, src, "b\"hello\"", TokenKind::String)
}

// ============================================================================
// Go (10 tests)
// ============================================================================

///|
test "go: keywords" {
  let src = "package main\nimport \"fmt\"\nfunc main() { defer cleanup(); go worker() }"
  sys_assert_tok(Language::Go, src, "package", TokenKind::Keyword)
  sys_assert_tok(Language::Go, src, "import", TokenKind::Keyword)
  sys_assert_tok(Language::Go, src, "func", TokenKind::Keyword)
  sys_assert_tok(Language::Go, src, "defer", TokenKind::Keyword)
  sys_assert_tok(Language::Go, src, "go", TokenKind::Keyword)
}

///|
test "go: builtin types" {
  let src = "func f(a int64, b string, c bool, d byte, e rune) error"
  sys_assert_tok(Language::Go, src, "int64", TokenKind::Type)
  sys_assert_tok(Language::Go, src, "string", TokenKind::Type)
  sys_assert_tok(Language::Go, src, "bool", TokenKind::Type)
  sys_assert_tok(Language::Go, src, "byte", TokenKind::Type)
  sys_assert_tok(Language::Go, src, "rune", TokenKind::Type)
  sys_assert_tok(Language::Go, src, "error", TokenKind::Type)
}

///|
test "go: backtick raw string" {
  let src = "s := `raw \\n string`"
  sys_assert_tok(Language::Go, src, "`raw \\n string`", TokenKind::String)
  sys_assert_tok(Language::Go, src, ":=", TokenKind::Operator)
}

///|
test "go: rune literal" {
  let src = "r := '\\n'"
  sys_assert_tok(Language::Go, src, "'\\n'", TokenKind::String)
}

///|
test "go: channel operators and select" {
  let src = "select { case v := <-ch: ch <- v }"
  sys_assert_tok(Language::Go, src, "select", TokenKind::Keyword)
  sys_assert_tok(Language::Go, src, "case", TokenKind::Keyword)
  sys_assert_tok(Language::Go, src, "<-", TokenKind::Operator)
}

///|
test "go: constants true false nil iota" {
  let src = "const a = iota; var x = nil; var ok = true"
  sys_assert_tok(Language::Go, src, "iota", TokenKind::Constant)
  sys_assert_tok(Language::Go, src, "nil", TokenKind::Constant)
  sys_assert_tok(Language::Go, src, "true", TokenKind::Constant)
}

///|
test "go: comments" {
  let src = "// line\n/* block */ x := 1"
  sys_assert_tok(Language::Go, src, "// line", TokenKind::Comment)
  sys_assert_tok(Language::Go, src, "/* block */", TokenKind::Comment)
}

///|
test "go: numbers hex underscore imaginary" {
  let src = "x := 0xFF_00 + 1_000 + 3.14i"
  sys_assert_tok(Language::Go, src, "0xFF_00", TokenKind::Number)
  sys_assert_tok(Language::Go, src, "1_000", TokenKind::Number)
  sys_assert_tok(Language::Go, src, "3.14i", TokenKind::Number)
}

///|
test "go: function call" {
  let src = "fmt.Println(\"hello\")"
  sys_assert_tok(Language::Go, src, "Println", TokenKind::Function)
  sys_assert_tok(Language::Go, src, "\"hello\"", TokenKind::String)
}

///|
test "go: struct and interface" {
  let src = "type Reader interface { Read(p []byte) (int, error) }"
  sys_assert_tok(Language::Go, src, "type", TokenKind::Keyword)
  sys_assert_tok(Language::Go, src, "interface", TokenKind::Keyword)
  sys_assert_tok(Language::Go, src, "Read", TokenKind::Function)
}

// ============================================================================
// C & C++ (12 tests)
// ============================================================================

///|
test "c: preprocessor directives" {
  let src = "#include <stdio.h>\n#define MAX 100\n#ifdef DEBUG"
  sys_assert_tok(Language::C, src, "#include", TokenKind::Attribute)
  sys_assert_tok(Language::C, src, "#define", TokenKind::Attribute)
  sys_assert_tok(Language::C, src, "#ifdef", TokenKind::Attribute)
}

///|
test "c: keywords and types" {
  let src = "static const unsigned int count = sizeof(size_t);"
  sys_assert_tok(Language::C, src, "static", TokenKind::Keyword)
  sys_assert_tok(Language::C, src, "const", TokenKind::Keyword)
  sys_assert_tok(Language::C, src, "sizeof", TokenKind::Keyword)
  sys_assert_tok(Language::C, src, "int", TokenKind::Type)
  sys_assert_tok(Language::C, src, "size_t", TokenKind::Type)
}

///|
test "c: numbers with suffixes 42UL 0xFFu 1.5f" {
  let src = "long a = 42UL; unsigned b = 0xFFu; float c = 1.5f; double d = 1e-9;"
  sys_assert_tok(Language::C, src, "42UL", TokenKind::Number)
  sys_assert_tok(Language::C, src, "0xFFu", TokenKind::Number)
  sys_assert_tok(Language::C, src, "1.5f", TokenKind::Number)
  sys_assert_tok(Language::C, src, "1e-9", TokenKind::Number)
}

///|
test "c: strings and char escapes" {
  let src = "char *s = \"a\\\"b\\\\c\"; char ch = '\\0';"
  sys_assert_tok(Language::C, src, "\"a\\\"b\\\\c\"", TokenKind::String)
  sys_assert_tok(Language::C, src, "'\\0'", TokenKind::String)
}

///|
test "c: comments and NULL" {
  let src = "/* doc */ void *p = NULL; // end"
  sys_assert_tok(Language::C, src, "/* doc */", TokenKind::Comment)
  sys_assert_tok(Language::C, src, "NULL", TokenKind::Constant)
  sys_assert_tok(Language::C, src, "// end", TokenKind::Comment)
}

///|
test "c: function call and pointer arrow" {
  let src = "printf(\"%d\", node->value);"
  sys_assert_tok(Language::C, src, "printf", TokenKind::Function)
  sys_assert_tok(Language::C, src, "->", TokenKind::Operator)
}

///|
test "cpp: keywords template constexpr noexcept nullptr" {
  let src = "template<typename T> constexpr T* empty() noexcept { return nullptr; }"
  sys_assert_tok(Language::Cpp, src, "template", TokenKind::Keyword)
  sys_assert_tok(Language::Cpp, src, "typename", TokenKind::Keyword)
  sys_assert_tok(Language::Cpp, src, "constexpr", TokenKind::Keyword)
  sys_assert_tok(Language::Cpp, src, "noexcept", TokenKind::Keyword)
  sys_assert_tok(Language::Cpp, src, "nullptr", TokenKind::Constant)
}

///|
test "cpp: namespace std::vector" {
  let src = "std::vector<int> items;"
  sys_assert_tok(Language::Cpp, src, "std", TokenKind::Namespace)
  sys_assert_tok(Language::Cpp, src, "::", TokenKind::Operator)
  sys_assert_tok(Language::Cpp, src, "int", TokenKind::Type)
}

///|
test "cpp: class override virtual public" {
  let src = "class Derived : public Base { public: virtual void draw() override; };"
  sys_assert_tok(Language::Cpp, src, "class", TokenKind::Keyword)
  sys_assert_tok(Language::Cpp, src, "public", TokenKind::Keyword)
  sys_assert_tok(Language::Cpp, src, "virtual", TokenKind::Keyword)
  sys_assert_tok(Language::Cpp, src, "override", TokenKind::Keyword)
  sys_assert_tok(Language::Cpp, src, "draw", TokenKind::Function)
}

///|
test "cpp: attributes [[nodiscard]]" {
  let src = "[[nodiscard]] int compute(int x);"
  sys_assert_tok(Language::Cpp, src, "[[nodiscard]]", TokenKind::Attribute)
  sys_assert_tok(Language::Cpp, src, "compute", TokenKind::Function)
}

///|
test "cpp: stream operators << >>" {
  let src = "std::cout << 42 << std::endl;"
  sys_assert_tok(Language::Cpp, src, "std", TokenKind::Namespace)
  sys_assert_tok(Language::Cpp, src, "<<", TokenKind::Operator)
  sys_assert_tok(Language::Cpp, src, "42", TokenKind::Number)
}

///|
test "cpp: digit separators 1'000'000" {
  let src = "auto n = 1'000'000ULL;"
  sys_assert_tok(Language::Cpp, src, "auto", TokenKind::Keyword)
  sys_assert_tok(Language::Cpp, src, "1'000'000ULL", TokenKind::Number)
}
