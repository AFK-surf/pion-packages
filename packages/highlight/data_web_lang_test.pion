///| Data, query, markup, style, diff, and markdown tokenizer tests.

///|
fn dw_has_token(
  lang : Language,
  src : String,
  text : String,
  kind : TokenKind,
) -> Bool {
  let spans = highlight(lang, src)
  let mut i = 0
  while i < spans.length() {
    let sp = spans[i]
    if token_kind_eq(sp.kind, kind) && src.slice(sp.start, sp.end) == text {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn dw_assert_tok(lang : Language, src : String, text : String, kind : TokenKind) -> Unit {
  debug_assert(
    dw_has_token(lang, src, text, kind),
    "expected token `" + text + "` with class `" + token_kind_class(kind) + "` in `" + src + "`",
  )
}

// ============================================================================
// JSON (6 tests)
// ============================================================================

///|
test "json: property key vs string value" {
  let src = "{\"name\": \"pion\"}"
  dw_assert_tok(Language::Json, src, "\"name\"", TokenKind::Property)
  dw_assert_tok(Language::Json, src, "\"pion\"", TokenKind::String)
}

///|
test "json: escaped strings" {
  let src = "{\"msg\": \"a\\\"b\\n\\u0041\"}"
  dw_assert_tok(Language::Json, src, "\"msg\"", TokenKind::Property)
  dw_assert_tok(Language::Json, src, "\"a\\\"b\\n\\u0041\"", TokenKind::String)
}

///|
test "json: numbers negative float scientific" {
  let src = "[0, -42, 3.14159, 1.5e-3]"
  dw_assert_tok(Language::Json, src, "0", TokenKind::Number)
  dw_assert_tok(Language::Json, src, "-42", TokenKind::Number)
  dw_assert_tok(Language::Json, src, "3.14159", TokenKind::Number)
  dw_assert_tok(Language::Json, src, "1.5e-3", TokenKind::Number)
}

///|
test "json: constants true false null" {
  let src = "{\"a\": true, \"b\": false, \"c\": null}"
  dw_assert_tok(Language::Json, src, "true", TokenKind::Constant)
  dw_assert_tok(Language::Json, src, "false", TokenKind::Constant)
  dw_assert_tok(Language::Json, src, "null", TokenKind::Constant)
}

///|
test "json: punctuation" {
  let src = "{\"a\": [1, 2]}"
  dw_assert_tok(Language::Json, src, "{", TokenKind::Punctuation)
  dw_assert_tok(Language::Json, src, ":", TokenKind::Punctuation)
  dw_assert_tok(Language::Json, src, "[", TokenKind::Punctuation)
  dw_assert_tok(Language::Json, src, ",", TokenKind::Punctuation)
}

///|
test "json: jsonc comments supported" {
  let src = "// comment\n{\"k\": 1}"
  dw_assert_tok(Language::Json, src, "// comment", TokenKind::Comment)
  dw_assert_tok(Language::Json, src, "\"k\"", TokenKind::Property)
}

// ============================================================================
// TOML (6 tests)
// ============================================================================

///|
test "toml: section headers [package] and [[bin]]" {
  let src = "[package]\nname = \"highlight\"\n[[bin]]\nname = \"cli\""
  dw_assert_tok(Language::Toml, src, "[package]", TokenKind::Tag)
  dw_assert_tok(Language::Toml, src, "[[bin]]", TokenKind::Tag)
}

///|
test "toml: key property and string value" {
  let src = "version = \"0.1.0\""
  dw_assert_tok(Language::Toml, src, "version", TokenKind::Property)
  dw_assert_tok(Language::Toml, src, "\"0.1.0\"", TokenKind::String)
}

///|
test "toml: multiline strings" {
  let src = "desc = \"\"\"line1\nline2\"\"\"\nlit = '''a\nb'''"
  dw_assert_tok(Language::Toml, src, "\"\"\"line1", TokenKind::String)
  dw_assert_tok(Language::Toml, src, "line2\"\"\"", TokenKind::String)
  dw_assert_tok(Language::Toml, src, "'''a", TokenKind::String)
  dw_assert_tok(Language::Toml, src, "b'''", TokenKind::String)
}

///|
test "toml: comments" {
  let src = "# header\nkey = 1 # inline"
  dw_assert_tok(Language::Toml, src, "# header", TokenKind::Comment)
  dw_assert_tok(Language::Toml, src, "# inline", TokenKind::Comment)
}

///|
test "toml: booleans and numbers" {
  let src = "ok = true\nfail = false\ncount = 1_000\nhex = 0xdead"
  dw_assert_tok(Language::Toml, src, "true", TokenKind::Constant)
  dw_assert_tok(Language::Toml, src, "false", TokenKind::Constant)
  dw_assert_tok(Language::Toml, src, "1_000", TokenKind::Number)
  dw_assert_tok(Language::Toml, src, "0xdead", TokenKind::Number)
}

///|
test "toml: dotted keys" {
  let src = "a.b = 42"
  dw_assert_tok(Language::Toml, src, "a", TokenKind::Property)
  dw_assert_tok(Language::Toml, src, "b", TokenKind::Property)
  dw_assert_tok(Language::Toml, src, "42", TokenKind::Number)
}

// ============================================================================
// YAML (6 tests)
// ============================================================================

///|
test "yaml: mapping keys" {
  let src = "name: highlight\nversion: 1"
  dw_assert_tok(Language::Yaml, src, "name", TokenKind::Property)
  dw_assert_tok(Language::Yaml, src, "version", TokenKind::Property)
  dw_assert_tok(Language::Yaml, src, "1", TokenKind::Number)
}

///|
test "yaml: comments" {
  let src = "# top comment\nkey: val # trailing"
  dw_assert_tok(Language::Yaml, src, "# top comment", TokenKind::Comment)
  dw_assert_tok(Language::Yaml, src, "# trailing", TokenKind::Comment)
}

///|
test "yaml: booleans and null" {
  let src = "a: true\nb: false\nc: null"
  dw_assert_tok(Language::Yaml, src, "true", TokenKind::Constant)
  dw_assert_tok(Language::Yaml, src, "false", TokenKind::Constant)
  dw_assert_tok(Language::Yaml, src, "null", TokenKind::Constant)
}

///|
test "yaml: quoted strings and numbers" {
  let src = "s: \"hello\"\nt: 'world'\nn: 3.14"
  dw_assert_tok(Language::Yaml, src, "\"hello\"", TokenKind::String)
  dw_assert_tok(Language::Yaml, src, "'world'", TokenKind::String)
  dw_assert_tok(Language::Yaml, src, "3.14", TokenKind::Number)
}

///|
test "yaml: anchors and aliases" {
  let src = "base: &defaults\n  port: 8080\nprod: *defaults"
  dw_assert_tok(Language::Yaml, src, "&defaults", TokenKind::Attribute)
  dw_assert_tok(Language::Yaml, src, "*defaults", TokenKind::Attribute)
  dw_assert_tok(Language::Yaml, src, "8080", TokenKind::Number)
}

///|
test "yaml: document separator and block scalar" {
  let src = "---\nscript: |\n  echo hi\n  echo bye"
  dw_assert_tok(Language::Yaml, src, "---", TokenKind::Punctuation)
  dw_assert_tok(Language::Yaml, src, "script", TokenKind::Property)
  dw_assert_tok(Language::Yaml, src, "  echo hi", TokenKind::String)
  dw_assert_tok(Language::Yaml, src, "  echo bye", TokenKind::String)
}

// ============================================================================
// SQL (6 tests)
// ============================================================================

///|
test "sql: uppercase keywords" {
  let src = "SELECT id, name FROM users WHERE active = TRUE ORDER BY id DESC"
  dw_assert_tok(Language::Sql, src, "SELECT", TokenKind::Keyword)
  dw_assert_tok(Language::Sql, src, "FROM", TokenKind::Keyword)
  dw_assert_tok(Language::Sql, src, "WHERE", TokenKind::Keyword)
  dw_assert_tok(Language::Sql, src, "ORDER", TokenKind::Keyword)
  dw_assert_tok(Language::Sql, src, "BY", TokenKind::Keyword)
  dw_assert_tok(Language::Sql, src, "DESC", TokenKind::Keyword)
}

///|
test "sql: lowercase keywords case-insensitive" {
  let src = "select a from t inner join u on t.id = u.id group by a"
  dw_assert_tok(Language::Sql, src, "select", TokenKind::Keyword)
  dw_assert_tok(Language::Sql, src, "from", TokenKind::Keyword)
  dw_assert_tok(Language::Sql, src, "inner", TokenKind::Keyword)
  dw_assert_tok(Language::Sql, src, "join", TokenKind::Keyword)
  dw_assert_tok(Language::Sql, src, "group", TokenKind::Keyword)
}

///|
test "sql: types" {
  let src = "CREATE TABLE items (id INT, title VARCHAR(64), created TIMESTAMP, ok BOOLEAN)"
  dw_assert_tok(Language::Sql, src, "INT", TokenKind::Type)
  dw_assert_tok(Language::Sql, src, "VARCHAR", TokenKind::Type)
  dw_assert_tok(Language::Sql, src, "TIMESTAMP", TokenKind::Type)
  dw_assert_tok(Language::Sql, src, "BOOLEAN", TokenKind::Type)
}

///|
test "sql: line and block comments" {
  let src = "-- line comment\n/* block */ SELECT 1"
  dw_assert_tok(Language::Sql, src, "-- line comment", TokenKind::Comment)
  dw_assert_tok(Language::Sql, src, "/* block */", TokenKind::Comment)
}

///|
test "sql: single-quoted string with doubled quote escape" {
  let src = "SELECT 'O''Brien' AS name"
  dw_assert_tok(Language::Sql, src, "'O''Brien'", TokenKind::String)
  dw_assert_tok(Language::Sql, src, "AS", TokenKind::Keyword)
}

///|
test "sql: constants and numbers" {
  let src = "SELECT NULL, TRUE, FALSE, 42, 3.14"
  dw_assert_tok(Language::Sql, src, "NULL", TokenKind::Constant)
  dw_assert_tok(Language::Sql, src, "TRUE", TokenKind::Constant)
  dw_assert_tok(Language::Sql, src, "FALSE", TokenKind::Constant)
  dw_assert_tok(Language::Sql, src, "42", TokenKind::Number)
  dw_assert_tok(Language::Sql, src, "3.14", TokenKind::Number)
}

// ============================================================================
// HTML (8 tests)
// ============================================================================

///|
test "html: opening and closing tags" {
  let src = "<div>hello</div>"
  dw_assert_tok(Language::Html, src, "div", TokenKind::Tag)
  dw_assert_tok(Language::Html, src, "<", TokenKind::Punctuation)
  dw_assert_tok(Language::Html, src, "</", TokenKind::Punctuation)
  dw_assert_tok(Language::Html, src, ">", TokenKind::Punctuation)
}

///|
test "html: attributes and string values" {
  let src = "<input type=\"text\" data-id='42' disabled />"
  dw_assert_tok(Language::Html, src, "input", TokenKind::Tag)
  dw_assert_tok(Language::Html, src, "type", TokenKind::Attribute)
  dw_assert_tok(Language::Html, src, "\"text\"", TokenKind::String)
  dw_assert_tok(Language::Html, src, "data-id", TokenKind::Attribute)
  dw_assert_tok(Language::Html, src, "'42'", TokenKind::String)
  dw_assert_tok(Language::Html, src, "disabled", TokenKind::Attribute)
}

///|
test "html: single-line comment" {
  let src = "<!-- hello --><div></div>"
  dw_assert_tok(Language::Html, src, "<!-- hello -->", TokenKind::Comment)
  dw_assert_tok(Language::Html, src, "div", TokenKind::Tag)
}

///|
test "html: multiline comment" {
  let src = "<!-- line1\nline2 -->\n<p>ok</p>"
  dw_assert_tok(Language::Html, src, "<!-- line1", TokenKind::Comment)
  dw_assert_tok(Language::Html, src, "line2 -->", TokenKind::Comment)
  dw_assert_tok(Language::Html, src, "p", TokenKind::Tag)
}

///|
test "html: doctype" {
  let src = "<!DOCTYPE html><html></html>"
  dw_assert_tok(Language::Html, src, "<!DOCTYPE html>", TokenKind::Comment)
  dw_assert_tok(Language::Html, src, "html", TokenKind::Tag)
}

///|
test "html: embedded script highlights JavaScript" {
  let src = "<script>\nconst x = 42;\n</script>"
  dw_assert_tok(Language::Html, src, "script", TokenKind::Tag)
  dw_assert_tok(Language::Html, src, "const", TokenKind::Keyword)
  dw_assert_tok(Language::Html, src, "42", TokenKind::Number)
}

///|
test "html: embedded style highlights CSS" {
  let src = "<style>\n.btn { color: #ff0; }\n</style>"
  dw_assert_tok(Language::Html, src, "style", TokenKind::Tag)
  dw_assert_tok(Language::Html, src, "color", TokenKind::Property)
  dw_assert_tok(Language::Html, src, "#ff0", TokenKind::Number)
}

///|
test "html: multiline open tag attributes" {
  let src = "<button\n  class=\"primary\"\n  type=\"submit\">Go</button>"
  dw_assert_tok(Language::Html, src, "button", TokenKind::Tag)
  dw_assert_tok(Language::Html, src, "class", TokenKind::Attribute)
  dw_assert_tok(Language::Html, src, "\"primary\"", TokenKind::String)
  dw_assert_tok(Language::Html, src, "type", TokenKind::Attribute)
}

// ============================================================================
// CSS (6 tests)
// ============================================================================

///|
test "css: selectors class id and pseudo" {
  let src = ".btn, #main, a:hover { display: flex; }"
  dw_assert_tok(Language::Css, src, ".btn", TokenKind::Tag)
  dw_assert_tok(Language::Css, src, "#main", TokenKind::Tag)
  dw_assert_tok(Language::Css, src, "display", TokenKind::Property)
}

///|
test "css: at-rules @media @keyframes" {
  let src = "@media (min-width: 768px) { .a { width: 100%; } }"
  dw_assert_tok(Language::Css, src, "@media", TokenKind::Keyword)
  dw_assert_tok(Language::Css, src, "min-width", TokenKind::Property)
  dw_assert_tok(Language::Css, src, "768px", TokenKind::Number)
  dw_assert_tok(Language::Css, src, "100%", TokenKind::Number)
}

///|
test "css: hex colors and numeric units" {
  let src = "body { background-color: #ff00aa; font-size: 1.5rem; margin: 16px; }"
  dw_assert_tok(Language::Css, src, "background-color", TokenKind::Property)
  dw_assert_tok(Language::Css, src, "#ff00aa", TokenKind::Number)
  dw_assert_tok(Language::Css, src, "font-size", TokenKind::Property)
  dw_assert_tok(Language::Css, src, "1.5rem", TokenKind::Number)
  dw_assert_tok(Language::Css, src, "16px", TokenKind::Number)
}

///|
test "css: comments" {
  let src = "/* reset */\n* { margin: 0; }"
  dw_assert_tok(Language::Css, src, "/* reset */", TokenKind::Comment)
  dw_assert_tok(Language::Css, src, "margin", TokenKind::Property)
  dw_assert_tok(Language::Css, src, "0", TokenKind::Number)
}

///|
test "css: !important and function calls" {
  let src = "p { color: rgb(255, 0, 128) !important; }"
  dw_assert_tok(Language::Css, src, "rgb", TokenKind::Function)
  dw_assert_tok(Language::Css, src, "!important", TokenKind::Keyword)
}

///|
test "css: strings in content property" {
  let src = ".icon::before { content: \"\\2713\"; }"
  dw_assert_tok(Language::Css, src, "content", TokenKind::Property)
  dw_assert_tok(Language::Css, src, "\"\\2713\"", TokenKind::String)
}

// ============================================================================
// Diff (6 tests)
// ============================================================================

///|
test "diff: git header" {
  let src = "diff --git a/foo.rs b/foo.rs\nindex 123..456 100644"
  dw_assert_tok(Language::Diff, src, "diff --git a/foo.rs b/foo.rs", TokenKind::DiffHeader)
  dw_assert_tok(Language::Diff, src, "index 123..456 100644", TokenKind::DiffHeader)
}

///|
test "diff: --- and +++ file headers" {
  let src = "--- a/foo.rs\n+++ b/foo.rs"
  dw_assert_tok(Language::Diff, src, "--- a/foo.rs", TokenKind::DiffHeader)
  dw_assert_tok(Language::Diff, src, "+++ b/foo.rs", TokenKind::DiffHeader)
}

///|
test "diff: hunk header @@ ... @@" {
  let src = "@@ -10,4 +10,5 @@ fn main()"
  dw_assert_tok(Language::Diff, src, "@@ -10,4 +10,5 @@ fn main()", TokenKind::DiffHeader)
}

///|
test "diff: added line" {
  let src = "+let x = 42;"
  dw_assert_tok(Language::Diff, src, "+let x = 42;", TokenKind::DiffAdd)
}

///|
test "diff: deleted line" {
  let src = "-let x = 0;"
  dw_assert_tok(Language::Diff, src, "-let x = 0;", TokenKind::DiffDel)
}

///|
test "diff: context line is Plain" {
  let src = " let unchanged = 1;"
  dw_assert_tok(Language::Diff, src, " let unchanged = 1;", TokenKind::Plain)
}

// ============================================================================
// Markdown (4 tests)
// ============================================================================

///|
test "markdown: headings" {
  let src = "# Title\n## Subtitle\nBody"
  dw_assert_tok(Language::Markdown, src, "# Title", TokenKind::Keyword)
  dw_assert_tok(Language::Markdown, src, "## Subtitle", TokenKind::Keyword)
}

///|
test "markdown: inline code" {
  let src = "Use `highlight_line` here."
  dw_assert_tok(Language::Markdown, src, "`highlight_line`", TokenKind::String)
}

///|
test "markdown: fenced code block" {
  let src = "```rust\nlet x = 1;\n```\nafter"
  dw_assert_tok(Language::Markdown, src, "```rust", TokenKind::Punctuation)
  dw_assert_tok(Language::Markdown, src, "let x = 1;", TokenKind::String)
  dw_assert_tok(Language::Markdown, src, "```", TokenKind::Punctuation)
}

///|
test "markdown: blockquote and link" {
  let src = "> quote\n[pion](https://example.com)"
  dw_assert_tok(Language::Markdown, src, "> quote", TokenKind::Comment)
  dw_assert_tok(Language::Markdown, src, "https://example.com", TokenKind::String)
}
