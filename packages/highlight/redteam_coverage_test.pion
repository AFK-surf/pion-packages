///| Additional unit tests: UTF-8 boundary invariants across all languages,
///| newly added languages (Java, Kotlin, Swift, C#, PHP, Ruby, Dockerfile),
///| and new rendering APIs (`highlight_line_html`, `highlight_html_lines`, `highlight_ansi`).

///| Assert every span boundary falls on a valid UTF-8 character boundary and reconstructs `src`.
fn cov_assert_utf8_and_roundtrip(lang : Language, src : String, label : String) -> Unit {
  let spans = highlight(lang, src)
  let n = src.length()
  let mut cursor = 0
  let rebuilt = StringBuilder::new()
  let mut i = 0
  while i < spans.length() {
    let sp = spans[i]
    debug_assert(sp.start == cursor, label + ": gap or overlap")
    debug_assert(sp.end > sp.start, label + ": empty span")
    debug_assert(sp.end <= n, label + ": end out of bounds")
    debug_assert(
      sp.start >= n || (src[sp.start] & 0xC0) != 0x80,
      label + ": span start splits UTF-8 sequence at " + sp.start.to_string(),
    )
    debug_assert(
      sp.end >= n || (src[sp.end] & 0xC0) != 0x80,
      label + ": span end splits UTF-8 sequence at " + sp.end.to_string(),
    )
    rebuilt.write_string(src.slice(sp.start, sp.end))
    cursor = sp.end
    i = i + 1
  }
  debug_assert(cursor == n, label + ": did not cover full input")
  debug_assert(rebuilt.to_string() == src, label + ": roundtrip mismatch")
}

///|
fn cov_has_token(lang : Language, src : String, text : String, kind : TokenKind) -> Bool {
  let spans = highlight(lang, src)
  let mut i = 0
  while i < spans.length() {
    let sp = spans[i]
    if token_kind_eq(sp.kind, kind) && src.slice(sp.start, sp.end) == text {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn cov_assert_tok(lang : Language, src : String, text : String, kind : TokenKind) -> Unit {
  debug_assert(
    cov_has_token(lang, src, text, kind),
    "expected `" + text + "` as `" + token_kind_class(kind) + "` in `" + src + "`",
  )
}

///|
fn cov_assert_resolves(name : String, expected : Language) -> Unit {
  match resolve_language(name) {
    Some(got) => debug_assert(language_eq(got, expected), "resolve mismatch for " + name)
    None => debug_assert(false, "resolve returned None for " + name)
  }
}

// ============================================================================
// UTF-8 boundary invariant across ALL 24 languages with hostile inputs
// ============================================================================

///|
test "invariant utf8: all 24 languages preserve UTF-8 boundaries on hostile inputs" {
  let langs : Array[Language] = [
    Language::Pion,
    Language::Rust,
    Language::Go,
    Language::TypeScript,
    Language::JavaScript,
    Language::Python,
    Language::C,
    Language::Cpp,
    Language::Json,
    Language::Toml,
    Language::Yaml,
    Language::Sql,
    Language::Shell,
    Language::Html,
    Language::Css,
    Language::Diff,
    Language::Markdown,
    Language::Java,
    Language::Kotlin,
    Language::Swift,
    Language::CSharp,
    Language::Php,
    Language::Ruby,
    Language::Dockerfile,
  ]
  let inputs : Array[String] = [
    "[[\u{e9}\n",
    "x [[\u{1F600}",
    "\"a\\\u{e9}\" '\\\u{1F600}' `\\\u{4e2d}`",
    "R\"d(你好\u{1F600})d\" // 注释\rlet x = \"🚀\";",
    "<!-- \u{4e2d} --> <div a=\u{e9}>&amp; \u{1F600}</div>",
    "cat <<\u{e9}\n你好\n\u{e9}\n",
    "**粗体** _斜体_ [链接](https://例.jp/\u{1F600})\n- 列表\n",
    "$$你好\u{1F600}$$ E'\\\u{e9}'",
  ]
  let mut li = 0
  while li < langs.length() {
    let lang = langs[li]
    let mut ii = 0
    while ii < inputs.length() {
      let src = inputs[ii]
      cov_assert_utf8_and_roundtrip(lang, src, language_name(lang) + "#" + ii.to_string())
      ii = ii + 1
    }
    li = li + 1
  }
}

// ============================================================================
// New languages: Java, Kotlin, Swift, C#, PHP, Ruby, Dockerfile
// ============================================================================

///|
test "resolve: new high-frequency languages and aliases" {
  cov_assert_resolves("java", Language::Java)
  cov_assert_resolves("Java", Language::Java)
  cov_assert_resolves("kotlin", Language::Kotlin)
  cov_assert_resolves("kt", Language::Kotlin)
  cov_assert_resolves("kts", Language::Kotlin)
  cov_assert_resolves("swift", Language::Swift)
  cov_assert_resolves("csharp", Language::CSharp)
  cov_assert_resolves("cs", Language::CSharp)
  cov_assert_resolves("c#", Language::CSharp)
  cov_assert_resolves("php", Language::Php)
  cov_assert_resolves("ruby", Language::Ruby)
  cov_assert_resolves("rb", Language::Ruby)
  cov_assert_resolves("dockerfile", Language::Dockerfile)
  cov_assert_resolves("docker", Language::Dockerfile)
}

///|
test "java: keywords types annotations strings numbers" {
  let src = "@Override\npublic final class App {\n  public static void main(String[] args) {\n    int n = 42;\n    System.out.println(\"hi\");\n  }\n}\n"
  cov_assert_tok(Language::Java, src, "@Override", TokenKind::Attribute)
  cov_assert_tok(Language::Java, src, "public", TokenKind::Keyword)
  cov_assert_tok(Language::Java, src, "class", TokenKind::Keyword)
  cov_assert_tok(Language::Java, src, "void", TokenKind::Type)
  cov_assert_tok(Language::Java, src, "int", TokenKind::Type)
  cov_assert_tok(Language::Java, src, "42", TokenKind::Number)
  cov_assert_tok(Language::Java, src, "println", TokenKind::Function)
  cov_assert_tok(Language::Java, src, "\"hi\"", TokenKind::String)
  inv_assert_incremental_equiv(Language::Java, src, "java")
}

///|
test "kotlin: data class fun val annotations" {
  let src = "@JvmStatic\ndata class User(val name: String, val age: Int)\nfun greet(u: User) = println(u.name)\n"
  cov_assert_tok(Language::Kotlin, src, "@JvmStatic", TokenKind::Attribute)
  cov_assert_tok(Language::Kotlin, src, "data", TokenKind::Keyword)
  cov_assert_tok(Language::Kotlin, src, "class", TokenKind::Keyword)
  cov_assert_tok(Language::Kotlin, src, "fun", TokenKind::Keyword)
  cov_assert_tok(Language::Kotlin, src, "greet", TokenKind::Function)
  cov_assert_tok(Language::Kotlin, src, "User", TokenKind::Type)
  inv_assert_incremental_equiv(Language::Kotlin, src, "kotlin")
}

///|
test "swift: struct func guard let async await" {
  let src = "@MainActor\nstruct Model { let id: Int }\nfunc load() async -> Model? { guard true else { return nil }; return nil }\n"
  cov_assert_tok(Language::Swift, src, "@MainActor", TokenKind::Attribute)
  cov_assert_tok(Language::Swift, src, "struct", TokenKind::Keyword)
  cov_assert_tok(Language::Swift, src, "func", TokenKind::Keyword)
  cov_assert_tok(Language::Swift, src, "load", TokenKind::Function)
  cov_assert_tok(Language::Swift, src, "guard", TokenKind::Keyword)
  cov_assert_tok(Language::Swift, src, "nil", TokenKind::Constant)
  inv_assert_incremental_equiv(Language::Swift, src, "swift")
}

///|
test "csharp: namespace class async await string int" {
  let src = "using System;\nnamespace Demo {\n  public class Svc {\n    public async void Run(string s, int n) { return; }\n  }\n}\n"
  cov_assert_tok(Language::CSharp, src, "using", TokenKind::Keyword)
  cov_assert_tok(Language::CSharp, src, "namespace", TokenKind::Keyword)
  cov_assert_tok(Language::CSharp, src, "async", TokenKind::Keyword)
  cov_assert_tok(Language::CSharp, src, "string", TokenKind::Type)
  cov_assert_tok(Language::CSharp, src, "int", TokenKind::Type)
  cov_assert_tok(Language::CSharp, src, "Run", TokenKind::Function)
  inv_assert_incremental_equiv(Language::CSharp, src, "csharp")
}

///|
test "php: tags variables functions keywords" {
  let src = "<?php\nfunction greet($name) {\n  echo \"hi \" . $name;\n  return true;\n}\n?>\n"
  cov_assert_tok(Language::Php, src, "<?php", TokenKind::Tag)
  cov_assert_tok(Language::Php, src, "function", TokenKind::Keyword)
  cov_assert_tok(Language::Php, src, "greet", TokenKind::Function)
  cov_assert_tok(Language::Php, src, "$name", TokenKind::Variable)
  cov_assert_tok(Language::Php, src, "echo", TokenKind::Keyword)
  cov_assert_tok(Language::Php, src, "true", TokenKind::Constant)
  cov_assert_tok(Language::Php, src, "?>", TokenKind::Tag)
  inv_assert_incremental_equiv(Language::Php, src, "php")
}

///|
test "ruby: def symbols ivars comments" {
  let src = "# greeting\nclass Greeter\n  def hello(name)\n    @tag = :ok\n    puts \"hi\"\n  end\nend\n"
  cov_assert_tok(Language::Ruby, src, "# greeting", TokenKind::Comment)
  cov_assert_tok(Language::Ruby, src, "class", TokenKind::Keyword)
  cov_assert_tok(Language::Ruby, src, "def", TokenKind::Keyword)
  cov_assert_tok(Language::Ruby, src, "hello", TokenKind::Function)
  cov_assert_tok(Language::Ruby, src, "@tag", TokenKind::Variable)
  cov_assert_tok(Language::Ruby, src, ":ok", TokenKind::Constant)
  cov_assert_tok(Language::Ruby, src, "end", TokenKind::Keyword)
  inv_assert_incremental_equiv(Language::Ruby, src, "ruby")
}

///|
test "dockerfile: instructions comments strings env vars" {
  let src = "# base image\nFROM alpine:3.20\nENV APP_HOME=\"/app\"\nRUN echo $APP_HOME\nCMD [\"/app/run\"]\n"
  cov_assert_tok(Language::Dockerfile, src, "# base image", TokenKind::Comment)
  cov_assert_tok(Language::Dockerfile, src, "FROM", TokenKind::Keyword)
  cov_assert_tok(Language::Dockerfile, src, "ENV", TokenKind::Keyword)
  cov_assert_tok(Language::Dockerfile, src, "\"/app\"", TokenKind::String)
  cov_assert_tok(Language::Dockerfile, src, "RUN", TokenKind::Keyword)
  cov_assert_tok(Language::Dockerfile, src, "$APP_HOME", TokenKind::Variable)
  cov_assert_tok(Language::Dockerfile, src, "CMD", TokenKind::Keyword)
  inv_assert_incremental_equiv(Language::Dockerfile, src, "dockerfile")
}

// ============================================================================
// New rendering APIs: highlight_line_html, highlight_html_lines, highlight_ansi
// ============================================================================

///|
test "highlight_line_html: incremental multiline matches highlight_html" {
  let src = "<script>\n/* multi\nline */ let x = 1;\n</script>"
  let lines = src.split("\n")
  let sb = StringBuilder::new()
  let mut st = LineState::initial()
  let mut i = 0
  while i < lines.length() {
    if i > 0 {
      sb.write_string("\n")
    }
    let (h, nst) = highlight_line_html(Language::Html, st, lines[i])
    sb.write_string(h)
    st = nst
    i = i + 1
  }
  debug_assert(sb.to_string() == highlight_html(Language::Html, src), "incremental HTML must match full HTML")
}

///|
test "highlight_html_lines: wraps lines and optional line numbers with XSS escaping" {
  let src = "let a = \"<script>\";\nlet b = 2;"
  let with_nums = highlight_html_lines(Language::Rust, src, true)
  debug_assert(with_nums.contains("<span class=\"hl-line\"><span class=\"hl-line-num\">1</span>"), "line 1 wrapper")
  debug_assert(with_nums.contains("<span class=\"hl-line\"><span class=\"hl-line-num\">2</span>"), "line 2 wrapper")
  debug_assert(!with_nums.contains("<script>"), "must escape script tag")
  debug_assert(with_nums.contains("&lt;script&gt;"), "escaped script tag")
  let no_nums = highlight_html_lines(Language::Rust, src, false)
  debug_assert(!no_nums.contains("hl-line-num"), "no line numbers when disabled")
}

///|
test "highlight_ansi: emits ANSI codes and preserves plain text" {
  let ansi = highlight_ansi(Language::Rust, "let x = 42;")
  debug_assert(ansi.contains("\u{1b}[35mlet\u{1b}[0m"), "keyword ANSI")
  debug_assert(ansi.contains("\u{1b}[36m42\u{1b}[0m"), "number ANSI")
  debug_assert(highlight_ansi(Language::Rust, "") == "", "empty ANSI")
}
