///| Red-team audit of `highlight`: every test asserts the behaviour of the real language lexer (and of
///| prismjs 1.30 / shiki 3.23 TextMate grammars where they agree). A FAILING test is a reproducible defect.
///| Severity tag in each name: P0 = state corruption that mis-highlights following code,
///| P1 = wrong class for a common construct / encoding defect, P2 = missing granularity vs prism/shiki.
import "highlight"

///| Byte offset of the `nth` (0-based) occurrence of `needle` in `src`, or -1.
fn rt_find(src : String, needle : String, nth : Int) -> Int {
  let n = src.length()
  let m = needle.length()
  let mut seen = 0
  let mut i = 0
  while i + m <= n {
    if src.slice(i, i + m) == needle {
      if seen == nth {
        return i
      }
      seen = seen + 1
    }
    i = i + 1
  }
  -1
}

///| Span covering byte `off`: (class, text) for diagnostics.
fn rt_span_at(lang : highlight::Language, src : String, off : Int) -> (highlight::TokenKind, String) {
  let spans = highlight::highlight(lang, src)
  let mut i = 0
  while i < spans.length() {
    let sp = spans[i]
    if sp.start <= off && off < sp.end {
      return (sp.kind, src.slice(sp.start, sp.end))
    }
    i = i + 1
  }
  (highlight::TokenKind::Plain, "<no span>")
}

///| Assert the byte at the `nth` occurrence of `needle` is highlighted as `want`.
fn rt_expect(
  lang : highlight::Language,
  src : String,
  needle : String,
  nth : Int,
  want : highlight::TokenKind,
) -> Unit {
  let off = rt_find(src, needle, nth)
  debug_assert(off >= 0, "test bug: needle `" + needle + "` not found")
  let (got, text) = rt_span_at(lang, src, off)
  debug_assert(
    highlight::token_kind_eq(got, want),
    "`" + needle + "` (occurrence " + nth.to_string() + ") expected " + highlight::token_kind_class(want) +
    " but got " + kind_name(got) + " via span `" + text + "` in `" + src + "`",
  )
}

///| Assert the byte at `needle` is NOT `bad`.
fn rt_expect_not(
  lang : highlight::Language,
  src : String,
  needle : String,
  nth : Int,
  bad : highlight::TokenKind,
) -> Unit {
  let off = rt_find(src, needle, nth)
  debug_assert(off >= 0, "test bug: needle `" + needle + "` not found")
  let (got, text) = rt_span_at(lang, src, off)
  debug_assert(
    !highlight::token_kind_eq(got, bad),
    "`" + needle + "` must not be " + kind_name(bad) + " (span `" + text + "`) in `" + src + "`",
  )
}

///| Resolve an advertised alias (aborts the test if the alias is not advertised any more).
fn rt_lang(name : String) -> highlight::Language {
  match highlight::resolve_language(name) {
    Some(l) => l
    None => {
      debug_assert(false, "alias `" + name + "` no longer resolves")
      highlight::Language::JavaScript
    }
  }
}

///|
fn kind_name(k : highlight::TokenKind) -> String {
  let c = highlight::token_kind_class(k)
  if c.length() == 0 {
    "plain"
  } else {
    c
  }
}

// ============================================================================
// P0 — lexer state corruption: one construct swallows the code after it
// ============================================================================

///|
test "P0 js: regex literal containing a double quote swallows the rest of the line" {
  // ECMAScript: `/a"b/` is a RegularExpressionLiteral (prism `regex`, shiki `string.regexp`).
  let src = "const re = /a\"b/g; const n = 1;"
  rt_expect(highlight::Language::JavaScript, src, "const", 1, highlight::TokenKind::Keyword)
  rt_expect(highlight::Language::JavaScript, src, "1", 0, highlight::TokenKind::Number)
}

///|
test "P0 js: regex literal containing a single quote swallows the rest of the line" {
  let src = "if (/'/.test(s)) x = 42;"
  rt_expect(highlight::Language::JavaScript, src, "42", 0, highlight::TokenKind::Number)
}

///|
test "P1 js: regex literal is not highlighted as a literal at all" {
  let src = "const re = /^\\d+$/;"
  rt_expect_not(highlight::Language::JavaScript, src, "d+", 0, highlight::TokenKind::Plain)
}

///|
test "P0 ts: two-level nested template literal corrupts state for the following lines" {
  // `a ${ `b ${1}` } d` is one template (one level deeper than the shipped tests); line 2 is ordinary code.
  let src = "const t = `a ${ `b ${1}` } d`;\nconst after = 2;\n"
  rt_expect(highlight::Language::TypeScript, src, " d", 0, highlight::TokenKind::String)
  rt_expect(highlight::Language::TypeScript, src, "const", 1, highlight::TokenKind::Keyword)
  rt_expect(highlight::Language::TypeScript, src, "2", 0, highlight::TokenKind::Number)
}

///|
test "P0 tsx: apostrophe in JSX text opens a string that eats the line" {
  // `tsx`/`jsx` are advertised aliases; JSX text is not a JS string (prism `tsx`, shiki `tsx`).
  let src = "const el = <div>it's {name}</div>; const k = 1;"
  let lang = rt_lang("tsx")
  rt_expect(lang, src, "const", 1, highlight::TokenKind::Keyword)
  rt_expect_not(lang, src, "'s {name}", 0, highlight::TokenKind::String)
}

///|
test "P1 jsx: JSX tags are not highlighted as tags" {
  let src = "return <Button onClick={go}>Go</Button>;"
  let lang = rt_lang("jsx")
  rt_expect(lang, src, "Button", 0, highlight::TokenKind::Tag)
}

///|
test "P0 html: multi-line block comment inside <script> loses state on the next line" {
  let src = "<script>\n/* a\nb */ let x = 1;\n</script>\n"
  rt_expect(highlight::Language::Html, src, "b */", 0, highlight::TokenKind::Comment)
  rt_expect(highlight::Language::Html, src, "let", 0, highlight::TokenKind::Keyword)
}

///|
test "P0 html: multi-line template literal inside <script> inverts code/string on the next line" {
  let src = "<script>\nlet t = `a\nb`; let y = 2;\n</script>\n"
  rt_expect(highlight::Language::Html, src, "b`", 0, highlight::TokenKind::String)
  rt_expect(highlight::Language::Html, src, "let", 1, highlight::TokenKind::Keyword)
}

///|
test "P0 cpp: raw string R\"d(...)d\" with inner quotes swallows the rest of the line" {
  let src = "auto s = R\"d(say \"hi\")d\"; int z = 1;"
  rt_expect(highlight::Language::Cpp, src, "hi", 0, highlight::TokenKind::String)
  rt_expect(highlight::Language::Cpp, src, "int", 0, highlight::TokenKind::Type)
  rt_expect(highlight::Language::Cpp, src, "1", 0, highlight::TokenKind::Number)
}

///|
test "P0 c: string line continuation flips string/code on the next line" {
  // C11 5.1.1.2 phase 2: backslash-newline splices lines, so `b"` closes the literal.
  let src = "char *s = \"a\\\nb\"; int y = 2;\n"
  rt_expect(highlight::Language::C, src, "b\"", 0, highlight::TokenKind::String)
  rt_expect(highlight::Language::C, src, "int", 0, highlight::TokenKind::Type)
}

///|
test "P0 shell: heredoc body is lexed as code" {
  let src = "cat <<EOF\nit's $HOME \"x\nEOF\necho ok\n"
  rt_expect(highlight::Language::Shell, src, "it", 0, highlight::TokenKind::String)
}

///|
test "P0 shell: escaped quote `\\'` opens a string that eats the line" {
  let src = "echo don\\'t; ls # real comment"
  rt_expect(highlight::Language::Shell, src, "# real", 0, highlight::TokenKind::Comment)
}

///|
test "P0 shell: single-quoted string spanning lines ends at newline, `#` inside becomes a comment" {
  let src = "echo 'a\nb # still string'\nls\n"
  rt_expect(highlight::Language::Shell, src, "# still", 0, highlight::TokenKind::String)
}

///|
test "P0 shell: double-quoted string spanning lines ends at newline" {
  let src = "msg=\"line one\nline # two\"\nls\n"
  rt_expect(highlight::Language::Shell, src, "# two", 0, highlight::TokenKind::String)
}

///|
test "P1 shell: nested double quotes inside $(...) inside a string" {
  let src = "echo \"$(echo \"inner\") done\""
  rt_expect(highlight::Language::Shell, src, "inner", 0, highlight::TokenKind::String)
}

// ============================================================================
// P1 — encoding / HTML output defects
// ============================================================================

///|
test "P1 cpp: unclosed [[ attribute splits a UTF-8 character across spans" {
  let src = "[[\u{e9}\n"
  let spans = highlight::highlight(highlight::Language::Cpp, src)
  let mut i = 0
  while i < spans.length() {
    let e = spans[i].end
    debug_assert(
      e >= src.length() || (src[e] & 0xC0) != 0x80,
      "span " + i.to_string() + " ends at byte " + e.to_string() + " inside a UTF-8 sequence",
    )
    i = i + 1
  }
}

///|
test "P1 cpp: highlight_html emits invalid UTF-8 (`</span>` inside a code point)" {
  let html = highlight::highlight_html(highlight::Language::Cpp, "x [[\u{1F600}")
  debug_assert(rt_find(html, "\u{1F600}", 0) >= 0, "emoji was cut in half by a </span>: " + html)
}

// ============================================================================
// P1 — wrong class for common constructs
// ============================================================================

///|
test "P1 c: #include <header> path is not a string" {
  rt_expect(highlight::Language::C, "#include <stdio.h>", "stdio", 0, highlight::TokenKind::String)
}

///|
test "P1 markdown: fenced code block content is not highlighted in its language" {
  let src = "```rust\nfn main() { let x = 1; } // c\n```\n"
  rt_expect(highlight::Language::Markdown, src, "fn", 0, highlight::TokenKind::Keyword)
  rt_expect(highlight::Language::Markdown, src, "// c", 0, highlight::TokenKind::Comment)
}

///|
test "P1 css: negative numbers lose their highlight" {
  let src = "a { margin: -1.5em -2px; }"
  rt_expect(highlight::Language::Css, src, "1.5em", 0, highlight::TokenKind::Number)
  rt_expect(highlight::Language::Css, src, "2px", 0, highlight::TokenKind::Number)
}

///|
test "P1 css: selectors nested inside @media are not highlighted" {
  let src = "@media screen { .m { color: red } }"
  rt_expect(highlight::Language::Css, src, ".m", 0, highlight::TokenKind::Tag)
}

///|
test "P1 toml: offset datetime is split into number fragments" {
  let src = "date = 1979-05-27T07:32:00Z"
  rt_expect(highlight::Language::Toml, src, "T07", 0, highlight::TokenKind::Number)
  rt_expect(highlight::Language::Toml, src, "Z", 0, highlight::TokenKind::Number)
}

///|
test "P1 toml: inline table keys are not properties" {
  let src = "inline = { a = 1, b.c = \"d\" }"
  rt_expect(highlight::Language::Toml, src, "a =", 0, highlight::TokenKind::Property)
  rt_expect(highlight::Language::Toml, src, "b.c", 0, highlight::TokenKind::Property)
}

///|
test "P1 python: f-string replacement fields are highlighted as string" {
  // PEP 498: `{x + 1}` is an expression; prism `string-interpolation`, shiki `meta.fstring`.
  let src = "s = f\"total={x + 1}\""
  rt_expect(highlight::Language::Python, src, "+", 0, highlight::TokenKind::Operator)
  rt_expect(highlight::Language::Python, src, "1}", 0, highlight::TokenKind::Number)
}

///|
test "P1 js: CR-only line terminator does not end a line comment" {
  // ECMAScript LineTerminator includes <CR>; content after `\r` is code.
  let src = "// c\rlet x = 1;"
  rt_expect(highlight::Language::JavaScript, src, "let", 0, highlight::TokenKind::Keyword)
}

// ============================================================================
// P2 — granularity gaps vs prism / shiki
// ============================================================================

///|
test "P2 rust: byte char b'x' and C string c\"..\" prefixes are not part of the literal" {
  let src = "let a = b'x'; let s = c\"hi\";"
  rt_expect(highlight::Language::Rust, src, "b'", 0, highlight::TokenKind::String)
  rt_expect(highlight::Language::Rust, src, "c\"", 0, highlight::TokenKind::String)
}

///|
test "P2 rust/ts: generic function definition names are not Function" {
  // prism `function-definition` / shiki `entity.name.function`; non-generic `fn f(` is handled.
  rt_expect(highlight::Language::Rust, "fn parse<T>(x: T) {}", "parse", 0, highlight::TokenKind::Function)
  rt_expect(highlight::Language::TypeScript, "function comp<T>(p: T) {}", "comp", 0, highlight::TokenKind::Function)
}

///|
test "P2 html: character references &amp; are plain text" {
  rt_expect_not(highlight::Language::Html, "<p>Tom &amp; Jerry</p>", "&amp;", 0, highlight::TokenKind::Plain)
}

///|
test "P2 html: unquoted attribute value is classed as attribute name" {
  rt_expect_not(highlight::Language::Html, "<a data-x=val>", "val", 0, highlight::TokenKind::Attribute)
}

///|
test "P2 markdown: bold, italic, list markers and link text are plain" {
  let src = "**bold** _it_ [link](http://x)\n- item\n"
  rt_expect_not(highlight::Language::Markdown, src, "bold", 0, highlight::TokenKind::Plain)
  rt_expect_not(highlight::Language::Markdown, src, "it_", 0, highlight::TokenKind::Plain)
  rt_expect_not(highlight::Language::Markdown, src, "- ", 0, highlight::TokenKind::Plain)
}

///|
test "P2 sql: dollar-quoted bodies and common DDL keywords" {
  let src = "CREATE FUNCTION f() RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql;"
  rt_expect(highlight::Language::Sql, src, "FUNCTION", 0, highlight::TokenKind::Keyword)
  rt_expect(highlight::Language::Sql, src, "RETURNS", 0, highlight::TokenKind::Keyword)
  rt_expect(highlight::Language::Sql, src, "LANGUAGE", 0, highlight::TokenKind::Keyword)
  rt_expect(highlight::Language::Sql, src, "$$ SELECT", 0, highlight::TokenKind::String)
}

///|
test "P2 shell: arithmetic expansion $((...)) operators and command names" {
  let src = "n=$((1 + 2 * 3))"
  rt_expect(highlight::Language::Shell, src, "+", 0, highlight::TokenKind::Operator)
  rt_expect_not(highlight::Language::Shell, src, "$((", 0, highlight::TokenKind::Plain)
}

///|
test "P2 c: #define continuation line is not part of the directive" {
  let src = "#define MAX(a, b) \\\n  ((a) > (b))\nint x;"
  rt_expect(highlight::Language::C, src, "((a)", 0, highlight::TokenKind::Attribute)
}

///|
test "P1 scss: advertised `scss` alias lexes `//` comments and `$vars` as selectors and strings" {
  let lang = rt_lang("scss")
  let src = "$main: #333; // it's a note\n.a { &:hover { color: $main; } }\n"
  rt_expect(lang, src, "// it", 0, highlight::TokenKind::Comment)
  rt_expect(lang, src, "'s a note", 0, highlight::TokenKind::Comment)
  rt_expect(lang, src, "$main", 1, highlight::TokenKind::Variable)
}

///|
test "P2 xml: `xml` alias leaves the <?xml ?> prolog unhighlighted" {
  let lang = rt_lang("xml")
  rt_expect_not(lang, "<?xml version=\"1.0\"?>\n<a/>", "xml", 0, highlight::TokenKind::Plain)
}
