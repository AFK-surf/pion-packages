///| Red-team probe: dumps `highlight` spans / incremental spans / HTML for a file, and runs timed loops.
///| usage: probe spans <lang> <file>        -> "start end class" per span
///|        probe lines <lang> <file>        -> spans via highlight_line (offsets rebased to file)
///|        probe html <lang> <file>         -> highlight_html output
///|        probe bench-html <lang> <file> <iters>  -> highlight_html N times, prints total out bytes
///|        probe bench-spans <lang> <file> <iters> -> highlight N times, prints total span count
import "highlight"

///|
fn parse_int(s : String, fallback : Int) -> Int {
  let mut v = 0
  let mut i = 0
  if s.length() == 0 {
    return fallback
  }
  while i < s.length() {
    let b = s[i]
    if b < 48 || b > 57 {
      return fallback
    }
    v = v * 10 + (b - 48)
    i = i + 1
  }
  v
}

///|
fn cls(k : highlight::TokenKind) -> String {
  let c = highlight::token_kind_class(k)
  if c.length() == 0 {
    "plain"
  } else {
    c.slice(3, c.length())
  }
}

///| Strip `<...>` tags and decode the 5 entities emitted by `highlight_html` (+ `&nbsp;`), FNV-1a over the decoded bytes.
fn html_text_fnv(h0 : Int, html : String) -> Int {
  let mut h = h0
  let n = html.length()
  let mut i = 0
  while i < n {
    let c = html[i]
    if c == 60 {
      while i < n && html[i] != 62 {
        i = i + 1
      }
      i = i + 1
      continue
    }
    let mut b = c
    if c == 38 {
      let mut j = i
      while j < n && html[j] != 59 {
        j = j + 1
      }
      let ent = html.slice(i, j + 1)
      if ent == "&amp;" {
        b = 38
      } else if ent == "&lt;" {
        b = 60
      } else if ent == "&gt;" {
        b = 62
      } else if ent == "&quot;" {
        b = 34
      } else if ent == "&#39;" {
        b = 39
      }
      i = j + 1
    } else {
      i = i + 1
    }
    h = ((h ^ b) * 16777619) & 0xFFFFFFFF
  }
  h
}

///|
fn hex8(v : Int) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut shift = 28
  while shift >= 0 {
    sb.write_byte(digits[(v >> shift) & 15].to_byte())
    shift = shift - 4
  }
  sb.to_string()
}

///| Parse the shared `bench/corpus.txt` (`===LANG:<name>===` sections, joined with `\n`).
fn parse_corpus(raw : String) -> Array[(highlight::Language, String)] {
  let entries : Array[(highlight::Language, String)] = Array::new()
  let lines = raw.split("\n")
  let mut name = ""
  let mut buf : Array[String] = Array::new()
  let mut active = false
  let mut i = 0
  while i <= lines.length() {
    let is_end = i == lines.length()
    let line = if is_end { "" } else { lines[i] }
    let is_hdr = !is_end && line.length() > 11 && line.slice(0, 8) == "===LANG:" && line.slice(line.length() - 3, line.length()) == "==="
    if is_end || is_hdr {
      if active {
        let sb = StringBuilder::new()
        let mut k = 0
        while k < buf.length() {
          if k > 0 {
            sb.write_string("\n")
          }
          sb.write_string(buf[k])
          k = k + 1
        }
        match highlight::resolve_language(name) {
          Some(l) => entries.push((l, sb.to_string()))
          None => ()
        }
      }
      if is_hdr {
        name = line.slice(8, line.length() - 3)
        buf = Array::new()
        active = true
      }
    } else if active {
      buf.push(line)
    }
    i = i + 1
  }
  entries
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 4 && args[1] == "corpus-html" {
    // probe corpus-html <corpus.txt> <iters>: end-to-end highlight_html over every corpus section.
    let raw = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(e) => {
        io_eprintln(world, "read failed: " + e)
        return 2
      }
    }
    let entries = parse_corpus(raw)
    let iters = parse_int(args[3], 1)
    let mut h = 0x811c9dc5
    let mut bytes = 0
    let mut j = 0
    while j < entries.length() {
      let (lang, src) = entries[j]
      let mut it = 0
      while it < iters {
        let html = highlight::highlight_html(lang, src)
        if it == iters - 1 {
          h = html_text_fnv(h, html)
        }
        it = it + 1
      }
      bytes = bytes + src.length()
      j = j + 1
    }
    io_print(world, "FILES=" + entries.length().to_string() + " BYTES=" + bytes.to_string() + " TEXT_FNV=" + hex8(h) + "\n")
    return 0
  }
  if args.length() < 4 {
    io_eprintln(world, "usage: probe <spans|lines|html|bench-html|bench-spans> <lang> <file> [iters]")
    return 2
  }
  let mode = args[1]
  let lang = match highlight::resolve_language(args[2]) {
    Some(l) => l
    None => {
      io_eprintln(world, "unknown language: " + args[2])
      return 2
    }
  }
  let src = match fs_read(world, args[3]) {
    Ok(s) => s
    Err(e) => {
      io_eprintln(world, "read failed: " + e)
      return 2
    }
  }
  let out = StringBuilder::new()
  if mode == "spans" {
    let spans = highlight::highlight(lang, src)
    let mut i = 0
    while i < spans.length() {
      let sp = spans[i]
      out.write_string(sp.start.to_string() + " " + sp.end.to_string() + " " + cls(sp.kind) + "\n")
      i = i + 1
    }
  } else if mode == "lines" {
    let n = src.length()
    let mut state = highlight::LineState::initial()
    let mut pos = 0
    while pos < n {
      let mut end = pos
      while end < n && src[end] != 10 {
        end = end + 1
      }
      if end < n {
        end = end + 1
      }
      let (sps, next) = highlight::highlight_line(lang, state, src.slice(pos, end))
      let mut j = 0
      while j < sps.length() {
        let sp = sps[j]
        out.write_string((pos + sp.start).to_string() + " " + (pos + sp.end).to_string() + " " + cls(sp.kind) + "\n")
        j = j + 1
      }
      state = next
      pos = end
    }
  } else if mode == "lines-nonl" {
    // Editor-style: feed each line WITHOUT its `\n` / `\r\n` terminator (as CodeMirror/Monaco/invar code_field store lines).
    let n = src.length()
    let mut state = highlight::LineState::initial()
    let mut pos = 0
    while pos < n {
      let mut end = pos
      while end < n && src[end] != 10 {
        end = end + 1
      }
      let mut cend = end
      if cend > pos && src[cend - 1] == 13 {
        cend = cend - 1
      }
      let (sps, next) = highlight::highlight_line(lang, state, src.slice(pos, cend))
      let mut j = 0
      while j < sps.length() {
        let sp = sps[j]
        out.write_string((pos + sp.start).to_string() + " " + (pos + sp.end).to_string() + " " + cls(sp.kind) + "\n")
        j = j + 1
      }
      state = next
      pos = if end < n { end + 1 } else { end }
    }
  } else if mode == "html" {
    out.write_string(highlight::highlight_html(lang, src))
  } else if mode == "bench-html" {
    let iters = if args.length() > 4 { parse_int(args[4], 1) } else { 1 }
    let mut total = 0
    let mut it = 0
    while it < iters {
      total = total + highlight::highlight_html(lang, src).length()
      it = it + 1
    }
    out.write_string("HTML_BYTES=" + total.to_string() + "\n")
  } else if mode == "bench-html-text" {
    // End-to-end HTML path: highlight_html N times; print FNV-1a of the tag-stripped, entity-decoded text (must equal source).
    let iters = if args.length() > 4 { parse_int(args[4], 1) } else { 1 }
    let mut h = 0x811c9dc5
    let mut it = 0
    while it < iters {
      let html = highlight::highlight_html(lang, src)
      if it == iters - 1 {
        h = html_text_fnv(h, html)
      }
      it = it + 1
    }
    out.write_string("BYTES=" + src.length().to_string() + " TEXT_FNV=" + hex8(h) + "\n")
  } else if mode == "bench-spans" {
    let iters = if args.length() > 4 { parse_int(args[4], 1) } else { 1 }
    let mut total = 0
    let mut it = 0
    while it < iters {
      total = total + highlight::highlight(lang, src).length()
      it = it + 1
    }
    out.write_string("SPANS=" + total.to_string() + "\n")
  } else {
    io_eprintln(world, "unknown mode " + mode)
    return 2
  }
  io_print(world, out.to_string())
  0
}
