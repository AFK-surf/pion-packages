///| Head-to-head native benchmark driver for `highlight` (full tokenization + lossless byte verification).
import "highlight"

///|
fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut v = 0
  let mut i = 0
  while i < n {
    let b = s[i]
    if b < 48 || b > 57 {
      return fallback
    }
    v = v * 10 + (b - 48)
    i = i + 1
  }
  v
}

///| FNV-1a 32-bit hash update over `s[start..end)`.
fn fnv1a_update(init_h : Int, s : String, start : Int, end : Int) -> Int {
  let mut h = init_h
  let mut i = start
  while i < end {
    h = ((h ^ s[i]) * 16777619) & 0xFFFFFFFF
    i = i + 1
  }
  h
}

///| Format 32-bit unsigned Int as 8-char lowercase hex.
fn hex8(v : Int) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut shift = 28
  while shift >= 0 {
    let nib = (v >> shift) & 15
    sb.write_byte(digits[nib].to_byte())
    shift = shift - 4
  }
  sb.to_string()
}

///| Parse `===LANG:<name>===` delimited corpus into `(lang_name, Language, source)` entries.
fn parse_corpus(raw : String) -> Array[(String, highlight::Language, String)] {
  let entries : Array[(String, highlight::Language, String)] = Array::new()
  let lines = raw.split("\n")
  let mut cur_name = ""
  let mut cur_buf = StringBuilder::new()
  let mut has_cur = false
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    if line.length() > 11 && line.slice(0, 8) == "===LANG:" && line.slice(line.length() - 3, line.length()) == "===" {
      if has_cur {
        match highlight::resolve_language(cur_name) {
          Some(lang) => entries.push((cur_name, lang, cur_buf.to_string()))
          None => ()
        }
      }
      cur_name = line.slice(8, line.length() - 3)
      cur_buf = StringBuilder::new()
      has_cur = true
    } else if has_cur {
      if cur_buf.to_string().length() > 0 {
        cur_buf.write_string("\n")
      }
      cur_buf.write_string(line)
    }
    i = i + 1
  }
  if has_cur {
    match highlight::resolve_language(cur_name) {
      Some(lang) => entries.push((cur_name, lang, cur_buf.to_string()))
      None => ()
    }
  }
  entries
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: highlight_bench <corpus_path> <iters> [--stats]")
    return 1
  }
  let corpus_path = args[1]
  let iters = parse_int_arg(args[2], 100)
  let show_stats = args.length() >= 4 && args[3] == "--stats"
  let raw = match fs_read(world, corpus_path) {
    Ok(s) => s
    Err(err) => {
      io_eprintln(world, "failed to read corpus: " + corpus_path + " (" + err + ")")
      return 1
    }
  }
  let entries = parse_corpus(raw)
  let n = entries.length()
  let mut total_bytes = 0
  let mut total_files = 0
  let mut total_valid = 0
  let mut total_hash = 0x811c9dc5
  let mut total_tokens = 0
  let mut total_non_plain = 0

  let lang_hashes : Array[Int] = Array::new()
  let lang_bytes : Array[Int] = Array::new()
  let lang_tokens : Array[Int] = Array::new()
  let mut k = 0
  while k < n {
    lang_hashes.push(0x811c9dc5)
    lang_bytes.push(0)
    lang_tokens.push(0)
    k = k + 1
  }

  let mut iter = 0
  while iter < iters {
    let mut j = 0
    while j < n {
      let (_, lang, src) = entries[j]
      let spans = highlight::highlight(lang, src)
      let mut cursor = 0
      let mut h = lang_hashes[j]
      let mut ok = true
      let mut sidx = 0
      let slen = spans.length()
      while sidx < slen {
        let sp = spans[sidx]
        if sp.start != cursor || sp.end <= sp.start || sp.end > src.length() {
          ok = false
          break
        }
        h = fnv1a_update(h, src, sp.start, sp.end)
        total_hash = fnv1a_update(total_hash, src, sp.start, sp.end)
        if !highlight::token_kind_eq(sp.kind, highlight::TokenKind::Plain) {
          total_non_plain = total_non_plain + 1
        }
        cursor = sp.end
        sidx = sidx + 1
      }
      if ok && cursor == src.length() {
        total_valid = total_valid + 1
      }
      lang_hashes[j] = h
      lang_bytes[j] = lang_bytes[j] + src.length()
      if iter == 0 {
        lang_tokens[j] = slen
      }
      total_tokens = total_tokens + slen
      total_bytes = total_bytes + src.length()
      total_files = total_files + 1
      j = j + 1
    }
    iter = iter + 1
  }

  let out = StringBuilder::new()
  let mut j = 0
  while j < n {
    let (name, _, _) = entries[j]
    out.write_string("LANG=" + name + " BYTES=" + lang_bytes[j].to_string() + " CHECKSUM=" + hex8(lang_hashes[j]) + "\n")
    j = j + 1
  }
  out.write_string("FILES=" + total_files.to_string() + " BYTES=" + total_bytes.to_string() + " VALID=" + total_valid.to_string() + " CHECKSUM=" + hex8(total_hash) + "\n")
  if show_stats {
    out.write_string("STATS total_spans=" + total_tokens.to_string() + " non_plain=" + total_non_plain.to_string() + "\n")
    let mut m = 0
    while m < n {
      let (name, _, _) = entries[m]
      out.write_string("  " + name + ": spans_per_file=" + lang_tokens[m].to_string() + "\n")
      m = m + 1
    }
  }
  io_print(world, out.to_string())
  0
}
