///| Public API entry points for `highlight`: full-file, incremental line-state, and HTML rendering.

///| Dispatch a single line content range `[start..content_end)` (without trailing `\r`/`\n`) to the language scanner.
fn scan_line_content(
  lang : Language,
  state : LineState,
  src : String,
  start : Int,
  content_end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  match lang {
    Pion | Rust | Go | TypeScript | JavaScript | C | Cpp =>
    scan_code_line(lang, state, src, start, content_end, out, base_idx)
    Python => scan_python_line(state, src, start, content_end, out, base_idx)
    Shell => scan_shell_line(state, src, start, content_end, out, base_idx)
    Json => scan_json_line(state, src, start, content_end, out, base_idx)
    Toml => scan_toml_line(state, src, start, content_end, out, base_idx)
    Yaml => scan_yaml_line(state, src, start, content_end, out, base_idx)
    Sql => scan_sql_line(state, src, start, content_end, out, base_idx)
    Html => scan_html_line(state, src, start, content_end, out, base_idx)
    Css => scan_css_line(state, src, start, content_end, out, base_idx)
    Diff => scan_diff_line(state, src, start, content_end, out, base_idx)
    Markdown => scan_markdown_line(state, src, start, content_end, out, base_idx)
  }
}

///| Scan one line slice `[line_start..line_end)` (optionally ending in `\r\n` or `\n`).
fn scan_line_range(
  lang : Language,
  state : LineState,
  src : String,
  line_start : Int,
  line_end : Int,
  out : Array[Span],
) -> LineState {
  let base_idx = out.length()
  let mut content_end = line_end
  if content_end > line_start && src[content_end - 1] == 10 {
    content_end = content_end - 1
    if content_end > line_start && src[content_end - 1] == 13 {
      content_end = content_end - 1
    }
  }
  let next_state = scan_line_content(lang, state, src, line_start, content_end, out, base_idx)
  if content_end < line_end {
    push_span(out, base_idx, content_end, line_end, TokenKind::Plain)
  }
  next_state
}

///| Highlight a single line incrementally, returning its spans (relative to `0..line.length()`) and next `LineState`.
pub fn highlight_line(
  lang : Language,
  state : LineState,
  line : String,
) -> (Array[Span], LineState) {
  let out : Array[Span] = Array::new()
  let next_state = scan_line_range(lang, state, line, 0, line.length(), out)
  (out, next_state)
}

///| Highlight a full source string, guaranteed 100% span-for-span identical to incremental `highlight_line`.
pub fn highlight(lang : Language, src : String) -> Array[Span] {
  let n = src.length()
  let out : Array[Span] = Array::new()
  if n == 0 {
    return out
  }
  let mut state = LineState::initial()
  let mut pos = 0
  while pos < n {
    let mut end = pos
    while end < n && src[end] != 10 {
      end = end + 1
    }
    if end < n && src[end] == 10 {
      end = end + 1
    }
    state = scan_line_range(lang, state, src, pos, end, out)
    pos = end
  }
  out
}

///| Write HTML-escaped slice `src[start..end)` into `sb` without intermediate substring allocations.
fn write_html_escaped_slice(sb : StringBuilder, src : String, start : Int, end : Int) -> Unit {
  let mut seg = start
  let mut p = start
  while p < end {
    let c = src[p]
    if c == 38 || c == 60 || c == 62 || c == 34 || c == 39 {
      if p > seg {
        sb.write_string(src.slice(seg, p))
      }
      if c == 38 {
        sb.write_string("&amp;")
      } else if c == 60 {
        sb.write_string("&lt;")
      } else if c == 62 {
        sb.write_string("&gt;")
      } else if c == 34 {
        sb.write_string("&quot;")
      } else {
        sb.write_string("&#39;")
      }
      seg = p + 1
    }
    p = p + 1
  }
  if seg < end {
    sb.write_string(src.slice(seg, end))
  }
}

///| Highlight source code to HTML with `<span class="hl-...">...</span>` and full HTML entity escaping.
pub fn highlight_html(lang : Language, src : String) -> String {
  if src.length() == 0 {
    return ""
  }
  let spans = highlight(lang, src)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < spans.length() {
    let sp = spans[i]
    let cls = token_kind_class(sp.kind)
    if cls.length() == 0 {
      write_html_escaped_slice(sb, src, sp.start, sp.end)
    } else {
      sb.write_string("<span class=\"")
      sb.write_string(cls)
      sb.write_string("\">")
      write_html_escaped_slice(sb, src, sp.start, sp.end)
      sb.write_string("</span>")
    }
    i = i + 1
  }
  sb.to_string()
}
