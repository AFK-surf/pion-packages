///| Core public types for `highlight`: languages, token kinds, zero-copy spans, and incremental line state.

///|
pub enum Language {
  Pion
  Rust
  Go
  TypeScript
  JavaScript
  Python
  C
  Cpp
  Json
  Toml
  Yaml
  Sql
  Shell
  Html
  Css
  Diff
  Markdown
  Java
  Kotlin
  Swift
  CSharp
  Php
  Ruby
  Dockerfile
}

///|
pub enum TokenKind {
  Plain
  Keyword
  Type
  Function
  String
  Number
  Comment
  Operator
  Punctuation
  Constant
  Attribute
  Property
  Tag
  Variable
  Namespace
  DiffAdd
  DiffDel
  DiffHeader
}

///|
pub val struct Span {
  pub start : Int
  pub end : Int
  pub kind : TokenKind
}

///|
pub val struct LineState {
  pub mode : Int
  pub depth : Int
  pub delim : Int
  pub sub_mode : Int
  pub sub_depth : Int
  pub sub_delim : Int
  pub tag : String
}

///|
pub fn LineState::initial() -> LineState {
  LineState::{
    mode: 0,
    depth: 0,
    delim: 0,
    sub_mode: 0,
    sub_depth: 0,
    sub_delim: 0,
    tag: "",
  }
}

///|
pub fn token_kind_eq(a : TokenKind, b : TokenKind) -> Bool {
  token_kind_id(a) == token_kind_id(b)
}

///|
pub fn token_kind_id(k : TokenKind) -> Int {
  match k {
    Plain => 0
    Keyword => 1
    Type => 2
    Function => 3
    String => 4
    Number => 5
    Comment => 6
    Operator => 7
    Punctuation => 8
    Constant => 9
    Attribute => 10
    Property => 11
    Tag => 12
    Variable => 13
    Namespace => 14
    DiffAdd => 15
    DiffDel => 16
    DiffHeader => 17
  }
}

///|
pub fn token_kind_class(k : TokenKind) -> String {
  match k {
    Plain => ""
    Keyword => "hl-keyword"
    Type => "hl-type"
    Function => "hl-function"
    String => "hl-string"
    Number => "hl-number"
    Comment => "hl-comment"
    Operator => "hl-operator"
    Punctuation => "hl-punctuation"
    Constant => "hl-constant"
    Attribute => "hl-attribute"
    Property => "hl-property"
    Tag => "hl-tag"
    Variable => "hl-variable"
    Namespace => "hl-namespace"
    DiffAdd => "hl-diff-add"
    DiffDel => "hl-diff-del"
    DiffHeader => "hl-diff-header"
  }
}

///|
pub fn span_eq(a : Span, b : Span) -> Bool {
  a.start == b.start && a.end == b.end && token_kind_eq(a.kind, b.kind)
}

///|
pub fn line_state_eq(a : LineState, b : LineState) -> Bool {
  a.mode == b.mode &&
  a.depth == b.depth &&
  a.delim == b.delim &&
  a.sub_mode == b.sub_mode &&
  a.sub_depth == b.sub_depth &&
  a.sub_delim == b.sub_delim &&
  a.tag == b.tag
}

///|
pub fn language_id(lang : Language) -> Int {
  match lang {
    Pion => 0
    Rust => 1
    Go => 2
    TypeScript => 3
    JavaScript => 4
    Python => 5
    C => 6
    Cpp => 7
    Json => 8
    Toml => 9
    Yaml => 10
    Sql => 11
    Shell => 12
    Html => 13
    Css => 14
    Diff => 15
    Markdown => 16
    Java => 17
    Kotlin => 18
    Swift => 19
    CSharp => 20
    Php => 21
    Ruby => 22
    Dockerfile => 23
  }
}

///|
pub fn language_eq(a : Language, b : Language) -> Bool {
  language_id(a) == language_id(b)
}

///|
pub fn language_name(lang : Language) -> String {
  match lang {
    Pion => "pion"
    Rust => "rust"
    Go => "go"
    TypeScript => "typescript"
    JavaScript => "javascript"
    Python => "python"
    C => "c"
    Cpp => "cpp"
    Json => "json"
    Toml => "toml"
    Yaml => "yaml"
    Sql => "sql"
    Shell => "shell"
    Html => "html"
    Css => "css"
    Diff => "diff"
    Markdown => "markdown"
    Java => "java"
    Kotlin => "kotlin"
    Swift => "swift"
    CSharp => "csharp"
    Php => "php"
    Ruby => "ruby"
    Dockerfile => "dockerfile"
  }
}

///| ANSI escape sequence prefix for terminal syntax highlighting.
pub fn token_kind_ansi(k : TokenKind) -> String {
  match k {
    Plain => ""
    Keyword => "\u{1b}[35m"
    Type => "\u{1b}[33m"
    Function => "\u{1b}[34m"
    String => "\u{1b}[32m"
    Number => "\u{1b}[36m"
    Comment => "\u{1b}[90m"
    Operator => "\u{1b}[37m"
    Punctuation => "\u{1b}[37m"
    Constant => "\u{1b}[93m"
    Attribute => "\u{1b}[95m"
    Property => "\u{1b}[94m"
    Tag => "\u{1b}[31m"
    Variable => "\u{1b}[96m"
    Namespace => "\u{1b}[93m"
    DiffAdd => "\u{1b}[32m"
    DiffDel => "\u{1b}[31m"
    DiffHeader => "\u{1b}[36m"
  }
}
