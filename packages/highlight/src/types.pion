///| Core public types for `highlight`: languages, token kinds, zero-copy spans, and incremental line state.

///|
pub enum Language {
  Pion
  Rust
  Go
  TypeScript
  JavaScript
  Python
  C
  Cpp
  Json
  Toml
  Yaml
  Sql
  Shell
  Html
  Css
  Diff
  Markdown
}

///|
pub enum TokenKind {
  Plain
  Keyword
  Type
  Function
  String
  Number
  Comment
  Operator
  Punctuation
  Constant
  Attribute
  Property
  Tag
  Variable
  Namespace
  DiffAdd
  DiffDel
  DiffHeader
}

///|
pub val struct Span {
  pub start : Int
  pub end : Int
  pub kind : TokenKind
}

///|
pub val struct LineState {
  pub mode : Int
  pub depth : Int
  pub delim : Int
}

///|
pub fn LineState::initial() -> LineState {
  LineState::{ mode: 0, depth: 0, delim: 0 }
}

///|
pub fn token_kind_eq(a : TokenKind, b : TokenKind) -> Bool {
  token_kind_id(a) == token_kind_id(b)
}

///|
pub fn token_kind_id(k : TokenKind) -> Int {
  match k {
    Plain => 0
    Keyword => 1
    Type => 2
    Function => 3
    String => 4
    Number => 5
    Comment => 6
    Operator => 7
    Punctuation => 8
    Constant => 9
    Attribute => 10
    Property => 11
    Tag => 12
    Variable => 13
    Namespace => 14
    DiffAdd => 15
    DiffDel => 16
    DiffHeader => 17
  }
}

///|
pub fn token_kind_class(k : TokenKind) -> String {
  match k {
    Plain => ""
    Keyword => "hl-keyword"
    Type => "hl-type"
    Function => "hl-function"
    String => "hl-string"
    Number => "hl-number"
    Comment => "hl-comment"
    Operator => "hl-operator"
    Punctuation => "hl-punctuation"
    Constant => "hl-constant"
    Attribute => "hl-attribute"
    Property => "hl-property"
    Tag => "hl-tag"
    Variable => "hl-variable"
    Namespace => "hl-namespace"
    DiffAdd => "hl-diff-add"
    DiffDel => "hl-diff-del"
    DiffHeader => "hl-diff-header"
  }
}

///|
pub fn span_eq(a : Span, b : Span) -> Bool {
  a.start == b.start && a.end == b.end && token_kind_eq(a.kind, b.kind)
}

///|
pub fn line_state_eq(a : LineState, b : LineState) -> Bool {
  a.mode == b.mode && a.depth == b.depth && a.delim == b.delim
}

///|
pub fn language_id(lang : Language) -> Int {
  match lang {
    Pion => 0
    Rust => 1
    Go => 2
    TypeScript => 3
    JavaScript => 4
    Python => 5
    C => 6
    Cpp => 7
    Json => 8
    Toml => 9
    Yaml => 10
    Sql => 11
    Shell => 12
    Html => 13
    Css => 14
    Diff => 15
    Markdown => 16
  }
}

///|
pub fn language_eq(a : Language, b : Language) -> Bool {
  language_id(a) == language_id(b)
}

///|
pub fn language_name(lang : Language) -> String {
  match lang {
    Pion => "pion"
    Rust => "rust"
    Go => "go"
    TypeScript => "typescript"
    JavaScript => "javascript"
    Python => "python"
    C => "c"
    Cpp => "cpp"
    Json => "json"
    Toml => "toml"
    Yaml => "yaml"
    Sql => "sql"
    Shell => "shell"
    Html => "html"
    Css => "css"
    Diff => "diff"
    Markdown => "markdown"
  }
}
