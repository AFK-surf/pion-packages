///| Language name & alias resolution (case-insensitive, ASCII whitespace trimmed).

///|
fn trim_and_lower(s : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n && (s[a] == 32 || s[a] == 9 || s[a] == 10 || s[a] == 13) {
    a = a + 1
  }
  let mut b = n
  while b > a && (s[b - 1] == 32 || s[b - 1] == 9 || s[b - 1] == 10 || s[b - 1] == 13) {
    b = b - 1
  }
  if a >= b {
    return ""
  }
  let sb = StringBuilder::new()
  let mut i = a
  while i < b {
    let c = s[i]
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn resolve_language(name : String) -> Option[Language] {
  let key = trim_and_lower(name)
  match key {
    "pion" | "mbt" | "moonbit" => Some(Language::Pion)
    "rust" | "rs" => Some(Language::Rust)
    "go" | "golang" => Some(Language::Go)
    "typescript" | "ts" | "tsx" | "mts" | "cts" => Some(Language::TypeScript)
    "javascript" | "js" | "jsx" | "mjs" | "cjs" => Some(Language::JavaScript)
    "python" | "py" | "py3" | "pyi" => Some(Language::Python)
    "c" | "h" => Some(Language::C)
    "cpp" | "c++" | "cc" | "cxx" | "hpp" | "hh" | "hxx" => Some(Language::Cpp)
    "json" | "jsonc" | "jsonl" => Some(Language::Json)
    "toml" => Some(Language::Toml)
    "yaml" | "yml" => Some(Language::Yaml)
    "sql" | "postgres" | "postgresql" | "mysql" | "sqlite" => Some(Language::Sql)
    "shell" | "sh" | "bash" | "zsh" | "shellscript" => Some(Language::Shell)
    "html" | "htm" | "xml" | "svg" | "xhtml" | "markup" => Some(Language::Html)
    "css" | "scss" => Some(Language::Css)
    "diff" | "patch" => Some(Language::Diff)
    "markdown" | "md" => Some(Language::Markdown)
    _ => None
  }
}
