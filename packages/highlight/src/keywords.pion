///| Zero-allocation first-byte-dispatched keyword, type, and constant classifiers for all languages.

///|
fn classify_pion(src : String, s : Int, len : Int) -> TokenKind {
  let b = src[s]
  match b {
    97 => if eq_word(src, s, len, "as") || eq_word(src, s, len, "async") || eq_word(src, s, len, "await") { TokenKind::Keyword } else { TokenKind::Plain }
    98 => if eq_word(src, s, len, "break") { TokenKind::Keyword } else { TokenKind::Plain }
    99 => if eq_word(src, s, len, "const") || eq_word(src, s, len, "continue") { TokenKind::Keyword } else { TokenKind::Plain }
    101 => if eq_word(src, s, len, "else") || eq_word(src, s, len, "enum") || eq_word(src, s, len, "extern") { TokenKind::Keyword } else { TokenKind::Plain }
    102 => if eq_word(src, s, len, "fn") || eq_word(src, s, len, "for") { TokenKind::Keyword } else if eq_word(src, s, len, "false") { TokenKind::Constant } else { TokenKind::Plain }
    105 => if eq_word(src, s, len, "if") || eq_word(src, s, len, "impl") || eq_word(src, s, len, "import") || eq_word(src, s, len, "in") { TokenKind::Keyword } else { TokenKind::Plain }
    108 => if eq_word(src, s, len, "let") || eq_word(src, s, len, "loop") { TokenKind::Keyword } else { TokenKind::Plain }
    109 => if eq_word(src, s, len, "match") || eq_word(src, s, len, "mut") { TokenKind::Keyword } else { TokenKind::Plain }
    112 => if eq_word(src, s, len, "pub") || eq_word(src, s, len, "priv") { TokenKind::Keyword } else { TokenKind::Plain }
    114 => if eq_word(src, s, len, "return") || eq_word(src, s, len, "raise") { TokenKind::Keyword } else { TokenKind::Plain }
    115 => if eq_word(src, s, len, "struct") || eq_word(src, s, len, "self") { TokenKind::Keyword } else { TokenKind::Plain }
    116 => if eq_word(src, s, len, "test") || eq_word(src, s, len, "trait") || eq_word(src, s, len, "type") || eq_word(src, s, len, "try") { TokenKind::Keyword } else if eq_word(src, s, len, "true") { TokenKind::Constant } else { TokenKind::Plain }
    118 => if eq_word(src, s, len, "val") { TokenKind::Keyword } else { TokenKind::Plain }
    119 => if eq_word(src, s, len, "while") || eq_word(src, s, len, "where") { TokenKind::Keyword } else { TokenKind::Plain }
    78 => if eq_word(src, s, len, "None") { TokenKind::Constant } else { TokenKind::Type }
    83 => if eq_word(src, s, len, "Some") { TokenKind::Constant } else { TokenKind::Type }
    79 => if eq_word(src, s, len, "Ok") { TokenKind::Constant } else { TokenKind::Type }
    69 => if eq_word(src, s, len, "Err") { TokenKind::Constant } else { TokenKind::Type }
    _ => if is_ascii_upper(b) { TokenKind::Type } else { TokenKind::Plain }
  }
}

///|
fn classify_rust(src : String, s : Int, len : Int) -> TokenKind {
  let b = src[s]
  match b {
    97 => if eq_word(src, s, len, "as") || eq_word(src, s, len, "async") || eq_word(src, s, len, "await") { TokenKind::Keyword } else { TokenKind::Plain }
    98 => if eq_word(src, s, len, "break") { TokenKind::Keyword } else if eq_word(src, s, len, "bool") { TokenKind::Type } else { TokenKind::Plain }
    99 => if eq_word(src, s, len, "const") || eq_word(src, s, len, "continue") || eq_word(src, s, len, "crate") { TokenKind::Keyword } else if eq_word(src, s, len, "char") { TokenKind::Type } else { TokenKind::Plain }
    100 => if eq_word(src, s, len, "dyn") { TokenKind::Keyword } else { TokenKind::Plain }
    101 => if eq_word(src, s, len, "else") || eq_word(src, s, len, "enum") || eq_word(src, s, len, "extern") { TokenKind::Keyword } else { TokenKind::Plain }
    102 => if eq_word(src, s, len, "fn") || eq_word(src, s, len, "for") { TokenKind::Keyword } else if eq_word(src, s, len, "false") { TokenKind::Constant } else if eq_word(src, s, len, "f32") || eq_word(src, s, len, "f64") { TokenKind::Type } else { TokenKind::Plain }
    105 => if eq_word(src, s, len, "if") || eq_word(src, s, len, "impl") || eq_word(src, s, len, "in") { TokenKind::Keyword } else if eq_word(src, s, len, "i8") || eq_word(src, s, len, "i16") || eq_word(src, s, len, "i32") || eq_word(src, s, len, "i64") || eq_word(src, s, len, "i128") || eq_word(src, s, len, "isize") { TokenKind::Type } else { TokenKind::Plain }
    108 => if eq_word(src, s, len, "let") || eq_word(src, s, len, "loop") { TokenKind::Keyword } else { TokenKind::Plain }
    109 => if eq_word(src, s, len, "match") || eq_word(src, s, len, "mod") || eq_word(src, s, len, "move") || eq_word(src, s, len, "mut") { TokenKind::Keyword } else { TokenKind::Plain }
    112 => if eq_word(src, s, len, "pub") { TokenKind::Keyword } else { TokenKind::Plain }
    114 => if eq_word(src, s, len, "ref") || eq_word(src, s, len, "return") { TokenKind::Keyword } else { TokenKind::Plain }
    115 => if eq_word(src, s, len, "self") || eq_word(src, s, len, "static") || eq_word(src, s, len, "struct") || eq_word(src, s, len, "super") { TokenKind::Keyword } else if eq_word(src, s, len, "str") { TokenKind::Type } else { TokenKind::Plain }
    116 => if eq_word(src, s, len, "trait") || eq_word(src, s, len, "type") { TokenKind::Keyword } else if eq_word(src, s, len, "true") { TokenKind::Constant } else { TokenKind::Plain }
    117 => if eq_word(src, s, len, "unsafe") || eq_word(src, s, len, "use") { TokenKind::Keyword } else if eq_word(src, s, len, "u8") || eq_word(src, s, len, "u16") || eq_word(src, s, len, "u32") || eq_word(src, s, len, "u64") || eq_word(src, s, len, "u128") || eq_word(src, s, len, "usize") { TokenKind::Type } else { TokenKind::Plain }
    119 => if eq_word(src, s, len, "where") || eq_word(src, s, len, "while") { TokenKind::Keyword } else { TokenKind::Plain }
    78 => if eq_word(src, s, len, "None") { TokenKind::Constant } else { TokenKind::Type }
    83 => if eq_word(src, s, len, "Some") { TokenKind::Constant } else { TokenKind::Type }
    79 => if eq_word(src, s, len, "Ok") { TokenKind::Constant } else { TokenKind::Type }
    69 => if eq_word(src, s, len, "Err") { TokenKind::Constant } else { TokenKind::Type }
    _ => if is_ascii_upper(b) { TokenKind::Type } else { TokenKind::Plain }
  }
}

///|
fn classify_go(src : String, s : Int, len : Int) -> TokenKind {
  let b = src[s]
  match b {
    97 => if eq_word(src, s, len, "any") { TokenKind::Type } else { TokenKind::Plain }
    98 => if eq_word(src, s, len, "break") { TokenKind::Keyword } else if eq_word(src, s, len, "bool") || eq_word(src, s, len, "byte") { TokenKind::Type } else { TokenKind::Plain }
    99 => if eq_word(src, s, len, "case") || eq_word(src, s, len, "chan") || eq_word(src, s, len, "const") || eq_word(src, s, len, "continue") { TokenKind::Keyword } else if eq_word(src, s, len, "complex64") || eq_word(src, s, len, "complex128") || eq_word(src, s, len, "comparable") { TokenKind::Type } else { TokenKind::Plain }
    100 => if eq_word(src, s, len, "default") || eq_word(src, s, len, "defer") { TokenKind::Keyword } else { TokenKind::Plain }
    101 => if eq_word(src, s, len, "else") { TokenKind::Keyword } else if eq_word(src, s, len, "error") { TokenKind::Type } else { TokenKind::Plain }
    102 => if eq_word(src, s, len, "fallthrough") || eq_word(src, s, len, "for") || eq_word(src, s, len, "func") { TokenKind::Keyword } else if eq_word(src, s, len, "false") { TokenKind::Constant } else if eq_word(src, s, len, "float32") || eq_word(src, s, len, "float64") { TokenKind::Type } else { TokenKind::Plain }
    103 => if eq_word(src, s, len, "go") || eq_word(src, s, len, "goto") { TokenKind::Keyword } else { TokenKind::Plain }
    105 => if eq_word(src, s, len, "if") || eq_word(src, s, len, "import") || eq_word(src, s, len, "interface") { TokenKind::Keyword } else if eq_word(src, s, len, "iota") { TokenKind::Constant } else if eq_word(src, s, len, "int") || eq_word(src, s, len, "int8") || eq_word(src, s, len, "int16") || eq_word(src, s, len, "int32") || eq_word(src, s, len, "int64") { TokenKind::Type } else { TokenKind::Plain }
    109 => if eq_word(src, s, len, "map") { TokenKind::Keyword } else { TokenKind::Plain }
    110 => if eq_word(src, s, len, "nil") { TokenKind::Constant } else { TokenKind::Plain }
    112 => if eq_word(src, s, len, "package") { TokenKind::Keyword } else { TokenKind::Plain }
    114 => if eq_word(src, s, len, "range") || eq_word(src, s, len, "return") { TokenKind::Keyword } else if eq_word(src, s, len, "rune") { TokenKind::Type } else { TokenKind::Plain }
    115 => if eq_word(src, s, len, "select") || eq_word(src, s, len, "struct") || eq_word(src, s, len, "switch") { TokenKind::Keyword } else if eq_word(src, s, len, "string") { TokenKind::Type } else { TokenKind::Plain }
    116 => if eq_word(src, s, len, "type") { TokenKind::Keyword } else if eq_word(src, s, len, "true") { TokenKind::Constant } else { TokenKind::Plain }
    117 => if eq_word(src, s, len, "uint") || eq_word(src, s, len, "uint8") || eq_word(src, s, len, "uint16") || eq_word(src, s, len, "uint32") || eq_word(src, s, len, "uint64") || eq_word(src, s, len, "uintptr") { TokenKind::Type } else { TokenKind::Plain }
    118 => if eq_word(src, s, len, "var") { TokenKind::Keyword } else { TokenKind::Plain }
    _ => TokenKind::Plain
  }
}

///|
fn classify_js_ts(src : String, s : Int, len : Int, is_ts : Bool) -> TokenKind {
  let b = src[s]
  match b {
    97 => if eq_word(src, s, len, "async") || eq_word(src, s, len, "await") || (is_ts && (eq_word(src, s, len, "as") || eq_word(src, s, len, "abstract"))) { TokenKind::Keyword } else if is_ts && eq_word(src, s, len, "any") { TokenKind::Type } else { TokenKind::Plain }
    98 => if eq_word(src, s, len, "break") { TokenKind::Keyword } else if is_ts && (eq_word(src, s, len, "boolean") || eq_word(src, s, len, "bigint")) { TokenKind::Type } else { TokenKind::Plain }
    99 => if eq_word(src, s, len, "case") || eq_word(src, s, len, "catch") || eq_word(src, s, len, "class") || eq_word(src, s, len, "const") || eq_word(src, s, len, "continue") { TokenKind::Keyword } else { TokenKind::Plain }
    100 => if eq_word(src, s, len, "debugger") || eq_word(src, s, len, "default") || eq_word(src, s, len, "delete") || eq_word(src, s, len, "do") || (is_ts && eq_word(src, s, len, "declare")) { TokenKind::Keyword } else { TokenKind::Plain }
    101 => if eq_word(src, s, len, "else") || eq_word(src, s, len, "export") || eq_word(src, s, len, "extends") || (is_ts && eq_word(src, s, len, "enum")) { TokenKind::Keyword } else { TokenKind::Plain }
    102 => if eq_word(src, s, len, "finally") || eq_word(src, s, len, "for") || eq_word(src, s, len, "from") || eq_word(src, s, len, "function") { TokenKind::Keyword } else if eq_word(src, s, len, "false") { TokenKind::Constant } else { TokenKind::Plain }
    103 => if eq_word(src, s, len, "get") { TokenKind::Keyword } else { TokenKind::Plain }
    105 => if eq_word(src, s, len, "if") || eq_word(src, s, len, "import") || eq_word(src, s, len, "in") || eq_word(src, s, len, "instanceof") || (is_ts && (eq_word(src, s, len, "implements") || eq_word(src, s, len, "interface") || eq_word(src, s, len, "infer") || eq_word(src, s, len, "is"))) { TokenKind::Keyword } else { TokenKind::Plain }
    107 => if is_ts && eq_word(src, s, len, "keyof") { TokenKind::Keyword } else { TokenKind::Plain }
    108 => if eq_word(src, s, len, "let") { TokenKind::Keyword } else { TokenKind::Plain }
    110 => if eq_word(src, s, len, "new") || (is_ts && eq_word(src, s, len, "namespace")) { TokenKind::Keyword } else if eq_word(src, s, len, "null") { TokenKind::Constant } else if is_ts && (eq_word(src, s, len, "number") || eq_word(src, s, len, "never")) { TokenKind::Type } else { TokenKind::Plain }
    111 => if eq_word(src, s, len, "of") || (is_ts && eq_word(src, s, len, "override")) { TokenKind::Keyword } else if is_ts && eq_word(src, s, len, "object") { TokenKind::Type } else { TokenKind::Plain }
    112 => if is_ts && (eq_word(src, s, len, "private") || eq_word(src, s, len, "protected") || eq_word(src, s, len, "public")) { TokenKind::Keyword } else { TokenKind::Plain }
    114 => if eq_word(src, s, len, "return") || (is_ts && eq_word(src, s, len, "readonly")) { TokenKind::Keyword } else { TokenKind::Plain }
    115 => if eq_word(src, s, len, "set") || eq_word(src, s, len, "static") || eq_word(src, s, len, "super") || eq_word(src, s, len, "switch") || (is_ts && eq_word(src, s, len, "satisfies")) { TokenKind::Keyword } else if is_ts && (eq_word(src, s, len, "string") || eq_word(src, s, len, "symbol")) { TokenKind::Type } else { TokenKind::Plain }
    116 => if eq_word(src, s, len, "this") || eq_word(src, s, len, "throw") || eq_word(src, s, len, "try") || eq_word(src, s, len, "typeof") || (is_ts && eq_word(src, s, len, "type")) { TokenKind::Keyword } else if eq_word(src, s, len, "true") { TokenKind::Constant } else { TokenKind::Plain }
    117 => if eq_word(src, s, len, "undefined") { TokenKind::Constant } else if is_ts && eq_word(src, s, len, "unknown") { TokenKind::Type } else { TokenKind::Plain }
    118 => if eq_word(src, s, len, "var") { TokenKind::Keyword } else if eq_word(src, s, len, "void") { if is_ts { TokenKind::Type } else { TokenKind::Keyword } } else { TokenKind::Plain }
    119 => if eq_word(src, s, len, "while") || eq_word(src, s, len, "with") { TokenKind::Keyword } else { TokenKind::Plain }
    121 => if eq_word(src, s, len, "yield") { TokenKind::Keyword } else { TokenKind::Plain }
    73 => if eq_word(src, s, len, "Infinity") { TokenKind::Constant } else if is_ascii_upper(b) { TokenKind::Type } else { TokenKind::Plain }
    78 => if eq_word(src, s, len, "NaN") { TokenKind::Constant } else if is_ascii_upper(b) { TokenKind::Type } else { TokenKind::Plain }
    _ => if eq_word(src, s, len, "Array") || eq_word(src, s, len, "Object") || eq_word(src, s, len, "Map") || eq_word(src, s, len, "Set") || eq_word(src, s, len, "Promise") || eq_word(src, s, len, "RegExp") || eq_word(src, s, len, "Date") || eq_word(src, s, len, "Error") || eq_word(src, s, len, "Record") || eq_word(src, s, len, "Partial") || eq_word(src, s, len, "Required") || eq_word(src, s, len, "Readonly") { TokenKind::Type } else { TokenKind::Plain }
  }
}

///|
fn classify_c_cpp(src : String, s : Int, len : Int, is_cpp : Bool) -> TokenKind {
  let b = src[s]
  match b {
    97 => if eq_word(src, s, len, "auto") || (is_cpp && eq_word(src, s, len, "alignas")) { TokenKind::Keyword } else { TokenKind::Plain }
    98 => if eq_word(src, s, len, "break") { TokenKind::Keyword } else if eq_word(src, s, len, "bool") { TokenKind::Type } else { TokenKind::Plain }
    99 => if eq_word(src, s, len, "case") || eq_word(src, s, len, "const") || eq_word(src, s, len, "continue") || (is_cpp && (eq_word(src, s, len, "catch") || eq_word(src, s, len, "class") || eq_word(src, s, len, "constexpr") || eq_word(src, s, len, "consteval") || eq_word(src, s, len, "concept") || eq_word(src, s, len, "co_await") || eq_word(src, s, len, "co_return") || eq_word(src, s, len, "co_yield"))) { TokenKind::Keyword } else if eq_word(src, s, len, "char") { TokenKind::Type } else { TokenKind::Plain }
    100 => if eq_word(src, s, len, "default") || eq_word(src, s, len, "do") || (is_cpp && (eq_word(src, s, len, "delete") || eq_word(src, s, len, "decltype"))) { TokenKind::Keyword } else if eq_word(src, s, len, "double") { TokenKind::Type } else { TokenKind::Plain }
    101 => if eq_word(src, s, len, "else") || eq_word(src, s, len, "enum") || eq_word(src, s, len, "extern") || (is_cpp && eq_word(src, s, len, "explicit")) { TokenKind::Keyword } else { TokenKind::Plain }
    102 => if eq_word(src, s, len, "for") || (is_cpp && (eq_word(src, s, len, "friend") || eq_word(src, s, len, "final"))) { TokenKind::Keyword } else if eq_word(src, s, len, "false") { TokenKind::Constant } else if eq_word(src, s, len, "float") { TokenKind::Type } else { TokenKind::Plain }
    103 => if eq_word(src, s, len, "goto") { TokenKind::Keyword } else { TokenKind::Plain }
    105 => if eq_word(src, s, len, "if") || eq_word(src, s, len, "inline") { TokenKind::Keyword } else if eq_word(src, s, len, "int") || eq_word(src, s, len, "int8_t") || eq_word(src, s, len, "int16_t") || eq_word(src, s, len, "int32_t") || eq_word(src, s, len, "int64_t") { TokenKind::Type } else { TokenKind::Plain }
    108 => if eq_word(src, s, len, "long") { TokenKind::Type } else { TokenKind::Plain }
    109 => if is_cpp && eq_word(src, s, len, "mutable") { TokenKind::Keyword } else { TokenKind::Plain }
    110 => if is_cpp && (eq_word(src, s, len, "namespace") || eq_word(src, s, len, "new") || eq_word(src, s, len, "noexcept")) { TokenKind::Keyword } else if is_cpp && eq_word(src, s, len, "nullptr") { TokenKind::Constant } else { TokenKind::Plain }
    111 => if is_cpp && (eq_word(src, s, len, "operator") || eq_word(src, s, len, "override")) { TokenKind::Keyword } else { TokenKind::Plain }
    112 => if is_cpp && (eq_word(src, s, len, "private") || eq_word(src, s, len, "protected") || eq_word(src, s, len, "public")) { TokenKind::Keyword } else { TokenKind::Plain }
    114 => if eq_word(src, s, len, "register") || eq_word(src, s, len, "restrict") || eq_word(src, s, len, "return") || (is_cpp && eq_word(src, s, len, "requires")) { TokenKind::Keyword } else { TokenKind::Plain }
    115 => if eq_word(src, s, len, "sizeof") || eq_word(src, s, len, "static") || eq_word(src, s, len, "struct") || eq_word(src, s, len, "switch") || (is_cpp && (eq_word(src, s, len, "static_assert") || eq_word(src, s, len, "static_cast"))) { TokenKind::Keyword } else if eq_word(src, s, len, "short") || eq_word(src, s, len, "signed") || eq_word(src, s, len, "size_t") || eq_word(src, s, len, "ssize_t") { TokenKind::Type } else { TokenKind::Plain }
    116 => if eq_word(src, s, len, "typedef") || (is_cpp && (eq_word(src, s, len, "template") || eq_word(src, s, len, "this") || eq_word(src, s, len, "throw") || eq_word(src, s, len, "try") || eq_word(src, s, len, "typename"))) { TokenKind::Keyword } else if eq_word(src, s, len, "true") { TokenKind::Constant } else { TokenKind::Plain }
    117 => if eq_word(src, s, len, "union") || (is_cpp && eq_word(src, s, len, "using")) { TokenKind::Keyword } else if eq_word(src, s, len, "unsigned") || eq_word(src, s, len, "uint8_t") || eq_word(src, s, len, "uint16_t") || eq_word(src, s, len, "uint32_t") || eq_word(src, s, len, "uint64_t") || eq_word(src, s, len, "uintptr_t") { TokenKind::Type } else { TokenKind::Plain }
    118 => if eq_word(src, s, len, "volatile") || (is_cpp && eq_word(src, s, len, "virtual")) { TokenKind::Keyword } else if eq_word(src, s, len, "void") { TokenKind::Type } else { TokenKind::Plain }
    119 => if eq_word(src, s, len, "while") { TokenKind::Keyword } else { TokenKind::Plain }
    78 => if eq_word(src, s, len, "NULL") { TokenKind::Constant } else { TokenKind::Plain }
    70 => if eq_word(src, s, len, "FILE") { TokenKind::Type } else { TokenKind::Plain }
    _ => TokenKind::Plain
  }
}

///|
fn classify_python(src : String, s : Int, len : Int) -> TokenKind {
  let b = src[s]
  match b {
    97 => if eq_word(src, s, len, "and") || eq_word(src, s, len, "as") || eq_word(src, s, len, "assert") || eq_word(src, s, len, "async") || eq_word(src, s, len, "await") { TokenKind::Keyword } else { TokenKind::Plain }
    98 => if eq_word(src, s, len, "break") { TokenKind::Keyword } else if eq_word(src, s, len, "bool") || eq_word(src, s, len, "bytes") || eq_word(src, s, len, "bytearray") { TokenKind::Type } else { TokenKind::Plain }
    99 => if eq_word(src, s, len, "class") || eq_word(src, s, len, "continue") || eq_word(src, s, len, "case") { TokenKind::Keyword } else if eq_word(src, s, len, "complex") { TokenKind::Type } else { TokenKind::Plain }
    100 => if eq_word(src, s, len, "def") || eq_word(src, s, len, "del") { TokenKind::Keyword } else if eq_word(src, s, len, "dict") { TokenKind::Type } else { TokenKind::Plain }
    101 => if eq_word(src, s, len, "elif") || eq_word(src, s, len, "else") || eq_word(src, s, len, "except") { TokenKind::Keyword } else { TokenKind::Plain }
    102 => if eq_word(src, s, len, "finally") || eq_word(src, s, len, "for") || eq_word(src, s, len, "from") { TokenKind::Keyword } else if eq_word(src, s, len, "float") || eq_word(src, s, len, "frozenset") { TokenKind::Type } else { TokenKind::Plain }
    103 => if eq_word(src, s, len, "global") { TokenKind::Keyword } else { TokenKind::Plain }
    105 => if eq_word(src, s, len, "if") || eq_word(src, s, len, "import") || eq_word(src, s, len, "in") || eq_word(src, s, len, "is") { TokenKind::Keyword } else if eq_word(src, s, len, "int") { TokenKind::Type } else { TokenKind::Plain }
    108 => if eq_word(src, s, len, "lambda") { TokenKind::Keyword } else if eq_word(src, s, len, "list") { TokenKind::Type } else { TokenKind::Plain }
    109 => if eq_word(src, s, len, "match") { TokenKind::Keyword } else { TokenKind::Plain }
    110 => if eq_word(src, s, len, "nonlocal") || eq_word(src, s, len, "not") { TokenKind::Keyword } else { TokenKind::Plain }
    111 => if eq_word(src, s, len, "or") { TokenKind::Keyword } else if eq_word(src, s, len, "object") { TokenKind::Type } else { TokenKind::Plain }
