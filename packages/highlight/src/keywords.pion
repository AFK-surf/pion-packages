    100 => if eq_word(src, s, len, "default") || eq_word(src, s, len, "delegate") || eq_word(src, s, len, "do") { TokenKind::Keyword } else if eq_word(src, s, len, "decimal") || eq_word(src, s, len, "double") || eq_word(src, s, len, "dynamic") { TokenKind::Type } else { TokenKind::Plain }
    101 => if eq_word(src, s, len, "else") || eq_word(src, s, len, "enum") || eq_word(src, s, len, "event") || eq_word(src, s, len, "extern") { TokenKind::Keyword } else { TokenKind::Plain }
    102 => if eq_word(src, s, len, "finally") || eq_word(src, s, len, "for") || eq_word(src, s, len, "foreach") { TokenKind::Keyword } else if eq_word(src, s, len, "false") { TokenKind::Constant } else if eq_word(src, s, len, "float") { TokenKind::Type } else { TokenKind::Plain }
    105 => if eq_word(src, s, len, "if") || eq_word(src, s, len, "in") || eq_word(src, s, len, "interface") || eq_word(src, s, len, "internal") || eq_word(src, s, len, "is") { TokenKind::Keyword } else if eq_word(src, s, len, "int") { TokenKind::Type } else { TokenKind::Plain }
    108 => if eq_word(src, s, len, "lock") { TokenKind::Keyword } else if eq_word(src, s, len, "long") { TokenKind::Type } else { TokenKind::Plain }
    110 => if eq_word(src, s, len, "namespace") || eq_word(src, s, len, "new") { TokenKind::Keyword } else if eq_word(src, s, len, "null") { TokenKind::Constant } else { TokenKind::Plain }
    111 => if eq_word(src, s, len, "operator") || eq_word(src, s, len, "out") || eq_word(src, s, len, "override") { TokenKind::Keyword } else if eq_word(src, s, len, "object") { TokenKind::Type } else { TokenKind::Plain }
    112 => if eq_word(src, s, len, "params") || eq_word(src, s, len, "partial") || eq_word(src, s, len, "private") || eq_word(src, s, len, "protected") || eq_word(src, s, len, "public") { TokenKind::Keyword } else { TokenKind::Plain }
    114 => if eq_word(src, s, len, "readonly") || eq_word(src, s, len, "record") || eq_word(src, s, len, "ref") || eq_word(src, s, len, "return") { TokenKind::Keyword } else { TokenKind::Plain }
    115 => if eq_word(src, s, len, "sealed") || eq_word(src, s, len, "static") || eq_word(src, s, len, "struct") || eq_word(src, s, len, "switch") { TokenKind::Keyword } else if eq_word(src, s, len, "sbyte") || eq_word(src, s, len, "short") || eq_word(src, s, len, "string") { TokenKind::Type } else { TokenKind::Plain }
    116 => if eq_word(src, s, len, "this") || eq_word(src, s, len, "throw") || eq_word(src, s, len, "try") || eq_word(src, s, len, "typeof") { TokenKind::Keyword } else if eq_word(src, s, len, "true") { TokenKind::Constant } else { TokenKind::Plain }
    117 => if eq_word(src, s, len, "unchecked") || eq_word(src, s, len, "unsafe") || eq_word(src, s, len, "using") { TokenKind::Keyword } else if eq_word(src, s, len, "uint") || eq_word(src, s, len, "ulong") || eq_word(src, s, len, "ushort") { TokenKind::Type } else { TokenKind::Plain }
    118 => if eq_word(src, s, len, "var") || eq_word(src, s, len, "virtual") { TokenKind::Keyword } else if eq_word(src, s, len, "void") { TokenKind::Type } else { TokenKind::Plain }
    119 => if eq_word(src, s, len, "where") || eq_word(src, s, len, "while") { TokenKind::Keyword } else { TokenKind::Plain }
    121 => if eq_word(src, s, len, "yield") { TokenKind::Keyword } else { TokenKind::Plain }
    _ => if is_ascii_upper(b) { TokenKind::Type } else { TokenKind::Plain }
  }
}

///|
fn classify_php(src : String, s : Int, len : Int) -> TokenKind {
  let b = to_lower_ascii(src[s])
  match b {
    97 => if eq_word_ci(src, s, len, "abstract") || eq_word_ci(src, s, len, "and") || eq_word_ci(src, s, len, "as") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "array") { TokenKind::Type } else { TokenKind::Plain }
    98 => if eq_word_ci(src, s, len, "break") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "bool") { TokenKind::Type } else { TokenKind::Plain }
    99 => if eq_word_ci(src, s, len, "case") || eq_word_ci(src, s, len, "catch") || eq_word_ci(src, s, len, "class") || eq_word_ci(src, s, len, "const") || eq_word_ci(src, s, len, "continue") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "callable") { TokenKind::Type } else { TokenKind::Plain }
    100 => if eq_word_ci(src, s, len, "default") || eq_word_ci(src, s, len, "do") { TokenKind::Keyword } else { TokenKind::Plain }
    101 => if eq_word_ci(src, s, len, "echo") || eq_word_ci(src, s, len, "else") || eq_word_ci(src, s, len, "elseif") || eq_word_ci(src, s, len, "enum") || eq_word_ci(src, s, len, "extends") { TokenKind::Keyword } else { TokenKind::Plain }
    102 => if eq_word_ci(src, s, len, "final") || eq_word_ci(src, s, len, "finally") || eq_word_ci(src, s, len, "fn") || eq_word_ci(src, s, len, "for") || eq_word_ci(src, s, len, "foreach") || eq_word_ci(src, s, len, "function") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "false") { TokenKind::Constant } else if eq_word_ci(src, s, len, "float") { TokenKind::Type } else { TokenKind::Plain }
    105 => if eq_word_ci(src, s, len, "if") || eq_word_ci(src, s, len, "implements") || eq_word_ci(src, s, len, "include") || eq_word_ci(src, s, len, "instanceof") || eq_word_ci(src, s, len, "interface") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "int") { TokenKind::Type } else { TokenKind::Plain }
    109 => if eq_word_ci(src, s, len, "match") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "mixed") { TokenKind::Type } else { TokenKind::Plain }
    110 => if eq_word_ci(src, s, len, "namespace") || eq_word_ci(src, s, len, "new") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "null") { TokenKind::Constant } else { TokenKind::Plain }
    111 => if eq_word_ci(src, s, len, "or") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "object") { TokenKind::Type } else { TokenKind::Plain }
    112 => if eq_word_ci(src, s, len, "print") || eq_word_ci(src, s, len, "private") || eq_word_ci(src, s, len, "protected") || eq_word_ci(src, s, len, "public") { TokenKind::Keyword } else { TokenKind::Plain }
    114 => if eq_word_ci(src, s, len, "readonly") || eq_word_ci(src, s, len, "require") || eq_word_ci(src, s, len, "return") { TokenKind::Keyword } else { TokenKind::Plain }
    115 => if eq_word_ci(src, s, len, "static") || eq_word_ci(src, s, len, "switch") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "string") { TokenKind::Type } else { TokenKind::Plain }
    116 => if eq_word_ci(src, s, len, "throw") || eq_word_ci(src, s, len, "trait") || eq_word_ci(src, s, len, "try") { TokenKind::Keyword } else if eq_word_ci(src, s, len, "true") { TokenKind::Constant } else { TokenKind::Plain }
    117 => if eq_word_ci(src, s, len, "use") { TokenKind::Keyword } else { TokenKind::Plain }
    118 => if eq_word_ci(src, s, len, "void") { TokenKind::Type } else { TokenKind::Plain }
    119 => if eq_word_ci(src, s, len, "while") { TokenKind::Keyword } else { TokenKind::Plain }
    121 => if eq_word_ci(src, s, len, "yield") { TokenKind::Keyword } else { TokenKind::Plain }
    _ => TokenKind::Plain
  }
}

///|
fn classify_ruby(src : String, s : Int, len : Int) -> TokenKind {
  let b = src[s]
  match b {
    97 => if eq_word(src, s, len, "alias") || eq_word(src, s, len, "and") { TokenKind::Keyword } else { TokenKind::Plain }
    98 => if eq_word(src, s, len, "begin") || eq_word(src, s, len, "break") { TokenKind::Keyword } else { TokenKind::Plain }
    99 => if eq_word(src, s, len, "case") || eq_word(src, s, len, "class") { TokenKind::Keyword } else { TokenKind::Plain }
    100 => if eq_word(src, s, len, "def") || eq_word(src, s, len, "defined?") || eq_word(src, s, len, "do") { TokenKind::Keyword } else { TokenKind::Plain }
    101 => if eq_word(src, s, len, "else") || eq_word(src, s, len, "elsif") || eq_word(src, s, len, "end") || eq_word(src, s, len, "ensure") { TokenKind::Keyword } else { TokenKind::Plain }
    102 => if eq_word(src, s, len, "for") { TokenKind::Keyword } else if eq_word(src, s, len, "false") { TokenKind::Constant } else { TokenKind::Plain }
    105 => if eq_word(src, s, len, "if") || eq_word(src, s, len, "in") { TokenKind::Keyword } else { TokenKind::Plain }
    109 => if eq_word(src, s, len, "module") { TokenKind::Keyword } else { TokenKind::Plain }
    110 => if eq_word(src, s, len, "next") || eq_word(src, s, len, "not") { TokenKind::Keyword } else if eq_word(src, s, len, "nil") { TokenKind::Constant } else { TokenKind::Plain }
    111 => if eq_word(src, s, len, "or") { TokenKind::Keyword } else { TokenKind::Plain }
    114 => if eq_word(src, s, len, "redo") || eq_word(src, s, len, "rescue") || eq_word(src, s, len, "retry") || eq_word(src, s, len, "return") || eq_word(src, s, len, "require") { TokenKind::Keyword } else { TokenKind::Plain }
    115 => if eq_word(src, s, len, "self") || eq_word(src, s, len, "super") { TokenKind::Keyword } else { TokenKind::Plain }
    116 => if eq_word(src, s, len, "then") { TokenKind::Keyword } else if eq_word(src, s, len, "true") { TokenKind::Constant } else { TokenKind::Plain }
    117 => if eq_word(src, s, len, "unless") || eq_word(src, s, len, "until") { TokenKind::Keyword } else { TokenKind::Plain }
    119 => if eq_word(src, s, len, "when") || eq_word(src, s, len, "while") { TokenKind::Keyword } else { TokenKind::Plain }
    121 => if eq_word(src, s, len, "yield") { TokenKind::Keyword } else { TokenKind::Plain }
    _ => if is_ascii_upper(b) { TokenKind::Type } else { TokenKind::Plain }
  }
}

///|
fn classify_dockerfile_instr(src : String, s : Int, len : Int) -> Bool {
  let b = to_lower_ascii(src[s])
  match b {
    97 => eq_word_ci(src, s, len, "add") || eq_word_ci(src, s, len, "arg")
    99 => eq_word_ci(src, s, len, "cmd") || eq_word_ci(src, s, len, "copy")
    101 => eq_word_ci(src, s, len, "entrypoint") || eq_word_ci(src, s, len, "env") || eq_word_ci(src, s, len, "expose")
    102 => eq_word_ci(src, s, len, "from")
    104 => eq_word_ci(src, s, len, "healthcheck")
    108 => eq_word_ci(src, s, len, "label")
    109 => eq_word_ci(src, s, len, "maintainer")
    111 => eq_word_ci(src, s, len, "onbuild")
    114 => eq_word_ci(src, s, len, "run")
    115 => eq_word_ci(src, s, len, "shell") || eq_word_ci(src, s, len, "stopsignal")
    117 => eq_word_ci(src, s, len, "user")
    118 => eq_word_ci(src, s, len, "volume")
    119 => eq_word_ci(src, s, len, "workdir")
    _ => false
  }
}
