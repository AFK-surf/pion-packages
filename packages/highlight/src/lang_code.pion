///| Line scanners for programming & scripting languages:
///| Pion, Rust, Go, TypeScript/TSX, JavaScript/JSX, C, C++, Java, Kotlin, Swift, C#, PHP, Python, Ruby, Shell, Dockerfile.

///| Scan a Rust raw string body starting at `pos` until `"` followed by `hashes` `#`s.
fn scan_rust_raw_body(src : String, pos : Int, end : Int, hashes : Int) -> (Int, Bool) {
  let mut p = pos
  while p < end {
    if src[p] == 34 {
      let mut h = 0
      while h < hashes && p + 1 + h < end && src[p + 1 + h] == 35 {
        h = h + 1
      }
      if h == hashes {
        return (p + 1 + hashes, true)
      }
    }
    p = p + 1
  }
  (end, false)
}

///| Scan a C++ raw string body starting after `R"delim(` until `)delim"`.
fn scan_cpp_raw_body(src : String, pos : Int, end : Int, delim : String) -> (Int, Bool) {
  let dlen = delim.length()
  let mut p = pos
  while p < end {
    if src[p] == 41 && p + 1 + dlen < end && src[p + 1 + dlen] == 34 {
      if dlen == 0 || eq_word(src, p + 1, dlen, delim) {
        return (p + 2 + dlen, true)
      }
    }
    p = p + 1
  }
  (end, false)
}

///| Scan a backtick raw string body (Go) until `` ` ``.
fn scan_backtick_body(src : String, pos : Int, end : Int) -> (Int, Bool) {
  let mut p = pos
  while p < end {
    if src[p] == 96 {
      return (p + 1, true)
    }
    p = p + 1
  }
  (end, false)
}

///| Scan a JS/TS template string segment starting at `pos`.
///| Stops at unescaped `` ` `` (returns `(next_pos, 0)`), `${` (returns `(next_pos, 1)`), or `end` (returns `(end, 2)`).
fn scan_template_segment(src : String, pos : Int, end : Int) -> (Int, Int) {
  let mut p = pos
  while p < end {
    let c = src[p]
    if c == 92 {
      p = p + 1
      if p < end {
        p = p + utf8_char_step(src, p, end)
      }
      continue
    }
    if c == 96 {
      return (p + 1, 0)
    }
    if c == 36 && p + 1 < end && src[p + 1] == 123 {
      return (p, 1)
    }
    p = p + 1
  }
  (end, 2)
}

///| Scan a JS/TS regex literal starting at `/` (`pos`). Returns end offset (including flags) or -1 if not a valid regex.
fn scan_js_regex(src : String, pos : Int, end : Int) -> Int {
  let mut p = pos + 1
  let mut in_class = false
  while p < end {
    let c = src[p]
    if c == 13 || c == 10 {
      return -1
    }
    if c == 92 {
      p = p + 1
      if p >= end || src[p] == 13 || src[p] == 10 {
        return -1
      }
      p = p + utf8_char_step(src, p, end)
      continue
    }
    if c == 91 {
      in_class = true
      p = p + 1
      continue
    }
    if c == 93 && in_class {
      in_class = false
      p = p + 1
      continue
    }
    if c == 47 && !in_class {
      p = p + 1
      while p < end && is_ascii_alpha(src[p]) {
        p = p + 1
      }
      return p
    }
    p = p + 1
  }
  -1
}

///| Return true if a JS/TS keyword can precede a regex literal or JSX element.
fn js_kw_allows_regex(src : String, s : Int, len : Int) -> Bool {
  let b = src[s]
  match b {
    97 => eq_word(src, s, len, "await")
    99 => eq_word(src, s, len, "case")
    100 => eq_word(src, s, len, "default") || eq_word(src, s, len, "delete") || eq_word(src, s, len, "do")
    101 => eq_word(src, s, len, "else") || eq_word(src, s, len, "export")
    105 => eq_word(src, s, len, "in") || eq_word(src, s, len, "instanceof")
    110 => eq_word(src, s, len, "new")
    111 => eq_word(src, s, len, "of")
    114 => eq_word(src, s, len, "return")
    116 => eq_word(src, s, len, "throw") || eq_word(src, s, len, "typeof")
    118 => eq_word(src, s, len, "void")
    121 => eq_word(src, s, len, "yield")
    _ => false
  }
}

///| Check if `<` at `pos` looks like a JSX opening tag (`<>` or `<Tag ...>`), excluding TS generics `<T,>` / `<T extends ...>`.
fn looks_like_jsx_open(src : String, pos : Int, end : Int) -> Bool {
  if pos + 1 >= end {
    return false
  }
  let n1 = src[pos + 1]
  // Fragment `<>`
  if n1 == 62 {
    return true
  }
  if !is_ascii_alpha(n1) && n1 != 95 {
    return false
  }
  let mut p = pos + 2
  while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 95 || src[p] == 45 || src[p] == 46) {
    p = p + 1
  }
  if p >= end {
    return false
  }
  let after = src[p]
  // `<Tag>` or `<Tag/>` or `<Tag ...>`
  if after == 62 {
    // Reject TS generic arrow `<T>(x) =>`
    let nxt = peek_non_ws(src, p + 1, end)
    if nxt == 40 {
      return false
    }
    return true
  }
  if after == 47 && p + 1 < end && src[p + 1] == 62 {
    return true
  }
  if is_ws_inline(after) {
    let mut q = p
    while q < end && is_ws_inline(src[q]) {
      q = q + 1
    }
    if q < end && starts_with_ci(src, q, end, "extends") && (q + 7 == end || !is_ident_cont(src[q + 7])) {
      return false
    }
    return true
  }
  false
}

///| Scan balanced `{ ... }` expression inside JSX attribute or JSX child using `scan_code_line`.
fn scan_jsx_brace_expr(
  lang : Language,
  src : String,
  pos : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> Int {
  push_span(out, base_idx, pos, pos + 1, TokenKind::Punctuation)
  let mut p = pos + 1
  let expr_start = p
  let mut bdepth = 1
  while p < end && bdepth > 0 {
    let c = src[p]
    if c == 123 {
      bdepth = bdepth + 1
      p = p + 1
    } else if c == 125 {
      bdepth = bdepth - 1
      if bdepth == 0 {
        break
      }
      p = p + 1
    } else if c == 34 || c == 39 {
      p = scan_quoted_string(src, p, end, c, true)
    } else if c == 96 {
      let (np, _) = scan_backtick_body(src, p + 1, end)
      p = np
    } else {
      p = p + 1
    }
  }
  if p > expr_start {
    let _ = scan_code_line(lang, LineState::initial(), src, expr_start, p, out, base_idx)
  }
  if p < end && src[p] == 125 {
    push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    return p + 1
  }
  p
}

///| Scan a JSX opening tag `<Tag attr="v" attr={expr} />` or `<>`.
///| Returns `(next_pos, is_self_closing)`.
fn scan_jsx_open_tag(
  lang : Language,
  src : String,
  pos : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> (Int, Bool) {
  push_span(out, base_idx, pos, pos + 1, TokenKind::Punctuation)
  let mut p = pos + 1
  if p < end && src[p] == 62 {
    push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    return (p + 1, false)
  }
  let tstart = p
  while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 95 || src[p] == 45 || src[p] == 46) {
    p = p + 1
  }
  if p > tstart {
    push_span(out, base_idx, tstart, p, TokenKind::Tag)
  }
  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws, p, TokenKind::Plain)
      continue
    }
    if c == 47 && p + 1 < end && src[p + 1] == 62 {
      push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
      return (p + 2, true)
    }
    if c == 62 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      return (p + 1, false)
    }
    if c == 61 {
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      p = p + 1
      continue
    }
    if c == 34 || c == 39 {
      let np = scan_quoted_string(src, p, end, c, true)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      continue
    }
    if c == 123 {
      p = scan_jsx_brace_expr(lang, src, p, end, out, base_idx)
      continue
    }
    if is_ascii_alpha(c) || c == 95 {
      let astart = p
      p = p + 1
      while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 95 || src[p] == 45) {
        p = p + 1
      }
      push_span(out, base_idx, astart, p, TokenKind::Attribute)
      continue
    }
    let step = utf8_char_step(src, p, end)
    push_span(out, base_idx, p, p + step, TokenKind::Plain)
    p = p + step
  }
  (end, false)
}

///| Scan JSX text and nested JSX children until `depth` reaches 0 or `end`.
///| Returns `(next_pos, remaining_depth)`.
fn scan_jsx_children(
  lang : Language,
  src : String,
  pos : Int,
  end : Int,
  init_depth : Int,
  out : Array[Span],
  base_idx : Int,
) -> (Int, Int) {
  let mut p = pos
  let mut jdepth = init_depth
  while p < end && jdepth > 0 {
    let c = src[p]
    if c == 123 {
      p = scan_jsx_brace_expr(lang, src, p, end, out, base_idx)
      continue
    }
    if c == 60 {
      // Closing tag `</Tag>` or `</>`
      if p + 1 < end && src[p + 1] == 47 {
        push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
        p = p + 2
        let tstart = p
        while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 95 || src[p] == 45 || src[p] == 46) {
          p = p + 1
        }
        if p > tstart {
          push_span(out, base_idx, tstart, p, TokenKind::Tag)
        }
        while p < end && is_ws_inline(src[p]) {
          let ws = p
          p = p + 1
          while p < end && is_ws_inline(src[p]) {
            p = p + 1
          }
          push_span(out, base_idx, ws, p, TokenKind::Plain)
        }
        if p < end && src[p] == 62 {
          push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
          p = p + 1
        }
        jdepth = jdepth - 1
        continue
      }
      // Nested opening tag
      if looks_like_jsx_open(src, p, end) {
        let (np, self_close) = scan_jsx_open_tag(lang, src, p, end, out, base_idx)
        p = np
        if !self_close {
          jdepth = jdepth + 1
        }
        continue
      }
    }
    // JSX text: plain text until `<` or `{` (apostrophes/quotes are plain text, NOT strings!)
    let tstart = p
    p = p + utf8_char_step(src, p, end)
    while p < end && src[p] != 60 && src[p] != 123 {
      p = p + 1
    }
    push_span(out, base_idx, tstart, p, TokenKind::Plain)
  }
  (p, jdepth)
}

///| Classify an identifier for C-family / systems / JS / TS / JVM / Swift / C# / PHP languages.
fn classify_code_ident(lang : Language, src : String, s : Int, len : Int) -> TokenKind {
  match lang {
    Pion => classify_pion(src, s, len)
    Rust => classify_rust(src, s, len)
    Go => classify_go(src, s, len)
    TypeScript => classify_js_ts(src, s, len, true)
    JavaScript => classify_js_ts(src, s, len, false)
    C => classify_c_cpp(src, s, len, false)
    Cpp => classify_c_cpp(src, s, len, true)
    Java => classify_java(src, s, len)
    Kotlin => classify_kotlin(src, s, len)
    Swift => classify_swift(src, s, len)
    CSharp => classify_csharp(src, s, len)
    Php => classify_php(src, s, len)
    _ => TokenKind::Plain
  }
}

///| Scan a Pion double-quoted string with optional `\{expr}` interpolation on a single line.
fn scan_pion_string(
  src : String,
  pos : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> Int {
  let mut p = pos + 1
  let mut seg_start = pos
  while p < end {
    let c = src[p]
    if c == 92 {
      if p + 1 < end && src[p + 1] == 123 {
        // String interpolation `\{ ... }`
        push_span(out, base_idx, seg_start, p, TokenKind::String)
        push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
        p = p + 2
        // Scan inner expression until matching `}`
        let mut brace_depth = 1
        let expr_start = p
        while p < end && brace_depth > 0 {
          let ec = src[p]
          if ec == 123 {
            brace_depth = brace_depth + 1
            p = p + 1
          } else if ec == 125 {
            brace_depth = brace_depth - 1
            if brace_depth == 0 {
              break
            }
            p = p + 1
          } else if ec == 34 {
            p = scan_quoted_string(src, p, end, 34, true)
          } else {
            p = p + 1
          }
        }
        let _ = scan_code_line(
          Language::Pion,
          LineState::initial(),
          src,
          expr_start,
          p,
          out,
          base_idx,
        )
        if p < end && src[p] == 125 {
          push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
          p = p + 1
        }
        seg_start = p
        continue
      }
      p = p + 1
      if p < end {
        p = p + utf8_char_step(src, p, end)
      }
      continue
    }
    if c == 34 {
      push_span(out, base_idx, seg_start, p + 1, TokenKind::String)
      return p + 1
    }
    p = p + 1
  }
  push_span(out, base_idx, seg_start, end, TokenKind::String)
  end
}

///| Continue a JS/TS template string segment and update `(mode, depth, delim, tpl_stack)` in O(1).
///| Returns `(next_pos, eol_reached, next_mode, next_depth, next_delim)`.
fn resume_template_body(
  src : String,
  pos : Int,
  end : Int,
  delim : Int,
  tpl_stack : Array[Int],
  out : Array[Span],
  base_idx : Int,
) -> (Int, Bool, Int, Int, Int) {
  let (np, status) = scan_template_segment(src, pos, end)
  push_span(out, base_idx, pos, np, TokenKind::String)
  if status == 0 {
    // Closed this template literal
    if delim > 0 {
      let outer_depth = match tpl_stack.pop() {
        Some(v) => v
        None => 0
      }
      (np, false, mode_template_str, outer_depth, delim - 1)
    } else {
      (np, false, mode_normal, 0, 0)
    }
  } else if status == 1 {
    push_span(out, base_idx, np, np + 2, TokenKind::Punctuation)
    (np + 2, false, mode_template_str, 1, delim)
  } else {
    (np, true, mode_template_str, 0, delim)
  }
}

///| Shared zero-allocation line scanner for Pion, Rust, Go, TypeScript, JavaScript, C, C++, Java, Kotlin, Swift, C#, PHP.
fn scan_code_line(
  lang : Language,
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let lid = language_id(lang)
  let is_pion = lid == 0
  let is_rust = lid == 1
  let is_go = lid == 2
  let is_ts = lid == 3
  let is_js = lid == 4
  let is_c = lid == 6
  let is_cpp = lid == 7
  let is_java = lid == 17
  let is_kotlin = lid == 18
  let is_swift = lid == 19
  let is_csharp = lid == 20
  let is_php = lid == 21
  let nested_comments = is_pion || is_rust || is_kotlin || is_swift
  let is_js_family = is_ts || is_js
  let has_namespace = is_pion || is_rust || is_cpp || is_php
  let has_at_attr = is_js_family || is_pion || is_java || is_kotlin || is_swift

  let mut mode = state.mode
  let mut depth = state.depth
  let mut delim = state.delim
  let mut sub_mode = state.sub_mode
  let mut sub_depth = state.sub_depth
  let mut sub_delim = state.sub_delim
  let mut tag = state.tag
  let tpl_stack : Array[Int] = if is_js_family && tag.length() > 0 && (mode == mode_template_str || sub_mode == mode_template_str) {
    stack_decode(tag)
  } else {
    Array::new()
  }
  let mut p = start
  let mut can_regex = true
  let mut no_more_regex = false
  let mut prev_was_fn = false
  let mut pp_cont_next = false

  // Handle continuing multi-line states at start of line
  if mode == mode_block_comment {
    let (np, nd) = scan_block_comment_body(src, p, end, depth, nested_comments)
    push_span(out, base_idx, p, np, TokenKind::Comment)
    p = np
    depth = nd
    if depth == 0 {
      if sub_mode == mode_template_str {
        mode = mode_template_str
        depth = sub_depth
        delim = sub_delim
        sub_mode = 0
        sub_depth = 0
        sub_delim = 0
      } else {
        mode = mode_normal
      }
    } else {
      return LineState::{ mode, depth, delim, sub_mode, sub_depth, sub_delim, tag }
    }
  } else if mode == mode_c_pp_cont {
    push_span(out, base_idx, p, end, TokenKind::Attribute)
    if ends_with_odd_backslashes(src, p, end) {
      return state
    }
    return LineState::initial()
  } else if mode == mode_c_str_cont {
    let q = delim
    let mut sp = p
    let mut closed = false
    while sp < end {
      let ch = src[sp]
      if ch == 92 {
        sp = sp + 1
        if sp < end {
          sp = sp + utf8_char_step(src, sp, end)
        }
        continue
      }
      if ch == q {
        sp = sp + 1
        closed = true
        break
      }
      sp = sp + 1
    }
    push_span(out, base_idx, p, sp, TokenKind::String)
    p = sp
    if closed {
      mode = mode_normal
      delim = 0
      can_regex = false
    } else if ends_with_odd_backslashes(src, start, end) {
      return state
    } else {
      return LineState::initial()
    }
  } else if mode == mode_cpp_raw_str {
    let (np, closed) = scan_cpp_raw_body(src, p, end, tag)
    push_span(out, base_idx, p, np, TokenKind::String)
    p = np
    if closed {
      mode = mode_normal
      tag = ""
      can_regex = false
    } else {
      return state
    }
  } else if mode == mode_raw_str {
    if delim == 34 {
      let (np, closed) = scan_rust_raw_body(src, p, end, depth)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      if closed {
        mode = mode_normal
        depth = 0
        delim = 0
      } else {
        return make_state(mode, depth, delim)
      }
    } else {
      let (np, closed) = scan_backtick_body(src, p, end)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      if closed {
        mode = mode_normal
        depth = 0
        delim = 0
      } else {
        return make_state(mode, depth, delim)
      }
    }
  } else if mode == mode_template_str && depth == 0 {
    let (np, eol, nm, nd, ndel) = resume_template_body(src, p, end, delim, tpl_stack, out, base_idx)
    p = np
    mode = nm
    depth = nd
    delim = ndel
    can_regex = true
    if eol {
      let enc = if delim > 0 { stack_encode(tpl_stack) } else { "" }
      return LineState::{ mode, depth, delim, sub_mode, sub_depth, sub_delim, tag: enc }
    }
    if mode == mode_normal {
      can_regex = false
    }
  } else if mode == mode_jsx_text {
    let (np, rem) = scan_jsx_children(lang, src, p, end, depth, out, base_idx)
    p = np
    depth = rem
    if depth == 0 {
      mode = mode_normal
      can_regex = false
    } else {
      return make_state(mode_jsx_text, depth, 0)
    }
  }

  while p < end {
    let c = src[p]

    // Whitespace (including bare `\r` as ECMAScript LineTerminator)
    if is_ws_inline(c) || c == 13 {
      let ws_start = p
      let mut had_cr = c == 13
      p = p + 1
      while p < end && (is_ws_inline(src[p]) || src[p] == 13) {
        if src[p] == 13 {
          had_cr = true
        }
        p = p + 1
      }
      if had_cr {
        can_regex = true
        prev_was_fn = false
      }
      push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      continue
    }

    // Template expression brace tracking (JS/TS with full nesting stack)
    if mode == mode_template_str && depth > 0 {
      if c == 123 {
        depth = depth + 1
        can_regex = true
        prev_was_fn = false
        push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
        p = p + 1
        continue
      }
      if c == 125 {
        depth = depth - 1
        push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
        p = p + 1
        if depth == 0 {
          let (np, eol, nm, nd, ndel) = resume_template_body(src, p, end, delim, tpl_stack, out, base_idx)
          p = np
          mode = nm
          depth = nd
          delim = ndel
          can_regex = mode == mode_template_str && depth > 0
          prev_was_fn = false
          if eol {
            let enc = if delim > 0 { stack_encode(tpl_stack) } else { "" }
            return LineState::{ mode, depth, delim, sub_mode, sub_depth, sub_delim, tag: enc }
          }
        } else {
          can_regex = false
          prev_was_fn = false
        }
        continue
      }
    }

    // Comments: `//` and `/*`
    if c == 47 && p + 1 < end {
      let n1 = src[p + 1]
      if n1 == 47 {
        let mut cend = p + 2
        while cend < end && src[cend] != 13 {
          cend = cend + 1
        }
        push_span(out, base_idx, p, cend, TokenKind::Comment)
        p = cend
        if p >= end {
          if pp_cont_next {
            return make_state(mode_c_pp_cont, 0, 0)
          }
          let enc = if mode == mode_template_str && delim > 0 { stack_encode(tpl_stack) } else { tag }
          return LineState::{ mode, depth, delim, sub_mode, sub_depth, sub_delim, tag: enc }
        }
        continue
      }
      if n1 == 42 {
        let cstart = p
        let (np, nd) = scan_block_comment_body(src, p + 2, end, 1, nested_comments)
        push_span(out, base_idx, cstart, np, TokenKind::Comment)
        p = np
        if nd > 0 {
          if mode == mode_template_str {
            let enc = if delim > 0 { stack_encode(tpl_stack) } else { "" }
            return LineState::{
              mode: mode_block_comment,
              depth: nd,
              delim: 0,
              sub_mode: mode_template_str,
              sub_depth: depth,
              sub_delim: delim,
              tag: enc,
            }
          }
          return make_state(mode_block_comment, nd, 0)
        }
        continue
      }
    }

    // JS/TS regex literal `/pattern/flags` when in expression-start position
    if is_js_family && can_regex && !no_more_regex && c == 47 {
      let r_end = scan_js_regex(src, p, end)
      if r_end > p {
        push_span(out, base_idx, p, r_end, TokenKind::String)
        p = r_end
        can_regex = false
        prev_was_fn = false
        continue
      }
      no_more_regex = true
    }

    // JS/TS JSX element `<Tag ...>...</Tag>`
    if is_js_family && can_regex && c == 60 && looks_like_jsx_open(src, p, end) {
      let (np, self_close) = scan_jsx_open_tag(lang, src, p, end, out, base_idx)
      p = np
      prev_was_fn = false
      if self_close {
        can_regex = false
      } else {
        let (np2, rem) = scan_jsx_children(lang, src, p, end, 1, out, base_idx)
        p = np2
        if rem > 0 {
          return make_state(mode_jsx_text, rem, 0)
        }
        can_regex = false
      }
      continue
    }

    // PHP `<?php` / `?>` tags and `$variable`
    if is_php {
      if c == 60 && p + 1 < end && src[p + 1] == 63 {
        let tstart = p
        p = p + 2
        while p < end && is_ascii_alpha(src[p]) {
          p = p + 1
        }
        push_span(out, base_idx, tstart, p, TokenKind::Tag)
        continue
      }
      if c == 63 && p + 1 < end && src[p + 1] == 62 {
        push_span(out, base_idx, p, p + 2, TokenKind::Tag)
        p = p + 2
        continue
      }
      if c == 36 && p + 1 < end && is_ident_start(src[p + 1]) {
        let vstart = p
        p = p + 2
        while p < end && is_ident_cont(src[p]) {
          p = p + 1
        }
        push_span(out, base_idx, vstart, p, TokenKind::Variable)
        continue
      }
      if c == 35 {
        push_span(out, base_idx, p, end, TokenKind::Comment)
        return LineState::initial()
      }
    }

    // `#` constructs: Pion `#|` / `#attr`, Rust `#[...]` / `#![...]`, C/C++ preprocessor `#include` / `#define`, C# `#region`
    if c == 35 {
      if is_pion {
        if p + 1 < end && src[p + 1] == 124 {
          push_span(out, base_idx, p, end, TokenKind::String)
          return LineState::{ mode, depth, delim, sub_mode, sub_depth, sub_delim, tag }
        }
        if p + 1 < end && is_ident_start(src[p + 1]) {
          let astart = p
          p = p + 2
          while p < end && is_ident_cont(src[p]) {
            p = p + 1
          }
          push_span(out, base_idx, astart, p, TokenKind::Attribute)
          continue
        }
      } else if is_rust {
        if (p + 1 < end && src[p + 1] == 91) || (p + 2 < end && src[p + 1] == 33 && src[p + 2] == 91) {
          let astart = p
          let mut bdepth = 0
          while p < end {
            if src[p] == 91 {
              bdepth = bdepth + 1
            } else if src[p] == 93 {
              bdepth = bdepth - 1
              p = p + 1
              if bdepth == 0 {
                break
              }
              continue
            } else if src[p] == 34 {
              p = scan_quoted_string(src, p, end, 34, true)
              continue
            }
            p = p + 1
          }
          push_span(out, base_idx, astart, p, TokenKind::Attribute)
          continue
        }
      } else if is_c || is_cpp || is_csharp {
        let astart = p
        p = p + 1
        while p < end && is_ws_inline(src[p]) {
          p = p + 1
        }
        let dname_start = p
        while p < end && is_ident_cont(src[p]) {
          p = p + 1
        }
        let dname_len = p - dname_start
        push_span(out, base_idx, astart, p, TokenKind::Attribute)
        // C/C++ `#include <header>`
        if (is_c || is_cpp) && eq_word(src, dname_start, dname_len, "include") {
          let ws_start = p
          while p < end && is_ws_inline(src[p]) {
            p = p + 1
          }
          if p > ws_start {
            push_span(out, base_idx, ws_start, p, TokenKind::Plain)
          }
          if p < end && src[p] == 60 {
            let hstart = p
            p = p + 1
            while p < end && src[p] != 62 {
              p = p + 1
            }
            if p < end && src[p] == 62 {
              p = p + 1
            }
            push_span(out, base_idx, hstart, p, TokenKind::String)
          }
        }
        // C/C++ `#define ... \` continuation
        if (is_c || is_cpp) && ends_with_odd_backslashes(src, start, end) {
          pp_cont_next = true
        }
        continue
      }
    }

    // `@decorator` / `@Annotation` (TS/JS/Pion/Java/Kotlin/Swift)
    if c == 64 && has_at_attr && p + 1 < end && is_ident_start(src[p + 1]) {
      let astart = p
      p = p + 2
      while p < end && (is_ident_cont(src[p]) || src[p] == 46) {
        p = p + 1
      }
      push_span(out, base_idx, astart, p, TokenKind::Attribute)
      continue
    }

    // C++ `[[attribute]]` (UTF-8 safe even when unclosed!)
    if is_cpp && c == 91 && p + 1 < end && src[p + 1] == 91 {
      let astart = p
      p = p + 2
      let mut closed = false
      while p + 1 < end {
        if src[p] == 93 && src[p + 1] == 93 {
          p = p + 2
          closed = true
          break
        }
        p = p + 1
      }
      if !closed {
        p = end
      }
      push_span(out, base_idx, astart, p, TokenKind::Attribute)
      continue
    }

    // C++ raw strings `R"delim(...)delim"` (and `u8R"`, `uR"`, `UR"`, `LR"`)
    if is_cpp && (c == 82 || c == 76 || c == 85 || c == 117) {
      let mut rp = p
      if c == 117 && rp + 2 < end && src[rp + 1] == 56 && src[rp + 2] == 82 {
        rp = rp + 2
      } else if (c == 76 || c == 85 || c == 117) && rp + 1 < end && src[rp + 1] == 82 {
        rp = rp + 1
      }
      if src[rp] == 82 && rp + 1 < end && src[rp + 1] == 34 {
        let dstart = rp + 2
        let mut dp = dstart
        while dp < end && dp - dstart <= 16 && src[dp] != 40 && !is_ws_inline(src[dp]) && src[dp] != 92 && src[dp] != 41 {
          dp = dp + 1
        }
        if dp < end && src[dp] == 40 {
          let rdelim = src.slice(dstart, dp)
          let (np, closed) = scan_cpp_raw_body(src, dp + 1, end, rdelim)
          push_span(out, base_idx, p, np, TokenKind::String)
          p = np
          if !closed {
            return LineState::{
              mode: mode_cpp_raw_str,
              depth: 0,
              delim: 0,
              sub_mode: 0,
              sub_depth: 0,
              sub_delim: 0,
              tag: rdelim,
            }
          }
          continue
        }
      }
    }

    // Double-quoted strings
    if c == 34 {
      can_regex = false
      prev_was_fn = false
      if is_pion {
        p = scan_pion_string(src, p, end, out, base_idx)
      } else if is_c || is_cpp {
        let mut sp = p + 1
        let mut closed = false
        while sp < end {
          let ch = src[sp]
          if ch == 92 {
            sp = sp + 1
            if sp < end {
              sp = sp + utf8_char_step(src, sp, end)
            }
            continue
          }
          if ch == 34 {
            sp = sp + 1
            closed = true
            break
          }
          sp = sp + 1
        }
        push_span(out, base_idx, p, sp, TokenKind::String)
        p = sp
        if !closed && ends_with_odd_backslashes(src, start, end) {
          return make_state(mode_c_str_cont, 0, 34)
        }
      } else {
        let np = scan_quoted_string(src, p, end, 34, true)
        push_span(out, base_idx, p, np, TokenKind::String)
        p = np
      }
      continue
    }

    // Single-quoted strings / char literals / Rust lifetimes
    if c == 39 {
      can_regex = false
      prev_was_fn = false
      if is_rust {
        if p + 1 < end && src[p + 1] == 92 {
          let np = scan_quoted_string(src, p, end, 39, true)
          push_span(out, base_idx, p, np, TokenKind::String)
          p = np
        } else if p + 2 < end && src[p + 2] == 39 {
          push_span(out, base_idx, p, p + 3, TokenKind::String)
          p = p + 3
        } else if p + 1 < end && is_ident_start(src[p + 1]) {
          let lstart = p
          p = p + 2
          while p < end && is_ident_cont(src[p]) {
            p = p + 1
          }
          push_span(out, base_idx, lstart, p, TokenKind::Attribute)
        } else {
          push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
          p = p + 1
        }
      } else {
        let np = scan_quoted_string(src, p, end, 39, true)
        push_span(out, base_idx, p, np, TokenKind::String)
        p = np
      }
      continue
    }

    // Backtick strings (Go raw string / JS & TS template string with nesting stack)
    if c == 96 {
      prev_was_fn = false
      if is_go {
        let bstart = p
        let (np, closed) = scan_backtick_body(src, p + 1, end)
        push_span(out, base_idx, bstart, np, TokenKind::String)
        p = np
        if !closed {
          return make_state(mode_raw_str, 0, 96)
        }
        continue
      }
      if is_js_family {
        // If already inside an outer template `${ ... }`, push outer brace depth onto O(1) Array stack
        let mut pushed_outer = false
        if mode == mode_template_str && depth > 0 {
          tpl_stack.push(depth)
          pushed_outer = true
        }
        let tstart = p
        let (np, status) = scan_template_segment(src, p + 1, end)
        push_span(out, base_idx, tstart, np, TokenKind::String)
        p = np
        if status == 0 {
          // Closed on same line: undo outer push if any, keep outer template state unchanged!
          if pushed_outer {
            let _ = tpl_stack.pop()
          }
          can_regex = false
        } else if status == 1 {
          push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
          p = p + 2
          mode = mode_template_str
          depth = 1
          if pushed_outer {
            delim = delim + 1
          }
          can_regex = true
        } else {
          let next_delim = if pushed_outer { delim + 1 } else { delim }
          let enc = if next_delim > 0 { stack_encode(tpl_stack) } else { "" }
          return LineState::{
            mode: mode_template_str,
            depth: 0,
            delim: next_delim,
            sub_mode: 0,
            sub_depth: 0,
            sub_delim: 0,
            tag: enc,
          }
        }
        continue
      }
    }

    // Rust raw strings `r"..."`, `r#"..."#`, byte strings/chars `b"..."`, `b'x'`, `br#"..."#`, C strings `c"..."`, `cr#"..."#`
    if is_rust && (c == 114 || c == 98 || c == 99) {
      let mut rp = p
      let mut is_raw = false
      if (c == 98 || c == 99) && rp + 1 < end && src[rp + 1] == 34 {
        let np = scan_quoted_string(src, rp + 1, end, 34, true)
        push_span(out, base_idx, p, np, TokenKind::String)
        p = np
        continue
      }
      if c == 98 && rp + 1 < end && src[rp + 1] == 39 {
        let np = scan_quoted_string(src, rp + 1, end, 39, true)
        push_span(out, base_idx, p, np, TokenKind::String)
        p = np
        continue
      }
      if (c == 98 || c == 99) && rp + 1 < end && src[rp + 1] == 114 {
        rp = rp + 1
        is_raw = true
      } else if c == 114 {
        is_raw = true
      }
      if is_raw {
        let mut h = 0
        while rp + 1 + h < end && src[rp + 1 + h] == 35 {
          h = h + 1
        }
        if rp + 1 + h < end && src[rp + 1 + h] == 34 {
          let (np, closed) = scan_rust_raw_body(src, rp + 2 + h, end, h)
          push_span(out, base_idx, p, np, TokenKind::String)
          p = np
          if !closed {
            return make_state(mode_raw_str, h, 34)
          }
          continue
        }
      }
    }

    // Numbers
    if is_ascii_digit(c) {
      let np = scan_number(src, p, end, is_cpp, true)
      push_span(out, base_idx, p, np, TokenKind::Number)
      p = np
      can_regex = false
      prev_was_fn = false
      continue
    }

    // Identifiers / keywords / types / functions / namespaces / macros
    if (is_js_family && is_js_ident_start(c)) || is_ident_start(c) {
      let istart = p
      p = p + 1
      if is_js_family {
        while p < end && is_js_ident_cont(src[p]) {
          p = p + 1
        }
      } else {
        while p < end && is_ident_cont(src[p]) {
          p = p + 1
        }
      }
      // Rust macro `name!`
      if is_rust && p < end && src[p] == 33 && (p + 1 >= end || src[p + 1] != 61) {
        p = p + 1
        push_span(out, base_idx, istart, p, TokenKind::Function)
        can_regex = false
        prev_was_fn = false
        continue
      }
      let ilen = p - istart
      let mut kind = classify_code_ident(lang, src, istart, ilen)
      if prev_was_fn && (token_kind_eq(kind, TokenKind::Plain) || token_kind_eq(kind, TokenKind::Type)) {
        kind = TokenKind::Function
      } else if token_kind_eq(kind, TokenKind::Plain) {
        if has_namespace && peek_double_colon(src, p, end) {
          kind = TokenKind::Namespace
        } else if peek_non_ws(src, p, end) == 40 {
          kind = TokenKind::Function
        }
      } else if is_csharp && token_kind_eq(kind, TokenKind::Type) && peek_non_ws(src, p, end) == 40 {
        kind = TokenKind::Function
      }
      push_span(out, base_idx, istart, p, kind)
      prev_was_fn = (is_rust && eq_word(src, istart, ilen, "fn")) ||
      (is_pion && eq_word(src, istart, ilen, "fn")) ||
      (is_js_family && eq_word(src, istart, ilen, "function")) ||
      (is_kotlin && eq_word(src, istart, ilen, "fun")) ||
      (is_swift && eq_word(src, istart, ilen, "func")) ||
      (is_go && eq_word(src, istart, ilen, "func")) ||
      (is_php && eq_word_ci(src, istart, ilen, "function"))
      if is_js_family {
        can_regex = token_kind_eq(kind, TokenKind::Keyword) && js_kw_allows_regex(src, istart, ilen)
      }
      continue
    }

    // Multi-char operators
    if c == 46 && p + 2 < end && src[p + 1] == 46 && src[p + 2] == 46 {
      push_span(out, base_idx, p, p + 3, TokenKind::Operator)
      p = p + 3
      can_regex = true
      prev_was_fn = false
      continue
    }
    if (c == 61 || c == 33) && p + 2 < end && src[p + 1] == 61 && src[p + 2] == 61 {
      push_span(out, base_idx, p, p + 3, TokenKind::Operator)
      p = p + 3
      can_regex = true
      prev_was_fn = false
      continue
    }
    if p + 1 < end {
      let n1 = src[p + 1]
      let is_two_op = (c == 61 && (n1 == 61 || n1 == 62)) ||
      (c == 33 && n1 == 61) ||
      (c == 60 && (n1 == 61 || n1 == 60 || n1 == 45)) ||
      (c == 62 && (n1 == 61 || n1 == 62)) ||
      (c == 38 && (n1 == 38 || n1 == 61)) ||
      (c == 124 && (n1 == 124 || n1 == 61)) ||
      (c == 45 && (n1 == 62 || n1 == 61 || n1 == 45)) ||
      (c == 43 && (n1 == 61 || n1 == 43)) ||
      (c == 58 && (n1 == 58 || n1 == 61)) ||
      (c == 63 && (n1 == 63 || n1 == 46)) ||
      (c == 42 && (n1 == 61 || n1 == 42)) ||
      (c == 47 && n1 == 61)
      if is_two_op {
        push_span(out, base_idx, p, p + 2, TokenKind::Operator)
        p = p + 2
        can_regex = !((c == 43 && n1 == 43) || (c == 45 && n1 == 45))
        prev_was_fn = false
        continue
      }
    }

    // Single-char operators vs punctuation
    if c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 61 || c == 60 || c == 62 || c == 33 || c == 38 || c == 124 || c == 94 || c == 126 || c == 63 {
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      can_regex = true
      if !(c == 42 && prev_was_fn) {
        prev_was_fn = false
      }
      p = p + 1
    } else if c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 44 || c == 59 || c == 58 || c == 46 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      can_regex = c == 40 || c == 91 || c == 123 || c == 44 || c == 59 || c == 58
      prev_was_fn = false
      p = p + 1
    } else {
      let step = utf8_char_step(src, p, end)
      push_span(out, base_idx, p, p + step, TokenKind::Plain)
      prev_was_fn = false
      p = p + step
    }
  }

  if pp_cont_next {
    return make_state(mode_c_pp_cont, 0, 0)
  }
  let final_tag = if mode == mode_template_str && delim > 0 {
    stack_encode(tpl_stack)
  } else if mode == mode_template_str {
    ""
  } else {
    tag
  }
  LineState::{ mode, depth, delim, sub_mode, sub_depth, sub_delim, tag: final_tag }
}

///| Check if `b` is a valid Python string prefix letter (`f`, `r`, `b`, `u`, uppercase).
fn is_py_str_prefix(b : Int) -> Bool {
  let l = to_lower_ascii(b)
  l == 102 || l == 114 || l == 98 || l == 117
}

///| Scan a Python f-string body (single or triple quoted) with `{expr}` interpolation.
///| Escaped `{{` / `}}` stay inside the string literal. Returns `(next_pos, closed)`.
fn scan_python_fstr_body(
  src : String,
  seg_start_init : Int,
  pos : Int,
  end : Int,
  quote : Int,
  triple : Bool,
  allow_esc : Bool,
  out : Array[Span],
  base_idx : Int,
) -> (Int, Bool) {
  let mut p = pos
  let mut seg_start = seg_start_init
  while p < end {
    let c = src[p]
    if allow_esc && c == 92 {
      p = p + 1
      if p < end {
        p = p + utf8_char_step(src, p, end)
      }
      continue
    }
    if triple {
      if c == quote && p + 2 < end && src[p + 1] == quote && src[p + 2] == quote {
        push_span(out, base_idx, seg_start, p + 3, TokenKind::String)
        return (p + 3, true)
      }
    } else if c == quote {
      push_span(out, base_idx, seg_start, p + 1, TokenKind::String)
      return (p + 1, true)
    }
    // Escaped `{{` or `}}`
    if (c == 123 || c == 125) && p + 1 < end && src[p + 1] == c {
      p = p + 2
      continue
    }
    // Replacement field `{ ... }`
    if c == 123 {
      if p > seg_start {
        push_span(out, base_idx, seg_start, p, TokenKind::String)
      }
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      p = p + 1
      let expr_start = p
      let mut bdepth = 1
      while p < end && bdepth > 0 {
        let ec = src[p]
        if ec == 123 {
          bdepth = bdepth + 1
          p = p + 1
        } else if ec == 125 {
          bdepth = bdepth - 1
          if bdepth == 0 {
            break
          }
          p = p + 1
        } else if ec == 34 || ec == 39 {
          p = scan_quoted_string(src, p, end, ec, true)
        } else {
          p = p + 1
        }
      }
      if p > expr_start {
        let _ = scan_python_line(LineState::initial(), src, expr_start, p, out, base_idx)
      }
      if p < end && src[p] == 125 {
        push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
        p = p + 1
      }
      seg_start = p
      continue
    }
    p = p + 1
  }
  push_span(out, base_idx, seg_start, end, TokenKind::String)
  (end, false)
}

///| Zero-allocation line scanner for Python.
fn scan_python_line(
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start

  if state.mode == mode_triple_double || state.mode == mode_triple_single {
    let q = if state.mode == mode_triple_double { 34 } else { 39 }
    let allow_esc = (state.depth & 1) == 0
    let is_fstr = (state.depth & 2) != 0
    let (np, closed) = if is_fstr {
      scan_python_fstr_body(src, p, p, end, q, true, allow_esc, out, base_idx)
    } else {
      let (np2, cl2) = scan_triple_string_body(src, p, end, q, allow_esc)
      push_span(out, base_idx, p, np2, TokenKind::String)
      (np2, cl2)
    }
    p = np
    if !closed {
      return state
    }
  }

  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws_start = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      continue
    }
    // `#` comment
    if c == 35 {
      push_span(out, base_idx, p, end, TokenKind::Comment)
      return LineState::initial()
    }
    // `@decorator`
    if c == 64 && p + 1 < end && is_ident_start(src[p + 1]) {
      let astart = p
      p = p + 2
      while p < end && (is_ident_cont(src[p]) || src[p] == 46) {
        p = p + 1
      }
      push_span(out, base_idx, astart, p, TokenKind::Attribute)
      continue
    }
    // Prefixed strings (`f"..."`, `r"..."`, `b"..."`, `rb'''...'''`, `fr"""..."""`, etc.)
    if is_py_str_prefix(c) {
      let mut qp = p + 1
      let lc0 = to_lower_ascii(c)
      let mut is_raw = lc0 == 114
      let mut is_fstr = lc0 == 102
      if qp < end && is_py_str_prefix(src[qp]) {
        let lc1 = to_lower_ascii(src[qp])
        if lc1 == 114 {
          is_raw = true
        }
        if lc1 == 102 {
          is_fstr = true
        }
        qp = qp + 1
      }
      if qp < end && (src[qp] == 34 || src[qp] == 39) {
        let q = src[qp]
        let allow_esc = !is_raw
        let flags = (if is_raw { 1 } else { 0 }) | (if is_fstr { 2 } else { 0 })
        if qp + 2 < end && src[qp + 1] == q && src[qp + 2] == q {
          let (np, closed) = if is_fstr {
            scan_python_fstr_body(src, p, qp + 3, end, q, true, allow_esc, out, base_idx)
          } else {
            let (np2, cl2) = scan_triple_string_body(src, qp + 3, end, q, allow_esc)
            push_span(out, base_idx, p, np2, TokenKind::String)
            (np2, cl2)
          }
          p = np
          if !closed {
            let m = if q == 34 { mode_triple_double } else { mode_triple_single }
            return make_state(m, flags, q)
          }
          continue
        }
        if is_fstr {
          let (np, _) = scan_python_fstr_body(src, p, qp + 1, end, q, false, allow_esc, out, base_idx)
          p = np
          continue
        }
        let np = scan_quoted_string(src, qp, end, q, allow_esc)
        push_span(out, base_idx, p, np, TokenKind::String)
        p = np
        continue
      }
    }
    // Triple or single/double quoted strings
    if c == 34 || c == 39 {
      if p + 2 < end && src[p + 1] == c && src[p + 2] == c {
        let (np, closed) = scan_triple_string_body(src, p + 3, end, c, true)
        push_span(out, base_idx, p, np, TokenKind::String)
        p = np
        if !closed {
          let m = if c == 34 { mode_triple_double } else { mode_triple_single }
          return make_state(m, 0, c)
        }
        continue
      }
      let np = scan_quoted_string(src, p, end, c, true)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      continue
    }
    // Numbers
    if is_ascii_digit(c) {
      let np = scan_number(src, p, end, false, true)
      push_span(out, base_idx, p, np, TokenKind::Number)
      p = np
      continue
    }
    // Identifiers
    if is_ident_start(c) {
      let istart = p
      p = p + 1
      while p < end && is_ident_cont(src[p]) {
        p = p + 1
      }
      let mut kind = classify_python(src, istart, p - istart)
      if token_kind_eq(kind, TokenKind::Plain) && peek_non_ws(src, p, end) == 40 {
        kind = TokenKind::Function
      }
      push_span(out, base_idx, istart, p, kind)
      continue
    }
    // Multi-char operators: `//`, `**`, `:=`, `->`, `==`, `!=`, `<=`, `>=`
    if p + 1 < end {
      let n1 = src[p + 1]
      if (c == 47 && n1 == 47) ||
      (c == 42 && n1 == 42) ||
      (c == 58 && n1 == 61) ||
      (c == 45 && n1 == 62) ||
      (c == 61 && n1 == 61) ||
      (c == 33 && n1 == 61) ||
      (c == 60 && (n1 == 61 || n1 == 60)) ||
      (c == 62 && (n1 == 61 || n1 == 62)) {
        push_span(out, base_idx, p, p + 2, TokenKind::Operator)
        p = p + 2
        continue
      }
    }
    if c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 61 || c == 60 || c == 62 || c == 38 || c == 124 || c == 94 || c == 126 {
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      p = p + 1
    } else if c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 44 || c == 59 || c == 58 || c == 46 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      p = p + 1
    } else {
      let step = utf8_char_step(src, p, end)
      push_span(out, base_idx, p, p + step, TokenKind::Plain)
      p = p + step
    }
  }

  LineState::initial()
}

///| Scan Shell single-quoted string body starting at `pos` (after opening `'` or at start of continuation line).
///| Returns `(next_pos, closed)`.
fn scan_shell_single_body(src : String, pos : Int, end : Int) -> (Int, Bool) {
  let mut p = pos
  while p < end {
    if src[p] == 39 {
      return (p + 1, true)
    }
    p = p + 1
  }
  (end, false)
}

///| Scan Shell arithmetic expansion `$(( ... ))` starting at `pos` (`src[pos] == '$'`).
fn scan_shell_arith(
  src : String,
  pos : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> Int {
  push_span(out, base_idx, pos, pos + 3, TokenKind::Punctuation)
  let mut p = pos + 3
  let mut pdepth = 0
  while p < end {
    let c = src[p]
    if c == 41 && pdepth == 0 && p + 1 < end && src[p + 1] == 41 {
      push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
      return p + 2
    }
    if is_ws_inline(c) {
      let ws = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws, p, TokenKind::Plain)
      continue
    }
    if c == 40 {
      pdepth = pdepth + 1
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      p = p + 1
      continue
    }
    if c == 41 {
      if pdepth > 0 {
        pdepth = pdepth - 1
      }
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      p = p + 1
      continue
    }
    if is_ascii_digit(c) {
      let np = scan_number(src, p, end, false, false)
      push_span(out, base_idx, p, np, TokenKind::Number)
      p = np
      continue
    }
    if is_ident_start(c) {
      let istart = p
      p = p + 1
      while p < end && is_ident_cont(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, istart, p, TokenKind::Variable)
      continue
    }
    if c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 61 || c == 60 || c == 62 || c == 33 || c == 38 || c == 124 || c == 94 || c == 126 || c == 63 || c == 58 {
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      p = p + 1
      continue
    }
    let step = utf8_char_step(src, p, end)
    push_span(out, base_idx, p, p + step, TokenKind::Plain)
    p = p + step
  }
  end
}

///| Scan Shell double-quoted string body starting at `pos` (with `seg_start` for prefix inclusion).
///| Supports `\"`, `\\`, and nested `$(...)` command substitution (with inner double quotes).
///| Returns `(next_pos, closed)`.
fn scan_shell_double_body(
  src : String,
  seg_start_init : Int,
  pos : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> (Int, Bool) {
  let mut p = pos
  let mut seg_start = seg_start_init
  while p < end {
    let c = src[p]
    if c == 92 {
      p = p + 1
      if p < end {
        p = p + utf8_char_step(src, p, end)
      }
      continue
    }
    if c == 34 {
      push_span(out, base_idx, seg_start, p + 1, TokenKind::String)
      return (p + 1, true)
    }
    // Nested `$(...)` command substitution inside double-quoted string
    if c == 36 && p + 1 < end && src[p + 1] == 40 {
      if p > seg_start {
        push_span(out, base_idx, seg_start, p, TokenKind::String)
      }
      if p + 2 < end && src[p + 2] == 40 {
        p = scan_shell_arith(src, p, end, out, base_idx)
        seg_start = p
        continue
      }
      push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
      p = p + 2
      let sub_start = p
      let mut pdepth = 1
      while p < end && pdepth > 0 {
        let sc = src[p]
        if sc == 92 {
          p = p + 1
          if p < end {
            p = p + utf8_char_step(src, p, end)
          }
        } else if sc == 34 {
          p = scan_quoted_string(src, p, end, 34, true)
        } else if sc == 39 {
          p = scan_quoted_string(src, p, end, 39, false)
        } else if sc == 40 {
          pdepth = pdepth + 1
          p = p + 1
        } else if sc == 41 {
          pdepth = pdepth - 1
          if pdepth == 0 {
            break
          }
          p = p + 1
        } else {
          p = p + 1
        }
      }
      if p > sub_start {
        let _ = scan_shell_line(LineState::initial(), src, sub_start, p, out, base_idx)
      }
      if p < end && src[p] == 41 {
        push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
        p = p + 1
      }
      seg_start = p
      continue
    }
    p = p + 1
  }
  push_span(out, base_idx, seg_start, end, TokenKind::String)
  (end, false)
}

///| Zero-allocation line scanner for Shell (sh / bash / zsh).
fn scan_shell_line(
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start

  // Continuing heredoc body
  if state.mode == mode_shell_heredoc {
    let mut check_start = start
    if state.delim == 1 {
      while check_start < end && src[check_start] == 9 {
        check_start = check_start + 1
      }
    }
    if end - check_start == state.tag.length() && eq_word(src, check_start, end - check_start, state.tag) {
      if check_start > start {
        push_span(out, base_idx, start, check_start, TokenKind::Plain)
      }
      push_span(out, base_idx, check_start, end, TokenKind::Keyword)
      return LineState::initial()
    }
    push_span(out, base_idx, start, end, TokenKind::String)
    return state
  }

  // Continuing multi-line single-quoted string
  if state.mode == mode_shell_single {
    let (np, closed) = scan_shell_single_body(src, p, end)
    push_span(out, base_idx, p, np, TokenKind::String)
    p = np
    if !closed {
      return state
    }
  } else if state.mode == mode_shell_double {
    let (np, closed) = scan_shell_double_body(src, p, p, end, out, base_idx)
    p = np
    if !closed {
      return state
    }
  }

  let mut pending_heredoc = ""
  let mut pending_strip_tabs = 0

  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws_start = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      continue
    }
    // Backslash escape outside quotes (`\'`, `\"`, `\\`, `\#`)
    if c == 92 && p + 1 < end {
      let step = utf8_char_step(src, p + 1, end)
      push_span(out, base_idx, p, p + 1 + step, TokenKind::Plain)
      p = p + 1 + step
      continue
    }
    // Comment or shebang `#` (at start of line or after whitespace / `;`)
    if c == 35 && (p == start || is_ws_inline(src[p - 1]) || src[p - 1] == 59) {
      push_span(out, base_idx, p, end, TokenKind::Comment)
      if pending_heredoc.length() > 0 {
        return LineState::{
          mode: mode_shell_heredoc,
          depth: 0,
          delim: pending_strip_tabs,
          sub_mode: 0,
          sub_depth: 0,
          sub_delim: 0,
          tag: pending_heredoc,
        }
      }
      return LineState::initial()
    }
    // Arithmetic expansion `$((...))` and command substitution `$(...)` and variables
    if c == 36 {
      if p + 2 < end && src[p + 1] == 40 && src[p + 2] == 40 {
        p = scan_shell_arith(src, p, end, out, base_idx)
        continue
      }
      if p + 1 < end && src[p + 1] == 40 {
        push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
        p = p + 2
        continue
      }
      let vstart = p
      if p + 1 < end && src[p + 1] == 123 {
        p = p + 2
        while p < end && src[p] != 125 {
          p = p + 1
        }
        if p < end && src[p] == 125 {
          p = p + 1
        }
        push_span(out, base_idx, vstart, p, TokenKind::Variable)
        continue
      }
      if p + 1 < end {
        let n1 = src[p + 1]
        if is_ident_start(n1) {
          p = p + 2
          while p < end && is_ident_cont(src[p]) {
            p = p + 1
          }
          push_span(out, base_idx, vstart, p, TokenKind::Variable)
          continue
        }
        if is_ascii_digit(n1) || n1 == 63 || n1 == 64 || n1 == 35 || n1 == 42 || n1 == 36 || n1 == 33 {
          push_span(out, base_idx, vstart, p + 2, TokenKind::Variable)
          p = p + 2
          continue
        }
      }
    }
    // Double-quoted strings (may span lines and contain nested `$(...)`)
    if c == 34 {
      let (np, closed) = scan_shell_double_body(src, p, p + 1, end, out, base_idx)
      p = np
      if !closed {
        return make_state(mode_shell_double, 0, 34)
      }
      continue
    }
    // Single-quoted strings (may span lines; `#` inside is string, not comment)
    if c == 39 {
      let (np, closed) = scan_shell_single_body(src, p + 1, end)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      if !closed {
        return make_state(mode_shell_single, 0, 39)
      }
      continue
    }
    // Heredoc `<<EOF`, `<<-EOF`, `<<'EOF'`, `<<"EOF"`, `<<\EOF` (not `<<<`)
    if c == 60 && p + 1 < end && src[p + 1] == 60 && (p + 2 >= end || src[p + 2] != 60) {
      let mut op_end = p + 2
      let mut strip_tabs = 0
      if op_end < end && src[op_end] == 45 {
        strip_tabs = 1
        op_end = op_end + 1
      }
      push_span(out, base_idx, p, op_end, TokenKind::Operator)
      p = op_end
      let ws_start = p
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      if p > ws_start {
        push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      }
      // Read heredoc delimiter word
      if p < end {
        let d_raw_start = p
        let mut hdelim = ""
        if src[p] == 39 || src[p] == 34 {
          let q = src[p]
          let np = scan_quoted_string(src, p, end, q, false)
          if np > p + 2 && src[np - 1] == q {
            hdelim = src.slice(p + 1, np - 1)
          }
          push_span(out, base_idx, d_raw_start, np, TokenKind::String)
          p = np
        } else {
          if src[p] == 92 && p + 1 < end {
            p = p + 1
          }
          let wstart = p
          while p < end && !is_ws_inline(src[p]) && src[p] != 59 && src[p] != 38 && src[p] != 124 && src[p] != 35 {
            p = p + 1
          }
          hdelim = src.slice(wstart, p)
          push_span(out, base_idx, d_raw_start, p, TokenKind::Keyword)
        }
        if hdelim.length() > 0 && pending_heredoc.length() == 0 {
          pending_heredoc = hdelim
          pending_strip_tabs = strip_tabs
        }
      }
      continue
    }
    // Numbers
    if is_ascii_digit(c) && (p == start || !is_ident_cont(src[p - 1])) {
      let np = scan_number(src, p, end, false, false)
      push_span(out, base_idx, p, np, TokenKind::Number)
      p = np
      continue
    }
    // Identifiers / keywords
    if is_ident_start(c) {
      let istart = p
      p = p + 1
      while p < end && is_ident_cont(src[p]) {
        p = p + 1
      }
      let kind = classify_shell(src, istart, p - istart)
      push_span(out, base_idx, istart, p, kind)
      continue
    }
    // Multi-char shell operators: `&&`, `||`, `>>`, `<<<`, `;;`
    if p + 1 < end {
      let n1 = src[p + 1]
      if c == 60 && n1 == 60 && p + 2 < end && src[p + 2] == 60 {
        push_span(out, base_idx, p, p + 3, TokenKind::Operator)
        p = p + 3
        continue
      }
      if (c == 38 && n1 == 38) || (c == 124 && n1 == 124) || (c == 62 && n1 == 62) {
        push_span(out, base_idx, p, p + 2, TokenKind::Operator)
        p = p + 2
        continue
      }
      if c == 59 && n1 == 59 {
        push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
        p = p + 2
        continue
      }
    }
    if c == 124 || c == 38 || c == 62 || c == 60 || c == 61 {
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      p = p + 1
    } else if c == 59 || c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      p = p + 1
    } else {
      let step = utf8_char_step(src, p, end)
      push_span(out, base_idx, p, p + step, TokenKind::Plain)
      p = p + step
    }
  }
  if pending_heredoc.length() > 0 {
    return LineState::{
      mode: mode_shell_heredoc,
      depth: 0,
      delim: pending_strip_tabs,
      sub_mode: 0,
      sub_depth: 0,
      sub_delim: 0,
      tag: pending_heredoc,
    }
  }
  LineState::initial()
}

///| Zero-allocation line scanner for Ruby.
fn scan_ruby_line(
  _state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start
  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws, p, TokenKind::Plain)
      continue
    }
    if c == 35 {
      push_span(out, base_idx, p, end, TokenKind::Comment)
      return LineState::initial()
    }
    if c == 34 || c == 39 {
      let np = scan_quoted_string(src, p, end, c, c == 34)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      continue
    }
    // Ruby symbols `:sym`
    if c == 58 && p + 1 < end && is_ident_start(src[p + 1]) {
      let sstart = p
      p = p + 2
      while p < end && is_ident_cont(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, sstart, p, TokenKind::Constant)
      continue
    }
    // Instance/class/global variables `@var`, `@@var`, `$var`
    if (c == 64 || c == 36) && p + 1 < end && (is_ident_start(src[p + 1]) || src[p + 1] == 64) {
      let vstart = p
      p = p + 1
      if p < end && src[p] == 64 {
        p = p + 1
      }
      while p < end && is_ident_cont(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, vstart, p, TokenKind::Variable)
      continue
    }
    if is_ascii_digit(c) {
      let np = scan_number(src, p, end, false, false)
      push_span(out, base_idx, p, np, TokenKind::Number)
      p = np
      continue
    }
    if is_ident_start(c) {
      let istart = p
      p = p + 1
      while p < end && is_ident_cont(src[p]) {
        p = p + 1
      }
      if p < end && (src[p] == 63 || src[p] == 33) {
        p = p + 1
      }
      let mut kind = classify_ruby(src, istart, p - istart)
      if token_kind_eq(kind, TokenKind::Plain) && peek_non_ws(src, p, end) == 40 {
        kind = TokenKind::Function
      }
      push_span(out, base_idx, istart, p, kind)
      continue
    }
    if c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 61 || c == 60 || c == 62 || c == 33 || c == 38 || c == 124 {
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      p = p + 1
    } else if c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 44 || c == 59 || c == 58 || c == 46 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      p = p + 1
    } else {
      let step = utf8_char_step(src, p, end)
      push_span(out, base_idx, p, p + step, TokenKind::Plain)
      p = p + step
    }
  }
  LineState::initial()
}

///| Zero-allocation line scanner for Dockerfile.
fn scan_dockerfile_line(
  _state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start
  while p < end && is_ws_inline(src[p]) {
    p = p + 1
  }
  if p > start {
    push_span(out, base_idx, start, p, TokenKind::Plain)
  }
  if p >= end {
    return LineState::initial()
  }
  if src[p] == 35 {
    push_span(out, base_idx, p, end, TokenKind::Comment)
    return LineState::initial()
  }
  // Leading instruction keyword (FROM, RUN, COPY, ENV, ...)
  if is_ascii_alpha(src[p]) {
    let wstart = p
    p = p + 1
    while p < end && is_ascii_alpha(src[p]) {
      p = p + 1
    }
    if classify_dockerfile_instr(src, wstart, p - wstart) {
      push_span(out, base_idx, wstart, p, TokenKind::Keyword)
    } else {
      push_span(out, base_idx, wstart, p, TokenKind::Plain)
    }
  }
  // Highlight remaining arguments (strings, `$VAR`, numbers, flags)
  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws, p, TokenKind::Plain)
      continue
    }
    if c == 34 || c == 39 {
      let np = scan_quoted_string(src, p, end, c, c == 34)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      continue
    }
    if c == 36 && p + 1 < end {
      let vstart = p
      if src[p + 1] == 123 {
        p = p + 2
        while p < end && src[p] != 125 {
          p = p + 1
        }
        if p < end && src[p] == 125 {
          p = p + 1
        }
        push_span(out, base_idx, vstart, p, TokenKind::Variable)
        continue
      }
      if is_ident_start(src[p + 1]) {
        p = p + 2
        while p < end && is_ident_cont(src[p]) {
          p = p + 1
        }
        push_span(out, base_idx, vstart, p, TokenKind::Variable)
        continue
      }
    }
    if c == 61 {
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      p = p + 1
      continue
    }
    let step = utf8_char_step(src, p, end)
    push_span(out, base_idx, p, p + step, TokenKind::Plain)
    p = p + step
  }
  LineState::initial()
}
