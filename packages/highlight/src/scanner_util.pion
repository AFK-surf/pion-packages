///| Zero-allocation byte-scanning helpers and shared LineState mode constants.

///|
let mode_normal : Int = 0
///|
let mode_block_comment : Int = 1
///|
let mode_triple_double : Int = 2
///|
let mode_triple_single : Int = 3
///|
let mode_template_str : Int = 4
///|
let mode_raw_str : Int = 5
///|
let mode_html_comment : Int = 6
///|
let mode_html_tag : Int = 7
///|
let mode_html_script : Int = 8
///|
let mode_html_style : Int = 9
///|
let mode_yaml_block : Int = 10
///|
let mode_md_fence : Int = 11
///|
let mode_cpp_raw_str : Int = 12
///|
let mode_c_str_cont : Int = 13
///|
let mode_c_pp_cont : Int = 14
///|
let mode_shell_heredoc : Int = 15
///|
let mode_shell_single : Int = 16
///|
let mode_shell_double : Int = 17
///|
let mode_sql_dollar : Int = 18
///|
let mode_jsx_text : Int = 19

///| Construct a LineState with only mode/depth/delim set (zero-allocation empty tag).
fn make_state(mode : Int, depth : Int, delim : Int) -> LineState {
  LineState::{
    mode,
    depth,
    delim,
    sub_mode: 0,
    sub_depth: 0,
    sub_delim: 0,
    tag: "",
  }
}

///| UTF-8 character byte length from leading byte, clamped to remaining bytes.
fn utf8_char_step(src : String, pos : Int, end : Int) -> Int {
  if pos >= end {
    return 0
  }
  let b = src[pos]
  let mut step = 1
  if b >= 0xF0 {
    step = 4
  } else if b >= 0xE0 {
    step = 3
  } else if b >= 0xC0 {
    step = 2
  }
  if pos + step > end {
    end - pos
  } else {
    step
  }
}

///| Check whether `src[start..end)` ends with an odd number of backslashes (`\`).
fn ends_with_odd_backslashes(src : String, start : Int, end : Int) -> Bool {
  let mut p = end
  let mut count = 0
  while p > start && src[p - 1] == 92 {
    count = count + 1
    p = p - 1
  }
  (count & 1) == 1
}

///| Parse a comma-separated stack string into an Array[Int] (O(len), only called on multiline nested templates).
fn stack_decode(stack : String) -> Array[Int] {
  let arr : Array[Int] = Array::new()
  let n = stack.length()
  if n == 0 {
    return arr
  }
  let mut v = 0
  let mut has = false
  let mut i = 0
  while i < n {
    let b = stack[i]
    if b == 44 {
      if has {
        arr.push(v)
        v = 0
        has = false
      }
    } else if b >= 48 && b <= 57 {
      v = v * 10 + (b - 48)
      has = true
    }
    i = i + 1
  }
  if has {
    arr.push(v)
  }
  arr
}

///| Encode an Array[Int] into a comma-separated stack string (O(len), only called at EOL for multiline nested templates).
fn stack_encode(arr : Array[Int]) -> String {
  let n = arr.length()
  if n == 0 {
    return ""
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(arr[i].to_string())
    i = i + 1
  }
  sb.to_string()
}

///|
fn is_ws_inline(b : Int) -> Bool {
  b == 32 || b == 9
}

///|
fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

///|
fn is_ascii_upper(b : Int) -> Bool {
  b >= 65 && b <= 90
}

///|
fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

///|
fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

///|
fn is_bin_digit(b : Int) -> Bool {
  b == 48 || b == 49
}

///|
fn is_oct_digit(b : Int) -> Bool {
  b >= 48 && b <= 55
}

///|
fn is_ident_start(b : Int) -> Bool {
  is_ascii_alpha(b) || b == 95 || b >= 128
}

///|
fn is_ident_cont(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b) || b == 95 || b >= 128
}

///|
fn is_js_ident_start(b : Int) -> Bool {
  is_ident_start(b) || b == 36
}

///|
fn is_js_ident_cont(b : Int) -> Bool {
  is_ident_cont(b) || b == 36
}

///|
fn is_css_ident_char(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b) || b == 95 || b == 45 || b >= 128
}

///|
fn to_lower_ascii(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

///|
fn eq_word(src : String, start : Int, len : Int, kw : String) -> Bool {
  if len != kw.length() {
    return false
  }
  let mut i = 0
  while i < len {
    if src[start + i] != kw[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn eq_word_ci(src : String, start : Int, len : Int, kw_lower : String) -> Bool {
  if len != kw_lower.length() {
    return false
  }
  let mut i = 0
  while i < len {
    if to_lower_ascii(src[start + i]) != kw_lower[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn starts_with_ci(src : String, pos : Int, end : Int, pat_lower : String) -> Bool {
  let plen = pat_lower.length()
  if pos + plen > end {
    return false
  }
  let mut i = 0
  while i < plen {
    if to_lower_ascii(src[pos + i]) != pat_lower[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Push a non-empty span, coalescing with the previous span on the same line if same TokenKind.
fn push_span(
  out : Array[Span],
  base_idx : Int,
  start : Int,
  end : Int,
  kind : TokenKind,
) -> Unit {
  if end <= start {
    return
  }
  let n = out.length()
  if n > base_idx {
    let prev = out[n - 1]
    if prev.end == start && token_kind_eq(prev.kind, kind) {
      out[n - 1] = Span::{ start: prev.start, end, kind }
      return
    }
  }
  out.push(Span::{ start, end, kind })
}

///| Scan a single-line quoted string starting at `pos` (where `src[pos] == quote`).
fn scan_quoted_string(
  src : String,
  pos : Int,
  end : Int,
  quote : Int,
  allow_escape : Bool,
) -> Int {
  let mut p = pos + 1
  while p < end {
    let c = src[p]
    if allow_escape && c == 92 {
      p = p + 2
      if p > end {
        p = end
      }
      continue
    }
    if c == quote {
      return p + 1
    }
    p = p + 1
  }
  end
}

///| Continue or scan a `/* ... */` block comment (with optional nesting).
///| Returns `(next_pos, next_depth)`.
fn scan_block_comment_body(
  src : String,
  pos : Int,
  end : Int,
  init_depth : Int,
  nested : Bool,
) -> (Int, Int) {
  let mut p = pos
  let mut depth = init_depth
  while p < end && depth > 0 {
    let c = src[p]
    if nested && c == 47 && p + 1 < end && src[p + 1] == 42 {
      depth = depth + 1
      p = p + 2
      continue
    }
    if c == 42 && p + 1 < end && src[p + 1] == 47 {
      depth = depth - 1
      p = p + 2
      continue
    }
    p = p + 1
  }
  (p, depth)
}

///| Continue or scan a triple-quoted string (`"""` or `'''`).
///| Returns `(next_pos, closed)`.
fn scan_triple_string_body(
  src : String,
  pos : Int,
  end : Int,
  quote : Int,
  allow_escape : Bool,
) -> (Int, Bool) {
  let mut p = pos
  while p < end {
    let c = src[p]
    if allow_escape && c == 92 {
      p = p + 2
      if p > end {
        p = end
      }
      continue
    }
    if c == quote && p + 2 < end && src[p + 1] == quote && src[p + 2] == quote {
      return (p + 3, true)
    }
    p = p + 1
  }
  (end, false)
}

///| Scan a numeric literal (hex/bin/oct/dec/float/exponent/separators/suffixes).
fn scan_number(
  src : String,
  pos : Int,
  end : Int,
  allow_apos_sep : Bool,
  allow_suffix : Bool,
) -> Int {
  let mut p = pos
  if p < end && src[p] == 48 && p + 1 < end {
    let n1 = src[p + 1]
    if n1 == 120 || n1 == 88 {
      // Hex
      p = p + 2
      while p < end && (is_hex_digit(src[p]) || src[p] == 95 || (allow_apos_sep && src[p] == 39)) {
        p = p + 1
      }
      // Hex float exponent (Go `0x1p2`, C `0x1p+2`)
      if p < end && (src[p] == 112 || src[p] == 80) {
        p = p + 1
        if p < end && (src[p] == 43 || src[p] == 45) {
          p = p + 1
        }
        while p < end && (is_ascii_digit(src[p]) || src[p] == 95) {
          p = p + 1
        }
      }
      if allow_suffix {
        while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 95) {
          p = p + 1
        }
      }
      return p
    }
    if n1 == 98 || n1 == 66 {
      // Binary
      p = p + 2
      while p < end && (is_bin_digit(src[p]) || src[p] == 95 || (allow_apos_sep && src[p] == 39)) {
        p = p + 1
      }
      if allow_suffix {
        while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 95) {
          p = p + 1
        }
      }
      return p
    }
    if n1 == 111 || n1 == 79 {
      // Octal
      p = p + 2
      while p < end && (is_oct_digit(src[p]) || src[p] == 95 || (allow_apos_sep && src[p] == 39)) {
        p = p + 1
      }
      if allow_suffix {
        while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 95) {
          p = p + 1
        }
      }
      return p
    }
  }
  while p < end && (is_ascii_digit(src[p]) || src[p] == 95 || (allow_apos_sep && src[p] == 39)) {
    p = p + 1
  }
  if p + 1 < end && src[p] == 46 && is_ascii_digit(src[p + 1]) {
    p = p + 2
    while p < end && (is_ascii_digit(src[p]) || src[p] == 95 || (allow_apos_sep && src[p] == 39)) {
      p = p + 1
    }
  }
  if p < end && (src[p] == 101 || src[p] == 69) {
    let mut ep = p + 1
    if ep < end && (src[ep] == 43 || src[ep] == 45) {
      ep = ep + 1
    }
    if ep < end && is_ascii_digit(src[ep]) {
      p = ep + 1
      while p < end && (is_ascii_digit(src[p]) || src[p] == 95 || (allow_apos_sep && src[p] == 39)) {
        p = p + 1
      }
    }
  }
  if allow_suffix {
    while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 95) {
      p = p + 1
    }
  }
  p
}

///| Peek next non-inline-whitespace byte starting at `pos`.
fn peek_non_ws(src : String, pos : Int, end : Int) -> Int {
  let mut p = pos
  while p < end && is_ws_inline(src[p]) {
    p = p + 1
  }
  if p < end {
    src[p]
  } else {
    -1
  }
}

///| Check if next non-ws starts with `::`.
fn peek_double_colon(src : String, pos : Int, end : Int) -> Bool {
  let mut p = pos
  while p < end && is_ws_inline(src[p]) {
    p = p + 1
  }
  p + 1 < end && src[p] == 58 && src[p + 1] == 58
}
