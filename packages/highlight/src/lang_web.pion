///| Line scanners for web, diff, and markup languages: HTML, CSS, Diff, Markdown.

///| Scan CSS line with `{` depth tracking in `state.depth`.
fn scan_css_line(
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start
  let mut brace_depth = state.depth
  let mut paren_depth = 0

  if state.mode == mode_block_comment {
    let (np, nd) = scan_block_comment_body(src, p, end, 1, false)
    push_span(out, base_idx, p, np, TokenKind::Comment)
    p = np
    if nd > 0 {
      return make_state(mode_block_comment, brace_depth, 0)
    }
  }

  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws_start = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      continue
    }
    // `//` line comment (SCSS) and `/* ... */` block comment
    if c == 47 && p + 1 < end {
      if src[p + 1] == 47 {
        push_span(out, base_idx, p, end, TokenKind::Comment)
        return make_state(mode_normal, brace_depth, 0)
      }
      if src[p + 1] == 42 {
        let (np, nd) = scan_block_comment_body(src, p + 2, end, 1, false)
        push_span(out, base_idx, p, np, TokenKind::Comment)
        p = np
        if nd > 0 {
          return make_state(mode_block_comment, brace_depth, 0)
        }
        continue
      }
    }
    // SCSS `$variable`
    if c == 36 && p + 1 < end && is_css_ident_char(src[p + 1]) {
      let vstart = p
      p = p + 2
      while p < end && is_css_ident_char(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, vstart, p, TokenKind::Variable)
      continue
    }
    // Strings
    if c == 34 || c == 39 {
      let np = scan_quoted_string(src, p, end, c, true)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      continue
    }
    // `@media`, `@keyframes`, `@import`
    if c == 64 && p + 1 < end && is_css_ident_char(src[p + 1]) {
      let astart = p
      p = p + 2
      while p < end && is_css_ident_char(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, astart, p, TokenKind::Keyword)
      continue
    }
    // `!important`
    if c == 33 && starts_with_ci(src, p + 1, end, "important") {
      push_span(out, base_idx, p, p + 10, TokenKind::Keyword)
      p = p + 10
      continue
    }
    // `#hex` color (inside `{...}` or `(...)` or after `:`) vs `#id` selector
    if c == 35 && p + 1 < end && is_css_ident_char(src[p + 1]) {
      let hstart = p
      p = p + 1
      let mut all_hex = true
      while p < end && is_css_ident_char(src[p]) {
        if !is_hex_digit(src[p]) {
          all_hex = false
        }
        p = p + 1
      }
      let hex_len = p - hstart - 1
      let is_color = (brace_depth > 0 || paren_depth > 0) &&
      all_hex &&
      (hex_len == 3 || hex_len == 4 || hex_len == 6 || hex_len == 8)
      let kind = if is_color { TokenKind::Number } else { TokenKind::Tag }
      push_span(out, base_idx, hstart, p, kind)
      continue
    }
    // Class selector `.cls` (at top-level or nested inside `@media` / SCSS blocks)
    if c == 46 && p + 1 < end && (is_ascii_alpha(src[p + 1]) || src[p + 1] == 95 || src[p + 1] == 45) {
      let prev_ok = p == start ||
      is_ws_inline(src[p - 1]) ||
      src[p - 1] == 123 ||
      src[p - 1] == 125 ||
      src[p - 1] == 44 ||
      src[p - 1] == 59 ||
      src[p - 1] == 40 ||
      src[p - 1] == 38
      if prev_ok {
        let sstart = p
        p = p + 2
        while p < end && is_css_ident_char(src[p]) {
          p = p + 1
        }
        push_span(out, base_idx, sstart, p, TokenKind::Tag)
        continue
      }
    }
    // Numbers (including negative numbers `-1.5em`, `-2px`, `-.5rem`) with optional CSS units
    if is_ascii_digit(c) ||
    (c == 46 && p + 1 < end && is_ascii_digit(src[p + 1])) ||
    (c == 45 &&
      p + 1 < end &&
      (is_ascii_digit(src[p + 1]) || (src[p + 1] == 46 && p + 2 < end && is_ascii_digit(src[p + 2])))) {
      let nstart = p
      if c == 45 {
        p = p + 1
      }
      if p < end && src[p] == 46 {
        p = p + 1
        while p < end && is_ascii_digit(src[p]) {
          p = p + 1
        }
      } else {
        p = scan_number(src, p, end, false, false)
      }
      // Consume CSS unit suffix (`px`, `rem`, `em`, `vh`, `vw`, `%`, `s`, `ms`, `deg`, etc.)
      if p < end && src[p] == 37 {
        p = p + 1
      } else {
        while p < end && is_ascii_alpha(src[p]) {
          p = p + 1
        }
      }
      push_span(out, base_idx, nstart, p, TokenKind::Number)
      continue
    }
    // SCSS parent selector `&`
    if c == 38 {
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      p = p + 1
      continue
    }
    // Identifiers: property (`name:`), function (`rgb(`), or selector tag
    if is_ascii_alpha(c) || c == 95 || c == 45 {
      if c == 45 && (p + 1 >= end || !is_css_ident_char(src[p + 1])) {
        push_span(out, base_idx, p, p + 1, TokenKind::Operator)
        p = p + 1
        continue
      }
      let istart = p
      p = p + 1
      while p < end && is_css_ident_char(src[p]) {
        p = p + 1
      }
      let nxt = peek_non_ws(src, p, end)
      let kind = if nxt == 40 {
        TokenKind::Function
      } else if (brace_depth > 0 || paren_depth > 0) && nxt == 58 {
        TokenKind::Property
      } else if brace_depth == 0 {
        TokenKind::Tag
      } else {
        TokenKind::Plain
      }
      push_span(out, base_idx, istart, p, kind)
      continue
    }
    if c == 123 {
      brace_depth = brace_depth + 1
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    } else if c == 125 {
      if brace_depth > 0 {
        brace_depth = brace_depth - 1
      }
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    } else if c == 40 {
      paren_depth = paren_depth + 1
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    } else if c == 41 {
      if paren_depth > 0 {
        paren_depth = paren_depth - 1
      }
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    } else if c == 58 || c == 59 || c == 44 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    } else {
      push_span(out, base_idx, p, p + 1, TokenKind::Plain)
    }
    p = p + 1
  }

  make_state(mode_normal, brace_depth, 0)
}

///| Scan HTML comment body until `-->`.
fn scan_html_comment_body(src : String, pos : Int, end : Int) -> (Int, Bool) {
  let mut p = pos
  while p + 2 < end {
    if src[p] == 45 && src[p + 1] == 45 && src[p + 2] == 62 {
      return (p + 3, true)
    }
    p = p + 1
  }
  (end, false)
}

///| Find closing tag `</script` or `</style` (case-insensitive) in `pos..end`.
///| Returns offset of `<` or `-1`.
fn find_html_close_tag(src : String, pos : Int, end : Int, tag_lower : String) -> Int {
  let tlen = tag_lower.length()
  let mut p = pos
  while p + 2 + tlen <= end {
    if src[p] == 60 && src[p + 1] == 47 && starts_with_ci(src, p + 2, end, tag_lower) {
      let after = p + 2 + tlen
      if after == end || src[after] == 62 || is_ws_inline(src[after]) {
        return p
      }
    }
    p = p + 1
  }
  -1
}

///| Scan inside an open HTML tag (`<tag ...>`), starting after tag name.
///| Returns `(next_pos, next_mode, next_delim)`.
fn scan_html_tag_attrs(
  src : String,
  pos : Int,
  end : Int,
  delim : Int,
  out : Array[Span],
  base_idx : Int,
) -> (Int, Int, Int) {
  let mut p = pos
  let mut after_eq = false
  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws_start = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      continue
    }
    if c == 47 && p + 1 < end && src[p + 1] == 62 {
      push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
      return (p + 2, mode_normal, 0)
    }
    if c == 62 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      let next_mode = if delim == 1 {
        mode_html_script
      } else if delim == 2 {
        mode_html_style
      } else {
        mode_normal
      }
      return (p + 1, next_mode, 0)
    }
    if c == 61 {
      after_eq = true
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      p = p + 1
      continue
    }
    if c == 34 || c == 39 {
      after_eq = false
      let np = scan_quoted_string(src, p, end, c, false)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      continue
    }
    if after_eq {
      after_eq = false
      let vstart = p
      p = p + 1
      while p < end && !is_ws_inline(src[p]) && src[p] != 62 && src[p] != 47 && src[p] != 34 && src[p] != 39 {
        p = p + 1
      }
      push_span(out, base_idx, vstart, p, TokenKind::String)
      continue
    }
    if is_ascii_alpha(c) || c == 95 || c == 58 {
      let astart = p
      p = p + 1
      while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 45 || src[p] == 95 || src[p] == 58) {
        p = p + 1
      }
      push_span(out, base_idx, astart, p, TokenKind::Attribute)
      continue
    }
    let step = utf8_char_step(src, p, end)
    push_span(out, base_idx, p, p + step, TokenKind::Plain)
    p = p + step
  }
  (end, mode_html_tag, delim)
}

///| Zero-allocation line scanner for HTML / XML / SVG (with embedded `<script>` and `<style>` carrying full sub-state).
fn scan_html_line(
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start
  let mut mode = state.mode
  let mut delim = state.delim
  let mut sub_mode = state.sub_mode
  let mut sub_depth = state.sub_depth
  let mut sub_delim = state.sub_delim
  let mut sub_tag = state.tag

  if mode == mode_html_comment {
    let (np, closed) = scan_html_comment_body(src, p, end)
    push_span(out, base_idx, p, np, TokenKind::Comment)
    p = np
    if !closed {
      return state
    }
    mode = mode_normal
  } else if mode == mode_html_tag {
    let (np, nm, nd) = scan_html_tag_attrs(src, p, end, delim, out, base_idx)
    p = np
    mode = nm
    delim = nd
    if p >= end {
      return make_state(mode, 0, delim)
    }
  }

  while p < end {
    if mode == mode_html_script {
      let js_st = LineState::{
        mode: sub_mode,
        depth: sub_depth,
        delim: sub_delim,
        sub_mode: 0,
        sub_depth: 0,
        sub_delim: 0,
        tag: sub_tag,
      }
      let close_at = find_html_close_tag(src, p, end, "script")
      if close_at < 0 {
        let next_js = scan_code_line(Language::JavaScript, js_st, src, p, end, out, base_idx)
        return LineState::{
          mode: mode_html_script,
          depth: 0,
          delim: 0,
          sub_mode: next_js.mode,
          sub_depth: next_js.depth,
          sub_delim: next_js.delim,
          tag: next_js.tag,
        }
      }
      if close_at > p {
        let _ = scan_code_line(Language::JavaScript, js_st, src, p, close_at, out, base_idx)
      }
      sub_mode = 0
      sub_depth = 0
      sub_delim = 0
      sub_tag = ""
      push_span(out, base_idx, close_at, close_at + 2, TokenKind::Punctuation)
      push_span(out, base_idx, close_at + 2, close_at + 8, TokenKind::Tag)
      p = close_at + 8
      mode = mode_html_tag
      delim = 0
      let (np, nm, nd) = scan_html_tag_attrs(src, p, end, delim, out, base_idx)
      p = np
      mode = nm
      delim = nd
      continue
    }

    if mode == mode_html_style {
      let css_st = make_state(sub_mode, sub_depth, sub_delim)
      let close_at = find_html_close_tag(src, p, end, "style")
      if close_at < 0 {
        let next_css = scan_css_line(css_st, src, p, end, out, base_idx)
        return LineState::{
          mode: mode_html_style,
          depth: 0,
          delim: 0,
          sub_mode: next_css.mode,
          sub_depth: next_css.depth,
          sub_delim: next_css.delim,
          tag: "",
        }
      }
      if close_at > p {
        let _ = scan_css_line(css_st, src, p, close_at, out, base_idx)
      }
      sub_mode = 0
      sub_depth = 0
      sub_delim = 0
      sub_tag = ""
      push_span(out, base_idx, close_at, close_at + 2, TokenKind::Punctuation)
      push_span(out, base_idx, close_at + 2, close_at + 7, TokenKind::Tag)
      p = close_at + 7
      mode = mode_html_tag
      delim = 0
      let (np, nm, nd) = scan_html_tag_attrs(src, p, end, delim, out, base_idx)
      p = np
      mode = nm
      delim = nd
      continue
    }

    let c = src[p]
    if c == 60 {
      // HTML comment `<!--`
      if p + 3 < end && src[p + 1] == 33 && src[p + 2] == 45 && src[p + 3] == 45 {
        let (np, closed) = scan_html_comment_body(src, p + 4, end)
        push_span(out, base_idx, p, np, TokenKind::Comment)
        p = np
        if !closed {
          return make_state(mode_html_comment, 0, 0)
        }
        continue
      }
      // XML processing instruction `<?xml ... ?>`
      if p + 1 < end && src[p + 1] == 63 {
        let xstart = p
        p = p + 2
        while p < end {
          if src[p] == 63 && p + 1 < end && src[p + 1] == 62 {
            p = p + 2
            break
          }
          p = p + 1
        }
        push_span(out, base_idx, xstart, p, TokenKind::Attribute)
        continue
      }
      // Doctype `<!DOCTYPE ...>`
      if p + 1 < end && src[p + 1] == 33 {
        let dstart = p
        p = p + 2
        while p < end && src[p] != 62 {
          p = p + 1
        }
        if p < end && src[p] == 62 {
          p = p + 1
        }
        push_span(out, base_idx, dstart, p, TokenKind::Comment)
        continue
      }
      // Closing tag `</tag>`
      if p + 1 < end && src[p + 1] == 47 {
        push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
        p = p + 2
        let tstart = p
        while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 45 || src[p] == 58) {
          p = p + 1
        }
        if p > tstart {
          push_span(out, base_idx, tstart, p, TokenKind::Tag)
        }
        let (np, nm, nd) = scan_html_tag_attrs(src, p, end, 0, out, base_idx)
        p = np
        mode = nm
        delim = nd
        continue
      }
      // Opening tag `<tag ...>`
      if p + 1 < end && (is_ascii_alpha(src[p + 1]) || src[p + 1] == 95) {
        push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
        p = p + 1
        let tstart = p
        while p < end && (is_ascii_alpha(src[p]) || is_ascii_digit(src[p]) || src[p] == 45 || src[p] == 58) {
          p = p + 1
        }
        let tlen = p - tstart
        push_span(out, base_idx, tstart, p, TokenKind::Tag)
        let tag_delim = if eq_word_ci(src, tstart, tlen, "script") {
          1
        } else if eq_word_ci(src, tstart, tlen, "style") {
          2
        } else {
          0
        }
        let (np, nm, nd) = scan_html_tag_attrs(src, p, end, tag_delim, out, base_idx)
        p = np
        mode = nm
        delim = nd
        continue
      }
    }

    // HTML character entity `&amp;`, `&#123;`, `&#x1F;`
    if c == 38 {
      let mut ep = p + 1
      let limit = if p + 16 < end { p + 16 } else { end }
      if ep < limit && src[ep] == 35 {
        ep = ep + 1
        if ep < limit && (src[ep] == 120 || src[ep] == 88) {
          ep = ep + 1
          while ep < limit && is_hex_digit(src[ep]) {
            ep = ep + 1
          }
        } else {
          while ep < limit && is_ascii_digit(src[ep]) {
            ep = ep + 1
          }
        }
      } else {
        while ep < limit && (is_ascii_alpha(src[ep]) || is_ascii_digit(src[ep])) {
          ep = ep + 1
        }
      }
      if ep > p + 1 && ep < end && src[ep] == 59 {
        push_span(out, base_idx, p, ep + 1, TokenKind::Constant)
        p = ep + 1
        continue
      }
    }

    // Plain text until next `<` or `&`
    let tstart = p
    let step = utf8_char_step(src, p, end)
    p = p + step
    while p < end && src[p] != 60 && src[p] != 38 {
      p = p + 1
    }
    push_span(out, base_idx, tstart, p, TokenKind::Plain)
  }

  LineState::{
    mode,
    depth: 0,
    delim,
    sub_mode,
    sub_depth,
    sub_delim,
    tag: sub_tag,
  }
}

///| Zero-allocation line scanner for Unified Diff / Git Patch.
fn scan_diff_line(
  _state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  if start >= end {
    return LineState::initial()
  }
  let c = src[start]
  let kind = if starts_with_ci(src, start, end, "diff ") ||
  starts_with_ci(src, start, end, "index ") ||
  starts_with_ci(src, start, end, "---") ||
  starts_with_ci(src, start, end, "+++") ||
  starts_with_ci(src, start, end, "@@") {
    TokenKind::DiffHeader
  } else if c == 43 {
    TokenKind::DiffAdd
  } else if c == 45 {
    TokenKind::DiffDel
  } else {
    TokenKind::Plain
  }
  push_span(out, base_idx, start, end, kind)
  LineState::initial()
}

///| Zero-allocation line scanner for Markdown.
fn scan_markdown_line(
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start
  while p < end && is_ws_inline(src[p]) {
    p = p + 1
  }

  // Check fenced code block open/close (``` or ~~~)
  if p + 2 < end && ((src[p] == 96 && src[p + 1] == 96 && src[p + 2] == 96) || (src[p] == 126 && src[p + 1] == 126 && src[p + 2] == 126)) {
    let fch = src[p]
    let mut flen = 3
    while p + flen < end && src[p + flen] == fch {
      flen = flen + 1
    }
    if state.mode == mode_md_fence {
      let open_ch = state.delim & 0xFF
      let open_len = state.delim >> 8
      if fch == open_ch && flen >= open_len {
        push_span(out, base_idx, start, end, TokenKind::Punctuation)
        return LineState::initial()
      }
      // Fall through to embedded language / plain code line below
    } else {
      // Opening fence: resolve optional info-string language (e.g. ```rust)
      let mut info_s = p + flen
      while info_s < end && is_ws_inline(src[info_s]) {
        info_s = info_s + 1
      }
      let mut info_e = info_s
      while info_e < end && !is_ws_inline(src[info_e]) && src[info_e] != 96 && src[info_e] != 123 {
        info_e = info_e + 1
      }
      let mut emb_id = 0
      if info_e > info_s {
        match resolve_language(src.slice(info_s, info_e)) {
          Some(sub_lang) => if !language_eq(sub_lang, Language::Markdown) {
            emb_id = language_id(sub_lang) + 1
          }
          None => ()
        }
      }
      push_span(out, base_idx, start, end, TokenKind::Punctuation)
      let packed_delim = (flen << 8) | fch
      return make_state(mode_md_fence, emb_id, packed_delim)
    }
  }

  if state.mode == mode_md_fence {
    if state.depth > 0 {
      match language_from_id(state.depth - 1) {
        Some(sub_lang) => {
          let sub_st = LineState::{
            mode: state.sub_mode,
            depth: state.sub_depth,
            delim: state.sub_delim,
            sub_mode: 0,
            sub_depth: 0,
            sub_delim: 0,
            tag: state.tag,
          }
          let next_sub = scan_line_content(sub_lang, sub_st, src, start, end, out, base_idx)
          return LineState::{
            mode: mode_md_fence,
            depth: state.depth,
            delim: state.delim,
            sub_mode: next_sub.mode,
            sub_depth: next_sub.depth,
            sub_delim: next_sub.delim,
            tag: next_sub.tag,
          }
        }
        None => ()
      }
    }
    push_span(out, base_idx, start, end, TokenKind::String)
    return state
  }

  if p < end {
    // Heading `# ...`
    if src[p] == 35 {
      let mut hp = p
      while hp < end && src[hp] == 35 {
        hp = hp + 1
      }
      if hp < end && is_ws_inline(src[hp]) {
        push_span(out, base_idx, start, end, TokenKind::Keyword)
        return LineState::initial()
      }
    }
    // Blockquote `> ...`
    if src[p] == 62 {
      push_span(out, base_idx, start, end, TokenKind::Comment)
      return LineState::initial()
    }
  }

  // Leading whitespace and list markers (`- `, `* `, `+ `, `1. `)
  let mut cursor = start
  if p > start {
    push_span(out, base_idx, start, p, TokenKind::Plain)
    cursor = p
  }
  if cursor < end {
    let ch = src[cursor]
    if (ch == 45 || ch == 42 || ch == 43) && cursor + 1 < end && is_ws_inline(src[cursor + 1]) {
      push_span(out, base_idx, cursor, cursor + 1, TokenKind::Punctuation)
      cursor = cursor + 1
    } else if is_ascii_digit(ch) {
      let mut np = cursor
      while np < end && is_ascii_digit(src[np]) {
        np = np + 1
      }
      if np + 1 < end && (src[np] == 46 || src[np] == 41) && is_ws_inline(src[np + 1]) {
        push_span(out, base_idx, cursor, np + 1, TokenKind::Punctuation)
        cursor = np + 1
      }
    }
  }

  // Inline markdown tokens: `` `code` ``, `**bold**`, `__bold__`, `*it*`, `_it_`, `[label](url)`
  p = cursor
  let mut no_more_star = false
  let mut no_more_under = false
  let mut no_more_link = false
  while p < end {
    let c = src[p]
    if c == 96 {
      let cstart = p
      p = p + 1
      while p < end && src[p] != 96 {
        p = p + 1
      }
      if p < end && src[p] == 96 {
        p = p + 1
      }
      push_span(out, base_idx, cstart, p, TokenKind::String)
      continue
    }
    // Bold `**...**` or `__...__`
    if ((c == 42 && !no_more_star) || (c == 95 && !no_more_under)) && p + 1 < end && src[p + 1] == c {
      let mut q = p + 2
      while q + 1 < end && !(src[q] == c && src[q + 1] == c) {
        q = q + 1
      }
      if q > p + 2 && q + 1 < end && src[q] == c && src[q + 1] == c {
        push_span(out, base_idx, p, q + 2, TokenKind::Keyword)
        p = q + 2
        continue
      }
      if q + 1 >= end {
        if c == 42 {
          no_more_star = true
        } else {
          no_more_under = true
        }
      }
    }
    // Italic `*...*` or `_..._`
    if ((c == 42 && !no_more_star) || (c == 95 && !no_more_under)) &&
    (p == start || !is_ident_cont(src[p - 1])) &&
    p + 1 < end &&
    !is_ws_inline(src[p + 1]) {
      let mut q = p + 1
      while q < end && src[q] != c {
        q = q + 1
      }
      if q > p + 1 && q < end && src[q] == c && !is_ws_inline(src[q - 1]) {
        push_span(out, base_idx, p, q + 1, TokenKind::Attribute)
        p = q + 1
        continue
      }
      if q >= end {
        if c == 42 {
          no_more_star = true
        } else {
          no_more_under = true
        }
      }
    }
    // Link `[label](url)`
    if c == 91 && !no_more_link {
      let mut q = p + 1
      while q < end && src[q] != 93 && src[q] != 91 {
        q = q + 1
      }
      if q + 1 < end && src[q] == 93 && src[q + 1] == 40 {
        push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
        if q > p + 1 {
          push_span(out, base_idx, p + 1, q, TokenKind::Function)
        }
        push_span(out, base_idx, q, q + 2, TokenKind::Punctuation)
        let ustart = q + 2
        let mut uend = ustart
        while uend < end && src[uend] != 41 {
          uend = uend + 1
        }
        if uend > ustart {
          push_span(out, base_idx, ustart, uend, TokenKind::String)
        }
        if uend < end && src[uend] == 41 {
          push_span(out, base_idx, uend, uend + 1, TokenKind::Punctuation)
          p = uend + 1
        } else {
          p = uend
        }
        continue
      }
      if q >= end {
        no_more_link = true
      }
    }
    if c == 93 && p + 1 < end && src[p + 1] == 40 {
      push_span(out, base_idx, p, p + 2, TokenKind::Punctuation)
      p = p + 2
      let ustart = p
      while p < end && src[p] != 41 {
        p = p + 1
      }
      push_span(out, base_idx, ustart, p, TokenKind::String)
      if p < end && src[p] == 41 {
        push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
        p = p + 1
      }
      continue
    }
    let tstart = p
    let step = utf8_char_step(src, p, end)
    p = p + step
    while p < end &&
    src[p] != 96 &&
    src[p] != 42 &&
    src[p] != 95 &&
    src[p] != 91 &&
    !(src[p] == 93 && p + 1 < end && src[p + 1] == 40) {
      p = p + 1
    }
    push_span(out, base_idx, tstart, p, TokenKind::Plain)
  }
  LineState::initial()
}
