///| Line scanners for data & query languages: JSON, TOML, YAML, SQL.

///| Zero-allocation line scanner for JSON / JSONC.
fn scan_json_line(
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start
  if state.mode == mode_block_comment {
    let (np, nd) = scan_block_comment_body(src, p, end, state.depth, false)
    push_span(out, base_idx, p, np, TokenKind::Comment)
    p = np
    if nd > 0 {
      return LineState::{ mode: mode_block_comment, depth: nd, delim: 0 }
    }
  }
  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws_start = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      continue
    }
    // JSONC comments
    if c == 47 && p + 1 < end {
      if src[p + 1] == 47 {
        push_span(out, base_idx, p, end, TokenKind::Comment)
        return LineState::initial()
      }
      if src[p + 1] == 42 {
        let (np, nd) = scan_block_comment_body(src, p + 2, end, 1, false)
        push_span(out, base_idx, p, np, TokenKind::Comment)
        p = np
        if nd > 0 {
          return LineState::{ mode: mode_block_comment, depth: nd, delim: 0 }
        }
        continue
      }
    }
    // Quoted string (Property if followed by `:`, else String)
    if c == 34 {
      let np = scan_quoted_string(src, p, end, 34, true)
      let kind = if peek_non_ws(src, np, end) == 58 {
        TokenKind::Property
      } else {
        TokenKind::String
      }
      push_span(out, base_idx, p, np, kind)
      p = np
      continue
    }
    // Numbers (including leading `-`)
    if is_ascii_digit(c) || (c == 45 && p + 1 < end && is_ascii_digit(src[p + 1])) {
      let nstart = p
      let dstart = if c == 45 { p + 1 } else { p }
      let np = scan_number(src, dstart, end, false, false)
      push_span(out, base_idx, nstart, np, TokenKind::Number)
      p = np
      continue
    }
    // Constants: true, false, null
    if is_ascii_alpha(c) {
      let istart = p
      p = p + 1
      while p < end && is_ascii_alpha(src[p]) {
        p = p + 1
      }
      let len = p - istart
      let kind = if eq_word(src, istart, len, "true") ||
      eq_word(src, istart, len, "false") ||
      eq_word(src, istart, len, "null") {
        TokenKind::Constant
      } else {
        TokenKind::Plain
      }
      push_span(out, base_idx, istart, p, kind)
      continue
    }
    if c == 123 || c == 125 || c == 91 || c == 93 || c == 58 || c == 44 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    } else {
      push_span(out, base_idx, p, p + 1, TokenKind::Plain)
    }
    p = p + 1
  }
  LineState::initial()
}

///| Zero-allocation line scanner for TOML.
fn scan_toml_line(
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start
  let mut seen_eq = false

  if state.mode == mode_triple_double {
    let (np, closed) = scan_triple_string_body(src, p, end, 34, true)
    push_span(out, base_idx, p, np, TokenKind::String)
    p = np
    seen_eq = true
    if !closed {
      return state
    }
  } else if state.mode == mode_triple_single {
    let (np, closed) = scan_triple_string_body(src, p, end, 39, false)
    push_span(out, base_idx, p, np, TokenKind::String)
    p = np
    seen_eq = true
    if !closed {
      return state
    }
  }

  // Leading whitespace
  let mut ws_end = p
  while ws_end < end && is_ws_inline(src[ws_end]) {
    ws_end = ws_end + 1
  }
  if ws_end > p {
    push_span(out, base_idx, p, ws_end, TokenKind::Plain)
    p = ws_end
  }

  // Table header `[table]` or `[[array_table]]`
  if !seen_eq && p < end && src[p] == 91 {
    let tstart = p
    let is_double = p + 1 < end && src[p + 1] == 91
    p = if is_double { p + 2 } else { p + 1 }
    while p < end {
      if is_double && src[p] == 93 && p + 1 < end && src[p + 1] == 93 {
        p = p + 2
        break
      }
      if !is_double && src[p] == 93 {
        p = p + 1
        break
      }
      p = p + 1
    }
    push_span(out, base_idx, tstart, p, TokenKind::Tag)
    seen_eq = true
  }

  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws_start = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      continue
    }
    if c == 35 {
      push_span(out, base_idx, p, end, TokenKind::Comment)
      return LineState::initial()
    }
    if c == 61 {
      seen_eq = true
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
      p = p + 1
      continue
    }
    // Triple or single/double quoted strings
    if c == 34 || c == 39 {
      if p + 2 < end && src[p + 1] == c && src[p + 2] == c {
        let (np, closed) = scan_triple_string_body(src, p + 3, end, c, c == 34)
        push_span(out, base_idx, p, np, TokenKind::String)
        p = np
        if !closed {
          let m = if c == 34 { mode_triple_double } else { mode_triple_single }
          return LineState::{ mode: m, depth: 0, delim: c }
        }
        continue
      }
      let np = scan_quoted_string(src, p, end, c, c == 34)
      let kind = if !seen_eq { TokenKind::Property } else { TokenKind::String }
      push_span(out, base_idx, p, np, kind)
      p = np
      continue
    }
    // Numbers (only after `=`)
    if seen_eq && (is_ascii_digit(c) || ((c == 45 || c == 43) && p + 1 < end && is_ascii_digit(src[p + 1]))) {
      let nstart = p
      let dstart = if c == 45 || c == 43 { p + 1 } else { p }
      let np = scan_number(src, dstart, end, false, false)
      push_span(out, base_idx, nstart, np, TokenKind::Number)
      p = np
      continue
    }
    // Keys before `=` or booleans/identifiers after `=`
    if is_ident_start(c) || (!seen_eq && (is_ascii_digit(c) || c == 45)) {
      let istart = p
      p = p + 1
      while p < end && (is_ident_cont(src[p]) || src[p] == 45) {
        p = p + 1
      }
      let len = p - istart
      let kind = if !seen_eq {
        TokenKind::Property
      } else if eq_word(src, istart, len, "true") || eq_word(src, istart, len, "false") {
        TokenKind::Constant
      } else {
        TokenKind::Plain
      }
      push_span(out, base_idx, istart, p, kind)
      continue
    }
    if c == 46 || c == 44 || c == 91 || c == 93 || c == 123 || c == 125 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    } else {
      push_span(out, base_idx, p, p + 1, TokenKind::Plain)
    }
    p = p + 1
  }
  LineState::initial()
}

///| Zero-allocation line scanner for YAML.
fn scan_yaml_line(
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  // Measure leading indentation
  let mut indent_end = start
  while indent_end < end && src[indent_end] == 32 {
    indent_end = indent_end + 1
  }
  let indent = indent_end - start

  // Check if continuing a YAML block scalar (`|` or `>`)
  if state.mode == mode_yaml_block {
    if indent_end == end || indent >= state.depth {
      push_span(out, base_idx, start, end, TokenKind::String)
      return state
    }
  }

  let mut p = start
  if indent_end > p {
    push_span(out, base_idx, p, indent_end, TokenKind::Plain)
    p = indent_end
  }
  if p >= end {
    return LineState::initial()
  }

  // Document markers `---` or `...`
  if indent == 0 && p + 3 <= end {
    let is_dash = src[p] == 45 && src[p + 1] == 45 && src[p + 2] == 45
    let is_dots = src[p] == 46 && src[p + 1] == 46 && src[p + 2] == 46
    if (is_dash || is_dots) && (p + 3 == end || is_ws_inline(src[p + 3])) {
      push_span(out, base_idx, p, p + 3, TokenKind::Punctuation)
      p = p + 3
    }
  }

  let mut after_colon = false
  let mut key_indent = indent
  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws_start = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      continue
    }
    // Comment `#`
    if c == 35 && (p == start || is_ws_inline(src[p - 1])) {
      push_span(out, base_idx, p, end, TokenKind::Comment)
      return LineState::initial()
    }
    // List marker `- `
    if !after_colon && c == 45 && (p + 1 == end || is_ws_inline(src[p + 1])) {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
      p = p + 1
      key_indent = p - start
      continue
    }
    // Anchors `&name` and aliases `*name`
    if (c == 38 || c == 42) && p + 1 < end && is_ident_start(src[p + 1]) {
      let astart = p
      p = p + 2
      while p < end && (is_ident_cont(src[p]) || src[p] == 45) {
        p = p + 1
      }
      push_span(out, base_idx, astart, p, TokenKind::Attribute)
      continue
    }
    // Block scalar indicator `|` or `>` after colon
    if after_colon && (c == 124 || c == 62) {
      let mut bp = p + 1
      if bp < end && (src[bp] == 45 || src[bp] == 43) {
        bp = bp + 1
      }
      push_span(out, base_idx, p, bp, TokenKind::Operator)
      p = bp
      if p < end {
        push_span(out, base_idx, p, end, TokenKind::Plain)
      }
      return LineState::{ mode: mode_yaml_block, depth: key_indent + 1, delim: 0 }
    }
    // Quoted strings
    if c == 34 || c == 39 {
      let np = scan_quoted_string(src, p, end, c, c == 34)
      let kind = if !after_colon && np < end && src[np] == 58 {
        TokenKind::Property
      } else {
        TokenKind::String
      }
      push_span(out, base_idx, p, np, kind)
      p = np
      continue
    }
    // Mapping key check (before `:`)
    if !after_colon && (is_ident_start(c) || is_ascii_digit(c)) {
      let kstart = p
      let mut kp = p
      while kp < end && src[kp] != 58 && src[kp] != 35 {
        kp = kp + 1
      }
      if kp < end && src[kp] == 58 && (kp + 1 == end || is_ws_inline(src[kp + 1])) {
        push_span(out, base_idx, kstart, kp, TokenKind::Property)
        push_span(out, base_idx, kp, kp + 1, TokenKind::Punctuation)
        p = kp + 1
        after_colon = true
        continue
      }
    }
    // Numbers
    if is_ascii_digit(c) || (c == 45 && p + 1 < end && is_ascii_digit(src[p + 1])) {
      let nstart = p
      let dstart = if c == 45 { p + 1 } else { p }
      let np = scan_number(src, dstart, end, false, false)
      if np == end || is_ws_inline(src[np]) || src[np] == 44 || src[np] == 93 || src[np] == 125 {
        push_span(out, base_idx, nstart, np, TokenKind::Number)
        p = np
        continue
      }
    }
    // Constants / plain words
    if is_ident_start(c) {
      let istart = p
      p = p + 1
      while p < end && (is_ident_cont(src[p]) || src[p] == 45) {
        p = p + 1
      }
      let len = p - istart
      let kind = if eq_word(src, istart, len, "true") ||
      eq_word(src, istart, len, "false") ||
      eq_word(src, istart, len, "null") ||
      eq_word(src, istart, len, "True") ||
      eq_word(src, istart, len, "False") ||
      eq_word(src, istart, len, "Null") {
        TokenKind::Constant
      } else {
        TokenKind::Plain
      }
      push_span(out, base_idx, istart, p, kind)
      continue
    }
    if c == 126 {
      push_span(out, base_idx, p, p + 1, TokenKind::Constant)
    } else if c == 58 || c == 44 || c == 91 || c == 93 || c == 123 || c == 125 {
      if c == 58 {
        after_colon = true
      }
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    } else {
      push_span(out, base_idx, p, p + 1, TokenKind::Plain)
    }
    p = p + 1
  }
  LineState::initial()
}

///| Zero-allocation line scanner for SQL.
fn scan_sql_line(
  state : LineState,
  src : String,
  start : Int,
  end : Int,
  out : Array[Span],
  base_idx : Int,
) -> LineState {
  let mut p = start
  if state.mode == mode_block_comment {
    let (np, nd) = scan_block_comment_body(src, p, end, state.depth, false)
    push_span(out, base_idx, p, np, TokenKind::Comment)
    p = np
    if nd > 0 {
      return LineState::{ mode: mode_block_comment, depth: nd, delim: 0 }
    }
  }
  while p < end {
    let c = src[p]
    if is_ws_inline(c) {
      let ws_start = p
      p = p + 1
      while p < end && is_ws_inline(src[p]) {
        p = p + 1
      }
      push_span(out, base_idx, ws_start, p, TokenKind::Plain)
      continue
    }
    // `--` line comment
    if c == 45 && p + 1 < end && src[p + 1] == 45 {
      push_span(out, base_idx, p, end, TokenKind::Comment)
      return LineState::initial()
    }
    // `/* ... */` block comment
    if c == 47 && p + 1 < end && src[p + 1] == 42 {
      let (np, nd) = scan_block_comment_body(src, p + 2, end, 1, false)
      push_span(out, base_idx, p, np, TokenKind::Comment)
      p = np
      if nd > 0 {
        return LineState::{ mode: mode_block_comment, depth: nd, delim: 0 }
      }
      continue
    }
    // SQL single-quoted string with `''` doubled-quote escape
    if c == 39 {
      let sstart = p
      p = p + 1
      while p < end {
        if src[p] == 39 {
          if p + 1 < end && src[p + 1] == 39 {
            p = p + 2
            continue
          }
          p = p + 1
          break
        }
        p = p + 1
      }
      push_span(out, base_idx, sstart, p, TokenKind::String)
      continue
    }
    // Double-quoted identifier
    if c == 34 {
      let np = scan_quoted_string(src, p, end, 34, true)
      push_span(out, base_idx, p, np, TokenKind::String)
      p = np
      continue
    }
    // Numbers
    if is_ascii_digit(c) {
      let np = scan_number(src, p, end, false, false)
      push_span(out, base_idx, p, np, TokenKind::Number)
      p = np
      continue
    }
    // Identifiers / SQL keywords & types (case-insensitive)
    if is_ident_start(c) {
      let istart = p
      p = p + 1
      while p < end && is_ident_cont(src[p]) {
        p = p + 1
      }
      let mut kind = classify_sql(src, istart, p - istart)
      if token_kind_eq(kind, TokenKind::Plain) && peek_non_ws(src, p, end) == 40 {
        kind = TokenKind::Function
      }
      push_span(out, base_idx, istart, p, kind)
      continue
    }
    if p + 1 < end {
      let n1 = src[p + 1]
      if (c == 60 && (n1 == 62 || n1 == 61)) || (c == 62 && n1 == 61) || (c == 33 && n1 == 61) || (c == 124 && n1 == 124) {
        push_span(out, base_idx, p, p + 2, TokenKind::Operator)
        p = p + 2
        continue
      }
    }
    if c == 61 || c == 60 || c == 62 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37 {
      push_span(out, base_idx, p, p + 1, TokenKind::Operator)
    } else if c == 40 || c == 41 || c == 44 || c == 59 || c == 46 {
      push_span(out, base_idx, p, p + 1, TokenKind::Punctuation)
    } else {
      push_span(out, base_idx, p, p + 1, TokenKind::Plain)
    }
    p = p + 1
  }
  LineState::initial()
}
