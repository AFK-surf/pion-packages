///| Reusable `DeflateContext` and `InflateContext` unit tests:
///| verifies bit-for-bit parity with one-shot APIs across all levels (0..9),
///| raw DEFLATE / zlib (incl. preset dict) / gzip (incl. custom headers & multi-member),
///| repeated small + large + incompressible payloads, and error recovery without stale state.

///|
fn ctx_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn ctx_make_payload(n : Int, seed : Int64) -> Bytes {
  let mut out = Bytes::new(n)
  let pat = "The quick brown fox jumps over the lazy dog. 0123456789\n".to_bytes()
  let pn = pat.length()
  let mut s = seed
  let mut i = 0
  while i < n {
    if (i / 128) % 3 == 0 {
      out[i] = pat[i % pn]
    } else {
      s = (s * 6364136223846793005L + 1442695040888963407L) & 0x7FFFFFFFFFFFFFFFL
      out[i] = ((s >> 24) & 0xFFL).to_int().to_byte()
    }
    i = i + 1
  }
  out
}

///|
fn ctx_make_random(n : Int, seed : Int64) -> Bytes {
  let mut out = Bytes::new(n)
  let mut s = seed
  let mut i = 0
  while i < n {
    s = (s * 6364136223846793005L + 1442695040888963407L) & 0x7FFFFFFFFFFFFFFFL
    out[i] = ((s >> 24) & 0xFFL).to_int().to_byte()
    i = i + 1
  }
  out
}

///|
test "context_deflate_inflate_bit_exact_parity_all_levels" {
  let dctx = DeflateContext::new()
  let ictx = InflateContext::new()
  let samples = [
    Bytes::new(0),
    "a".to_bytes(),
    "hello, reusable context!".to_bytes(),
    ctx_make_payload(4096, 17L),
    ctx_make_payload(70000, 99L),
    ctx_make_random(20000, 12345L),
    ctx_make_payload(1024, 7L),
  ]
  let mut lvl = 0
  while lvl <= 9 {
    let mut si = 0
    while si < samples.length() {
      let src = samples[si]
      let c_one = match deflate_compress(src, lvl) {
        Ok(b) => b
        Err(e) => {
          debug_assert(false, flate_error_message(e))
          Bytes::new(0)
        }
      }
      let c_ctx = match dctx.deflate_compress(src, lvl) {
        Ok(b) => b
        Err(e) => {
          debug_assert(false, flate_error_message(e))
          Bytes::new(0)
        }
      }
      debug_assert(ctx_bytes_eq(c_one, c_ctx), "DeflateContext must match one-shot bit-for-bit")
      match ictx.deflate_decompress(c_ctx) {
        Ok(dec) => debug_assert(ctx_bytes_eq(dec, src), "InflateContext deflate roundtrip")
        Err(e) => debug_assert(false, flate_error_message(e))
      }
      si = si + 1
    }
    lvl = lvl + 1
  }
}

///|
test "context_zlib_gzip_and_error_recovery" {
  let dctx = DeflateContext::new()
  let ictx = InflateContext::new()
  let p1 = ctx_make_payload(8192, 101L)
  let p2 = ctx_make_payload(12345, 202L)

  // Invalid level error must not corrupt DeflateContext
  match dctx.deflate_compress(p1, 99) {
    Ok(_) => debug_assert(false, "invalid level should fail")
    Err(_) => ()
  }
  match dctx.zlib_compress(p1, -1) {
    Ok(_) => debug_assert(false, "invalid zlib level should fail")
    Err(_) => ()
  }

  // Zlib roundtrip + bit-exact parity
  let z1 = match dctx.zlib_compress(p1, 6) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, flate_error_message(e))
      Bytes::new(0)
    }
  }
  let z1_one = match zlib_compress(p1, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  debug_assert(ctx_bytes_eq(z1, z1_one), "DeflateContext::zlib_compress parity")
  match ictx.zlib_decompress(z1) {
    Ok(dec) => debug_assert(ctx_bytes_eq(dec, p1), "InflateContext::zlib_decompress")
    Err(e) => debug_assert(false, flate_error_message(e))
  }

  // Force InflateContext errors (truncated, output limit, bad checksum) then verify clean reuse
  match ictx.deflate_decompress(Bytes::new(1)) {
    Ok(_) => debug_assert(false, "truncated deflate must fail")
    Err(_) => ()
  }
  match ictx.zlib_decompress_with_limit(z1, 16) {
    Ok(_) => debug_assert(false, "limit exceeded must fail")
    Err(_) => ()
  }

  // Gzip custom header + multi-member reuse
  let hdr = GzipHeader::with_name("reuse.dat")
  let g1 = match dctx.gzip_compress_with_header(p1, 1, hdr) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, flate_error_message(e))
      Bytes::new(0)
    }
  }
  let g2 = match dctx.gzip_compress(p2, 6) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, flate_error_message(e))
      Bytes::new(0)
    }
  }
  let combined = g1.concat(g2)
  match ictx.gzip_decompress_full(combined, 0) {
    Ok(dec) => {
      debug_assert(dec.member_count == 2, "multi-member count == 2")
      debug_assert(dec.header.has_name && dec.header.name == "reuse.dat", "header name")
      debug_assert(ctx_bytes_eq(dec.data, p1.concat(p2)), "multi-member data match")
    }
    Err(e) => debug_assert(false, flate_error_message(e))
  }
  match ictx.gzip_decompress(g2) {
    Ok(dec) => debug_assert(ctx_bytes_eq(dec, p2), "reuse after multi-member")
    Err(e) => debug_assert(false, flate_error_message(e))
  }

  // Zlib preset dict via InflateContext
  let dict = "The quick brown fox ".to_bytes()
  let expected = "The quick brown fox jumps over the lazy dog!".to_bytes()
  let zdict_ints = [
    120, 187, 76, 98, 7, 52, 11, 193, 34, 150, 85, 154, 91, 80, 172, 144, 95,
    150, 90, 164, 80, 2, 148, 206, 73, 172, 170, 84, 72, 201, 79, 87, 4, 0, 107,
    215, 15, 251,
  ]
  let mut zdict = Bytes::new(zdict_ints.length())
  let mut k = 0
  while k < zdict_ints.length() {
    zdict[k] = zdict_ints[k].to_byte()
    k = k + 1
  }
  match ictx.zlib_decompress_with_dict(zdict, dict, 65536) {
    Ok(dec) => debug_assert(ctx_bytes_eq(dec, expected), "InflateContext preset dict")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}

///|
test "context_repeated_many_small_frames" {
  // Exercise repeated reuse across 200 small payloads (tests l1_bias and scratch reuse)
  let dctx = DeflateContext::new()
  let ictx = InflateContext::new()
  let mut i = 0
  while i < 200 {
    let payload = ctx_make_payload(256 + (i % 64) * 16, i.to_int64() + 1L)
    let lvl = if i % 2 == 0 { 1 } else { 6 }
    let comp = match dctx.gzip_compress(payload, lvl) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, flate_error_message(e))
        Bytes::new(0)
      }
    }
    match ictx.gzip_decompress(comp) {
      Ok(dec) => debug_assert(ctx_bytes_eq(dec, payload), "repeated frame roundtrip")
      Err(e) => debug_assert(false, flate_error_message(e))
    }
    i = i + 1
  }
}

///|
test "context_gzip_error_in_second_member_clears_chunks" {
  let dctx = DeflateContext::new()
  let ictx = InflateContext::new()
  let payload = ctx_make_payload(1024, 42L)
  let member1 = match dctx.gzip_compress(payload, 6) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, flate_error_message(e))
      Bytes::new(0)
    }
  }
  // Append a truncated second gzip member header (only 4 bytes) after a valid non-empty member
  let m1_len = member1.length()
  let mut bad_multi = Bytes::new(m1_len + 4)
  let mut i = 0
  while i < m1_len {
    bad_multi[i] = member1[i]
    i = i + 1
  }
  bad_multi[m1_len] = 0x1F.to_byte()
  bad_multi[m1_len + 1] = 0x8B.to_byte()
  bad_multi[m1_len + 2] = 0x08.to_byte()
  bad_multi[m1_len + 3] = 0x00.to_byte()
  match ictx.gzip_decompress_full(bad_multi, 65536) {
    Ok(_) => debug_assert(false, "truncated second gzip member must fail")
    Err(_) => ()
  }
  // Must not retain decoded Bytes from member 1 in ctx.gzip_chunks
  debug_assert(
    ictx.gzip_chunks.length() == 0,
    "gzip_chunks must be cleared on second-member header error",
  )

  // Also test invalid magic bytes on second member
  let mut bad_magic = Bytes::new(m1_len + 10)
  i = 0
  while i < m1_len {
    bad_magic[i] = member1[i]
    i = i + 1
  }
  bad_magic[m1_len] = 0x00.to_byte()
  bad_magic[m1_len + 1] = 0x00.to_byte()
  match ictx.gzip_decompress_full(bad_magic, 65536) {
    Ok(_) => debug_assert(false, "invalid magic on second gzip member must fail")
    Err(_) => ()
  }
  debug_assert(
    ictx.gzip_chunks.length() == 0,
    "gzip_chunks must be cleared on second-member invalid magic",
  )

  // Context must remain cleanly usable afterwards
  match ictx.gzip_decompress(member1) {
    Ok(dec) => debug_assert(ctx_bytes_eq(dec, payload), "context usable after multi-member error")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}
