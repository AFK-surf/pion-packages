///| RFC 1951 raw DEFLATE compliance, reference vectors, RLE overlap, and level 0..9 roundtrip tests.
///| Ported from Go `compress/flate`, Rust `miniz_oxide`, and RFC 1951 test vectors.

///|
fn fl_bytes_from_ints(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn fl_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn fl_repeat_bytes(pat : Bytes, count : Int) -> Bytes {
  let pn = pat.length()
  let mut out = Bytes::new(pn * count)
  let mut c = 0
  while c < count {
    let base = c * pn
    let mut j = 0
    while j < pn {
      out[base + j] = pat[j]
      j = j + 1
    }
    c = c + 1
  }
  out
}

///|
fn fl_make_lcg_bytes(n : Int, seed : Int64) -> Bytes {
  let mut out = Bytes::new(n)
  let mut s = seed
  let mut i = 0
  while i < n {
    s = (s * 6364136223846793005L + 1442695040888963407L) & 0x7FFFFFFFFFFFFFFFL
    out[i] = ((s >> 24) & 0xFFL).to_int().to_byte()
    i = i + 1
  }
  out
}

///|
fn fl_make_skewed_text(n : Int) -> Bytes {
  let alphabet = "eeeeetttaaaooiiinnnssshhrrddllccuummwwffggyyppbbvvkkjxqz \n.,;:'\"0123456789".to_bytes()
  let alen = alphabet.length()
  let mut out = Bytes::new(n)
  let mut rng : Int64 = 123456789L
  let mut i = 0
  while i < n {
    rng = (rng * 1103515245L + 12345L) & 0x7FFFFFFFL
    out[i] = alphabet[(rng % alen.to_int64()).to_int()]
    i = i + 1
  }
  out
}

///|
test "deflate_reference_empty_and_stored_btype00" {
  // Empty stream: BFINAL=1, BTYPE=01, EOB(256)
  let empty_raw = fl_bytes_from_ints([3, 0])
  match deflate_decompress(empty_raw) {
    Ok(out) => debug_assert(out.length() == 0, "empty deflate output")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
  // Stored BTYPE=00: "hello, stored!"
  let stored_raw = fl_bytes_from_ints([
    1, 14, 0, 241, 255, 104, 101, 108, 108, 111, 44, 32, 115, 116, 111, 114, 101,
    100, 33,
  ])
  match deflate_decompress(stored_raw) {
    Ok(out) =>
    debug_assert(fl_bytes_eq(out, "hello, stored!".to_bytes()), "stored btype00")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}

///|
test "deflate_reference_fixed_btype01_and_rle_overlap" {
  // Fixed Huffman: "hello, world!"
  let hello_raw = fl_bytes_from_ints([
    203, 72, 205, 201, 201, 215, 81, 40, 207, 47, 202, 73, 81, 4, 0,
  ])
  match deflate_decompress(hello_raw) {
    Ok(out) =>
    debug_assert(fl_bytes_eq(out, "hello, world!".to_bytes()), "fixed hello")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
  // RLE overlap dist=1: "A" * 1000
  let rle_a_raw = fl_bytes_from_ints([115, 116, 28, 5, 163, 96, 20, 12, 119, 0, 0])
  match deflate_decompress(rle_a_raw) {
    Ok(out) =>
    debug_assert(
      fl_bytes_eq(out, fl_repeat_bytes("A".to_bytes(), 1000)),
      "RLE dist=1",
    )
    Err(e) => debug_assert(false, flate_error_message(e))
  }
  // RLE overlap dist=2: "AB" * 500
  let rle_ab_raw = fl_bytes_from_ints([
    115, 116, 114, 28, 133, 163, 112, 20, 14, 115, 8, 0,
  ])
  match deflate_decompress(rle_ab_raw) {
    Ok(out) =>
    debug_assert(
      fl_bytes_eq(out, fl_repeat_bytes("AB".to_bytes(), 500)),
      "RLE dist=2",
    )
    Err(e) => debug_assert(false, flate_error_message(e))
  }
  // RLE overlap dist=3: "ABC" * 333
  let rle_abc_raw = fl_bytes_from_ints([
    115, 116, 114, 118, 28, 69, 163, 104, 20, 13, 107, 4, 0,
  ])
  match deflate_decompress(rle_abc_raw) {
    Ok(out) =>
    debug_assert(
      fl_bytes_eq(out, fl_repeat_bytes("ABC".to_bytes(), 333)),
      "RLE dist=3",
    )
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}

///|
test "deflate_reference_dynamic_btype10" {
  // True BTYPE=10 dynamic Huffman stream generated by zlib for fl_make_skewed_text(400)
  let dyn_raw = fl_bytes_from_ints([
    13, 205, 75, 178, 171, 32, 16, 0, 208, 249, 93, 69, 138, 137, 19, 43, 101,
    252, 27, 87, 211, 98, 243, 81, 1, 133, 22, 130, 171, 127, 239, 108, 224, 88,
    195, 127, 166, 132, 33, 201, 119, 168, 118, 112, 241, 33, 156, 59, 4, 204,
    193, 194, 208, 187, 52, 65, 106, 9, 116, 165, 66, 206, 4, 66, 63, 71, 99,
    216, 235, 59, 74, 171, 223, 171, 204, 215, 10, 164, 195, 229, 175, 88, 60,
    123, 83, 80, 98, 142, 21, 119, 188, 183, 59, 254, 46, 233, 255, 150, 131,
    180, 66, 133, 171, 144, 199, 25, 48, 19, 97, 9, 66, 72, 181, 6, 23, 217, 145,
    170, 78, 70, 59, 212, 211, 210, 20, 137, 131, 233, 238, 143, 19, 91, 55, 34,
    54, 90, 40, 184, 232, 240, 192, 148, 182, 235, 43, 191, 79, 35, 177, 241,
    165, 211, 55, 110, 7, 127, 54, 106, 99, 63, 129, 203, 136, 131, 48, 181, 240,
    234, 253, 236, 193, 117, 51, 142, 195, 242, 127, 156, 217, 162, 123, 35, 50,
    15, 227, 176, 243, 68, 60, 230, 9, 99, 126, 116, 216, 253, 201, 213, 3, 103,
    194, 141, 105, 220, 38, 181, 70, 222, 126, 199, 15, 65, 175, 235, 124, 240,
    138, 73, 113, 134, 212, 101, 90, 66, 241, 131, 207, 173, 69, 170, 151, 170,
    171, 84, 69, 220, 188, 190, 192, 219, 63, 174, 33, 39, 157, 241, 12, 228,
    225, 55, 151, 151, 111, 7, 28, 66, 196, 229, 92, 214, 0, 187, 227, 64, 214,
    246, 12, 202, 217, 94, 193, 202, 3, 2, 91, 117, 189, 39, 170, 110, 180, 214,
    122, 26, 7, 30, 231, 240, 210, 234, 19, 200, 124, 121, 236, 99, 173, 184,
    249, 7,
  ])
  debug_assert(((dyn_raw[0].to_int() >> 1) & 3) == 2, "must be BTYPE=10")
  let expected = fl_make_skewed_text(400)
  match deflate_decompress(dyn_raw) {
    Ok(out) => {
      debug_assert(fl_bytes_eq(out, expected), "dynamic btype10 exact match")
      debug_assert(crc32(out) == 0x3236D8EBU, "dynamic btype10 crc32")
    }
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}

///|
test "deflate_roundtrip_all_levels_0_to_9" {
  let samples = [
    Bytes::new(0),
    "x".to_bytes(),
    "ab".to_bytes(),
    "hello, world!".to_bytes(),
    fl_repeat_bytes("A".to_bytes(), 4096),
    fl_repeat_bytes("The quick brown fox jumps over the lazy dog. ".to_bytes(), 120),
    fl_make_skewed_text(8192),
    fl_make_lcg_bytes(4096, 42L),
  ]
  let mut lvl = 0
  while lvl <= 9 {
    let mut si = 0
    while si < samples.length() {
      let src = samples[si]
      let comp = match deflate_compress(src, lvl) {
        Ok(b) => b
        Err(e) => {
          debug_assert(false, flate_error_message(e))
          Bytes::new(0)
        }
      }
      if lvl == 0 && src.length() > 0 {
        // Level 0 must emit stored blocks (BTYPE=00)
        debug_assert(((comp[0].to_int() >> 1) & 3) == 0, "level 0 uses stored")
      }
      match deflate_decompress(comp) {
        Ok(dec) => debug_assert(fl_bytes_eq(dec, src), "deflate roundtrip mismatch")
        Err(e) => debug_assert(false, flate_error_message(e))
      }
      si = si + 1
    }
    lvl = lvl + 1
  }
}

///|
test "deflate_multiblock_and_32k_window_boundary" {
  // > 80 KiB payload crossing both 32 KiB LZ77 window and 64 KiB stored block limits
  let mut payload = Bytes::new(82000)
  let pat = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\n".to_bytes()
  let pn = pat.length()
  let mut i = 0
  while i < 82000 {
    // Mix repeating patterns and varying bytes so window wrap-around is exercised
    if (i / 1024) % 3 == 0 {
      payload[i] = pat[i % pn]
    } else {
      payload[i] = ((i * 37 + (i >> 7)) & 0xFF).to_byte()
    }
    i = i + 1
  }
  // Test levels 0, 1, 6, 9
  let levels = [0, 1, 6, 9]
  let mut li = 0
  while li < levels.length() {
    let lvl = levels[li]
    let comp = match deflate_compress(payload, lvl) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, flate_error_message(e))
        Bytes::new(0)
      }
    }
    if lvl >= 1 {
      debug_assert(comp.length() < payload.length(), "must compress repetitive 82 KiB")
    }
    match deflate_decompress(comp) {
      Ok(dec) => debug_assert(fl_bytes_eq(dec, payload), "82 KiB roundtrip mismatch")
      Err(e) => debug_assert(false, flate_error_message(e))
    }
    li = li + 1
  }
}

///|
test "deflate_max_distance_32768_copy" {
  // Place a 32-byte marker at offset 0 and again at offset 32768 (exact max RFC 1951 distance)
  let total = 32768 + 64
  let mut buf = fl_make_lcg_bytes(total, 999L)
  let marker = "MAX_DISTANCE_32768_MARKER_BYTES!".to_bytes()
  let mut i = 0
  while i < 32 {
    buf[i] = marker[i]
    buf[32768 + i] = marker[i]
    i = i + 1
  }
  let comp = match deflate_compress(buf, 6) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, flate_error_message(e))
      Bytes::new(0)
    }
  }
  match deflate_decompress(comp) {
    Ok(dec) => debug_assert(fl_bytes_eq(dec, buf), "32768 distance roundtrip")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}
