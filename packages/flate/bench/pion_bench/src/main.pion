///| Pion Native head-to-head benchmark for `packages/flate`.
///| Modes:
///|   decompress <gz_file> <iters>
///|   compress6  <raw_file> <iters> [dump_gz_path]
///|   compress1  <raw_file> <iters> [dump_gz_path]
///|   checksum   <raw_file> <iters>

import "flate"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: flate_bench <decompress|compress6|compress1|checksum> <file> <iters> [dump_path]")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int(args[3])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }

  if mode == "decompress" || mode == "decompress_reuse" {
    let reuse = mode == "decompress_reuse"
    let ictx = flate::InflateContext::new()
    let mut last_out = Bytes::new(0)
    let mut total_bytes : Int64 = 0L
    let mut i = 0
    while i < iters {
      let res = if reuse {
        ictx.gzip_decompress(data)
      } else {
        flate::gzip_decompress(data)
      }
      match res {
        Ok(out) => {
          total_bytes = total_bytes + out.length().to_int64()
          last_out = out
        }
        Err(e) => {
          io_println(world, "decompress error: " + flate::flate_error_message(e))
          return 1
        }
      }
      i = i + 1
    }
    io_println(world, "total_bytes=" + total_bytes.to_string())
    io_println(world, last_out.to_string())
    return 0
  }

  if mode == "compress6" || mode == "compress1" || mode == "compress6_reuse" || mode == "compress1_reuse" {
    let reuse = mode == "compress6_reuse" || mode == "compress1_reuse"
    let lvl = if mode == "compress6" || mode == "compress6_reuse" { 6 } else { 1 }
    let dctx = flate::DeflateContext::new()
    let ictx = flate::InflateContext::new()
    let mut last_gz = Bytes::new(0)
    let mut i = 0
    while i < iters {
      let res = if reuse {
        dctx.gzip_compress(data, lvl)
      } else {
        flate::gzip_compress(data, lvl)
      }
      match res {
        Ok(gz) => last_gz = gz
        Err(e) => {
          io_println(world, "compress error: " + flate::flate_error_message(e))
          return 1
        }
      }
      i = i + 1
    }
    if args.length() >= 5 {
      let _ = fs_write_bytes(world, args[4], last_gz)
    }
    match ictx.gzip_decompress_with_limit(last_gz, 0) {
      Ok(dec) => {
        let crc = flate::crc32(dec)
        io_println(
          world,
          "mode=" + mode + " input_bytes=" + data.length().to_string() + " iters=" + iters.to_string() +
          " verified_len=" + dec.length().to_string() + " verified_crc32=" + crc.to_int64().to_string(),
        )
      }
      Err(e) => {
        io_println(world, "compress verify error: " + flate::flate_error_message(e))
        return 1
      }
    }
    return 0
  }

  if mode == "checksum" {
    let mut c : UInt = 0U
    let mut a : UInt = 1U
    let mut i = 0
    while i < iters {
      c = flate::crc32_update(c, data)
      a = flate::adler32_update(a, data)
      i = i + 1
    }
    io_println(world, "crc32=" + c.to_int64().to_string())
    io_println(world, "adler32=" + a.to_int64().to_string())
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
