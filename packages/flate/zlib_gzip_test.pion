///| RFC 1950 (zlib) and RFC 1952 (gzip) compliance, header flags, preset dict, and multi-member tests.

///|
fn zg_bytes_from_ints(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn zg_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "zlib_reference_vectors" {
  let z_empty = zg_bytes_from_ints([120, 156, 3, 0, 0, 0, 0, 1])
  match zlib_decompress(z_empty) {
    Ok(out) => debug_assert(out.length() == 0, "zlib empty")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
  let z_hello = zg_bytes_from_ints([
    120, 156, 203, 72, 205, 201, 201, 215, 81, 40, 207, 47, 202, 73, 81, 4, 0,
    33, 254, 4, 170,
  ])
  match zlib_decompress(z_hello) {
    Ok(out) =>
    debug_assert(zg_bytes_eq(out, "hello, world!".to_bytes()), "zlib hello")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
  let z_stored = zg_bytes_from_ints([
    120, 1, 1, 14, 0, 241, 255, 104, 101, 108, 108, 111, 44, 32, 115, 116, 111,
    114, 101, 100, 33, 39, 93, 5, 19,
  ])
  match zlib_decompress(z_stored) {
    Ok(out) =>
    debug_assert(zg_bytes_eq(out, "hello, stored!".to_bytes()), "zlib stored")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}

///|
test "zlib_preset_dictionary_fdict" {
  let dict = "The quick brown fox ".to_bytes()
  let expected = "The quick brown fox jumps over the lazy dog!".to_bytes()
  let zdict = zg_bytes_from_ints([
    120, 187, 76, 98, 7, 52, 11, 193, 34, 150, 85, 154, 91, 80, 172, 144, 95,
    150, 90, 164, 80, 2, 148, 206, 73, 172, 170, 84, 72, 201, 79, 87, 4, 0, 107,
    215, 15, 251,
  ])
  // Without dict must fail
  match zlib_decompress(zdict) {
    Ok(_) => debug_assert(false, "FDICT without dict must fail")
    Err(_) => ()
  }
  // Wrong dict must fail checksum check
  match zlib_decompress_with_dict(zdict, "wrong dict".to_bytes(), 65536) {
    Ok(_) => debug_assert(false, "wrong dict must fail")
    Err(_) => ()
  }
  // Correct dict must succeed
  match zlib_decompress_with_dict(zdict, dict, 65536) {
    Ok(out) => debug_assert(zg_bytes_eq(out, expected), "zlib preset dict match")
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}

///|
test "zlib_roundtrip_all_levels" {
  let msg = "Pion zlib roundtrip payload! 0123456789 repetitive repetitive repetitive.".to_bytes()
  let mut lvl = 0
  while lvl <= 9 {
    let z = match zlib_compress(msg, lvl) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, flate_error_message(e))
        Bytes::new(0)
      }
    }
    // Check RFC 1950 FCHECK: (CMF*256 + FLG) % 31 == 0
    let cmf = z[0].to_int()
    let flg = z[1].to_int()
    debug_assert((cmf * 256 + flg) % 31 == 0, "zlib FCHECK divisible by 31")
    match zlib_decompress(z) {
      Ok(out) => debug_assert(zg_bytes_eq(out, msg), "zlib roundtrip")
      Err(e) => debug_assert(false, flate_error_message(e))
    }
    lvl = lvl + 1
  }
}

///|
test "gzip_reference_simple_and_full_flags" {
  // Python gzip.GzipFile with FNAME="test.txt", mtime=1700000000
  let gz_simple = zg_bytes_from_ints([
    31, 139, 8, 8, 0, 241, 83, 101, 2, 255, 116, 101, 115, 116, 46, 116, 120,
    116, 0, 243, 72, 205, 201, 201, 87, 72, 175, 202, 44, 80, 40, 207, 47, 202,
    73, 81, 4, 0, 132, 157, 31, 106, 17, 0, 0, 0,
  ])
  match gzip_decompress_full(gz_simple, 65536) {
    Ok(dec) => {
      debug_assert(zg_bytes_eq(dec.data, "Hello gzip world!".to_bytes()), "gz_simple data")
      debug_assert(dec.header.has_name, "gz_simple has_name")
      debug_assert(dec.header.name == "test.txt", "gz_simple name")
      debug_assert(dec.header.mtime == 1700000000U, "gz_simple mtime")
      debug_assert(dec.header.os == 255, "gz_simple os")
      debug_assert(dec.member_count == 1, "gz_simple member_count")
    }
    Err(e) => debug_assert(false, flate_error_message(e))
  }
  // Full flags: FEXTRA + FNAME + FCOMMENT + FHCRC + OS=3 + mtime=1700001234
  let full_gz = zg_bytes_from_ints([
    31, 139, 8, 30, 210, 245, 83, 101, 2, 3, 6, 0, 65, 66, 2, 0, 120, 121, 104,
    101, 108, 108, 111, 46, 98, 105, 110, 0, 116, 101, 115, 116, 32, 99, 111,
    109, 109, 101, 110, 116, 0, 218, 86, 115, 43, 205, 201, 81, 200, 72, 77, 76,
    73, 45, 82, 72, 175, 202, 44, 80, 40, 72, 172, 204, 201, 79, 76, 81, 4, 0,
    152, 33, 75, 250, 25, 0, 0, 0,
  ])
  match gzip_decompress_full(full_gz, 65536) {
    Ok(dec) => {
      debug_assert(
        zg_bytes_eq(dec.data, "Full header gzip payload!".to_bytes()),
        "full_gz data",
      )
      debug_assert(dec.header.has_extra, "full_gz has_extra")
      debug_assert(dec.header.extra.length() == 6, "full_gz extra len")
      debug_assert(dec.header.has_name && dec.header.name == "hello.bin", "full_gz name")
      debug_assert(
        dec.header.has_comment && dec.header.comment == "test comment",
        "full_gz comment",
      )
      debug_assert(dec.header.has_hcrc, "full_gz has_hcrc")
      debug_assert(dec.header.os == 3, "full_gz os=3")
      debug_assert(dec.header.mtime == 1700001234U, "full_gz mtime")
    }
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}

///|
test "gzip_custom_header_roundtrip_and_multimember_concat" {
  let hdr = GzipHeader::{
    mtime: 1700123456U,
    extra_flags: 2,
    os: 3,
    extra: "EX\x01\x00Z".to_bytes(),
    name: "archive.tar".to_bytes().to_string(),
    comment: "generated by pion flate".to_bytes().to_string(),
    has_extra: true,
    has_name: true,
    has_comment: true,
    has_hcrc: true,
  }
  let p1 = "First member payload. ".to_bytes()
  let p2 = "Second member payload! ".to_bytes()
  let p3 = "Third member payload.".to_bytes()
  let g1 = match gzip_compress_with_header(p1, 6, hdr) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, flate_error_message(e))
      Bytes::new(0)
    }
  }
  let g2 = match gzip_compress(p2, 1) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, flate_error_message(e))
      Bytes::new(0)
    }
  }
  let g3 = match gzip_compress(p3, 0) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, flate_error_message(e))
      Bytes::new(0)
    }
  }
  let combined = g1.concat(g2).concat(g3)
  let expected = p1.concat(p2).concat(p3)
  match gzip_decompress_full(combined, 65536) {
    Ok(dec) => {
      debug_assert(zg_bytes_eq(dec.data, expected), "multi-member gzip data")
      debug_assert(dec.member_count == 3, "multi-member count == 3")
      debug_assert(dec.header.name == "archive.tar", "first member name preserved")
      debug_assert(
        dec.header.comment == "generated by pion flate",
        "first member comment preserved",
      )
      debug_assert(dec.header.has_hcrc, "first member hcrc")
      debug_assert(dec.header.mtime == 1700123456U, "first member mtime")
    }
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}
