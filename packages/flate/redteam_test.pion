///| Day-1 red-team security tests for `packages/flate`:
///| Zip Bomb output limit interception, invalid BTYPE=11, oversubscribed/incomplete Huffman trees,
///| out-of-range distances, truncated streams, bad stored NLEN, corrupted checksums/headers.

///|
fn rt_bytes_from_ints(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn rt_clone_bytes(src : Bytes) -> Bytes {
  let n = src.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = src[i]
    i = i + 1
  }
  b
}

///|
fn rt_is_err(r : Result[Bytes, FlateError]) -> Bool {
  match r {
    Err(_) => true
    Ok(_) => false
  }
}

///|
test "redteam_zip_bomb_intercepted_without_oom" {
  // Build a genuine high-ratio raw DEFLATE bomb: 10 MiB of zeros compresses to ~10 KiB (>1000:1)
  // Using fixed Huffman RLE: BFINAL=1, BTYPE=01 (3 bits: 0b011)
  // Literal 0x00 in fixed Huffman: 8-bit code 0b00110000 -> bit-reversed 0b00001100
  // Sym 285 (len=258, 0 extra) in fixed Huffman: 8-bit code 0b11000101 -> bit-reversed 0b10100011
  // Dist 0 (dist=1, 0 extra) in fixed Huffman: 5-bit code 0b00000
  // Each repeat of (len=258, dist=1) is 13 bits! 40,000 repeats = 10,320,000 bytes (~10 MiB) in 65 KB;
  // 400,000 repeats = 103,200,000 bytes (~100 MiB) in ~650 KB — or even smaller: 10,000 repeats = 2.58 MiB in 16 KB.
  // Let's construct a 40,000-repeat (~10.3 MiB output) bomb in ~65 KB and test a 16 KiB limit!
  let repeats = 40000
  let total_bits = 3 + 8 + repeats * 13 + 7
  let byte_len = (total_bits + 7) / 8
  let mut bomb = Bytes::new(byte_len)
  let mut bitbuf : UInt64 = 0UL
  let mut bitcnt = 0
  let mut out_pos = 0

  // Helper inline closure style via loop: emit BFINAL=1, BTYPE=01 (0b011, 3 bits) + lit 0 (0b00001100, 8 bits)
  bitbuf = 3UL | (12UL << 3)
  bitcnt = 11
  while bitcnt >= 8 {
    bomb[out_pos] = (bitbuf & 0xFFUL).to_int().to_byte()
    out_pos = out_pos + 1
    bitbuf = bitbuf >> 8
    bitcnt = bitcnt - 8
  }
  // Emit `repeats` copies of sym 285 (8 bits: 0b10100011 = 163) + dist 0 (5 bits: 0)
  let mut r = 0
  while r < repeats {
    bitbuf = bitbuf | (163UL << bitcnt)
    bitcnt = bitcnt + 13
    while bitcnt >= 8 {
      bomb[out_pos] = (bitbuf & 0xFFUL).to_int().to_byte()
      out_pos = out_pos + 1
      bitbuf = bitbuf >> 8
      bitcnt = bitcnt - 8
    }
    r = r + 1
  }
  // Emit EOB (sym 256, 7 zero bits)
  bitcnt = bitcnt + 7
  while bitcnt > 0 {
    bomb[out_pos] = (bitbuf & 0xFFUL).to_int().to_byte()
    out_pos = out_pos + 1
    bitbuf = bitbuf >> 8
    bitcnt = if bitcnt >= 8 { bitcnt - 8 } else { 0 }
  }
  // Must be intercepted at 64 KiB limit with OutputLimitExceeded
  match deflate_decompress_with_limit(bomb, 65536) {
    Err(FlateError::OutputLimitExceeded(_)) => ()
    Ok(b) => debug_assert(false, "zip bomb should not succeed, got len=" + b.length().to_string())
    Err(e) => debug_assert(false, "expected OutputLimitExceeded, got: " + flate_error_message(e))
  }
  // Also test compressing a 1 MiB zero buffer and decompressing with 4 KiB limit through zlib & gzip
  let zeros = Bytes::new(1048576)
  match zlib_compress(zeros, 6) {
    Ok(zb) => {
      debug_assert(zb.length() < 4096, "1 MiB zeros should compress to < 4 KiB")
      match zlib_decompress_with_limit(zb, 4096) {
        Err(FlateError::OutputLimitExceeded(_)) => ()
        _ => debug_assert(false, "zlib zip bomb must return OutputLimitExceeded")
      }
    }
    Err(e) => debug_assert(false, flate_error_message(e))
  }
  match gzip_compress(zeros, 6) {
    Ok(gb) => {
      debug_assert(gb.length() < 4096, "1 MiB zeros gzip should compress to < 4 KiB")
      match gzip_decompress_with_limit(gb, 4096) {
        Err(FlateError::OutputLimitExceeded(_)) => ()
        _ => debug_assert(false, "gzip zip bomb must return OutputLimitExceeded")
      }
    }
    Err(e) => debug_assert(false, flate_error_message(e))
  }
}

///|
test "redteam_invalid_btype11_and_stored_nlen" {
  // BFINAL=1, BTYPE=11 -> 0b00000111 = 7
  match deflate_decompress(rt_bytes_from_ints([7])) {
    Err(FlateError::InvalidBlockType(3)) => ()
    _ => debug_assert(false, "BTYPE=11 must return InvalidBlockType(3)")
  }
  // Stored block with corrupted NLEN (LEN=4, NLEN=0x0000 != ~4)
  match deflate_decompress(rt_bytes_from_ints([1, 4, 0, 0, 0, 65, 66, 67, 68])) {
    Err(FlateError::InvalidStoredLength(_)) => ()
    _ => debug_assert(false, "corrupted NLEN must return InvalidStoredLength")
  }
  // Truncated stored block (claims LEN=10, only 3 bytes follow)
  match deflate_decompress(rt_bytes_from_ints([1, 10, 0, 245, 255, 65, 66, 67])) {
    Err(FlateError::UnexpectedEof(_)) => ()
    _ => debug_assert(false, "truncated stored block must return UnexpectedEof")
  }
}

///|
test "redteam_invalid_huffman_and_distance_and_eof" {
  // Empty input (0 bytes) -> UnexpectedEof
  match deflate_decompress(Bytes::new(0)) {
    Err(FlateError::UnexpectedEof(_)) => ()
    _ => debug_assert(false, "empty input must fail with UnexpectedEof")
  }
  // Fixed Huffman with back-reference distance > current output (output is empty, emit len=3 dist=1)
  // BFINAL=1, BTYPE=01 (0b011) + sym 257 (7 bits: 0b0000001 reversed = 0b1000000 = 64) + dist 0 (5 bits: 0)
  // Bits: 011 | 1000000 | 00000 -> byte0 = 0b00000011? Wait:
  // bit0..2 = 011 (3), bit3..9 = 1000000 (64 << 3 = 512), bit10..14 = 00000 -> 0x03, 0x02, 0x00
  match deflate_decompress(rt_bytes_from_ints([3, 2, 0])) {
    Err(FlateError::InvalidDistance(_)) => ()
    _ => debug_assert(false, "distance > output len must return InvalidDistance")
  }
  // Dynamic Huffman with oversubscribed code-length tree (all 19 code-length symbols = 1 -> 19 * 2^-1 > 1)
  // BFINAL=1, BTYPE=10 (0b101 = 5), HLIT=0 (5b), HDIST=0 (5b), HCLEN=15 (4b: 19 codes)
  // followed by 19 * 3 bits of 0b001
  let mut bad_dyn = Bytes::new(16)
  let mut bb : UInt64 = 5UL | (15UL << 13) // 17 bits
  let mut bc = 17
  let mut op = 0
  let mut k = 0
  while k < 19 {
    bb = bb | (1UL << bc)
    bc = bc + 3
    while bc >= 8 {
      bad_dyn[op] = (bb & 0xFFUL).to_int().to_byte()
      op = op + 1
      bb = bb >> 8
      bc = bc - 8
    }
    k = k + 1
  }
  if bc > 0 {
    bad_dyn[op] = (bb & 0xFFUL).to_int().to_byte()
  }
  match deflate_decompress(bad_dyn) {
    Err(FlateError::InvalidHuffmanTree(_)) => ()
    _ => debug_assert(false, "oversubscribed code-length tree must return InvalidHuffmanTree")
  }
  // Truncated dynamic header
  debug_assert(rt_is_err(deflate_decompress(rt_bytes_from_ints([5, 0]))), "truncated dynamic header")
  // Invalid compression levels
  match deflate_compress("abc".to_bytes(), -1) {
    Err(FlateError::InvalidLevel(v)) => debug_assert(v == -1, "level -1 must fail")
    _ => debug_assert(false, "level -1 must fail")
  }
  match deflate_compress("abc".to_bytes(), 10) {
    Err(FlateError::InvalidLevel(10)) => ()
    _ => debug_assert(false, "level 10 must fail")
  }
}

///|
test "redteam_zlib_and_gzip_header_and_checksum_corruption" {
  // Valid zlib "hello, world!"
  let good_z = rt_bytes_from_ints([
    120, 156, 203, 72, 205, 201, 201, 215, 81, 40, 207, 47, 202, 73, 81, 4, 0,
    33, 254, 4, 170,
  ])
  // Corrupt FCHECK
  let mut bad_fcheck = rt_clone_bytes(good_z)
  bad_fcheck[1] = (157).to_byte()
  debug_assert(rt_is_err(zlib_decompress(bad_fcheck)), "bad zlib FCHECK")
  // Corrupt CM != 8
  let mut bad_cm = rt_clone_bytes(good_z)
  bad_cm[0] = (121).to_byte()
  debug_assert(rt_is_err(zlib_decompress(bad_cm)), "bad zlib CM")
  // Corrupt Adler-32 trailer
  let mut bad_adler = rt_clone_bytes(good_z)
  bad_adler[bad_adler.length() - 1] = (171).to_byte()
  match zlib_decompress(bad_adler) {
    Err(FlateError::ChecksumMismatch(_)) => ()
    _ => debug_assert(false, "bad Adler-32 must return ChecksumMismatch")
  }
  // Truncated zlib trailer
  debug_assert(
    rt_is_err(zlib_decompress(good_z.slice(0, good_z.length() - 2))),
    "truncated zlib trailer",
  )

  // Valid gzip "Hello gzip world!"
  let good_gz = rt_bytes_from_ints([
    31, 139, 8, 8, 0, 241, 83, 101, 2, 255, 116, 101, 115, 116, 46, 116, 120,
    116, 0, 243, 72, 205, 201, 201, 87, 72, 175, 202, 44, 80, 40, 207, 47, 202,
    73, 81, 4, 0, 132, 157, 31, 106, 17, 0, 0, 0,
  ])
  // Bad magic
  let mut bad_magic = rt_clone_bytes(good_gz)
  bad_magic[0] = (30).to_byte()
  debug_assert(rt_is_err(gzip_decompress(bad_magic)), "bad gzip magic")
  // Bad CRC-32
  let mut bad_crc = rt_clone_bytes(good_gz)
  bad_crc[bad_crc.length() - 5] = (107).to_byte()
  match gzip_decompress(bad_crc) {
    Err(FlateError::ChecksumMismatch(_)) => ()
    _ => debug_assert(false, "bad gzip CRC-32 must return ChecksumMismatch")
  }
  // Bad ISIZE
  let mut bad_isize = rt_clone_bytes(good_gz)
  bad_isize[bad_isize.length() - 4] = (18).to_byte()
  match gzip_decompress(bad_isize) {
    Err(FlateError::ChecksumMismatch(_)) => ()
    _ => debug_assert(false, "bad gzip ISIZE must return ChecksumMismatch")
  }
  // Reserved gzip FLG bits set (bit 5 = 0x20)
  let mut bad_flg = rt_clone_bytes(good_gz)
  bad_flg[3] = (0x28).to_byte()
  debug_assert(rt_is_err(gzip_decompress(bad_flg)), "reserved gzip FLG bits")
  // Truncated gzip trailer
  debug_assert(
    rt_is_err(gzip_decompress(good_gz.slice(0, good_gz.length() - 4))),
    "truncated gzip trailer",
  )
}
