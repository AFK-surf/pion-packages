///| Red-team unit tests for `packages/flate`.
///| Assertions encode the *expected correct* behaviour: a test FAILS while the defect exists and
///| PASSES once fixed.  Tests prefixed `control_` document behaviour that is already correct.
///| Cross-implementation evidence for every item lives in `difftest.py` and `REPORT.md`.

import "flate"

///|
fn au_bytes(vals : Array[Int]) -> Bytes {
  let mut b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn au_fill(n : Int, v : Int) -> Bytes {
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = v.to_byte()
    i = i + 1
  }
  b
}

///|
fn au_concat(a : Bytes, b : Bytes) -> Bytes {
  let mut o = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    o[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    o[a.length() + j] = b[j]
    j = j + 1
  }
  o
}

///|
fn au_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn au_gz(data : Bytes, h : flate::GzipHeader) -> Bytes {
  match flate::gzip_compress_with_header(data, 6, h) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///|
fn au_header(name : String, comment : String) -> flate::GzipHeader {
  flate::GzipHeader::{
    mtime: 0U,
    extra_flags: 0,
    os: 3,
    extra: Bytes::new(0),
    name: name,
    comment: comment,
    has_extra: false,
    has_name: name.length() > 0,
    has_comment: comment.length() > 0,
    has_hcrc: false,
  }
}

// ---------------------------------------------------------------------------------------------
// P2-1: gzip FNAME / FCOMMENT charset: encoder writes UTF-8 instead of RFC 1952 ISO-8859-1.
// (Pion<->Pion round-trips because `Bytes::to_string` decodes valid UTF-8 first; other readers see mojibake.)
// ---------------------------------------------------------------------------------------------

///|
test "control_gzip_name_non_ascii_self_roundtrip" {
  // Control: Pion's own encoder + decoder round-trip a non-ASCII name.
  let gz = au_gz("payload".to_bytes(), au_header("café.txt", ""))
  match flate::gzip_decompress_full(gz, 1024) {
    Ok(dec) =>
    debug_assert(
      dec.header.name == "café.txt",
      "gzip FNAME \"café.txt\" came back as \"" + dec.header.name + "\" (encoder UTF-8 / decoder Latin-1 mismatch)",
    )
    Err(e) => debug_assert(false, flate::flate_error_message(e))
  }
}

///|
test "control_gzip_comment_non_ascii_self_roundtrip" {
  let gz = au_gz("payload".to_bytes(), au_header("", "naïve ±"))
  match flate::gzip_decompress_full(gz, 1024) {
    Ok(dec) =>
    debug_assert(
      dec.header.comment == "naïve ±",
      "gzip FCOMMENT came back as \"" + dec.header.comment + "\"",
    )
    Err(e) => debug_assert(false, flate::flate_error_message(e))
  }
}

///|
test "redteam_gzip_name_is_iso8859_1_on_the_wire" {
  // RFC 1952 §2.3.1: FNAME "must consist of ISO 8859-1 (LATIN-1) characters".  'é' is the single byte 0xE9.
  // Go `compress/gzip` writes 0xE9; Pion writes the UTF-8 pair 0xC3 0xA9 which every RFC reader shows as "Ã©".
  let gz = au_gz("x".to_bytes(), au_header("é", ""))
  debug_assert(gz.length() > 12, "compress failed")
  debug_assert(
    gz[10].to_int() == 0xE9 && gz[11].to_int() == 0,
    "FNAME bytes on the wire: " + gz[10].to_int().to_string() + "," + gz[11].to_int().to_string() + " (expected 233,0)",
  )
}

///|
test "redteam_gzip_name_with_nul_must_not_corrupt_stream" {
  // A NUL inside FNAME terminates the field early; the remaining name bytes are then parsed as DEFLATE data.
  // Go rejects such names (`gzip.Writer: non-Latin-1 header string` / NUL check).  Either reject or round-trip.
  match flate::gzip_compress_with_header("payload".to_bytes(), 6, au_header("a\u{0}b", "")) {
    Err(_) => ()
    Ok(gz) =>
    match flate::gzip_decompress(gz) {
      Ok(out) => debug_assert(au_eq(out, "payload".to_bytes()), "payload corrupted")
      Err(e) =>
      debug_assert(
        false,
        "gzip_compress_with_header accepted a NUL in FNAME and produced an undecodable stream: " +
        flate::flate_error_message(e),
      )
    }
  }
}

///|
test "redteam_gzip_name_non_latin1_rejected" {
  // Characters outside ISO-8859-1 cannot be represented in FNAME; Go returns an error, Pion silently emits UTF-8.
  let r = flate::gzip_compress_with_header("x".to_bytes(), 6, au_header("名字.txt", ""))
  let rejected = match r {
    Err(_) => true
    Ok(_) => false
  }
  debug_assert(rejected, "non-Latin-1 FNAME accepted and written as raw UTF-8 bytes")
}

// ---------------------------------------------------------------------------------------------
// P2: zlib FDICT with an empty preset dictionary (DICTID = adler32("") = 1)
// ---------------------------------------------------------------------------------------------

///|
test "redteam_zlib_fdict_empty_dictionary_accepted" {
  // CMF=0x78 FLG=0xBB (FDICT, FCHECK ok) DICTID=00000001, fixed block "hi", Adler-32("hi") = 0x013B00D2.
  // zlib (inflateSetDictionary with len 0) and Go (NewReaderDict with []byte{}) both accept.
  let fixed_hi = match flate::deflate_compress("hi".to_bytes(), 1) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let head = au_bytes([0x78, 0xBB, 0, 0, 0, 1])
  let adl = flate::adler32("hi".to_bytes())
  let tail = au_bytes([
    ((adl >> 24) & 0xFFU).to_int(),
    ((adl >> 16) & 0xFFU).to_int(),
    ((adl >> 8) & 0xFFU).to_int(),
    (adl & 0xFFU).to_int(),
  ])
  let z = au_concat(au_concat(head, fixed_hi), tail)
  debug_assert((0x78 * 256 + 0xBB) % 31 == 0, "test vector FCHECK")
  match flate::zlib_decompress_with_dict(z, Bytes::new(0), 1024) {
    Ok(out) => debug_assert(au_eq(out, "hi".to_bytes()), "wrong output")
    Err(e) =>
    debug_assert(false, "empty preset dictionary (DICTID=1) rejected: " + flate::flate_error_message(e))
  }
}

// ---------------------------------------------------------------------------------------------
// Controls (already correct; kept as regression guards)
// ---------------------------------------------------------------------------------------------

///|
test "control_output_limit_is_exact" {
  let data = au_fill(100000, 0x41)
  let raw = match flate::deflate_compress(data, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match flate::deflate_decompress_with_limit(raw, 100000) {
    Ok(out) => debug_assert(out.length() == 100000, "len")
    Err(e) => debug_assert(false, "limit == size must pass: " + flate::flate_error_message(e))
  }
  let over = match flate::deflate_decompress_with_limit(raw, 99999) {
    Err(flate::FlateError::OutputLimitExceeded(_)) => true
    _ => false
  }
  debug_assert(over, "limit == size-1 must fail with OutputLimitExceeded")
  match flate::deflate_decompress_with_limit(au_bytes([3, 0]), 0) {
    Ok(out) => debug_assert(out.length() == 0, "empty")
    Err(e) => debug_assert(false, "empty stream with limit 0: " + flate::flate_error_message(e))
  }
}

///|
test "control_gzip_multimember_cumulative_limit" {
  let m = flate::gzip_compress_default(au_fill(600, 0x42))
  let two = au_concat(m, m)
  match flate::gzip_decompress_with_limit(two, 1200) {
    Ok(out) => debug_assert(out.length() == 1200, "len")
    Err(e) => debug_assert(false, flate::flate_error_message(e))
  }
  let over = match flate::gzip_decompress_with_limit(two, 1199) {
    Err(flate::FlateError::OutputLimitExceeded(_)) => true
    _ => false
  }
  debug_assert(over, "cumulative multi-member limit")
}

///|
test "control_adler32_crc32_large_and_split" {
  let n = 10 * 1024 * 1024 + 12345
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = ((i * 7 + 3) & 255).to_byte()
    i = i + 1
  }
  // reference values from CPython zlib
  debug_assert(flate::adler32(b) == 0xE0AFAD44U, "adler32 10 MiB")
  debug_assert(flate::crc32(b) == 0x6DF74013U, "crc32 10 MiB")
  // incremental with awkward split points must equal one-shot
  let splits = [1, 7, 5551, 5552, 5553, 65521, 100003]
  let mut a : UInt = 1U
  let mut c : UInt = 0U
  let mut pos = 0
  let mut si = 0
  while pos < n {
    let step = splits[si % splits.length()]
    let e = if pos + step > n { n } else { pos + step }
    a = flate::adler32_update_slice(a, b, pos, e)
    c = flate::crc32_update_slice(c, b, pos, e)
    pos = e
    si = si + 1
  }
  debug_assert(a == 0xE0AFAD44U, "adler32 split")
  debug_assert(c == 0x6DF74013U, "crc32 split")
  // all-0xFF just past 3*NMAX: worst case for deferred modulo
  debug_assert(flate::adler32(au_fill(5552 * 3 + 7, 0xFF)) == 0x08B5D9AAU, "adler32 0xFF NMAX boundary")
}

///|
test "control_bomb_rejected_with_small_limit" {
  let raw = match flate::deflate_compress(au_fill(8 * 1024 * 1024, 0), 9) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  debug_assert(raw.length() < 16384, "bomb ratio")
  let blocked = match flate::deflate_decompress_with_limit(raw, 65536) {
    Err(flate::FlateError::OutputLimitExceeded(_)) => true
    _ => false
  }
  debug_assert(blocked, "8 MiB bomb with 64 KiB limit")
}

///|
test "control_compress_all_levels_pathological_roundtrip" {
  // Fibonacci-distributed literal frequencies force Package-Merge to clamp at 15 bits.
  let mut fib : Array[Int] = [1, 1]
  while fib.length() < 22 {
    fib.push(fib[fib.length() - 1] + fib[fib.length() - 2])
  }
  let mut total = 0
  let mut k = 0
  while k < 22 {
    total = total + fib[k]
    k = k + 1
  }
  let mut data = Bytes::new(total)
  // interleave symbols deterministically so LZ77 cannot collapse runs
  let left : Array[Int] = []
  k = 0
  while k < 22 {
    left.push(fib[k])
    k = k + 1
  }
  let mut p = 0
  let mut s = 0
  while p < total {
    if left[s] > 0 {
      data[p] = (s * 11 + 1).to_byte()
      left[s] = left[s] - 1
      p = p + 1
    }
    s = (s + 1) % 22
  }
  let mut lvl = 0
  while lvl <= 9 {
    match flate::deflate_compress(data, lvl) {
      Ok(raw) =>
      match flate::deflate_decompress(raw) {
        Ok(out) => debug_assert(au_eq(out, data), "fib roundtrip level " + lvl.to_string())
        Err(e) => debug_assert(false, "level " + lvl.to_string() + ": " + flate::flate_error_message(e))
      }
      Err(e) => debug_assert(false, flate::flate_error_message(e))
    }
    lvl = lvl + 1
  }
}
