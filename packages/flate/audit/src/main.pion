///| Red-team differential harness CLI for `packages/flate`.
///| Batch file format: repeated `[u32 LE length][payload]` records.
///| Modes:
///|   batch <inflate|zlib|gzip> <cases.bin> <limit>        -> one line per case: `OK <len> <crc32>` | `ERR <Variant>`
///|   compress <level> <cases.bin> <out.bin>              -> raw DEFLATE of every case (same record format)
///|   file <inflate|zlib|gzip> <in> <limit> [out]         -> single-file decode (for bombs / bench)
///|   cfile <level> <in> <out>                            -> single-file raw DEFLATE compress
///|   gzfile <level> <in> <out>                           -> single-file gzip compress
///|   bench <d|c1|c6|c9|crc> <file> <iters>              -> timed loop for bench_compare.py (identical stdout across impls)

import "flate"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut neg = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 45 && i == 0 {
      neg = true
    } else if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    0 - acc
  } else {
    acc
  }
}

///|
fn err_name(e : flate::FlateError) -> String {
  match e {
    UnexpectedEof(_) => "UnexpectedEof"
    InvalidBlockType(_) => "InvalidBlockType"
    InvalidStoredLength(_) => "InvalidStoredLength"
    InvalidHuffmanTree(_) => "InvalidHuffmanTree"
    InvalidSymbol(_) => "InvalidSymbol"
    InvalidDistance(_) => "InvalidDistance"
    InvalidHeader(_) => "InvalidHeader"
    ChecksumMismatch(_) => "ChecksumMismatch"
    OutputLimitExceeded(_) => "OutputLimitExceeded"
    InvalidLevel(_) => "InvalidLevel"
    UnsupportedFeature(_) => "UnsupportedFeature"
  }
}

///|
fn decode(op : String, data : Bytes, limit : Int) -> Result[Bytes, flate::FlateError] {
  if op == "inflate" {
    flate::deflate_decompress_with_limit(data, limit)
  } else if op == "zlib" {
    flate::zlib_decompress_with_limit(data, limit)
  } else {
    flate::gzip_decompress_with_limit(data, limit)
  }
}

///|
fn read_u32le(b : Bytes, p : Int) -> Int {
  b[p].to_int() |
  (b[p + 1].to_int() << 8) |
  (b[p + 2].to_int() << 16) |
  (b[p + 3].to_int() << 24)
}

///|
fn put_u32le(b : Bytes, p : Int, v : Int) -> Unit {
  b[p] = (v & 255).to_byte()
  b[p + 1] = ((v >> 8) & 255).to_byte()
  b[p + 2] = ((v >> 16) & 255).to_byte()
  b[p + 3] = ((v >> 24) & 255).to_byte()
}

///|
fn split_records(b : Bytes) -> Array[Bytes] {
  let out : Array[Bytes] = []
  let n = b.length()
  let mut p = 0
  while p + 4 <= n {
    let len = read_u32le(b, p)
    p = p + 4
    out.push(b.slice(p, p + len))
    p = p + len
  }
  out
}

///|
fn result_line(r : Result[Bytes, flate::FlateError]) -> String {
  match r {
    Ok(out) =>
    "OK " + out.length().to_string() + " " + flate::crc32(out).to_int64().to_string()
    Err(e) => "ERR " + err_name(e)
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: flate_audit <batch|compress|file|cfile|gzfile> ...")
    return 2
  }
  let mode = args[1]
  if mode == "batch" {
    let data = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let limit = if args.length() >= 5 { parse_int(args[4]) } else { 16777216 }
    let recs = split_records(data)
    let sb = StringBuilder::new()
    let mut i = 0
    while i < recs.length() {
      sb.write_string(result_line(decode(args[2], recs[i], limit)))
      sb.write_string("\n")
      i = i + 1
    }
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "compress" {
    let lvl = parse_int(args[2])
    let data = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let recs = split_records(data)
    let outs : Array[Bytes] = []
    let mut total = 0
    let mut i = 0
    while i < recs.length() {
      let c = match flate::deflate_compress(recs[i], lvl) {
        Ok(b) => b
        Err(_) => Bytes::new(0)
      }
      total = total + 4 + c.length()
      outs.push(c)
      i = i + 1
    }
    let mut buf = Bytes::new(total)
    let mut p = 0
    i = 0
    while i < outs.length() {
      let c = outs[i]
      put_u32le(buf, p, c.length())
      p = p + 4
      let mut k = 0
      while k < c.length() {
        buf[p + k] = c[k]
        k = k + 1
      }
      p = p + c.length()
      i = i + 1
    }
    let _ = fs_write_bytes(world, args[4], buf)
    return 0
  }
  if mode == "file" {
    let data = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let limit = if args.length() >= 5 { parse_int(args[4]) } else { flate::default_max_output_bytes }
    let r = decode(args[2], data, limit)
    io_println(world, result_line(r))
    if args.length() >= 6 {
      match r {
        Ok(out) => {
          let _ = fs_write_bytes(world, args[5], out)
        }
        Err(_) => ()
      }
    }
    return 0
  }
  if mode == "cfile" || mode == "gzfile" {
    let lvl = parse_int(args[2])
    let data = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let r = if mode == "cfile" {
      flate::deflate_compress(data, lvl)
    } else {
      flate::gzip_compress(data, lvl)
    }
    match r {
      Ok(c) => {
        if args.length() >= 5 {
          let _ = fs_write_bytes(world, args[4], c)
        }
        io_println(world, "OK " + c.length().to_string())
      }
      Err(e) => io_println(world, "ERR " + err_name(e))
    }
    return 0
  }
  if mode == "bench" {
    let data = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let iters = if args.length() >= 5 { parse_int(args[4]) } else { 1 }
    let op = args[2]
    let mut i = 0
    let mut last = Bytes::new(0)
    let mut c : UInt = 0U
    let mut a : UInt = 1U
    while i < iters {
      if op == "d" {
        match flate::gzip_decompress_with_limit(data, 1073741824) {
          Ok(out) => last = out
          Err(e) => {
            io_println(world, "ERR " + err_name(e))
            return 1
          }
        }
      } else if op == "crc" {
        c = flate::crc32_update(c, data)
        a = flate::adler32_update(a, data)
      } else {
        let lvl = parse_int(op)
        match flate::gzip_compress(data, lvl) {
          Ok(gz) => last = gz
          Err(_) => return 1
        }
      }
      i = i + 1
    }
    if op == "d" {
      io_println(world, "OK " + last.length().to_string() + " " + flate::crc32(last).to_int64().to_string())
    } else if op == "crc" {
      io_println(world, "OK " + c.to_int64().to_string() + " " + a.to_int64().to_string())
    } else {
      // verify our own output once so a broken encoder cannot "win"
      match flate::gzip_decompress_with_limit(last, 1073741824) {
        Ok(out) =>
        io_println(world, "OK " + out.length().to_string() + " " + flate::crc32(out).to_int64().to_string())
        Err(_) => return 1
      }
    }
    return 0
  }
  2
}
