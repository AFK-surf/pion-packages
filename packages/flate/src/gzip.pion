///| RFC 1952 gzip compression and decompression with full header flags
///| (FEXTRA, FNAME, FCOMMENT, FHCRC), CRC-32 + ISIZE verification, and multi-member concatenation.

///| Encode a UTF-8 `String` into RFC 1952 ISO-8859-1 (Latin-1) bytes.
///| Rejects NUL (`\u{0}`) and any code point > U+00FF with `FlateError::InvalidHeader`.
fn encode_iso8859_1(s : String, field : String) -> Result[Bytes, FlateError] {
  let raw = s.to_bytes()
  let n = raw.length()
  let mut out = Bytes::new(n)
  let mut i = 0
  let mut j = 0
  while i < n {
    let b0 = raw[i].to_int()
    if b0 == 0 {
      return Err(FlateError::InvalidHeader("gzip " + field + " contains NUL byte"))
    }
    if b0 < 0x80 {
      out[j] = b0.to_byte()
      j = j + 1
      i = i + 1
    } else if (b0 == 0xC2 || b0 == 0xC3) && i + 1 < n {
      let b1 = raw[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return Err(FlateError::InvalidHeader("gzip " + field + " contains invalid UTF-8"))
      }
      let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
      out[j] = cp.to_byte()
      j = j + 1
      i = i + 2
    } else {
      return Err(FlateError::InvalidHeader("gzip " + field + " contains non-ISO-8859-1 character"))
    }
  }
  if j == n {
    Ok(out)
  } else {
    Ok(out.slice(0, j))
  }
}

///| Decode RFC 1952 ISO-8859-1 (Latin-1) bytes `data[start..end]` into a UTF-8 `String`.
fn decode_iso8859_1(data : Bytes, start : Int, end : Int) -> String {
  let mut non_ascii = 0
  let mut i = start
  while i < end {
    if data[i].to_int() >= 0x80 {
      non_ascii = non_ascii + 1
    }
    i = i + 1
  }
  if non_ascii == 0 {
    return data.slice(start, end).to_string()
  }
  let mut utf8 = Bytes::new((end - start) + non_ascii)
  let mut j = 0
  i = start
  while i < end {
    let b = data[i].to_int()
    if b < 0x80 {
      utf8[j] = b.to_byte()
      j = j + 1
    } else {
      utf8[j] = (0xC0 | (b >> 6)).to_byte()
      utf8[j + 1] = (0x80 | (b & 0x3F)).to_byte()
      j = j + 2
    }
    i = i + 1
  }
  utf8.to_string()
}

///| Compress `data` into an RFC 1952 gzip stream at `level` (0..9).
pub fn gzip_compress(data : Bytes, level : Int) -> Result[Bytes, FlateError] {
  gzip_compress_with_header(data, level, GzipHeader::default())
}

///| Compress `data` into an RFC 1952 gzip stream at default level 6.
pub fn gzip_compress_default(data : Bytes) -> Bytes {
  match gzip_compress(data, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///| Compress `data` into an RFC 1952 gzip stream with custom `GzipHeader`.
pub fn gzip_compress_with_header(
  data : Bytes,
  level : Int,
  header : GzipHeader,
) -> Result[Bytes, FlateError] {
  if level < 0 || level > 9 {
    return Err(FlateError::InvalidLevel(level))
  }

  let name_bytes = match encode_iso8859_1(header.name, "FNAME") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let comment_bytes = match encode_iso8859_1(header.comment, "FCOMMENT") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let has_extra = header.has_extra || header.extra.length() > 0
  let has_name = header.has_name || name_bytes.length() > 0
  let has_comment = header.has_comment || comment_bytes.length() > 0
  let has_hcrc = header.has_hcrc

  if has_extra && header.extra.length() > 65535 {
    return Err(FlateError::InvalidHeader("gzip FEXTRA length exceeds 65535 bytes"))
  }

  let raw = match deflate_compress(data, level) {
    Ok(b) => b
    Err(e) => return Err(e)
  }

  let mut flg = 0
  if has_hcrc {
    flg = flg | 0x02
  }
  if has_extra {
    flg = flg | 0x04
  }
  if has_name {
    flg = flg | 0x08
  }
  if has_comment {
    flg = flg | 0x10
  }

  let xfl = if header.extra_flags != 0 {
    header.extra_flags & 0xFF
  } else if level >= 9 {
    2
  } else if level == 1 {
    4
  } else {
    0
  }

  let mut hdr_len = 10
  if has_extra {
    hdr_len = hdr_len + 2 + header.extra.length()
  }
  if has_name {
    hdr_len = hdr_len + name_bytes.length() + 1
  }
  if has_comment {
    hdr_len = hdr_len + comment_bytes.length() + 1
  }
  let hcrc_bytes = if has_hcrc { 2 } else { 0 }

  let mut hdr = Bytes::new(hdr_len + hcrc_bytes)
  // Fixed 10-byte header
  hdr[0] = (0x1F).to_byte()
  hdr[1] = (0x8B).to_byte()
  hdr[2] = (8).to_byte()
  hdr[3] = flg.to_byte()
  hdr[4] = (header.mtime & 0xFFU).to_int().to_byte()
  hdr[5] = ((header.mtime >> 8) & 0xFFU).to_int().to_byte()
  hdr[6] = ((header.mtime >> 16) & 0xFFU).to_int().to_byte()
  hdr[7] = ((header.mtime >> 24) & 0xFFU).to_int().to_byte()
  hdr[8] = xfl.to_byte()
  hdr[9] = (header.os & 0xFF).to_byte()

  let mut pos = 10
  if has_extra {
    let xlen = header.extra.length()
    hdr[pos] = (xlen & 0xFF).to_byte()
    hdr[pos + 1] = ((xlen >> 8) & 0xFF).to_byte()
    pos = pos + 2
    let mut i = 0
    while i < xlen {
      hdr[pos + i] = header.extra[i]
      i = i + 1
    }
    pos = pos + xlen
  }
  if has_name {
    let mut i = 0
    while i < name_bytes.length() {
      hdr[pos + i] = name_bytes[i]
      i = i + 1
    }
    pos = pos + name_bytes.length()
    hdr[pos] = (0).to_byte()
    pos = pos + 1
  }
  if has_comment {
    let mut i = 0
    while i < comment_bytes.length() {
      hdr[pos + i] = comment_bytes[i]
      i = i + 1
    }
    pos = pos + comment_bytes.length()
    hdr[pos] = (0).to_byte()
    pos = pos + 1
  }
  if has_hcrc {
    let hcrc = crc32_update_slice(0U, hdr, 0, pos) & 0xFFFFU
    hdr[pos] = (hcrc & 0xFFU).to_int().to_byte()
    hdr[pos + 1] = ((hcrc >> 8) & 0xFFU).to_int().to_byte()
  }

  // 8-byte trailer: CRC32 (LE) + ISIZE (LE)
  let c = crc32(data)
  let isize = data.length().to_uint()
  let mut trailer = Bytes::new(8)
  trailer[0] = (c & 0xFFU).to_int().to_byte()
  trailer[1] = ((c >> 8) & 0xFFU).to_int().to_byte()
  trailer[2] = ((c >> 16) & 0xFFU).to_int().to_byte()
  trailer[3] = ((c >> 24) & 0xFFU).to_int().to_byte()
  trailer[4] = (isize & 0xFFU).to_int().to_byte()
  trailer[5] = ((isize >> 8) & 0xFFU).to_int().to_byte()
  trailer[6] = ((isize >> 16) & 0xFFU).to_int().to_byte()
  trailer[7] = ((isize >> 24) & 0xFFU).to_int().to_byte()
  Ok(hdr.concat(raw).concat(trailer))
}

///| Decompress an RFC 1952 gzip stream (including concatenated multi-member streams).
pub fn gzip_decompress(data : Bytes) -> Result[Bytes, FlateError] {
  gzip_decompress_with_limit(data, default_max_output_bytes)
}

///| Decompress an RFC 1952 gzip stream enforcing `max_output_bytes` (`0` means unlimited).
pub fn gzip_decompress_with_limit(
  data : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  match gzip_decompress_full(data, max_output_bytes) {
    Ok(dec) => Ok(dec.data)
    Err(e) => Err(e)
  }
}

///| Decompress an RFC 1952 gzip stream and return data + first member header + member count.
///| `max_output_bytes == 0` disables the output size limit.
pub fn gzip_decompress_full(
  data : Bytes,
  max_output_bytes : Int,
) -> Result[GzipDecoded, FlateError] {
  if max_output_bytes < 0 {
    return Err(FlateError::OutputLimitExceeded(max_output_bytes))
  }
  let eff_limit = if max_output_bytes == 0 { 2147483647 } else { max_output_bytes }
  let n = data.length()
  if n < 18 {
    return Err(FlateError::UnexpectedEof("gzip stream shorter than 18 bytes"))
  }
  let mut pos = 0
  let mut member_count = 0
  let mut first_header = GzipHeader::default()
  let chunks : Array[Bytes] = []
  let mut total_out = 0
  let scratch = InflateScratch::new()

  while pos < n {
    let member_start = pos
    if pos + 10 > n {
      return Err(FlateError::UnexpectedEof("truncated gzip member header"))
    }
    if data[pos].to_int() != 0x1F || data[pos + 1].to_int() != 0x8B {
      return Err(FlateError::InvalidHeader("invalid gzip magic bytes"))
    }
    if data[pos + 2].to_int() != 8 {
      return Err(FlateError::InvalidHeader("unsupported gzip compression method"))
    }
    let flg = data[pos + 3].to_int()
    if (flg & 0xE0) != 0 {
      return Err(FlateError::InvalidHeader("reserved gzip FLG bits set"))
    }
    let mtime = data[pos + 4].to_int().to_uint() |
    (data[pos + 5].to_int().to_uint() << 8) |
    (data[pos + 6].to_int().to_uint() << 16) |
    (data[pos + 7].to_int().to_uint() << 24)
    let xfl = data[pos + 8].to_int()
    let os = data[pos + 9].to_int()
    pos = pos + 10

    let has_hcrc = (flg & 0x02) != 0
    let has_extra = (flg & 0x04) != 0
    let has_name = (flg & 0x08) != 0
    let has_comment = (flg & 0x10) != 0

    let mut extra = Bytes::new(0)
    if has_extra {
      if pos + 2 > n {
        return Err(FlateError::UnexpectedEof("truncated gzip FEXTRA length"))
      }
      let xlen = data[pos].to_int() | (data[pos + 1].to_int() << 8)
      pos = pos + 2
      if pos + xlen > n {
        return Err(FlateError::UnexpectedEof("truncated gzip FEXTRA payload"))
      }
      extra = data.slice(pos, pos + xlen)
      pos = pos + xlen
    }

    let mut name = ""
    if has_name {
      let s = pos
      while pos < n && data[pos].to_int() != 0 {
        pos = pos + 1
      }
      if pos + 9 > n {
        return Err(FlateError::UnexpectedEof("unterminated gzip FNAME"))
      }
      if member_count == 0 {
        name = decode_iso8859_1(data, s, pos)
      }
      pos = pos + 1
    }

    let mut comment = ""
    if has_comment {
      let s = pos
      while pos < n && data[pos].to_int() != 0 {
        pos = pos + 1
      }
      if pos + 9 > n {
        return Err(FlateError::UnexpectedEof("unterminated gzip FCOMMENT"))
      }
      if member_count == 0 {
        comment = decode_iso8859_1(data, s, pos)
      }
      pos = pos + 1
    }

    if has_hcrc {
      if pos + 2 > n {
        return Err(FlateError::UnexpectedEof("truncated gzip FHCRC"))
      }
      let expected_hcrc = (data[pos].to_int() | (data[pos + 1].to_int() << 8)).to_uint()
      let actual_hcrc = crc32_update_slice(0U, data, member_start, pos) & 0xFFFFU
      if expected_hcrc != actual_hcrc {
        return Err(FlateError::ChecksumMismatch("gzip FHCRC mismatch"))
      }
      pos = pos + 2
    }

    if member_count == 0 {
      first_header = GzipHeader::{
        mtime: mtime,
        extra_flags: xfl,
        os: os,
        extra: extra,
        name: name,
        comment: comment,
        has_extra: has_extra,
        has_name: has_name,
        has_comment: has_comment,
        has_hcrc: has_hcrc,
      }
    }

    let remaining_limit = eff_limit - total_out
    let hint_cap = if member_count == 0 { -1 } else { 256 }
    let (member_out, end_pos) = match
    inflate_raw_into(data, pos, remaining_limit, Bytes::new(0), scratch, hint_cap) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    pos = end_pos

    if pos + 8 > n {
      return Err(FlateError::UnexpectedEof("truncated gzip trailer"))
    }
    let expected_crc = data[pos].to_int().to_uint() |
    (data[pos + 1].to_int().to_uint() << 8) |
    (data[pos + 2].to_int().to_uint() << 16) |
    (data[pos + 3].to_int().to_uint() << 24)
    let expected_isize = data[pos + 4].to_int().to_uint() |
    (data[pos + 5].to_int().to_uint() << 8) |
    (data[pos + 6].to_int().to_uint() << 16) |
    (data[pos + 7].to_int().to_uint() << 24)
    pos = pos + 8

    let actual_crc = crc32(member_out)
    if expected_crc != actual_crc {
      return Err(FlateError::ChecksumMismatch("gzip CRC-32 mismatch"))
    }
    let actual_isize = member_out.length().to_uint()
    if expected_isize != actual_isize {
      return Err(FlateError::ChecksumMismatch("gzip ISIZE mismatch"))
    }

    if member_out.length() > 0 {
      total_out = total_out + member_out.length()
      chunks.push(member_out)
    }
    member_count = member_count + 1
  }

  let final_data = concat_bytes_chunks(chunks)

  Ok(GzipDecoded::{
    data: final_data,
    header: first_header,
    member_count: member_count,
  })
}
