///| RFC 1952 gzip compression and decompression with full header flags
///| (FEXTRA, FNAME, FCOMMENT, FHCRC), CRC-32 + ISIZE verification, and multi-member concatenation.

///| Compress `data` into an RFC 1952 gzip stream at `level` (0..9).
pub fn gzip_compress(data : Bytes, level : Int) -> Result[Bytes, FlateError] {
  gzip_compress_with_header(data, level, GzipHeader::default())
}

///| Compress `data` into an RFC 1952 gzip stream at default level 6.
pub fn gzip_compress_default(data : Bytes) -> Bytes {
  match gzip_compress(data, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///| Compress `data` into an RFC 1952 gzip stream with custom `GzipHeader`.
pub fn gzip_compress_with_header(
  data : Bytes,
  level : Int,
  header : GzipHeader,
) -> Result[Bytes, FlateError] {
  if level < 0 || level > 9 {
    return Err(FlateError::InvalidLevel(level))
  }
  let raw = match deflate_compress(data, level) {
    Ok(b) => b
    Err(e) => return Err(e)
  }

  let name_bytes = header.name.to_bytes()
  let comment_bytes = header.comment.to_bytes()
  let has_extra = header.has_extra || header.extra.length() > 0
  let has_name = header.has_name || name_bytes.length() > 0
  let has_comment = header.has_comment || comment_bytes.length() > 0
  let has_hcrc = header.has_hcrc

  if has_extra && header.extra.length() > 65535 {
    return Err(FlateError::InvalidHeader("gzip FEXTRA length exceeds 65535 bytes"))
  }

  let mut flg = 0
  if has_hcrc {
    flg = flg | 0x02
  }
  if has_extra {
    flg = flg | 0x04
  }
  if has_name {
    flg = flg | 0x08
  }
  if has_comment {
    flg = flg | 0x10
  }

  let xfl = if header.extra_flags != 0 {
    header.extra_flags & 0xFF
  } else if level >= 9 {
    2
  } else if level == 1 {
    4
  } else {
    0
  }

  let mut hdr_len = 10
  if has_extra {
    hdr_len = hdr_len + 2 + header.extra.length()
  }
  if has_name {
    hdr_len = hdr_len + name_bytes.length() + 1
  }
  if has_comment {
    hdr_len = hdr_len + comment_bytes.length() + 1
  }
  let hcrc_bytes = if has_hcrc { 2 } else { 0 }

  let rlen = raw.length()
  let total_len = hdr_len + hcrc_bytes + rlen + 8
  let mut out = Bytes::new(total_len)

  // Fixed 10-byte header
  out[0] = (0x1F).to_byte()
  out[1] = (0x8B).to_byte()
  out[2] = (8).to_byte()
  out[3] = flg.to_byte()
  out[4] = (header.mtime & 0xFFU).to_int().to_byte()
  out[5] = ((header.mtime >> 8) & 0xFFU).to_int().to_byte()
  out[6] = ((header.mtime >> 16) & 0xFFU).to_int().to_byte()
  out[7] = ((header.mtime >> 24) & 0xFFU).to_int().to_byte()
  out[8] = xfl.to_byte()
  out[9] = (header.os & 0xFF).to_byte()

  let mut pos = 10
  if has_extra {
    let xlen = header.extra.length()
    out[pos] = (xlen & 0xFF).to_byte()
    out[pos + 1] = ((xlen >> 8) & 0xFF).to_byte()
    pos = pos + 2
    let mut i = 0
    while i < xlen {
      out[pos + i] = header.extra[i]
      i = i + 1
    }
    pos = pos + xlen
  }
  if has_name {
    let mut i = 0
    while i < name_bytes.length() {
      out[pos + i] = name_bytes[i]
      i = i + 1
    }
    pos = pos + name_bytes.length()
    out[pos] = (0).to_byte()
    pos = pos + 1
  }
  if has_comment {
    let mut i = 0
    while i < comment_bytes.length() {
      out[pos + i] = comment_bytes[i]
      i = i + 1
    }
    pos = pos + comment_bytes.length()
    out[pos] = (0).to_byte()
    pos = pos + 1
  }
  if has_hcrc {
    let hcrc = crc32_update_slice(0U, out, 0, pos) & 0xFFFFU
    out[pos] = (hcrc & 0xFFU).to_int().to_byte()
    out[pos + 1] = ((hcrc >> 8) & 0xFFU).to_int().to_byte()
    pos = pos + 2
  }

  // Copy raw DEFLATE payload
  let mut i = 0
  let lim8 = rlen - 8
  while i <= lim8 {
    out[pos + i] = raw[i]
    out[pos + i + 1] = raw[i + 1]
    out[pos + i + 2] = raw[i + 2]
    out[pos + i + 3] = raw[i + 3]
    out[pos + i + 4] = raw[i + 4]
    out[pos + i + 5] = raw[i + 5]
    out[pos + i + 6] = raw[i + 6]
    out[pos + i + 7] = raw[i + 7]
    i = i + 8
  }
  while i < rlen {
    out[pos + i] = raw[i]
    i = i + 1
  }
  pos = pos + rlen

  // 8-byte trailer: CRC32 (LE) + ISIZE (LE)
  let c = crc32(data)
  let isize = data.length().to_uint()
  out[pos] = (c & 0xFFU).to_int().to_byte()
  out[pos + 1] = ((c >> 8) & 0xFFU).to_int().to_byte()
  out[pos + 2] = ((c >> 16) & 0xFFU).to_int().to_byte()
  out[pos + 3] = ((c >> 24) & 0xFFU).to_int().to_byte()
  out[pos + 4] = (isize & 0xFFU).to_int().to_byte()
  out[pos + 5] = ((isize >> 8) & 0xFFU).to_int().to_byte()
  out[pos + 6] = ((isize >> 16) & 0xFFU).to_int().to_byte()
  out[pos + 7] = ((isize >> 24) & 0xFFU).to_int().to_byte()
  Ok(out)
}

///| Decompress an RFC 1952 gzip stream (including concatenated multi-member streams).
pub fn gzip_decompress(data : Bytes) -> Result[Bytes, FlateError] {
  gzip_decompress_with_limit(data, default_max_output_bytes)
}

///| Decompress an RFC 1952 gzip stream enforcing `max_output_bytes`.
pub fn gzip_decompress_with_limit(
  data : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  match gzip_decompress_full(data, max_output_bytes) {
    Ok(dec) => Ok(dec.data)
    Err(e) => Err(e)
  }
}

///| Decompress an RFC 1952 gzip stream and return data + first member header + member count.
pub fn gzip_decompress_full(
  data : Bytes,
  max_output_bytes : Int,
) -> Result[GzipDecoded, FlateError] {
  let n = data.length()
  if n < 18 {
    return Err(FlateError::UnexpectedEof("gzip stream shorter than 18 bytes"))
  }
  let mut pos = 0
  let mut member_count = 0
  let mut first_header = GzipHeader::default()
  let chunks : Array[Bytes] = []
  let mut total_out = 0

  while pos < n {
    let member_start = pos
    if pos + 10 > n {
      return Err(FlateError::UnexpectedEof("truncated gzip member header"))
    }
    if data[pos].to_int() != 0x1F || data[pos + 1].to_int() != 0x8B {
      return Err(FlateError::InvalidHeader("invalid gzip magic bytes"))
    }
    if data[pos + 2].to_int() != 8 {
      return Err(FlateError::InvalidHeader("unsupported gzip compression method"))
    }
    let flg = data[pos + 3].to_int()
    if (flg & 0xE0) != 0 {
      return Err(FlateError::InvalidHeader("reserved gzip FLG bits set"))
    }
    let mtime = data[pos + 4].to_int().to_uint() |
    (data[pos + 5].to_int().to_uint() << 8) |
    (data[pos + 6].to_int().to_uint() << 16) |
    (data[pos + 7].to_int().to_uint() << 24)
    let xfl = data[pos + 8].to_int()
    let os = data[pos + 9].to_int()
    pos = pos + 10

    let has_hcrc = (flg & 0x02) != 0
    let has_extra = (flg & 0x04) != 0
    let has_name = (flg & 0x08) != 0
    let has_comment = (flg & 0x10) != 0

    let mut extra = Bytes::new(0)
    if has_extra {
      if pos + 2 > n {
        return Err(FlateError::UnexpectedEof("truncated gzip FEXTRA length"))
      }
      let xlen = data[pos].to_int() | (data[pos + 1].to_int() << 8)
      pos = pos + 2
      if pos + xlen > n {
        return Err(FlateError::UnexpectedEof("truncated gzip FEXTRA payload"))
      }
      extra = data.slice(pos, pos + xlen)
      pos = pos + xlen
    }

    let mut name = ""
    if has_name {
      let s = pos
      while pos < n && data[pos].to_int() != 0 {
        pos = pos + 1
      }
      if pos >= n {
        return Err(FlateError::UnexpectedEof("unterminated gzip FNAME"))
      }
      name = data.slice(s, pos).to_string()
      pos = pos + 1
    }

    let mut comment = ""
    if has_comment {
      let s = pos
      while pos < n && data[pos].to_int() != 0 {
        pos = pos + 1
      }
      if pos >= n {
        return Err(FlateError::UnexpectedEof("unterminated gzip FCOMMENT"))
      }
      comment = data.slice(s, pos).to_string()
      pos = pos + 1
    }

    if has_hcrc {
      if pos + 2 > n {
        return Err(FlateError::UnexpectedEof("truncated gzip FHCRC"))
      }
      let expected_hcrc = (data[pos].to_int() | (data[pos + 1].to_int() << 8)).to_uint()
      let actual_hcrc = crc32_update_slice(0U, data, member_start, pos) & 0xFFFFU
      if expected_hcrc != actual_hcrc {
        return Err(FlateError::ChecksumMismatch("gzip FHCRC mismatch"))
      }
      pos = pos + 2
    }

    if member_count == 0 {
      first_header = GzipHeader::{
        mtime: mtime,
        extra_flags: xfl,
        os: os,
        extra: extra,
        name: name,
        comment: comment,
        has_extra: has_extra,
        has_name: has_name,
        has_comment: has_comment,
        has_hcrc: has_hcrc,
      }
    }

    let remaining_limit = max_output_bytes - total_out
    let (member_out, end_pos) = match
    inflate_raw_into(data, pos, remaining_limit, Bytes::new(0)) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    pos = end_pos

    if pos + 8 > n {
      return Err(FlateError::UnexpectedEof("truncated gzip trailer"))
    }
    let expected_crc = data[pos].to_int().to_uint() |
    (data[pos + 1].to_int().to_uint() << 8) |
    (data[pos + 2].to_int().to_uint() << 16) |
    (data[pos + 3].to_int().to_uint() << 24)
    let expected_isize = data[pos + 4].to_int().to_uint() |
    (data[pos + 5].to_int().to_uint() << 8) |
    (data[pos + 6].to_int().to_uint() << 16) |
    (data[pos + 7].to_int().to_uint() << 24)
    pos = pos + 8

    let actual_crc = crc32(member_out)
    if expected_crc != actual_crc {
      return Err(FlateError::ChecksumMismatch("gzip CRC-32 mismatch"))
    }
    let actual_isize = member_out.length().to_uint()
    if expected_isize != actual_isize {
      return Err(FlateError::ChecksumMismatch("gzip ISIZE mismatch"))
    }

    total_out = total_out + member_out.length()
    chunks.push(member_out)
    member_count = member_count + 1
  }

  let final_data = if chunks.length() == 1 {
    chunks[0]
  } else {
    let mut out = Bytes::new(total_out)
    let mut off = 0
    let mut ci = 0
    while ci < chunks.length() {
      let c = chunks[ci]
      let clen = c.length()
      let mut k = 0
      while k < clen {
        out[off + k] = c[k]
        k = k + 1
      }
      off = off + clen
      ci = ci + 1
    }
    out
  }

  Ok(GzipDecoded::{
    data: final_data,
    header: first_header,
    member_count: member_count,
  })
}
