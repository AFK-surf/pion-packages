///| High-performance RFC 1951 raw DEFLATE compressor.
///| Features a 32 KiB sliding window with 15-bit hash-chain LZ77 (levels 0..9:
///| stored, fast/greedy, and lazy matching), Package-Merge length-limited (<= 15 bit)
///| Canonical Huffman coding, and per-block minimum-cost selection among Stored, Fixed, and Dynamic.

///| 64-bit LSB-first bit writer backed by a growable `Bytes` buffer.
struct BitWriter {
  mut buf : Bytes
  mut len : Int
  mut bitbuf : UInt64
  mut bitcnt : Int
}

///|
fn BitWriter::new(init_cap : Int) -> BitWriter {
  let c = if init_cap < 64 { 64 } else { init_cap }
  BitWriter::{ buf: Bytes::new(c), len: 0, bitbuf: 0UL, bitcnt: 0 }
}

///|
fn bw_ensure(bw : BitWriter, extra : Int) -> Unit {
  let needed = bw.len + extra
  if needed <= bw.buf.length() {
    return
  }
  let mut new_cap = bw.buf.length() * 2
  while new_cap < needed {
    new_cap = new_cap * 2
  }
  let mut next = Bytes::new(new_cap)
  let used = bw.len
  let mut i = 0
  let lim8 = used - 8
  while i <= lim8 {
    next[i] = bw.buf[i]
    next[i + 1] = bw.buf[i + 1]
    next[i + 2] = bw.buf[i + 2]
    next[i + 3] = bw.buf[i + 3]
    next[i + 4] = bw.buf[i + 4]
    next[i + 5] = bw.buf[i + 5]
    next[i + 6] = bw.buf[i + 6]
    next[i + 7] = bw.buf[i + 7]
    i = i + 8
  }
  while i < used {
    next[i] = bw.buf[i]
    i = i + 1
  }
  bw.buf = next
}

///|
fn bw_write_bits(bw : BitWriter, bits : Int, nbits : Int) -> Unit {
  bw.bitbuf = bw.bitbuf | (bits.to_int64().to_uint64() << bw.bitcnt)
  bw.bitcnt = bw.bitcnt + nbits
  if bw.bitcnt >= 32 {
    bw_ensure(bw, 4)
    let w = bw.bitbuf
    bw.buf[bw.len] = (w & 0xFFUL).to_int().to_byte()
    bw.buf[bw.len + 1] = ((w >> 8) & 0xFFUL).to_int().to_byte()
    bw.buf[bw.len + 2] = ((w >> 16) & 0xFFUL).to_int().to_byte()
    bw.buf[bw.len + 3] = ((w >> 24) & 0xFFUL).to_int().to_byte()
    bw.len = bw.len + 4
    bw.bitbuf = bw.bitbuf >> 32
    bw.bitcnt = bw.bitcnt - 32
  }
}

///| Flush remaining bits, zero-padding to next byte boundary.
fn bw_align_byte(bw : BitWriter) -> Unit {
  if bw.bitcnt > 0 {
    let bytes_out = (bw.bitcnt + 7) >> 3
    bw_ensure(bw, bytes_out)
    let mut k = 0
    while k < bytes_out {
      bw.buf[bw.len] = (bw.bitbuf & 0xFFUL).to_int().to_byte()
      bw.len = bw.len + 1
      bw.bitbuf = bw.bitbuf >> 8
      k = k + 1
    }
    bw.bitbuf = 0UL
    bw.bitcnt = 0
  }
}

///| Write raw bytes directly (caller must call `bw_align_byte` first).
fn bw_write_raw(bw : BitWriter, data : Bytes, start : Int, count : Int) -> Unit {
  bw_ensure(bw, count)
  let mut k = 0
  let lim8 = count - 8
  while k <= lim8 {
    bw.buf[bw.len + k] = data[start + k]
    bw.buf[bw.len + k + 1] = data[start + k + 1]
    bw.buf[bw.len + k + 2] = data[start + k + 2]
    bw.buf[bw.len + k + 3] = data[start + k + 3]
    bw.buf[bw.len + k + 4] = data[start + k + 4]
    bw.buf[bw.len + k + 5] = data[start + k + 5]
    bw.buf[bw.len + k + 6] = data[start + k + 6]
    bw.buf[bw.len + k + 7] = data[start + k + 7]
    k = k + 8
  }
  while k < count {
    bw.buf[bw.len + k] = data[start + k]
    k = k + 1
  }
  bw.len = bw.len + count
}

///| Emit stored block(s) for `data[start..start+count]`.
fn emit_stored_blocks(
  bw : BitWriter,
  data : Bytes,
  start : Int,
  count : Int,
  is_final : Bool,
) -> Unit {
  if count == 0 {
    bw_write_bits(bw, if is_final { 1 } else { 0 }, 3)
    bw_align_byte(bw)
    bw_ensure(bw, 4)
    bw.buf[bw.len] = (0).to_byte()
    bw.buf[bw.len + 1] = (0).to_byte()
    bw.buf[bw.len + 2] = (255).to_byte()
    bw.buf[bw.len + 3] = (255).to_byte()
    bw.len = bw.len + 4
    return
  }
  let mut pos = start
  let end = start + count
  while pos < end {
    let rem = end - pos
    let chunk = if rem > 65535 { 65535 } else { rem }
    let chunk_final = is_final && (pos + chunk == end)
    bw_write_bits(bw, if chunk_final { 1 } else { 0 }, 3)
    bw_align_byte(bw)
    bw_ensure(bw, 4)
    let nlen = chunk ^ 0xFFFF
    bw.buf[bw.len] = (chunk & 0xFF).to_byte()
    bw.buf[bw.len + 1] = ((chunk >> 8) & 0xFF).to_byte()
    bw.buf[bw.len + 2] = (nlen & 0xFF).to_byte()
    bw.buf[bw.len + 3] = ((nlen >> 8) & 0xFF).to_byte()
    bw.len = bw.len + 4
    bw_write_raw(bw, data, pos, chunk)
    pos = pos + chunk
  }
}

///| RLE-encode `hlit + hdist` code lengths into `(rle_syms, rle_extra, rle_cnt)` and populate `cl_freqs`.
fn rle_encode_lengths(
  lit_lens : FixedArray[Int],
  hlit : Int,
  dist_lens : FixedArray[Int],
  hdist : Int,
  rle_syms : FixedArray[Int],
  rle_extra : FixedArray[Int],
  cl_freqs : FixedArray[Int],
) -> Int {
  let total = hlit + hdist
  let all : FixedArray[Int] = FixedArray::make(total, 0)
  let mut i = 0
  while i < hlit {
    all[i] = lit_lens[i]
    i = i + 1
  }
  i = 0
  while i < hdist {
    all[hlit + i] = dist_lens[i]
    i = i + 1
  }
  i = 0
  while i < 19 {
    cl_freqs[i] = 0
    i = i + 1
  }
  let mut out_cnt = 0
  i = 0
  while i < total {
    let v = all[i]
    let mut run = 1
    while i + run < total && all[i + run] == v {
      run = run + 1
    }
    if v == 0 {
      let mut rem = run
      while rem >= 11 {
        let take = if rem > 138 { 138 } else { rem }
        rle_syms[out_cnt] = 18
        rle_extra[out_cnt] = take - 11
        out_cnt = out_cnt + 1
        cl_freqs[18] = cl_freqs[18] + 1
        rem = rem - take
      }
      if rem >= 3 {
        rle_syms[out_cnt] = 17
        rle_extra[out_cnt] = rem - 3
        out_cnt = out_cnt + 1
        cl_freqs[17] = cl_freqs[17] + 1
        rem = 0
      }
      while rem > 0 {
        rle_syms[out_cnt] = 0
        rle_extra[out_cnt] = 0
        out_cnt = out_cnt + 1
        cl_freqs[0] = cl_freqs[0] + 1
        rem = rem - 1
      }
    } else {
      rle_syms[out_cnt] = v
      rle_extra[out_cnt] = 0
      out_cnt = out_cnt + 1
      cl_freqs[v] = cl_freqs[v] + 1
      let mut rem = run - 1
      while rem >= 3 {
        let take = if rem > 6 { 6 } else { rem }
        rle_syms[out_cnt] = 16
        rle_extra[out_cnt] = take - 3
        out_cnt = out_cnt + 1
        cl_freqs[16] = cl_freqs[16] + 1
        rem = rem - take
      }
      while rem > 0 {
        rle_syms[out_cnt] = v
        rle_extra[out_cnt] = 0
        out_cnt = out_cnt + 1
        cl_freqs[v] = cl_freqs[v] + 1
        rem = rem - 1
      }
    }
    i = i + run
  }
  out_cnt
}

///| Flush buffered LZ77 tokens choosing the smallest of Stored, Fixed, or Dynamic Huffman.
fn flush_lz77_block(
  bw : BitWriter,
  data : Bytes,
  block_start : Int,
  block_raw_len : Int,
  tok_lit_len : FixedArray[Int],
  tok_dist : FixedArray[Int],
  tok_cnt : Int,
  lit_freqs : FixedArray[Int],
  dist_freqs : FixedArray[Int],
  is_final : Bool,
) -> Unit {
  // Always include EOB symbol 256
  lit_freqs[256] = 1

  // 1. Compute Stored bit cost (including byte alignment + 32-bit header per 65535B chunk)
  let num_stored = if block_raw_len == 0 {
    1
  } else {
    (block_raw_len + 65534) / 65535
  }
  let align_pad = (8 - ((bw.bitcnt + 3) & 7)) & 7
  let stored_bits = align_pad + num_stored * 35 + block_raw_len * 8

  // 2. Compute Fixed Huffman bit cost
  let mut fixed_bits = 3
  let mut i = 0
  while i < 286 {
    let f = lit_freqs[i]
    if f > 0 {
      let extra = if i >= 257 { len_extra[i - 257] } else { 0 }
      fixed_bits = fixed_bits + f * (fixed_litlen_lengths[i] + extra)
    }
    i = i + 1
  }
  i = 0
  while i < 30 {
    let f = dist_freqs[i]
    if f > 0 {
      fixed_bits = fixed_bits + f * (5 + dist_extra[i])
    }
    i = i + 1
  }

  // 3. Build Dynamic Huffman lengths & compute Dynamic bit cost
  let dyn_lit_lens : FixedArray[Int] = FixedArray::make(286, 0)
  let dyn_dist_lens : FixedArray[Int] = FixedArray::make(30, 0)
  build_limited_huffman_lengths(lit_freqs, 286, 15, dyn_lit_lens)
  build_limited_huffman_lengths(dist_freqs, 30, 15, dyn_dist_lens)

  // Ensure at least 1 distance code has length 1 so all decoders accept HDIST >= 1
  let mut has_dist = false
  i = 0
  while i < 30 {
    if dyn_dist_lens[i] > 0 {
      has_dist = true
      break
    }
    i = i + 1
  }
  if !has_dist {
    dyn_dist_lens[0] = 1
  }

  let mut hlit = 286
  while hlit > 257 && dyn_lit_lens[hlit - 1] == 0 {
    hlit = hlit - 1
  }
  let mut hdist = 30
  while hdist > 1 && dyn_dist_lens[hdist - 1] == 0 {
    hdist = hdist - 1
  }

  let rle_syms : FixedArray[Int] = FixedArray::make(320, 0)
  let rle_extra : FixedArray[Int] = FixedArray::make(320, 0)
  let cl_freqs : FixedArray[Int] = FixedArray::make(19, 0)
  let rle_cnt = rle_encode_lengths(
    dyn_lit_lens, hlit, dyn_dist_lens, hdist, rle_syms, rle_extra, cl_freqs,
  )
  let cl_lens : FixedArray[Int] = FixedArray::make(19, 0)
  build_limited_huffman_lengths(cl_freqs, 19, 7, cl_lens)

  let mut hclen = 19
  while hclen > 4 && cl_lens[cl_order[hclen - 1]] == 0 {
    hclen = hclen - 1
  }

  let mut dyn_bits = 3 + 5 + 5 + 4 + hclen * 3
  i = 0
  while i < rle_cnt {
    let s = rle_syms[i]
    let ex = if s == 16 { 2 } else if s == 17 { 3 } else if s == 18 { 7 } else { 0 }
    dyn_bits = dyn_bits + cl_lens[s] + ex
    i = i + 1
  }
  i = 0
  while i < 286 {
    let f = lit_freqs[i]
    if f > 0 {
      let extra = if i >= 257 { len_extra[i - 257] } else { 0 }
      dyn_bits = dyn_bits + f * (dyn_lit_lens[i] + extra)
    }
    i = i + 1
  }
  i = 0
  while i < 30 {
    let f = dist_freqs[i]
    if f > 0 {
      dyn_bits = dyn_bits + f * (dyn_dist_lens[i] + dist_extra[i])
    }
    i = i + 1
  }

  // Pick minimum-cost block representation
  if stored_bits <= fixed_bits && stored_bits <= dyn_bits {
    emit_stored_blocks(bw, data, block_start, block_raw_len, is_final)
    return
  }

  let use_dyn = dyn_bits < fixed_bits
  let mut lit_codes = fixed_litlen_codes
  let mut lit_lens_out = fixed_litlen_lengths
  let mut dist_codes = fixed_dist_codes
  let mut dist_lens_out = fixed_dist_lengths

  if use_dyn {
    // Header: BFINAL + BTYPE=10 (2)
    bw_write_bits(bw, (if is_final { 1 } else { 0 }) | 4, 3)
    bw_write_bits(bw, hlit - 257, 5)
    bw_write_bits(bw, hdist - 1, 5)
    bw_write_bits(bw, hclen - 4, 4)
    i = 0
    while i < hclen {
      bw_write_bits(bw, cl_lens[cl_order[i]], 3)
      i = i + 1
    }
    let cl_codes : FixedArray[Int] = FixedArray::make(19, 0)
    build_canonical_codes(cl_lens, 19, cl_codes)
    i = 0
    while i < rle_cnt {
      let s = rle_syms[i]
      bw_write_bits(bw, cl_codes[s], cl_lens[s])
      if s == 16 {
        bw_write_bits(bw, rle_extra[i], 2)
      } else if s == 17 {
        bw_write_bits(bw, rle_extra[i], 3)
      } else if s == 18 {
        bw_write_bits(bw, rle_extra[i], 7)
      }
      i = i + 1
    }
    let dc_lit : FixedArray[Int] = FixedArray::make(286, 0)
    let dc_dist : FixedArray[Int] = FixedArray::make(30, 0)
    build_canonical_codes(dyn_lit_lens, 286, dc_lit)
    build_canonical_codes(dyn_dist_lens, 30, dc_dist)
    lit_codes = dc_lit
    lit_lens_out = dyn_lit_lens
    dist_codes = dc_dist
    dist_lens_out = dyn_dist_lens
  } else {
    // Header: BFINAL + BTYPE=01 (1)
    bw_write_bits(bw, (if is_final { 1 } else { 0 }) | 2, 3)
  }

  // Emit LZ77 tokens
  let ltc = len_to_code
  let lb = len_base
  let le = len_extra
  let db = dist_base
  let de = dist_extra
  i = 0
  while i < tok_cnt {
    let d = tok_dist[i]
    let ll = tok_lit_len[i]
    if d == 0 {
      bw_write_bits(bw, lit_codes[ll], lit_lens_out[ll])
    } else {
      let lcode = ltc[ll]
      let lsym = 257 + lcode
      bw_write_bits(bw, lit_codes[lsym], lit_lens_out[lsym])
      let lex = le[lcode]
      if lex > 0 {
        bw_write_bits(bw, ll - lb[lcode], lex)
      }
      let dcode = dist_to_code(d)
      bw_write_bits(bw, dist_codes[dcode], dist_lens_out[dcode])
      let dex = de[dcode]
      if dex > 0 {
        bw_write_bits(bw, d - db[dcode], dex)
      }
    }
    i = i + 1
  }
  // Emit EOB (symbol 256)
  bw_write_bits(bw, lit_codes[256], lit_lens_out[256])
}

///| 15-bit multiplicative 3-byte hash.
fn lz77_hash3(data : Bytes, pos : Int) -> Int {
  let v = (data[pos].to_int() << 16) |
  (data[pos + 1].to_int() << 8) |
  data[pos + 2].to_int()
  ((v * 506832829) >> 17) & 32767
}

///| Find best LZ77 match at `pos` walking up to `max_chain` hash-chain entries.
///| Returns `(best_len, best_dist)`.
fn lz77_find_match(
  data : Bytes,
  pos : Int,
  n : Int,
  start_cand : Int,
  prev : FixedArray[Int],
  max_chain : Int,
  nice_len : Int,
  prev_best_len : Int,
) -> (Int, Int) {
  let max_len = if n - pos < 258 { n - pos } else { 258 }
  if max_len < 3 {
    return (0, 0)
  }
  let min_pos = if pos > 32768 { pos - 32768 } else { 0 }
  let mut best_len = prev_best_len
  let mut best_dist = 0
  let b0 = data[pos]
  let b1 = data[pos + 1]
  let b2 = data[pos + 2]
  let mut cand = start_cand
  let mut steps = max_chain
  while cand >= min_pos && steps > 0 {
    // Quick check at best_len end byte before scanning from start
    if best_len < max_len &&
    data[cand + best_len] == data[pos + best_len] &&
    data[cand] == b0 &&
    data[cand + 1] == b1 &&
    data[cand + 2] == b2 {
      let mut mlen = 3
      while mlen + 4 <= max_len &&
      data[cand + mlen] == data[pos + mlen] &&
      data[cand + mlen + 1] == data[pos + mlen + 1] &&
      data[cand + mlen + 2] == data[pos + mlen + 2] &&
      data[cand + mlen + 3] == data[pos + mlen + 3] {
        mlen = mlen + 4
      }
      while mlen < max_len && data[cand + mlen] == data[pos + mlen] {
        mlen = mlen + 1
      }
      if mlen > best_len {
        best_len = mlen
        best_dist = pos - cand
        if best_len >= nice_len || best_len == max_len {
          break
        }
      }
    }
    let next_cand = prev[cand & 32767]
    if next_cand >= cand {
      break
    }
    cand = next_cand
    steps = steps - 1
  }
  (best_len, best_dist)
}

///| Compress `data` into a raw RFC 1951 DEFLATE stream at `level` (0..9).
pub fn deflate_compress(data : Bytes, level : Int) -> Result[Bytes, FlateError] {
  if level < 0 || level > 9 {
    return Err(FlateError::InvalidLevel(level))
  }
  let n = data.length()
  if level == 0 {
    let bw = BitWriter::new(n + 16)
    emit_stored_blocks(bw, data, 0, n, true)
    bw_align_byte(bw)
    return Ok(bw.buf.slice(0, bw.len))
  }
  if n == 0 {
    let mut empty = Bytes::new(2)
    empty[0] = (3).to_byte()
    empty[1] = (0).to_byte()
    return Ok(empty)
  }

  // Compression level parameters
  let max_chain = if level == 1 {
    4
  } else if level == 2 {
    8
  } else if level == 3 {
    16
  } else if level == 4 {
    16
  } else if level == 5 {
    32
  } else if level == 6 {
    64
  } else if level == 7 {
    128
  } else if level == 8 {
    256
  } else {
    1024
  }
  let nice_len = if level == 1 {
    8
  } else if level == 2 {
    16
  } else if level <= 4 {
    32
  } else if level == 5 {
    64
  } else if level <= 7 {
    128
  } else {
    258
  }
  let use_lazy = level >= 4

  let bw = BitWriter::new(if n / 2 + 64 < 256 { 256 } else { n / 2 + 64 })
  let head : FixedArray[Int] = FixedArray::make(32768, -1)
  let prev : FixedArray[Int] = FixedArray::make(32768, -1)

  let max_tokens = 32768
  let tok_lit_len : FixedArray[Int] = FixedArray::make(max_tokens, 0)
  let tok_dist : FixedArray[Int] = FixedArray::make(max_tokens, 0)
  let lit_freqs : FixedArray[Int] = FixedArray::make(286, 0)
  let dist_freqs : FixedArray[Int] = FixedArray::make(30, 0)
  let ltc = len_to_code

  let mut tok_cnt = 0
  let mut block_start = 0
  let mut pos = 0

  while pos < n {
    let mut match_len = 0
    let mut match_dist = 0

    if pos + 2 < n {
      let h = lz77_hash3(data, pos)
      let cand = head[h]
      prev[pos & 32767] = cand
      head[h] = pos
      if cand >= 0 {
        let (ml, md) = lz77_find_match(
          data, pos, n, cand, prev, max_chain, nice_len, 2,
        )
        match_len = ml
        match_dist = md
      }
    }

    // Lazy matching (levels 4..9): check if pos+1 has a strictly better match
    if use_lazy && match_len >= 3 && match_len < nice_len && pos + 3 < n {
      let h2 = lz77_hash3(data, pos + 1)
      let cand2 = head[h2]
      if cand2 >= 0 {
        let (ml2, _) = lz77_find_match(
          data,
          pos + 1,
          n,
          cand2,
          prev,
          max_chain >> 1,
          nice_len,
          match_len,
        )
        if ml2 > match_len {
          // Emit current byte as literal and advance to pos+1
          let b = data[pos].to_int()
          tok_lit_len[tok_cnt] = b
          tok_dist[tok_cnt] = 0
          tok_cnt = tok_cnt + 1
          lit_freqs[b] = lit_freqs[b] + 1
          pos = pos + 1
          if tok_cnt == max_tokens {
            flush_lz77_block(
              bw,
              data,
              block_start,
              pos - block_start,
              tok_lit_len,
              tok_dist,
              tok_cnt,
              lit_freqs,
              dist_freqs,
              pos == n,
            )
            tok_cnt = 0
            block_start = pos
            let mut z = 0
            while z < 286 {
              lit_freqs[z] = 0
              z = z + 1
            }
            z = 0
            while z < 30 {
              dist_freqs[z] = 0
              z = z + 1
            }
          }
          continue
        }
      }
    }

    if match_len >= 3 {
      tok_lit_len[tok_cnt] = match_len
      tok_dist[tok_cnt] = match_dist
      tok_cnt = tok_cnt + 1
      let lsym = 257 + ltc[match_len]
      lit_freqs[lsym] = lit_freqs[lsym] + 1
      let dcode = dist_to_code(match_dist)
      dist_freqs[dcode] = dist_freqs[dcode] + 1

      // Insert intermediate positions into hash chains (skip for level 1 long matches)
      let max_ins = if level == 1 && match_len > 4 { 4 } else { match_len }
      let mut step = 1
      while step < max_ins && pos + step + 2 < n {
        let hp = lz77_hash3(data, pos + step)
        prev[(pos + step) & 32767] = head[hp]
        head[hp] = pos + step
        step = step + 1
      }
      pos = pos + match_len
    } else {
      let b = data[pos].to_int()
      tok_lit_len[tok_cnt] = b
      tok_dist[tok_cnt] = 0
      tok_cnt = tok_cnt + 1
      lit_freqs[b] = lit_freqs[b] + 1
      pos = pos + 1
    }

    if tok_cnt == max_tokens {
      flush_lz77_block(
        bw,
        data,
        block_start,
        pos - block_start,
        tok_lit_len,
        tok_dist,
        tok_cnt,
        lit_freqs,
        dist_freqs,
        pos == n,
      )
      tok_cnt = 0
      block_start = pos
      let mut z = 0
      while z < 286 {
        lit_freqs[z] = 0
        z = z + 1
      }
      z = 0
      while z < 30 {
        dist_freqs[z] = 0
        z = z + 1
      }
    }
  }

  if tok_cnt > 0 || bw.len == 0 {
    flush_lz77_block(
      bw,
      data,
      block_start,
      pos - block_start,
      tok_lit_len,
      tok_dist,
      tok_cnt,
      lit_freqs,
      dist_freqs,
      true,
    )
  }

  bw_align_byte(bw)
  Ok(bw.buf.slice(0, bw.len))
}

///| Compress `data` into a raw RFC 1951 DEFLATE stream at default level 6.
pub fn deflate_compress_default(data : Bytes) -> Bytes {
  match deflate_compress(data, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}
