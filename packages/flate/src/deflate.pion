///| High-performance RFC 1951 raw DEFLATE compressor.
///| Features a 32 KiB sliding window with 15-bit hash-chain LZ77 (levels 0..9:
///| stored, fast/greedy with adaptive miss-skipping, and lazy matching with zlib-style
///| `good_length`/`max_lazy`/`nice_length` early exit), incompressible-block Stored fast path,
///| zero-COW `FixedArray[Byte]` `BitWriter` with hoisted token emission,
///| Package-Merge length-limited (<= 15 bit) Canonical Huffman coding, and per-block
///| minimum-cost selection among Stored, Fixed, and Dynamic.

///| 64-bit LSB-first bit writer backed by a zero-COW `FixedArray[Byte]` staging buffer.
struct BitWriter {
  mut buf : FixedArray[Byte]
  mut cap : Int
  mut len : Int
  mut bitbuf : UInt64
  mut bitcnt : Int
  chunks : Array[Bytes]
}

///|
fn BitWriter::new(init_cap : Int) -> BitWriter {
  let c = if init_cap < 512 { 512 } else if init_cap > 65536 { 65536 } else { init_cap }
  BitWriter::{
    buf: FixedArray::make(c, (0).to_byte()),
    cap: c,
    len: 0,
    bitbuf: 0UL,
    bitcnt: 0,
    chunks: [],
  }
}

///| Reset a reusable `BitWriter`, growing its staging buffer up to `min(max(init_cap, 512), 65536)` if needed.
fn bw_reset(bw : BitWriter, init_cap : Int) -> Unit {
  let target = if init_cap < 512 { 512 } else if init_cap > 65536 { 65536 } else { init_cap }
  if bw.cap < target {
    bw.buf = FixedArray::make(target, (0).to_byte())
    bw.cap = target
  }
  bw.len = 0
  bw.bitbuf = 0UL
  bw.bitcnt = 0
  bw.chunks.clear()
}

///| Reusable compression scratch context for repeated raw DEFLATE, zlib, and gzip calls.
///| Lazily allocates and reuses LZ77 hash tables, token buffers, bit-writer staging buffer,
///| and dynamic Huffman / Package-Merge scratch arrays across calls and blocks.
pub struct DeflateContext {
  bw : BitWriter
  mut l1_ready : Bool
  mut full_ready : Bool
  mut huff_ready : Bool
  mut head_l1 : FixedArray[Int]
  mut l1_bias : Int
  mut head : FixedArray[Int]
  mut prev : FixedArray[Int]
  mut probe_table : FixedArray[Int]
  mut probe_bias : Int
  mut probe_hist : FixedArray[Int]
  mut tok_lit_len : FixedArray[Int]
  mut tok_dist : FixedArray[Int]
  mut lit_freqs : FixedArray[Int]
  mut dist_freqs : FixedArray[Int]
  // Dynamic Huffman + Package-Merge per-block scratch
  mut dyn_lit_lens : FixedArray[Int]
  mut dyn_dist_lens : FixedArray[Int]
  mut rle_all : FixedArray[Int]
  mut rle_syms : FixedArray[Int]
  mut rle_extra : FixedArray[Int]
  mut cl_freqs : FixedArray[Int]
  mut cl_lens : FixedArray[Int]
  mut cl_codes : FixedArray[Int]
  mut dc_lit : FixedArray[Int]
  mut dc_dist : FixedArray[Int]
  mut lit_packed : FixedArray[Int]
  mut dist_packed : FixedArray[Int]
  mut bl_count : FixedArray[Int]
  mut next_code : FixedArray[Int]
  mut pm_syms : FixedArray[Int]
  mut pm_weights : FixedArray[Int64]
  mut pm_node_left : FixedArray[Int]
  mut pm_node_right : FixedArray[Int]
  mut pm_node_sym : FixedArray[Int]
  mut pm_cur_ids : FixedArray[Int]
  mut pm_cur_w : FixedArray[Int64]
  mut pm_next_ids : FixedArray[Int]
  mut pm_next_w : FixedArray[Int64]
  mut pm_stack : FixedArray[Int]
}

///| Create a new reusable compression context (internal tables are allocated lazily on first use).
pub fn DeflateContext::new() -> DeflateContext {
  let empty_i : FixedArray[Int] = FixedArray::make(0, 0)
  let empty_i64 : FixedArray[Int64] = FixedArray::make(0, 0L)
  let empty_b : FixedArray[Byte] = FixedArray::make(0, (0).to_byte())
  DeflateContext::{
    bw: BitWriter::{
      buf: empty_b,
      cap: 0,
      len: 0,
      bitbuf: 0UL,
      bitcnt: 0,
      chunks: [],
    },
    l1_ready: false,
    full_ready: false,
    huff_ready: false,
    head_l1: empty_i,
    l1_bias: 0,
    head: empty_i,
    prev: empty_i,
    probe_table: empty_i,
    probe_bias: 0,
    probe_hist: empty_i,
    tok_lit_len: empty_i,
    tok_dist: empty_i,
    lit_freqs: empty_i,
    dist_freqs: empty_i,
    dyn_lit_lens: empty_i,
    dyn_dist_lens: empty_i,
    rle_all: empty_i,
    rle_syms: empty_i,
    rle_extra: empty_i,
    cl_freqs: empty_i,
    cl_lens: empty_i,
    cl_codes: empty_i,
    dc_lit: empty_i,
    dc_dist: empty_i,
    lit_packed: empty_i,
    dist_packed: empty_i,
    bl_count: empty_i,
    next_code: empty_i,
    pm_syms: empty_i,
    pm_weights: empty_i64,
    pm_node_left: empty_i,
    pm_node_right: empty_i,
    pm_node_sym: empty_i,
    pm_cur_ids: empty_i,
    pm_cur_w: empty_i64,
    pm_next_ids: empty_i,
    pm_next_w: empty_i64,
    pm_stack: empty_i,
  }
}

///|
fn ensure_deflate_common(ctx : DeflateContext) -> Unit {
  if ctx.tok_lit_len.length() == 0 {
    ctx.probe_table = FixedArray::make(4096, -1)
    ctx.probe_bias = 0
    ctx.probe_hist = FixedArray::make(256, 0)
    ctx.tok_lit_len = FixedArray::make(32768, 0)
    ctx.tok_dist = FixedArray::make(32768, 0)
    ctx.lit_freqs = FixedArray::make(286, 0)
    ctx.dist_freqs = FixedArray::make(30, 0)
  }
}

///|
fn ensure_deflate_l1(ctx : DeflateContext) -> Unit {
  ensure_deflate_common(ctx)
  if !ctx.l1_ready {
    ctx.head_l1 = FixedArray::make(16384, -1)
    ctx.l1_bias = 0
    ctx.l1_ready = true
  }
}

///|
fn ensure_deflate_full(ctx : DeflateContext) -> Unit {
  ensure_deflate_common(ctx)
  if !ctx.full_ready {
    ctx.head = FixedArray::make(32768, -1)
    ctx.prev = FixedArray::make(32768, -1)
    ctx.full_ready = true
  }
}

///|
fn ensure_deflate_huff(ctx : DeflateContext) -> Unit {
  if !ctx.huff_ready {
    ctx.dyn_lit_lens = FixedArray::make(286, 0)
    ctx.dyn_dist_lens = FixedArray::make(30, 0)
    ctx.rle_all = FixedArray::make(320, 0)
    ctx.rle_syms = FixedArray::make(320, 0)
    ctx.rle_extra = FixedArray::make(320, 0)
    ctx.cl_freqs = FixedArray::make(19, 0)
    ctx.cl_lens = FixedArray::make(19, 0)
    ctx.cl_codes = FixedArray::make(19, 0)
    ctx.dc_lit = FixedArray::make(286, 0)
    ctx.dc_dist = FixedArray::make(30, 0)
    ctx.lit_packed = FixedArray::make(286, 0)
    ctx.dist_packed = FixedArray::make(30, 0)
    ctx.bl_count = FixedArray::make(16, 0)
    ctx.next_code = FixedArray::make(16, 0)
    ctx.pm_syms = FixedArray::make(288, 0)
    ctx.pm_weights = FixedArray::make(288, 0L)
    ctx.pm_node_left = FixedArray::make(9160, -1)
    ctx.pm_node_right = FixedArray::make(9160, -1)
    ctx.pm_node_sym = FixedArray::make(9160, -1)
    ctx.pm_cur_ids = FixedArray::make(576, 0)
    ctx.pm_cur_w = FixedArray::make(576, 0L)
    ctx.pm_next_ids = FixedArray::make(576, 0)
    ctx.pm_next_w = FixedArray::make(576, 0L)
    ctx.pm_stack = FixedArray::make(9160, 0)
    ctx.huff_ready = true
  }
}

///| Fast 8-way unrolled fill of `arr[0..len]` with `v`.
fn fill_fixed_i(arr : FixedArray[Int], len : Int, v : Int) -> Unit {
  let mut i = 0
  let lim8 = len - 8
  while i <= lim8 {
    arr[i] = v
    arr[i + 1] = v
    arr[i + 2] = v
    arr[i + 3] = v
    arr[i + 4] = v
    arr[i + 5] = v
    arr[i + 6] = v
    arr[i + 7] = v
    i = i + 8
  }
  while i < len {
    arr[i] = v
    i = i + 1
  }
}

///| Materialize `bw.buf[0..bw.len]` into `bw.chunks` and reset `bw.len = 0`.
fn bw_flush_chunk(bw : BitWriter) -> Unit {
  let n = bw.len
  if n == 0 {
    return
  }
  let src = bw.buf
  let mut out = Bytes::new(n)
  let mut i = 0
  let lim8 = n - 8
  while i <= lim8 {
    out[i] = src[i]
    out[i + 1] = src[i + 1]
    out[i + 2] = src[i + 2]
    out[i + 3] = src[i + 3]
    out[i + 4] = src[i + 4]
    out[i + 5] = src[i + 5]
    out[i + 6] = src[i + 6]
    out[i + 7] = src[i + 7]
    i = i + 8
  }
  while i < n {
    out[i] = src[i]
    i = i + 1
  }
  bw.chunks.push(out)
  bw.len = 0
}

///|
fn bw_ensure(bw : BitWriter, extra : Int) -> Unit {
  if bw.len + extra > bw.cap {
    bw_flush_chunk(bw)
  }
}

///|
fn bw_write_bits(bw : BitWriter, bits : Int, nbits : Int) -> Unit {
  bw.bitbuf = bw.bitbuf | (bits.to_int64().to_uint64() << bw.bitcnt)
  bw.bitcnt = bw.bitcnt + nbits
  if bw.bitcnt >= 32 {
    if bw.len + 4 > bw.cap {
      bw_flush_chunk(bw)
    }
    let w = bw.bitbuf
    let buf = bw.buf
    let p = bw.len
    buf[p] = (w & 0xFFUL).to_int().to_byte()
    buf[p + 1] = ((w >> 8) & 0xFFUL).to_int().to_byte()
    buf[p + 2] = ((w >> 16) & 0xFFUL).to_int().to_byte()
    buf[p + 3] = ((w >> 24) & 0xFFUL).to_int().to_byte()
    bw.len = p + 4
    bw.bitbuf = bw.bitbuf >> 32
    bw.bitcnt = bw.bitcnt - 32
  }
}

///| Flush remaining bits, zero-padding to next byte boundary.
fn bw_align_byte(bw : BitWriter) -> Unit {
  if bw.bitcnt > 0 {
    let bytes_out = (bw.bitcnt + 7) >> 3
    bw_ensure(bw, bytes_out)
    let buf = bw.buf
    let mut p = bw.len
    let mut bb = bw.bitbuf
    let mut k = 0
    while k < bytes_out {
      buf[p] = (bb & 0xFFUL).to_int().to_byte()
      p = p + 1
      bb = bb >> 8
      k = k + 1
    }
    bw.len = p
    bw.bitbuf = 0UL
    bw.bitcnt = 0
  }
}

///| Write raw bytes directly (caller must call `bw_align_byte` first).
fn bw_write_raw(bw : BitWriter, data : Bytes, start : Int, count : Int) -> Unit {
  if count >= 256 || bw.len + count > bw.cap {
    bw_flush_chunk(bw)
    bw.chunks.push(data.slice(start, start + count))
    return
  }
  let buf = bw.buf
  let dst = bw.len
  let mut k = 0
  while k < count {
    buf[dst + k] = data[start + k]
    k = k + 1
  }
  bw.len = dst + count
}

///| Finalize `BitWriter` into a contiguous `Bytes` buffer and release chunk references.
fn bw_finish(bw : BitWriter) -> Bytes {
  bw_align_byte(bw)
  bw_flush_chunk(bw)
  let out = concat_bytes_chunks(bw.chunks)
  bw.chunks.clear()
  out
}

///| Emit stored block(s) for `data[start..start+count]`.
fn emit_stored_blocks(
  bw : BitWriter,
  data : Bytes,
  start : Int,
  count : Int,
  is_final : Bool,
) -> Unit {
  if count == 0 {
    bw_write_bits(bw, if is_final { 1 } else { 0 }, 3)
    bw_align_byte(bw)
    bw_ensure(bw, 4)
    let buf = bw.buf
    let p = bw.len
    buf[p] = (0).to_byte()
    buf[p + 1] = (0).to_byte()
    buf[p + 2] = (255).to_byte()
    buf[p + 3] = (255).to_byte()
    bw.len = p + 4
    return
  }
  let mut pos = start
  let end = start + count
  while pos < end {
    let rem = end - pos
    let chunk = if rem > 65535 { 65535 } else { rem }
    let chunk_final = is_final && (pos + chunk == end)
    bw_write_bits(bw, if chunk_final { 1 } else { 0 }, 3)
    bw_align_byte(bw)
    bw_ensure(bw, 4)
    let nlen = chunk ^ 0xFFFF
    let buf = bw.buf
    let p = bw.len
    buf[p] = (chunk & 0xFF).to_byte()
    buf[p + 1] = ((chunk >> 8) & 0xFF).to_byte()
    buf[p + 2] = (nlen & 0xFF).to_byte()
    buf[p + 3] = ((nlen >> 8) & 0xFF).to_byte()
    bw.len = p + 4
    bw_write_raw(bw, data, pos, chunk)
    pos = pos + chunk
  }
}

///| RLE-encode `hlit + hdist` code lengths into `(rle_syms, rle_extra, rle_cnt)` and populate `cl_freqs`.
fn rle_encode_lengths(
  lit_lens : FixedArray[Int],
  hlit : Int,
  dist_lens : FixedArray[Int],
  hdist : Int,
  all : FixedArray[Int],
  rle_syms : FixedArray[Int],
  rle_extra : FixedArray[Int],
  cl_freqs : FixedArray[Int],
) -> Int {
  let total = hlit + hdist
  let mut i = 0
  while i < hlit {
    all[i] = lit_lens[i]
    i = i + 1
  }
  i = 0
  while i < hdist {
    all[hlit + i] = dist_lens[i]
    i = i + 1
  }
  i = 0
  while i < 19 {
    cl_freqs[i] = 0
    i = i + 1
  }
  let mut out_cnt = 0
  i = 0
  while i < total {
    let v = all[i]
    let mut run = 1
    while i + run < total && all[i + run] == v {
      run = run + 1
    }
    if v == 0 {
      let mut rem = run
      while rem >= 11 {
        let take = if rem > 138 { 138 } else { rem }
        rle_syms[out_cnt] = 18
        rle_extra[out_cnt] = take - 11
        out_cnt = out_cnt + 1
        cl_freqs[18] = cl_freqs[18] + 1
        rem = rem - take
      }
      if rem >= 3 {
        rle_syms[out_cnt] = 17
        rle_extra[out_cnt] = rem - 3
        out_cnt = out_cnt + 1
        cl_freqs[17] = cl_freqs[17] + 1
        rem = 0
      }
      while rem > 0 {
        rle_syms[out_cnt] = 0
        rle_extra[out_cnt] = 0
        out_cnt = out_cnt + 1
        cl_freqs[0] = cl_freqs[0] + 1
        rem = rem - 1
      }
    } else {
      rle_syms[out_cnt] = v
      rle_extra[out_cnt] = 0
      out_cnt = out_cnt + 1
      cl_freqs[v] = cl_freqs[v] + 1
      let mut rem = run - 1
      while rem >= 3 {
        let take = if rem > 6 { 6 } else { rem }
        rle_syms[out_cnt] = 16
        rle_extra[out_cnt] = take - 3
        out_cnt = out_cnt + 1
        cl_freqs[16] = cl_freqs[16] + 1
        rem = rem - take
      }
      while rem > 0 {
        rle_syms[out_cnt] = v
        rle_extra[out_cnt] = 0
        out_cnt = out_cnt + 1
        cl_freqs[v] = cl_freqs[v] + 1
        rem = rem - 1
      }
    }
    i = i + run
  }
  out_cnt
}

///| Hot token bit-emission loop with packed Huffman tables `(code << 5) | nbits`
///| and packed length/distance tables to keep live arrays minimal and avoid register spills.
fn emit_lz77_tokens(
  bw : BitWriter,
  tok_lit_len : FixedArray[Int],
  tok_dist : FixedArray[Int],
  tok_cnt : Int,
  lit_packed : FixedArray[Int],
  dist_packed : FixedArray[Int],
) -> Unit {
  let lp = len_pack
  let dp = dist_pack
  let d_small = dist_to_code_small
  let d_hi = dist_to_code_hi
  let buf = bw.buf
  let flush_lim = bw.cap - 16
  let mut p = bw.len
  let mut bitbuf = bw.bitbuf
  let mut bitcnt = bw.bitcnt

  let mut i = 0
  while i < tok_cnt {
    let d = tok_dist[i]
    let ll = tok_lit_len[i]
    if d == 0 {
      let pk = lit_packed[ll]
      bitbuf = bitbuf | ((pk >> 5).to_int64().to_uint64() << bitcnt)
      bitcnt = bitcnt + (pk & 31)
      if bitcnt >= 32 {
        buf[p] = (bitbuf & 0xFFUL).to_int().to_byte()
        buf[p + 1] = ((bitbuf >> 8) & 0xFFUL).to_int().to_byte()
        buf[p + 2] = ((bitbuf >> 16) & 0xFFUL).to_int().to_byte()
        buf[p + 3] = ((bitbuf >> 24) & 0xFFUL).to_int().to_byte()
        p = p + 4
        bitbuf = bitbuf >> 32
        bitcnt = bitcnt - 32
        if p >= flush_lim {
          bw.len = p
          bw_flush_chunk(bw)
          p = 0
        }
      }
    } else {
      let li = lp[ll]
      let lpk = lit_packed[li >> 13]
      bitbuf = bitbuf | ((lpk >> 5).to_int64().to_uint64() << bitcnt)
      bitcnt = bitcnt + (lpk & 31)
      let lex = (li >> 9) & 15
      if lex > 0 {
        bitbuf = bitbuf | ((ll - (li & 511)).to_int64().to_uint64() << bitcnt)
        bitcnt = bitcnt + lex
      }
      if bitcnt >= 32 {
        buf[p] = (bitbuf & 0xFFUL).to_int().to_byte()
        buf[p + 1] = ((bitbuf >> 8) & 0xFFUL).to_int().to_byte()
        buf[p + 2] = ((bitbuf >> 16) & 0xFFUL).to_int().to_byte()
        buf[p + 3] = ((bitbuf >> 24) & 0xFFUL).to_int().to_byte()
        p = p + 4
        bitbuf = bitbuf >> 32
        bitcnt = bitcnt - 32
      }
      let dcode = if d <= 512 { d_small[d] } else { d_hi[(d - 1) >> 7] }
      let dpk = dist_packed[dcode]
      bitbuf = bitbuf | ((dpk >> 5).to_int64().to_uint64() << bitcnt)
      bitcnt = bitcnt + (dpk & 31)
      let di = dp[dcode]
      let dex = di >> 16
      if dex > 0 {
        bitbuf = bitbuf | ((d - (di & 65535)).to_int64().to_uint64() << bitcnt)
        bitcnt = bitcnt + dex
      }
      if bitcnt >= 32 {
        buf[p] = (bitbuf & 0xFFUL).to_int().to_byte()
        buf[p + 1] = ((bitbuf >> 8) & 0xFFUL).to_int().to_byte()
        buf[p + 2] = ((bitbuf >> 16) & 0xFFUL).to_int().to_byte()
        buf[p + 3] = ((bitbuf >> 24) & 0xFFUL).to_int().to_byte()
        p = p + 4
        bitbuf = bitbuf >> 32
        bitcnt = bitcnt - 32
      }
      if p >= flush_lim {
        bw.len = p
        bw_flush_chunk(bw)
        p = 0
      }
    }
    i = i + 1
  }

  // Emit EOB (symbol 256)
  let epk = lit_packed[256]
  bitbuf = bitbuf | ((epk >> 5).to_int64().to_uint64() << bitcnt)
  bitcnt = bitcnt + (epk & 31)
  if bitcnt >= 32 {
    if p + 4 > bw.cap {
      bw.len = p
      bw_flush_chunk(bw)
      p = 0
    }
    buf[p] = (bitbuf & 0xFFUL).to_int().to_byte()
    buf[p + 1] = ((bitbuf >> 8) & 0xFFUL).to_int().to_byte()
    buf[p + 2] = ((bitbuf >> 16) & 0xFFUL).to_int().to_byte()
    buf[p + 3] = ((bitbuf >> 24) & 0xFFUL).to_int().to_byte()
    p = p + 4
    bitbuf = bitbuf >> 32
    bitcnt = bitcnt - 32
  }
  bw.len = p
  bw.bitbuf = bitbuf
  bw.bitcnt = bitcnt
}

///| Flush buffered LZ77 tokens choosing the smallest of Stored, Fixed, or Dynamic Huffman.
///| Returns `true` if Stored was chosen.
fn flush_lz77_block(
  ctx : DeflateContext,
  bw : BitWriter,
  data : Bytes,
  block_start : Int,
  block_raw_len : Int,
  tok_lit_len : FixedArray[Int],
  tok_dist : FixedArray[Int],
  tok_cnt : Int,
  match_cnt : Int,
  lit_freqs : FixedArray[Int],
  dist_freqs : FixedArray[Int],
  is_final : Bool,
) -> Bool {
  // Fast check: if 0 matches and literal distribution is near-flat across >= 240 symbols,
  // Dynamic Huffman cannot beat Stored; skip Package-Merge entirely.
  if match_cnt == 0 && block_raw_len >= 1024 {
    let mut distinct = 0
    let mut max_f = 0
    let mut k = 0
    while k < 256 {
      let f = lit_freqs[k]
      if f > 0 {
        distinct = distinct + 1
        if f > max_f {
          max_f = f
        }
      }
      k = k + 1
    }
    if distinct >= 240 && max_f * 64 < block_raw_len {
      emit_stored_blocks(bw, data, block_start, block_raw_len, is_final)
      return true
    }
  }

  // Always include EOB symbol 256
  lit_freqs[256] = 1

  let le = len_extra
  let de = dist_extra
  let flit_lens = fixed_litlen_lengths
  let clo = cl_order

  // 1. Compute Stored bit cost (including byte alignment + 32-bit header per 65535B chunk)
  let num_stored = if block_raw_len == 0 {
    1
  } else {
    (block_raw_len + 65534) / 65535
  }
  let align_pad = (8 - ((bw.bitcnt + 3) & 7)) & 7
  let stored_bits = align_pad + num_stored * 35 + block_raw_len * 8

  // 2. Compute Fixed Huffman bit cost
  let mut fixed_bits = 3
  let mut i = 0
  while i < 286 {
    let f = lit_freqs[i]
    if f > 0 {
      let extra = if i >= 257 { le[i - 257] } else { 0 }
      fixed_bits = fixed_bits + f * (flit_lens[i] + extra)
    }
    i = i + 1
  }
  i = 0
  while i < 30 {
    let f = dist_freqs[i]
    if f > 0 {
      fixed_bits = fixed_bits + f * (5 + de[i])
    }
    i = i + 1
  }

  // 3. Build Dynamic Huffman lengths & compute Dynamic bit cost (reusing ctx scratch)
  ensure_deflate_huff(ctx)
  let dyn_lit_lens = ctx.dyn_lit_lens
  let dyn_dist_lens = ctx.dyn_dist_lens
  build_limited_huffman_lengths_scratch(
    lit_freqs, 286, 15, dyn_lit_lens,
    ctx.pm_syms, ctx.pm_weights, ctx.pm_node_left, ctx.pm_node_right, ctx.pm_node_sym,
    ctx.pm_cur_ids, ctx.pm_cur_w, ctx.pm_next_ids, ctx.pm_next_w, ctx.pm_stack,
  )
  build_limited_huffman_lengths_scratch(
    dist_freqs, 30, 15, dyn_dist_lens,
    ctx.pm_syms, ctx.pm_weights, ctx.pm_node_left, ctx.pm_node_right, ctx.pm_node_sym,
    ctx.pm_cur_ids, ctx.pm_cur_w, ctx.pm_next_ids, ctx.pm_next_w, ctx.pm_stack,
  )

  // Ensure at least 1 distance code has length 1 so all decoders accept HDIST >= 1
  let mut has_dist = false
  i = 0
  while i < 30 {
    if dyn_dist_lens[i] > 0 {
      has_dist = true
      break
    }
    i = i + 1
  }
  if !has_dist {
    dyn_dist_lens[0] = 1
  }

  let mut hlit = 286
  while hlit > 257 && dyn_lit_lens[hlit - 1] == 0 {
    hlit = hlit - 1
  }
  let mut hdist = 30
  while hdist > 1 && dyn_dist_lens[hdist - 1] == 0 {
    hdist = hdist - 1
  }

  let rle_syms = ctx.rle_syms
  let rle_extra = ctx.rle_extra
  let cl_freqs = ctx.cl_freqs
  let rle_cnt = rle_encode_lengths(
    dyn_lit_lens, hlit, dyn_dist_lens, hdist, ctx.rle_all, rle_syms, rle_extra, cl_freqs,
  )
  let cl_lens = ctx.cl_lens
  build_limited_huffman_lengths_scratch(
    cl_freqs, 19, 7, cl_lens,
    ctx.pm_syms, ctx.pm_weights, ctx.pm_node_left, ctx.pm_node_right, ctx.pm_node_sym,
    ctx.pm_cur_ids, ctx.pm_cur_w, ctx.pm_next_ids, ctx.pm_next_w, ctx.pm_stack,
  )

  let mut hclen = 19
  while hclen > 4 && cl_lens[clo[hclen - 1]] == 0 {
    hclen = hclen - 1
  }

  let mut dyn_bits = 3 + 5 + 5 + 4 + hclen * 3
  i = 0
  while i < rle_cnt {
    let s = rle_syms[i]
    let ex = if s == 16 { 2 } else if s == 17 { 3 } else if s == 18 { 7 } else { 0 }
    dyn_bits = dyn_bits + cl_lens[s] + ex
    i = i + 1
  }
  i = 0
  while i < 286 {
    let f = lit_freqs[i]
    if f > 0 {
      let extra = if i >= 257 { le[i - 257] } else { 0 }
      dyn_bits = dyn_bits + f * (dyn_lit_lens[i] + extra)
    }
    i = i + 1
  }
  i = 0
  while i < 30 {
    let f = dist_freqs[i]
    if f > 0 {
      dyn_bits = dyn_bits + f * (dyn_dist_lens[i] + de[i])
    }
    i = i + 1
  }

  // Pick minimum-cost block representation
  if stored_bits <= fixed_bits && stored_bits <= dyn_bits {
    emit_stored_blocks(bw, data, block_start, block_raw_len, is_final)
    return true
  }

  let use_dyn = dyn_bits < fixed_bits
  let mut lit_codes = fixed_litlen_codes
  let mut lit_lens_out = flit_lens
  let mut dist_codes = fixed_dist_codes
  let mut dist_lens_out = fixed_dist_lengths

  if use_dyn {
    // Header: BFINAL + BTYPE=10 (2)
    bw_write_bits(bw, (if is_final { 1 } else { 0 }) | 4, 3)
    bw_write_bits(bw, hlit - 257, 5)
    bw_write_bits(bw, hdist - 1, 5)
    bw_write_bits(bw, hclen - 4, 4)
    i = 0
    while i < hclen {
      bw_write_bits(bw, cl_lens[clo[i]], 3)
      i = i + 1
    }
    let cl_codes = ctx.cl_codes
    build_canonical_codes_scratch(cl_lens, 19, cl_codes, ctx.bl_count, ctx.next_code)
    i = 0
    while i < rle_cnt {
      let s = rle_syms[i]
      bw_write_bits(bw, cl_codes[s], cl_lens[s])
      if s == 16 {
        bw_write_bits(bw, rle_extra[i], 2)
      } else if s == 17 {
        bw_write_bits(bw, rle_extra[i], 3)
      } else if s == 18 {
        bw_write_bits(bw, rle_extra[i], 7)
      }
      i = i + 1
    }
    let dc_lit = ctx.dc_lit
    let dc_dist = ctx.dc_dist
    build_canonical_codes_scratch(dyn_lit_lens, 286, dc_lit, ctx.bl_count, ctx.next_code)
    build_canonical_codes_scratch(dyn_dist_lens, 30, dc_dist, ctx.bl_count, ctx.next_code)
    lit_codes = dc_lit
    lit_lens_out = dyn_lit_lens
    dist_codes = dc_dist
    dist_lens_out = dyn_dist_lens
  } else {
    // Header: BFINAL + BTYPE=01 (1)
    bw_write_bits(bw, (if is_final { 1 } else { 0 }) | 2, 3)
  }

  let lit_packed = ctx.lit_packed
  let dist_packed = ctx.dist_packed
  i = 0
  while i < 286 {
    lit_packed[i] = (lit_codes[i] << 5) | lit_lens_out[i]
    i = i + 1
  }
  i = 0
  while i < 30 {
    dist_packed[i] = (dist_codes[i] << 5) | dist_lens_out[i]
    i = i + 1
  }

  emit_lz77_tokens(bw, tok_lit_len, tok_dist, tok_cnt, lit_packed, dist_packed)
  false
}

///| Reset per-block frequency histograms.
fn reset_block_freqs(lit_freqs : FixedArray[Int], dist_freqs : FixedArray[Int]) -> Unit {
  let mut z = 0
  while z < 286 {
    lit_freqs[z] = 0
    z = z + 1
  }
  z = 0
  while z < 30 {
    dist_freqs[z] = 0
    z = z + 1
  }
}

///| 15-bit multiplicative 3-byte hash.
fn lz77_hash3(data : Bytes, pos : Int) -> Int {
  let v = (data[pos].to_int() << 16) |
  (data[pos + 1].to_int() << 8) |
  data[pos + 2].to_int()
  ((v * 506832829) >> 17) & 32767
}

///| Find best LZ77 match at `pos` walking up to `max_chain` hash-chain entries.
///| `cfg` packs `(good_len << 20) | (nice_len << 10) | max_chain` so all 6 args stay in registers.
///| Returns packed `(best_len << 16) | best_dist` (0 if no match > `prev_best_len`).
fn lz77_find_match(
  data : Bytes,
  pos : Int,
  start_cand : Int,
  prev : FixedArray[Int],
  cfg : Int,
  prev_best_len : Int,
) -> Int {
  let n = data.length()
  let max_len = if n - pos < 258 { n - pos } else { 258 }
  if max_len < 3 || prev_best_len >= max_len {
    return 0
  }
  let max_chain = cfg & 1023
  let nice_len = (cfg >> 10) & 1023
  let good_len = cfg >> 20
  let min_pos = if pos > 32768 { pos - 32768 } else { 0 }
  let mut best_len = prev_best_len
  let mut best_dist = 0
  let mut steps = if best_len >= good_len { max_chain >> 2 } else { max_chain }
  if steps <= 0 {
    steps = 1
  }
  let b0 = data[pos]
  let b1 = data[pos + 1]
  let b2 = data[pos + 2]
  let mut end_b = data[pos + best_len]
  let mut end_p = data[pos + best_len - 1]
  let mut cand = start_cand
  while cand >= min_pos && steps > 0 {
    if data[cand + best_len] == end_b &&
    data[cand + best_len - 1] == end_p &&
    data[cand] == b0 &&
    data[cand + 1] == b1 &&
    data[cand + 2] == b2 {
      let mut mlen = 3
      while mlen + 4 <= max_len &&
      data[cand + mlen] == data[pos + mlen] &&
      data[cand + mlen + 1] == data[pos + mlen + 1] &&
      data[cand + mlen + 2] == data[pos + mlen + 2] &&
      data[cand + mlen + 3] == data[pos + mlen + 3] {
        mlen = mlen + 4
      }
      while mlen < max_len && data[cand + mlen] == data[pos + mlen] {
        mlen = mlen + 1
      }
      if mlen > best_len {
        best_len = mlen
        best_dist = pos - cand
        if best_len >= nice_len || best_len == max_len {
          break
        }
        end_b = data[pos + best_len]
        end_p = data[pos + best_len - 1]
        if best_len >= good_len && steps > (max_chain >> 2) {
          steps = max_chain >> 2
        }
      }
    }
    let next_cand = prev[cand & 32767]
    if next_cand >= cand {
      break
    }
    cand = next_cand
    steps = steps - 1
  }
  if best_dist == 0 {
    return 0
  }
  (best_len << 16) | best_dist
}

///| Quick entropy + 3-byte-match probe on `data[start..start+probe_len]` to detect
///| high-entropy incompressible chunks (e.g. encrypted/compressed/random bytes).
fn is_incompressible_probe(
  ctx : DeflateContext,
  data : Bytes,
  start : Int,
  probe_len : Int,
) -> Bool {
  let end = start + probe_len
  let hist = ctx.probe_hist
  fill_fixed_i(hist, 256, 0)
  let mut i = start
  while i < end {
    let b = data[i].to_int()
    hist[b] = hist[b] + 1
    i = i + 1
  }
  let mut distinct = 0
  let mut max_f = 0
  i = 0
  while i < 256 {
    let f = hist[i]
    if f > 0 {
      distinct = distinct + 1
      if f > max_f {
        max_f = f
      }
    }
    i = i + 1
  }
  // Low alphabet cardinality or skewed frequencies (e.g. text, JSON, Fibonacci) are compressible by Huffman
  if distinct < 200 || max_f * 24 >= probe_len {
    return false
  }
  // Quick 1-slot hash match count over probe window using bias-isolated reusable table
  let probe_table = ctx.probe_table
  if ctx.probe_bias > 1000000000 - probe_len {
    fill_fixed_i(probe_table, 4096, -1)
    ctx.probe_bias = 0
  }
  let bias = ctx.probe_bias
  ctx.probe_bias = bias + probe_len + 1
  let mut matches = 0
  i = start
  let lim = end - 3
  while i <= lim {
    let h = lz77_hash3(data, i) & 4095
    let prev_rel = probe_table[h] - bias
    probe_table[h] = (i - start) + bias
    if prev_rel >= 0 {
      let prev_p = start + prev_rel
      if data[prev_p] == data[i] &&
      data[prev_p + 1] == data[i + 1] &&
      data[prev_p + 2] == data[i + 2] {
        matches = matches + 1
        i = i + 3
        continue
      }
    }
    i = i + 1
  }
  // Random data has ~0.01% 3-byte collisions in a 1-2 KiB window; require very few matches
  matches * 64 < probe_len
}

///| Ultra-fast 1-slot direct-hash LZ77 compressor for level 1 (no `prev` chain array, inline match scan).
fn deflate_fast_l1(ctx : DeflateContext, data : Bytes, bw : BitWriter) -> Unit {
  let n = data.length()
  ensure_deflate_l1(ctx)
  let head = ctx.head_l1
  if ctx.l1_bias > 1000000000 - n {
    fill_fixed_i(head, 16384, -1)
    ctx.l1_bias = 0
  }
  let bias = ctx.l1_bias
  ctx.l1_bias = bias + n + 1

  let max_tokens = 32768
  let tok_lit_len = ctx.tok_lit_len
  let tok_dist = ctx.tok_dist
  let lit_freqs = ctx.lit_freqs
  let dist_freqs = ctx.dist_freqs
  reset_block_freqs(lit_freqs, dist_freqs)
  let ltc = len_to_code
  let d_small = dist_to_code_small
  let d_hi = dist_to_code_hi

  let mut tok_cnt = 0
  let mut match_cnt = 0
  let mut block_start = 0
  let mut pos = 0
  let mut miss_count = 0
  let mut consec_stored = 0
  let lim3 = n - 3

  while pos < n {
    if tok_cnt == 0 && n - pos >= 8192 {
      if consec_stored > 0 || (pos == 0 && n >= 16384) {
        let probe_len = if consec_stored >= 2 { 1024 } else { 2048 }
        if is_incompressible_probe(ctx, data, pos, probe_len) {
          let chunk = if n - pos > 65535 { 65535 } else { n - pos }
          emit_stored_blocks(bw, data, pos, chunk, pos + chunk == n)
          pos = pos + chunk
          block_start = pos
          consec_stored = consec_stored + 1
          continue
        }
        consec_stored = 0
      }
    }

    let mut match_len = 0
    let mut match_dist = 0
    if pos <= lim3 {
      let b0 = data[pos]
      let b1 = data[pos + 1]
      let b2 = data[pos + 2]
      let v = (b0.to_int() << 16) | (b1.to_int() << 8) | b2.to_int()
      let h = ((v * 506832829) >> 18) & 16383
      let cand = head[h] - bias
      head[h] = pos + bias
      if cand >= 0 && pos - cand <= 32768 &&
      data[cand] == b0 && data[cand + 1] == b1 && data[cand + 2] == b2 {
        let max_len = if n - pos < 258 { n - pos } else { 258 }
        let mut mlen = 3
        while mlen + 4 <= max_len &&
        data[cand + mlen] == data[pos + mlen] &&
        data[cand + mlen + 1] == data[pos + mlen + 1] &&
        data[cand + mlen + 2] == data[pos + mlen + 2] &&
        data[cand + mlen + 3] == data[pos + mlen + 3] {
          mlen = mlen + 4
        }
        while mlen < max_len && data[cand + mlen] == data[pos + mlen] {
          mlen = mlen + 1
        }
        match_len = mlen
        match_dist = pos - cand
      }
    }

    if match_len >= 3 {
      miss_count = 0
      tok_lit_len[tok_cnt] = match_len
      tok_dist[tok_cnt] = match_dist
      tok_cnt = tok_cnt + 1
      match_cnt = match_cnt + 1
      let lsym = 257 + ltc[match_len]
      lit_freqs[lsym] = lit_freqs[lsym] + 1
      let dcode = if match_dist <= 512 { d_small[match_dist] } else { d_hi[(match_dist - 1) >> 7] }
      dist_freqs[dcode] = dist_freqs[dcode] + 1

      // Insert match tail so RLE/adjacent runs stay indexed
      let tail = pos + match_len - 1
      if tail <= lim3 {
        let tv = (data[tail].to_int() << 16) |
        (data[tail + 1].to_int() << 8) |
        data[tail + 2].to_int()
        head[((tv * 506832829) >> 18) & 16383] = tail + bias
      }
      pos = pos + match_len
    } else {
      let b = data[pos].to_int()
      tok_lit_len[tok_cnt] = b
      tok_dist[tok_cnt] = 0
      tok_cnt = tok_cnt + 1
      lit_freqs[b] = lit_freqs[b] + 1
      pos = pos + 1
      miss_count = miss_count + 1

      if miss_count >= 32 && tok_cnt < max_tokens {
        let mut skip = miss_count >> 5
        if skip > 64 {
          skip = 64
        }
        let room = max_tokens - tok_cnt
        if skip > room {
          skip = room
        }
        if skip > n - pos {
          skip = n - pos
        }
        let mut s = 0
        while s < skip {
          let sb = data[pos].to_int()
          tok_lit_len[tok_cnt] = sb
          tok_dist[tok_cnt] = 0
          tok_cnt = tok_cnt + 1
          lit_freqs[sb] = lit_freqs[sb] + 1
          pos = pos + 1
          s = s + 1
        }
        miss_count = miss_count + skip
      }
    }

    if tok_cnt == max_tokens {
      let was_stored = flush_lz77_block(
        ctx, bw, data, block_start, pos - block_start, tok_lit_len, tok_dist,
        tok_cnt, match_cnt, lit_freqs, dist_freqs, pos == n,
      )
      consec_stored = if was_stored { consec_stored + 1 } else { 0 }
      tok_cnt = 0
      match_cnt = 0
      block_start = pos
      reset_block_freqs(lit_freqs, dist_freqs)
    }
  }

  if tok_cnt > 0 || (bw.len == 0 && bw.chunks.length() == 0) {
    let _ = flush_lz77_block(
      ctx, bw, data, block_start, pos - block_start, tok_lit_len, tok_dist,
      tok_cnt, match_cnt, lit_freqs, dist_freqs, true,
    )
  }
}

///| Lean greedy LZ77 compressor for levels 2..3 (no lazy-match state or branches).
fn deflate_greedy(
  ctx : DeflateContext,
  data : Bytes,
  bw : BitWriter,
  cfg : Int,
  max_ins_limit : Int,
  skip_shift : Int,
  skip_max : Int,
) -> Unit {
  let n = data.length()
  let was_ready = ctx.full_ready
  ensure_deflate_full(ctx)
  let head = ctx.head
  let prev = ctx.prev
  if was_ready {
    fill_fixed_i(head, 32768, -1)
  }

  let max_tokens = 32768
  let tok_lit_len = ctx.tok_lit_len
  let tok_dist = ctx.tok_dist
  let lit_freqs = ctx.lit_freqs
  let dist_freqs = ctx.dist_freqs
  reset_block_freqs(lit_freqs, dist_freqs)
  let ltc = len_to_code
  let d_small = dist_to_code_small
  let d_hi = dist_to_code_hi

  let mut tok_cnt = 0
  let mut match_cnt = 0
  let mut block_start = 0
  let mut pos = 0
  let mut miss_count = 0
  let mut consec_stored = 0
  let skip_thresh = 1 << skip_shift

  while pos < n {
    if tok_cnt == 0 && n - pos >= 8192 {
      if consec_stored > 0 || (pos == 0 && n >= 16384) {
        let probe_len = if consec_stored >= 2 { 1024 } else { 2048 }
        if is_incompressible_probe(ctx, data, pos, probe_len) {
          let chunk = if n - pos > 65535 { 65535 } else { n - pos }
          emit_stored_blocks(bw, data, pos, chunk, pos + chunk == n)
          pos = pos + chunk
          block_start = pos
          consec_stored = consec_stored + 1
          continue
        }
        consec_stored = 0
      }
    }

    let mut match_len = 0
    let mut match_dist = 0
    if pos + 2 < n {
      let h = lz77_hash3(data, pos)
      let cand = head[h]
      prev[pos & 32767] = cand
      head[h] = pos
      if cand >= 0 {
        let packed = lz77_find_match(data, pos, cand, prev, cfg, 2)
        if packed != 0 {
          match_len = packed >> 16
          match_dist = packed & 65535
        }
      }
    }

    if match_len >= 3 {
      miss_count = 0
      tok_lit_len[tok_cnt] = match_len
      tok_dist[tok_cnt] = match_dist
      tok_cnt = tok_cnt + 1
      match_cnt = match_cnt + 1
      let lsym = 257 + ltc[match_len]
      lit_freqs[lsym] = lit_freqs[lsym] + 1
      let dcode = if match_dist <= 512 { d_small[match_dist] } else { d_hi[(match_dist - 1) >> 7] }
      dist_freqs[dcode] = dist_freqs[dcode] + 1

      let max_ins = if match_len > max_ins_limit { max_ins_limit } else { match_len }
      let mut step = 1
      while step < max_ins && pos + step + 2 < n {
        let hp = lz77_hash3(data, pos + step)
        prev[(pos + step) & 32767] = head[hp]
        head[hp] = pos + step
        step = step + 1
      }
      if match_len > max_ins_limit {
        let tail = pos + match_len - 1
        if tail + 2 < n {
          let hp = lz77_hash3(data, tail)
          prev[tail & 32767] = head[hp]
          head[hp] = tail
        }
      }
      pos = pos + match_len
    } else {
      let b = data[pos].to_int()
      tok_lit_len[tok_cnt] = b
      tok_dist[tok_cnt] = 0
      tok_cnt = tok_cnt + 1
      lit_freqs[b] = lit_freqs[b] + 1
      pos = pos + 1
      miss_count = miss_count + 1

      if miss_count >= skip_thresh && tok_cnt < max_tokens {
        let mut skip = miss_count >> skip_shift
        if skip > skip_max {
          skip = skip_max
        }
        let room = max_tokens - tok_cnt
        if skip > room {
          skip = room
        }
        if skip > n - pos {
          skip = n - pos
        }
        let mut s = 0
        while s < skip {
          let sb = data[pos].to_int()
          tok_lit_len[tok_cnt] = sb
          tok_dist[tok_cnt] = 0
          tok_cnt = tok_cnt + 1
          lit_freqs[sb] = lit_freqs[sb] + 1
          pos = pos + 1
          s = s + 1
        }
        miss_count = miss_count + skip
      }
    }

    if tok_cnt == max_tokens {
      let was_stored = flush_lz77_block(
        ctx, bw, data, block_start, pos - block_start, tok_lit_len, tok_dist,
        tok_cnt, match_cnt, lit_freqs, dist_freqs, pos == n,
      )
      consec_stored = if was_stored { consec_stored + 1 } else { 0 }
      tok_cnt = 0
      match_cnt = 0
      block_start = pos
      reset_block_freqs(lit_freqs, dist_freqs)
    }
  }

  if tok_cnt > 0 || (bw.len == 0 && bw.chunks.length() == 0) {
    let _ = flush_lz77_block(
      ctx, bw, data, block_start, pos - block_start, tok_lit_len, tok_dist,
      tok_cnt, match_cnt, lit_freqs, dist_freqs, true,
    )
  }
}

///| Lazy-matching LZ77 compressor for levels 4..9.
fn deflate_lazy(
  ctx : DeflateContext,
  data : Bytes,
  bw : BitWriter,
  cfg : Int,
  lazy_cfg : Int,
  max_lazy : Int,
  max_ins_limit : Int,
  skip_shift : Int,
  skip_max : Int,
) -> Unit {
  let n = data.length()
  let was_ready = ctx.full_ready
  ensure_deflate_full(ctx)
  let head = ctx.head
  let prev = ctx.prev
  if was_ready {
    fill_fixed_i(head, 32768, -1)
  }

  let max_tokens = 32768
  let tok_lit_len = ctx.tok_lit_len
  let tok_dist = ctx.tok_dist
  let lit_freqs = ctx.lit_freqs
  let dist_freqs = ctx.dist_freqs
  reset_block_freqs(lit_freqs, dist_freqs)
  let ltc = len_to_code
  let d_small = dist_to_code_small
  let d_hi = dist_to_code_hi

  let mut tok_cnt = 0
  let mut match_cnt = 0
  let mut block_start = 0
  let mut pos = 0
  let mut miss_count = 0
  let mut consec_stored = 0
  let mut pending_len = 0
  let mut pending_dist = 0

  while pos < n {
    if tok_cnt == 0 && pending_len == 0 && n - pos >= 8192 {
      if consec_stored > 0 || (pos == 0 && n >= 16384) {
        let probe_len = if consec_stored >= 2 { 1024 } else { 2048 }
        if is_incompressible_probe(ctx, data, pos, probe_len) {
          let chunk = if n - pos > 65535 { 65535 } else { n - pos }
          emit_stored_blocks(bw, data, pos, chunk, pos + chunk == n)
          pos = pos + chunk
          block_start = pos
          consec_stored = consec_stored + 1
          continue
        }
        consec_stored = 0
      }
    }

    let mut match_len = 0
    let mut match_dist = 0

    if pending_len >= 3 {
      match_len = pending_len
      match_dist = pending_dist
      pending_len = 0
      pending_dist = 0
    } else if pos + 2 < n {
      let h = lz77_hash3(data, pos)
      let cand = head[h]
      prev[pos & 32767] = cand
      head[h] = pos
      if cand >= 0 {
        let packed = lz77_find_match(data, pos, cand, prev, cfg, 2)
        if packed != 0 {
          match_len = packed >> 16
          match_dist = packed & 65535
        }
      }
    }

    let mut lazy_inserted = false
    if match_len >= 3 && match_len < max_lazy && pos + 3 < n {
      let h2 = lz77_hash3(data, pos + 1)
      let cand2 = head[h2]
      prev[(pos + 1) & 32767] = cand2
      head[h2] = pos + 1
      lazy_inserted = true
      if cand2 >= 0 {
        let packed2 = lz77_find_match(data, pos + 1, cand2, prev, lazy_cfg, match_len)
        if packed2 != 0 {
          let b = data[pos].to_int()
          tok_lit_len[tok_cnt] = b
          tok_dist[tok_cnt] = 0
          tok_cnt = tok_cnt + 1
          lit_freqs[b] = lit_freqs[b] + 1
          pos = pos + 1
          pending_len = packed2 >> 16
          pending_dist = packed2 & 65535
          miss_count = 0
          if tok_cnt == max_tokens {
            let was_stored = flush_lz77_block(
              ctx, bw, data, block_start, pos - block_start, tok_lit_len, tok_dist,
              tok_cnt, match_cnt, lit_freqs, dist_freqs, pos == n,
            )
            consec_stored = if was_stored { consec_stored + 1 } else { 0 }
            tok_cnt = 0
            match_cnt = 0
            block_start = pos
            reset_block_freqs(lit_freqs, dist_freqs)
          }
          continue
        }
      }
    }

    if match_len >= 3 {
      miss_count = 0
      tok_lit_len[tok_cnt] = match_len
      tok_dist[tok_cnt] = match_dist
      tok_cnt = tok_cnt + 1
      match_cnt = match_cnt + 1
      let lsym = 257 + ltc[match_len]
      lit_freqs[lsym] = lit_freqs[lsym] + 1
      let dcode = if match_dist <= 512 { d_small[match_dist] } else { d_hi[(match_dist - 1) >> 7] }
      dist_freqs[dcode] = dist_freqs[dcode] + 1

      let max_ins = if match_len > max_ins_limit { max_ins_limit } else { match_len }
      let mut step = if lazy_inserted { 2 } else { 1 }
      while step < max_ins && pos + step + 2 < n {
        let hp = lz77_hash3(data, pos + step)
        prev[(pos + step) & 32767] = head[hp]
        head[hp] = pos + step
        step = step + 1
      }
      if match_len > max_ins_limit {
        let tail = pos + match_len - 1
        if tail + 2 < n {
          let hp = lz77_hash3(data, tail)
          prev[tail & 32767] = head[hp]
          head[hp] = tail
        }
      }
      pos = pos + match_len
    } else {
      let b = data[pos].to_int()
      tok_lit_len[tok_cnt] = b
      tok_dist[tok_cnt] = 0
      tok_cnt = tok_cnt + 1
      lit_freqs[b] = lit_freqs[b] + 1
      pos = pos + 1
      miss_count = miss_count + 1

      if skip_shift > 0 && miss_count >= (1 << skip_shift) && tok_cnt < max_tokens {
        let mut skip = miss_count >> skip_shift
        if skip > skip_max {
          skip = skip_max
        }
        let room = max_tokens - tok_cnt
        if skip > room {
          skip = room
        }
        if skip > n - pos {
          skip = n - pos
        }
        let mut s = 0
        while s < skip {
          let sb = data[pos].to_int()
          tok_lit_len[tok_cnt] = sb
          tok_dist[tok_cnt] = 0
          tok_cnt = tok_cnt + 1
          lit_freqs[sb] = lit_freqs[sb] + 1
          pos = pos + 1
          s = s + 1
        }
        miss_count = miss_count + skip
      }
    }

    if tok_cnt == max_tokens {
      let was_stored = flush_lz77_block(
        ctx, bw, data, block_start, pos - block_start, tok_lit_len, tok_dist,
        tok_cnt, match_cnt, lit_freqs, dist_freqs, pos == n,
      )
      consec_stored = if was_stored { consec_stored + 1 } else { 0 }
      tok_cnt = 0
      match_cnt = 0
      block_start = pos
      reset_block_freqs(lit_freqs, dist_freqs)
    }
  }

  if tok_cnt > 0 || (bw.len == 0 && bw.chunks.length() == 0) {
    let _ = flush_lz77_block(
      ctx, bw, data, block_start, pos - block_start, tok_lit_len, tok_dist,
      tok_cnt, match_cnt, lit_freqs, dist_freqs, true,
    )
  }
}

///| Compress `data` into a raw RFC 1951 DEFLATE stream at `level` (0..9) using this reusable context.
pub fn DeflateContext::deflate_compress(
  self : DeflateContext,
  data : Bytes,
  level : Int,
) -> Result[Bytes, FlateError] {
  if level < 0 || level > 9 {
    return Err(FlateError::InvalidLevel(level))
  }
  let n = data.length()
  if level == 0 {
    bw_reset(self.bw, n + 16)
    emit_stored_blocks(self.bw, data, 0, n, true)
    return Ok(bw_finish(self.bw))
  }
  if n == 0 {
    let mut empty = Bytes::new(2)
    empty[0] = (3).to_byte()
    empty[1] = (0).to_byte()
    return Ok(empty)
  }

  let max_chain = if level == 1 {
    4
  } else if level == 2 {
    8
  } else if level <= 4 {
    16
  } else if level == 5 {
    32
  } else if level == 6 {
    64
  } else if level == 7 {
    128
  } else if level == 8 {
    256
  } else {
    512
  }
  let good_len = if level <= 4 {
    4
  } else if level <= 7 {
    8
  } else {
    32
  }
  let max_lazy = if level <= 3 {
    0
  } else if level == 4 {
    4
  } else if level <= 6 {
    16
  } else if level == 7 {
    32
  } else if level == 8 {
    64
  } else {
    128
  }
  let nice_len = if level == 1 {
    8
  } else if level == 2 {
    16
  } else if level <= 4 {
    32
  } else if level == 5 {
    64
  } else if level <= 7 {
    128
  } else {
    258
  }
  let max_ins_limit = if level == 1 {
    4
  } else if level == 2 {
    8
  } else if level <= 4 {
    16
  } else if level == 5 {
    32
  } else if level == 6 {
    64
  } else if level == 7 {
    128
  } else {
    258
  }
  let skip_shift = if level == 1 {
    5
  } else if level <= 3 {
    6
  } else if level <= 6 {
    7
  } else {
    0
  }
  let skip_max = if level == 1 {
    64
  } else if level == 2 {
    32
  } else if level <= 6 {
    16
  } else {
    1
  }

  bw_reset(self.bw, if n / 2 + 64 < 512 { 512 } else { n / 2 + 64 })
  if level == 1 {
    deflate_fast_l1(self, data, self.bw)
  } else if level <= 3 {
    let cfg = (good_len << 20) | (nice_len << 10) | max_chain
    deflate_greedy(self, data, self.bw, cfg, max_ins_limit, skip_shift, skip_max)
  } else {
    let cfg = (good_len << 20) | (nice_len << 10) | max_chain
    let lazy_cfg = (good_len << 20) | (nice_len << 10) | (max_chain >> 1)
    deflate_lazy(self, data, self.bw, cfg, lazy_cfg, max_lazy, max_ins_limit, skip_shift, skip_max)
  }
  Ok(bw_finish(self.bw))
}

///| Compress `data` into a raw RFC 1951 DEFLATE stream at `level` (0..9).
pub fn deflate_compress(data : Bytes, level : Int) -> Result[Bytes, FlateError] {
  let ctx = DeflateContext::new()
  ctx.deflate_compress(data, level)
}

///| Compress `data` into a raw RFC 1951 DEFLATE stream at default level 6.
pub fn deflate_compress_default(data : Bytes) -> Bytes {
  match deflate_compress(data, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}
