///| RFC 1951 shared lookup tables, 2-level Inflate Huffman LUT (9-bit primary + subtables),
///| and length-limited Canonical Huffman encoder (Package-Merge, <= 15 bits).

///|
let litlen_root_bits : Int = 10

///|
let litlen_root_size : Int = 1024

///|
let litlen_root_mask : UInt64 = 1023UL

///|
let dist_root_bits : Int = 9

///|
let dist_root_mask : UInt64 = 511UL

///| Precomputed bit masks `(1UL << k) - 1UL` for `k = 0..16`.
fn build_bit_masks() -> FixedArray[UInt64] {
  let a : FixedArray[UInt64] = FixedArray::make(17, 0UL)
  let mut k = 0
  while k <= 16 {
    a[k] = (1UL << k) - 1UL
    k = k + 1
  }
  a
}

///|
let bit_masks : FixedArray[UInt64] = build_bit_masks()

///| Code-length alphabet order (RFC 1951 §3.2.7).
fn build_cl_order() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(19, 0)
  a[0] = 16
  a[1] = 17
  a[2] = 18
  a[3] = 0
  a[4] = 8
  a[5] = 7
  a[6] = 9
  a[7] = 6
  a[8] = 10
  a[9] = 5
  a[10] = 11
  a[11] = 4
  a[12] = 12
  a[13] = 3
  a[14] = 13
  a[15] = 2
  a[16] = 14
  a[17] = 1
  a[18] = 15
  a
}

///|
let cl_order : FixedArray[Int] = build_cl_order()

///| Length base values for symbols 257..285 (index = sym - 257).
fn build_len_base() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(29, 0)
  a[0] = 3
  a[1] = 4
  a[2] = 5
  a[3] = 6
  a[4] = 7
  a[5] = 8
  a[6] = 9
  a[7] = 10
  a[8] = 11
  a[9] = 13
  a[10] = 15
  a[11] = 17
  a[12] = 19
  a[13] = 23
  a[14] = 27
  a[15] = 31
  a[16] = 35
  a[17] = 43
  a[18] = 51
  a[19] = 59
  a[20] = 67
  a[21] = 83
  a[22] = 99
  a[23] = 115
  a[24] = 131
  a[25] = 163
  a[26] = 195
  a[27] = 227
  a[28] = 258
  a
}

///|
let len_base : FixedArray[Int] = build_len_base()

///| Length extra bits for symbols 257..285.
fn build_len_extra() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(29, 0)
  a[8] = 1
  a[9] = 1
  a[10] = 1
  a[11] = 1
  a[12] = 2
  a[13] = 2
  a[14] = 2
  a[15] = 2
  a[16] = 3
  a[17] = 3
  a[18] = 3
  a[19] = 3
  a[20] = 4
  a[21] = 4
  a[22] = 4
  a[23] = 4
  a[24] = 5
  a[25] = 5
  a[26] = 5
  a[27] = 5
  a
}

///|
let len_extra : FixedArray[Int] = build_len_extra()

///| Distance base values for symbols 0..29.
fn build_dist_base() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(30, 0)
  a[0] = 1
  a[1] = 2
  a[2] = 3
  a[3] = 4
  a[4] = 5
  a[5] = 7
  a[6] = 9
  a[7] = 13
  a[8] = 17
  a[9] = 25
  a[10] = 33
  a[11] = 49
  a[12] = 65
  a[13] = 97
  a[14] = 129
  a[15] = 193
  a[16] = 257
  a[17] = 385
  a[18] = 513
  a[19] = 769
  a[20] = 1025
  a[21] = 1537
  a[22] = 2049
  a[23] = 3073
  a[24] = 4097
  a[25] = 6145
  a[26] = 8193
  a[27] = 12289
  a[28] = 16385
  a[29] = 24577
  a
}

///|
let dist_base : FixedArray[Int] = build_dist_base()

///| Distance extra bits for symbols 0..29.
fn build_dist_extra() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(30, 0)
  a[4] = 1
  a[5] = 1
  a[6] = 2
  a[7] = 2
  a[8] = 3
  a[9] = 3
  a[10] = 4
  a[11] = 4
  a[12] = 5
  a[13] = 5
  a[14] = 6
  a[15] = 6
  a[16] = 7
  a[17] = 7
  a[18] = 8
  a[19] = 8
  a[20] = 9
  a[21] = 9
  a[22] = 10
  a[23] = 10
  a[24] = 11
  a[25] = 11
  a[26] = 12
  a[27] = 12
  a[28] = 13
  a[29] = 13
  a
}

///|
let dist_extra : FixedArray[Int] = build_dist_extra()

///| Map match length (3..258) to RFC 1951 length code index (0..28, sym = 257 + idx).
fn build_len_to_code() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(259, 0)
  let mut code = 0
  while code < 29 {
    let base = len_base[code]
    let span = 1 << len_extra[code]
    let mut k = 0
    while k < span {
      let l = base + k
      if l <= 258 {
        a[l] = code
      }
      k = k + 1
    }
    code = code + 1
  }
  a[258] = 28
  a
}

///|
let len_to_code : FixedArray[Int] = build_len_to_code()

///| Map small distance (1..512) to RFC 1951 distance code (0..17).
fn build_dist_to_code_small() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(513, 0)
  let mut code = 0
  while code < 18 {
    let base = dist_base[code]
    let span = 1 << dist_extra[code]
    let mut k = 0
    while k < span {
      let d = base + k
      if d <= 512 {
        a[d] = code
      }
      k = k + 1
    }
    code = code + 1
  }
  a
}

///|
let dist_to_code_small : FixedArray[Int] = build_dist_to_code_small()

///| Map `(dist - 1) >> 7` (range 4..255) to RFC 1951 distance code (18..29).
fn build_dist_to_code_hi() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(256, 0)
  let mut code = 18
  while code < 30 {
    let lo = (dist_base[code] - 1) >> 7
    let hi = (dist_base[code] + (1 << dist_extra[code]) - 2) >> 7
    let mut k = lo
    while k <= hi && k < 256 {
      a[k] = code
      k = k + 1
    }
    code = code + 1
  }
  a
}

///|
let dist_to_code_hi : FixedArray[Int] = build_dist_to_code_hi()

///| Fast O(1) distance (1..32768) -> distance code (0..29).
fn dist_to_code(dist : Int) -> Int {
  if dist <= 512 {
    return dist_to_code_small[dist]
  }
  dist_to_code_hi[(dist - 1) >> 7]
}

///| Bit-reverse the bottom `bits` bits of `code`.
fn bit_reverse(code : Int, bits : Int) -> Int {
  let mut x = code
  let mut r = 0
  let mut i = 0
  while i < bits {
    r = (r << 1) | (x & 1)
    x = x >> 1
    i = i + 1
  }
  r
}

///| Build 2-level Inflate Huffman LUT into `table` (size >= 1024).
///| Entry encoding:
///|   - `0`: invalid code
///|   - `(entry & 16) == 0`: direct symbol -> `bits = entry & 15`, `sym = entry >> 5`
///|   - `(entry & 16) != 0`: subtable -> `sub_bits = entry & 15`, `sub_off = entry >> 5`
///| `allow_empty`: true only for dynamic distance tree with 0 symbols.
fn build_inflate_table(
  lengths : FixedArray[Int],
  num_syms : Int,
  table : FixedArray[Int],
  root_bits : Int,
  allow_empty : Bool,
) -> Result[Int, FlateError] {
  let count : FixedArray[Int] = FixedArray::make(16, 0)
  let mut max_len = 0
  let mut total_syms = 0
  let mut i = 0
  while i < num_syms {
    let l = lengths[i]
    if l < 0 || l > 15 {
      return Err(FlateError::InvalidHuffmanTree("code length out of 0..15 range"))
    }
    if l > 0 {
      count[l] = count[l] + 1
      if l > max_len {
        max_len = l
      }
      total_syms = total_syms + 1
    }
    i = i + 1
  }
  let root_size = 1 << root_bits
  // Clear root table
  i = 0
  while i < root_size {
    table[i] = 0
    i = i + 1
  }
  if total_syms == 0 {
    if allow_empty {
      return Ok(0)
    }
    return Err(FlateError::InvalidHuffmanTree("empty Huffman tree"))
  }
  // Check Kraft inequality: oversubscribed or incomplete
  let mut left = 1
  let mut b = 1
  while b <= 15 {
    left = (left << 1) - count[b]
    if left < 0 {
      return Err(FlateError::InvalidHuffmanTree("oversubscribed Huffman tree"))
    }
    b = b + 1
  }
  if left > 0 && !(total_syms == 1 && max_len == 1) {
    return Err(FlateError::InvalidHuffmanTree("incomplete Huffman tree"))
  }

  // Compute canonical starting codes for each bit length
  let next_code : FixedArray[Int] = FixedArray::make(16, 0)
  let mut code = 0
  b = 1
  while b <= 15 {
    code = (code + count[b - 1]) << 1
    next_code[b] = code
    b = b + 1
  }

  // First pass: assign codes for symbols with length <= root_bits, and track max length per root prefix for length > root_bits
  let sub_max_bits : FixedArray[Int] = FixedArray::make(root_size, 0)
  let sym_codes : FixedArray[Int] = FixedArray::make(num_syms, 0)
  let mut sym = 0
  while sym < num_syms {
    let l = lengths[sym]
    if l > 0 {
      let c = next_code[l]
      next_code[l] = c + 1
      let rev = bit_reverse(c, l)
      sym_codes[sym] = rev
      if l <= root_bits {
        let entry = (sym << 5) | l
        let step = 1 << l
        let mut idx = rev
        while idx < root_size {
          table[idx] = entry
          idx = idx + step
        }
      } else {
        let prefix = rev & (root_size - 1)
        let extra = l - root_bits
        if extra > sub_max_bits[prefix] {
          sub_max_bits[prefix] = extra
        }
      }
    }
    sym = sym + 1
  }

  // Allocate subtables for prefixes that have codes longer than root_bits
  let mut next_free = root_size
  let mut p = 0
  while p < root_size {
    let sb = sub_max_bits[p]
    if sb > 0 {
      let sub_size = 1 << sb
      if next_free + sub_size > table.length() {
        return Err(FlateError::InvalidHuffmanTree("Huffman subtable overflow"))
      }
      table[p] = (next_free << 5) | 16 | sb
      let mut k = 0
      while k < sub_size {
        table[next_free + k] = 0
        k = k + 1
      }
      next_free = next_free + sub_size
    }
    p = p + 1
  }

  // Second pass: populate subtables
  sym = 0
  while sym < num_syms {
    let l = lengths[sym]
    if l > root_bits {
      let rev = sym_codes[sym]
      let prefix = rev & (root_size - 1)
      let root_entry = table[prefix]
      let sub_off = root_entry >> 5
      let sub_bits = root_entry & 15
      let sub_size = 1 << sub_bits
      let extra_len = l - root_bits
      let entry = (sym << 5) | extra_len
      let step = 1 << extra_len
      let mut idx = rev >> root_bits
      while idx < sub_size {
        table[sub_off + idx] = entry
        idx = idx + step
      }
    }
    sym = sym + 1
  }
  Ok(total_syms)
}

///| Build fixed RFC 1951 literal/length code lengths (288 entries).
fn build_fixed_litlen_lengths() -> FixedArray[Int] {
  let l : FixedArray[Int] = FixedArray::make(288, 0)
  let mut i = 0
  while i <= 143 {
    l[i] = 8
    i = i + 1
  }
  while i <= 255 {
    l[i] = 9
    i = i + 1
  }
  while i <= 279 {
    l[i] = 7
    i = i + 1
  }
  while i <= 287 {
    l[i] = 8
    i = i + 1
  }
  l
}

///|
let fixed_litlen_lengths : FixedArray[Int] = build_fixed_litlen_lengths()

///| Build fixed RFC 1951 distance code lengths (32 entries, all 5 bits; 30..31 rejected on decode).
fn build_fixed_dist_lengths() -> FixedArray[Int] {
  FixedArray::make(32, 5)
}

///|
let fixed_dist_lengths : FixedArray[Int] = build_fixed_dist_lengths()

///| Build 2-level packed LitLen Inflate Huffman LUT into `table` (size >= 2048 for 10-bit root).
///| Direct entry encoding (`(entry & 16) == 0`):
///|   - `0`: invalid code
///|   - `(entry & 48) == 32`: literal -> `nb = entry & 15`, `lit = entry >> 8`
///|   - `(entry & 64) != 0`: EOB (sym 256) -> `nb = entry & 15`
///|   - `(entry & 128) != 0`: length -> `nb = entry & 15`, `lextra = (entry >> 8) & 15`, `lbase = entry >> 12`
///|   - `(entry & 256) != 0`: invalid symbol (286..287) -> `nb = entry & 15`, `sym = entry >> 9`
///| Subtable entry (`(entry & 16) != 0`): `sub_bits = entry & 15`, `sub_off = entry >> 5`.
fn build_litlen_inflate_table(
  lengths : FixedArray[Int],
  num_syms : Int,
  table : FixedArray[Int],
  root_bits : Int,
) -> Result[Int, FlateError] {
  let count : FixedArray[Int] = FixedArray::make(16, 0)
  let mut max_len = 0
  let mut total_syms = 0
  let mut i = 0
  while i < num_syms {
    let l = lengths[i]
    if l < 0 || l > 15 {
      return Err(FlateError::InvalidHuffmanTree("code length out of 0..15 range"))
    }
    if l > 0 {
      count[l] = count[l] + 1
      if l > max_len {
        max_len = l
      }
      total_syms = total_syms + 1
    }
    i = i + 1
  }
  let root_size = 1 << root_bits
  i = 0
  while i < root_size {
    table[i] = 0
    i = i + 1
  }
  if total_syms == 0 {
    return Err(FlateError::InvalidHuffmanTree("empty Huffman tree"))
  }
  let mut left = 1
  let mut b = 1
  while b <= 15 {
    left = (left << 1) - count[b]
    if left < 0 {
      return Err(FlateError::InvalidHuffmanTree("oversubscribed Huffman tree"))
    }
    b = b + 1
  }
  if left > 0 && !(total_syms == 1 && max_len == 1) {
    return Err(FlateError::InvalidHuffmanTree("incomplete Huffman tree"))
  }

  let next_code : FixedArray[Int] = FixedArray::make(16, 0)
  let mut code = 0
  b = 1
  while b <= 15 {
    code = (code + count[b - 1]) << 1
    next_code[b] = code
    b = b + 1
  }

  let sub_max_bits : FixedArray[Int] = FixedArray::make(root_size, 0)
  let sym_codes : FixedArray[Int] = FixedArray::make(num_syms, 0)
  let lb = len_base
  let le = len_extra
  let mut sym = 0
  while sym < num_syms {
    let l = lengths[sym]
    if l > 0 {
      let c = next_code[l]
      next_code[l] = c + 1
      let rev = bit_reverse(c, l)
      sym_codes[sym] = rev
      if l <= root_bits {
        let packed = if sym < 256 {
          (sym << 8) | 32
        } else if sym == 256 {
          64
        } else if sym <= 285 {
          let lidx = sym - 257
          (lb[lidx] << 12) | (le[lidx] << 8) | 128
        } else {
          (sym << 9) | 256
        }
        let entry = packed | l
        let step = 1 << l
        let mut idx = rev
        while idx < root_size {
          table[idx] = entry
          idx = idx + step
        }
      } else {
        let prefix = rev & (root_size - 1)
        let extra = l - root_bits
        if extra > sub_max_bits[prefix] {
          sub_max_bits[prefix] = extra
        }
      }
    }
    sym = sym + 1
  }

  let mut next_free = root_size
  let mut p = 0
  while p < root_size {
    let sb = sub_max_bits[p]
    if sb > 0 {
      let sub_size = 1 << sb
      if next_free + sub_size > table.length() {
        return Err(FlateError::InvalidHuffmanTree("Huffman subtable overflow"))
      }
      table[p] = (next_free << 5) | 16 | sb
      let mut k = 0
      while k < sub_size {
        table[next_free + k] = 0
        k = k + 1
      }
      next_free = next_free + sub_size
    }
    p = p + 1
  }

  sym = 0
  while sym < num_syms {
    let l = lengths[sym]
    if l > root_bits {
      let rev = sym_codes[sym]
      let prefix = rev & (root_size - 1)
      let root_entry = table[prefix]
      let sub_off = root_entry >> 5
      let sub_bits = root_entry & 15
      let sub_size = 1 << sub_bits
      let extra_len = l - root_bits
      let packed = if sym < 256 {
        (sym << 8) | 32
      } else if sym == 256 {
        64
      } else if sym <= 285 {
        let lidx = sym - 257
        (lb[lidx] << 12) | (le[lidx] << 8) | 128
      } else {
        (sym << 9) | 256
      }
      let entry = packed | extra_len
      let step = 1 << extra_len
      let mut idx = rev >> root_bits
      while idx < sub_size {
        table[sub_off + idx] = entry
        idx = idx + step
      }
    }
    sym = sym + 1
  }
  Ok(total_syms)
}

///| Build 2-level packed Distance Inflate Huffman LUT into `table` (size >= 1024 for 9-bit root).
///| Direct entry encoding (`(entry & 16) == 0`):
///|   - `0`: invalid code
///|   - `(entry & 48) == 32`: valid dist -> `dnb = entry & 15`, `dextra = (entry >> 6) & 15`, `dbase = entry >> 10`
///|   - `(entry & 64) != 0`: invalid dist symbol (30..31) -> `dnb = entry & 15`, `dsym = entry >> 7`
///| Subtable entry (`(entry & 16) != 0`): `sub_bits = entry & 15`, `sub_off = entry >> 5`.
fn build_dist_inflate_table(
  lengths : FixedArray[Int],
  num_syms : Int,
  table : FixedArray[Int],
  root_bits : Int,
  allow_empty : Bool,
) -> Result[Int, FlateError] {
  let count : FixedArray[Int] = FixedArray::make(16, 0)
  let mut max_len = 0
  let mut total_syms = 0
  let mut i = 0
  while i < num_syms {
    let l = lengths[i]
    if l < 0 || l > 15 {
      return Err(FlateError::InvalidHuffmanTree("code length out of 0..15 range"))
    }
    if l > 0 {
      count[l] = count[l] + 1
      if l > max_len {
        max_len = l
      }
      total_syms = total_syms + 1
    }
    i = i + 1
  }
  let root_size = 1 << root_bits
  i = 0
  while i < root_size {
    table[i] = 0
    i = i + 1
  }
  if total_syms == 0 {
    if allow_empty {
      return Ok(0)
    }
    return Err(FlateError::InvalidHuffmanTree("empty Huffman tree"))
  }
  let mut left = 1
  let mut b = 1
  while b <= 15 {
    left = (left << 1) - count[b]
    if left < 0 {
      return Err(FlateError::InvalidHuffmanTree("oversubscribed Huffman tree"))
    }
    b = b + 1
  }
  if left > 0 && !(total_syms == 1 && max_len == 1) {
    return Err(FlateError::InvalidHuffmanTree("incomplete Huffman tree"))
  }

  let next_code : FixedArray[Int] = FixedArray::make(16, 0)
  let mut code = 0
  b = 1
  while b <= 15 {
    code = (code + count[b - 1]) << 1
    next_code[b] = code
    b = b + 1
  }

  let sub_max_bits : FixedArray[Int] = FixedArray::make(root_size, 0)
  let sym_codes : FixedArray[Int] = FixedArray::make(num_syms, 0)
  let db = dist_base
  let de = dist_extra
  let mut sym = 0
  while sym < num_syms {
    let l = lengths[sym]
    if l > 0 {
      let c = next_code[l]
      next_code[l] = c + 1
      let rev = bit_reverse(c, l)
      sym_codes[sym] = rev
      if l <= root_bits {
        let packed = if sym <= 29 {
          (db[sym] << 10) | (de[sym] << 6) | 32
        } else {
          (sym << 7) | 64
        }
        let entry = packed | l
        let step = 1 << l
        let mut idx = rev
        while idx < root_size {
          table[idx] = entry
          idx = idx + step
        }
      } else {
        let prefix = rev & (root_size - 1)
        let extra = l - root_bits
        if extra > sub_max_bits[prefix] {
          sub_max_bits[prefix] = extra
        }
      }
    }
    sym = sym + 1
  }

  let mut next_free = root_size
  let mut p = 0
  while p < root_size {
    let sb = sub_max_bits[p]
    if sb > 0 {
      let sub_size = 1 << sb
      if next_free + sub_size > table.length() {
        return Err(FlateError::InvalidHuffmanTree("Huffman subtable overflow"))
      }
      table[p] = (next_free << 5) | 16 | sb
      let mut k = 0
      while k < sub_size {
        table[next_free + k] = 0
        k = k + 1
      }
      next_free = next_free + sub_size
    }
    p = p + 1
  }

  sym = 0
  while sym < num_syms {
    let l = lengths[sym]
    if l > root_bits {
      let rev = sym_codes[sym]
      let prefix = rev & (root_size - 1)
      let root_entry = table[prefix]
      let sub_off = root_entry >> 5
      let sub_bits = root_entry & 15
      let sub_size = 1 << sub_bits
      let extra_len = l - root_bits
      let packed = if sym <= 29 {
        (db[sym] << 10) | (de[sym] << 6) | 32
      } else {
        (sym << 7) | 64
      }
      let entry = packed | extra_len
      let step = 1 << extra_len
      let mut idx = rev >> root_bits
      while idx < sub_size {
        table[sub_off + idx] = entry
        idx = idx + step
      }
    }
    sym = sym + 1
  }
  Ok(total_syms)
}

///| Prebuilt fixed Inflate litlen LUT (1024 entries, max code len 9 fits completely in 10-bit primary).
fn build_fixed_litlen_lut() -> FixedArray[Int] {
  let t : FixedArray[Int] = FixedArray::make(litlen_root_size, 0)
  let _ = build_litlen_inflate_table(fixed_litlen_lengths, 288, t, litlen_root_bits)
  t
}

///|
let fixed_litlen_lut : FixedArray[Int] = build_fixed_litlen_lut()

///| Prebuilt fixed Inflate dist LUT (all 5-bit codes).
fn build_fixed_dist_lut() -> FixedArray[Int] {
  let t : FixedArray[Int] = FixedArray::make(64, 0)
  let _ = build_dist_inflate_table(fixed_dist_lengths, 32, t, 5, false)
  t
}

///|
let fixed_dist_lut : FixedArray[Int] = build_fixed_dist_lut()

///| Compute bit-reversed canonical Huffman codes from `lengths[0..num_syms]` into `codes`.
fn build_canonical_codes(
  lengths : FixedArray[Int],
  num_syms : Int,
  codes : FixedArray[Int],
) -> Unit {
  let bl_count : FixedArray[Int] = FixedArray::make(16, 0)
  let mut i = 0
  while i < num_syms {
    let l = lengths[i]
    if l > 0 {
      bl_count[l] = bl_count[l] + 1
    }
    codes[i] = 0
    i = i + 1
  }
  let next_code : FixedArray[Int] = FixedArray::make(16, 0)
  let mut code = 0
  let mut b = 1
  while b <= 15 {
    code = (code + bl_count[b - 1]) << 1
    next_code[b] = code
    b = b + 1
  }
  i = 0
  while i < num_syms {
    let l = lengths[i]
    if l > 0 {
      let c = next_code[l]
      next_code[l] = c + 1
      codes[i] = bit_reverse(c, l)
    }
    i = i + 1
  }
}

///| Prebuilt fixed Deflate litlen codes (bit-reversed).
fn build_fixed_litlen_codes() -> FixedArray[Int] {
  let c : FixedArray[Int] = FixedArray::make(288, 0)
  build_canonical_codes(fixed_litlen_lengths, 288, c)
  c
}

///|
let fixed_litlen_codes : FixedArray[Int] = build_fixed_litlen_codes()

///| Prebuilt fixed Deflate dist codes (bit-reversed).
fn build_fixed_dist_codes() -> FixedArray[Int] {
  let c : FixedArray[Int] = FixedArray::make(30, 0)
  build_canonical_codes(fixed_dist_lengths, 30, c)
  c
}

///|
let fixed_dist_codes : FixedArray[Int] = build_fixed_dist_codes()

///| Package-Merge optimal length-limited Huffman code length builder (`1 <= len <= max_bits`).
///| Writes resulting lengths into `out_lengths[0..num_syms]`.
fn build_limited_huffman_lengths(
  freqs : FixedArray[Int],
  num_syms : Int,
  max_bits : Int,
  out_lengths : FixedArray[Int],
) -> Unit {
  let mut i = 0
  while i < num_syms {
    out_lengths[i] = 0
    i = i + 1
  }
  // Collect active symbols
  let syms : FixedArray[Int] = FixedArray::make(num_syms, 0)
  let weights : FixedArray[Int64] = FixedArray::make(num_syms, 0L)
  let mut n = 0
  i = 0
  while i < num_syms {
    if freqs[i] > 0 {
      syms[n] = i
      weights[n] = freqs[i].to_int64()
      n = n + 1
    }
    i = i + 1
  }
  if n == 0 {
    return
  }
  if n == 1 {
    out_lengths[syms[0]] = 1
    return
  }
  // Insertion sort active symbols by (weight asc, sym asc)
  i = 1
  while i < n {
    let kw = weights[i]
    let ks = syms[i]
    let mut j = i - 1
    while j >= 0 && (weights[j] > kw || (weights[j] == kw && syms[j] > ks)) {
      weights[j + 1] = weights[j]
      syms[j + 1] = syms[j]
      j = j - 1
    }
    weights[j + 1] = kw
    syms[j + 1] = ks
    i = i + 1
  }

  // Package-Merge:
  // At each level `d` in `0..max_bits-1`, we have up to `2*n - 2` items.
  // Each item is either a leaf (sym >= 0) or a package combining two items from level `d-1`.
  // We store package trees in flat arrays:
  //   node_left[id], node_right[id]: child node ids (-1 if leaf)
  //   node_sym[id]: symbol index if leaf (-1 if internal package)
  let max_items = 2 * n
  let max_nodes = (max_bits + 1) * max_items + 4
  let node_left : FixedArray[Int] = FixedArray::make(max_nodes, -1)
  let node_right : FixedArray[Int] = FixedArray::make(max_nodes, -1)
  let node_sym : FixedArray[Int] = FixedArray::make(max_nodes, -1)
  let mut node_cnt = 0

  let mut cur_ids : FixedArray[Int] = FixedArray::make(max_items, 0)
  let mut cur_w : FixedArray[Int64] = FixedArray::make(max_items, 0L)
  let mut cur_len = n
  i = 0
  while i < n {
    let id = node_cnt
    node_cnt = node_cnt + 1
    node_sym[id] = syms[i]
    cur_ids[i] = id
    cur_w[i] = weights[i]
    i = i + 1
  }

  let next_ids : FixedArray[Int] = FixedArray::make(max_items, 0)
  let next_w : FixedArray[Int64] = FixedArray::make(max_items, 0L)

  let mut lvl = 1
  while lvl < max_bits {
    // Pair adjacent items from cur into packages
    let pkg_cnt = cur_len / 2
    // Merge-sort `n` leaves with `pkg_cnt` packages
    let mut li = 0
    let mut pi = 0
    let mut oi = 0
    let max_out = 2 * n - 2
    while oi < max_out && (li < n || pi < pkg_cnt) {
      let take_leaf = if pi >= pkg_cnt {
        true
      } else if li >= n {
        false
      } else {
        let pw = cur_w[pi * 2] + cur_w[pi * 2 + 1]
        weights[li] <= pw
      }
      if take_leaf {
        let id = node_cnt
        node_cnt = node_cnt + 1
        node_sym[id] = syms[li]
        next_ids[oi] = id
        next_w[oi] = weights[li]
        li = li + 1
      } else {
        let id = node_cnt
        node_cnt = node_cnt + 1
        node_left[id] = cur_ids[pi * 2]
        node_right[id] = cur_ids[pi * 2 + 1]
        next_ids[oi] = id
        next_w[oi] = cur_w[pi * 2] + cur_w[pi * 2 + 1]
        pi = pi + 1
      }
      oi = oi + 1
    }
    // Copy next into cur
    let mut k = 0
    while k < oi {
      cur_ids[k] = next_ids[k]
      cur_w[k] = next_w[k]
      k = k + 1
    }
    cur_len = oi
    lvl = lvl + 1
  }

  // Count leaf occurrences across the first `2*n - 2` items using an explicit stack
  let stack : FixedArray[Int] = FixedArray::make(max_nodes, 0)
  let mut sp = 0
  let take = if 2 * n - 2 < cur_len { 2 * n - 2 } else { cur_len }
  i = 0
  while i < take {
    stack[sp] = cur_ids[i]
    sp = sp + 1
    i = i + 1
  }
  while sp > 0 {
    sp = sp - 1
    let id = stack[sp]
    let s = node_sym[id]
    if s >= 0 {
      out_lengths[s] = out_lengths[s] + 1
    } else {
      stack[sp] = node_left[id]
      sp = sp + 1
      stack[sp] = node_right[id]
      sp = sp + 1
    }
  }
}
