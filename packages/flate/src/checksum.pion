///| High-performance IEEE CRC-32 (Slice-by-8) and Adler-32 (NMAX=5552 deferred modulo).

///|
fn build_crc32_t0() -> FixedArray[UInt] {
  let t : FixedArray[UInt] = FixedArray::make(256, 0U)
  let poly : UInt = 0xEDB88320U
  let mut i = 0
  while i < 256 {
    let mut c : UInt = i.to_uint()
    let mut k = 0
    while k < 8 {
      if (c & 1U) != 0U {
        c = (c >> 1) ^ poly
      } else {
        c = c >> 1
      }
      k = k + 1
    }
    t[i] = c
    i = i + 1
  }
  t
}

///|
fn build_crc32_next(prev : FixedArray[UInt], t0 : FixedArray[UInt]) -> FixedArray[UInt] {
  let t : FixedArray[UInt] = FixedArray::make(256, 0U)
  let mut i = 0
  while i < 256 {
    let p = prev[i]
    t[i] = (p >> 8) ^ t0[(p & 0xFFU).to_int()]
    i = i + 1
  }
  t
}

///|
let crc32_t0 : FixedArray[UInt] = build_crc32_t0()

///|
let crc32_t1 : FixedArray[UInt] = build_crc32_next(crc32_t0, crc32_t0)

///|
let crc32_t2 : FixedArray[UInt] = build_crc32_next(crc32_t1, crc32_t0)

///|
let crc32_t3 : FixedArray[UInt] = build_crc32_next(crc32_t2, crc32_t0)

///|
let crc32_t4 : FixedArray[UInt] = build_crc32_next(crc32_t3, crc32_t0)

///|
let crc32_t5 : FixedArray[UInt] = build_crc32_next(crc32_t4, crc32_t0)

///|
let crc32_t6 : FixedArray[UInt] = build_crc32_next(crc32_t5, crc32_t0)

///|
let crc32_t7 : FixedArray[UInt] = build_crc32_next(crc32_t6, crc32_t0)

///|
let crc32_t8 : FixedArray[UInt] = build_crc32_next(crc32_t7, crc32_t0)

///|
let crc32_t9 : FixedArray[UInt] = build_crc32_next(crc32_t8, crc32_t0)

///|
let crc32_t10 : FixedArray[UInt] = build_crc32_next(crc32_t9, crc32_t0)

///|
let crc32_t11 : FixedArray[UInt] = build_crc32_next(crc32_t10, crc32_t0)

///|
let crc32_t12 : FixedArray[UInt] = build_crc32_next(crc32_t11, crc32_t0)

///|
let crc32_t13 : FixedArray[UInt] = build_crc32_next(crc32_t12, crc32_t0)

///|
let crc32_t14 : FixedArray[UInt] = build_crc32_next(crc32_t13, crc32_t0)

///|
let crc32_t15 : FixedArray[UInt] = build_crc32_next(crc32_t14, crc32_t0)

///| Incrementally update IEEE CRC-32 over `data[start..end]` using Slice-by-16.
pub fn crc32_update_slice(crc : UInt, data : Bytes, start : Int, end : Int) -> UInt {
  let s = if start < 0 { 0 } else { start }
  let e = if end > data.length() { data.length() } else { end }
  if s >= e {
    return crc
  }
  let t0 = crc32_t0
  let t1 = crc32_t1
  let t2 = crc32_t2
  let t3 = crc32_t3
  let t4 = crc32_t4
  let t5 = crc32_t5
  let t6 = crc32_t6
  let t7 = crc32_t7
  let t8 = crc32_t8
  let t9 = crc32_t9
  let t10 = crc32_t10
  let t11 = crc32_t11
  let t12 = crc32_t12
  let t13 = crc32_t13
  let t14 = crc32_t14
  let t15 = crc32_t15
  let mut c : UInt = crc ^ 0xFFFFFFFFU
  let mut i = s
  let limit16 = e - 16
  while i <= limit16 {
    let x0 = (c & 0xFFU).to_int() ^ data[i].to_int()
    let x1 = ((c >> 8) & 0xFFU).to_int() ^ data[i + 1].to_int()
    let x2 = ((c >> 16) & 0xFFU).to_int() ^ data[i + 2].to_int()
    let x3 = ((c >> 24) & 0xFFU).to_int() ^ data[i + 3].to_int()
    c = (t15[x0] ^ t14[x1] ^ t13[x2] ^ t12[x3]) ^
    (t11[data[i + 4].to_int()] ^ t10[data[i + 5].to_int()] ^ t9[data[i + 6].to_int()] ^ t8[data[i + 7].to_int()]) ^
    (t7[data[i + 8].to_int()] ^ t6[data[i + 9].to_int()] ^ t5[data[i + 10].to_int()] ^ t4[data[i + 11].to_int()]) ^
    (t3[data[i + 12].to_int()] ^ t2[data[i + 13].to_int()] ^ t1[data[i + 14].to_int()] ^ t0[data[i + 15].to_int()])
    i = i + 16
  }
  while i < e {
    let idx = ((c & 0xFFU).to_int()) ^ data[i].to_int()
    c = (c >> 8) ^ t0[idx]
    i = i + 1
  }
  c ^ 0xFFFFFFFFU
}

///| Incrementally update IEEE CRC-32 with `data`.
pub fn crc32_update(crc : UInt, data : Bytes) -> UInt {
  crc32_update_slice(crc, data, 0, data.length())
}

///| Compute IEEE CRC-32 of `data`.
pub fn crc32(data : Bytes) -> UInt {
  crc32_update_slice(0U, data, 0, data.length())
}

///| Streaming IEEE CRC-32 hasher.
pub struct Crc32 {
  mut state : UInt
}

///|
pub fn Crc32::new() -> Crc32 {
  Crc32::{ state: 0U }
}

///|
pub fn Crc32::update(self : Crc32, data : Bytes) -> Unit {
  self.state = crc32_update(self.state, data)
}

///|
pub fn Crc32::finalize(self : Crc32) -> UInt {
  self.state
}

///|
pub fn Crc32::reset(self : Crc32) -> Unit {
  self.state = 0U
}

///| Incrementally update Adler-32 over `data[start..end]` with NMAX=5552 deferred modulo.
pub fn adler32_update_slice(adler : UInt, data : Bytes, start : Int, end : Int) -> UInt {
  let s = if start < 0 { 0 } else { start }
  let e = if end > data.length() { data.length() } else { end }
  if s >= e {
    return adler
  }
  let mut s1 : UInt = adler & 0xFFFFU
  let mut s2 : UInt = (adler >> 16) & 0xFFFFU
  let mut i = s
  while i < e {
    let rem = e - i
    let chunk = if rem > 5552 { 5552 } else { rem }
    let chunk_end = i + chunk
    let limit16 = chunk_end - 16
    while i <= limit16 {
      let b0 = data[i].to_int()
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      let b4 = data[i + 4].to_int()
      let b5 = data[i + 5].to_int()
      let b6 = data[i + 6].to_int()
      let b7 = data[i + 7].to_int()
      let b8 = data[i + 8].to_int()
      let b9 = data[i + 9].to_int()
      let b10 = data[i + 10].to_int()
      let b11 = data[i + 11].to_int()
      let b12 = data[i + 12].to_int()
      let b13 = data[i + 13].to_int()
      let b14 = data[i + 14].to_int()
      let b15 = data[i + 15].to_int()
      let sum = (b0 + b1 + b2 + b3) + (b4 + b5 + b6 + b7) +
      (b8 + b9 + b10 + b11) + (b12 + b13 + b14 + b15)
      let wsum = (16 * b0 + 15 * b1 + 14 * b2 + 13 * b3) +
      (12 * b4 + 11 * b5 + 10 * b6 + 9 * b7) +
      (8 * b8 + 7 * b9 + 6 * b10 + 5 * b11) +
      (4 * b12 + 3 * b13 + 2 * b14 + b15)
      s2 = s2 + (s1 << 4) + wsum.to_uint()
      s1 = s1 + sum.to_uint()
      i = i + 16
    }
    while i < chunk_end {
      s1 = s1 + data[i].to_int().to_uint()
      s2 = s2 + s1
      i = i + 1
    }
    s1 = s1 % 65521U
    s2 = s2 % 65521U
  }
  (s2 << 16) | s1
}

///| Incrementally update Adler-32 with `data`.
pub fn adler32_update(adler : UInt, data : Bytes) -> UInt {
  adler32_update_slice(adler, data, 0, data.length())
}

///| Compute Adler-32 of `data`.
pub fn adler32(data : Bytes) -> UInt {
  adler32_update_slice(1U, data, 0, data.length())
}

///| Streaming Adler-32 hasher.
pub struct Adler32 {
  mut state : UInt
}

///|
pub fn Adler32::new() -> Adler32 {
  Adler32::{ state: 1U }
}

///|
pub fn Adler32::update(self : Adler32, data : Bytes) -> Unit {
  self.state = adler32_update(self.state, data)
}

///|
pub fn Adler32::finalize(self : Adler32) -> UInt {
  self.state
}

///|
pub fn Adler32::reset(self : Adler32) -> Unit {
  self.state = 1U
}
