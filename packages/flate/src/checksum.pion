///| High-performance IEEE CRC-32 (Slice-by-8) and Adler-32 (NMAX=5552 deferred modulo).

///| IEEE 802.3 CRC-32 8-bit polynomial reduction (`0xEDB88320U`) for table entry `b`.
pub fn crc32_byte_poly(b : UInt) -> UInt {
  let poly : UInt = 0xEDB88320U
  let mut c : UInt = b
  let mut k = 0
  while k < 8 {
    if (c & 1U) != 0U {
      c = (c >> 1) ^ poly
    } else {
      c = c >> 1
    }
    k = k + 1
  }
  c
}

///| Build flat 16x256 Slice-by-16 IEEE CRC-32 lookup table (`table[k * 256 + b]`).
fn build_crc32_table16() -> FixedArray[UInt] {
  let t : FixedArray[UInt] = FixedArray::make(4096, 0U)
  let mut i = 0
  while i < 256 {
    t[i] = crc32_byte_poly(i.to_uint())
    i = i + 1
  }
  let mut k = 1
  while k < 16 {
    let prev_off = (k - 1) * 256
    let cur_off = k * 256
    i = 0
    while i < 256 {
      let p = t[prev_off + i]
      t[cur_off + i] = (p >> 8) ^ t[(p & 0xFFU).to_int()]
      i = i + 1
    }
    k = k + 1
  }
  t
}

///|
let crc32_table16 : FixedArray[UInt] = build_crc32_table16()

///| Incrementally update IEEE CRC-32 over `data[start..end]` using single-table Slice-by-16.
pub fn crc32_update_slice(crc : UInt, data : Bytes, start : Int, end : Int) -> UInt {
  let s = if start < 0 { 0 } else { start }
  let e = if end > data.length() { data.length() } else { end }
  if s >= e {
    return crc
  }
  let tbl = crc32_table16
  let mut c : UInt = crc ^ 0xFFFFFFFFU
  let mut i = s
  let limit16 = e - 16
  while i <= limit16 {
    let x0 = (c & 0xFFU).to_int() ^ data[i].to_int()
    let x1 = ((c >> 8) & 0xFFU).to_int() ^ data[i + 1].to_int()
    let x2 = ((c >> 16) & 0xFFU).to_int() ^ data[i + 2].to_int()
    let x3 = ((c >> 24) & 0xFFU).to_int() ^ data[i + 3].to_int()
    let a = tbl[3840 + x0] ^ tbl[3584 + x1] ^ tbl[3328 + x2] ^ tbl[3072 + x3]
    let b = tbl[2816 + data[i + 4].to_int()] ^
    tbl[2560 + data[i + 5].to_int()] ^
    tbl[2304 + data[i + 6].to_int()] ^
    tbl[2048 + data[i + 7].to_int()]
    let d = tbl[1792 + data[i + 8].to_int()] ^
    tbl[1536 + data[i + 9].to_int()] ^
    tbl[1280 + data[i + 10].to_int()] ^
    tbl[1024 + data[i + 11].to_int()]
    let f = tbl[768 + data[i + 12].to_int()] ^
    tbl[512 + data[i + 13].to_int()] ^
    tbl[256 + data[i + 14].to_int()] ^
    tbl[data[i + 15].to_int()]
    c = (a ^ b) ^ (d ^ f)
    i = i + 16
  }
  while i < e {
    let idx = (c & 0xFFU).to_int() ^ data[i].to_int()
    c = (c >> 8) ^ tbl[idx]
    i = i + 1
  }
  c ^ 0xFFFFFFFFU
}

///| Incrementally update IEEE CRC-32 with `data`.
pub fn crc32_update(crc : UInt, data : Bytes) -> UInt {
  crc32_update_slice(crc, data, 0, data.length())
}

///| Compute IEEE CRC-32 of `data`.
pub fn crc32(data : Bytes) -> UInt {
  crc32_update_slice(0U, data, 0, data.length())
}

///| Streaming IEEE CRC-32 hasher.
pub struct Crc32 {
  mut state : UInt
}

///|
pub fn Crc32::new() -> Crc32 {
  Crc32::{ state: 0U }
}

///|
pub fn Crc32::update(self : Crc32, data : Bytes) -> Unit {
  self.state = crc32_update(self.state, data)
}

///|
pub fn Crc32::finalize(self : Crc32) -> UInt {
  self.state
}

///|
pub fn Crc32::reset(self : Crc32) -> Unit {
  self.state = 0U
}

///| Pack Adler-32 `(s1, s2)` (`0 <= s1, s2 < 65521`) into a 32-bit unsigned checksum `(s2 << 16) | s1`.
#verify
pub fn adler32_pack(s1 : UInt, s2 : UInt) -> UInt {
  (s2 << 16) | s1
}

///| Incrementally update Adler-32 over `data[start..end]` with NMAX=5552 deferred modulo.
pub fn adler32_update_slice(adler : UInt, data : Bytes, start : Int, end : Int) -> UInt {
  let s = if start < 0 { 0 } else { start }
  let e = if end > data.length() { data.length() } else { end }
  if s >= e {
    return adler
  }
  let mut s1 : UInt = adler & 0xFFFFU
  let mut s2 : UInt = (adler >> 16) & 0xFFFFU
  let mut i = s
  while i < e {
    let rem = e - i
    let chunk = if rem > 5552 { 5552 } else { rem }
    let chunk_end = i + chunk
    let limit8 = chunk_end - 8
    while i <= limit8 {
      let b0 = data[i].to_int()
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      s2 = s2 + (s1 << 2) + (4 * b0 + 3 * b1 + 2 * b2 + b3).to_uint()
      s1 = s1 + (b0 + b1 + b2 + b3).to_uint()
      let b4 = data[i + 4].to_int()
      let b5 = data[i + 5].to_int()
      let b6 = data[i + 6].to_int()
      let b7 = data[i + 7].to_int()
      s2 = s2 + (s1 << 2) + (4 * b4 + 3 * b5 + 2 * b6 + b7).to_uint()
      s1 = s1 + (b4 + b5 + b6 + b7).to_uint()
      i = i + 8
    }
    while i < chunk_end {
      s1 = s1 + data[i].to_int().to_uint()
      s2 = s2 + s1
      i = i + 1
    }
    s1 = s1 % 65521U
    s2 = s2 % 65521U
  }
  adler32_pack(s1, s2)
}

///| Incrementally update Adler-32 with `data`.
pub fn adler32_update(adler : UInt, data : Bytes) -> UInt {
  adler32_update_slice(adler, data, 0, data.length())
}

///| Compute Adler-32 of `data`.
pub fn adler32(data : Bytes) -> UInt {
  adler32_update_slice(1U, data, 0, data.length())
}

///| Streaming Adler-32 hasher.
pub struct Adler32 {
  mut state : UInt
}

///|
pub fn Adler32::new() -> Adler32 {
  Adler32::{ state: 1U }
}

///|
pub fn Adler32::update(self : Adler32, data : Bytes) -> Unit {
  self.state = adler32_update(self.state, data)
}

///|
pub fn Adler32::finalize(self : Adler32) -> UInt {
  self.state
}

///|
pub fn Adler32::reset(self : Adler32) -> Unit {
  self.state = 1U
}
