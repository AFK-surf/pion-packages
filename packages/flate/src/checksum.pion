///| IEEE CRC-32 and Adler-32 checksums (stub for Red phase).

///| Compute IEEE CRC-32 of `data`.
pub fn crc32(data : Bytes) -> UInt {
  let _ = data
  0U
}

///| Incrementally update IEEE CRC-32 with `data`.
pub fn crc32_update(crc : UInt, data : Bytes) -> UInt {
  let _ = (crc, data)
  0U
}

///| Incrementally update IEEE CRC-32 over `data[start..end]`.
pub fn crc32_update_slice(crc : UInt, data : Bytes, start : Int, end : Int) -> UInt {
  let _ = (crc, data, start, end)
  0U
}

///| Streaming IEEE CRC-32 hasher.
pub struct Crc32 {
  mut state : UInt
}

///|
pub fn Crc32::new() -> Crc32 {
  Crc32::{ state: 0U }
}

///|
pub fn Crc32::update(self : Crc32, data : Bytes) -> Unit {
  self.state = crc32_update(self.state, data)
}

///|
pub fn Crc32::finalize(self : Crc32) -> UInt {
  self.state
}

///|
pub fn Crc32::reset(self : Crc32) -> Unit {
  self.state = 0U
}

///| Compute Adler-32 of `data`.
pub fn adler32(data : Bytes) -> UInt {
  let _ = data
  0U
}

///| Incrementally update Adler-32 with `data`.
pub fn adler32_update(adler : UInt, data : Bytes) -> UInt {
  let _ = (adler, data)
  0U
}

///| Incrementally update Adler-32 over `data[start..end]`.
pub fn adler32_update_slice(adler : UInt, data : Bytes, start : Int, end : Int) -> UInt {
  let _ = (adler, data, start, end)
  0U
}

///| Streaming Adler-32 hasher.
pub struct Adler32 {
  mut state : UInt
}

///|
pub fn Adler32::new() -> Adler32 {
  Adler32::{ state: 1U }
}

///|
pub fn Adler32::update(self : Adler32, data : Bytes) -> Unit {
  self.state = adler32_update(self.state, data)
}

///|
pub fn Adler32::finalize(self : Adler32) -> UInt {
  self.state
}

///|
pub fn Adler32::reset(self : Adler32) -> Unit {
  self.state = 1U
}
