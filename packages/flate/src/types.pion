///| Public types, errors, limits, and header metadata for `packages/flate`.
///| Pure Pion implementation of RFC 1951 (DEFLATE), RFC 1950 (zlib), RFC 1952 (gzip),
///| IEEE CRC-32, and Adler-32.

///| Default decompression output limit (256 MiB) to defend against Zip Bombs.
pub let default_max_output_bytes : Int = 268435456

///| Error returned by DEFLATE, zlib, and gzip compression or decompression.
pub enum FlateError {
  UnexpectedEof(String)
  InvalidBlockType(Int)
  InvalidStoredLength(String)
  InvalidHuffmanTree(String)
  InvalidSymbol(Int)
  InvalidDistance(String)
  InvalidHeader(String)
  ChecksumMismatch(String)
  OutputLimitExceeded(Int)
  InvalidLevel(Int)
  UnsupportedFeature(String)
}

///| Human-readable description of a `FlateError`.
pub fn flate_error_message(err : FlateError) -> String {
  match err {
    UnexpectedEof(msg) => "unexpected EOF: " + msg
    InvalidBlockType(bt) => "invalid DEFLATE block type: " + bt.to_string()
    InvalidStoredLength(msg) => "invalid stored block length: " + msg
    InvalidHuffmanTree(msg) => "invalid Huffman tree: " + msg
    InvalidSymbol(sym) => "invalid Huffman symbol: " + sym.to_string()
    InvalidDistance(msg) => "invalid back-reference distance: " + msg
    InvalidHeader(msg) => "invalid header: " + msg
    ChecksumMismatch(msg) => "checksum mismatch: " + msg
    OutputLimitExceeded(limit) =>
    "decompressed output exceeded limit: " + limit.to_string()
    InvalidLevel(lvl) => "invalid compression level (expected 0..9): " + lvl.to_string()
    UnsupportedFeature(msg) => "unsupported feature: " + msg
  }
}

///|
pub fn FlateError::to_string(self : FlateError) -> String {
  flate_error_message(self)
}

///| Decompression resource limits.
pub val struct DecompressLimits {
  pub max_output_bytes : Int
}

///| Default decompression limits (256 MiB).
pub fn DecompressLimits::default() -> DecompressLimits {
  DecompressLimits::{ max_output_bytes: default_max_output_bytes }
}

///| Create custom decompression limits.
pub fn DecompressLimits::new(max_output_bytes : Int) -> DecompressLimits {
  DecompressLimits::{ max_output_bytes: max_output_bytes }
}

///| RFC 1952 GZIP member header metadata.
pub struct GzipHeader {
  pub mtime : UInt
  pub extra_flags : Int
  pub os : Int
  pub extra : Bytes
  pub name : String
  pub comment : String
  pub has_extra : Bool
  pub has_name : Bool
  pub has_comment : Bool
  pub has_hcrc : Bool
}

///| Default minimal GZIP header (mtime=0, os=255 unknown).
pub fn GzipHeader::default() -> GzipHeader {
  GzipHeader::{
    mtime: 0U,
    extra_flags: 0,
    os: 255,
    extra: Bytes::new(0),
    name: "",
    comment: "",
    has_extra: false,
    has_name: false,
    has_comment: false,
    has_hcrc: false,
  }
}

///| Create a GZIP header with the `FNAME` field populated.
pub fn GzipHeader::with_name(name : String) -> GzipHeader {
  GzipHeader::{
    mtime: 0U,
    extra_flags: 0,
    os: 255,
    extra: Bytes::new(0),
    name: name,
    comment: "",
    has_extra: false,
    has_name: true,
    has_comment: false,
    has_hcrc: false,
  }
}

///| Result of full GZIP decoding, including first member header and member count.
pub struct GzipDecoded {
  pub data : Bytes
  pub header : GzipHeader
  pub member_count : Int
}
