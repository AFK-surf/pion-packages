///| RFC 1950 zlib framing (stub for Red phase).

///| Compress `data` into an RFC 1950 zlib stream at `level` (0..9).
pub fn zlib_compress(data : Bytes, level : Int) -> Result[Bytes, FlateError] {
  let _ = (data, level)
  Err(FlateError::UnsupportedFeature("not implemented"))
}

///| Compress `data` into an RFC 1950 zlib stream at default level 6.
pub fn zlib_compress_default(data : Bytes) -> Bytes {
  match zlib_compress(data, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///| Decompress an RFC 1950 zlib stream using default output limit (256 MiB).
pub fn zlib_decompress(data : Bytes) -> Result[Bytes, FlateError] {
  zlib_decompress_with_limit(data, default_max_output_bytes)
}

///| Decompress an RFC 1950 zlib stream enforcing `max_output_bytes`.
pub fn zlib_decompress_with_limit(
  data : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  let _ = (data, max_output_bytes)
  Err(FlateError::UnsupportedFeature("not implemented"))
}

///| Decompress an RFC 1950 zlib stream with a preset dictionary, enforcing `max_output_bytes`.
pub fn zlib_decompress_with_dict(
  data : Bytes,
  dict : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  let _ = (data, dict, max_output_bytes)
  Err(FlateError::UnsupportedFeature("not implemented"))
}
