///| RFC 1950 zlib compression and decompression with FCHECK, FDICT, and Adler-32 validation.

///| Map compression level `0..9` to RFC 1950 zlib 2-bit `FLEVEL` (`0..3`).
#verify
pub fn zlib_flevel(level : Int) -> Int {
  if level <= 1 {
    0
  } else if level <= 5 {
    1
  } else if level == 6 {
    2
  } else {
    3
  }
}

///| Compute RFC 1950 zlib `FLG` byte from `cmf` and `flevel` (`0..3`) with `FDICT=0` and exact `FCHECK`.
#verify
pub fn zlib_compute_flg(cmf : Int, flevel : Int) -> Int {
  let base_flg = flevel << 6
  let rem = (cmf * 256 + base_flg) % 31
  base_flg + (if rem == 0 { 0 } else { 31 - rem })
}

///| Validate RFC 1950 zlib header `(cmf, flg)`:
///| `0` = valid, `1` = FCHECK failed, `2` = CM != 8, `3` = CINFO > 7.
#verify
pub fn zlib_check_header(cmf : Int, flg : Int) -> Int {
  if (cmf * 256 + flg) % 31 != 0 {
    return 1
  }
  let cm = cmf & 0x0F
  let cinfo = (cmf >> 4) & 0x0F
  if cm != 8 {
    return 2
  }
  if cinfo > 7 {
    return 3
  }
  0
}

///| Compress `data` into an RFC 1950 zlib stream at `level` (0..9) using this reusable context.
pub fn DeflateContext::zlib_compress(
  self : DeflateContext,
  data : Bytes,
  level : Int,
) -> Result[Bytes, FlateError] {
  if !is_valid_level(level) {
    return Err(FlateError::InvalidLevel(level))
  }
  let raw = match self.deflate_compress(data, level) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let cmf = 0x78 // CM=8 (DEFLATE), CINFO=7 (32K window)
  let flevel = zlib_flevel(level)
  let flg = zlib_compute_flg(cmf, flevel)
  let check = adler32(data)

  let mut hdr = Bytes::new(2)
  hdr[0] = cmf.to_byte()
  hdr[1] = flg.to_byte()
  let mut trailer = Bytes::new(4)
  trailer[0] = ((check >> 24) & 0xFFU).to_int().to_byte()
  trailer[1] = ((check >> 16) & 0xFFU).to_int().to_byte()
  trailer[2] = ((check >> 8) & 0xFFU).to_int().to_byte()
  trailer[3] = (check & 0xFFU).to_int().to_byte()
  Ok(hdr.concat(raw).concat(trailer))
}

///| Compress `data` into an RFC 1950 zlib stream at `level` (0..9).
pub fn zlib_compress(data : Bytes, level : Int) -> Result[Bytes, FlateError] {
  let ctx = DeflateContext::new()
  ctx.zlib_compress(data, level)
}

///| Compress `data` into an RFC 1950 zlib stream at default level 6.
pub fn zlib_compress_default(data : Bytes) -> Bytes {
  match zlib_compress(data, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///| Decompress an RFC 1950 zlib stream using this reusable context and default limit (256 MiB).
pub fn InflateContext::zlib_decompress(
  self : InflateContext,
  data : Bytes,
) -> Result[Bytes, FlateError] {
  self.zlib_decompress_with_limit(data, default_max_output_bytes)
}

///| Decompress an RFC 1950 zlib stream using this reusable context, enforcing `max_output_bytes` (`0` = unlimited).
pub fn InflateContext::zlib_decompress_with_limit(
  self : InflateContext,
  data : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  zlib_decompress_internal(self, data, false, empty_bytes, max_output_bytes)
}

///| Decompress an RFC 1950 zlib stream with a preset dictionary using this reusable context.
pub fn InflateContext::zlib_decompress_with_dict(
  self : InflateContext,
  data : Bytes,
  dict : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  zlib_decompress_internal(self, data, true, dict, max_output_bytes)
}

///| Decompress an RFC 1950 zlib stream using default output limit (256 MiB).
pub fn zlib_decompress(data : Bytes) -> Result[Bytes, FlateError] {
  zlib_decompress_with_limit(data, default_max_output_bytes)
}

///| Decompress an RFC 1950 zlib stream enforcing `max_output_bytes` (`0` means unlimited).
pub fn zlib_decompress_with_limit(
  data : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  let ctx = InflateContext::new()
  zlib_decompress_internal(ctx, data, false, empty_bytes, max_output_bytes)
}

///| Decompress an RFC 1950 zlib stream with a preset dictionary, enforcing `max_output_bytes` (`0` means unlimited).
pub fn zlib_decompress_with_dict(
  data : Bytes,
  dict : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  let ctx = InflateContext::new()
  zlib_decompress_internal(ctx, data, true, dict, max_output_bytes)
}

///|
fn zlib_decompress_internal(
  ctx : InflateContext,
  data : Bytes,
  has_dict : Bool,
  dict : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  if max_output_bytes < 0 {
    return Err(FlateError::OutputLimitExceeded(max_output_bytes))
  }
  let eff_limit = if max_output_bytes == 0 { 2147483647 } else { max_output_bytes }
  let n = data.length()
  if n < 6 {
    return Err(FlateError::UnexpectedEof("zlib stream shorter than 6 bytes"))
  }
  let cmf = data[0].to_int()
  let flg = data[1].to_int()
  let hdr_rc = zlib_check_header(cmf, flg)
  if hdr_rc == 1 {
    return Err(FlateError::InvalidHeader("zlib FCHECK failed"))
  }
  if hdr_rc == 2 {
    return Err(FlateError::InvalidHeader("unsupported zlib compression method"))
  }
  if hdr_rc == 3 {
    return Err(FlateError::InvalidHeader("zlib window size > 32 KiB"))
  }
  let fdict = (flg & 0x20) != 0
  let mut pos = 2
  let mut use_dict = empty_bytes
  if fdict {
    if n < 10 {
      return Err(FlateError::UnexpectedEof("truncated zlib DICTID"))
    }
    if !has_dict {
      return Err(FlateError::InvalidHeader("zlib stream requires preset dictionary"))
    }
    let expected_dict_id = (data[2].to_int().to_uint() << 24) |
    (data[3].to_int().to_uint() << 16) |
    (data[4].to_int().to_uint() << 8) |
    data[5].to_int().to_uint()
    let actual_dict_id = adler32(dict)
    if expected_dict_id != actual_dict_id {
      return Err(FlateError::ChecksumMismatch("zlib preset dictionary Adler-32 mismatch"))
    }
    pos = 6
    use_dict = dict
  }

  let (out, end_pos) = match inflate_raw_into(data, pos, eff_limit, use_dict, ctx, -1) {
    Ok(pair) => pair
    Err(e) => return Err(e)
  }

  if end_pos + 4 > n {
    return Err(FlateError::UnexpectedEof("truncated zlib Adler-32 trailer"))
  }
  let expected_adler = (data[end_pos].to_int().to_uint() << 24) |
  (data[end_pos + 1].to_int().to_uint() << 16) |
  (data[end_pos + 2].to_int().to_uint() << 8) |
  data[end_pos + 3].to_int().to_uint()
  let actual_adler = adler32(out)
  if expected_adler != actual_adler {
    return Err(FlateError::ChecksumMismatch("zlib Adler-32 checksum mismatch"))
  }
  Ok(out)
}
