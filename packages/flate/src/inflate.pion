///| High-performance RFC 1951 raw DEFLATE decompressor.
///| Uses a 64-bit bit buffer, 10-bit primary + secondary packed Huffman LUTs,
///| zero-loop Stored block slicing (`Bytes::slice` / `Bytes::concat`),
///| fast RLE (`dist == 1`) and 8-byte unrolled back-reference copies,
///| preset dictionary support (for zlib FDICT), and strict `max_output_bytes` Zip Bomb guard.

///| RFC 1951 §3.2.3: valid DEFLATE block types are `0` (stored), `1` (fixed), `2` (dynamic); `3` is reserved.
#verify
pub fn is_valid_btype(btype : Int) -> Bool {
  btype >= 0 && btype <= 2
}

///| RFC 1951 §3.2.4: stored block `NLEN` must be the exact 16-bit one's complement of `LEN`.
#verify
pub fn is_valid_stored_nlen(slen : Int, nlen : Int) -> Bool {
  (slen ^ nlen) == 0xFFFF
}

///| Reusable scratch tables for Dynamic Huffman decoding (allocated lazily on first `btype == 2`).
struct InflateScratch {
  mut initialized : Bool
  mut dyn_litlen_lut : FixedArray[Int]
  mut dyn_dist_lut : FixedArray[Int]
  mut cl_lut : FixedArray[Int]
  mut cl_lens : FixedArray[Int]
  mut code_lens : FixedArray[Int]
  mut litlen_lens : FixedArray[Int]
  mut dist_lens : FixedArray[Int]
}

///|
fn InflateScratch::new() -> InflateScratch {
  let empty : FixedArray[Int] = FixedArray::make(0, 0)
  InflateScratch::{
    initialized: false,
    dyn_litlen_lut: empty,
    dyn_dist_lut: empty,
    cl_lut: empty,
    cl_lens: empty,
    code_lens: empty,
    litlen_lens: empty,
    dist_lens: empty,
  }
}

///|
fn ensure_inflate_scratch(s : InflateScratch) -> Unit {
  if !s.initialized {
    s.dyn_litlen_lut = FixedArray::make(2048, 0)
    s.dyn_dist_lut = FixedArray::make(1024, 0)
    s.cl_lut = FixedArray::make(128, 0)
    s.cl_lens = FixedArray::make(19, 0)
    s.code_lens = FixedArray::make(320, 0)
    s.litlen_lens = FixedArray::make(288, 0)
    s.dist_lens = FixedArray::make(32, 0)
    s.initialized = true
  }
}

///| Grow `buf` to at least `needed` bytes (clamped to `max_cap`), copying `used` bytes.
fn grow_bytes(buf : Bytes, used : Int, needed : Int, max_cap : Int, init_hint : Int) -> Bytes {
  let mut new_cap = buf.length()
  if new_cap == 0 {
    new_cap = init_hint
    if new_cap < 256 {
      new_cap = 256
    }
    if new_cap > max_cap {
      new_cap = max_cap
    }
  }
  while new_cap < needed {
    if new_cap > max_cap / 2 {
      new_cap = max_cap
      break
    }
    new_cap = new_cap * 2
  }
  if new_cap < needed {
    new_cap = needed
  }
  if used == 0 {
    return Bytes::new(new_cap)
  }
  // Use native memcpy via Bytes::concat for buffers <= 32 MiB; avoid 2x+ padding peak on giant bombs.
  if new_cap <= 33554432 {
    let pad = Bytes::new(new_cap - used)
    if used == buf.length() {
      return buf.concat(pad)
    }
    return buf.slice(0, used).concat(pad)
  }
  let mut next = Bytes::new(new_cap)
  let mut i = 0
  let lim8 = used - 8
  while i <= lim8 {
    next[i] = buf[i]
    next[i + 1] = buf[i + 1]
    next[i + 2] = buf[i + 2]
    next[i + 3] = buf[i + 3]
    next[i + 4] = buf[i + 4]
    next[i + 5] = buf[i + 5]
    next[i + 6] = buf[i + 6]
    next[i + 7] = buf[i + 7]
    i = i + 8
  }
  while i < used {
    next[i] = buf[i]
    i = i + 1
  }
  next
}

///| Core RFC 1951 Inflate engine starting at `data[start..]`.
///| `max_output_bytes` is an exact non-negative limit (0 means at most 0 output bytes).
///| Returns `(decompressed_bytes, next_byte_offset_in_data)`.
fn inflate_raw_into(
  data : Bytes,
  start : Int,
  max_output_bytes : Int,
  dict : Bytes,
  scratch : InflateScratch,
  hint_cap : Int,
) -> Result[(Bytes, Int), FlateError] {
  if max_output_bytes < 0 {
    return Err(FlateError::OutputLimitExceeded(max_output_bytes))
  }
  let in_len = data.length()
  let mut in_pos = start
  let mut bitbuf : UInt64 = 0UL
  let mut bitcnt = 0

  let rem_in = in_len - start
  let mut init_hint = if hint_cap >= 0 {
    hint_cap
  } else {
    let h = rem_in * 4
    if h < 256 { 256 } else if h > 65536 { 65536 } else { h }
  }
  if init_hint > max_output_bytes {
    init_hint = max_output_bytes
  }

  let mut out = Bytes::new(0)
  let mut out_len = 0
  let mut out_cap = 0
  let mut safe_end = 0

  let stored_chunks : Array[Bytes] = []
  let mut stored_total = 0

  let dict_len = dict.length()
  let clo = cl_order
  let flit = fixed_litlen_lut
  let fdist = fixed_dist_lut
  let masks = bit_masks

  let mut bfinal = 0
  while bfinal == 0 {
    // Refill for 3-bit block header
    while bitcnt < 3 && in_pos < in_len {
      bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
      in_pos = in_pos + 1
      bitcnt = bitcnt + 8
    }
    if bitcnt < 3 {
      return Err(FlateError::UnexpectedEof("missing DEFLATE block header"))
    }
    bfinal = (bitbuf & 1UL).to_int()
    let btype = ((bitbuf >> 1) & 3UL).to_int()
    bitbuf = bitbuf >> 3
    bitcnt = bitcnt - 3

    if !is_valid_btype(btype) {
      return Err(FlateError::InvalidBlockType(btype))
    }

    if btype == 0 {
      // Stored block: discard remaining bits in current byte, rewind whole bytes
      let drop = bitcnt & 7
      bitbuf = bitbuf >> drop
      bitcnt = bitcnt - drop
      in_pos = in_pos - (bitcnt >> 3)
      bitbuf = 0UL
      bitcnt = 0
      if in_pos + 4 > in_len {
        return Err(FlateError::UnexpectedEof("truncated stored block header"))
      }
      let slen = data[in_pos].to_int() | (data[in_pos + 1].to_int() << 8)
      let nlen = data[in_pos + 2].to_int() | (data[in_pos + 3].to_int() << 8)
      in_pos = in_pos + 4
      if !is_valid_stored_nlen(slen, nlen) {
        return Err(FlateError::InvalidStoredLength("NLEN != ~LEN"))
      }
      if in_pos + slen > in_len {
        return Err(FlateError::UnexpectedEof("truncated stored block payload"))
      }
      if slen == 0 {
        continue
      }
      if out_len == 0 {
        if slen > max_output_bytes - stored_total {
          return Err(FlateError::OutputLimitExceeded(max_output_bytes))
        }
        if stored_total == 0 && bfinal == 1 {
          return Ok((data.slice(in_pos, in_pos + slen), in_pos + slen))
        }
        stored_chunks.push(data.slice(in_pos, in_pos + slen))
        stored_total = stored_total + slen
        in_pos = in_pos + slen
        continue
      }
      if slen > max_output_bytes - out_len {
        return Err(FlateError::OutputLimitExceeded(max_output_bytes))
      }
      if out_len + slen > out_cap {
        out = grow_bytes(out, out_len, out_len + slen, max_output_bytes, init_hint)
        out_cap = out.length()
        safe_end = if out_cap < max_output_bytes { out_cap } else { max_output_bytes }
      }
      let mut k = 0
      let lim8 = slen - 8
      while k <= lim8 {
        out[out_len + k] = data[in_pos + k]
        out[out_len + k + 1] = data[in_pos + k + 1]
        out[out_len + k + 2] = data[in_pos + k + 2]
        out[out_len + k + 3] = data[in_pos + k + 3]
        out[out_len + k + 4] = data[in_pos + k + 4]
        out[out_len + k + 5] = data[in_pos + k + 5]
        out[out_len + k + 6] = data[in_pos + k + 6]
        out[out_len + k + 7] = data[in_pos + k + 7]
        k = k + 8
      }
      while k < slen {
        out[out_len + k] = data[in_pos + k]
        k = k + 1
      }
      in_pos = in_pos + slen
      out_len = out_len + slen
      continue
    }

    // Materialize any preceding stored blocks before Huffman decoding
    if stored_total > 0 {
      out = concat_bytes_chunks(stored_chunks)
      out_len = stored_total
      out_cap = out.length()
      safe_end = if out_cap < max_output_bytes { out_cap } else { max_output_bytes }
      stored_total = 0
    }

    let mut cur_litlen = flit
    let mut cur_dist = fdist
    let mut dist_mask : UInt64 = 31UL

    if btype == 2 {
      ensure_inflate_scratch(scratch)
      let cl_lut = scratch.cl_lut
      let cl_lens = scratch.cl_lens
      let code_lens = scratch.code_lens
      let litlen_lens = scratch.litlen_lens
      let dist_lens = scratch.dist_lens
      let dyn_litlen_lut = scratch.dyn_litlen_lut
      let dyn_dist_lut = scratch.dyn_dist_lut

      // Dynamic Huffman block header: HLIT (5b), HDIST (5b), HCLEN (4b) = 14 bits
      while bitcnt < 14 && in_pos < in_len {
        bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
        in_pos = in_pos + 1
        bitcnt = bitcnt + 8
      }
      if bitcnt < 14 {
        return Err(FlateError::UnexpectedEof("truncated dynamic block header"))
      }
      let hlit = (bitbuf & 31UL).to_int() + 257
      let hdist = ((bitbuf >> 5) & 31UL).to_int() + 1
      let hclen = ((bitbuf >> 10) & 15UL).to_int() + 4
      bitbuf = bitbuf >> 14
      bitcnt = bitcnt - 14
      if hlit > 286 || hdist > 30 {
        return Err(FlateError::InvalidHuffmanTree("HLIT > 286 or HDIST > 30"))
      }
      let mut ci = 0
      while ci < 19 {
        cl_lens[ci] = 0
        ci = ci + 1
      }
      ci = 0
      while ci < hclen {
        while bitcnt < 3 && in_pos < in_len {
          bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
          in_pos = in_pos + 1
          bitcnt = bitcnt + 8
        }
        if bitcnt < 3 {
          return Err(FlateError::UnexpectedEof("truncated code-length table"))
        }
        cl_lens[clo[ci]] = (bitbuf & 7UL).to_int()
        bitbuf = bitbuf >> 3
        bitcnt = bitcnt - 3
        ci = ci + 1
      }
      match build_inflate_table(cl_lens, 19, cl_lut, 7, false) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }

      // Decode hlit + hdist code lengths
      let total_codes = hlit + hdist
      let mut idx = 0
      while idx < total_codes {
        while bitcnt < 15 && in_pos < in_len {
          bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
          in_pos = in_pos + 1
          bitcnt = bitcnt + 8
        }
        let ent = cl_lut[(bitbuf & 127UL).to_int()]
        let nb = ent & 15
        if nb == 0 {
          return Err(FlateError::InvalidHuffmanTree("invalid code-length symbol"))
        }
        if bitcnt < nb {
          return Err(FlateError::UnexpectedEof("truncated code-length symbol"))
        }
        let csym = ent >> 5
        bitbuf = bitbuf >> nb
        bitcnt = bitcnt - nb
        if csym < 16 {
          code_lens[idx] = csym
          idx = idx + 1
        } else {
          let mut rep_val = 0
          let mut rep_cnt = 0
          if csym == 16 {
            if idx == 0 {
              return Err(FlateError::InvalidHuffmanTree("repeat code 16 with no previous length"))
            }
            if bitcnt < 2 {
              while bitcnt < 2 && in_pos < in_len {
                bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
                in_pos = in_pos + 1
                bitcnt = bitcnt + 8
              }
              if bitcnt < 2 {
                return Err(FlateError::UnexpectedEof("truncated repeat-16 extra bits"))
              }
            }
            rep_val = code_lens[idx - 1]
            rep_cnt = 3 + (bitbuf & 3UL).to_int()
            bitbuf = bitbuf >> 2
            bitcnt = bitcnt - 2
          } else if csym == 17 {
            if bitcnt < 3 {
              while bitcnt < 3 && in_pos < in_len {
                bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
                in_pos = in_pos + 1
                bitcnt = bitcnt + 8
              }
              if bitcnt < 3 {
                return Err(FlateError::UnexpectedEof("truncated repeat-17 extra bits"))
              }
            }
            rep_val = 0
            rep_cnt = 3 + (bitbuf & 7UL).to_int()
            bitbuf = bitbuf >> 3
            bitcnt = bitcnt - 3
          } else {
            if bitcnt < 7 {
              while bitcnt < 7 && in_pos < in_len {
                bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
                in_pos = in_pos + 1
                bitcnt = bitcnt + 8
              }
              if bitcnt < 7 {
                return Err(FlateError::UnexpectedEof("truncated repeat-18 extra bits"))
              }
            }
            rep_val = 0
            rep_cnt = 11 + (bitbuf & 127UL).to_int()
            bitbuf = bitbuf >> 7
            bitcnt = bitcnt - 7
          }
          if idx + rep_cnt > total_codes {
            return Err(FlateError::InvalidHuffmanTree("code-length repeat exceeds HLIT+HDIST"))
          }
          let mut r = 0
          while r < rep_cnt {
            code_lens[idx] = rep_val
            idx = idx + 1
            r = r + 1
          }
        }
      }

      if code_lens[256] == 0 {
        return Err(FlateError::InvalidHuffmanTree("missing EOB symbol 256"))
      }
      let mut li = 0
      while li < hlit {
        litlen_lens[li] = code_lens[li]
        li = li + 1
      }
      while li < 288 {
        litlen_lens[li] = 0
        li = li + 1
      }
      let mut di = 0
      while di < hdist {
        dist_lens[di] = code_lens[hlit + di]
        di = di + 1
      }
      while di < 32 {
        dist_lens[di] = 0
        di = di + 1
      }

      match build_litlen_inflate_table(litlen_lens, hlit, dyn_litlen_lut, litlen_root_bits) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match build_dist_inflate_table(dist_lens, hdist, dyn_dist_lut, dist_root_bits, true) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      cur_litlen = dyn_litlen_lut
      cur_dist = dyn_dist_lut
      dist_mask = dist_root_mask
    }

    // Main Huffman decode hot loop for this block
    while true {
      // Fast 32-bit refill when >= 4 input bytes remain
      if bitcnt <= 32 && in_pos + 4 <= in_len {
        let w = data[in_pos].to_int().to_int64().to_uint64() |
        (data[in_pos + 1].to_int().to_int64().to_uint64() << 8) |
        (data[in_pos + 2].to_int().to_int64().to_uint64() << 16) |
        (data[in_pos + 3].to_int().to_int64().to_uint64() << 24)
        bitbuf = bitbuf | (w << bitcnt)
        in_pos = in_pos + 4
        bitcnt = bitcnt + 32
      } else {
        while bitcnt <= 56 && in_pos < in_len {
          bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
          in_pos = in_pos + 1
          bitcnt = bitcnt + 8
        }
      }

      // Decode literal/length symbol via packed 10-bit primary + secondary LUT
      let mut ent = cur_litlen[(bitbuf & litlen_root_mask).to_int()]
      // Ultra-fast direct literal path (handles up to 3 literals per refill)
      if (ent & 48) == 32 {
        let nb = ent & 15
        if bitcnt < nb {
          return Err(FlateError::UnexpectedEof("truncated litlen code"))
        }
        bitbuf = bitbuf >> nb
        bitcnt = bitcnt - nb
        if out_len >= safe_end {
          if out_len >= max_output_bytes {
            return Err(FlateError::OutputLimitExceeded(max_output_bytes))
          }
          out = grow_bytes(out, out_len, out_len + 1, max_output_bytes, init_hint)
          out_cap = out.length()
          safe_end = if out_cap < max_output_bytes { out_cap } else { max_output_bytes }
        }
        out[out_len] = (ent >> 8).to_byte()
        out_len = out_len + 1

        // Opportunistic 2nd & 3rd direct literals while bitbuf has >= 16 bits and room remains
        if bitcnt >= 16 && out_len < safe_end {
          let ent2 = cur_litlen[(bitbuf & litlen_root_mask).to_int()]
          if (ent2 & 48) == 32 {
            let nb2 = ent2 & 15
            bitbuf = bitbuf >> nb2
            bitcnt = bitcnt - nb2
            out[out_len] = (ent2 >> 8).to_byte()
            out_len = out_len + 1
            if bitcnt >= 16 && out_len < safe_end {
              let ent3 = cur_litlen[(bitbuf & litlen_root_mask).to_int()]
              if (ent3 & 48) == 32 {
                let nb3 = ent3 & 15
                bitbuf = bitbuf >> nb3
                bitcnt = bitcnt - nb3
                out[out_len] = (ent3 >> 8).to_byte()
                out_len = out_len + 1
              }
            }
          }
        }
        continue
      }

      if (ent & 16) != 0 {
        // Subtable lookup (code length > 10)
        if bitcnt < 10 {
          return Err(FlateError::UnexpectedEof("truncated litlen subtable prefix"))
        }
        let sub_bits = ent & 15
        let sub_off = ent >> 5
        let sub_ent = cur_litlen[sub_off + ((bitbuf >> 10) & masks[sub_bits]).to_int()]
        let sub_nb = sub_ent & 15
        if sub_nb == 0 {
          return Err(FlateError::InvalidHuffmanTree("invalid litlen subtable code"))
        }
        let total_nb = 10 + sub_nb
        if bitcnt < total_nb {
          return Err(FlateError::UnexpectedEof("truncated litlen subtable code"))
        }
        bitbuf = bitbuf >> total_nb
        bitcnt = bitcnt - total_nb
        ent = sub_ent
        if (ent & 32) != 0 {
          if out_len >= safe_end {
            if out_len >= max_output_bytes {
              return Err(FlateError::OutputLimitExceeded(max_output_bytes))
            }
            out = grow_bytes(out, out_len, out_len + 1, max_output_bytes, init_hint)
            out_cap = out.length()
            safe_end = if out_cap < max_output_bytes { out_cap } else { max_output_bytes }
          }
          out[out_len] = (ent >> 8).to_byte()
          out_len = out_len + 1
          continue
        }
      } else {
        let nb = ent & 15
        if nb == 0 {
          return Err(FlateError::InvalidHuffmanTree("invalid litlen code"))
        }
        if bitcnt < nb {
          return Err(FlateError::UnexpectedEof("truncated litlen code"))
        }
        bitbuf = bitbuf >> nb
        bitcnt = bitcnt - nb
      }

      // EOB (sym 256)
      if (ent & 64) != 0 {
        break
      }

      // Invalid symbol (286..287)
      if (ent & 128) == 0 {
        return Err(FlateError::InvalidSymbol(ent >> 9))
      }

      // Packed length: lbase + lextra extra bits
      let lextra = (ent >> 8) & 15
      let mut match_len = ent >> 12
      if lextra > 0 {
        if bitcnt < lextra {
          return Err(FlateError::UnexpectedEof("truncated length extra bits"))
        }
        match_len = match_len + (bitbuf & masks[lextra]).to_int()
        bitbuf = bitbuf >> lextra
        bitcnt = bitcnt - lextra
      }

      // Refill before distance symbol + up to 13 extra bits (max 28 bits needed)
      if bitcnt < 28 {
        if bitcnt <= 32 && in_pos + 4 <= in_len {
          let w = data[in_pos].to_int().to_int64().to_uint64() |
          (data[in_pos + 1].to_int().to_int64().to_uint64() << 8) |
          (data[in_pos + 2].to_int().to_int64().to_uint64() << 16) |
          (data[in_pos + 3].to_int().to_int64().to_uint64() << 24)
          bitbuf = bitbuf | (w << bitcnt)
          in_pos = in_pos + 4
          bitcnt = bitcnt + 32
        } else {
          while bitcnt <= 56 && in_pos < in_len {
            bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
            in_pos = in_pos + 1
            bitcnt = bitcnt + 8
          }
        }
      }

      // Decode packed distance symbol
      let mut dent = cur_dist[(bitbuf & dist_mask).to_int()]
      if (dent & 48) == 32 {
        let dnb = dent & 15
        if bitcnt < dnb {
          return Err(FlateError::UnexpectedEof("truncated distance code"))
        }
        bitbuf = bitbuf >> dnb
        bitcnt = bitcnt - dnb
      } else if (dent & 16) != 0 {
        if bitcnt < 9 {
          return Err(FlateError::UnexpectedEof("truncated distance subtable prefix"))
        }
        let sub_bits = dent & 15
        let sub_off = dent >> 5
        let sub_ent = cur_dist[sub_off + ((bitbuf >> 9) & masks[sub_bits]).to_int()]
        let sub_nb = sub_ent & 15
        if sub_nb == 0 {
          return Err(FlateError::InvalidHuffmanTree("invalid distance subtable code"))
        }
        let total_nb = 9 + sub_nb
        if bitcnt < total_nb {
          return Err(FlateError::UnexpectedEof("truncated distance subtable code"))
        }
        bitbuf = bitbuf >> total_nb
        bitcnt = bitcnt - total_nb
        dent = sub_ent
        if (dent & 32) == 0 {
          return Err(FlateError::InvalidSymbol(dent >> 7))
        }
      } else {
        let dnb = dent & 15
        if dnb == 0 {
          return Err(FlateError::InvalidHuffmanTree("invalid distance code"))
        }
        if bitcnt < dnb {
          return Err(FlateError::UnexpectedEof("truncated distance code"))
        }
        return Err(FlateError::InvalidSymbol(dent >> 7))
      }

      let dextra = (dent >> 6) & 15
      let mut dist = dent >> 10
      if dextra > 0 {
        if bitcnt < dextra {
          return Err(FlateError::UnexpectedEof("truncated distance extra bits"))
        }
        dist = dist + (bitbuf & masks[dextra]).to_int()
        bitbuf = bitbuf >> dextra
        bitcnt = bitcnt - dextra
      }

      if dist <= 0 || dist > out_len + dict_len {
        return Err(FlateError::InvalidDistance("distance exceeds available history"))
      }

      if match_len > max_output_bytes - out_len {
        return Err(FlateError::OutputLimitExceeded(max_output_bytes))
      }
      if out_len + match_len > out_cap {
        out = grow_bytes(out, out_len, out_len + match_len, max_output_bytes, init_hint)
        out_cap = out.length()
        safe_end = if out_cap < max_output_bytes { out_cap } else { max_output_bytes }
      }

      if dist > out_len {
        // Preset dictionary copy (crosses from dict tail into out)
        let mut rem = match_len
        let cur_dist_pos = dist
        while rem > 0 {
          if cur_dist_pos > out_len {
            let d_off = dict_len - (cur_dist_pos - out_len)
            out[out_len] = dict[d_off]
          } else {
            out[out_len] = out[out_len - cur_dist_pos]
          }
          out_len = out_len + 1
          rem = rem - 1
        }
      } else if dist == 1 {
        // Fast RLE memset fill
        let fill = out[out_len - 1]
        let mut k = 0
        let lim8 = match_len - 8
        while k <= lim8 {
          out[out_len + k] = fill
          out[out_len + k + 1] = fill
          out[out_len + k + 2] = fill
          out[out_len + k + 3] = fill
          out[out_len + k + 4] = fill
          out[out_len + k + 5] = fill
          out[out_len + k + 6] = fill
          out[out_len + k + 7] = fill
          k = k + 8
        }
        while k < match_len {
          out[out_len + k] = fill
          k = k + 1
        }
        out_len = out_len + match_len
      } else if dist >= 8 {
        // Non-overlapping 8-byte unrolled copy
        let src_start = out_len - dist
        let mut k = 0
        let lim8 = match_len - 8
        while k <= lim8 {
          out[out_len + k] = out[src_start + k]
          out[out_len + k + 1] = out[src_start + k + 1]
          out[out_len + k + 2] = out[src_start + k + 2]
          out[out_len + k + 3] = out[src_start + k + 3]
          out[out_len + k + 4] = out[src_start + k + 4]
          out[out_len + k + 5] = out[src_start + k + 5]
          out[out_len + k + 6] = out[src_start + k + 6]
          out[out_len + k + 7] = out[src_start + k + 7]
          k = k + 8
        }
        while k < match_len {
          out[out_len + k] = out[src_start + k]
          k = k + 1
        }
        out_len = out_len + match_len
      } else {
        // Overlapping RLE copy (2 <= dist < 8)
        let src_start = out_len - dist
        let mut k = 0
        while k < match_len {
          out[out_len + k] = out[src_start + k]
          k = k + 1
        }
        out_len = out_len + match_len
      }
    }
  }

  // Rewind whole unused bytes left in bitbuf
  let end_pos = in_pos - (bitcnt >> 3)
  if out_len == 0 && stored_total > 0 {
    return Ok((concat_bytes_chunks(stored_chunks), end_pos))
  }
  if out_len == 0 {
    return Ok((Bytes::new(0), end_pos))
  }
  if out_len == out_cap {
    return Ok((out, end_pos))
  }
  Ok((out.slice(0, out_len), end_pos))
}

///| Decompress a raw RFC 1951 DEFLATE stream using default output limit (256 MiB).
pub fn deflate_decompress(data : Bytes) -> Result[Bytes, FlateError] {
  deflate_decompress_with_limit(data, default_max_output_bytes)
}

///| Decompress a raw RFC 1951 DEFLATE stream enforcing `max_output_bytes` (`0` means unlimited).
pub fn deflate_decompress_with_limit(
  data : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  if max_output_bytes < 0 {
    return Err(FlateError::OutputLimitExceeded(max_output_bytes))
  }
  let eff_limit = if max_output_bytes == 0 { 2147483647 } else { max_output_bytes }
  match inflate_raw_into(data, 0, eff_limit, Bytes::new(0), InflateScratch::new(), -1) {
    Ok((out, _)) => Ok(out)
    Err(e) => Err(e)
  }
}
