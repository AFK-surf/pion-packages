///| High-performance RFC 1951 raw DEFLATE decompressor.
///| Uses a 64-bit bit buffer, 10-bit primary + secondary packed Huffman LUTs,
///| split fast/slow Huffman decode loops (immutable `out` in fast loop with zero
///| per-symbol EOF/bounds/Result overhead), zero-loop Stored block slicing
///| (`Bytes::slice` / `Bytes::concat`), fast RLE (`dist == 1`) and 8-byte unrolled
///| back-reference copies, preset dictionary support (for zlib FDICT), and strict
///| `max_output_bytes` Zip Bomb guard.

///| RFC 1951 §3.2.3: valid DEFLATE block types are `0` (stored), `1` (fixed), `2` (dynamic); `3` is reserved.
pub fn is_valid_btype(btype : Int) -> Bool {
  btype >= 0 && btype <= 2
}

///| RFC 1951 §3.2.4: stored block `NLEN` must be the exact 16-bit one's complement of `LEN`.
pub fn is_valid_stored_nlen(slen : Int, nlen : Int) -> Bool {
  (slen ^ nlen) == 0xFFFF
}

///| Reusable scratch tables for Dynamic Huffman decoding (allocated lazily on first `btype == 2`).
struct InflateScratch {
  mut initialized : Bool
  mut dyn_litlen_lut : FixedArray[Int]
  mut dyn_dist_lut : FixedArray[Int]
  mut cl_lut : FixedArray[Int]
  mut cl_lens : FixedArray[Int]
  mut code_lens : FixedArray[Int]
  mut litlen_lens : FixedArray[Int]
  mut dist_lens : FixedArray[Int]
}

///|
fn InflateScratch::new() -> InflateScratch {
  let empty : FixedArray[Int] = FixedArray::make(0, 0)
  InflateScratch::{
    initialized: false,
    dyn_litlen_lut: empty,
    dyn_dist_lut: empty,
    cl_lut: empty,
    cl_lens: empty,
    code_lens: empty,
    litlen_lens: empty,
    dist_lens: empty,
  }
}

///|
fn ensure_inflate_scratch(s : InflateScratch) -> Unit {
  if !s.initialized {
    s.dyn_litlen_lut = FixedArray::make(2048, 0)
    s.dyn_dist_lut = FixedArray::make(1024, 0)
    s.cl_lut = FixedArray::make(128, 0)
    s.cl_lens = FixedArray::make(19, 0)
    s.code_lens = FixedArray::make(320, 0)
    s.litlen_lens = FixedArray::make(288, 0)
    s.dist_lens = FixedArray::make(32, 0)
    s.initialized = true
  }
}

///| Mutable inflate stream state shared across block handlers.
struct InflateState {
  mut in_pos : Int
  mut bitbuf : UInt64
  mut bitcnt : Int
  mut out : Bytes
  mut out_len : Int
  mut out_cap : Int
  mut safe_end : Int
  mut dist_mask : UInt64
  mut err_sym : Int
  dict : Bytes
  dict_len : Int
  max_output_bytes : Int
  init_hint : Int
}

///| Grow `buf` to at least `needed` bytes (clamped to `max_cap`), copying `used` bytes.
fn grow_bytes(buf : Bytes, used : Int, needed : Int, max_cap : Int, init_hint : Int) -> Bytes {
  let mut new_cap = buf.length()
  if new_cap == 0 {
    new_cap = init_hint
    if new_cap < 256 {
      new_cap = 256
    }
    if new_cap > max_cap {
      new_cap = max_cap
    }
  }
  while new_cap < needed {
    if new_cap > max_cap / 2 {
      new_cap = max_cap
      break
    }
    new_cap = new_cap * 2
  }
  if new_cap < needed {
    new_cap = needed
  }
  if used == 0 {
    return Bytes::new(new_cap)
  }
  // Use native memcpy via Bytes::concat for buffers <= 32 MiB; avoid 2x+ padding peak on giant bombs.
  if new_cap <= 33554432 {
    let pad = Bytes::new(new_cap - used)
    if used == buf.length() {
      return buf.concat(pad)
    }
    return buf.slice(0, used).concat(pad)
  }
  let mut next = Bytes::new(new_cap)
  let mut i = 0
  let lim8 = used - 8
  while i <= lim8 {
    next[i] = buf[i]
    next[i + 1] = buf[i + 1]
    next[i + 2] = buf[i + 2]
    next[i + 3] = buf[i + 3]
    next[i + 4] = buf[i + 4]
    next[i + 5] = buf[i + 5]
    next[i + 6] = buf[i + 6]
    next[i + 7] = buf[i + 7]
    i = i + 8
  }
  while i < used {
    next[i] = buf[i]
    i = i + 1
  }
  next
}

///| Ensure `state.out` has room for `extra` bytes beyond `cur_len`, enforcing `max_output_bytes`.
///| Returns `true` on success, `false` if `max_output_bytes` would be exceeded.
fn inflate_ensure_out(
  state : InflateState,
  cur_out : Bytes,
  cur_len : Int,
  extra : Int,
) -> Bool {
  if extra > state.max_output_bytes - cur_len {
    return false
  }
  let next = grow_bytes(
    cur_out,
    cur_len,
    cur_len + extra,
    state.max_output_bytes,
    state.init_hint,
  )
  let cap = next.length()
  state.out = next
  state.out_cap = cap
  state.safe_end = if cap < state.max_output_bytes { cap } else { state.max_output_bytes }
  true
}

///| Cold helper: copy LZ77 match crossing from preset `dict` tail into `out`.
fn inflate_copy_dict(
  out : Bytes,
  start_len : Int,
  dict : Bytes,
  dict_len : Int,
  dist : Int,
  match_len : Int,
) -> Int {
  let mut out_len = start_len
  let mut rem = match_len
  while rem > 0 {
    if dist > out_len {
      let d_off = dict_len - (dist - out_len)
      out[out_len] = dict[d_off]
    } else {
      out[out_len] = out[out_len - dist]
    }
    out_len = out_len + 1
    rem = rem - 1
  }
  out_len
}

///| Leaf helper: non-overlapping 8-byte unrolled LZ77 copy (`dist >= 8`).
fn inflate_copy_dist8(
  out : Bytes,
  out_len : Int,
  dist : Int,
  match_len : Int,
) -> Int {
  let mut d = out_len
  let mut s = out_len - dist
  let end = out_len + match_len
  let end8 = end - 8
  while d <= end8 {
    out[d] = out[s]
    out[d + 1] = out[s + 1]
    out[d + 2] = out[s + 2]
    out[d + 3] = out[s + 3]
    out[d + 4] = out[s + 4]
    out[d + 5] = out[s + 5]
    out[d + 6] = out[s + 6]
    out[d + 7] = out[s + 7]
    d = d + 8
    s = s + 8
  }
  while d < end {
    out[d] = out[s]
    d = d + 1
    s = s + 1
  }
  end
}

///| Leaf helper: 8-byte unrolled RLE fill (`dist == 1`).
fn inflate_fill_rle1(
  out : Bytes,
  out_len : Int,
  match_len : Int,
) -> Int {
  let fill = out[out_len - 1]
  let mut d = out_len
  let end = out_len + match_len
  let end8 = end - 8
  while d <= end8 {
    out[d] = fill
    out[d + 1] = fill
    out[d + 2] = fill
    out[d + 3] = fill
    out[d + 4] = fill
    out[d + 5] = fill
    out[d + 6] = fill
    out[d + 7] = fill
    d = d + 8
  }
  while d < end {
    out[d] = fill
    d = d + 1
  }
  end
}

///| Cold helper: overlapping LZ77 copy (`2 <= dist < 8`).
fn inflate_copy_overlap(
  out : Bytes,
  out_len : Int,
  dist : Int,
  match_len : Int,
) -> Int {
  let src_start = out_len - dist
  let mut k = 0
  while k < match_len {
    out[out_len + k] = out[src_start + k]
    k = k + 1
  }
  out_len + match_len
}

///| Cold helper: decode RFC 1951 §3.2.7 Dynamic Huffman tables into `scratch`.
fn inflate_read_dynamic_trees(
  data : Bytes,
  in_len : Int,
  state : InflateState,
  scratch : InflateScratch,
) -> Result[Unit, FlateError] {
  ensure_inflate_scratch(scratch)
  let cl_lut = scratch.cl_lut
  let cl_lens = scratch.cl_lens
  let code_lens = scratch.code_lens
  let litlen_lens = scratch.litlen_lens
  let dist_lens = scratch.dist_lens
  let dyn_litlen_lut = scratch.dyn_litlen_lut
  let dyn_dist_lut = scratch.dyn_dist_lut
  let clo = cl_order

  let mut in_pos = state.in_pos
  let mut bitbuf = state.bitbuf
  let mut bitcnt = state.bitcnt

  // Dynamic Huffman block header: HLIT (5b), HDIST (5b), HCLEN (4b) = 14 bits
  while bitcnt < 14 && in_pos < in_len {
    bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
    in_pos = in_pos + 1
    bitcnt = bitcnt + 8
  }
  if bitcnt < 14 {
    return Err(FlateError::UnexpectedEof("truncated dynamic block header"))
  }
  let hlit = (bitbuf & 31UL).to_int() + 257
  let hdist = ((bitbuf >> 5) & 31UL).to_int() + 1
  let hclen = ((bitbuf >> 10) & 15UL).to_int() + 4
  bitbuf = bitbuf >> 14
  bitcnt = bitcnt - 14
  if hlit > 286 || hdist > 30 {
    return Err(FlateError::InvalidHuffmanTree("HLIT > 286 or HDIST > 30"))
  }
  let mut ci = 0
  while ci < 19 {
    cl_lens[ci] = 0
    ci = ci + 1
  }
  ci = 0
  while ci < hclen {
    while bitcnt < 3 && in_pos < in_len {
      bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
      in_pos = in_pos + 1
      bitcnt = bitcnt + 8
    }
    if bitcnt < 3 {
      return Err(FlateError::UnexpectedEof("truncated code-length table"))
    }
    cl_lens[clo[ci]] = (bitbuf & 7UL).to_int()
    bitbuf = bitbuf >> 3
    bitcnt = bitcnt - 3
    ci = ci + 1
  }
  match build_inflate_table(cl_lens, 19, cl_lut, 7, false) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  // Decode hlit + hdist code lengths
  let total_codes = hlit + hdist
  let mut idx = 0
  while idx < total_codes {
    while bitcnt < 15 && in_pos < in_len {
      bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
      in_pos = in_pos + 1
      bitcnt = bitcnt + 8
    }
    let ent = cl_lut[(bitbuf & 127UL).to_int()]
    let nb = ent & 15
    if nb == 0 {
      return Err(FlateError::InvalidHuffmanTree("invalid code-length symbol"))
    }
    if bitcnt < nb {
      return Err(FlateError::UnexpectedEof("truncated code-length symbol"))
    }
    let csym = ent >> 5
    bitbuf = bitbuf >> nb
    bitcnt = bitcnt - nb
    if csym < 16 {
      code_lens[idx] = csym
      idx = idx + 1
    } else {
      let mut rep_val = 0
      let mut rep_cnt = 0
      if csym == 16 {
        if idx == 0 {
          return Err(FlateError::InvalidHuffmanTree("repeat code 16 with no previous length"))
        }
        while bitcnt < 2 && in_pos < in_len {
          bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
          in_pos = in_pos + 1
          bitcnt = bitcnt + 8
        }
        if bitcnt < 2 {
          return Err(FlateError::UnexpectedEof("truncated repeat-16 extra bits"))
        }
        rep_val = code_lens[idx - 1]
        rep_cnt = 3 + (bitbuf & 3UL).to_int()
        bitbuf = bitbuf >> 2
        bitcnt = bitcnt - 2
      } else if csym == 17 {
        while bitcnt < 3 && in_pos < in_len {
          bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
          in_pos = in_pos + 1
          bitcnt = bitcnt + 8
        }
        if bitcnt < 3 {
          return Err(FlateError::UnexpectedEof("truncated repeat-17 extra bits"))
        }
        rep_val = 0
        rep_cnt = 3 + (bitbuf & 7UL).to_int()
        bitbuf = bitbuf >> 3
        bitcnt = bitcnt - 3
      } else {
        while bitcnt < 7 && in_pos < in_len {
          bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
          in_pos = in_pos + 1
          bitcnt = bitcnt + 8
        }
        if bitcnt < 7 {
          return Err(FlateError::UnexpectedEof("truncated repeat-18 extra bits"))
        }
        rep_val = 0
        rep_cnt = 11 + (bitbuf & 127UL).to_int()
        bitbuf = bitbuf >> 7
        bitcnt = bitcnt - 7
      }
      if idx + rep_cnt > total_codes {
        return Err(FlateError::InvalidHuffmanTree("code-length repeat exceeds HLIT+HDIST"))
      }
      let mut r = 0
      while r < rep_cnt {
        code_lens[idx] = rep_val
        idx = idx + 1
        r = r + 1
      }
    }
  }

  if code_lens[256] == 0 {
    return Err(FlateError::InvalidHuffmanTree("missing EOB symbol 256"))
  }
  let mut li = 0
  while li < hlit {
    litlen_lens[li] = code_lens[li]
    li = li + 1
  }
  while li < 288 {
    litlen_lens[li] = 0
    li = li + 1
  }
  let mut di = 0
  while di < hdist {
    dist_lens[di] = code_lens[hlit + di]
    di = di + 1
  }
  while di < 32 {
    dist_lens[di] = 0
    di = di + 1
  }

  match build_litlen_inflate_table(litlen_lens, hlit, dyn_litlen_lut, 10) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match build_dist_inflate_table(dist_lens, hdist, dyn_dist_lut, 9, true) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  state.in_pos = in_pos
  state.bitbuf = bitbuf
  state.bitcnt = bitcnt
  Ok(())
}

///| Map `inflate_huffman_block` integer error code to `FlateError`.
fn inflate_rc_to_error(rc : Int, state : InflateState) -> FlateError {
  if rc == 1 {
    FlateError::UnexpectedEof("truncated litlen code")
  } else if rc == 2 {
    FlateError::OutputLimitExceeded(state.max_output_bytes)
  } else if rc == 3 {
    FlateError::UnexpectedEof("truncated litlen subtable prefix")
  } else if rc == 4 {
    FlateError::InvalidHuffmanTree("invalid litlen subtable code")
  } else if rc == 5 {
    FlateError::UnexpectedEof("truncated litlen subtable code")
  } else if rc == 6 {
    FlateError::InvalidHuffmanTree("invalid litlen code")
  } else if rc == 7 {
    FlateError::InvalidSymbol(state.err_sym)
  } else if rc == 8 {
    FlateError::UnexpectedEof("truncated length extra bits")
  } else if rc == 9 {
    FlateError::UnexpectedEof("truncated distance code")
  } else if rc == 10 {
    FlateError::UnexpectedEof("truncated distance subtable prefix")
  } else if rc == 11 {
    FlateError::InvalidHuffmanTree("invalid distance subtable code")
  } else if rc == 12 {
    FlateError::UnexpectedEof("truncated distance subtable code")
  } else if rc == 13 {
    FlateError::InvalidHuffmanTree("invalid distance code")
  } else if rc == 14 {
    FlateError::UnexpectedEof("truncated distance extra bits")
  } else {
    FlateError::InvalidDistance("distance exceeds available history")
  }
}

///| Ultra-lean hot loop: runs while >= 8 input bytes and >= 258 output bytes remain.
///| `out` is immutable here (never grown or reassigned), single exit point, zero EOF/cap checks.
///| Returns: `0` on EOB, `-1` when buffer/input margin reached (resume in slow/grow loop), `> 0` on error.
fn inflate_huffman_fast(
  data : Bytes,
  cur_litlen : FixedArray[Int],
  cur_dist : FixedArray[Int],
  out : Bytes,
  state : InflateState,
) -> Int {
  let mut in_pos = state.in_pos
  let mut bitbuf = state.bitbuf
  let mut bitcnt = state.bitcnt
  let mut out_len = state.out_len
  let in_lim8 = data.length() - 8
  let out_safe = state.safe_end - 258
  let dist_mask = state.dist_mask
  let mut rc = -1

  while in_pos <= in_lim8 && out_len <= out_safe {
    // Guaranteed >= 8 input bytes remain: sequential 32-bit refill (low register pressure)
    if bitcnt <= 32 {
      let mut w : UInt = data[in_pos].to_int().to_uint()
      w = w | (data[in_pos + 1].to_int().to_uint() << 8)
      w = w | (data[in_pos + 2].to_int().to_uint() << 16)
      w = w | (data[in_pos + 3].to_int().to_uint() << 24)
      bitbuf = bitbuf | (w.to_int64().to_uint64() << bitcnt)
      in_pos = in_pos + 4
      bitcnt = bitcnt + 32
    }

    // Decode literal/length symbol via 10-bit primary LUT
    let mut ent = cur_litlen[(bitbuf & 1023UL).to_int()]
    if (ent & 48) == 32 {
      let nb = ent & 15
      bitbuf = bitbuf >> nb
      bitcnt = bitcnt - nb
      out[out_len] = (ent >> 8).to_byte()
      out_len = out_len + 1
      // Drain consecutive direct literals while >= 20 bits and safe room remain;
      // if the next symbol is a match/EOB/subtable, fall straight through without re-reading LUT!
      let mut fell_through = false
      while bitcnt >= 20 && out_len <= out_safe {
        ent = cur_litlen[(bitbuf & 1023UL).to_int()]
        if (ent & 48) != 32 {
          fell_through = true
          break
        }
        let nb2 = ent & 15
        bitbuf = bitbuf >> nb2
        bitcnt = bitcnt - nb2
        out[out_len] = (ent >> 8).to_byte()
        out_len = out_len + 1
      }
      if !fell_through {
        continue
      }
    }

    if (ent & 16) != 0 {
      let sub_bits = ent & 15
      let sub_off = ent >> 5
      let sub_ent = cur_litlen[sub_off + ((bitbuf >> 10) & ((1UL << sub_bits) - 1UL)).to_int()]
      let sub_nb = sub_ent & 15
      if sub_nb == 0 {
        rc = 4
        break
      }
      let total_nb = 10 + sub_nb
      bitbuf = bitbuf >> total_nb
      bitcnt = bitcnt - total_nb
      ent = sub_ent
      if (ent & 32) != 0 {
        out[out_len] = (ent >> 8).to_byte()
        out_len = out_len + 1
        continue
      }
    } else {
      let nb = ent & 15
      if nb == 0 {
        rc = 6
        break
      }
      bitbuf = bitbuf >> nb
      bitcnt = bitcnt - nb
    }

    // EOB (sym 256)
    if (ent & 64) != 0 {
      rc = 0
      break
    }

    // Invalid symbol (286..287)
    if (ent & 128) == 0 {
      state.err_sym = ent >> 9
      rc = 7
      break
    }

    // Packed length: lbase + lextra extra bits
    let lextra = (ent >> 8) & 15
    let mut match_len = ent >> 12
    if lextra > 0 {
      match_len = match_len + (bitbuf & ((1UL << lextra) - 1UL)).to_int()
      bitbuf = bitbuf >> lextra
      bitcnt = bitcnt - lextra
    }

    // Guaranteed >= 4 input bytes still remain: refill before distance if bitcnt < 28
    if bitcnt < 28 {
      let mut w : UInt = data[in_pos].to_int().to_uint()
      w = w | (data[in_pos + 1].to_int().to_uint() << 8)
      w = w | (data[in_pos + 2].to_int().to_uint() << 16)
      w = w | (data[in_pos + 3].to_int().to_uint() << 24)
      bitbuf = bitbuf | (w.to_int64().to_uint64() << bitcnt)
      in_pos = in_pos + 4
      bitcnt = bitcnt + 32
    }

    // Decode packed distance symbol
    let mut dent = cur_dist[(bitbuf & dist_mask).to_int()]
    if (dent & 48) == 32 {
      let dnb = dent & 15
      bitbuf = bitbuf >> dnb
      bitcnt = bitcnt - dnb
    } else if (dent & 16) != 0 {
      let sub_bits = dent & 15
      let sub_off = dent >> 5
      let sub_ent = cur_dist[sub_off + ((bitbuf >> 9) & ((1UL << sub_bits) - 1UL)).to_int()]
      let sub_nb = sub_ent & 15
      if sub_nb == 0 {
        rc = 11
        break
      }
      let total_nb = 9 + sub_nb
      bitbuf = bitbuf >> total_nb
      bitcnt = bitcnt - total_nb
      dent = sub_ent
      if (dent & 32) == 0 {
        state.err_sym = dent >> 7
        rc = 7
        break
      }
    } else {
      let dnb = dent & 15
      if dnb == 0 {
        rc = 13
        break
      }
      state.err_sym = dent >> 7
      rc = 7
      break
    }

    let dextra = (dent >> 6) & 15
    let mut dist = dent >> 10
    if dextra > 0 {
      dist = dist + (bitbuf & ((1UL << dextra) - 1UL)).to_int()
      bitbuf = bitbuf >> dextra
      bitcnt = bitcnt - dextra
    }

    if dist <= 0 || dist > out_len {
      if dist <= 0 || dist > out_len + state.dict_len {
        rc = 15
        break
      }
      out_len = inflate_copy_dict(out, out_len, state.dict, state.dict_len, dist, match_len)
    } else if dist >= 8 {
      out_len = inflate_copy_dist8(out, out_len, dist, match_len)
    } else if dist == 1 {
      out_len = inflate_fill_rle1(out, out_len, match_len)
    } else {
      out_len = inflate_copy_overlap(out, out_len, dist, match_len)
    }
  }

  state.in_pos = in_pos
  state.bitbuf = bitbuf
  state.bitcnt = bitcnt
  state.out_len = out_len
  rc
}

///| Exact boundary-checked slow loop for the final <= 8 input bytes or <= 258 bytes before `max_output_bytes`.
fn inflate_huffman_slow(
  data : Bytes,
  in_len : Int,
  cur_litlen : FixedArray[Int],
  cur_dist : FixedArray[Int],
  state : InflateState,
) -> Int {
  let mut in_pos = state.in_pos
  let mut bitbuf = state.bitbuf
  let mut bitcnt = state.bitcnt
  let mut out = state.out
  let mut out_len = state.out_len
  let mut safe_end = state.safe_end
  let dist_mask = state.dist_mask
  let masks = bit_masks

  while true {
    while bitcnt <= 56 && in_pos < in_len {
      bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
      in_pos = in_pos + 1
      bitcnt = bitcnt + 8
    }

    let mut ent = cur_litlen[(bitbuf & 1023UL).to_int()]
    if (ent & 48) == 32 {
      let nb = ent & 15
      if bitcnt < nb {
        return 1
      }
      bitbuf = bitbuf >> nb
      bitcnt = bitcnt - nb
      if out_len >= safe_end {
        if !inflate_ensure_out(state, out, out_len, 1) {
          return 2
        }
        out = state.out
        safe_end = state.safe_end
      }
      out[out_len] = (ent >> 8).to_byte()
      out_len = out_len + 1
      continue
    }

    if (ent & 16) != 0 {
      if bitcnt < 10 {
        return 3
      }
      let sub_bits = ent & 15
      let sub_off = ent >> 5
      let sub_ent = cur_litlen[sub_off + ((bitbuf >> 10) & masks[sub_bits]).to_int()]
      let sub_nb = sub_ent & 15
      if sub_nb == 0 {
        return 4
      }
      let total_nb = 10 + sub_nb
      if bitcnt < total_nb {
        return 5
      }
      bitbuf = bitbuf >> total_nb
      bitcnt = bitcnt - total_nb
      ent = sub_ent
      if (ent & 32) != 0 {
        if out_len >= safe_end {
          if !inflate_ensure_out(state, out, out_len, 1) {
            return 2
          }
          out = state.out
          safe_end = state.safe_end
        }
        out[out_len] = (ent >> 8).to_byte()
        out_len = out_len + 1
        continue
      }
    } else {
      let nb = ent & 15
      if nb == 0 {
        return 6
      }
      if bitcnt < nb {
        return 1
      }
      bitbuf = bitbuf >> nb
      bitcnt = bitcnt - nb
    }

    if (ent & 64) != 0 {
      break
    }
    if (ent & 128) == 0 {
      state.err_sym = ent >> 9
      return 7
    }

    let lextra = (ent >> 8) & 15
    let mut match_len = ent >> 12
    if lextra > 0 {
      if bitcnt < lextra {
        return 8
      }
      match_len = match_len + (bitbuf & masks[lextra]).to_int()
      bitbuf = bitbuf >> lextra
      bitcnt = bitcnt - lextra
    }

    while bitcnt <= 56 && in_pos < in_len {
      bitbuf = bitbuf | (data[in_pos].to_int().to_int64().to_uint64() << bitcnt)
      in_pos = in_pos + 1
      bitcnt = bitcnt + 8
    }

    let mut dent = cur_dist[(bitbuf & dist_mask).to_int()]
    if (dent & 48) == 32 {
      let dnb = dent & 15
      if bitcnt < dnb {
        return 9
      }
      bitbuf = bitbuf >> dnb
      bitcnt = bitcnt - dnb
    } else if (dent & 16) != 0 {
      if bitcnt < 9 {
        return 10
      }
      let sub_bits = dent & 15
      let sub_off = dent >> 5
      let sub_ent = cur_dist[sub_off + ((bitbuf >> 9) & masks[sub_bits]).to_int()]
      let sub_nb = sub_ent & 15
      if sub_nb == 0 {
        return 11
      }
      let total_nb = 9 + sub_nb
      if bitcnt < total_nb {
        return 12
      }
      bitbuf = bitbuf >> total_nb
      bitcnt = bitcnt - total_nb
      dent = sub_ent
      if (dent & 32) == 0 {
        state.err_sym = dent >> 7
        return 7
      }
    } else {
      let dnb = dent & 15
      if dnb == 0 {
        return 13
      }
      if bitcnt < dnb {
        return 9
      }
      state.err_sym = dent >> 7
      return 7
    }

    let dextra = (dent >> 6) & 15
    let mut dist = dent >> 10
    if dextra > 0 {
      if bitcnt < dextra {
        return 14
      }
      dist = dist + (bitbuf & masks[dextra]).to_int()
      bitbuf = bitbuf >> dextra
      bitcnt = bitcnt - dextra
    }

    if dist <= 0 || dist > out_len + state.dict_len {
      return 15
    }
    if match_len > safe_end - out_len {
      if !inflate_ensure_out(state, out, out_len, match_len) {
        return 2
      }
      out = state.out
      safe_end = state.safe_end
    }

    if dist > out_len {
      out_len = inflate_copy_dict(out, out_len, state.dict, state.dict_len, dist, match_len)
    } else {
      out_len = inflate_copy_overlap(out, out_len, dist, match_len)
    }
  }

  state.in_pos = in_pos
  state.bitbuf = bitbuf
  state.bitcnt = bitcnt
  state.out = out
  state.out_len = out_len
  state.safe_end = safe_end
  0
}

///| Dispatch Fixed/Dynamic Huffman block: stay in `inflate_huffman_fast`, grow as needed, finish in `inflate_huffman_slow`.
fn inflate_huffman_block(
  data : Bytes,
  in_len : Int,
  cur_litlen : FixedArray[Int],
  cur_dist : FixedArray[Int],
  state : InflateState,
) -> Int {
  let in_lim8 = in_len - 8
  while true {
    if state.in_pos <= in_lim8 {
      if state.out_cap == 0 && state.init_hint > 0 {
        if !inflate_ensure_out(state, state.out, 0, 1) {
          return 2
        }
      }
      if state.out_len <= state.safe_end - 258 {
        let rc = inflate_huffman_fast(data, cur_litlen, cur_dist, state.out, state)
        if rc >= 0 {
          return rc
        }
        // Only pre-grow when we are not already at an exact ISIZE hint tail;
        // otherwise finish the final <= 258 bytes in slow loop without doubling the buffer.
        if state.in_pos <= in_lim8 &&
        state.out_len > state.safe_end - 258 &&
        state.out_cap != state.init_hint &&
        state.safe_end < state.max_output_bytes &&
        state.max_output_bytes - state.out_len >= 258 {
          if !inflate_ensure_out(state, state.out, state.out_len, 258) {
            return 2
          }
          continue
        }
      }
    }
    return inflate_huffman_slow(data, in_len, cur_litlen, cur_dist, state)
  }
  0
}

///| Core RFC 1951 Inflate engine starting at `data[start..]`.
///| `max_output_bytes` is an exact non-negative limit (0 means at most 0 output bytes).
///| Returns `(decompressed_bytes, next_byte_offset_in_data)`.
fn inflate_raw_into(
  data : Bytes,
  start : Int,
  max_output_bytes : Int,
  dict : Bytes,
  scratch : InflateScratch,
  hint_cap : Int,
) -> Result[(Bytes, Int), FlateError] {
  if max_output_bytes < 0 {
    return Err(FlateError::OutputLimitExceeded(max_output_bytes))
  }
  let in_len = data.length()
  let rem_in = in_len - start
  let mut init_hint = if hint_cap >= 0 {
    hint_cap
  } else {
    let h = rem_in * 4
    if h < 256 { 256 } else if h > 65536 { 65536 } else { h }
  }
  if init_hint > max_output_bytes {
    init_hint = max_output_bytes
  }

  let state = InflateState::{
    in_pos: start,
    bitbuf: 0UL,
    bitcnt: 0,
    out: Bytes::new(0),
    out_len: 0,
    out_cap: 0,
    safe_end: 0,
    dist_mask: 31UL,
    err_sym: 0,
    dict: dict,
    dict_len: dict.length(),
    max_output_bytes: max_output_bytes,
    init_hint: init_hint,
  }

  let stored_chunks : Array[Bytes] = []
  let mut stored_total = 0

  let flit = fixed_litlen_lut
  let fdist = fixed_dist_lut

  let mut bfinal = 0
  while bfinal == 0 {
    // Refill for 3-bit block header
    while state.bitcnt < 3 && state.in_pos < in_len {
      state.bitbuf = state.bitbuf |
      (data[state.in_pos].to_int().to_int64().to_uint64() << state.bitcnt)
      state.in_pos = state.in_pos + 1
      state.bitcnt = state.bitcnt + 8
    }
    if state.bitcnt < 3 {
      return Err(FlateError::UnexpectedEof("missing DEFLATE block header"))
    }
    bfinal = (state.bitbuf & 1UL).to_int()
    let btype = ((state.bitbuf >> 1) & 3UL).to_int()
    state.bitbuf = state.bitbuf >> 3
    state.bitcnt = state.bitcnt - 3

    if !is_valid_btype(btype) {
      return Err(FlateError::InvalidBlockType(btype))
    }

    if btype == 0 {
      // Stored block: discard remaining bits in current byte, rewind whole bytes
      let drop = state.bitcnt & 7
      state.bitbuf = state.bitbuf >> drop
      state.bitcnt = state.bitcnt - drop
      state.in_pos = state.in_pos - (state.bitcnt >> 3)
      state.bitbuf = 0UL
      state.bitcnt = 0
      if state.in_pos + 4 > in_len {
        return Err(FlateError::UnexpectedEof("truncated stored block header"))
      }
      let p = state.in_pos
      let slen = data[p].to_int() | (data[p + 1].to_int() << 8)
      let nlen = data[p + 2].to_int() | (data[p + 3].to_int() << 8)
      state.in_pos = p + 4
      if !is_valid_stored_nlen(slen, nlen) {
        return Err(FlateError::InvalidStoredLength("NLEN != ~LEN"))
      }
      if state.in_pos + slen > in_len {
        return Err(FlateError::UnexpectedEof("truncated stored block payload"))
      }
      if slen == 0 {
        continue
      }
      if state.out_len == 0 {
        if slen > max_output_bytes - stored_total {
          return Err(FlateError::OutputLimitExceeded(max_output_bytes))
        }
        if stored_total == 0 && bfinal == 1 {
          return Ok((data.slice(state.in_pos, state.in_pos + slen), state.in_pos + slen))
        }
        stored_chunks.push(data.slice(state.in_pos, state.in_pos + slen))
        stored_total = stored_total + slen
        state.in_pos = state.in_pos + slen
        continue
      }
      if slen > state.safe_end - state.out_len {
        if !inflate_ensure_out(state, state.out, state.out_len, slen) {
          return Err(FlateError::OutputLimitExceeded(max_output_bytes))
        }
      }
      let out = state.out
      let dst = state.out_len
      let src = state.in_pos
      let mut k = 0
      let lim8 = slen - 8
      while k <= lim8 {
        out[dst + k] = data[src + k]
        out[dst + k + 1] = data[src + k + 1]
        out[dst + k + 2] = data[src + k + 2]
        out[dst + k + 3] = data[src + k + 3]
        out[dst + k + 4] = data[src + k + 4]
        out[dst + k + 5] = data[src + k + 5]
        out[dst + k + 6] = data[src + k + 6]
        out[dst + k + 7] = data[src + k + 7]
        k = k + 8
      }
      while k < slen {
        out[dst + k] = data[src + k]
        k = k + 1
      }
      state.in_pos = src + slen
      state.out_len = dst + slen
      continue
    }

    // Materialize any preceding stored blocks before Huffman decoding
    if stored_total > 0 {
      let mat = concat_bytes_chunks(stored_chunks)
      state.out = mat
      state.out_len = stored_total
      state.out_cap = mat.length()
      state.safe_end = if state.out_cap < max_output_bytes {
        state.out_cap
      } else {
        max_output_bytes
      }
      stored_total = 0
    }

    let mut cur_litlen = flit
    let mut cur_dist = fdist
    state.dist_mask = 31UL

    if btype == 2 {
      match inflate_read_dynamic_trees(data, in_len, state, scratch) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      cur_litlen = scratch.dyn_litlen_lut
      cur_dist = scratch.dyn_dist_lut
      state.dist_mask = 511UL
    }

    let rc = inflate_huffman_block(data, in_len, cur_litlen, cur_dist, state)
    if rc != 0 {
      return Err(inflate_rc_to_error(rc, state))
    }
  }

  // Rewind whole unused bytes left in bitbuf
  let end_pos = state.in_pos - (state.bitcnt >> 3)
  if state.out_len == 0 && stored_total > 0 {
    return Ok((concat_bytes_chunks(stored_chunks), end_pos))
  }
  if state.out_len == 0 {
    return Ok((Bytes::new(0), end_pos))
  }
  if state.out_len == state.out_cap {
    return Ok((state.out, end_pos))
  }
  Ok((state.out.slice(0, state.out_len), end_pos))
}

///| Decompress a raw RFC 1951 DEFLATE stream using default output limit (256 MiB).
pub fn deflate_decompress(data : Bytes) -> Result[Bytes, FlateError] {
  deflate_decompress_with_limit(data, default_max_output_bytes)
}

///| Decompress a raw RFC 1951 DEFLATE stream enforcing `max_output_bytes` (`0` means unlimited).
pub fn deflate_decompress_with_limit(
  data : Bytes,
  max_output_bytes : Int,
) -> Result[Bytes, FlateError] {
  if max_output_bytes < 0 {
    return Err(FlateError::OutputLimitExceeded(max_output_bytes))
  }
  let eff_limit = if max_output_bytes == 0 { 2147483647 } else { max_output_bytes }
  match inflate_raw_into(data, 0, eff_limit, Bytes::new(0), InflateScratch::new(), -1) {
    Ok((out, _)) => Ok(out)
    Err(e) => Err(e)
  }
}
