///| Wasm32 & Native smoke entry for `packages/flate`.

import "flate"

///|
pub fn smoke() -> Int {
  let msg = "The quick brown fox jumps over the lazy dog. ".to_bytes()
  // 1. CRC-32 & Adler-32
  if flate::crc32("123456789".to_bytes()) != 0xCBF43926U {
    return 1
  }
  if flate::adler32("Wikipedia".to_bytes()) != 0x11E60398U {
    return 2
  }
  // 2. Raw DEFLATE roundtrip
  let raw = match flate::deflate_compress(msg, 6) {
    Ok(b) => b
    Err(_) => return 3
  }
  match flate::deflate_decompress(raw) {
    Ok(out) =>
    if out.to_string() != msg.to_string() {
      return 4
    }
    Err(_) => return 5
  }
  // 3. zlib roundtrip
  let zb = match flate::zlib_compress(msg, 6) {
    Ok(b) => b
    Err(_) => return 6
  }
  match flate::zlib_decompress(zb) {
    Ok(out) =>
    if out.to_string() != msg.to_string() {
      return 7
    }
    Err(_) => return 8
  }
  // 4. gzip roundtrip
  let gz = match flate::gzip_compress_with_header(msg, 6, flate::GzipHeader::with_name("fox.txt")) {
    Ok(b) => b
    Err(_) => return 9
  }
  match flate::gzip_decompress_full(gz, 1048576) {
    Ok(dec) =>
    if dec.data.to_string() != msg.to_string() || dec.header.name != "fox.txt" || dec.member_count != 1 {
      return 10
    }
    Err(_) => return 11
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
