///| IEEE CRC-32 and Adler-32 checksum compliance tests (RFC 1950 / RFC 1952 / Go hash/crc32 & hash/adler32).

///|
fn cs_repeat_byte(bval : Int, count : Int) -> Bytes {
  let mut b = Bytes::new(count)
  let bv = bval.to_byte()
  let mut i = 0
  while i < count {
    b[i] = bv
    i = i + 1
  }
  b
}

///|
test "crc32_known_vectors" {
  debug_assert(crc32(Bytes::new(0)) == 0x00000000U, "crc32 empty")
  debug_assert(crc32("123456789".to_bytes()) == 0xCBF43926U, "crc32 123456789")
  debug_assert(
    crc32("The quick brown fox jumps over the lazy dog".to_bytes()) == 0x414FA339U,
    "crc32 quick brown fox",
  )
  debug_assert(crc32("hello, world!".to_bytes()) == 0x58988D13U, "crc32 hello")
  debug_assert(crc32("hello, stored!".to_bytes()) == 0x23A95223U, "crc32 stored")
  debug_assert(crc32(cs_repeat_byte(65, 1000)) == 0x51A02E01U, "crc32 1000x A")
}

///|
test "crc32_incremental_and_slice_alignment" {
  let msg = "The quick brown fox jumps over the lazy dog. 0123456789!@#$%^&*()_+-=".to_bytes()
  let expected = crc32(msg)
  debug_assert(expected != 0U, "non-zero crc")
  // Test various chunk sizes including 1, 3, 7, 8, 9, 15, 16 to exercise Slice-by-8 boundaries
  let sizes = [1, 2, 3, 7, 8, 9, 15, 16, 31]
  let mut si = 0
  while si < sizes.length() {
    let step = sizes[si]
    let h = Crc32::new()
    let mut pos = 0
    while pos < msg.length() {
      let end = if pos + step < msg.length() { pos + step } else { msg.length() }
      h.update(msg.slice(pos, end))
      pos = end
    }
    debug_assert(h.finalize() == expected, "streaming crc32 mismatch")
    si = si + 1
  }
  // Direct slice update
  let mut c = 0U
  c = crc32_update_slice(c, msg, 0, 17)
  c = crc32_update_slice(c, msg, 17, msg.length())
  debug_assert(c == expected, "crc32_update_slice mismatch")
}

///|
test "adler32_known_vectors" {
  debug_assert(adler32(Bytes::new(0)) == 0x00000001U, "adler32 empty")
  debug_assert(adler32("Wikipedia".to_bytes()) == 0x11E60398U, "adler32 Wikipedia")
  debug_assert(adler32("a".to_bytes()) == 0x00620062U, "adler32 a")
  debug_assert(adler32("abc".to_bytes()) == 0x024D0127U, "adler32 abc")
  debug_assert(adler32("hello, world!".to_bytes()) == 0x21FE04AAU, "adler32 hello")
  debug_assert(adler32(cs_repeat_byte(65, 1000)) == 0x890CFDE9U, "adler32 1000x A")
}

///|
test "adler32_nmax_boundary_and_streaming" {
  // 20,000 bytes of 0xFF exercises NMAX=5552 deferred modulo multiple times without UInt overflow
  let big = cs_repeat_byte(255, 20000)
  let oneshot = adler32(big)
  // Compute reference byte-by-byte modulo 65521
  let mut s1 : UInt = 1U
  let mut s2 : UInt = 0U
  let mut i = 0
  while i < 20000 {
    s1 = (s1 + 255U) % 65521U
    s2 = (s2 + s1) % 65521U
    i = i + 1
  }
  let expected = (s2 << 16) | s1
  debug_assert(oneshot == expected, "adler32 20000x 0xFF exact match")
  // Streaming across odd chunk sizes
  let h = Adler32::new()
  let mut pos = 0
  while pos < big.length() {
    let end = if pos + 5553 < big.length() { pos + 5553 } else { big.length() }
    h.update(big.slice(pos, end))
    pos = end
  }
  debug_assert(h.finalize() == expected, "adler32 streaming NMAX match")
  h.reset()
  debug_assert(h.finalize() == 1U, "adler32 reset to 1")
}
