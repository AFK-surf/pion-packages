///| Apache Avro 1.11.1 Upstream Specification Compliance & Regression Test Suite.
///|
///| Covers vectors and semantics from Apache Avro Java reference tests:
///| - TestSchemaNormalization (PCF stripping, whitespace, ordering, CRC-64-AVRO)
///| - TestSchemaCompatibility & TestResolvingGrammar (unqualified name match, aliases, promotions, defaults)
///| - TestDataFile (OCF full-schema metadata preservation, streaming OcfReader, limits)
///| - Avro JSON edge cases (-0.0, NaN/Infinity/-Infinity, duplicate map keys, wide records)

test "spec/normalization: TestSchemaNormalization PCF and CRC-64-AVRO vectors" {
  // Strip doc, aliases, default, order, logicalType, custom attributes; qualify names; remove whitespace
  let cases = [
    (
      "{\"type\":\"record\",\"name\":\"R\",\"namespace\":\"n\",\"doc\":\"d\",\"aliases\":[\"Z\"],\"fields\":[{\"name\":\"a\",\"type\":{\"type\":\"long\",\"logicalType\":\"timestamp-millis\"},\"doc\":\"x\",\"default\":1,\"order\":\"descending\",\"aliases\":[\"q\"]}]}",
      "{\"name\":\"n.R\",\"type\":\"record\",\"fields\":[{\"name\":\"a\",\"type\":\"long\"}]}",
    ),
    (
      "{\"type\":\"fixed\",\"name\":\"D\",\"size\":8,\"logicalType\":\"decimal\",\"precision\":18,\"scale\":2}",
      "{\"name\":\"D\",\"type\":\"fixed\",\"size\":8}",
    ),
    (
      "{\"type\":\"record\",\"name\":\"A\",\"fields\":[{\"name\":\"b\",\"type\":[\"null\",{\"type\":\"record\",\"name\":\"B\",\"fields\":[{\"name\":\"a\",\"type\":[\"null\",\"A\"]}]}]}]}",
      "{\"name\":\"A\",\"type\":\"record\",\"fields\":[{\"name\":\"b\",\"type\":[\"null\",{\"name\":\"B\",\"type\":\"record\",\"fields\":[{\"name\":\"a\",\"type\":[\"null\",\"A\"]}]}]}]}",
    ),
    (
      "{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":{\"type\":\"fixed\",\"name\":\"F\",\"size\":2}},{\"name\":\"b\",\"type\":{\"type\":\"F\"}}]}",
      "{\"name\":\"R\",\"type\":\"record\",\"fields\":[{\"name\":\"a\",\"type\":{\"name\":\"F\",\"type\":\"fixed\",\"size\":2}},{\"name\":\"b\",\"type\":\"F\"}]}",
    ),
    ("[]", "[]"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (src, want) = cases[i]
    let s = must_parse_schema(src)
    let got = canonical_form(s)
    debug_assert(got == want, "normalization case " + i.to_string() + ": got " + got)
    i = i + 1
  }
}

test "spec/normalization: schema_to_json preserves logicalType, default, aliases, doc, and order" {
  let src =
  "{\"type\":\"record\",\"name\":\"Ev\",\"namespace\":\"com.acme\",\"aliases\":[\"OldEv\"],\"fields\":[" +
  "{\"name\":\"at\",\"type\":{\"type\":\"long\",\"logicalType\":\"timestamp-millis\"},\"doc\":\"event time\",\"default\":0,\"order\":\"descending\",\"aliases\":[\"ts\"]}," +
  "{\"name\":\"id\",\"type\":{\"type\":\"string\",\"logicalType\":\"uuid\"}}," +
  "{\"name\":\"amt\",\"type\":{\"type\":\"bytes\",\"logicalType\":\"decimal\",\"precision\":9,\"scale\":2}}," +
  "{\"name\":\"day\",\"type\":{\"type\":\"int\",\"logicalType\":\"date\"}}," +
  "{\"name\":\"dur\",\"type\":{\"type\":\"fixed\",\"name\":\"Dur12\",\"size\":12,\"logicalType\":\"duration\"}}," +
  "{\"name\":\"opt\",\"type\":[\"null\",\"string\"],\"default\":null}" +
  "]}"
  let s = must_parse_schema(src)
  let full = schema_to_json(s)
  debug_assert(full.contains("timestamp-millis"), "keeps timestamp-millis")
  debug_assert(full.contains("uuid"), "keeps uuid")
  debug_assert(full.contains("decimal"), "keeps decimal")
  debug_assert(full.contains("\"precision\":9"), "keeps precision")
  debug_assert(full.contains("\"scale\":2"), "keeps scale")
  debug_assert(full.contains("duration"), "keeps duration")
  debug_assert(full.contains("\"order\":\"descending\""), "keeps order")
  debug_assert(full.contains("\"doc\":\"event time\""), "keeps doc")
  debug_assert(full.contains("\"aliases\":[\"ts\"]"), "keeps field aliases")
  // Re-parsing full JSON must preserve identical PCF and logical types
  let s2 = must_parse_schema(full)
  debug_assert(canonical_form(s) == canonical_form(s2), "PCF preserved after schema_to_json roundtrip")
  debug_assert(fingerprint_rabin(s) == fingerprint_rabin(s2), "Rabin fingerprint preserved")
}

test "spec/compatibility: unqualified name resolution for record, enum, and fixed" {
  // Record a.X -> b.X
  let wr = must_parse_schema("{\"type\":\"record\",\"name\":\"a.X\",\"fields\":[{\"name\":\"f\",\"type\":\"int\"}]}")
  let rr = must_parse_schema("{\"type\":\"record\",\"name\":\"b.X\",\"fields\":[{\"name\":\"f\",\"type\":\"long\"}]}")
  let raw_r = match encode_datum(wr, AvroValue::Record([("f", AvroValue::Int(42))])) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  match decode_datum_resolved(wr, rr, raw_r) {
    Ok(v) =>
    debug_assert(
      avro_value_eq(v, AvroValue::Record([("f", AvroValue::Long(42L))])),
      "a.X -> b.X record resolution",
    )
    Err(e) => debug_assert(false, error_message(e))
  }

  // Enum a.E -> b.E
  let we = must_parse_schema("{\"type\":\"enum\",\"name\":\"a.E\",\"symbols\":[\"A\",\"B\"]}")
  let re = must_parse_schema("{\"type\":\"enum\",\"name\":\"b.E\",\"symbols\":[\"B\",\"A\"]}")
  let raw_e = match encode_datum(we, AvroValue::Enum(0, "A")) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  match decode_datum_resolved(we, re, raw_e) {
    Ok(v) => debug_assert(avro_value_eq(v, AvroValue::Enum(1, "A")), "a.E -> b.E enum resolution")
    Err(e) => debug_assert(false, error_message(e))
  }

  // Fixed a.F -> b.F
  let wf = must_parse_schema("{\"type\":\"fixed\",\"name\":\"a.F\",\"size\":2}")
  let rf = must_parse_schema("{\"type\":\"fixed\",\"name\":\"b.F\",\"size\":2}")
  let raw_f = from_hex("abcd")
  match decode_datum_resolved(wf, rf, raw_f) {
    Ok(v) => debug_assert(avro_value_eq(v, AvroValue::Fixed(raw_f)), "a.F -> b.F fixed resolution")
    Err(e) => debug_assert(false, error_message(e))
  }
}

test "spec/resolving: numeric promotions (long->float single rounding, float->double sNaN quieting)" {
  // long -> float: 2^60 + 2^36 + 1 must single-round to 0x5d800001
  let w_long = must_parse_schema("\"long\"")
  let r_float = must_parse_schema("\"float\"")
  let v = (1L << 60) + (1L << 36) + 1L
  let raw_l = match encode_datum(w_long, AvroValue::Long(v)) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  match decode_datum_resolved(w_long, r_float, raw_l) {
    Ok(AvroValue::Float32(f)) =>
    debug_assert(double_to_float32_bits(f) == 0x5d800001L, "long->float single rounding")
    _ => debug_assert(false, "expected Float32")
  }

  // Int64::MAX -> float = 2^63 (0x5f000000), Int64::MIN -> float = -2^63 (0xdf000000)
  debug_assert(int64_to_float32_bits(9223372036854775807L) == 0x5f000000L, "Int64::MAX to f32")
  debug_assert(int64_to_float32_bits(-9223372036854775807L - 1L) == 0xdf000000L, "Int64::MIN to f32")

  // float sNaN 0x7f800001 -> double quiet NaN 0x7ff8000020000000
  let w_float = must_parse_schema("\"float\"")
  let r_double = must_parse_schema("\"double\"")
  match decode_datum_resolved(w_float, r_double, from_hex("0100807f")) {
    Ok(AvroValue::Float64(d)) =>
    debug_assert(d.to_bits() == 0x7ff8000020000000L, "sNaN quieted on float->double")
    _ => debug_assert(false, "expected Float64")
  }
}

test "spec/resolving: field alias does not override exact writer field" {
  let w = must_parse_schema(
    "{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"b\",\"type\":\"int\"},{\"name\":\"a\",\"type\":\"int\"}]}",
  )
  let r = must_parse_schema(
    "{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"b\",\"type\":\"int\",\"aliases\":[\"a\"]}]}",
  )
  let raw = match encode_datum(w, AvroValue::Record([("b", AvroValue::Int(1)), ("a", AvroValue::Int(2))])) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  match decode_datum_resolved(w, r, raw) {
    Ok(v) =>
    debug_assert(
      avro_value_eq(v, AvroValue::Record([("b", AvroValue::Int(1))])),
      "exact field b=1 must not be overwritten by alias a=2",
    )
    Err(e) => debug_assert(false, error_message(e))
  }
}

test "spec/json: negative zero, NaN/Infinity/-Infinity roundtrip, and map duplicate key last-wins" {
  let sd = must_parse_schema("\"double\"")
  let special = [
    Double::from_bits(0x8000000000000000L), // -0.0
    Double::from_bits(0x7ff8000000000000L), // NaN
    Double::from_bits(0x7ff0000000000000L), // +Inf
    Double::from_bits(0xfff0000000000000L), // -Inf
  ]
  let mut i = 0
  while i < special.length() {
    let orig = special[i]
    let js = match encode_json(sd, AvroValue::Float64(orig)) {
      Ok(s) => s
      Err(e) => {
        debug_assert(false, error_message(e))
        return
      }
    }
    match decode_json(sd, js) {
      Ok(AvroValue::Float64(got)) =>
      debug_assert(got.to_bits() == orig.to_bits(), "special double roundtrip failed for " + js)
      _ => debug_assert(false, "decode_json failed for " + js)
    }
    i = i + 1
  }

  let sm = must_parse_schema("{\"type\":\"map\",\"values\":\"int\"}")
  match decode_json(sm, "{\"a\":1,\"b\":2,\"a\":3}") {
    Ok(AvroValue::Map(es)) => {
      debug_assert(es.length() == 2, "duplicate map key collapsed to 2 entries")
      let (k0, v0) = es[0]
      debug_assert(k0 == "a" && avro_value_eq(v0, AvroValue::Int(3)), "duplicate key last-wins")
    }
    _ => debug_assert(false, "expected map")
  }
}

test "spec/datafile: streaming OcfReader multi-block iteration and logical type roundtrip" {
  let s = must_parse_schema(
    "{\"type\":\"record\",\"name\":\"Ev\",\"fields\":[{\"name\":\"at\",\"type\":{\"type\":\"long\",\"logicalType\":\"timestamp-millis\"}},{\"name\":\"n\",\"type\":\"int\"}]}",
  )
  let recs : Array[AvroValue] = []
  let mut i = 0
  while i < 15 {
    recs.push(AvroValue::Record([("at", AvroValue::Long(1700000000000L + i.to_int64())), ("n", AvroValue::Int(i))]))
    i = i + 1
  }
  let file = match write_ocf(s, recs, OcfOptions::default().with_block_size(4).with_codec(OcfCodec::Deflate)) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let reader = match OcfReader::open(file, AvroLimits::default()) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let mut blocks = 0
  let mut count = 0
  while true {
    match reader.next_block() {
      Ok(None) => break
      Ok(Some(blk)) => {
        blocks = blocks + 1
        let mut j = 0
        while j < blk.length() {
          debug_assert(avro_value_eq(blk[j], recs[count]), "streamed record mismatch")
          count = count + 1
          j = j + 1
        }
      }
      Err(e) => {
        debug_assert(false, error_message(e))
        return
      }
    }
  }
  debug_assert(blocks == 4 && count == 15, "expected 4 blocks and 15 records")
}
