///| Apache Avro 1.11.1 Schema Resolution (Evolution), Object Container File (OCF), and DoS Limits Tests.

test "resolve: record evolution (reorder, delete/skip nested, add default, field & record aliases, promotions)" {
  let writer_src =
  "{\"type\":\"record\",\"name\":\"OldUser\",\"namespace\":\"com.v1\",\"fields\":[" +
  "{\"name\":\"id\",\"type\":\"int\"}," +
  "{\"name\":\"dropped\",\"type\":{\"type\":\"map\",\"values\":{\"type\":\"array\",\"items\":\"string\"}}}," +
  "{\"name\":\"score\",\"type\":\"float\"}," +
  "{\"name\":\"old_name\",\"type\":\"string\"}," +
  "{\"name\":\"raw_tag\",\"type\":\"bytes\"}," +
  "{\"name\":\"status\",\"type\":{\"type\":\"enum\",\"name\":\"Status\",\"symbols\":[\"ACTIVE\",\"PAUSED\",\"LEGACY\"]}}" +
  "]}"
  let reader_src =
  "{\"type\":\"record\",\"name\":\"User\",\"namespace\":\"com.v2\",\"aliases\":[\"com.v1.OldUser\"],\"fields\":[" +
  "{\"name\":\"name\",\"aliases\":[\"old_name\"],\"type\":\"bytes\"}," +
  "{\"name\":\"id\",\"type\":\"long\"}," +
  "{\"name\":\"score\",\"type\":\"double\"}," +
  "{\"name\":\"raw_tag\",\"type\":\"string\"}," +
  "{\"name\":\"status\",\"type\":{\"type\":\"enum\",\"name\":\"UserStatus\",\"aliases\":[\"com.v1.Status\"],\"symbols\":[\"ACTIVE\",\"UNKNOWN\"],\"default\":\"UNKNOWN\"}}," +
  "{\"name\":\"tier\",\"type\":\"int\",\"default\":3}," +
  "{\"name\":\"note\",\"type\":[\"null\",\"string\"],\"default\":null}" +
  "]}"
  let w_schema = match parse_schema(writer_src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "parse writer schema: " + error_message(e))
      return
    }
  }
  let r_schema = match parse_schema(reader_src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "parse reader schema: " + error_message(e))
      return
    }
  }
  let w_val = AvroValue::Record([
    ("id", AvroValue::Int(42)),
    (
      "dropped",
      AvroValue::Map([
        ("k1", AvroValue::Array([AvroValue::String("a"), AvroValue::String("b")])),
      ]),
    ),
    ("score", AvroValue::Float32(2.5)),
    ("old_name", AvroValue::String("alice")),
    ("raw_tag", AvroValue::Bytes("vip".to_bytes())),
    ("status", AvroValue::Enum(2, "LEGACY")),
  ])
  let raw = match encode_datum(w_schema, w_val) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode writer val: " + error_message(e))
      return
    }
  }
  let resolved = match decode_datum_resolved(w_schema, r_schema, raw) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "resolve failed: " + error_message(e))
      return
    }
  }
  let want = AvroValue::Record([
    ("name", AvroValue::Bytes("alice".to_bytes())),
    ("id", AvroValue::Long(42L)),
    ("score", AvroValue::Float64(2.5)),
    ("raw_tag", AvroValue::String("vip")),
    ("status", AvroValue::Enum(1, "UNKNOWN")),
    ("tier", AvroValue::Int(3)),
    ("note", AvroValue::Union(0, AvroValue::Null)),
  ])
  debug_assert(avro_value_eq(resolved, want), "resolved record mismatch")
}

test "resolve: union evolution (non-union -> union, union -> non-union, union -> union with promotion)" {
  let s_int = must_parse_schema("\"int\"")
  let s_union_nl = must_parse_schema("[\"null\",\"long\"]")
  let s_union_is = must_parse_schema("[\"int\",\"string\"]")
  let s_double = must_parse_schema("\"double\"")

  // int -> ["null", "long"] => Union(1, Long(99))
  let b_int = match encode_datum(s_int, AvroValue::Int(99)) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode int: " + error_message(e))
      return
    }
  }
  let r1 = match decode_datum_resolved(s_int, s_union_nl, b_int) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "int -> union failed: " + error_message(e))
      return
    }
  }
  debug_assert(avro_value_eq(r1, AvroValue::Union(1, AvroValue::Long(99L))), "int -> union value")

  // ["int", "string"] (int branch) -> double => Float64(7.0)
  let b_u = match encode_datum(s_union_is, AvroValue::Union(0, AvroValue::Int(7))) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode union: " + error_message(e))
      return
    }
  }
  let r2 = match decode_datum_resolved(s_union_is, s_double, b_u) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "union -> double failed: " + error_message(e))
      return
    }
  }
  debug_assert(avro_value_eq(r2, AvroValue::Float64(7.0)), "union -> double value")

  // Incompatible: string -> int must fail
  let s_str = must_parse_schema("\"string\"")
  let b_str = match encode_datum(s_str, AvroValue::String("nope")) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode str: " + error_message(e))
      return
    }
  }
  match decode_datum_resolved(s_str, s_int, b_str) {
    Ok(_) => debug_assert(false, "expected error for string -> int")
    Err(_) => ()
  }
}

test "ocf: write and read null & deflate codecs, multi-block, custom metadata, and schema evolution" {
  let schema_v1 = match parse_schema(
    "{\"type\":\"record\",\"name\":\"Item\",\"fields\":[{\"name\":\"id\",\"type\":\"int\"},{\"name\":\"label\",\"type\":\"string\"}]}",
  ) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let schema_v2 = match parse_schema(
    "{\"type\":\"record\",\"name\":\"Item\",\"fields\":[{\"name\":\"label\",\"type\":\"string\"},{\"name\":\"id\",\"type\":\"long\"},{\"name\":\"active\",\"type\":\"boolean\",\"default\":true}]}",
  ) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let recs : Array[AvroValue] = []
  let mut i = 0
  while i < 25 {
    recs.push(
      AvroValue::Record([
        ("id", AvroValue::Int(i)),
        ("label", AvroValue::String("item-" + i.to_string() + "-payload-repeat-repeat")),
      ]),
    )
    i = i + 1
  }

  // Test Null codec with block_size=7 (4 blocks: 7+7+7+4)
  let opts_null = OcfOptions::default()
  .with_codec(OcfCodec::Null)
  .with_block_size(7)
  .with_metadata([("app.version", "1.0".to_bytes())])
  let ocf_null = match write_ocf(schema_v1, recs, opts_null) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "write_ocf null failed: " + error_message(e))
      return
    }
  }
  // Check magic bytes Obj\x01
  debug_assert(
    ocf_null.length() > 20 &&
    ocf_null[0] == b'O' &&
    ocf_null[1] == b'b' &&
    ocf_null[2] == b'j' &&
    ocf_null[3].to_int() == 1,
    "OCF magic bytes mismatch",
  )
  let read_null = match read_ocf(ocf_null) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "read_ocf null failed: " + error_message(e))
      return
    }
  }
  debug_assert(read_null.records.length() == 25, "OCF null record count")
  let mut k = 0
  while k < 25 {
    debug_assert(avro_value_eq(read_null.records[k], recs[k]), "OCF null record " + k.to_string())
    k = k + 1
  }

  // Test Deflate codec (must compress smaller than null codec for repetitive data)
  let opts_def = OcfOptions::default().with_codec(OcfCodec::Deflate).with_block_size(10)
  let ocf_def = match write_ocf(schema_v1, recs, opts_def) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "write_ocf deflate failed: " + error_message(e))
      return
    }
  }
  debug_assert(ocf_def.length() < ocf_null.length(), "deflate OCF should be smaller than null OCF")
  let read_def = match read_ocf(ocf_def) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "read_ocf deflate failed: " + error_message(e))
      return
    }
  }
  debug_assert(read_def.records.length() == 25, "OCF deflate record count")
  let mut m = 0
  while m < 25 {
    debug_assert(avro_value_eq(read_def.records[m], recs[m]), "OCF deflate record " + m.to_string())
    m = m + 1
  }

  // Test read_ocf_resolved (v1 OCF -> v2 reader schema)
  let evolved = match read_ocf_resolved(ocf_def, schema_v2, AvroLimits::default()) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "read_ocf_resolved failed: " + error_message(e))
      return
    }
  }
  debug_assert(evolved.records.length() == 25, "OCF resolved count")
  let want0 = AvroValue::Record([
    ("label", AvroValue::String("item-0-payload-repeat-repeat")),
    ("id", AvroValue::Long(0L)),
    ("active", AvroValue::Boolean(true)),
  ])
  debug_assert(avro_value_eq(evolved.records[0], want0), "OCF resolved record 0 mismatch")

  // Corrupt sync marker must fail
  let bad_sync = ocf_null.slice(0, ocf_null.length())
  bad_sync[bad_sync.length() - 1] = (bad_sync[bad_sync.length() - 1].to_int() ^ 0xFF).to_byte()
  match read_ocf(bad_sync) {
    Ok(_) => debug_assert(false, "expected sync marker mismatch error")
    Err(_) => ()
  }
}

test "limits: DoS protection (max_depth, max_elements, max_bytes / decompression bomb)" {
  // 1. max_elements on array
  let s_arr = must_parse_schema("{\"type\":\"array\",\"items\":\"int\"}")
  let big_arr = AvroValue::Array([
    AvroValue::Int(1),
    AvroValue::Int(2),
    AvroValue::Int(3),
    AvroValue::Int(4),
    AvroValue::Int(5),
  ])
  let enc_arr = match encode_datum(s_arr, big_arr) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode arr: " + error_message(e))
      return
    }
  }
  match decode_datum_with_limits(s_arr, enc_arr, AvroLimits::default().with_max_elements(3)) {
    Ok(_) => debug_assert(false, "expected max_elements limit error")
    Err(_) => ()
  }

  // 2. max_depth on recursive record
  let s_node = must_parse_schema(
    "{\"type\":\"record\",\"name\":\"N\",\"fields\":[{\"name\":\"next\",\"type\":[\"null\",\"N\"]}]}",
  )
  let mut cur = AvroValue::Record([("next", AvroValue::Union(0, AvroValue::Null))])
  let mut d = 0
  while d < 8 {
    cur = AvroValue::Record([("next", AvroValue::Union(1, cur))])
    d = d + 1
  }
  let enc_deep = match encode_datum(s_node, cur) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode deep: " + error_message(e))
      return
    }
  }
  match decode_datum_with_limits(s_node, enc_deep, AvroLimits::default().with_max_depth(4)) {
    Ok(_) => debug_assert(false, "expected max_depth limit error")
    Err(_) => ()
  }

  // 3. max_bytes decompression bomb guard on deflate OCF
  let s_str = must_parse_schema("\"string\"")
  let sb = StringBuilder::new()
  let mut j = 0
  while j < 4096 {
    sb.write_string("A")
    j = j + 1
  }
  let big_str = sb.to_string()
  let ocf_bomb = match write_ocf(
    s_str,
    [AvroValue::String(big_str)],
    OcfOptions::default().with_codec(OcfCodec::Deflate),
  ) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "write ocf bomb: " + error_message(e))
      return
    }
  }
  match read_ocf_with_limits(ocf_bomb, AvroLimits::default().with_max_bytes(512)) {
    Ok(_) => debug_assert(false, "expected decompression bomb max_bytes limit error")
    Err(_) => ()
  }
}
