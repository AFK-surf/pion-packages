///| Apache Avro 1.11.1 Binary & JSON Datum Codec Specification Tests.

fn hex_nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

fn from_hex(hex : String) -> Bytes {
  let n = hex.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nib(hex.code_unit_at(i * 2))
    let lo = hex_nib(hex.code_unit_at(i * 2 + 1))
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

fn to_hex(b : Bytes) -> String {
  let lut = "0123456789abcdef"
  let out = Bytes::new(b.length() * 2)
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    out[i * 2] = lut.code_unit_at(v >> 4).to_byte()
    out[i * 2 + 1] = lut.code_unit_at(v & 15).to_byte()
    i = i + 1
  }
  out.to_string()
}

test "binary: zigzag varint int & long spec vectors" {
  // Avro 1.11.1 spec §Binary Encoding:
  // 0 -> 00, -1 -> 01, 1 -> 02, -2 -> 03, 2 -> 04, -64 -> 7f, 64 -> 80 01
  let s_int = match parse_schema("\"int\"") {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let int_cases = [
    (0, "00"),
    (-1, "01"),
    (1, "02"),
    (-2, "03"),
    (2, "04"),
    (-64, "7f"),
    (64, "8001"),
    (2147483647, "feffffff0f"),
    (-2147483648, "ffffffff0f"),
  ]
  let mut i = 0
  while i < int_cases.length() {
    let (v, want_hex) = int_cases[i]
    let enc = match encode_datum(s_int, AvroValue::Int(v)) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, "encode int failed: " + error_message(e))
        return
      }
    }
    debug_assert(to_hex(enc) == want_hex, "int " + v.to_string() + " got " + to_hex(enc))
    let dec = match decode_datum(s_int, enc) {
      Ok(d) => d
      Err(e) => {
        debug_assert(false, "decode int failed: " + error_message(e))
        return
      }
    }
    debug_assert(avro_value_eq(dec, AvroValue::Int(v)), "int roundtrip mismatch")
    i = i + 1
  }

  let s_long = match parse_schema("\"long\"") {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let long_cases = [
    (0L, "00"),
    (-1L, "01"),
    (1L, "02"),
    (9223372036854775807L, "feffffffffffffffff01"),
    (-9223372036854775807L - 1L, "ffffffffffffffffff01"),
  ]
  let mut j = 0
  while j < long_cases.length() {
    let (v, want_hex) = long_cases[j]
    let enc = match encode_datum(s_long, AvroValue::Long(v)) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, "encode long failed: " + error_message(e))
        return
      }
    }
    debug_assert(to_hex(enc) == want_hex, "long " + v.to_string() + " got " + to_hex(enc))
    let dec = match decode_datum(s_long, enc) {
      Ok(d) => d
      Err(e) => {
        debug_assert(false, "decode long failed: " + error_message(e))
        return
      }
    }
    debug_assert(avro_value_eq(dec, AvroValue::Long(v)), "long roundtrip mismatch")
    j = j + 1
  }
}

test "binary: exact IEEE-754 float32 and float64 encoding" {
  let s_f32 = match parse_schema("\"float\"") {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  // 1.5f = 0x3FC00000 -> LE: 00 00 c0 3f
  // -0.0f = 0x80000000 -> LE: 00 00 00 80
  // +Inf = 0x7F800000 -> LE: 00 00 80 7f
  // smallest subnormal = 0x00000001 -> LE: 01 00 00 00
  let f32_hexes = ["0000c03f", "00000080", "0000807f", "000080ff", "01000000", "0000c07f"]
  let mut i = 0
  while i < f32_hexes.length() {
    let raw = from_hex(f32_hexes[i])
    let dec = match decode_datum(s_f32, raw) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "decode f32 failed: " + error_message(e))
        return
      }
    }
    let reenc = match encode_datum(s_f32, dec) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, "encode f32 failed: " + error_message(e))
        return
      }
    }
    debug_assert(to_hex(reenc) == f32_hexes[i], "f32 bit-exact roundtrip failed for " + f32_hexes[i] + ": got " + to_hex(reenc))
    i = i + 1
  }

  let s_f64 = match parse_schema("\"double\"") {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  // 3.141592653589793 = 0x400921fb54442d18 -> LE: 18 2d 44 54 fb 21 09 40
  let raw_pi = from_hex("182d4454fb210940")
  let dec_pi = match decode_datum(s_f64, raw_pi) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let reenc_pi = match encode_datum(s_f64, dec_pi) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(bytes_equal(raw_pi, reenc_pi), "f64 pi roundtrip mismatch")
}

test "binary: array and map negative block counts with byte-size prefix" {
  // Avro spec §Arrays: negative count -2 (zigzag: 03), followed by byte_size 2 (zigzag: 04),
  // then two ints: 3 (06) and 27 (36), then block 2: count +1 (02), int -5 (09), then 00 terminator.
  let s_arr = match parse_schema("{\"type\":\"array\",\"items\":\"int\"}") {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let wire_arr = from_hex("03040636020900")
  let dec_arr = match decode_datum(s_arr, wire_arr) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "decode negative-count array failed: " + error_message(e))
      return
    }
  }
  let want_arr = AvroValue::Array([AvroValue::Int(3), AvroValue::Int(27), AvroValue::Int(-5)])
  debug_assert(avro_value_eq(dec_arr, want_arr), "negative-count array value mismatch")

  // Map with negative block count -1 (01), byte_size 3 (06): key "a" (02 61), val 10 (14), then 00.
  let s_map = match parse_schema("{\"type\":\"map\",\"values\":\"int\"}") {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let wire_map = from_hex("010602611400")
  let dec_map = match decode_datum(s_map, wire_map) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "decode negative-count map failed: " + error_message(e))
      return
    }
  }
  let want_map = AvroValue::Map([("a", AvroValue::Int(10))])
  debug_assert(avro_value_eq(dec_map, want_map), "negative-count map value mismatch")
}

test "binary: complex nested record, enum, union, fixed, recursive list roundtrip" {
  let src =
  "{\"type\":\"record\",\"name\":\"Node\",\"namespace\":\"demo\",\"fields\":[" +
  "{\"name\":\"id\",\"type\":\"int\"}," +
  "{\"name\":\"tag\",\"type\":{\"type\":\"enum\",\"name\":\"Kind\",\"symbols\":[\"A\",\"B\",\"C\"]}}," +
  "{\"name\":\"hash\",\"type\":{\"type\":\"fixed\",\"name\":\"H4\",\"size\":4}}," +
  "{\"name\":\"meta\",\"type\":{\"type\":\"map\",\"values\":[\"null\",\"string\"]}}," +
  "{\"name\":\"next\",\"type\":[\"null\",\"Node\"]}" +
  "]}"
  let s = match parse_schema(src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let h1 = from_hex("deadbeef")
  let h2 = from_hex("cafebabe")
  let tail = AvroValue::Record([
    ("id", AvroValue::Int(2)),
    ("tag", AvroValue::Enum(2, "C")),
    ("hash", AvroValue::Fixed(h2)),
    ("meta", AvroValue::Map([("k", AvroValue::Union(0, AvroValue::Null))])),
    ("next", AvroValue::Union(0, AvroValue::Null)),
  ])
  let head = AvroValue::Record([
    ("id", AvroValue::Int(1)),
    ("tag", AvroValue::Enum(1, "B")),
    ("hash", AvroValue::Fixed(h1)),
    ("meta", AvroValue::Map([("env", AvroValue::Union(1, AvroValue::String("prod")))])),
    ("next", AvroValue::Union(1, tail)),
  ])
  let enc = match encode_datum(s, head) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode recursive record failed: " + error_message(e))
      return
    }
  }
  let dec = match decode_datum(s, enc) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "decode recursive record failed: " + error_message(e))
      return
    }
  }
  debug_assert(avro_value_eq(head, dec), "recursive record binary roundtrip mismatch")
}

test "binary: invalid binary rejection (bad bool, invalid UTF-8, varint overflow, trailing bytes)" {
  let s_bool = must_parse_schema("\"boolean\"")
  match decode_datum(s_bool, from_hex("02")) {
    Ok(_) => debug_assert(false, "expected error for bool byte 0x02")
    Err(_) => ()
  }
  match decode_datum(s_bool, from_hex("0000")) {
    Ok(_) => debug_assert(false, "expected error for trailing byte")
    Err(_) => ()
  }
  let s_str = must_parse_schema("\"string\"")
  // length 2 (04), invalid UTF-8 bytes FF FE
  match decode_datum(s_str, from_hex("04fffe")) {
    Ok(_) => debug_assert(false, "expected invalid UTF-8 error")
    Err(_) => ()
  }
  let s_int = must_parse_schema("\"int\"")
  // 6-byte varint overflows 32-bit int
  match decode_datum(s_int, from_hex("808080808001")) {
    Ok(_) => debug_assert(false, "expected 32-bit int overflow error")
    Err(_) => ()
  }
}

test "json: Avro JSON encoding and decoding with union wrapping, bytes Latin-1, and defaults" {
  let src =
  "{\"type\":\"record\",\"name\":\"Event\",\"namespace\":\"com.acme\",\"fields\":[" +
  "{\"name\":\"id\",\"type\":\"long\"}," +
  "{\"name\":\"raw\",\"type\":\"bytes\"}," +
  "{\"name\":\"payload\",\"type\":[\"null\",\"string\",{\"type\":\"record\",\"name\":\"Sub\",\"fields\":[{\"name\":\"n\",\"type\":\"int\"}]}]}," +
  "{\"name\":\"opt\",\"type\":\"int\",\"default\":42}" +
  "]}"
  let s = match parse_schema(src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  // Case 1: union = null (must encode as JSON null, NOT {"null": null})
  let v1 = AvroValue::Record([
    ("id", AvroValue::Long(100L)),
    ("raw", AvroValue::Bytes(from_hex("0041ff"))),
    ("payload", AvroValue::Union(0, AvroValue::Null)),
    ("opt", AvroValue::Int(42)),
  ])
  let j1 = match encode_json(s, v1) {
    Ok(st) => st
    Err(e) => {
      debug_assert(false, "encode_json v1 failed: " + error_message(e))
      return
    }
  }
  let d1 = match decode_json(s, j1) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "decode_json v1 failed: " + error_message(e) + " json=" + j1)
      return
    }
  }
  debug_assert(avro_value_eq(v1, d1), "json roundtrip v1 mismatch")

  // Case 2: union = named record -> must wrap with fullname "com.acme.Sub"
  let v2 = AvroValue::Record([
    ("id", AvroValue::Long(200L)),
    ("raw", AvroValue::Bytes(from_hex("0102"))),
    ("payload", AvroValue::Union(2, AvroValue::Record([("n", AvroValue::Int(7))]))),
    ("opt", AvroValue::Int(9)),
  ])
  let j2 = match encode_json(s, v2) {
    Ok(st) => st
    Err(e) => {
      debug_assert(false, "encode_json v2 failed: " + error_message(e))
      return
    }
  }
  let d2 = match decode_json(s, j2) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "decode_json v2 failed: " + error_message(e) + " json=" + j2)
      return
    }
  }
  debug_assert(avro_value_eq(v2, d2), "json roundtrip v2 mismatch")

  // Case 3: missing field with default in JSON input
  let d3 = match decode_json(s, "{\"id\":5,\"raw\":\"AB\",\"payload\":{\"string\":\"hi\"}}") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "decode_json default failed: " + error_message(e))
      return
    }
  }
  let want3 = AvroValue::Record([
    ("id", AvroValue::Long(5L)),
    ("raw", AvroValue::Bytes("AB".to_bytes())),
    ("payload", AvroValue::Union(1, AvroValue::String("hi"))),
    ("opt", AvroValue::Int(42)),
  ])
  debug_assert(avro_value_eq(d3, want3), "json default fill mismatch")

  // Case 4: bytes string with code point > 0xFF must be rejected
  let s_bytes = match parse_schema("\"bytes\"") {
    Ok(v) => v
    Err(_) => return
  }
  match decode_json(s_bytes, "\"\\u0100\"") {
    Ok(_) => debug_assert(false, "expected error for bytes code point > 0xFF")
    Err(_) => ()
  }
}
