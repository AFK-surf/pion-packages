///| Red-team audit helpers for packages/avro (no production code; see ../REPORT.md).

import "avro"

///|
fn audit_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///| Hex string -> bytes.
pub fn hx(s : String) -> Bytes {
  let b = s.to_bytes()
  let n = b.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (audit_nibble(b[2 * i].to_int()) * 16 + audit_nibble(b[2 * i + 1].to_int())).to_byte()
    i = i + 1
  }
  out
}

///| Parse a schema that the test requires to be valid.
pub fn ps(src : String) -> avro::Schema {
  match avro::parse_schema(src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "schema must parse: " + avro::error_message(e) + " :: " + src)
      avro::Schema::{ root: 0, nodes: [], named_indices: [] }
    }
  }
}

///| Concatenate byte strings.
pub fn cat(parts : Array[Bytes]) -> Bytes {
  let mut n = 0
  let mut i = 0
  while i < parts.length() {
    n = n + parts[i].length()
    i = i + 1
  }
  let out = Bytes::new(n)
  let mut off = 0
  i = 0
  while i < parts.length() {
    let p = parts[i]
    let mut k = 0
    while k < p.length() {
      out[off + k] = p[k]
      k = k + 1
    }
    off = off + p.length()
    i = i + 1
  }
  out
}

///| Avro zig-zag varint of a long.
pub fn lng(n : Int64) -> Bytes {
  let mut u = ((n << 1) ^ (n >> 63)).to_uint64()
  let tmp : Array[Byte] = []
  while u >= 0x80UL {
    tmp.push(((u & 0x7FUL) | 0x80UL).to_int().to_byte())
    u = u >> 7
  }
  tmp.push(u.to_int().to_byte())
  let out = Bytes::new(tmp.length())
  let mut i = 0
  while i < tmp.length() {
    out[i] = tmp[i]
    i = i + 1
  }
  out
}

///| Length-prefixed Avro bytes/string.
pub fn lbytes(b : Bytes) -> Bytes {
  cat([lng(b.length().to_int64()), b])
}

///| Fixed sync marker used by the OCF builders below.
pub fn sync16() -> Bytes {
  let s = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    s[i] = (0xA0 + i).to_byte()
    i = i + 1
  }
  s
}

///| OCF header with `avro.schema` and `avro.codec`.
pub fn ocf_header(schema_json : String, codec : String) -> Bytes {
  cat([
    hx("4f626a01"),
    lng(2L),
    lbytes("avro.schema".to_bytes()),
    lbytes(schema_json.to_bytes()),
    lbytes("avro.codec".to_bytes()),
    lbytes(codec.to_bytes()),
    hx("00"),
    sync16(),
  ])
}

///| One OCF data block.
pub fn ocf_block(count : Int64, payload : Bytes) -> Bytes {
  cat([lng(count), lng(payload.length().to_int64()), payload, sync16()])
}

///| `Ok` -> true.
pub fn is_ok_value(r : Result[avro::AvroValue, avro::AvroError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}
