///| Red-team differential / DoS probe for packages/avro (see ../../REPORT.md).
///
///   avro_audit_probe batch <cases.txt> <out.txt>       same case protocol as ../go/main.go
///   avro_audit_probe ocf_read <file.avro> [max_elements]
///   avro_audit_probe ocf_write_ts <out.avro>            OCF with a timestamp-millis field
///   avro_audit_probe deep_list <n> <max_depth>          encode+decode an n-node recursive list
///   avro_audit_probe deep_schema <n> <max_depth>        parse an n-deep nested array schema
///   avro_audit_probe smoke                              4-mode consistency vector digest

import "avro"

///|
fn nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn unhex(s : String) -> Bytes {
  let b = s.to_bytes()
  let n = b.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (nib(b[2 * i].to_int()) * 16 + nib(b[2 * i + 1].to_int())).to_byte()
    i = i + 1
  }
  out
}

///|
fn hex_write(sb : StringBuilder, b : Bytes) -> Unit {
  let d = "0123456789abcdef"
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_string(d.slice(v >> 4, (v >> 4) + 1))
    sb.write_string(d.slice(v & 15, (v & 15) + 1))
    i = i + 1
  }
}

///|
fn hex_fixed(sb : StringBuilder, v : Int64, digits : Int) -> Unit {
  let d = "0123456789abcdef"
  let mut shift = (digits - 1) * 4
  while shift >= 0 {
    let x = ((v >> shift) & 15L).to_int()
    sb.write_string(d.slice(x, x + 1))
    shift = shift - 4
  }
}

///|
fn bytes_less(a : Bytes, b : Bytes) -> Bool {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  let mut i = 0
  while i < n {
    if a[i].to_int() != b[i].to_int() {
      return a[i].to_int() < b[i].to_int()
    }
    i = i + 1
  }
  a.length() < b.length()
}

///| Schema-directed canonical text, identical in format to ../go/main.go `canon`.
fn canon(sb : StringBuilder, s : avro::Schema, id : Int, v : avro::AvroValue) -> Bool {
  let rid = s.resolve_id(id)
  match (s.nodes[rid].kind, v) {
    (avro::SchemaKind::Null, avro::AvroValue::Null) => sb.write_string("n")
    (avro::SchemaKind::Boolean, avro::AvroValue::Boolean(b)) =>
    sb.write_string(if b { "t" } else { "f" })
    (avro::SchemaKind::Int, avro::AvroValue::Int(x)) => sb.write_string("I" + x.to_string())
    (avro::SchemaKind::Long, avro::AvroValue::Long(x)) => sb.write_string("L" + x.to_string())
    (avro::SchemaKind::Float, avro::AvroValue::Float32(x)) => {
      sb.write_string("f")
      hex_fixed(sb, avro::double_to_float32_bits(x), 8)
    }
    (avro::SchemaKind::Double, avro::AvroValue::Float64(x)) => {
      sb.write_string("d")
      hex_fixed(sb, x.to_bits(), 16)
    }
    (avro::SchemaKind::Bytes, avro::AvroValue::Bytes(b)) => {
      sb.write_string("b")
      hex_write(sb, b)
    }
    (avro::SchemaKind::String, avro::AvroValue::String(x)) => {
      sb.write_string("s")
      hex_write(sb, x.to_bytes())
    }
    (avro::SchemaKind::Fixed(_, _, _), avro::AvroValue::Fixed(b)) => {
      sb.write_string("x")
      hex_write(sb, b)
    }
    (avro::SchemaKind::Enum(_, _, _, _), avro::AvroValue::Enum(_, sym)) => sb.write_string("e" + sym)
    (avro::SchemaKind::Array(item), avro::AvroValue::Array(xs)) => {
      sb.write_string("[")
      let mut i = 0
      while i < xs.length() {
        if i > 0 {
          sb.write_string(",")
        }
        if !canon(sb, s, item, xs[i]) {
          return false
        }
        i = i + 1
      }
      sb.write_string("]")
    }
    (avro::SchemaKind::Map(vid), avro::AvroValue::Map(es)) => {
      // stable insertion sort by key bytes (duplicate keys are kept: hamba/Java keep the last)
      let keys : Array[Bytes] = []
      let idx : Array[Int] = []
      let mut i = 0
      while i < es.length() {
        let (k, _) = es[i]
        let kb = k.to_bytes()
        let mut j = keys.length()
        keys.push(kb)
        idx.push(i)
        while j > 0 && bytes_less(kb, keys[j - 1]) {
          keys[j] = keys[j - 1]
          idx[j] = idx[j - 1]
          j = j - 1
        }
        keys[j] = kb
        idx[j] = i
        i = i + 1
      }
      sb.write_string("{")
      let mut m = 0
      while m < idx.length() {
        if m > 0 {
          sb.write_string(",")
        }
        let (_, ev) = es[idx[m]]
        sb.write_string("k")
        hex_write(sb, keys[m])
        sb.write_string(":")
        if !canon(sb, s, vid, ev) {
          return false
        }
        m = m + 1
      }
      sb.write_string("}")
    }
    (avro::SchemaKind::Record(_, _, fields), avro::AvroValue::Record(vals)) => {
      if vals.length() != fields.length() {
        return false
      }
      sb.write_string("(")
      let mut i = 0
      while i < fields.length() {
        if i > 0 {
          sb.write_string(",")
        }
        let (_, fv) = vals[i]
        if !canon(sb, s, fields[i].schema_id, fv) {
          return false
        }
        i = i + 1
      }
      sb.write_string(")")
    }
    (avro::SchemaKind::Union(bs), avro::AvroValue::Union(i, inner)) => {
      if i < 0 || i >= bs.length() {
        return false
      }
      return canon(sb, s, bs[i], inner)
    }
    _ => return false
  }
  true
}

///|
fn probe_limits() -> avro::AvroLimits {
  avro::AvroLimits::default().with_max_depth(200)
}

///|
fn run_case(line : String) -> String {
  let parts : Array[String] = []
  let b = line.to_bytes()
  let mut start = 0
  let mut i = 0
  while i <= b.length() {
    if i == b.length() || b[i].to_int() == 32 {
      if i > start {
        parts.push(b.slice(start, i).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  if parts.length() == 0 {
    return "err empty"
  }
  let op = parts[0]
  if op == "S" {
    match avro::parse_schema(unhex(parts[1]).to_string()) {
      Err(e) => return "err " + avro::error_message(e)
      Ok(s) => {
        let sb = StringBuilder::new()
        sb.write_string("ok ")
        hex_write(sb, avro::canonical_form(s).to_bytes())
        sb.write_string(" ")
        sb.write_string(avro::fingerprint_rabin_hex(s))
        return sb.to_string()
      }
    }
  }
  if op == "D" {
    let s = match avro::parse_schema(unhex(parts[1]).to_string()) {
      Ok(x) => x
      Err(_) => return "err schema"
    }
    let data = if parts.length() > 2 { unhex(parts[2]) } else { Bytes::new(0) }
    match avro::decode_datum_at(s, data, 0, probe_limits()) {
      Err(e) => return "err " + avro::error_message(e)
      Ok((v, _)) => {
        let sb = StringBuilder::new()
        sb.write_string("ok ")
        if !canon(sb, s, s.root, v) {
          return "err canon"
        }
        return sb.to_string()
      }
    }
  }
  if op == "R" {
    let w = match avro::parse_schema(unhex(parts[1]).to_string()) {
      Ok(x) => x
      Err(_) => return "err writer"
    }
    let r = match avro::parse_schema(unhex(parts[2]).to_string()) {
      Ok(x) => x
      Err(_) => return "err reader"
    }
    let data = if parts.length() > 3 { unhex(parts[3]) } else { Bytes::new(0) }
    let res = match avro::compile_resolver(w, r) {
      Ok(x) => x
      Err(e) => return "err resolve: " + avro::error_message(e)
    }
    match avro::decode_datum_with_resolver(res, data, probe_limits()) {
      Err(e) => return "err " + avro::error_message(e)
      Ok(v) => {
        let sb = StringBuilder::new()
        sb.write_string("ok ")
        if !canon(sb, r, r.root, v) {
          return "err canon"
        }
        return sb.to_string()
      }
    }
  }
  "err op"
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  v
}

///|
fn list_schema() -> String {
  "{\"type\":\"record\",\"name\":\"Node\",\"fields\":[{\"name\":\"v\",\"type\":\"long\"},{\"name\":\"next\",\"type\":[\"null\",\"Node\"]}]}"
}

///| Deterministic digest of a fixed vector set, printed identically by all 4 build modes.
fn smoke(world : World) -> Int {
  let sb = StringBuilder::new()
  let schemas = [
    "\"double\"", "\"float\"", "\"long\"", "\"int\"",
    "{\"type\":\"record\",\"name\":\"a.b.R\",\"namespace\":\"x\",\"fields\":[{\"name\":\"e\",\"type\":{\"type\":\"enum\",\"name\":\"E\",\"symbols\":[\"A\",\"B\"]}},{\"name\":\"f\",\"type\":{\"type\":\"fixed\",\"name\":\"F\",\"namespace\":\"\",\"size\":2}},{\"name\":\"m\",\"type\":{\"type\":\"map\",\"values\":[\"null\",\"E\",\"F\"]}}]}",
    list_schema(),
  ]
  let mut i = 0
  while i < schemas.length() {
    match avro::parse_schema(schemas[i]) {
      Ok(s) => {
        sb.write_string(avro::fingerprint_rabin_hex(s))
        sb.write_string(" ")
        sb.write_string(avro::canonical_form(s))
        sb.write_string("\n")
      }
      Err(e) => sb.write_string("err " + avro::error_message(e) + "\n")
    }
    i = i + 1
  }
  // float/double bit patterns: -0, NaN payloads, subnormals, inf, rounding ties
  let d = ps("\"double\"")
  let f = ps("\"float\"")
  let pats = [
    0x8000000000000000L, 0x7FF8000000000001L, 0xFFF0000000000000L, 0x0000000000000001L,
    0x36A0000000000000L, 0x3690000000000001L, 0x47EFFFFFE0000000L, 0x47EFFFFFF0000000L,
    0x3FF0000010000000L, 0x3FF0000030000000L, 0x380FFFFFF0000000L,
  ]
  let mut k = 0
  while k < pats.length() {
    let x = Double::from_bits(pats[k])
    match avro::encode_datum(d, avro::AvroValue::Float64(x)) {
      Ok(b) => hex_write(sb, b)
      Err(_) => sb.write_string("E")
    }
    sb.write_string(" ")
    match avro::encode_datum(f, avro::AvroValue::Float32(x)) {
      Ok(b) => hex_write(sb, b)
      Err(_) => sb.write_string("E")
    }
    sb.write_string("\n")
    k = k + 1
  }
  // varint edges
  let l = ps("\"long\"")
  let longs = [0L, -1L, 9223372036854775807L, -9223372036854775807L - 1L, 4294967296L]
  let mut j = 0
  while j < longs.length() {
    match avro::encode_datum(l, avro::AvroValue::Long(longs[j])) {
      Ok(b) => hex_write(sb, b)
      Err(_) => sb.write_string("E")
    }
    sb.write_string("\n")
    j = j + 1
  }
  io_println(world, sb.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: avro_audit_probe <batch|ocf_read|ocf_write_ts|deep_list|deep_schema|smoke> ...")
    return 2
  }
  let mode = args[1]
  if mode == "smoke" {
    return smoke(world)
  }
  if mode == "batch" {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 2
    }
    let sb = StringBuilder::new()
    let mut start = 0
    let mut i = 0
    let n = data.length()
    while i <= n {
      if i == n || data[i].to_int() == 10 {
        if i > start {
          sb.write_string(run_case(data.slice(start, i).to_string()))
          sb.write_string("\n")
        }
        start = i + 1
      }
      i = i + 1
    }
    match fs_write_bytes(world, args[3], sb.to_string().to_bytes()) {
      Ok(_) => return 0
      Err(_) => return 3
    }
  }
  if mode == "ocf_read" {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 2
    }
    let mut limits = avro::AvroLimits::default()
    if args.length() > 3 {
      limits = limits.with_max_elements(parse_int(args[3]))
    }
    match avro::read_ocf_with_limits(data, limits) {
      Ok(f) => {
        let mut nodes = 0L
        let mut r = 0
        while r < f.records.length() {
          match f.records[r] {
            avro::AvroValue::Array(xs) => nodes = nodes + xs.length().to_int64()
            avro::AvroValue::Record(fs) =>
            match fs[0] {
              (_, avro::AvroValue::Array(xs)) => nodes = nodes + xs.length().to_int64()
              _ => ()
            }
            _ => ()
          }
          r = r + 1
        }
        io_println(
          world,
          "ok records=" + f.records.length().to_string() + " array_items=" + nodes.to_string(),
        )
        return 0
      }
      Err(e) => {
        io_println(world, "err " + avro::error_message(e))
        return 1
      }
    }
  }
  if mode == "ocf_write_ts" {
    let s = ps(
      "{\"type\":\"record\",\"name\":\"Ev\",\"fields\":[{\"name\":\"at\",\"type\":{\"type\":\"long\",\"logicalType\":\"timestamp-millis\"}},{\"name\":\"id\",\"type\":{\"type\":\"string\",\"logicalType\":\"uuid\"}},{\"name\":\"amt\",\"type\":{\"type\":\"bytes\",\"logicalType\":\"decimal\",\"precision\":9,\"scale\":2}}]}",
    )
    let rec = avro::AvroValue::Record([
      ("at", avro::AvroValue::Long(1700000000123L)),
      ("id", avro::AvroValue::String("0b5e5a40-6e3c-4a7a-9a9e-0e9c5d6a7b8c")),
      ("amt", avro::AvroValue::Bytes(unhex("3039"))),
    ])
    match avro::write_ocf(s, [rec], avro::OcfOptions::default()) {
      Ok(b) =>
      match fs_write_bytes(world, args[2], b) {
        Ok(_) => return 0
        Err(_) => return 3
      }
      Err(e) => {
        io_println(world, "err " + avro::error_message(e))
        return 1
      }
    }
  }
  if mode == "deep_list" {
    let n = parse_int(args[2])
    let depth = parse_int(args[3])
    let limits = avro::AvroLimits::default().with_max_depth(depth)
    let s = ps(list_schema())
    let mut v = avro::AvroValue::Union(0, avro::AvroValue::Null)
    let mut i = 0
    while i < n {
      v = avro::AvroValue::Union(
        1,
        avro::AvroValue::Record([("v", avro::AvroValue::Long(i.to_int64())), ("next", v)]),
      )
      i = i + 1
    }
    let head = match v {
      avro::AvroValue::Union(_, r) => r
      _ => v
    }
    let enc = match avro::encode_datum_with_limits(s, head, limits) {
      Ok(b) => b
      Err(e) => {
        io_println(world, "encode err " + avro::error_message(e))
        return 1
      }
    }
    match avro::decode_datum_with_limits(s, enc, limits) {
      Ok(_) => io_println(world, "ok nodes=" + n.to_string() + " bytes=" + enc.length().to_string())
      Err(e) => {
        io_println(world, "decode err " + avro::error_message(e))
        return 1
      }
    }
    return 0
  }
  if mode == "deep_list_dec" {
    // decode-only: attacker-supplied bytes of an n-node list (v=0, next=branch 1) ... (v=0, null)
    let n = parse_int(args[2])
    let limits = avro::AvroLimits::default().with_max_depth(parse_int(args[3]))
    let s = ps(list_schema())
    let data = Bytes::new(2 * n + 2)
    let mut i = 0
    while i < n {
      data[2 * i + 1] = (2).to_byte()
      i = i + 1
    }
    match avro::decode_datum_with_limits(s, data, limits) {
      Ok(_) => io_println(world, "ok nodes=" + (n + 1).to_string())
      Err(e) => {
        io_println(world, "err " + avro::error_message(e))
        return 1
      }
    }
    return 0
  }
  if mode == "decode_json_file" {
    let sj = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => return 2
    }
    let js = match fs_read_bytes(world, args[3]) {
      Ok(b) => b.to_string()
      Err(_) => return 2
    }
    let limits = avro::AvroLimits::default().with_max_schema_types(1000000)
    let s = match avro::parse_schema_with_limits(sj, limits) {
      Ok(x) => x
      Err(e) => {
        io_println(world, "schema err " + avro::error_message(e))
        return 1
      }
    }
    match avro::decode_json(s, js) {
      Ok(_) => io_println(world, "ok")
      Err(e) => {
        io_println(world, "err " + avro::error_message(e))
        return 1
      }
    }
    return 0
  }
  if mode == "deep_schema" {
    let n = parse_int(args[2])
    let depth = parse_int(args[3])
    let sb = StringBuilder::new()
    let mut i = 0
    while i < n {
      sb.write_string("{\"type\":\"array\",\"items\":")
      i = i + 1
    }
    sb.write_string("\"int\"")
    i = 0
    while i < n {
      sb.write_string("}")
      i = i + 1
    }
    let limits = avro::AvroLimits::default().with_max_depth(depth).with_max_schema_types(n + 16)
    match avro::parse_schema_with_limits(sb.to_string(), limits) {
      Ok(s) => io_println(world, "ok nodes=" + s.nodes.length().to_string() + " pcf_len=" + avro::canonical_form(s).length().to_string())
      Err(e) => {
        io_println(world, "err " + avro::error_message(e))
        return 1
      }
    }
    return 0
  }
  io_eprintln(world, "unknown mode")
  2
}

///|
fn ps(src : String) -> avro::Schema {
  match avro::parse_schema(src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "schema: " + avro::error_message(e))
      avro::Schema::{ root: 0, nodes: [], named_indices: [] }
    }
  }
}
