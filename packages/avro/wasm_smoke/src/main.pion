///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/avro`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "avro"

fn fnv1a_64_bytes(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn fnv1a_64_str(s : String) -> UInt64 {
  fnv1a_64_bytes(s.to_bytes())
}

fn hex_u64(v : UInt64) -> String {
  let lut = "0123456789abcdef"
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    out[i] = lut.code_unit_at(nib).to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

pub fn main(world : World) -> Int {
  let v1_src =
  "{\"type\":\"record\",\"name\":\"Event\",\"namespace\":\"com.smoke\",\"fields\":[" +
  "{\"name\":\"id\",\"type\":\"int\"}," +
  "{\"name\":\"score\",\"type\":\"float\"}," +
  "{\"name\":\"tags\",\"type\":{\"type\":\"array\",\"items\":\"string\"}}," +
  "{\"name\":\"attrs\",\"type\":{\"type\":\"map\",\"values\":[\"null\",\"long\"]}}," +
  "{\"name\":\"payload\",\"type\":[\"null\",\"bytes\"]}" +
  "]}"
  let v2_src =
  "{\"type\":\"record\",\"name\":\"Event\",\"namespace\":\"com.smoke\",\"fields\":[" +
  "{\"name\":\"tags\",\"type\":{\"type\":\"array\",\"items\":\"string\"}}," +
  "{\"name\":\"id\",\"type\":\"long\"}," +
  "{\"name\":\"score\",\"type\":\"double\"}," +
  "{\"name\":\"version\",\"type\":\"int\",\"default\":2}" +
  "]}"

  let s1 = match avro::parse_schema(v1_src) {
    Ok(s) => s
    Err(_) => return 1
  }
  let s2 = match avro::parse_schema(v2_src) {
    Ok(s) => s
    Err(_) => return 2
  }
  let fp1 = avro::fingerprint_rabin_hex(s1)
  let fp2 = avro::fingerprint_rabin_hex(s2)

  let raw_pay = Bytes::new(4)
  raw_pay[0] = 0xDE.to_byte()
  raw_pay[1] = 0xAD.to_byte()
  raw_pay[2] = 0xBE.to_byte()
  raw_pay[3] = 0xEF.to_byte()

  let rec = avro::AvroValue::Record([
    ("id", avro::AvroValue::Int(42)),
    ("score", avro::AvroValue::Float32(3.5)),
    ("tags", avro::AvroValue::Array([avro::AvroValue::String("avro"), avro::AvroValue::String("pion")])),
    (
      "attrs",
      avro::AvroValue::Map([
        ("ts", avro::AvroValue::Union(1, avro::AvroValue::Long(1700000000L))),
        ("nil", avro::AvroValue::Union(0, avro::AvroValue::Null)),
      ]),
    ),
    ("payload", avro::AvroValue::Union(1, avro::AvroValue::Bytes(raw_pay))),
  ])

  let bin = match avro::encode_datum(s1, rec) {
    Ok(b) => b
    Err(_) => return 3
  }
  let dec = match avro::decode_datum(s1, bin) {
    Ok(v) => v
    Err(_) => return 4
  }
  if !avro::avro_value_eq(rec, dec) {
    return 5
  }

  let js = match avro::encode_json(s1, rec) {
    Ok(s) => s
    Err(_) => return 6
  }
  let jdec = match avro::decode_json(s1, js) {
    Ok(v) => v
    Err(_) => return 7
  }
  if !avro::avro_value_eq(rec, jdec) {
    return 8
  }

  let evolved = match avro::decode_datum_resolved(s1, s2, bin) {
    Ok(v) => v
    Err(_) => return 9
  }
  let evolved_bin = match avro::encode_datum(s2, evolved) {
    Ok(b) => b
    Err(_) => return 10
  }

  let ocf_bytes = match avro::write_ocf(
    s1,
    [rec, rec, rec],
    avro::OcfOptions::default().with_codec(avro::OcfCodec::Deflate).with_block_size(2),
  ) {
    Ok(b) => b
    Err(_) => return 11
  }
  let ocf_read = match avro::read_ocf_resolved(ocf_bytes, s2, avro::AvroLimits::default()) {
    Ok(f) => f
    Err(_) => return 12
  }
  if ocf_read.records.length() != 3 || !avro::avro_value_eq(ocf_read.records[0], evolved) {
    return 13
  }

  io_println(world, "avro_wasm_smoke:ok")
  io_println(
    world,
    "fp1=" + fp1 +
    " fp2=" + fp2 +
    " bin_fnv64=" + hex_u64(fnv1a_64_bytes(bin)) +
    " json_fnv64=" + hex_u64(fnv1a_64_str(js)) +
    " evolved_fnv64=" + hex_u64(fnv1a_64_bytes(evolved_bin)) +
    " ocf_bytes=" + ocf_bytes.length().to_string(),
  )
  0
}
