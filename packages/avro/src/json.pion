///| Apache Avro 1.11.1 JSON datum encoder/decoder and strict internal RFC 8259 JSON parser.

///| Internal JSON value AST used by both schema parsing and Avro JSON datum codecs.
enum JsonVal {
  JNull
  JBool(Bool)
  JInt(Int64)
  JFloat(Double)
  JStr(String)
  JArr(Array[JsonVal])
  JObj(Array[(String, JsonVal)])
}

struct JsonParser {
  data : Bytes
  len : Int
  mut pos : Int
  max_depth : Int
  mut depth : Int
}

fn JsonParser::new(src : String, max_depth : Int) -> JsonParser {
  let b = src.to_bytes()
  JsonParser::{ data: b, len: b.length(), pos: 0, max_depth: max_depth, depth: 0 }
}

fn jp_skip_ws(p : JsonParser) -> Unit {
  while p.pos < p.len {
    let c = p.data[p.pos].to_int()
    if c == 32 || c == 9 || c == 10 || c == 13 {
      p.pos = p.pos + 1
    } else {
      break
    }
  }
}

fn jp_hex_digit(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

fn jp_push_utf8(out : Array[Byte], cp : Int) -> Unit {
  if cp < 0x80 {
    out.push(cp.to_byte())
  } else if cp < 0x800 {
    out.push((0xC0 | (cp >> 6)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    out.push((0xE0 | (cp >> 12)).to_byte())
    out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  } else {
    out.push((0xF0 | (cp >> 18)).to_byte())
    out.push((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn jp_read_hex4(p : JsonParser) -> Result[Int, AvroError] {
  if p.pos + 4 > p.len {
    return Err(AvroError::InvalidJson("truncated \\uXXXX escape"))
  }
  let h0 = jp_hex_digit(p.data[p.pos].to_int())
  let h1 = jp_hex_digit(p.data[p.pos + 1].to_int())
  let h2 = jp_hex_digit(p.data[p.pos + 2].to_int())
  let h3 = jp_hex_digit(p.data[p.pos + 3].to_int())
  if h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0 {
    return Err(AvroError::InvalidJson("invalid hex digit in \\uXXXX escape"))
  }
  p.pos = p.pos + 4
  Ok((h0 << 12) | (h1 << 8) | (h2 << 4) | h3)
}

fn jp_parse_string(p : JsonParser) -> Result[String, AvroError] {
  if p.pos >= p.len || p.data[p.pos].to_int() != 34 {
    return Err(AvroError::InvalidJson("expected '\"'"))
  }
  p.pos = p.pos + 1
  let start = p.pos
  let mut has_escape = false
  let mut scan = start
  while scan < p.len {
    let b = p.data[scan].to_int()
    if b == 34 {
      if !has_escape {
        let sl = p.data.slice(start, scan)
        if !is_valid_utf8_range(sl, 0, sl.length()) {
          return Err(AvroError::InvalidUtf8("invalid UTF-8 in JSON string"))
        }
        p.pos = scan + 1
        return Ok(sl.to_string())
      }
      break
    }
    if b == 92 {
      has_escape = true
      break
    }
    if b < 0x20 {
      return Err(AvroError::InvalidJson("unescaped control character in JSON string"))
    }
    scan = scan + 1
  }
  let out : Array[Byte] = []
  let mut k = start
  while k < scan {
    out.push(p.data[k])
    k = k + 1
  }
  p.pos = scan
  while p.pos < p.len {
    let b = p.data[p.pos].to_int()
    if b == 34 {
      p.pos = p.pos + 1
      let buf = Bytes::new(out.length())
      let mut i = 0
      while i < out.length() {
        buf[i] = out[i]
        i = i + 1
      }
      if !is_valid_utf8_range(buf, 0, buf.length()) {
        return Err(AvroError::InvalidUtf8("invalid UTF-8 in JSON string"))
      }
      return Ok(buf.to_string())
    }
    if b == 92 {
      p.pos = p.pos + 1
      if p.pos >= p.len {
        return Err(AvroError::InvalidJson("unterminated escape sequence"))
      }
      let esc = p.data[p.pos].to_int()
      p.pos = p.pos + 1
      if esc == 34 {
        out.push(34.to_byte())
      } else if esc == 92 {
        out.push(92.to_byte())
      } else if esc == 47 {
        out.push(47.to_byte())
      } else if esc == 98 {
        out.push(8.to_byte())
      } else if esc == 102 {
        out.push(12.to_byte())
      } else if esc == 110 {
        out.push(10.to_byte())
      } else if esc == 114 {
        out.push(13.to_byte())
      } else if esc == 116 {
        out.push(9.to_byte())
      } else if esc == 117 {
        let u1 = match jp_read_hex4(p) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if u1 >= 0xD800 && u1 <= 0xDBFF {
          if p.pos + 2 > p.len || p.data[p.pos].to_int() != 92 || p.data[p.pos + 1].to_int() != 117 {
            return Err(AvroError::InvalidJson("lone high surrogate in JSON string"))
          }
          p.pos = p.pos + 2
          let u2 = match jp_read_hex4(p) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if u2 < 0xDC00 || u2 > 0xDFFF {
            return Err(AvroError::InvalidJson("invalid low surrogate in JSON string"))
          }
          let cp = 0x10000 + (((u1 - 0xD800) << 10) | (u2 - 0xDC00))
          jp_push_utf8(out, cp)
        } else if u1 >= 0xDC00 && u1 <= 0xDFFF {
          return Err(AvroError::InvalidJson("lone low surrogate in JSON string"))
        } else {
          jp_push_utf8(out, u1)
        }
      } else {
        return Err(AvroError::InvalidJson("unknown escape character"))
      }
    } else if b < 0x20 {
      return Err(AvroError::InvalidJson("unescaped control character in JSON string"))
    } else {
      out.push(p.data[p.pos])
      p.pos = p.pos + 1
    }
  }
  Err(AvroError::InvalidJson("unterminated JSON string"))
}

fn jp_parse_number(p : JsonParser) -> Result[JsonVal, AvroError] {
  let start = p.pos
  let mut neg = false
  if p.pos < p.len && p.data[p.pos].to_int() == 45 {
    neg = true
    p.pos = p.pos + 1
  }
  if p.pos >= p.len {
    return Err(AvroError::InvalidJson("unexpected EOF in number"))
  }
  let first = p.data[p.pos].to_int()
  if first < 48 || first > 57 {
    return Err(AvroError::InvalidJson("invalid number"))
  }
  if first == 48 {
    p.pos = p.pos + 1
    if p.pos < p.len {
      let next = p.data[p.pos].to_int()
      if next >= 48 && next <= 57 {
        return Err(AvroError::InvalidJson("leading zero in JSON number"))
      }
    }
  } else {
    while p.pos < p.len {
      let c = p.data[p.pos].to_int()
      if c >= 48 && c <= 57 {
        p.pos = p.pos + 1
      } else {
        break
      }
    }
  }
  let mut is_float = false
  if p.pos < p.len && p.data[p.pos].to_int() == 46 {
    is_float = true
    p.pos = p.pos + 1
    if p.pos >= p.len || p.data[p.pos].to_int() < 48 || p.data[p.pos].to_int() > 57 {
      return Err(AvroError::InvalidJson("missing fractional digits"))
    }
    while p.pos < p.len {
      let c = p.data[p.pos].to_int()
      if c >= 48 && c <= 57 {
        p.pos = p.pos + 1
      } else {
        break
      }
    }
  }
  if p.pos < p.len && (p.data[p.pos].to_int() == 101 || p.data[p.pos].to_int() == 69) {
    is_float = true
    p.pos = p.pos + 1
    if p.pos < p.len && (p.data[p.pos].to_int() == 43 || p.data[p.pos].to_int() == 45) {
      p.pos = p.pos + 1
    }
    if p.pos >= p.len || p.data[p.pos].to_int() < 48 || p.data[p.pos].to_int() > 57 {
      return Err(AvroError::InvalidJson("missing exponent digits"))
    }
    while p.pos < p.len {
      let c = p.data[p.pos].to_int()
      if c >= 48 && c <= 57 {
        p.pos = p.pos + 1
      } else {
        break
      }
    }
  }
  let tok = p.data.slice(start, p.pos).to_string()
  if !is_float {
    // Parse signed Int64 safely
    let mut acc : UInt64 = 0UL
    let mut i = if neg { start + 1 } else { start }
    let mut overflow = false
    let limit : UInt64 = if neg { 9223372036854775808UL } else { 9223372036854775807UL }
    while i < p.pos {
      let d = (p.data[i].to_int() - 48).to_int64().to_uint64()
      if acc > (limit - d) / 10UL {
        overflow = true
        break
      }
      acc = acc * 10UL + d
      i = i + 1
    }
    if !overflow {
      if neg {
        if acc == 0UL {
          return Ok(JsonVal::JFloat(Double::from_bits(0x8000000000000000L)))
        }
        if acc == 9223372036854775808UL {
          return Ok(JsonVal::JInt(-9223372036854775807L - 1L))
        }
        return Ok(JsonVal::JInt(-(acc.to_int64())))
      }
      return Ok(JsonVal::JInt(acc.to_int64()))
    }
  }
  match tok.to_double() {
    Some(d) => Ok(JsonVal::JFloat(if neg && d == 0.0 { Double::from_bits(0x8000000000000000L) } else { d }))
    None => Err(AvroError::InvalidJson("invalid float literal: " + tok))
  }
}

enum JsonParseFrame {
  JpArr(Array[JsonVal])
  JpObj(Array[(String, JsonVal)], String)
}

fn jp_parse_value(p : JsonParser) -> Result[JsonVal, AvroError] {
  let stack : Array[JsonParseFrame] = []
  let mut has_val = false
  let mut out_val = JsonVal::JNull
  while true {
    if !has_val {
      jp_skip_ws(p)
      if p.pos >= p.len {
        return Err(AvroError::InvalidJson("unexpected EOF"))
      }
      let c = p.data[p.pos].to_int()
      if c == 110 {
        if p.pos + 4 <= p.len &&
        p.data[p.pos + 1].to_int() == 117 &&
        p.data[p.pos + 2].to_int() == 108 &&
        p.data[p.pos + 3].to_int() == 108 {
          p.pos = p.pos + 4
          out_val = JsonVal::JNull
          has_val = true
        } else {
          return Err(AvroError::InvalidJson("expected 'null'"))
        }
      } else if c == 116 {
        if p.pos + 4 <= p.len &&
        p.data[p.pos + 1].to_int() == 114 &&
        p.data[p.pos + 2].to_int() == 117 &&
        p.data[p.pos + 3].to_int() == 101 {
          p.pos = p.pos + 4
          out_val = JsonVal::JBool(true)
          has_val = true
        } else {
          return Err(AvroError::InvalidJson("expected 'true'"))
        }
      } else if c == 102 {
        if p.pos + 5 <= p.len &&
        p.data[p.pos + 1].to_int() == 97 &&
        p.data[p.pos + 2].to_int() == 108 &&
        p.data[p.pos + 3].to_int() == 115 &&
        p.data[p.pos + 4].to_int() == 101 {
          p.pos = p.pos + 5
          out_val = JsonVal::JBool(false)
          has_val = true
        } else {
          return Err(AvroError::InvalidJson("expected 'false'"))
        }
      } else if c == 34 {
        match jp_parse_string(p) {
          Ok(s) => {
            out_val = JsonVal::JStr(s)
            has_val = true
          }
          Err(e) => return Err(e)
        }
      } else if c == 91 {
        if stack.length() >= p.max_depth {
          return Err(AvroError::LimitExceeded("JSON nesting depth exceeded"))
        }
        p.pos = p.pos + 1
        jp_skip_ws(p)
        if p.pos < p.len && p.data[p.pos].to_int() == 93 {
          p.pos = p.pos + 1
          out_val = JsonVal::JArr([])
          has_val = true
        } else {
          stack.push(JsonParseFrame::JpArr([]))
        }
      } else if c == 123 {
        if stack.length() >= p.max_depth {
          return Err(AvroError::LimitExceeded("JSON nesting depth exceeded"))
        }
        p.pos = p.pos + 1
        jp_skip_ws(p)
        if p.pos < p.len && p.data[p.pos].to_int() == 125 {
          p.pos = p.pos + 1
          out_val = JsonVal::JObj([])
          has_val = true
        } else {
          let key = match jp_parse_string(p) {
            Ok(k) => k
            Err(e) => return Err(e)
          }
          jp_skip_ws(p)
          if p.pos >= p.len || p.data[p.pos].to_int() != 58 {
            return Err(AvroError::InvalidJson("expected ':' after object key"))
          }
          p.pos = p.pos + 1
          stack.push(JsonParseFrame::JpObj([], key))
        }
      } else if c == 45 || (c >= 48 && c <= 57) {
        match jp_parse_number(p) {
          Ok(nv) => {
            out_val = nv
            has_val = true
          }
          Err(e) => return Err(e)
        }
      } else {
        return Err(AvroError::InvalidJson("unexpected character in JSON"))
      }
    } else {
      match stack.pop() {
        None => return Ok(out_val)
        Some(JsonParseFrame::JpArr(items)) => {
          items.push(out_val)
          jp_skip_ws(p)
          if p.pos >= p.len {
            return Err(AvroError::InvalidJson("unterminated JSON array"))
          }
          let sep = p.data[p.pos].to_int()
          if sep == 93 {
            p.pos = p.pos + 1
            out_val = JsonVal::JArr(items)
          } else if sep == 44 {
            p.pos = p.pos + 1
            stack.push(JsonParseFrame::JpArr(items))
            has_val = false
          } else {
            return Err(AvroError::InvalidJson("expected ',' or ']' in JSON array"))
          }
        }
        Some(JsonParseFrame::JpObj(entries, key)) => {
          entries.push((key, out_val))
          jp_skip_ws(p)
          if p.pos >= p.len {
            return Err(AvroError::InvalidJson("unterminated JSON object"))
          }
          let sep = p.data[p.pos].to_int()
          if sep == 125 {
            p.pos = p.pos + 1
            out_val = JsonVal::JObj(entries)
          } else if sep == 44 {
            p.pos = p.pos + 1
            jp_skip_ws(p)
            let next_key = match jp_parse_string(p) {
              Ok(k) => k
              Err(e) => return Err(e)
            }
            jp_skip_ws(p)
            if p.pos >= p.len || p.data[p.pos].to_int() != 58 {
              return Err(AvroError::InvalidJson("expected ':' after object key"))
            }
            p.pos = p.pos + 1
            stack.push(JsonParseFrame::JpObj(entries, next_key))
            has_val = false
          } else {
            return Err(AvroError::InvalidJson("expected ',' or '}' in JSON object"))
          }
        }
      }
    }
  }
  Ok(out_val)
}

fn json_parse(src : String, max_depth : Int) -> Result[JsonVal, AvroError] {
  let p = JsonParser::new(src, max_depth)
  let v = match jp_parse_value(p) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  jp_skip_ws(p)
  if p.pos != p.len {
    return Err(AvroError::InvalidJson("trailing characters after JSON value"))
  }
  Ok(v)
}

fn json_obj_get(entries : Array[(String, JsonVal)], key : String) -> Option[JsonVal] {
  let mut i = 0
  while i < entries.length() {
    let (k, v) = entries[i]
    if k == key {
      return Some(v)
    }
    i = i + 1
  }
  None
}

///| Write a JSON-escaped string (with surrounding quotes) to `sb`.
fn json_write_string(sb : StringBuilder, s : String) -> Unit {
  let lut = "0123456789abcdef"
  sb.write_string("\"")
  let b = s.to_bytes()
  let n = b.length()
  let mut i = 0
  let mut seg_start = 0
  while i < n {
    let c = b[i].to_int()
    if c == 34 || c == 92 || c < 0x20 {
      if i > seg_start {
        sb.write_string(b.slice(seg_start, i).to_string())
      }
      if c == 34 {
        sb.write_string("\\\"")
      } else if c == 92 {
        sb.write_string("\\\\")
      } else if c == 8 {
        sb.write_string("\\b")
      } else if c == 12 {
        sb.write_string("\\f")
      } else if c == 10 {
        sb.write_string("\\n")
      } else if c == 13 {
        sb.write_string("\\r")
      } else if c == 9 {
        sb.write_string("\\t")
      } else {
        let esc = Bytes::new(6)
        esc[0] = b'\\'
        esc[1] = b'u'
        esc[2] = b'0'
        esc[3] = b'0'
        esc[4] = lut.code_unit_at((c >> 4) & 15).to_byte()
        esc[5] = lut.code_unit_at(c & 15).to_byte()
        sb.write_string(esc.to_string())
      }
      seg_start = i + 1
    }
    i = i + 1
  }
  if seg_start < n {
    sb.write_string(b.slice(seg_start, n).to_string())
  }
  sb.write_string("\"")
}

///| Write Avro `bytes`/`fixed` as JSON string using ISO-8859-1 code points U+0000..U+00FF.
fn json_write_avro_bytes(sb : StringBuilder, data : Bytes) -> Unit {
  let lut = "0123456789abcdef"
  sb.write_string("\"")
  let n = data.length()
  let mut i = 0
  while i < n {
    let b = data[i].to_int()
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 8 {
      sb.write_string("\\b")
    } else if b == 12 {
      sb.write_string("\\f")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b < 0x20 || b >= 0x7F {
      let esc = Bytes::new(6)
      esc[0] = b'\\'
      esc[1] = b'u'
      esc[2] = b'0'
      esc[3] = b'0'
      esc[4] = lut.code_unit_at((b >> 4) & 15).to_byte()
      esc[5] = lut.code_unit_at(b & 15).to_byte()
      sb.write_string(esc.to_string())
    } else {
      let ch = Bytes::new(1)
      ch[0] = b.to_byte()
      sb.write_string(ch.to_string())
    }
    i = i + 1
  }
  sb.write_string("\"")
}

///| Decode a JSON string representing Avro `bytes`/`fixed` (each Unicode code point must be <= 0xFF).
fn json_str_to_avro_bytes(s : String) -> Result[Bytes, AvroError] {
  let raw = s.to_bytes()
  let n = raw.length()
  let out : Array[Byte] = []
  let mut i = 0
  while i < n {
    let b0 = raw[i].to_int()
    if b0 < 0x80 {
      out.push(b0.to_byte())
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xC3 && i + 1 < n {
      let b1 = raw[i + 1].to_int()
      let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
      if cp > 0xFF {
        return Err(AvroError::InvalidJson("bytes/fixed JSON string contains code point > U+00FF"))
      }
      out.push(cp.to_byte())
      i = i + 2
    } else {
      return Err(AvroError::InvalidJson("bytes/fixed JSON string contains code point > U+00FF"))
    }
  }
  let res = Bytes::new(out.length())
  let mut k = 0
  while k < out.length() {
    res[k] = out[k]
    k = k + 1
  }
  Ok(res)
}

///| Return the Avro JSON union branch type key name for a schema node.
fn schema_union_branch_name(schema : Schema, id : Int) -> String {
  let rid = schema.resolve_id(id)
  match schema.nodes[rid].kind {
    SchemaKind::Null => "null"
    SchemaKind::Boolean => "boolean"
    SchemaKind::Int => "int"
    SchemaKind::Long => "long"
    SchemaKind::Float => "float"
    SchemaKind::Double => "double"
    SchemaKind::Bytes => "bytes"
    SchemaKind::String => "string"
    SchemaKind::Array(_) => "array"
    SchemaKind::Map(_) => "map"
    SchemaKind::Record(name, _, _) => name
    SchemaKind::Enum(name, _, _, _) => name
    SchemaKind::Fixed(name, _, _) => name
    SchemaKind::Union(_) => "union"
    SchemaKind::Ref(_) => "ref"
  }
}

fn json_write_double(sb : StringBuilder, v : Double) -> Unit {
  let bits = v.to_bits()
  let exp = (bits >> 52) & 0x7FFL
  let frac = bits & 0x000FFFFFFFFFFFFFL
  if exp == 0x7FFL {
    if frac != 0L {
      sb.write_string("\"NaN\"")
    } else if bits < 0L {
      sb.write_string("\"-Infinity\"")
    } else {
      sb.write_string("\"Infinity\"")
    }
    return
  }
  if bits == 0x8000000000000000L {
    sb.write_string("-0.0")
    return
  }
  sb.write_string(v.to_string())
}

enum JsonEncFrame {
  JeNode(Int, AvroValue, Int, Bool)
  JeLit(String)
  JeArr(Int, Array[AvroValue], Int, Int, Bool)
  JeMap(Int, Array[(String, AvroValue)], Int, Int, Bool)
  JeRec(Array[RecordField], Array[(String, AvroValue)], Int, Int, Bool)
}

fn encode_json_node_impl(
  sb : StringBuilder,
  schema : Schema,
  root_node_id : Int,
  root_value : AvroValue,
  limits : AvroLimits,
  init_depth : Int,
  is_default : Bool,
) -> Result[Unit, AvroError] {
  let stack : Array[JsonEncFrame] = [JsonEncFrame::JeNode(root_node_id, root_value, init_depth, is_default)]
  while stack.length() > 0 {
    let frame = match stack.pop() {
      Some(f) => f
      None => break
    }
    match frame {
      JsonEncFrame::JeLit(s) => sb.write_string(s)
      JsonEncFrame::JeArr(item_id, items, idx, depth, is_def) =>
      if idx < items.length() {
        if idx > 0 {
          sb.write_string(",")
        }
        if idx + 1 < items.length() {
          stack.push(JsonEncFrame::JeArr(item_id, items, idx + 1, depth, is_def))
        }
        stack.push(JsonEncFrame::JeNode(item_id, items[idx], depth, is_def))
      }
      JsonEncFrame::JeMap(val_id, entries, idx, depth, is_def) =>
      if idx < entries.length() {
        if idx > 0 {
          sb.write_string(",")
        }
        let (k, v) = entries[idx]
        json_write_string(sb, k)
        sb.write_string(":")
        if idx + 1 < entries.length() {
          stack.push(JsonEncFrame::JeMap(val_id, entries, idx + 1, depth, is_def))
        }
        stack.push(JsonEncFrame::JeNode(val_id, v, depth, is_def))
      }
      JsonEncFrame::JeRec(fields, vals, idx, depth, is_def) =>
      if idx < fields.length() {
        if idx > 0 {
          sb.write_string(",")
        }
        let f = fields[idx]
        let (vk, vv) = vals[idx]
        if vk != f.name {
          return Err(AvroError::SchemaMismatch("record field name mismatch: " + vk))
        }
        json_write_string(sb, f.name)
        sb.write_string(":")
        if idx + 1 < fields.length() {
          stack.push(JsonEncFrame::JeRec(fields, vals, idx + 1, depth, is_def))
        }
        stack.push(JsonEncFrame::JeNode(f.schema_id, vv, depth, is_def))
      }
      JsonEncFrame::JeNode(node_id, value, depth, is_def) => {
        if depth > limits.max_depth {
          return Err(AvroError::LimitExceeded("max_depth exceeded in encode_json"))
        }
        let rid = schema.resolve_id(node_id)
        match (schema.nodes[rid].kind, value) {
          (SchemaKind::Null, AvroValue::Null) => sb.write_string("null")
          (SchemaKind::Boolean, AvroValue::Boolean(b)) => sb.write_string(if b { "true" } else { "false" })
          (SchemaKind::Int, AvroValue::Int(v)) => sb.write_string(v.to_string())
          (SchemaKind::Long, AvroValue::Long(v)) => sb.write_string(v.to_string())
          (SchemaKind::Float, AvroValue::Float32(v)) => json_write_double(sb, v)
          (SchemaKind::Double, AvroValue::Float64(v)) => json_write_double(sb, v)
          (SchemaKind::Bytes, AvroValue::Bytes(b)) => json_write_avro_bytes(sb, b)
          (SchemaKind::String, AvroValue::String(s)) => json_write_string(sb, s)
          (SchemaKind::Fixed(_, _, size), AvroValue::Fixed(b)) => {
            if b.length() != size {
              return Err(AvroError::SchemaMismatch("fixed length mismatch"))
            }
            json_write_avro_bytes(sb, b)
          }
          (SchemaKind::Enum(_, _, symbols, _), AvroValue::Enum(idx, sym)) => {
            if idx < 0 || idx >= symbols.length() || symbols[idx] != sym {
              return Err(AvroError::SchemaMismatch("invalid enum symbol: " + sym))
            }
            json_write_string(sb, sym)
          }
          (SchemaKind::Array(item_id), AvroValue::Array(items)) => {
            sb.write_string("[")
            stack.push(JsonEncFrame::JeLit("]"))
            if items.length() > 0 {
              stack.push(JsonEncFrame::JeArr(item_id, items, 0, depth + 1, is_def))
            }
          }
          (SchemaKind::Map(val_id), AvroValue::Map(entries)) => {
            sb.write_string("{")
            stack.push(JsonEncFrame::JeLit("}"))
            if entries.length() > 0 {
              stack.push(JsonEncFrame::JeMap(val_id, entries, 0, depth + 1, is_def))
            }
          }
          (SchemaKind::Record(_, _, fields), AvroValue::Record(vals)) => {
            if vals.length() != fields.length() {
              return Err(AvroError::SchemaMismatch("record field count mismatch"))
            }
            sb.write_string("{")
            stack.push(JsonEncFrame::JeLit("}"))
            if fields.length() > 0 {
              stack.push(JsonEncFrame::JeRec(fields, vals, 0, depth + 1, is_def))
            }
          }
          (SchemaKind::Union(branches), AvroValue::Union(idx, inner)) => {
            if idx < 0 || idx >= branches.length() {
              return Err(AvroError::SchemaMismatch("union branch index out of range"))
            }
            let bid = schema.resolve_id(branches[idx])
            if is_def {
              stack.push(JsonEncFrame::JeNode(bid, inner, depth + 1, true))
            } else {
              match (schema.nodes[bid].kind, inner) {
                (SchemaKind::Null, AvroValue::Null) => sb.write_string("null")
                _ => {
                  let bname = schema_union_branch_name(schema, bid)
                  sb.write_string("{")
                  json_write_string(sb, bname)
                  sb.write_string(":")
                  stack.push(JsonEncFrame::JeLit("}"))
                  stack.push(JsonEncFrame::JeNode(bid, inner, depth + 1, false))
                }
              }
            }
          }
          _ => return Err(AvroError::SchemaMismatch("value does not match schema in encode_json"))
        }
      }
    }
  }
  Ok(())
}

fn encode_json_node(
  sb : StringBuilder,
  schema : Schema,
  node_id : Int,
  value : AvroValue,
  limits : AvroLimits,
  depth : Int,
) -> Result[Unit, AvroError] {
  encode_json_node_impl(sb, schema, node_id, value, limits, depth, false)
}

fn parse_special_json_float(s : String) -> Option[Double] {
  if s == "NaN" {
    Some(Double::from_bits(0x7FF8000000000000L))
  } else if s == "Infinity" || s == "+Infinity" {
    Some(Double::from_bits(0x7FF0000000000000L))
  } else if s == "-Infinity" {
    Some(Double::from_bits(0xFFF0000000000000L))
  } else {
    None
  }
}

enum JsonDecFrame {
  JdArr(Int, Array[JsonVal], Array[AvroValue], Int)
  JdMap(Int, Array[(String, JsonVal)], Array[(String, AvroValue)], Map[String, Int], Int)
  JdRec(Array[RecordField], Array[(String, JsonVal)], Map[String, Int], Array[(String, AvroValue)], Int)
  JdUnion(Int)
}

///| Convert a parsed `JsonVal` to an `AvroValue` according to `schema` (iterative, O(1) host stack).
fn json_val_to_avro(
  schema : Schema,
  root_node_id : Int,
  root_jv : JsonVal,
  limits : AvroLimits,
  init_depth : Int,
  is_default : Bool,
) -> Result[AvroValue, AvroError] {
  let stack : Array[JsonDecFrame] = []
  let mut cur_id = root_node_id
  let mut cur_jv = root_jv
  let mut has_val = false
  let mut out_val = AvroValue::Null
  while true {
    if !has_val {
      if init_depth + stack.length() > limits.max_depth {
        return Err(AvroError::LimitExceeded("max_depth exceeded in decode_json"))
      }
      let rid = schema.resolve_id(cur_id)
      match schema.nodes[rid].kind {
        SchemaKind::Null =>
        match cur_jv {
          JsonVal::JNull => {
            out_val = AvroValue::Null
            has_val = true
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON null"))
        }
        SchemaKind::Boolean =>
        match cur_jv {
          JsonVal::JBool(b) => {
            out_val = AvroValue::Boolean(b)
            has_val = true
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON boolean"))
        }
        SchemaKind::Int =>
        match cur_jv {
          JsonVal::JInt(v) => {
            if v < -2147483648L || v > 2147483647L {
              return Err(AvroError::InvalidValue("int out of 32-bit range"))
            }
            out_val = AvroValue::Int(v.to_int())
            has_val = true
          }
          JsonVal::JFloat(d) =>
          if d.to_bits() == 0x8000000000000000L {
            out_val = AvroValue::Int(0)
            has_val = true
          } else {
            return Err(AvroError::SchemaMismatch("expected JSON integer for int"))
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON integer for int"))
        }
        SchemaKind::Long =>
        match cur_jv {
          JsonVal::JInt(v) => {
            out_val = AvroValue::Long(v)
            has_val = true
          }
          JsonVal::JFloat(d) =>
          if d.to_bits() == 0x8000000000000000L {
            out_val = AvroValue::Long(0L)
            has_val = true
          } else {
            return Err(AvroError::SchemaMismatch("expected JSON integer for long"))
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON integer for long"))
        }
        SchemaKind::Float =>
        match cur_jv {
          JsonVal::JFloat(d) => {
            out_val = AvroValue::Float32(float32_bits_to_double(double_to_float32_bits(d)))
            has_val = true
          }
          JsonVal::JInt(v) => {
            out_val = AvroValue::Float32(float32_bits_to_double(int64_to_float32_bits(v)))
            has_val = true
          }
          JsonVal::JStr(s) =>
          match parse_special_json_float(s) {
            Some(d) => {
              out_val = AvroValue::Float32(float32_bits_to_double(double_to_float32_bits(d)))
              has_val = true
            }
            None => return Err(AvroError::SchemaMismatch("expected JSON number for float"))
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON number for float"))
        }
        SchemaKind::Double =>
        match cur_jv {
          JsonVal::JFloat(d) => {
            out_val = AvroValue::Float64(d)
            has_val = true
          }
          JsonVal::JInt(v) => {
            out_val = AvroValue::Float64(v.to_double())
            has_val = true
          }
          JsonVal::JStr(s) =>
          match parse_special_json_float(s) {
            Some(d) => {
              out_val = AvroValue::Float64(d)
              has_val = true
            }
            None => return Err(AvroError::SchemaMismatch("expected JSON number for double"))
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON number for double"))
        }
        SchemaKind::Bytes =>
        match cur_jv {
          JsonVal::JStr(s) =>
          match json_str_to_avro_bytes(s) {
            Ok(b) => {
              out_val = AvroValue::Bytes(b)
              has_val = true
            }
            Err(e) => return Err(e)
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON string for bytes"))
        }
        SchemaKind::String =>
        match cur_jv {
          JsonVal::JStr(s) => {
            out_val = AvroValue::String(s)
            has_val = true
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON string for string"))
        }
        SchemaKind::Fixed(_, _, size) =>
        match cur_jv {
          JsonVal::JStr(s) =>
          match json_str_to_avro_bytes(s) {
            Ok(b) => {
              if b.length() != size {
                return Err(AvroError::SchemaMismatch("fixed byte length mismatch"))
              }
              out_val = AvroValue::Fixed(b)
              has_val = true
            }
            Err(e) => return Err(e)
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON string for fixed"))
        }
        SchemaKind::Enum(_, _, symbols, _) =>
        match cur_jv {
          JsonVal::JStr(s) => {
            let mut found = -1
            let mut i = 0
            while i < symbols.length() {
              if symbols[i] == s {
                found = i
                break
              }
              i = i + 1
            }
            if found < 0 {
              return Err(AvroError::SchemaMismatch("unknown enum symbol: " + s))
            }
            out_val = AvroValue::Enum(found, s)
            has_val = true
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON string for enum"))
        }
        SchemaKind::Array(item_id) =>
        match cur_jv {
          JsonVal::JArr(items) => {
            if items.length() > limits.max_elements {
              return Err(AvroError::LimitExceeded("array exceeds max_elements"))
            }
            if items.length() == 0 {
              out_val = AvroValue::Array([])
              has_val = true
            } else {
              stack.push(JsonDecFrame::JdArr(item_id, items, [], 0))
              cur_id = item_id
              cur_jv = items[0]
            }
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON array"))
        }
        SchemaKind::Map(val_id) =>
        match cur_jv {
          JsonVal::JObj(entries) => {
            if entries.length() > limits.max_elements {
              return Err(AvroError::LimitExceeded("map exceeds max_elements"))
            }
            if entries.length() == 0 {
              out_val = AvroValue::Map([])
              has_val = true
            } else {
              let (_, ev0) = entries[0]
              stack.push(JsonDecFrame::JdMap(val_id, entries, [], Map::new(), 0))
              cur_id = val_id
              cur_jv = ev0
            }
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON object for map"))
        }
        SchemaKind::Record(_, _, fields) =>
        match cur_jv {
          JsonVal::JObj(entries) => {
            let entry_map : Map[String, Int] = Map::new()
            let mut ei = 0
            while ei < entries.length() {
              let (ek, _) = entries[ei]
              entry_map.set(ek, ei)
              ei = ei + 1
            }
            let out : Array[(String, AvroValue)] = []
            let mut fi = 0
            let mut found_need = false
            while fi < fields.length() {
              let f = fields[fi]
              match entry_map.get(f.name) {
                Some(eidx) => {
                  let (_, fv) = entries[eidx]
                  stack.push(JsonDecFrame::JdRec(fields, entries, entry_map, out, fi))
                  cur_id = f.schema_id
                  cur_jv = fv
                  found_need = true
                  break
                }
                None =>
                match f.default_val {
                  Some(def) => out.push((f.name, def))
                  None => return Err(AvroError::SchemaMismatch("missing required record field: " + f.name))
                }
              }
              fi = fi + 1
            }
            if !found_need {
              out_val = AvroValue::Record(out)
              has_val = true
            }
          }
          _ => return Err(AvroError::SchemaMismatch("expected JSON object for record"))
        }
        SchemaKind::Union(branches) =>
        if is_default {
          if branches.length() == 0 {
            return Err(AvroError::InvalidSchema("empty union"))
          }
          stack.push(JsonDecFrame::JdUnion(0))
          cur_id = branches[0]
        } else {
          match cur_jv {
            JsonVal::JNull => {
              let mut found = -1
              let mut i = 0
              while i < branches.length() {
                let bid = schema.resolve_id(branches[i])
                match schema.nodes[bid].kind {
                  SchemaKind::Null => {
                    found = i
                    break
                  }
                  _ => ()
                }
                i = i + 1
              }
              if found < 0 {
                return Err(AvroError::SchemaMismatch("JSON null not permitted by union"))
              }
              out_val = AvroValue::Union(found, AvroValue::Null)
              has_val = true
            }
            JsonVal::JObj(entries) => {
              if entries.length() != 1 {
                return Err(AvroError::SchemaMismatch("Avro JSON union wrapper must have exactly 1 key"))
              }
              let (bkey, bval) = entries[0]
              let mut found = -1
              let mut found_bid = 0
              let mut i = 0
              while i < branches.length() {
                let bid = schema.resolve_id(branches[i])
                if schema_union_branch_name(schema, bid) == bkey {
                  found = i
                  found_bid = bid
                  break
                }
                i = i + 1
              }
              if found < 0 {
                return Err(AvroError::SchemaMismatch("unknown union branch in JSON: " + bkey))
              }
              stack.push(JsonDecFrame::JdUnion(found))
              cur_id = found_bid
              cur_jv = bval
            }
            _ => return Err(AvroError::SchemaMismatch("expected JSON null or single-key wrapper object for union"))
          }
        }
        SchemaKind::Ref(_) => return Err(AvroError::InvalidSchema("unresolved schema ref"))
      }
    } else {
      match stack.pop() {
        None => return Ok(out_val)
        Some(JsonDecFrame::JdUnion(idx)) => out_val = AvroValue::Union(idx, out_val)
        Some(JsonDecFrame::JdArr(item_id, items, out, idx)) => {
          out.push(out_val)
          let next = idx + 1
          if next < items.length() {
            stack.push(JsonDecFrame::JdArr(item_id, items, out, next))
            cur_id = item_id
            cur_jv = items[next]
            has_val = false
          } else {
            out_val = AvroValue::Array(out)
          }
        }
        Some(JsonDecFrame::JdMap(val_id, entries, out, key_idx, idx)) => {
          let (k, _) = entries[idx]
          match key_idx.get(k) {
            Some(pos) => out[pos] = (k, out_val)
            None => {
              key_idx.set(k, out.length())
              out.push((k, out_val))
            }
          }
          let next = idx + 1
          if next < entries.length() {
            let (_, ev) = entries[next]
            stack.push(JsonDecFrame::JdMap(val_id, entries, out, key_idx, next))
            cur_id = val_id
            cur_jv = ev
            has_val = false
          } else {
            out_val = AvroValue::Map(out)
          }
        }
        Some(JsonDecFrame::JdRec(fields, entries, entry_map, out, idx)) => {
          out.push((fields[idx].name, out_val))
          let mut fi = idx + 1
          let mut found_need = false
          while fi < fields.length() {
            let f = fields[fi]
            match entry_map.get(f.name) {
              Some(eidx) => {
                let (_, fv) = entries[eidx]
                stack.push(JsonDecFrame::JdRec(fields, entries, entry_map, out, fi))
                cur_id = f.schema_id
                cur_jv = fv
                has_val = false
                found_need = true
                break
              }
              None =>
              match f.default_val {
                Some(def) => out.push((f.name, def))
                None => return Err(AvroError::SchemaMismatch("missing required record field: " + f.name))
              }
            }
            fi = fi + 1
          }
          if !found_need {
            out_val = AvroValue::Record(out)
          }
        }
      }
    }
  }
  Ok(out_val)
}

///| Encode an `AvroValue` to Avro JSON format using default limits.
pub fn encode_json(schema : Schema, value : AvroValue) -> Result[String, AvroError] {
  encode_json_with_limits(schema, value, AvroLimits::default())
}

///| Encode an `AvroValue` to Avro JSON format with custom limits.
pub fn encode_json_with_limits(
  schema : Schema,
  value : AvroValue,
  limits : AvroLimits,
) -> Result[String, AvroError] {
  let sb = StringBuilder::new()
  match encode_json_node(sb, schema, schema.root, value, limits, 0) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

///| Decode an Avro JSON datum using default limits.
pub fn decode_json(schema : Schema, json_str : String) -> Result[AvroValue, AvroError] {
  decode_json_with_limits(schema, json_str, AvroLimits::default())
}

///| Decode an Avro JSON datum with custom limits.
pub fn decode_json_with_limits(
  schema : Schema,
  json_str : String,
  limits : AvroLimits,
) -> Result[AvroValue, AvroError] {
  let jv = match json_parse(json_str, limits.max_depth + 4) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  json_val_to_avro(schema, schema.root, jv, limits, 0, false)
}
