///| Apache Avro 1.11.1 Reader/Writer Schema Resolution (Schema Evolution) with pre-compiled plans.

///| Pre-compiled resolution step for a `(writer_node, reader_node)` pair.
enum ResolveOp {
  ExactNull
  ExactBool
  ExactInt
  ExactLong
  ExactFloat
  ExactDouble
  ExactBytes
  ExactString
  ExactFixed(Int)
  PromoteIntToLong
  PromoteIntToFloat
  PromoteIntToDouble
  PromoteLongToFloat
  PromoteLongToDouble
  PromoteFloatToDouble
  PromoteStringToBytes
  PromoteBytesToString
  ResolveEnum(FixedArray[Int], Array[String]) // writer_idx -> reader_idx (-1 if error), reader_symbols
  ResolveArray(Int) // item plan id
  ResolveMap(Int) // value plan id
  ResolveRecord(
    Array[String], // reader field names in reader order
    FixedArray[Int], // for each writer field i: reader slot index (-1 = skip)
    FixedArray[Int], // for each writer field i: plan id (if mapped) or writer field schema_id (if skip)
    Array[(Int, AvroValue)], // (reader slot, default value) for reader fields absent in writer
  )
  ResolveWriterUnion(Array[Int]) // for each writer branch: plan id (-1 if incompatible)
  ResolveReaderUnion(Int, Int) // (matched reader branch index, inner plan id)
  Incompatible(String)
}

///| Pre-compiled schema evolution resolver from `writer` schema to `reader` schema.
pub struct SchemaResolver {
  pub writer : Schema
  pub reader : Schema
  root_plan : Int
  plans : Array[ResolveOp]
}

fn names_match(w_name : String, r_name : String, r_aliases : Array[String]) -> Bool {
  if w_name == r_name {
    return true
  }
  let mut i = 0
  while i < r_aliases.length() {
    if r_aliases[i] == w_name {
      return true
    }
    i = i + 1
  }
  false
}

///| Check if writer node `wid` can match reader node `rid` (exact or promotion).
///| Returns 2 for exact match, 1 for promotion match, 0 for no match.
fn match_score(writer : Schema, wid : Int, reader : Schema, rid : Int) -> Int {
  let w = writer.resolve_id(wid)
  let r = reader.resolve_id(rid)
  match (writer.nodes[w].kind, reader.nodes[r].kind) {
    (SchemaKind::Null, SchemaKind::Null) => 2
    (SchemaKind::Boolean, SchemaKind::Boolean) => 2
    (SchemaKind::Int, SchemaKind::Int) => 2
    (SchemaKind::Long, SchemaKind::Long) => 2
    (SchemaKind::Float, SchemaKind::Float) => 2
    (SchemaKind::Double, SchemaKind::Double) => 2
    (SchemaKind::Bytes, SchemaKind::Bytes) => 2
    (SchemaKind::String, SchemaKind::String) => 2
    (SchemaKind::Int, SchemaKind::Long) => 1
    (SchemaKind::Int, SchemaKind::Float) => 1
    (SchemaKind::Int, SchemaKind::Double) => 1
    (SchemaKind::Long, SchemaKind::Float) => 1
    (SchemaKind::Long, SchemaKind::Double) => 1
    (SchemaKind::Float, SchemaKind::Double) => 1
    (SchemaKind::String, SchemaKind::Bytes) => 1
    (SchemaKind::Bytes, SchemaKind::String) => 1
    (SchemaKind::Array(_), SchemaKind::Array(_)) => 2
    (SchemaKind::Map(_), SchemaKind::Map(_)) => 2
    (SchemaKind::Fixed(wn, _, ws), SchemaKind::Fixed(rn, ra, rs)) =>
    if ws == rs && names_match(wn, rn, ra) { 2 } else { 0 }
    (SchemaKind::Enum(wn, _, _, _), SchemaKind::Enum(rn, ra, _, _)) =>
    if names_match(wn, rn, ra) { 2 } else { 0 }
    (SchemaKind::Record(wn, _, _), SchemaKind::Record(rn, ra, _)) =>
    if names_match(wn, rn, ra) { 2 } else { 0 }
    _ => 0
  }
}

struct PlanCompiler {
  writer : Schema
  reader : Schema
  plans : Array[ResolveOp]
  memo : Array[(Int, Int, Int)] // (wid, rid, plan_id)
}

fn pc_find_memo(c : PlanCompiler, wid : Int, rid : Int) -> Option[Int] {
  let mut i = 0
  while i < c.memo.length() {
    let (w, r, pid) = c.memo[i]
    if w == wid && r == rid {
      return Some(pid)
    }
    i = i + 1
  }
  None
}

fn pc_compile(c : PlanCompiler, wid_raw : Int, rid_raw : Int) -> Result[Int, AvroError] {
  let wid = c.writer.resolve_id(wid_raw)
  let rid = c.reader.resolve_id(rid_raw)
  match pc_find_memo(c, wid, rid) {
    Some(pid) => return Ok(pid)
    None => ()
  }
  let pid = c.plans.length()
  c.plans.push(ResolveOp::Incompatible("pending"))
  c.memo.push((wid, rid, pid))

  let wkind = c.writer.nodes[wid].kind
  let rkind = c.reader.nodes[rid].kind

  // Rule 1: Writer is a Union -> resolve each writer branch against reader
  match wkind {
    SchemaKind::Union(wbranches) => {
      let bplans : Array[Int] = []
      let mut i = 0
      while i < wbranches.length() {
        match pc_compile(c, wbranches[i], rid) {
          Ok(bp) => bplans.push(bp)
          Err(_) => bplans.push(-1)
        }
        i = i + 1
      }
      c.plans[pid] = ResolveOp::ResolveWriterUnion(bplans)
      return Ok(pid)
    }
    _ => ()
  }

  // Rule 2: Reader is a Union (and writer is not) -> find best matching reader branch
  match rkind {
    SchemaKind::Union(rbranches) => {
      let mut best_idx = -1
      let mut best_score = 0
      let mut i = 0
      while i < rbranches.length() {
        let sc = match_score(c.writer, wid, c.reader, rbranches[i])
        if sc > best_score {
          best_score = sc
          best_idx = i
          if sc == 2 {
            break
          }
        }
        i = i + 1
      }
      if best_idx < 0 {
        let msg = "no matching reader union branch for writer schema"
        c.plans[pid] = ResolveOp::Incompatible(msg)
        return Err(AvroError::ResolutionError(msg))
      }
      let inner_pid = match pc_compile(c, wid, rbranches[best_idx]) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      c.plans[pid] = ResolveOp::ResolveReaderUnion(best_idx, inner_pid)
      return Ok(pid)
    }
    _ => ()
  }

  // Rule 3: Concrete writer vs concrete reader
  match (wkind, rkind) {
    (SchemaKind::Null, SchemaKind::Null) => {
      c.plans[pid] = ResolveOp::ExactNull
      Ok(pid)
    }
    (SchemaKind::Boolean, SchemaKind::Boolean) => {
      c.plans[pid] = ResolveOp::ExactBool
      Ok(pid)
    }
    (SchemaKind::Int, SchemaKind::Int) => {
      c.plans[pid] = ResolveOp::ExactInt
      Ok(pid)
    }
    (SchemaKind::Long, SchemaKind::Long) => {
      c.plans[pid] = ResolveOp::ExactLong
      Ok(pid)
    }
    (SchemaKind::Float, SchemaKind::Float) => {
      c.plans[pid] = ResolveOp::ExactFloat
      Ok(pid)
    }
    (SchemaKind::Double, SchemaKind::Double) => {
      c.plans[pid] = ResolveOp::ExactDouble
      Ok(pid)
    }
    (SchemaKind::Bytes, SchemaKind::Bytes) => {
      c.plans[pid] = ResolveOp::ExactBytes
      Ok(pid)
    }
    (SchemaKind::String, SchemaKind::String) => {
      c.plans[pid] = ResolveOp::ExactString
      Ok(pid)
    }
    (SchemaKind::Int, SchemaKind::Long) => {
      c.plans[pid] = ResolveOp::PromoteIntToLong
      Ok(pid)
    }
    (SchemaKind::Int, SchemaKind::Float) => {
      c.plans[pid] = ResolveOp::PromoteIntToFloat
      Ok(pid)
    }
    (SchemaKind::Int, SchemaKind::Double) => {
      c.plans[pid] = ResolveOp::PromoteIntToDouble
      Ok(pid)
    }
    (SchemaKind::Long, SchemaKind::Float) => {
      c.plans[pid] = ResolveOp::PromoteLongToFloat
      Ok(pid)
    }
    (SchemaKind::Long, SchemaKind::Double) => {
      c.plans[pid] = ResolveOp::PromoteLongToDouble
      Ok(pid)
    }
    (SchemaKind::Float, SchemaKind::Double) => {
      c.plans[pid] = ResolveOp::PromoteFloatToDouble
      Ok(pid)
    }
    (SchemaKind::String, SchemaKind::Bytes) => {
      c.plans[pid] = ResolveOp::PromoteStringToBytes
      Ok(pid)
    }
    (SchemaKind::Bytes, SchemaKind::String) => {
      c.plans[pid] = ResolveOp::PromoteBytesToString
      Ok(pid)
    }
    (SchemaKind::Fixed(wn, _, ws), SchemaKind::Fixed(rn, ra, rs)) => {
      if !names_match(wn, rn, ra) || ws != rs {
        return Err(AvroError::ResolutionError("incompatible fixed schemas: " + wn + " vs " + rn))
      }
      c.plans[pid] = ResolveOp::ExactFixed(ws)
      Ok(pid)
    }
    (SchemaKind::Enum(wn, _, wsyms, _), SchemaKind::Enum(rn, ra, rsyms, rdef)) => {
      if !names_match(wn, rn, ra) {
        return Err(AvroError::ResolutionError("incompatible enum names: " + wn + " vs " + rn))
      }
      let def_idx = match rdef {
        None => -1
        Some(ds) => {
          let mut found = -1
          let mut k = 0
          while k < rsyms.length() {
            if rsyms[k] == ds {
              found = k
              break
            }
            k = k + 1
          }
          found
        }
      }
      let sym_map : FixedArray[Int] = FixedArray::make(wsyms.length(), -1)
      let mut i = 0
      while i < wsyms.length() {
        let ws = wsyms[i]
        let mut ridx = -1
        let mut j = 0
        while j < rsyms.length() {
          if rsyms[j] == ws {
            ridx = j
            break
          }
          j = j + 1
        }
        sym_map[i] = if ridx >= 0 { ridx } else { def_idx }
        i = i + 1
      }
      c.plans[pid] = ResolveOp::ResolveEnum(sym_map, rsyms)
      Ok(pid)
    }
    (SchemaKind::Array(witem), SchemaKind::Array(ritem)) => {
      let item_pid = match pc_compile(c, witem, ritem) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      c.plans[pid] = ResolveOp::ResolveArray(item_pid)
      Ok(pid)
    }
    (SchemaKind::Map(wval), SchemaKind::Map(rval)) => {
      let val_pid = match pc_compile(c, wval, rval) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      c.plans[pid] = ResolveOp::ResolveMap(val_pid)
      Ok(pid)
    }
    (SchemaKind::Record(wn, _, wfields), SchemaKind::Record(rn, ra, rfields)) => {
      if !names_match(wn, rn, ra) {
        return Err(AvroError::ResolutionError("incompatible record names: " + wn + " vs " + rn))
      }
      let r_len = rfields.length()
      let w_len = wfields.length()
      let r_names : Array[String] = []
      let r_matched : FixedArray[Bool] = FixedArray::make(r_len, false)
      let mut ri = 0
      while ri < r_len {
        r_names.push(rfields[ri].name)
        ri = ri + 1
      }
      let w_to_r : FixedArray[Int] = FixedArray::make(w_len, -1)
      let w_fplans : FixedArray[Int] = FixedArray::make(w_len, -1)
      let mut wi = 0
      while wi < w_len {
        let wf = wfields[wi]
        let mut target_r = -1
        let mut k = 0
        while k < r_len {
          let rf = rfields[k]
          if rf.name == wf.name || str_array_contains(rf.aliases, wf.name) {
            target_r = k
            break
          }
          k = k + 1
        }
        if target_r >= 0 {
          let fp = match pc_compile(c, wf.schema_id, rfields[target_r].schema_id) {
            Ok(p) => p
            Err(e) => return Err(e)
          }
          w_to_r[wi] = target_r
          w_fplans[wi] = fp
          r_matched[target_r] = true
        } else {
          w_to_r[wi] = -1
          w_fplans[wi] = wf.schema_id
        }
        wi = wi + 1
      }
      let r_defaults : Array[(Int, AvroValue)] = []
      let mut j = 0
      while j < r_len {
        if !r_matched[j] {
          match rfields[j].default_val {
            Some(dv) => r_defaults.push((j, dv))
            None =>
            return Err(
              AvroError::ResolutionError(
                "reader field '" + rfields[j].name + "' missing in writer and has no default",
              ),
            )
          }
        }
        j = j + 1
      }
      c.plans[pid] = ResolveOp::ResolveRecord(r_names, w_to_r, w_fplans, r_defaults)
      Ok(pid)
    }
    _ => Err(AvroError::ResolutionError("incompatible writer and reader schemas"))
  }
}

fn exec_resolve(
  r : BinReader,
  res : SchemaResolver,
  plan_id : Int,
) -> Result[AvroValue, AvroError] {
  if r.depth > r.limits.max_depth {
    return Err(AvroError::LimitExceeded("max_depth exceeded in schema resolution"))
  }
  match res.plans[plan_id] {
    ResolveOp::ExactNull => Ok(AvroValue::Null)
    ResolveOp::ExactBool =>
    match br_read_bool(r) {
      Ok(b) => Ok(AvroValue::Boolean(b))
      Err(e) => Err(e)
    }
    ResolveOp::ExactInt =>
    match br_read_i32(r) {
      Ok(v) => Ok(AvroValue::Int(v))
      Err(e) => Err(e)
    }
    ResolveOp::ExactLong =>
    match br_read_i64(r) {
      Ok(v) => Ok(AvroValue::Long(v))
      Err(e) => Err(e)
    }
    ResolveOp::ExactFloat =>
    match br_read_f32_bits(r) {
      Ok(bits) => Ok(AvroValue::Float32(float32_bits_to_double(bits)))
      Err(e) => Err(e)
    }
    ResolveOp::ExactDouble =>
    match br_read_f64_bits(r) {
      Ok(bits) => Ok(AvroValue::Float64(Double::from_bits(bits)))
      Err(e) => Err(e)
    }
    ResolveOp::ExactBytes =>
    match br_read_bytes(r) {
      Ok(b) => Ok(AvroValue::Bytes(b))
      Err(e) => Err(e)
    }
    ResolveOp::ExactString =>
    match br_read_string(r) {
      Ok(s) => Ok(AvroValue::String(s))
      Err(e) => Err(e)
    }
    ResolveOp::ExactFixed(size) =>
    match br_read_fixed(r, size) {
      Ok(b) => Ok(AvroValue::Fixed(b))
      Err(e) => Err(e)
    }
    ResolveOp::PromoteIntToLong =>
    match br_read_i32(r) {
      Ok(v) => Ok(AvroValue::Long(v.to_int64()))
      Err(e) => Err(e)
    }
    ResolveOp::PromoteIntToFloat =>
    match br_read_i32(r) {
      Ok(v) =>
      Ok(AvroValue::Float32(float32_bits_to_double(double_to_float32_bits(v.to_double()))))
      Err(e) => Err(e)
    }
    ResolveOp::PromoteIntToDouble =>
    match br_read_i32(r) {
      Ok(v) => Ok(AvroValue::Float64(v.to_double()))
      Err(e) => Err(e)
    }
    ResolveOp::PromoteLongToFloat =>
    match br_read_i64(r) {
      Ok(v) =>
      Ok(AvroValue::Float32(float32_bits_to_double(double_to_float32_bits(v.to_double()))))
      Err(e) => Err(e)
    }
    ResolveOp::PromoteLongToDouble =>
    match br_read_i64(r) {
      Ok(v) => Ok(AvroValue::Float64(v.to_double()))
      Err(e) => Err(e)
    }
    ResolveOp::PromoteFloatToDouble =>
    match br_read_f32_bits(r) {
      Ok(bits) => Ok(AvroValue::Float64(float32_bits_to_double(bits)))
      Err(e) => Err(e)
    }
    ResolveOp::PromoteStringToBytes =>
    match br_read_string(r) {
      Ok(s) => Ok(AvroValue::Bytes(s.to_bytes()))
      Err(e) => Err(e)
    }
    ResolveOp::PromoteBytesToString =>
    match br_read_bytes(r) {
      Ok(b) => {
        if !is_valid_utf8_range(b, 0, b.length()) {
          return Err(AvroError::InvalidUtf8("bytes->string promotion encountered invalid UTF-8"))
        }
        Ok(AvroValue::String(b.to_string()))
      }
      Err(e) => Err(e)
    }
    ResolveOp::ResolveEnum(sym_map, rsyms) => {
      let widx = match br_read_i32(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if widx < 0 || widx >= sym_map.length() {
        return Err(AvroError::InvalidBinary("writer enum index out of range"))
      }
      let ridx = sym_map[widx]
      if ridx < 0 {
        return Err(AvroError::ResolutionError("writer enum symbol not in reader enum and no default"))
      }
      Ok(AvroValue::Enum(ridx, rsyms[ridx]))
    }
    ResolveOp::ResolveArray(item_pid) => {
      r.depth = r.depth + 1
      let items : Array[AvroValue] = []
      while true {
        let count = match br_read_block_count(r) {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        if count == 0L {
          break
        }
        if count > (r.limits.max_elements - r.elements).to_int64() {
          return Err(AvroError::LimitExceeded("array exceeds max_elements in resolve"))
        }
        let n = count.to_int()
        r.elements = r.elements + n
        let mut i = 0
        while i < n {
          let item = match exec_resolve(r, res, item_pid) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          items.push(item)
          i = i + 1
        }
      }
      r.depth = r.depth - 1
      Ok(AvroValue::Array(items))
    }
    ResolveOp::ResolveMap(val_pid) => {
      r.depth = r.depth + 1
      let entries : Array[(String, AvroValue)] = []
      while true {
        let count = match br_read_block_count(r) {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        if count == 0L {
          break
        }
        if count > (r.limits.max_elements - r.elements).to_int64() {
          return Err(AvroError::LimitExceeded("map exceeds max_elements in resolve"))
        }
        let n = count.to_int()
        r.elements = r.elements + n
        let mut i = 0
        while i < n {
          let k = match br_read_string(r) {
            Ok(s) => s
            Err(e) => return Err(e)
          }
          let v = match exec_resolve(r, res, val_pid) {
            Ok(x) => x
            Err(e) => return Err(e)
          }
          entries.push((k, v))
          i = i + 1
        }
      }
      r.depth = r.depth - 1
      Ok(AvroValue::Map(entries))
    }
    ResolveOp::ResolveRecord(r_names, w_to_r, w_fplans, r_defaults) => {
      r.depth = r.depth + 1
      let r_len = r_names.length()
      let slots : FixedArray[AvroValue] = FixedArray::make(r_len, AvroValue::Null)
      let mut di = 0
      while di < r_defaults.length() {
        let (slot, dv) = r_defaults[di]
        slots[slot] = dv
        di = di + 1
      }
      let mut wi = 0
      while wi < w_to_r.length() {
        let r_slot = w_to_r[wi]
        if r_slot >= 0 {
          let v = match exec_resolve(r, res, w_fplans[wi]) {
            Ok(x) => x
            Err(e) => return Err(e)
          }
          slots[r_slot] = v
        } else {
          match skip_datum_from(r, res.writer, w_fplans[wi]) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        wi = wi + 1
      }
      let out : Array[(String, AvroValue)] = []
      let mut ri = 0
      while ri < r_len {
        out.push((r_names[ri], slots[ri]))
        ri = ri + 1
      }
      r.depth = r.depth - 1
      Ok(AvroValue::Record(out))
    }
    ResolveOp::ResolveWriterUnion(bplans) => {
      let widx64 = match br_read_i64(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if widx64 < 0L || widx64 >= bplans.length().to_int64() {
        return Err(AvroError::InvalidBinary("writer union index out of range"))
      }
      let bpid = bplans[widx64.to_int()]
      if bpid < 0 {
        return Err(AvroError::ResolutionError("writer union branch incompatible with reader schema"))
      }
      r.depth = r.depth + 1
      let v = exec_resolve(r, res, bpid)
      r.depth = r.depth - 1
      v
    }
    ResolveOp::ResolveReaderUnion(ridx, inner_pid) => {
      r.depth = r.depth + 1
      let inner = match exec_resolve(r, res, inner_pid) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      r.depth = r.depth - 1
      Ok(AvroValue::Union(ridx, inner))
    }
    ResolveOp::Incompatible(msg) => Err(AvroError::ResolutionError(msg))
  }
}

///| Compile and validate a `SchemaResolver` for evolving datums from `writer` to `reader`.
pub fn compile_resolver(writer : Schema, reader : Schema) -> Result[SchemaResolver, AvroError] {
  let c = PlanCompiler::{ writer: writer, reader: reader, plans: [], memo: [] }
  let root_plan = match pc_compile(c, writer.root, reader.root) {
    Ok(pid) => pid
    Err(e) => return Err(e)
  }
  Ok(SchemaResolver::{ writer: writer, reader: reader, root_plan: root_plan, plans: c.plans })
}

///| Decode a binary datum written with `writer` schema into a value conforming to `reader` schema.
pub fn decode_datum_resolved(
  writer : Schema,
  reader : Schema,
  data : Bytes,
) -> Result[AvroValue, AvroError] {
  decode_datum_resolved_with_limits(writer, reader, data, AvroLimits::default())
}

///| Decode a binary datum with schema evolution and custom limits.
pub fn decode_datum_resolved_with_limits(
  writer : Schema,
  reader : Schema,
  data : Bytes,
  limits : AvroLimits,
) -> Result[AvroValue, AvroError] {
  let res = match compile_resolver(writer, reader) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  decode_datum_with_resolver(res, data, limits)
}

///| Decode a binary datum using a pre-compiled `SchemaResolver`.
pub fn decode_datum_with_resolver(
  resolver : SchemaResolver,
  data : Bytes,
  limits : AvroLimits,
) -> Result[AvroValue, AvroError] {
  let r = BinReader::new(data, 0, data.length(), limits)
  let decoded = match exec_resolve(r, resolver, resolver.root_plan) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if r.pos != r.end {
    return Err(AvroError::TrailingBytes(r.end - r.pos))
  }
  Ok(decoded)
}

///| Decode `count` back-to-back binary datums using a pre-compiled `SchemaResolver`.
pub fn decode_datums_with_resolver(
  resolver : SchemaResolver,
  data : Bytes,
  count : Int,
  limits : AvroLimits,
) -> Result[Array[AvroValue], AvroError] {
  let r = BinReader::new(data, 0, data.length(), limits)
  let out : Array[AvroValue] = []
  let mut i = 0
  while i < count {
    r.elements = 0
    let decoded = match exec_resolve(r, resolver, resolver.root_plan) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    out.push(decoded)
    i = i + 1
  }
  if r.pos != r.end {
    return Err(AvroError::TrailingBytes(r.end - r.pos))
  }
  Ok(out)
}
