///| Apache Avro 1.11.1 Schema representation, parser, Parsing Canonical Form, and CRC-64-AVRO Rabin fingerprint.

///| Logical type annotation attached to an Avro schema node.
pub enum LogicalType {
  None
  Decimal(Int, Int)
  Uuid
  Date
  TimeMillis
  TimeMicros
  TimestampMillis
  TimestampMicros
  Duration
}

///| Record field sort order.
pub enum FieldOrder {
  Ascending
  Descending
  Ignore
}

///| A single field of an Avro `record` schema.
pub struct RecordField {
  pub name : String
  pub schema_id : Int
  pub doc : Option[String]
  pub default_val : Option[AvroValue]
  pub order : FieldOrder
  pub aliases : Array[String]
}

///| Core kind of an Avro schema node in the arena.
pub enum SchemaKind {
  Null
  Boolean
  Int
  Long
  Float
  Double
  Bytes
  String
  Record(String, Array[String], Array[RecordField])
  Enum(String, Array[String], Array[String], Option[String])
  Array(Int)
  Map(Int)
  Union(Array[Int])
  Fixed(String, Array[String], Int)
  Ref(Int)
}

///| A node in the `Schema` arena.
pub struct SchemaNode {
  pub kind : SchemaKind
  pub logical : LogicalType
}

///| Arena-backed Avro schema supporting recursive and shared named types without reference cycles.
pub struct Schema {
  pub root : Int
  pub nodes : Array[SchemaNode]
  pub named_indices : Array[(String, Int)]
}

///| Return the root `SchemaNode` of a `Schema`.
pub fn Schema::root_node(self : Schema) -> SchemaNode {
  self.nodes[self.root]
}

///| Resolve a `SchemaKind::Ref` chain to its target node index.
pub fn Schema::resolve_id(self : Schema, id : Int) -> Int {
  let mut cur = id
  let mut steps = 0
  while steps < 64 {
    match self.nodes[cur].kind {
      SchemaKind::Ref(target) => {
        cur = target
        steps = steps + 1
      }
      _ => return cur
    }
  }
  cur
}

fn is_primitive_name(name : String) -> Bool {
  name == "null" ||
  name == "boolean" ||
  name == "int" ||
  name == "long" ||
  name == "float" ||
  name == "double" ||
  name == "bytes" ||
  name == "string"
}

fn is_valid_ident_segment(s : String) -> Bool {
  let b = s.to_bytes()
  let n = b.length()
  if n == 0 {
    return false
  }
  let c0 = b[0].to_int()
  let ok0 = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95
  if !ok0 {
    return false
  }
  let mut i = 1
  while i < n {
    let c = b[i].to_int()
    let ok =
    (c >= 65 && c <= 90) ||
    (c >= 97 && c <= 122) ||
    (c >= 48 && c <= 57) ||
    c == 95
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

fn is_valid_fullname(s : String) -> Bool {
  let b = s.to_bytes()
  let n = b.length()
  if n == 0 {
    return false
  }
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || b[i].to_int() == 46 {
      let seg = b.slice(start, i).to_string()
      if !is_valid_ident_segment(seg) {
        return false
      }
      start = i + 1
    }
    i = i + 1
  }
  true
}

fn last_dot_index(s : String) -> Int {
  let b = s.to_bytes()
  let mut i = b.length() - 1
  while i >= 0 {
    if b[i].to_int() == 46 {
      return i
    }
    i = i - 1
  }
  -1
}

fn split_fullname(fullname : String) -> (String, String) {
  let dot = last_dot_index(fullname)
  if dot < 0 {
    ("", fullname)
  } else {
    let b = fullname.to_bytes()
    (b.slice(0, dot).to_string(), b.slice(dot + 1, b.length()).to_string())
  }
}

fn qualify_name(
  name : String,
  explicit_ns : Option[String],
  enclosing_ns : String,
) -> Result[(String, String), AvroError] {
  if name.length() == 0 {
    return Err(AvroError::InvalidSchema("empty type name"))
  }
  let dot = last_dot_index(name)
  let fullname = if dot >= 0 {
    name
  } else {
    match explicit_ns {
      Some(ns) => if ns.length() == 0 { name } else { ns + "." + name }
      None => if enclosing_ns.length() == 0 { name } else { enclosing_ns + "." + name }
    }
  }
  if !is_valid_fullname(fullname) {
    return Err(AvroError::InvalidSchema("invalid Avro name: " + fullname))
  }
  let (ns, simple) = split_fullname(fullname)
  if is_primitive_name(simple) {
    return Err(AvroError::InvalidSchema("cannot redefine primitive type name: " + simple))
  }
  Ok((fullname, ns))
}

fn max_decimal_precision_for_fixed(size : Int) -> Int {
  // floor(log10(2^(8*size - 1) - 1)) ~= floor((8*size - 1) * 0.3010299956639812)
  // Exact for all practical fixed sizes (1..1024):
  if size <= 0 {
    return 0
  }
  let bits = 8 * size - 1
  // Use exact integer arithmetic: log10(2) = 0.301029995663981195...
  // Multiply by 301029995L and divide by 1000000000L
  ((bits.to_int64() * 301029995L) / 1000000000L).to_int()
}

fn parse_logical_type(entries : Array[(String, JsonVal)], kind : SchemaKind) -> LogicalType {
  let lt_name = match json_obj_get(entries, "logicalType") {
    Some(JsonVal::JStr(s)) => s
    _ => return LogicalType::None
  }
  if lt_name == "decimal" {
    let prec = match json_obj_get(entries, "precision") {
      Some(JsonVal::JInt(p)) => p.to_int()
      _ => return LogicalType::None
    }
    let scale = match json_obj_get(entries, "scale") {
      Some(JsonVal::JInt(sc)) => sc.to_int()
      None => 0
      _ => return LogicalType::None
    }
    if prec <= 0 || scale < 0 || scale > prec {
      return LogicalType::None
    }
    match kind {
      SchemaKind::Bytes => return LogicalType::Decimal(prec, scale)
      SchemaKind::Fixed(_, _, size) => {
        if prec <= max_decimal_precision_for_fixed(size) {
          return LogicalType::Decimal(prec, scale)
        }
        return LogicalType::None
      }
      _ => return LogicalType::None
    }
  }
  if lt_name == "uuid" {
    match kind {
      SchemaKind::String => return LogicalType::Uuid
      _ => return LogicalType::None
    }
  }
  if lt_name == "date" {
    match kind {
      SchemaKind::Int => return LogicalType::Date
      _ => return LogicalType::None
    }
  }
  if lt_name == "time-millis" {
    match kind {
      SchemaKind::Int => return LogicalType::TimeMillis
      _ => return LogicalType::None
    }
  }
  if lt_name == "time-micros" {
    match kind {
      SchemaKind::Long => return LogicalType::TimeMicros
      _ => return LogicalType::None
    }
  }
  if lt_name == "timestamp-millis" {
    match kind {
      SchemaKind::Long => return LogicalType::TimestampMillis
      _ => return LogicalType::None
    }
  }
  if lt_name == "timestamp-micros" {
    match kind {
      SchemaKind::Long => return LogicalType::TimestampMicros
      _ => return LogicalType::None
    }
  }
  if lt_name == "duration" {
    match kind {
      SchemaKind::Fixed(_, _, size) =>
      if size == 12 {
        return LogicalType::Duration
      } else {
        return LogicalType::None
      }
      _ => return LogicalType::None
    }
  }
  LogicalType::None
}

struct SchemaBuilder {
  nodes : Array[SchemaNode]
  named : Array[(String, Int)]
  named_map : Map[String, Int]
  limits : AvroLimits
}

fn sb_find_named(b : SchemaBuilder, fullname : String) -> Option[Int] {
  b.named_map.get(fullname)
}

fn sb_register_named(b : SchemaBuilder, fullname : String, id : Int) -> Unit {
  b.named.push((fullname, id))
  b.named_map.set(fullname, id)
}

fn sb_push_node(b : SchemaBuilder, node : SchemaNode) -> Result[Int, AvroError] {
  if b.nodes.length() >= b.limits.max_schema_types {
    return Err(AvroError::LimitExceeded("max_schema_types exceeded"))
  }
  let id = b.nodes.length()
  b.nodes.push(node)
  Ok(id)
}

fn sb_parse_aliases(
  entries : Array[(String, JsonVal)],
  own_ns : String,
) -> Result[Array[String], AvroError] {
  let out : Array[String] = []
  match json_obj_get(entries, "aliases") {
    None => return Ok(out)
    Some(JsonVal::JArr(arr)) => {
      let mut i = 0
      while i < arr.length() {
        match arr[i] {
          JsonVal::JStr(a) => {
            let (full, _) = match qualify_name(a, None, own_ns) {
              Ok(pair) => pair
              Err(e) => return Err(e)
            }
            out.push(full)
          }
          _ => return Err(AvroError::InvalidSchema("alias must be a string"))
        }
        i = i + 1
      }
      Ok(out)
    }
    _ => Err(AvroError::InvalidSchema("aliases must be an array of strings"))
  }
}

fn sb_parse_field_aliases(entries : Array[(String, JsonVal)]) -> Result[Array[String], AvroError] {
  let out : Array[String] = []
  match json_obj_get(entries, "aliases") {
    None => return Ok(out)
    Some(JsonVal::JArr(arr)) => {
      let mut i = 0
      while i < arr.length() {
        match arr[i] {
          JsonVal::JStr(a) => {
            if !is_valid_ident_segment(a) {
              return Err(AvroError::InvalidSchema("invalid field alias: " + a))
            }
            out.push(a)
          }
          _ => return Err(AvroError::InvalidSchema("field alias must be a string"))
        }
        i = i + 1
      }
      Ok(out)
    }
    _ => Err(AvroError::InvalidSchema("field aliases must be an array"))
  }
}

fn union_branch_dup_key(b : SchemaBuilder, id : Int) -> String {
  let mut cur = id
  match b.nodes[cur].kind {
    SchemaKind::Ref(t) => cur = t
    _ => ()
  }
  match b.nodes[cur].kind {
    SchemaKind::Null => "null"
    SchemaKind::Boolean => "boolean"
    SchemaKind::Int => "int"
    SchemaKind::Long => "long"
    SchemaKind::Float => "float"
    SchemaKind::Double => "double"
    SchemaKind::Bytes => "bytes"
    SchemaKind::String => "string"
    SchemaKind::Array(_) => "array"
    SchemaKind::Map(_) => "map"
    SchemaKind::Record(name, _, _) => "named:" + name
    SchemaKind::Enum(name, _, _, _) => "named:" + name
    SchemaKind::Fixed(name, _, _) => "named:" + name
    SchemaKind::Union(_) => "union"
    SchemaKind::Ref(_) => "ref"
  }
}

fn sb_resolve_named_ref(
  b : SchemaBuilder,
  s : String,
  enclosing_ns : String,
) -> Option[Int] {
  let dot = last_dot_index(s)
  if dot < 0 && enclosing_ns.length() > 0 {
    let qualified = enclosing_ns + "." + s
    match sb_find_named(b, qualified) {
      Some(target) => return Some(target)
      None => ()
    }
  }
  sb_find_named(b, s)
}

enum SbFrame {
  SbArray
  SbMap
  SbUnion(Array[JsonVal], String, Array[Int], Map[String, Bool], Int)
  SbRecord(
    Int, // rec_id
    String, // fullname
    Array[String], // aliases
    String, // own_ns
    Array[JsonVal], // fields_jv
    Array[RecordField], // built fields
    Map[String, Bool], // seen_fnames
    Int, // current field idx waiting for fschema_id
    String, // current fname
    Option[String], // current fdoc
    FieldOrder, // current forder
    Array[String], // current faliases
    Option[JsonVal], // current fdefault_jv
  )
}

fn sb_parse_node(
  b : SchemaBuilder,
  root_jv : JsonVal,
  root_ns : String,
  init_depth : Int,
) -> Result[Int, AvroError] {
  let stack : Array[SbFrame] = []
  let mut cur_jv = root_jv
  let mut cur_ns = root_ns
  let mut has_id = false
  let mut res_id = 0
  while true {
    if !has_id {
      if init_depth + stack.length() > b.limits.max_depth {
        return Err(AvroError::LimitExceeded("schema max_depth exceeded"))
      }
      match cur_jv {
        JsonVal::JStr(s) =>
        if s == "null" {
          match sb_push_node(b, SchemaNode::{ kind: SchemaKind::Null, logical: LogicalType::None }) {
            Ok(id) => {
              res_id = id
              has_id = true
            }
            Err(e) => return Err(e)
          }
        } else if s == "boolean" {
          match sb_push_node(b, SchemaNode::{ kind: SchemaKind::Boolean, logical: LogicalType::None }) {
            Ok(id) => {
              res_id = id
              has_id = true
            }
            Err(e) => return Err(e)
          }
        } else if s == "int" {
          match sb_push_node(b, SchemaNode::{ kind: SchemaKind::Int, logical: LogicalType::None }) {
            Ok(id) => {
              res_id = id
              has_id = true
            }
            Err(e) => return Err(e)
          }
        } else if s == "long" {
          match sb_push_node(b, SchemaNode::{ kind: SchemaKind::Long, logical: LogicalType::None }) {
            Ok(id) => {
              res_id = id
              has_id = true
            }
            Err(e) => return Err(e)
          }
        } else if s == "float" {
          match sb_push_node(b, SchemaNode::{ kind: SchemaKind::Float, logical: LogicalType::None }) {
            Ok(id) => {
              res_id = id
              has_id = true
            }
            Err(e) => return Err(e)
          }
        } else if s == "double" {
          match sb_push_node(b, SchemaNode::{ kind: SchemaKind::Double, logical: LogicalType::None }) {
            Ok(id) => {
              res_id = id
              has_id = true
            }
            Err(e) => return Err(e)
          }
        } else if s == "bytes" {
          match sb_push_node(b, SchemaNode::{ kind: SchemaKind::Bytes, logical: LogicalType::None }) {
            Ok(id) => {
              res_id = id
              has_id = true
            }
            Err(e) => return Err(e)
          }
        } else if s == "string" {
          match sb_push_node(b, SchemaNode::{ kind: SchemaKind::String, logical: LogicalType::None }) {
            Ok(id) => {
              res_id = id
              has_id = true
            }
            Err(e) => return Err(e)
          }
        } else {
          match sb_resolve_named_ref(b, s, cur_ns) {
            Some(target) =>
            match sb_push_node(
              b,
              SchemaNode::{ kind: SchemaKind::Ref(target), logical: LogicalType::None },
            ) {
              Ok(id) => {
                res_id = id
                has_id = true
              }
              Err(e) => return Err(e)
            }
            None => return Err(AvroError::InvalidSchema("unknown type reference: " + s))
          }
        }
        JsonVal::JArr(arr) =>
        if arr.length() == 0 {
          match sb_push_node(b, SchemaNode::{ kind: SchemaKind::Union([]), logical: LogicalType::None }) {
            Ok(id) => {
              res_id = id
              has_id = true
            }
            Err(e) => return Err(e)
          }
        } else {
          stack.push(SbFrame::SbUnion(arr, cur_ns, [], Map::new(), 0))
          cur_jv = arr[0]
        }
        JsonVal::JObj(entries) => {
          let typ_val = match json_obj_get(entries, "type") {
            Some(v) => v
            None => return Err(AvroError::InvalidSchema("schema object missing 'type'"))
          }
          let typ = match typ_val {
            JsonVal::JStr(s) => s
            _ => return Err(AvroError::InvalidSchema("'type' must be a string"))
          }
          if is_primitive_name(typ) {
            let kind = if typ == "null" {
              SchemaKind::Null
            } else if typ == "boolean" {
              SchemaKind::Boolean
            } else if typ == "int" {
              SchemaKind::Int
            } else if typ == "long" {
              SchemaKind::Long
            } else if typ == "float" {
              SchemaKind::Float
            } else if typ == "double" {
              SchemaKind::Double
            } else if typ == "bytes" {
              SchemaKind::Bytes
            } else {
              SchemaKind::String
            }
            let lt = parse_logical_type(entries, kind)
            match sb_push_node(b, SchemaNode::{ kind: kind, logical: lt }) {
              Ok(id) => {
                res_id = id
                has_id = true
              }
              Err(e) => return Err(e)
            }
          } else if typ == "array" {
            let items_jv = match json_obj_get(entries, "items") {
              Some(v) => v
              None => return Err(AvroError::InvalidSchema("array schema missing 'items'"))
            }
            stack.push(SbFrame::SbArray)
            cur_jv = items_jv
          } else if typ == "map" {
            let vals_jv = match json_obj_get(entries, "values") {
              Some(v) => v
              None => return Err(AvroError::InvalidSchema("map schema missing 'values'"))
            }
            stack.push(SbFrame::SbMap)
            cur_jv = vals_jv
          } else if typ == "fixed" {
            let name = match json_obj_get(entries, "name") {
              Some(JsonVal::JStr(s)) => s
              _ => return Err(AvroError::InvalidSchema("fixed schema missing string 'name'"))
            }
            let explicit_ns = match json_obj_get(entries, "namespace") {
              Some(JsonVal::JStr(ns)) => Some(ns)
              None => None
              _ => return Err(AvroError::InvalidSchema("fixed 'namespace' must be a string"))
            }
            let (fullname, own_ns) = match qualify_name(name, explicit_ns, cur_ns) {
              Ok(p) => p
              Err(e) => return Err(e)
            }
            match sb_find_named(b, fullname) {
              Some(_) => return Err(AvroError::InvalidSchema("duplicate named type: " + fullname))
              None => ()
            }
            let size = match json_obj_get(entries, "size") {
              Some(JsonVal::JInt(n)) => {
                if n < 0L || n > 2147483647L {
                  return Err(AvroError::InvalidSchema("fixed 'size' must be non-negative int"))
                }
                n.to_int()
              }
              _ => return Err(AvroError::InvalidSchema("fixed schema missing integer 'size'"))
            }
            let aliases = match sb_parse_aliases(entries, own_ns) {
              Ok(a) => a
              Err(e) => return Err(e)
            }
            let kind = SchemaKind::Fixed(fullname, aliases, size)
            let lt = parse_logical_type(entries, kind)
            let id = match sb_push_node(b, SchemaNode::{ kind: kind, logical: lt }) {
              Ok(x) => x
              Err(e) => return Err(e)
            }
            sb_register_named(b, fullname, id)
            res_id = id
            has_id = true
          } else if typ == "enum" {
            let name = match json_obj_get(entries, "name") {
              Some(JsonVal::JStr(s)) => s
              _ => return Err(AvroError::InvalidSchema("enum schema missing string 'name'"))
            }
            let explicit_ns = match json_obj_get(entries, "namespace") {
              Some(JsonVal::JStr(ns)) => Some(ns)
              None => None
              _ => return Err(AvroError::InvalidSchema("enum 'namespace' must be a string"))
            }
            let (fullname, own_ns) = match qualify_name(name, explicit_ns, cur_ns) {
              Ok(p) => p
              Err(e) => return Err(e)
            }
            match sb_find_named(b, fullname) {
              Some(_) => return Err(AvroError::InvalidSchema("duplicate named type: " + fullname))
              None => ()
            }
            let syms_jv = match json_obj_get(entries, "symbols") {
              Some(JsonVal::JArr(a)) => a
              _ => return Err(AvroError::InvalidSchema("enum schema missing 'symbols' array"))
            }
            let symbols : Array[String] = []
            let seen_syms : Map[String, Bool] = Map::new()
            let mut i = 0
            while i < syms_jv.length() {
              let sym = match syms_jv[i] {
                JsonVal::JStr(s) => s
                _ => return Err(AvroError::InvalidSchema("enum symbol must be a string"))
              }
              if !is_valid_ident_segment(sym) {
                return Err(AvroError::InvalidSchema("invalid enum symbol: " + sym))
              }
              match seen_syms.get(sym) {
                Some(_) => return Err(AvroError::InvalidSchema("duplicate enum symbol: " + sym))
                None => seen_syms.set(sym, true)
              }
              symbols.push(sym)
              i = i + 1
            }
            let default_sym = match json_obj_get(entries, "default") {
              None => None
              Some(JsonVal::JStr(ds)) =>
              match seen_syms.get(ds) {
                Some(_) => Some(ds)
                None => return Err(AvroError::InvalidSchema("enum default not in symbols: " + ds))
              }
              _ => return Err(AvroError::InvalidSchema("enum default must be a string"))
            }
            let aliases = match sb_parse_aliases(entries, own_ns) {
              Ok(a) => a
              Err(e) => return Err(e)
            }
            let id = match sb_push_node(
              b,
              SchemaNode::{
                kind: SchemaKind::Enum(fullname, aliases, symbols, default_sym),
                logical: LogicalType::None,
              },
            ) {
              Ok(x) => x
              Err(e) => return Err(e)
            }
            sb_register_named(b, fullname, id)
            res_id = id
            has_id = true
          } else if typ == "record" || typ == "error" {
            let name = match json_obj_get(entries, "name") {
              Some(JsonVal::JStr(s)) => s
              _ => return Err(AvroError::InvalidSchema("record schema missing string 'name'"))
            }
            let explicit_ns = match json_obj_get(entries, "namespace") {
              Some(JsonVal::JStr(ns)) => Some(ns)
              None => None
              _ => return Err(AvroError::InvalidSchema("record 'namespace' must be a string"))
            }
            let (fullname, own_ns) = match qualify_name(name, explicit_ns, cur_ns) {
              Ok(p) => p
              Err(e) => return Err(e)
            }
            match sb_find_named(b, fullname) {
              Some(_) => return Err(AvroError::InvalidSchema("duplicate named type: " + fullname))
              None => ()
            }
            let aliases = match sb_parse_aliases(entries, own_ns) {
              Ok(a) => a
              Err(e) => return Err(e)
            }
            let rec_id = match sb_push_node(
              b,
              SchemaNode::{
                kind: SchemaKind::Record(fullname, aliases, []),
                logical: LogicalType::None,
              },
            ) {
              Ok(x) => x
              Err(e) => return Err(e)
            }
            sb_register_named(b, fullname, rec_id)
            let fields_jv = match json_obj_get(entries, "fields") {
              Some(JsonVal::JArr(a)) => a
              _ => return Err(AvroError::InvalidSchema("record schema missing 'fields' array"))
            }
            if fields_jv.length() == 0 {
              res_id = rec_id
              has_id = true
            } else {
              let fentries = match fields_jv[0] {
                JsonVal::JObj(fe) => fe
                _ => return Err(AvroError::InvalidSchema("record field must be a JSON object"))
              }
              let fname = match json_obj_get(fentries, "name") {
                Some(JsonVal::JStr(s)) => s
                _ => return Err(AvroError::InvalidSchema("record field missing string 'name'"))
              }
              if !is_valid_ident_segment(fname) {
                return Err(AvroError::InvalidSchema("invalid field name: " + fname))
              }
              let seen_fnames : Map[String, Bool] = Map::new()
              seen_fnames.set(fname, true)
              let ftype_jv = match json_obj_get(fentries, "type") {
                Some(v) => v
                None => return Err(AvroError::InvalidSchema("record field missing 'type': " + fname))
              }
              let fdoc = match json_obj_get(fentries, "doc") {
                Some(JsonVal::JStr(d)) => Some(d)
                _ => None
              }
              let forder = match json_obj_get(fentries, "order") {
                None => FieldOrder::Ascending
                Some(JsonVal::JStr(os)) =>
                if os == "ascending" {
                  FieldOrder::Ascending
                } else if os == "descending" {
                  FieldOrder::Descending
                } else if os == "ignore" {
                  FieldOrder::Ignore
                } else {
                  return Err(AvroError::InvalidSchema("invalid field order: " + os))
                }
                _ => return Err(AvroError::InvalidSchema("field order must be a string"))
              }
              let faliases = match sb_parse_field_aliases(fentries) {
                Ok(a) => a
                Err(e) => return Err(e)
              }
              let fdef_jv = json_obj_get(fentries, "default")
              stack.push(
                SbFrame::SbRecord(
                  rec_id,
                  fullname,
                  aliases,
                  own_ns,
                  fields_jv,
                  [],
                  seen_fnames,
                  0,
                  fname,
                  fdoc,
                  forder,
                  faliases,
                  fdef_jv,
                ),
              )
              cur_jv = ftype_jv
              cur_ns = own_ns
            }
          } else {
            // Object-form named type reference: {"type": "F"} (Avro 1.11.1 Java Schema.parse)
            match sb_resolve_named_ref(b, typ, cur_ns) {
              Some(target) =>
              match sb_push_node(
                b,
                SchemaNode::{ kind: SchemaKind::Ref(target), logical: LogicalType::None },
              ) {
                Ok(id) => {
                  res_id = id
                  has_id = true
                }
                Err(e) => return Err(e)
              }
              None => return Err(AvroError::InvalidSchema("unknown schema type: " + typ))
            }
          }
        }
        _ => return Err(AvroError::InvalidSchema("schema must be a JSON string, array, or object"))
      }
    } else {
      match stack.pop() {
        None => return Ok(res_id)
        Some(SbFrame::SbArray) =>
        match sb_push_node(
          b,
          SchemaNode::{ kind: SchemaKind::Array(res_id), logical: LogicalType::None },
        ) {
          Ok(id) => res_id = id
          Err(e) => return Err(e)
        }
        Some(SbFrame::SbMap) =>
        match sb_push_node(
          b,
          SchemaNode::{ kind: SchemaKind::Map(res_id), logical: LogicalType::None },
        ) {
          Ok(id) => res_id = id
          Err(e) => return Err(e)
        }
        Some(SbFrame::SbUnion(arr, enc_ns, branches, seen_keys, idx)) => {
          let bid = res_id
          let mut target = bid
          match b.nodes[target].kind {
            SchemaKind::Ref(t) => target = t
            _ => ()
          }
          match b.nodes[target].kind {
            SchemaKind::Union(_) =>
            return Err(AvroError::InvalidSchema("unions may not immediately contain other unions"))
            _ => ()
          }
          let dkey = union_branch_dup_key(b, bid)
          match seen_keys.get(dkey) {
            Some(_) => return Err(AvroError::InvalidSchema("duplicate branch type in union: " + dkey))
            None => seen_keys.set(dkey, true)
          }
          branches.push(bid)
          let next = idx + 1
          if next < arr.length() {
            stack.push(SbFrame::SbUnion(arr, enc_ns, branches, seen_keys, next))
            cur_jv = arr[next]
            cur_ns = enc_ns
            has_id = false
          } else {
            match sb_push_node(
              b,
              SchemaNode::{ kind: SchemaKind::Union(branches), logical: LogicalType::None },
            ) {
              Ok(id) => res_id = id
              Err(e) => return Err(e)
            }
          }
        }
        Some(
          SbFrame::SbRecord(
            rec_id,
            fullname,
            aliases,
            own_ns,
            fields_jv,
            fields,
            seen_fnames,
            idx,
            fname,
            fdoc,
            forder,
            faliases,
            fdef_jv,
          ),
        ) => {
          let fschema_id = res_id
          let fdefault = match fdef_jv {
            None => None
            Some(djv) => {
              let tmp_schema = Schema::{ root: fschema_id, nodes: b.nodes, named_indices: b.named }
              match json_val_to_avro(tmp_schema, fschema_id, djv, b.limits, 0, true) {
                Ok(dv) => Some(dv)
                Err(e) =>
                return Err(
                  AvroError::InvalidSchema(
                    "invalid default value for field '" + fname + "': " + error_message(e),
                  ),
                )
              }
            }
          }
          fields.push(
            RecordField::{
              name: fname,
              schema_id: fschema_id,
              doc: fdoc,
              default_val: fdefault,
              order: forder,
              aliases: faliases,
            },
          )
          let next = idx + 1
          if next < fields_jv.length() {
            let fentries = match fields_jv[next] {
              JsonVal::JObj(fe) => fe
              _ => return Err(AvroError::InvalidSchema("record field must be a JSON object"))
            }
            let nfname = match json_obj_get(fentries, "name") {
              Some(JsonVal::JStr(s)) => s
              _ => return Err(AvroError::InvalidSchema("record field missing string 'name'"))
            }
            if !is_valid_ident_segment(nfname) {
              return Err(AvroError::InvalidSchema("invalid field name: " + nfname))
            }
            match seen_fnames.get(nfname) {
              Some(_) => return Err(AvroError::InvalidSchema("duplicate field name: " + nfname))
              None => seen_fnames.set(nfname, true)
            }
            let nftype_jv = match json_obj_get(fentries, "type") {
              Some(v) => v
              None => return Err(AvroError::InvalidSchema("record field missing 'type': " + nfname))
            }
            let nfdoc = match json_obj_get(fentries, "doc") {
              Some(JsonVal::JStr(d)) => Some(d)
              _ => None
            }
            let nforder = match json_obj_get(fentries, "order") {
              None => FieldOrder::Ascending
              Some(JsonVal::JStr(os)) =>
              if os == "ascending" {
                FieldOrder::Ascending
              } else if os == "descending" {
                FieldOrder::Descending
              } else if os == "ignore" {
                FieldOrder::Ignore
              } else {
                return Err(AvroError::InvalidSchema("invalid field order: " + os))
              }
              _ => return Err(AvroError::InvalidSchema("field order must be a string"))
            }
            let nfaliases = match sb_parse_field_aliases(fentries) {
              Ok(a) => a
              Err(e) => return Err(e)
            }
            let nfdef_jv = json_obj_get(fentries, "default")
            stack.push(
              SbFrame::SbRecord(
                rec_id,
                fullname,
                aliases,
                own_ns,
                fields_jv,
                fields,
                seen_fnames,
                next,
                nfname,
                nfdoc,
                nforder,
                nfaliases,
                nfdef_jv,
              ),
            )
            cur_jv = nftype_jv
            cur_ns = own_ns
            has_id = false
          } else {
            b.nodes[rec_id] = SchemaNode::{
              kind: SchemaKind::Record(fullname, aliases, fields),
              logical: LogicalType::None,
            }
            res_id = rec_id
          }
        }
      }
    }
  }
  Ok(res_id)
}

///| Parse an Apache Avro 1.11.1 JSON schema using default limits.
pub fn parse_schema(json_str : String) -> Result[Schema, AvroError] {
  parse_schema_with_limits(json_str, AvroLimits::default())
}

///| Parse an Apache Avro 1.11.1 JSON schema with custom limits.
pub fn parse_schema_with_limits(
  json_str : String,
  limits : AvroLimits,
) -> Result[Schema, AvroError] {
  let jv = match json_parse(json_str, limits.max_depth + 4) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let b = SchemaBuilder::{ nodes: [], named: [], named_map: Map::new(), limits: limits }
  let root = match sb_parse_node(b, jv, "", 0) {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  Ok(Schema::{ root: root, nodes: b.nodes, named_indices: b.named })
}

fn str_array_contains(arr : Array[String], s : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == s {
      return true
    }
    i = i + 1
  }
  false
}

enum SchemaWriteFrame {
  SwNode(Int)
  SwLit(String)
  SwUnion(Array[Int], Int)
  SwRecFields(Array[RecordField], Int)
}

fn write_logical_fields(sb : StringBuilder, lt : LogicalType) -> Unit {
  match lt {
    LogicalType::None => ()
    LogicalType::Decimal(prec, scale) => {
      sb.write_string(",\"logicalType\":\"decimal\",\"precision\":")
      sb.write_string(prec.to_string())
      if scale != 0 {
        sb.write_string(",\"scale\":")
        sb.write_string(scale.to_string())
      }
    }
    LogicalType::Uuid => sb.write_string(",\"logicalType\":\"uuid\"")
    LogicalType::Date => sb.write_string(",\"logicalType\":\"date\"")
    LogicalType::TimeMillis => sb.write_string(",\"logicalType\":\"time-millis\"")
    LogicalType::TimeMicros => sb.write_string(",\"logicalType\":\"time-micros\"")
    LogicalType::TimestampMillis => sb.write_string(",\"logicalType\":\"timestamp-millis\"")
    LogicalType::TimestampMicros => sb.write_string(",\"logicalType\":\"timestamp-micros\"")
    LogicalType::Duration => sb.write_string(",\"logicalType\":\"duration\"")
  }
}

fn write_str_array(sb : StringBuilder, arr : Array[String]) -> Unit {
  sb.write_string("[")
  let mut i = 0
  while i < arr.length() {
    if i > 0 {
      sb.write_string(",")
    }
    json_write_string(sb, arr[i])
    i = i + 1
  }
  sb.write_string("]")
}

fn write_schema_iterative(
  sb : StringBuilder,
  schema : Schema,
  root_id : Int,
  full_mode : Bool,
) -> Unit {
  let seen : Map[String, Bool] = Map::new()
  let stack : Array[SchemaWriteFrame] = [SchemaWriteFrame::SwNode(root_id)]
  let def_limits = AvroLimits::default().with_max_depth(65536)
  while stack.length() > 0 {
    let frame = match stack.pop() {
      Some(f) => f
      None => break
    }
    match frame {
      SchemaWriteFrame::SwLit(s) => sb.write_string(s)
      SchemaWriteFrame::SwUnion(branches, idx) =>
      if idx < branches.length() {
        if idx > 0 {
          sb.write_string(",")
        }
        if idx + 1 < branches.length() {
          stack.push(SchemaWriteFrame::SwUnion(branches, idx + 1))
        }
        stack.push(SchemaWriteFrame::SwNode(branches[idx]))
      }
      SchemaWriteFrame::SwRecFields(fields, idx) =>
      if idx < fields.length() {
        if idx > 0 {
          sb.write_string(",")
        }
        let f = fields[idx]
        sb.write_string("{\"name\":")
        json_write_string(sb, f.name)
        sb.write_string(",\"type\":")
        if idx + 1 < fields.length() {
          stack.push(SchemaWriteFrame::SwRecFields(fields, idx + 1))
        }
        if full_mode {
          let tail_sb = StringBuilder::new()
          match f.doc {
            Some(d) => {
              tail_sb.write_string(",\"doc\":")
              json_write_string(tail_sb, d)
            }
            None => ()
          }
          match f.default_val {
            Some(dv) => {
              tail_sb.write_string(",\"default\":")
              let _ = encode_json_node_impl(tail_sb, schema, f.schema_id, dv, def_limits, 0, true)
            }
            None => ()
          }
          match f.order {
            FieldOrder::Ascending => ()
            FieldOrder::Descending => tail_sb.write_string(",\"order\":\"descending\"")
            FieldOrder::Ignore => tail_sb.write_string(",\"order\":\"ignore\"")
          }
          if f.aliases.length() > 0 {
            tail_sb.write_string(",\"aliases\":")
            write_str_array(tail_sb, f.aliases)
          }
          tail_sb.write_string("}")
          stack.push(SchemaWriteFrame::SwLit(tail_sb.to_string()))
        } else {
          stack.push(SchemaWriteFrame::SwLit("}"))
        }
        stack.push(SchemaWriteFrame::SwNode(f.schema_id))
      }
      SchemaWriteFrame::SwNode(node_id) => {
        let rid = schema.resolve_id(node_id)
        let node = schema.nodes[rid]
        match node.kind {
          SchemaKind::Null => sb.write_string("\"null\"")
          SchemaKind::Boolean => sb.write_string("\"boolean\"")
          SchemaKind::Int =>
          if full_mode && !(match node.logical { LogicalType::None => true _ => false }) {
            sb.write_string("{\"type\":\"int\"")
            write_logical_fields(sb, node.logical)
            sb.write_string("}")
          } else {
            sb.write_string("\"int\"")
          }
          SchemaKind::Long =>
          if full_mode && !(match node.logical { LogicalType::None => true _ => false }) {
            sb.write_string("{\"type\":\"long\"")
            write_logical_fields(sb, node.logical)
            sb.write_string("}")
          } else {
            sb.write_string("\"long\"")
          }
          SchemaKind::Float => sb.write_string("\"float\"")
          SchemaKind::Double => sb.write_string("\"double\"")
          SchemaKind::Bytes =>
          if full_mode && !(match node.logical { LogicalType::None => true _ => false }) {
            sb.write_string("{\"type\":\"bytes\"")
            write_logical_fields(sb, node.logical)
            sb.write_string("}")
          } else {
            sb.write_string("\"bytes\"")
          }
          SchemaKind::String =>
          if full_mode && !(match node.logical { LogicalType::None => true _ => false }) {
            sb.write_string("{\"type\":\"string\"")
            write_logical_fields(sb, node.logical)
            sb.write_string("}")
          } else {
            sb.write_string("\"string\"")
          }
          SchemaKind::Array(item_id) => {
            sb.write_string("{\"type\":\"array\",\"items\":")
            stack.push(SchemaWriteFrame::SwLit("}"))
            stack.push(SchemaWriteFrame::SwNode(item_id))
          }
          SchemaKind::Map(val_id) => {
            sb.write_string("{\"type\":\"map\",\"values\":")
            stack.push(SchemaWriteFrame::SwLit("}"))
            stack.push(SchemaWriteFrame::SwNode(val_id))
          }
          SchemaKind::Union(branches) => {
            sb.write_string("[")
            stack.push(SchemaWriteFrame::SwLit("]"))
            if branches.length() > 0 {
              stack.push(SchemaWriteFrame::SwUnion(branches, 0))
            }
          }
          SchemaKind::Fixed(fullname, aliases, size) =>
          match seen.get(fullname) {
            Some(_) => json_write_string(sb, fullname)
            None => {
              seen.set(fullname, true)
              sb.write_string("{\"name\":")
              json_write_string(sb, fullname)
              sb.write_string(",\"type\":\"fixed\",\"size\":")
              sb.write_string(size.to_string())
              if full_mode {
                if aliases.length() > 0 {
                  sb.write_string(",\"aliases\":")
                  write_str_array(sb, aliases)
                }
                write_logical_fields(sb, node.logical)
              }
              sb.write_string("}")
            }
          }
          SchemaKind::Enum(fullname, aliases, symbols, default_sym) =>
          match seen.get(fullname) {
            Some(_) => json_write_string(sb, fullname)
            None => {
              seen.set(fullname, true)
              sb.write_string("{\"name\":")
              json_write_string(sb, fullname)
              sb.write_string(",\"type\":\"enum\",\"symbols\":")
              write_str_array(sb, symbols)
              if full_mode {
                if aliases.length() > 0 {
                  sb.write_string(",\"aliases\":")
                  write_str_array(sb, aliases)
                }
                match default_sym {
                  Some(ds) => {
                    sb.write_string(",\"default\":")
                    json_write_string(sb, ds)
                  }
                  None => ()
                }
              }
              sb.write_string("}")
            }
          }
          SchemaKind::Record(fullname, aliases, fields) =>
          match seen.get(fullname) {
            Some(_) => json_write_string(sb, fullname)
            None => {
              seen.set(fullname, true)
              sb.write_string("{\"name\":")
              json_write_string(sb, fullname)
              sb.write_string(",\"type\":\"record\"")
              if full_mode && aliases.length() > 0 {
                sb.write_string(",\"aliases\":")
                write_str_array(sb, aliases)
              }
              sb.write_string(",\"fields\":[")
              stack.push(SchemaWriteFrame::SwLit("]}"))
              if fields.length() > 0 {
                stack.push(SchemaWriteFrame::SwRecFields(fields, 0))
              }
            }
          }
          SchemaKind::Ref(_) => ()
        }
      }
    }
  }
}

///| Produce the Apache Avro 1.11.1 Parsing Canonical Form (PCF) of a schema.
pub fn canonical_form(schema : Schema) -> String {
  let sb = StringBuilder::new()
  write_schema_iterative(sb, schema, schema.root, false)
  sb.to_string()
}

///| Serialize a `Schema` to full Avro JSON preserving `logicalType`, `default`, `aliases`, `doc`, and `order`.
pub fn schema_to_json(schema : Schema) -> String {
  let sb = StringBuilder::new()
  write_schema_iterative(sb, schema, schema.root, true)
  sb.to_string()
}

fn rabin_table() -> FixedArray[UInt64] {
  let empty : UInt64 = 0xc15d213aa4d7a795UL
  let tbl : FixedArray[UInt64] = FixedArray::make(256, 0UL)
  let mut i = 0
  while i < 256 {
    let mut fp = i.to_int64().to_uint64()
    let mut j = 0
    while j < 8 {
      let mask = if (fp & 1UL) != 0UL { empty } else { 0UL }
      fp = (fp >> 1) ^ mask
      j = j + 1
    }
    tbl[i] = fp
    i = i + 1
  }
  tbl
}

///| Compute the official 64-bit CRC-64-AVRO Rabin fingerprint of a schema's Parsing Canonical Form.
pub fn fingerprint_rabin(schema : Schema) -> UInt64 {
  let pcf = canonical_form(schema).to_bytes()
  let tbl = rabin_table()
  let mut fp : UInt64 = 0xc15d213aa4d7a795UL
  let n = pcf.length()
  let mut i = 0
  while i < n {
    let idx = ((fp ^ pcf[i].to_int().to_int64().to_uint64()) & 0xFFUL).to_int()
    fp = (fp >> 8) ^ tbl[idx]
    i = i + 1
  }
  fp
}

///| Compute the 8-byte little-endian CRC-64-AVRO Rabin fingerprint of a schema.
pub fn fingerprint_rabin_bytes(schema : Schema) -> Bytes {
  let fp = fingerprint_rabin(schema)
  let out = Bytes::new(8)
  let mut i = 0
  while i < 8 {
    out[i] = ((fp >> (i * 8)) & 0xFFUL).to_int().to_byte()
    i = i + 1
  }
  out
}

///| Compute the 16-character lowercase hex string of the CRC-64-AVRO Rabin fingerprint.
pub fn fingerprint_rabin_hex(schema : Schema) -> String {
  let fp = fingerprint_rabin(schema)
  let lut = "0123456789abcdef"
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((fp >> shift) & 15UL).to_int()
    out[i] = lut.code_unit_at(nib).to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}
