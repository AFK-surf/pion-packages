///| Apache Avro 1.11.1 Schema representation, parser, Parsing Canonical Form, and CRC-64-AVRO Rabin fingerprint.

///| Logical type annotation attached to an Avro schema node.
pub enum LogicalType {
  None
  Decimal(Int, Int)
  Uuid
  Date
  TimeMillis
  TimeMicros
  TimestampMillis
  TimestampMicros
  Duration
}

///| Record field sort order.
pub enum FieldOrder {
  Ascending
  Descending
  Ignore
}

///| A single field of an Avro `record` schema.
pub struct RecordField {
  pub name : String
  pub schema_id : Int
  pub doc : Option[String]
  pub default_val : Option[AvroValue]
  pub order : FieldOrder
  pub aliases : Array[String]
}

///| Core kind of an Avro schema node in the arena.
pub enum SchemaKind {
  Null
  Boolean
  Int
  Long
  Float
  Double
  Bytes
  String
  Record(String, Array[String], Array[RecordField])
  Enum(String, Array[String], Array[String], Option[String])
  Array(Int)
  Map(Int)
  Union(Array[Int])
  Fixed(String, Array[String], Int)
  Ref(Int)
}

///| A node in the `Schema` arena.
pub struct SchemaNode {
  pub kind : SchemaKind
  pub logical : LogicalType
}

///| Arena-backed Avro schema supporting recursive and shared named types without reference cycles.
pub struct Schema {
  pub root : Int
  pub nodes : Array[SchemaNode]
  pub named_indices : Array[(String, Int)]
}

///| Return the root `SchemaNode` of a `Schema`.
pub fn Schema::root_node(self : Schema) -> SchemaNode {
  self.nodes[self.root]
}

///| Resolve a `SchemaKind::Ref` chain to its target node index.
pub fn Schema::resolve_id(self : Schema, id : Int) -> Int {
  let mut cur = id
  let mut steps = 0
  while steps < 64 {
    match self.nodes[cur].kind {
      SchemaKind::Ref(target) => {
        cur = target
        steps = steps + 1
      }
      _ => return cur
    }
  }
  cur
}

///| Parse an Apache Avro 1.11.1 JSON schema using default limits.
pub fn parse_schema(json_str : String) -> Result[Schema, AvroError] {
  parse_schema_with_limits(json_str, AvroLimits::default())
}

///| Parse an Apache Avro 1.11.1 JSON schema with custom limits.
pub fn parse_schema_with_limits(
  json_str : String,
  limits : AvroLimits,
) -> Result[Schema, AvroError] {
  let _ = json_str
  let _ = limits
  Err(AvroError::InvalidSchema("not implemented"))
}

///| Produce the Apache Avro 1.11.1 Parsing Canonical Form (PCF) of a schema.
pub fn canonical_form(schema : Schema) -> String {
  let _ = schema
  ""
}

///| Compute the official 64-bit CRC-64-AVRO Rabin fingerprint of a schema's Parsing Canonical Form.
pub fn fingerprint_rabin(schema : Schema) -> UInt64 {
  let _ = schema
  0UL
}

///| Compute the 8-byte little-endian CRC-64-AVRO Rabin fingerprint of a schema.
pub fn fingerprint_rabin_bytes(schema : Schema) -> Bytes {
  let _ = schema
  Bytes::new(0)
}

///| Compute the 16-character lowercase hex string of the CRC-64-AVRO Rabin fingerprint.
pub fn fingerprint_rabin_hex(schema : Schema) -> String {
  let _ = schema
  ""
}
