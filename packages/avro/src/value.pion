///| Core Apache Avro 1.11.1 value model, limits, error types, and low-level primitives.

///| Error returned by Avro schema parsing, datum encoding/decoding, schema resolution, and OCF I/O.
pub enum AvroError {
  InvalidSchema(String)
  InvalidJson(String)
  InvalidBinary(String)
  InvalidUtf8(String)
  SchemaMismatch(String)
  ResolutionError(String)
  InvalidOcf(String)
  UnsupportedCodec(String)
  DecompressionError(String)
  LimitExceeded(String)
  UnexpectedEof(String)
  TrailingBytes(Int)
  InvalidLogicalType(String)
  InvalidValue(String)
}

///| Human-readable description of an `AvroError`.
pub fn error_message(err : AvroError) -> String {
  match err {
    InvalidSchema(m) => "invalid schema: " + m
    InvalidJson(m) => "invalid json: " + m
    InvalidBinary(m) => "invalid binary: " + m
    InvalidUtf8(m) => "invalid utf-8: " + m
    SchemaMismatch(m) => "schema mismatch: " + m
    ResolutionError(m) => "resolution error: " + m
    InvalidOcf(m) => "invalid ocf: " + m
    UnsupportedCodec(m) => "unsupported codec: " + m
    DecompressionError(m) => "decompression error: " + m
    LimitExceeded(m) => "limit exceeded: " + m
    UnexpectedEof(m) => "unexpected eof: " + m
    TrailingBytes(n) => "trailing bytes: " + n.to_string()
    InvalidLogicalType(m) => "invalid logical type: " + m
    InvalidValue(m) => "invalid value: " + m
  }
}

///|
pub fn AvroError::to_string(self : AvroError) -> String {
  error_message(self)
}

///| Resource and DoS protection limits for Avro schema parsing, datum codecs, and OCF decompression.
pub val struct AvroLimits {
  pub max_depth : Int
  pub max_elements : Int
  pub max_bytes : Int
  pub max_schema_types : Int
}

///| Default Avro resource limits (depth 64, 1M elements, 64 MiB max bytes/block, 4096 schema nodes).
pub fn AvroLimits::default() -> AvroLimits {
  AvroLimits::{
    max_depth: 64,
    max_elements: 1000000,
    max_bytes: 67108864,
    max_schema_types: 4096,
  }
}

///|
pub fn AvroLimits::with_max_depth(self : AvroLimits, v : Int) -> AvroLimits {
  AvroLimits::{
    max_depth: v,
    max_elements: self.max_elements,
    max_bytes: self.max_bytes,
    max_schema_types: self.max_schema_types,
  }
}

///|
pub fn AvroLimits::with_max_elements(self : AvroLimits, v : Int) -> AvroLimits {
  AvroLimits::{
    max_depth: self.max_depth,
    max_elements: v,
    max_bytes: self.max_bytes,
    max_schema_types: self.max_schema_types,
  }
}

///|
pub fn AvroLimits::with_max_bytes(self : AvroLimits, v : Int) -> AvroLimits {
  AvroLimits::{
    max_depth: self.max_depth,
    max_elements: self.max_elements,
    max_bytes: v,
    max_schema_types: self.max_schema_types,
  }
}

///|
pub fn AvroLimits::with_max_schema_types(self : AvroLimits, v : Int) -> AvroLimits {
  AvroLimits::{
    max_depth: self.max_depth,
    max_elements: self.max_elements,
    max_bytes: self.max_bytes,
    max_schema_types: v,
  }
}

///| Dynamic Apache Avro datum value supporting all 8 primitives and 6 complex types.
pub enum AvroValue {
  Null
  Boolean(Bool)
  Int(Int)
  Long(Int64)
  Float32(Double)
  Float64(Double)
  Bytes(Bytes)
  String(String)
  Fixed(Bytes)
  Enum(Int, String)
  Array(Array[AvroValue])
  Map(Array[(String, AvroValue)])
  Union(Int, AvroValue)
  Record(Array[(String, AvroValue)])
}

///| Compare two `Bytes` buffers for exact byte-for-byte equality.
pub fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Bit-exact structural equality for `AvroValue`.
pub fn avro_value_eq(a : AvroValue, b : AvroValue) -> Bool {
  match (a, b) {
    (AvroValue::Null, AvroValue::Null) => true
    (AvroValue::Boolean(x), AvroValue::Boolean(y)) => x == y
    (AvroValue::Int(x), AvroValue::Int(y)) => x == y
    (AvroValue::Long(x), AvroValue::Long(y)) => x == y
    (AvroValue::Float32(x), AvroValue::Float32(y)) =>
    double_to_float32_bits(x) == double_to_float32_bits(y)
    (AvroValue::Float64(x), AvroValue::Float64(y)) => x.to_bits() == y.to_bits()
    (AvroValue::Bytes(x), AvroValue::Bytes(y)) => bytes_equal(x, y)
    (AvroValue::String(x), AvroValue::String(y)) => x == y
    (AvroValue::Fixed(x), AvroValue::Fixed(y)) => bytes_equal(x, y)
    (AvroValue::Enum(ix, sx), AvroValue::Enum(iy, sy)) => ix == iy && sx == sy
    (AvroValue::Union(ix, vx), AvroValue::Union(iy, vy)) => ix == iy && avro_value_eq(vx, vy)
    (AvroValue::Array(xs), AvroValue::Array(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        if !avro_value_eq(xs[i], ys[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (AvroValue::Map(xs), AvroValue::Map(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        let (kx, vx) = xs[i]
        let (ky, vy) = ys[i]
        if kx != ky || !avro_value_eq(vx, vy) {
          return false
        }
        i = i + 1
      }
      true
    }
    (AvroValue::Record(xs), AvroValue::Record(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        let (kx, vx) = xs[i]
        let (ky, vy) = ys[i]
        if kx != ky || !avro_value_eq(vx, vy) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

///| ZigZag encode a signed 32-bit integer to unsigned 32-bit (in lower 32 bits of UInt64).
pub fn zigzag_encode_i32(n : Int) -> UInt64 {
  let n32 = (n.to_int64() << 32) >> 32
  (((n32 << 1) ^ (n32 >> 63)) & 0xFFFFFFFFL).to_uint64()
}

///| ZigZag decode an unsigned 32-bit integer to signed 32-bit `Int`.
pub fn zigzag_decode_i32(u : UInt64) -> Int {
  let u32 = (u & 0xFFFFFFFFUL).to_int64()
  let v = (u32 >> 1) ^ -(u32 & 1L)
  ((v << 32) >> 32).to_int()
}

///| ZigZag encode a signed 64-bit integer to `UInt64`.
pub fn zigzag_encode_i64(n : Int64) -> UInt64 {
  ((n << 1) ^ (n >> 63)).to_uint64()
}

///| ZigZag decode a `UInt64` to signed 64-bit `Int64`.
pub fn zigzag_decode_i64(u : UInt64) -> Int64 {
  (u >> 1).to_int64() ^ -(u & 1UL).to_int64()
}

///| Convert IEEE-754 binary32 bits (lower 32 bits of Int64) to `Double`.
pub fn float32_bits_to_double(bits : Int64) -> Double {
  let u = bits & 0xFFFFFFFFL
  let sign : Int64 = (u >> 31) & 1L
  let exp = ((u >> 23) & 0xFFL).to_int()
  let frac : Int64 = u & 0x7FFFFFL
  if exp == 0 {
    if frac == 0L {
      return Double::from_bits(sign << 63)
    }
    let mut f = frac
    let mut e64 = 897
    while (f & 0x800000L) == 0L {
      f = f << 1
      e64 = e64 - 1
    }
    let mant : Int64 = (f & 0x7FFFFFL) << 29
    return Double::from_bits((sign << 63) | (e64.to_int64() << 52) | mant)
  }
  if exp == 255 {
    if frac == 0L {
      return Double::from_bits((sign << 63) | (0x7FFL << 52))
    }
    let mant : Int64 = frac << 29
    return Double::from_bits((sign << 63) | (0x7FFL << 52) | mant)
  }
  let e64 : Int64 = (exp + 896).to_int64()
  let mant : Int64 = frac << 29
  Double::from_bits((sign << 63) | (e64 << 52) | mant)
}

///| Convert `Double` to IEEE-754 binary32 bits (lower 32 bits of Int64).
pub fn double_to_float32_bits(value : Double) -> Int64 {
  let bits = value.to_bits()
  let sign : Int64 = (bits >> 63) & 1L
  let exp = ((bits >> 52) & 0x7FFL).to_int()
  let frac : Int64 = bits & 0x000FFFFFFFFFFFFFL
  if exp == 0x7FF {
    if frac == 0L {
      return (sign << 31) | 0x7F800000L
    }
    let payload = (frac >> 29) & 0x7FFFFFL
    let safe_payload = if payload == 0L { 0x400000L } else { payload }
    return (sign << 31) | 0x7F800000L | safe_payload
  }
  if exp == 0 && frac == 0L {
    return sign << 31
  }
  let e = exp - 1023
  if e > 127 {
    return (sign << 31) | 0x7F800000L
  }
  if e >= -126 {
    let mut mant = (frac >> 29) & 0x7FFFFFL
    let rem = frac & 0x1FFFFFFFL
    let half : Int64 = 0x10000000L
    if rem > half || (rem == half && (mant & 1L) != 0L) {
      mant = mant + 1L
      if mant == 0x800000L {
        mant = 0L
        let ne = e + 1
        if ne > 127 {
          return (sign << 31) | 0x7F800000L
        }
        return (sign << 31) | ((ne + 127).to_int64() << 23)
      }
    }
    return (sign << 31) | ((e + 127).to_int64() << 23) | mant
  }
  if e >= -150 {
    let full_sig : Int64 = (1L << 52) | frac
    let shift = -97 - e
    if shift >= 54 {
      return sign << 31
    }
    let mut mant = full_sig >> shift
    let half : Int64 = 1L << (shift - 1)
    let rem = full_sig & ((1L << shift) - 1L)
    if rem > half || (rem == half && (mant & 1L) != 0L) {
      mant = mant + 1L
      if mant == 0x800000L {
        return (sign << 31) | 0x00800000L
      }
    }
    return (sign << 31) | (mant & 0x7FFFFFL)
  }
  sign << 31
}

///| Strict RFC 3629 UTF-8 validation over `data[start..start+len]`.
fn is_valid_utf8_range(data : Bytes, start : Int, len : Int) -> Bool {
  let end = start + len
  let mut i = start
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
      while i < end && data[i].to_int() < 0x80 {
        i = i + 1
      }
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}
