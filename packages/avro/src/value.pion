///| Core Apache Avro 1.11.1 value model, limits, error types, and low-level primitives.

///| Error returned by Avro schema parsing, datum encoding/decoding, schema resolution, and OCF I/O.
pub enum AvroError {
  InvalidSchema(String)
  InvalidJson(String)
  InvalidBinary(String)
  InvalidUtf8(String)
  SchemaMismatch(String)
  ResolutionError(String)
  InvalidOcf(String)
  UnsupportedCodec(String)
  DecompressionError(String)
  LimitExceeded(String)
  UnexpectedEof(String)
  TrailingBytes(Int)
  InvalidLogicalType(String)
  InvalidValue(String)
}

///| Human-readable description of an `AvroError`.
pub fn error_message(err : AvroError) -> String {
  match err {
    InvalidSchema(m) => "invalid schema: " + m
    InvalidJson(m) => "invalid json: " + m
    InvalidBinary(m) => "invalid binary: " + m
    InvalidUtf8(m) => "invalid utf-8: " + m
    SchemaMismatch(m) => "schema mismatch: " + m
    ResolutionError(m) => "resolution error: " + m
    InvalidOcf(m) => "invalid ocf: " + m
    UnsupportedCodec(m) => "unsupported codec: " + m
    DecompressionError(m) => "decompression error: " + m
    LimitExceeded(m) => "limit exceeded: " + m
    UnexpectedEof(m) => "unexpected eof: " + m
    TrailingBytes(n) => "trailing bytes: " + n.to_string()
    InvalidLogicalType(m) => "invalid logical type: " + m
    InvalidValue(m) => "invalid value: " + m
  }
}

///|
pub fn AvroError::to_string(self : AvroError) -> String {
  error_message(self)
}

///| Resource and DoS protection limits for Avro schema parsing, datum codecs, and OCF decompression.
pub val struct AvroLimits {
  pub max_depth : Int
  pub max_elements : Int
  pub max_bytes : Int
  pub max_schema_types : Int
}

///| Default Avro resource limits (depth 64, 1M elements, 64 MiB max bytes/block, 4096 schema nodes).
pub fn AvroLimits::default() -> AvroLimits {
  AvroLimits::{
    max_depth: 64,
    max_elements: 1000000,
    max_bytes: 67108864,
    max_schema_types: 4096,
  }
}

///|
pub fn AvroLimits::with_max_depth(self : AvroLimits, v : Int) -> AvroLimits {
  AvroLimits::{
    max_depth: v,
    max_elements: self.max_elements,
    max_bytes: self.max_bytes,
    max_schema_types: self.max_schema_types,
  }
}

///|
pub fn AvroLimits::with_max_elements(self : AvroLimits, v : Int) -> AvroLimits {
  AvroLimits::{
    max_depth: self.max_depth,
    max_elements: v,
    max_bytes: self.max_bytes,
    max_schema_types: self.max_schema_types,
  }
}

///|
pub fn AvroLimits::with_max_bytes(self : AvroLimits, v : Int) -> AvroLimits {
  AvroLimits::{
    max_depth: self.max_depth,
    max_elements: self.max_elements,
    max_bytes: v,
    max_schema_types: self.max_schema_types,
  }
}

///|
pub fn AvroLimits::with_max_schema_types(self : AvroLimits, v : Int) -> AvroLimits {
  AvroLimits::{
    max_depth: self.max_depth,
    max_elements: self.max_elements,
    max_bytes: self.max_bytes,
    max_schema_types: v,
  }
}

///| Dynamic Apache Avro datum value supporting all 8 primitives and 6 complex types.
pub enum AvroValue {
  Null
  Boolean(Bool)
  Int(Int)
  Long(Int64)
  Float32(Double)
  Float64(Double)
  Bytes(Bytes)
  String(String)
  Fixed(Bytes)
  Enum(Int, String)
  Array(Array[AvroValue])
  Map(Array[(String, AvroValue)])
  Union(Int, AvroValue)
  Record(Array[(String, AvroValue)])
}

///| Compare two `Bytes` buffers for exact byte-for-byte equality.
pub fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Bit-exact structural equality for `AvroValue`.
pub fn avro_value_eq(a : AvroValue, b : AvroValue) -> Bool {
  let _ = a
  let _ = b
  false
}

///| ZigZag encode a signed 32-bit integer to unsigned 32-bit (in lower 32 bits of UInt64).
pub fn zigzag_encode_i32(n : Int) -> UInt64 {
  let _ = n
  0UL
}

///| ZigZag decode an unsigned 32-bit integer to signed 32-bit `Int`.
pub fn zigzag_decode_i32(u : UInt64) -> Int {
  let _ = u
  0
}

///| ZigZag encode a signed 64-bit integer to `UInt64`.
pub fn zigzag_encode_i64(n : Int64) -> UInt64 {
  let _ = n
  0UL
}

///| ZigZag decode a `UInt64` to signed 64-bit `Int64`.
pub fn zigzag_decode_i64(u : UInt64) -> Int64 {
  let _ = u
  0L
}

///| Convert IEEE-754 binary32 bits (lower 32 bits of Int64) to `Double`.
pub fn float32_bits_to_double(bits : Int64) -> Double {
  let _ = bits
  0.0
}

///| Convert `Double` to IEEE-754 binary32 bits (lower 32 bits of Int64).
pub fn double_to_float32_bits(value : Double) -> Int64 {
  let _ = value
  0L
}
