///| Apache Avro 1.11.1 binary datum encoder, decoder, and datum skipper.

///| Chunked, amortized-growth binary writer with fast ZigZag varint and IEEE-754 helpers.
struct BinWriter {
  mut buf : Bytes
  mut len : Int
  chunks : Array[Bytes]
}

fn BinWriter::new(init_cap : Int) -> BinWriter {
  let c = if init_cap < 128 { 128 } else if init_cap > 65536 { 65536 } else { init_cap }
  BinWriter::{ buf: Bytes::new(c), len: 0, chunks: [] }
}

fn bw_ensure(w : BinWriter, extra : Int) -> Unit {
  let needed = w.len + extra
  if needed <= w.buf.length() {
    return
  }
  if w.len >= 4096 {
    w.chunks.push(w.buf.slice(0, w.len))
    w.len = 0
    if extra <= w.buf.length() {
      return
    }
    let mut cap = w.buf.length() * 2
    while cap < extra {
      cap = cap * 2
    }
    w.buf = Bytes::new(cap)
    return
  }
  let mut cap = w.buf.length() * 2
  while cap < needed {
    cap = cap * 2
  }
  let next = Bytes::new(cap)
  let mut i = 0
  while i < w.len {
    next[i] = w.buf[i]
    i = i + 1
  }
  w.buf = next
}

fn bw_write_byte(w : BinWriter, b : Int) -> Unit {
  bw_ensure(w, 1)
  w.buf[w.len] = b.to_byte()
  w.len = w.len + 1
}

fn bw_write_bytes_raw(w : BinWriter, src : Bytes) -> Unit {
  let n = src.length()
  if n == 0 {
    return
  }
  if n >= 4096 {
    if w.len > 0 {
      w.chunks.push(w.buf.slice(0, w.len))
      w.len = 0
    }
    w.chunks.push(src)
    return
  }
  bw_ensure(w, n)
  let mut i = 0
  let dst_off = w.len
  while i < n {
    w.buf[dst_off + i] = src[i]
    i = i + 1
  }
  w.len = dst_off + n
}

fn bw_write_varint_u64(w : BinWriter, v : UInt64) -> Unit {
  bw_ensure(w, 10)
  let mut u = v
  let mut pos = w.len
  while u >= 0x80UL {
    w.buf[pos] = ((u & 0x7FUL) | 0x80UL).to_int().to_byte()
    u = u >> 7
    pos = pos + 1
  }
  w.buf[pos] = (u & 0x7FUL).to_int().to_byte()
  w.len = pos + 1
}

fn bw_write_i32(w : BinWriter, n : Int) -> Unit {
  bw_write_varint_u64(w, zigzag_encode_i32(n))
}

fn bw_write_i64(w : BinWriter, n : Int64) -> Unit {
  bw_write_varint_u64(w, zigzag_encode_i64(n))
}

fn bw_write_f32_bits(w : BinWriter, bits : Int64) -> Unit {
  bw_ensure(w, 4)
  let p = w.len
  w.buf[p] = (bits & 0xFFL).to_int().to_byte()
  w.buf[p + 1] = ((bits >> 8) & 0xFFL).to_int().to_byte()
  w.buf[p + 2] = ((bits >> 16) & 0xFFL).to_int().to_byte()
  w.buf[p + 3] = ((bits >> 24) & 0xFFL).to_int().to_byte()
  w.len = p + 4
}

fn bw_write_f64_bits(w : BinWriter, bits : Int64) -> Unit {
  bw_ensure(w, 8)
  let p = w.len
  w.buf[p] = (bits & 0xFFL).to_int().to_byte()
  w.buf[p + 1] = ((bits >> 8) & 0xFFL).to_int().to_byte()
  w.buf[p + 2] = ((bits >> 16) & 0xFFL).to_int().to_byte()
  w.buf[p + 3] = ((bits >> 24) & 0xFFL).to_int().to_byte()
  w.buf[p + 4] = ((bits >> 32) & 0xFFL).to_int().to_byte()
  w.buf[p + 5] = ((bits >> 40) & 0xFFL).to_int().to_byte()
  w.buf[p + 6] = ((bits >> 48) & 0xFFL).to_int().to_byte()
  w.buf[p + 7] = ((bits >> 56) & 0xFFL).to_int().to_byte()
  w.len = p + 8
}

fn bw_write_len_bytes(w : BinWriter, b : Bytes) -> Unit {
  bw_write_i64(w, b.length().to_int64())
  bw_write_bytes_raw(w, b)
}

fn bw_write_string(w : BinWriter, s : String) -> Unit {
  let b = s.to_bytes()
  bw_write_i64(w, b.length().to_int64())
  bw_write_bytes_raw(w, b)
}

fn bw_finish(w : BinWriter) -> Bytes {
  if w.chunks.length() == 0 {
    return w.buf.slice(0, w.len)
  }
  let mut total = w.len
  let mut i = 0
  while i < w.chunks.length() {
    total = total + w.chunks[i].length()
    i = i + 1
  }
  let out = Bytes::new(total)
  let mut off = 0
  let mut c = 0
  while c < w.chunks.length() {
    let ch = w.chunks[c]
    let clen = ch.length()
    let mut k = 0
    while k < clen {
      out[off + k] = ch[k]
      k = k + 1
    }
    off = off + clen
    c = c + 1
  }
  let mut k = 0
  while k < w.len {
    out[off + k] = w.buf[k]
    k = k + 1
  }
  out
}

///| Zero-copy binary reader with depth, element count, and byte limits tracking.
struct BinReader {
  data : Bytes
  mut pos : Int
  end : Int
  limits : AvroLimits
  mut depth : Int
  mut elements : Int
}

fn BinReader::new(data : Bytes, start : Int, end : Int, limits : AvroLimits) -> BinReader {
  BinReader::{ data: data, pos: start, end: end, limits: limits, depth: 0, elements: 0 }
}

fn br_read_varint_u64(r : BinReader) -> Result[UInt64, AvroError] {
  let mut result : UInt64 = 0UL
  let mut shift = 0
  let mut count = 0
  while r.pos < r.end {
    let b = r.data[r.pos].to_int()
    r.pos = r.pos + 1
    if count == 9 {
      // 10th byte: only bit 0 is valid for 64-bit varint
      if b > 1 {
        return Err(AvroError::InvalidBinary("64-bit varint overflow"))
      }
      result = result | (b.to_int64().to_uint64() << 63)
      return Ok(result)
    }
    result = result | ((b & 0x7F).to_int64().to_uint64() << shift)
    if (b & 0x80) == 0 {
      return Ok(result)
    }
    shift = shift + 7
    count = count + 1
  }
  Err(AvroError::UnexpectedEof("truncated varint"))
}

fn br_read_i32(r : BinReader) -> Result[Int, AvroError] {
  let u = match br_read_varint_u64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if u > 0xFFFFFFFFUL {
    return Err(AvroError::InvalidBinary("32-bit int varint overflow"))
  }
  Ok(zigzag_decode_i32(u))
}

fn br_read_i64(r : BinReader) -> Result[Int64, AvroError] {
  let u = match br_read_varint_u64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok(zigzag_decode_i64(u))
}

fn br_read_bool(r : BinReader) -> Result[Bool, AvroError] {
  if r.pos >= r.end {
    return Err(AvroError::UnexpectedEof("truncated boolean"))
  }
  let b = r.data[r.pos].to_int()
  r.pos = r.pos + 1
  if b == 0 {
    Ok(false)
  } else if b == 1 {
    Ok(true)
  } else {
    Err(AvroError::InvalidBinary("invalid boolean byte: " + b.to_string()))
  }
}

fn br_read_f32_bits(r : BinReader) -> Result[Int64, AvroError] {
  if r.pos + 4 > r.end {
    return Err(AvroError::UnexpectedEof("truncated float"))
  }
  let p = r.pos
  let b0 = r.data[p].to_int().to_int64()
  let b1 = r.data[p + 1].to_int().to_int64()
  let b2 = r.data[p + 2].to_int().to_int64()
  let b3 = r.data[p + 3].to_int().to_int64()
  r.pos = p + 4
  Ok(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))
}

fn br_read_f64_bits(r : BinReader) -> Result[Int64, AvroError] {
  if r.pos + 8 > r.end {
    return Err(AvroError::UnexpectedEof("truncated double"))
  }
  let p = r.pos
  let b0 = r.data[p].to_int().to_int64()
  let b1 = r.data[p + 1].to_int().to_int64()
  let b2 = r.data[p + 2].to_int().to_int64()
  let b3 = r.data[p + 3].to_int().to_int64()
  let b4 = r.data[p + 4].to_int().to_int64()
  let b5 = r.data[p + 5].to_int().to_int64()
  let b6 = r.data[p + 6].to_int().to_int64()
  let b7 = r.data[p + 7].to_int().to_int64()
  r.pos = p + 8
  Ok(
    b0 |
    (b1 << 8) |
    (b2 << 16) |
    (b3 << 24) |
    (b4 << 32) |
    (b5 << 40) |
    (b6 << 48) |
    (b7 << 56),
  )
}

fn br_read_bytes(r : BinReader) -> Result[Bytes, AvroError] {
  let n64 = match br_read_i64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if n64 < 0L {
    return Err(AvroError::InvalidBinary("negative bytes length"))
  }
  if n64 > r.limits.max_bytes.to_int64() {
    return Err(AvroError::LimitExceeded("bytes length exceeds max_bytes"))
  }
  let n = n64.to_int()
  if n > r.end - r.pos {
    return Err(AvroError::UnexpectedEof("truncated bytes payload"))
  }
  let sl = r.data.slice(r.pos, r.pos + n)
  r.pos = r.pos + n
  Ok(sl)
}

fn br_read_string(r : BinReader) -> Result[String, AvroError] {
  let n64 = match br_read_i64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if n64 < 0L {
    return Err(AvroError::InvalidBinary("negative string length"))
  }
  if n64 > r.limits.max_bytes.to_int64() {
    return Err(AvroError::LimitExceeded("string length exceeds max_bytes"))
  }
  let n = n64.to_int()
  if n > r.end - r.pos {
    return Err(AvroError::UnexpectedEof("truncated string payload"))
  }
  if !is_valid_utf8_range(r.data, r.pos, n) {
    return Err(AvroError::InvalidUtf8("invalid UTF-8 in binary string"))
  }
  let sl = r.data.slice(r.pos, r.pos + n)
  r.pos = r.pos + n
  Ok(sl.to_string())
}

fn br_read_fixed(r : BinReader, size : Int) -> Result[Bytes, AvroError] {
  if size < 0 || size > r.end - r.pos {
    return Err(AvroError::UnexpectedEof("truncated fixed payload"))
  }
  let sl = r.data.slice(r.pos, r.pos + size)
  r.pos = r.pos + size
  Ok(sl)
}

fn br_read_block_count(r : BinReader) -> Result[Int64, AvroError] {
  let count = match br_read_i64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count == 0L {
    return Ok(0L)
  }
  if count < 0L {
    if count == (-9223372036854775807L - 1L) {
      return Err(AvroError::InvalidBinary("block count Int64::min overflow"))
    }
    let byte_size = match br_read_i64(r) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
      return Err(AvroError::InvalidBinary("invalid negative-count block byte_size"))
    }
    return Ok(-count)
  }
  Ok(count)
}

fn encode_datum_into(
  w : BinWriter,
  schema : Schema,
  node_id : Int,
  value : AvroValue,
  limits : AvroLimits,
  depth : Int,
) -> Result[Unit, AvroError] {
  if depth > limits.max_depth {
    return Err(AvroError::LimitExceeded("max_depth exceeded in encode_datum"))
  }
  let rid = schema.resolve_id(node_id)
  match (schema.nodes[rid].kind, value) {
    (SchemaKind::Null, AvroValue::Null) => Ok(())
    (SchemaKind::Boolean, AvroValue::Boolean(b)) => {
      bw_write_byte(w, if b { 1 } else { 0 })
      Ok(())
    }
    (SchemaKind::Int, AvroValue::Int(v)) => {
      bw_write_i32(w, v)
      Ok(())
    }
    (SchemaKind::Long, AvroValue::Long(v)) => {
      bw_write_i64(w, v)
      Ok(())
    }
    (SchemaKind::Float, AvroValue::Float32(v)) => {
      bw_write_f32_bits(w, double_to_float32_bits(v))
      Ok(())
    }
    (SchemaKind::Double, AvroValue::Float64(v)) => {
      bw_write_f64_bits(w, v.to_bits())
      Ok(())
    }
    (SchemaKind::Bytes, AvroValue::Bytes(b)) => {
      bw_write_len_bytes(w, b)
      Ok(())
    }
    (SchemaKind::String, AvroValue::String(s)) => {
      bw_write_string(w, s)
      Ok(())
    }
    (SchemaKind::Fixed(_, _, size), AvroValue::Fixed(b)) => {
      if b.length() != size {
        return Err(AvroError::SchemaMismatch("fixed length mismatch"))
      }
      bw_write_bytes_raw(w, b)
      Ok(())
    }
    (SchemaKind::Enum(_, _, symbols, _), AvroValue::Enum(idx, sym)) => {
      if idx < 0 || idx >= symbols.length() || symbols[idx] != sym {
        return Err(AvroError::SchemaMismatch("invalid enum value: " + sym))
      }
      bw_write_i32(w, idx)
      Ok(())
    }
    (SchemaKind::Array(item_id), AvroValue::Array(items)) => {
      let n = items.length()
      if n > 0 {
        bw_write_i64(w, n.to_int64())
        let mut i = 0
        while i < n {
          match encode_datum_into(w, schema, item_id, items[i], limits, depth + 1) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          i = i + 1
        }
      }
      bw_write_byte(w, 0)
      Ok(())
    }
    (SchemaKind::Map(val_id), AvroValue::Map(entries)) => {
      let n = entries.length()
      if n > 0 {
        bw_write_i64(w, n.to_int64())
        let mut i = 0
        while i < n {
          let (k, v) = entries[i]
          bw_write_string(w, k)
          match encode_datum_into(w, schema, val_id, v, limits, depth + 1) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          i = i + 1
        }
      }
      bw_write_byte(w, 0)
      Ok(())
    }
    (SchemaKind::Union(branches), AvroValue::Union(idx, inner)) => {
      if idx < 0 || idx >= branches.length() {
        return Err(AvroError::SchemaMismatch("union branch index out of range"))
      }
      bw_write_i64(w, idx.to_int64())
      encode_datum_into(w, schema, branches[idx], inner, limits, depth + 1)
    }
    (SchemaKind::Record(_, _, fields), AvroValue::Record(vals)) => {
      if vals.length() != fields.length() {
        return Err(AvroError::SchemaMismatch("record field count mismatch"))
      }
      let mut i = 0
      while i < fields.length() {
        let f = fields[i]
        let (vk, vv) = vals[i]
        if vk != f.name {
          return Err(AvroError::SchemaMismatch("record field name mismatch: " + vk))
        }
        match encode_datum_into(w, schema, f.schema_id, vv, limits, depth + 1) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      Ok(())
    }
    _ => Err(AvroError::SchemaMismatch("value does not match schema in encode_datum"))
  }
}

fn decode_datum_from(
  r : BinReader,
  schema : Schema,
  node_id : Int,
) -> Result[AvroValue, AvroError] {
  if r.depth > r.limits.max_depth {
    return Err(AvroError::LimitExceeded("max_depth exceeded in decode_datum"))
  }
  let rid = schema.resolve_id(node_id)
  match schema.nodes[rid].kind {
    SchemaKind::Null => Ok(AvroValue::Null)
    SchemaKind::Boolean =>
    match br_read_bool(r) {
      Ok(b) => Ok(AvroValue::Boolean(b))
      Err(e) => Err(e)
    }
    SchemaKind::Int =>
    match br_read_i32(r) {
      Ok(v) => Ok(AvroValue::Int(v))
      Err(e) => Err(e)
    }
    SchemaKind::Long =>
    match br_read_i64(r) {
      Ok(v) => Ok(AvroValue::Long(v))
      Err(e) => Err(e)
    }
    SchemaKind::Float =>
    match br_read_f32_bits(r) {
      Ok(bits) => Ok(AvroValue::Float32(float32_bits_to_double(bits)))
      Err(e) => Err(e)
    }
    SchemaKind::Double =>
    match br_read_f64_bits(r) {
      Ok(bits) => Ok(AvroValue::Float64(Double::from_bits(bits)))
      Err(e) => Err(e)
    }
    SchemaKind::Bytes =>
    match br_read_bytes(r) {
      Ok(b) => Ok(AvroValue::Bytes(b))
      Err(e) => Err(e)
    }
    SchemaKind::String =>
    match br_read_string(r) {
      Ok(s) => Ok(AvroValue::String(s))
      Err(e) => Err(e)
    }
    SchemaKind::Fixed(_, _, size) =>
    match br_read_fixed(r, size) {
      Ok(b) => Ok(AvroValue::Fixed(b))
      Err(e) => Err(e)
    }
    SchemaKind::Enum(_, _, symbols, _) => {
      let idx = match br_read_i32(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if idx < 0 || idx >= symbols.length() {
        return Err(AvroError::InvalidBinary("enum index out of range: " + idx.to_string()))
      }
      Ok(AvroValue::Enum(idx, symbols[idx]))
    }
    SchemaKind::Array(item_id) => {
      r.depth = r.depth + 1
      let items : Array[AvroValue] = []
      while true {
        let count = match br_read_block_count(r) {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        if count == 0L {
          break
        }
        if count > (r.limits.max_elements - r.elements).to_int64() {
          return Err(AvroError::LimitExceeded("array exceeds max_elements"))
        }
        let n = count.to_int()
        r.elements = r.elements + n
        let mut i = 0
        while i < n {
          let item = match decode_datum_from(r, schema, item_id) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          items.push(item)
          i = i + 1
        }
      }
      r.depth = r.depth - 1
      Ok(AvroValue::Array(items))
    }
    SchemaKind::Map(val_id) => {
      r.depth = r.depth + 1
      let entries : Array[(String, AvroValue)] = []
      while true {
        let count = match br_read_block_count(r) {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        if count == 0L {
          break
        }
        if count > (r.limits.max_elements - r.elements).to_int64() {
          return Err(AvroError::LimitExceeded("map exceeds max_elements"))
        }
        let n = count.to_int()
        r.elements = r.elements + n
        let mut i = 0
        while i < n {
          let k = match br_read_string(r) {
            Ok(s) => s
            Err(e) => return Err(e)
          }
          let v = match decode_datum_from(r, schema, val_id) {
            Ok(x) => x
            Err(e) => return Err(e)
          }
          entries.push((k, v))
          i = i + 1
        }
      }
      r.depth = r.depth - 1
      Ok(AvroValue::Map(entries))
    }
    SchemaKind::Union(branches) => {
      let idx64 = match br_read_i64(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if idx64 < 0L || idx64 >= branches.length().to_int64() {
        return Err(AvroError::InvalidBinary("union branch index out of range"))
      }
      let idx = idx64.to_int()
      r.depth = r.depth + 1
      let inner = match decode_datum_from(r, schema, branches[idx]) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      r.depth = r.depth - 1
      Ok(AvroValue::Union(idx, inner))
    }
    SchemaKind::Record(_, _, fields) => {
      r.depth = r.depth + 1
      let vals : Array[(String, AvroValue)] = []
      let mut i = 0
      while i < fields.length() {
        let f = fields[i]
        let v = match decode_datum_from(r, schema, f.schema_id) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        vals.push((f.name, v))
        i = i + 1
      }
      r.depth = r.depth - 1
      Ok(AvroValue::Record(vals))
    }
    SchemaKind::Ref(_) => Err(AvroError::InvalidSchema("unresolved ref"))
  }
}

///| Fast binary datum skipper used by Schema Evolution when writer has fields absent in reader.
fn skip_datum_from(r : BinReader, schema : Schema, node_id : Int) -> Result[Unit, AvroError] {
  if r.depth > r.limits.max_depth {
    return Err(AvroError::LimitExceeded("max_depth exceeded while skipping datum"))
  }
  let rid = schema.resolve_id(node_id)
  match schema.nodes[rid].kind {
    SchemaKind::Null => Ok(())
    SchemaKind::Boolean =>
    match br_read_bool(r) {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
    SchemaKind::Int =>
    match br_read_i32(r) {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
    SchemaKind::Long =>
    match br_read_i64(r) {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
    SchemaKind::Float => {
      if r.pos + 4 > r.end {
        return Err(AvroError::UnexpectedEof("truncated float"))
      }
      r.pos = r.pos + 4
      Ok(())
    }
    SchemaKind::Double => {
      if r.pos + 8 > r.end {
        return Err(AvroError::UnexpectedEof("truncated double"))
      }
      r.pos = r.pos + 8
      Ok(())
    }
    SchemaKind::Bytes | SchemaKind::String => {
      let n64 = match br_read_i64(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if n64 < 0L || n64 > (r.end - r.pos).to_int64() {
        return Err(AvroError::UnexpectedEof("truncated bytes/string during skip"))
      }
      r.pos = r.pos + n64.to_int()
      Ok(())
    }
    SchemaKind::Fixed(_, _, size) => {
      if size < 0 || size > r.end - r.pos {
        return Err(AvroError::UnexpectedEof("truncated fixed during skip"))
      }
      r.pos = r.pos + size
      Ok(())
    }
    SchemaKind::Enum(_, _, symbols, _) => {
      let idx = match br_read_i32(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if idx < 0 || idx >= symbols.length() {
        return Err(AvroError::InvalidBinary("enum index out of range during skip"))
      }
      Ok(())
    }
    SchemaKind::Array(item_id) => {
      r.depth = r.depth + 1
      while true {
        let count = match br_read_i64(r) {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        if count == 0L {
          break
        }
        if count < 0L {
          let byte_size = match br_read_i64(r) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
            return Err(AvroError::InvalidBinary("invalid block byte_size during skip"))
          }
          r.pos = r.pos + byte_size.to_int()
        } else {
          if count > (r.limits.max_elements - r.elements).to_int64() {
            return Err(AvroError::LimitExceeded("array exceeds max_elements during skip"))
          }
          let n = count.to_int()
          r.elements = r.elements + n
          let mut i = 0
          while i < n {
            match skip_datum_from(r, schema, item_id) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            i = i + 1
          }
        }
      }
      r.depth = r.depth - 1
      Ok(())
    }
    SchemaKind::Map(val_id) => {
      r.depth = r.depth + 1
      while true {
        let count = match br_read_i64(r) {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        if count == 0L {
          break
        }
        if count < 0L {
          let byte_size = match br_read_i64(r) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
            return Err(AvroError::InvalidBinary("invalid map block byte_size during skip"))
          }
          r.pos = r.pos + byte_size.to_int()
        } else {
          if count > (r.limits.max_elements - r.elements).to_int64() {
            return Err(AvroError::LimitExceeded("map exceeds max_elements during skip"))
          }
          let n = count.to_int()
          r.elements = r.elements + n
          let mut i = 0
          while i < n {
            let klen = match br_read_i64(r) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            if klen < 0L || klen > (r.end - r.pos).to_int64() {
              return Err(AvroError::UnexpectedEof("truncated map key during skip"))
            }
            r.pos = r.pos + klen.to_int()
            match skip_datum_from(r, schema, val_id) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            i = i + 1
          }
        }
      }
      r.depth = r.depth - 1
      Ok(())
    }
    SchemaKind::Union(branches) => {
      let idx64 = match br_read_i64(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if idx64 < 0L || idx64 >= branches.length().to_int64() {
        return Err(AvroError::InvalidBinary("union branch index out of range during skip"))
      }
      r.depth = r.depth + 1
      let res = skip_datum_from(r, schema, branches[idx64.to_int()])
      r.depth = r.depth - 1
      res
    }
    SchemaKind::Record(_, _, fields) => {
      r.depth = r.depth + 1
      let mut i = 0
      while i < fields.length() {
        match skip_datum_from(r, schema, fields[i].schema_id) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      r.depth = r.depth - 1
      Ok(())
    }
    SchemaKind::Ref(_) => Err(AvroError::InvalidSchema("unresolved ref"))
  }
}

///| Encode an `AvroValue` to Avro binary format using default limits.
pub fn encode_datum(schema : Schema, value : AvroValue) -> Result[Bytes, AvroError] {
  encode_datum_with_limits(schema, value, AvroLimits::default())
}

///| Encode an `AvroValue` to Avro binary format with custom limits.
pub fn encode_datum_with_limits(
  schema : Schema,
  value : AvroValue,
  limits : AvroLimits,
) -> Result[Bytes, AvroError] {
  let w = BinWriter::new(256)
  match encode_datum_into(w, schema, schema.root, value, limits, 0) {
    Ok(_) => Ok(bw_finish(w))
    Err(e) => Err(e)
  }
}

///| Decode a single Avro binary datum using default limits (rejects trailing bytes).
pub fn decode_datum(schema : Schema, data : Bytes) -> Result[AvroValue, AvroError] {
  decode_datum_with_limits(schema, data, AvroLimits::default())
}

///| Decode a single Avro binary datum with custom limits (rejects trailing bytes).
pub fn decode_datum_with_limits(
  schema : Schema,
  data : Bytes,
  limits : AvroLimits,
) -> Result[AvroValue, AvroError] {
  let r = BinReader::new(data, 0, data.length(), limits)
  let decoded = match decode_datum_from(r, schema, schema.root) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if r.pos != r.end {
    return Err(AvroError::TrailingBytes(r.end - r.pos))
  }
  Ok(decoded)
}

///| Decode a datum starting at `offset` in `data`, returning `(value, next_offset)`.
pub fn decode_datum_at(
  schema : Schema,
  data : Bytes,
  offset : Int,
  limits : AvroLimits,
) -> Result[(AvroValue, Int), AvroError] {
  if offset < 0 || offset > data.length() {
    return Err(AvroError::UnexpectedEof("offset out of range"))
  }
  let r = BinReader::new(data, offset, data.length(), limits)
  let decoded = match decode_datum_from(r, schema, schema.root) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok((decoded, r.pos))
}

///| Encode a batch of datums back-to-back into a single binary buffer using one writer.
pub fn encode_datums(
  schema : Schema,
  values : Array[AvroValue],
  limits : AvroLimits,
) -> Result[Bytes, AvroError] {
  let w = BinWriter::new(4096)
  let n = values.length()
  let mut i = 0
  while i < n {
    match encode_datum_into(w, schema, schema.root, values[i], limits, 0) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(bw_finish(w))
}

///| Decode `count` back-to-back datums from `data` (rejects trailing bytes).
pub fn decode_datums(
  schema : Schema,
  data : Bytes,
  count : Int,
  limits : AvroLimits,
) -> Result[Array[AvroValue], AvroError] {
  let r = BinReader::new(data, 0, data.length(), limits)
  let out : Array[AvroValue] = []
  let mut i = 0
  while i < count {
    r.elements = 0
    let v = match decode_datum_from(r, schema, schema.root) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    out.push(v)
    i = i + 1
  }
  if r.pos != r.end {
    return Err(AvroError::TrailingBytes(r.end - r.pos))
  }
  Ok(out)
}
