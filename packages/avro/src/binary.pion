///| Apache Avro 1.11.1 binary datum encoder, decoder, and datum skipper.

let empty_bytes : Bytes = Bytes::new(0)
let val_true : AvroValue = AvroValue::Boolean(true)
let val_false : AvroValue = AvroValue::Boolean(false)
let union_null_0 : AvroValue = AvroValue::Union(0, AvroValue::Null)
let union_null_1 : AvroValue = AvroValue::Union(1, AvroValue::Null)

///| Contiguous amortized-growth binary writer with cached capacity, unboxed error state, and reusable reset.
struct BinWriter {
  mut buf : Bytes
  mut len : Int
  mut cap : Int
  mut has_err : Bool
  mut err : AvroError
}

fn BinWriter::new(init_cap : Int) -> BinWriter {
  let c = if init_cap < 64 { 64 } else { init_cap }
  BinWriter::{
    buf: Bytes::new(c),
    len: 0,
    cap: c,
    has_err: false,
    err: AvroError::SchemaMismatch(""),
  }
}

fn bw_set_err(w : BinWriter, e : AvroError) -> Unit {
  w.has_err = true
  w.err = e
}

fn bw_reset(w : BinWriter) -> Unit {
  w.len = 0
}

fn bw_grow(w : BinWriter, extra : Int) -> Unit {
  let needed = w.len + extra
  let mut next_cap = if w.cap < 64 { 64 } else { w.cap }
  while next_cap < needed {
    if next_cap > 1073741823 {
      next_cap = needed
      break
    }
    next_cap = next_cap * 2
  }
  let next = Bytes::new(next_cap)
  let old = w.buf
  let n = w.len
  let mut i = 0
  while i + 8 <= n {
    next[i] = old[i]
    next[i + 1] = old[i + 1]
    next[i + 2] = old[i + 2]
    next[i + 3] = old[i + 3]
    next[i + 4] = old[i + 4]
    next[i + 5] = old[i + 5]
    next[i + 6] = old[i + 6]
    next[i + 7] = old[i + 7]
    i = i + 8
  }
  while i < n {
    next[i] = old[i]
    i = i + 1
  }
  w.buf = next
  w.cap = next_cap
}

fn bw_ensure(w : BinWriter, extra : Int) -> Unit {
  if w.len + extra > w.cap {
    bw_grow(w, extra)
  }
}

fn bw_write_byte(w : BinWriter, b : Int) -> Unit {
  let p = w.len
  if p + 1 > w.cap {
    bw_grow(w, 1)
  }
  w.buf[p] = b.to_byte()
  w.len = p + 1
}

fn bw_write_bytes_raw(w : BinWriter, src : Bytes) -> Unit {
  let n = src.length()
  if n == 0 {
    return
  }
  let dst_off = w.len
  if dst_off + n > w.cap {
    bw_grow(w, n)
  }
  let dst = w.buf
  let mut i = 0
  while i + 8 <= n {
    dst[dst_off + i] = src[i]
    dst[dst_off + i + 1] = src[i + 1]
    dst[dst_off + i + 2] = src[i + 2]
    dst[dst_off + i + 3] = src[i + 3]
    dst[dst_off + i + 4] = src[i + 4]
    dst[dst_off + i + 5] = src[i + 5]
    dst[dst_off + i + 6] = src[i + 6]
    dst[dst_off + i + 7] = src[i + 7]
    i = i + 8
  }
  while i < n {
    dst[dst_off + i] = src[i]
    i = i + 1
  }
  w.len = dst_off + n
}

fn bw_write_varint_u64(w : BinWriter, v : UInt64) -> Unit {
  let mut pos = w.len
  if pos + 10 > w.cap {
    bw_grow(w, 10)
  }
  let buf = w.buf
  if v < 0x80UL {
    buf[pos] = v.to_int().to_byte()
    w.len = pos + 1
    return
  }
  if v < 0x4000UL {
    buf[pos] = ((v & 0x7FUL) | 0x80UL).to_int().to_byte()
    buf[pos + 1] = (v >> 7).to_int().to_byte()
    w.len = pos + 2
    return
  }
  if v < 0x200000UL {
    let x = v.to_int()
    buf[pos] = ((x & 0x7F) | 0x80).to_byte()
    buf[pos + 1] = (((x >> 7) & 0x7F) | 0x80).to_byte()
    buf[pos + 2] = (x >> 14).to_byte()
    w.len = pos + 3
    return
  }
  let mut u = v
  while u >= 0x80UL {
    buf[pos] = ((u & 0x7FUL) | 0x80UL).to_int().to_byte()
    u = u >> 7
    pos = pos + 1
  }
  buf[pos] = (u & 0x7FUL).to_int().to_byte()
  w.len = pos + 1
}

fn bw_write_i32(w : BinWriter, n : Int) -> Unit {
  if n >= 0 && n < 64 {
    bw_write_byte(w, n << 1)
    return
  }
  bw_write_varint_u64(w, zigzag_encode_i32(n))
}

fn bw_write_i64(w : BinWriter, n : Int64) -> Unit {
  if n >= 0L && n < 64L {
    bw_write_byte(w, n.to_int() << 1)
    return
  }
  bw_write_varint_u64(w, zigzag_encode_i64(n))
}

fn bw_write_f32_bits(w : BinWriter, bits : Int64) -> Unit {
  let p = w.len
  if p + 4 > w.cap {
    bw_grow(w, 4)
  }
  let buf = w.buf
  buf[p] = (bits & 0xFFL).to_int().to_byte()
  buf[p + 1] = ((bits >> 8) & 0xFFL).to_int().to_byte()
  buf[p + 2] = ((bits >> 16) & 0xFFL).to_int().to_byte()
  buf[p + 3] = ((bits >> 24) & 0xFFL).to_int().to_byte()
  w.len = p + 4
}

fn bw_write_f64_bits(w : BinWriter, bits : Int64) -> Unit {
  let p = w.len
  if p + 8 > w.cap {
    bw_grow(w, 8)
  }
  let buf = w.buf
  buf[p] = (bits & 0xFFL).to_int().to_byte()
  buf[p + 1] = ((bits >> 8) & 0xFFL).to_int().to_byte()
  buf[p + 2] = ((bits >> 16) & 0xFFL).to_int().to_byte()
  buf[p + 3] = ((bits >> 24) & 0xFFL).to_int().to_byte()
  buf[p + 4] = ((bits >> 32) & 0xFFL).to_int().to_byte()
  buf[p + 5] = ((bits >> 40) & 0xFFL).to_int().to_byte()
  buf[p + 6] = ((bits >> 48) & 0xFFL).to_int().to_byte()
  buf[p + 7] = ((bits >> 56) & 0xFFL).to_int().to_byte()
  w.len = p + 8
}

fn bw_write_len_bytes(w : BinWriter, b : Bytes) -> Unit {
  bw_write_i64(w, b.length().to_int64())
  bw_write_bytes_raw(w, b)
}

fn bw_write_string(w : BinWriter, s : String) -> Unit {
  let n = s.length()
  let mut pos = w.len
  if pos + n + 10 > w.cap {
    bw_grow(w, n + 10)
  }
  let buf = w.buf
  if n < 64 {
    buf[pos] = (n << 1).to_byte()
    pos = pos + 1
  } else {
    let mut u = (n.to_int64() << 1).to_uint64()
    while u >= 0x80UL {
      buf[pos] = ((u & 0x7FUL) | 0x80UL).to_int().to_byte()
      u = u >> 7
      pos = pos + 1
    }
    buf[pos] = u.to_int().to_byte()
    pos = pos + 1
  }
  let mut i = 0
  while i + 4 <= n {
    buf[pos + i] = s.code_unit_at(i).to_byte()
    buf[pos + i + 1] = s.code_unit_at(i + 1).to_byte()
    buf[pos + i + 2] = s.code_unit_at(i + 2).to_byte()
    buf[pos + i + 3] = s.code_unit_at(i + 3).to_byte()
    i = i + 4
  }
  while i < n {
    buf[pos + i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  w.len = pos + n
}

fn bw_finish(w : BinWriter) -> Bytes {
  let n = w.len
  if n == 0 {
    return empty_bytes
  }
  w.buf.slice(0, n)
}

///| Zero-copy binary reader with unboxed error state and limits tracking.
struct BinReader {
  data : Bytes
  mut pos : Int
  end : Int
  limits : AvroLimits
  mut depth : Int
  mut elements : Int
  mut has_err : Bool
  mut err : AvroError
}

fn BinReader::new(data : Bytes, start : Int, end : Int, limits : AvroLimits) -> BinReader {
  BinReader::{
    data: data,
    pos: start,
    end: end,
    limits: limits,
    depth: 0,
    elements: 0,
    has_err: false,
    err: AvroError::UnexpectedEof(""),
  }
}

fn br_set_err(r : BinReader, e : AvroError) -> Unit {
  r.has_err = true
  r.err = e
}

fn br_read_varint_u64_raw(r : BinReader) -> UInt64 {
  let pos = r.pos
  let end = r.end
  if pos >= end {
    br_set_err(r, AvroError::UnexpectedEof("truncated varint"))
    return 0UL
  }
  let data = r.data
  let b0 = data[pos].to_int()
  if b0 < 0x80 {
    r.pos = pos + 1
    return b0.to_int64().to_uint64()
  }
  if pos + 1 < end {
    let b1 = data[pos + 1].to_int()
    if b1 < 0x80 {
      r.pos = pos + 2
      return ((b0 & 0x7F) | (b1 << 7)).to_int64().to_uint64()
    }
    if pos + 2 < end {
      let b2 = data[pos + 2].to_int()
      if b2 < 0x80 {
        r.pos = pos + 3
        return ((b0 & 0x7F) | ((b1 & 0x7F) << 7) | (b2 << 14)).to_int64().to_uint64()
      }
    }
  }
  let mut result : UInt64 = (b0 & 0x7F).to_int64().to_uint64()
  let mut p = pos + 1
  let mut shift = 7
  let mut count = 1
  while p < end {
    let b = data[p].to_int()
    p = p + 1
    if count == 9 {
      if b > 1 {
        r.pos = p
        br_set_err(r, AvroError::InvalidBinary("64-bit varint overflow"))
        return 0UL
      }
      result = result | (b.to_int64().to_uint64() << 63)
      r.pos = p
      return result
    }
    result = result | ((b & 0x7F).to_int64().to_uint64() << shift)
    if (b & 0x80) == 0 {
      r.pos = p
      return result
    }
    shift = shift + 7
    count = count + 1
  }
  r.pos = p
  br_set_err(r, AvroError::UnexpectedEof("truncated varint"))
  0UL
}

fn br_read_i32_raw(r : BinReader) -> Int {
  let pos = r.pos
  if pos < r.end {
    let b0 = r.data[pos].to_int()
    if b0 < 0x80 {
      r.pos = pos + 1
      return (b0 >> 1) ^ -(b0 & 1)
    }
  }
  let u = br_read_varint_u64_raw(r)
  if r.has_err {
    return 0
  }
  if u > 0xFFFFFFFFUL {
    br_set_err(r, AvroError::InvalidBinary("32-bit int varint overflow"))
    return 0
  }
  zigzag_decode_i32(u)
}

fn br_read_i64_raw(r : BinReader) -> Int64 {
  let pos = r.pos
  if pos < r.end {
    let b0 = r.data[pos].to_int()
    if b0 < 0x80 {
      r.pos = pos + 1
      return ((b0 >> 1) ^ -(b0 & 1)).to_int64()
    }
  }
  let u = br_read_varint_u64_raw(r)
  if r.has_err {
    return 0L
  }
  zigzag_decode_i64(u)
}

fn br_read_bool_raw(r : BinReader) -> Bool {
  if r.pos >= r.end {
    br_set_err(r, AvroError::UnexpectedEof("truncated boolean"))
    return false
  }
  let b = r.data[r.pos].to_int()
  r.pos = r.pos + 1
  if b == 0 {
    false
  } else if b == 1 {
    true
  } else {
    br_set_err(r, AvroError::InvalidBinary("invalid boolean byte: " + b.to_string()))
    false
  }
}

fn br_read_f32_bits_raw(r : BinReader) -> Int64 {
  let p = r.pos
  if p + 4 > r.end {
    br_set_err(r, AvroError::UnexpectedEof("truncated float"))
    return 0L
  }
  let data = r.data
  let b0 = data[p].to_int().to_int64()
  let b1 = data[p + 1].to_int().to_int64()
  let b2 = data[p + 2].to_int().to_int64()
  let b3 = data[p + 3].to_int().to_int64()
  r.pos = p + 4
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn br_read_f64_bits_raw(r : BinReader) -> Int64 {
  let p = r.pos
  if p + 8 > r.end {
    br_set_err(r, AvroError::UnexpectedEof("truncated double"))
    return 0L
  }
  let data = r.data
  let b0 = data[p].to_int().to_int64()
  let b1 = data[p + 1].to_int().to_int64()
  let b2 = data[p + 2].to_int().to_int64()
  let b3 = data[p + 3].to_int().to_int64()
  let b4 = data[p + 4].to_int().to_int64()
  let b5 = data[p + 5].to_int().to_int64()
  let b6 = data[p + 6].to_int().to_int64()
  let b7 = data[p + 7].to_int().to_int64()
  r.pos = p + 8
  b0 |
  (b1 << 8) |
  (b2 << 16) |
  (b3 << 24) |
  (b4 << 32) |
  (b5 << 40) |
  (b6 << 48) |
  (b7 << 56)
}

fn br_read_bytes_raw(r : BinReader) -> Bytes {
  let n64 = br_read_i64_raw(r)
  if r.has_err {
    return empty_bytes
  }
  if n64 < 0L {
    br_set_err(r, AvroError::InvalidBinary("negative bytes length"))
    return empty_bytes
  }
  if n64 > r.limits.max_bytes.to_int64() {
    br_set_err(r, AvroError::LimitExceeded("bytes length exceeds max_bytes"))
    return empty_bytes
  }
  let n = n64.to_int()
  let p = r.pos
  if n > r.end - p {
    br_set_err(r, AvroError::UnexpectedEof("truncated bytes payload"))
    return empty_bytes
  }
  r.pos = p + n
  if n == 0 {
    return empty_bytes
  }
  r.data.slice(p, p + n)
}

fn br_read_string_raw(r : BinReader) -> String {
  let pos = r.pos
  let end_lim = r.end
  let data = r.data
  let mut start = 0
  let mut n = 0
  if pos < end_lim {
    let b0 = data[pos].to_int()
    if b0 < 0x80 && (b0 & 1) == 0 {
      n = b0 >> 1
      if n > r.limits.max_bytes {
        br_set_err(r, AvroError::LimitExceeded("string length exceeds max_bytes"))
        return ""
      }
      start = pos + 1
      if n > end_lim - start {
        br_set_err(r, AvroError::UnexpectedEof("truncated string payload"))
        return ""
      }
    } else {
      let n64 = br_read_i64_raw(r)
      if r.has_err {
        return ""
      }
      if n64 < 0L {
        br_set_err(r, AvroError::InvalidBinary("negative string length"))
        return ""
      }
      if n64 > r.limits.max_bytes.to_int64() {
        br_set_err(r, AvroError::LimitExceeded("string length exceeds max_bytes"))
        return ""
      }
      n = n64.to_int()
      start = r.pos
      if n > end_lim - start {
        br_set_err(r, AvroError::UnexpectedEof("truncated string payload"))
        return ""
      }
    }
  } else {
    br_set_err(r, AvroError::UnexpectedEof("truncated varint"))
    return ""
  }
  if n == 0 {
    r.pos = start
    return ""
  }
  let str_end = start + n
  // Inline 4-byte unrolled ASCII check before falling back to full UTF-8 validator
  let mut i = start
  let mut ascii_ok = true
  while i + 4 <= str_end {
    let c0 = data[i].to_int()
    let c1 = data[i + 1].to_int()
    let c2 = data[i + 2].to_int()
    let c3 = data[i + 3].to_int()
    if (c0 | c1 | c2 | c3) < 0x80 {
      i = i + 4
    } else {
      ascii_ok = false
      break
    }
  }
  if ascii_ok {
    while i < str_end {
      if data[i].to_int() >= 0x80 {
        ascii_ok = false
        break
      }
      i = i + 1
    }
  }
  if !ascii_ok && !is_valid_utf8_range(data, i, str_end - i) {
    br_set_err(r, AvroError::InvalidUtf8("invalid UTF-8 in binary string"))
    return ""
  }
  r.pos = str_end
  data.slice(start, str_end).to_string()
}

fn br_read_fixed_raw(r : BinReader, size : Int) -> Bytes {
  let p = r.pos
  if size < 0 || size > r.end - p {
    br_set_err(r, AvroError::UnexpectedEof("truncated fixed payload"))
    return empty_bytes
  }
  r.pos = p + size
  if size == 0 {
    return empty_bytes
  }
  r.data.slice(p, p + size)
}

fn br_read_block_count_raw(r : BinReader) -> Int64 {
  let pos = r.pos
  if pos < r.end {
    let b0 = r.data[pos].to_int()
    if b0 == 0 {
      r.pos = pos + 1
      return 0L
    }
    if b0 < 0x80 && (b0 & 1) == 0 {
      r.pos = pos + 1
      return (b0 >> 1).to_int64()
    }
  }
  let count = br_read_i64_raw(r)
  if r.has_err {
    return 0L
  }
  if count == 0L {
    return 0L
  }
  if count < 0L {
    if count == (-9223372036854775807L - 1L) {
      br_set_err(r, AvroError::InvalidBinary("block count Int64::min overflow"))
      return 0L
    }
    let byte_size = br_read_i64_raw(r)
    if r.has_err {
      return 0L
    }
    if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
      br_set_err(r, AvroError::InvalidBinary("invalid negative-count block byte_size"))
      return 0L
    }
    return -count
  }
  count
}

fn br_read_i64(r : BinReader) -> Result[Int64, AvroError] {
  let v = br_read_i64_raw(r)
  if r.has_err {
    Err(r.err)
  } else {
    Ok(v)
  }
}

fn br_read_bytes(r : BinReader) -> Result[Bytes, AvroError] {
  let v = br_read_bytes_raw(r)
  if r.has_err {
    Err(r.err)
  } else {
    Ok(v)
  }
}

fn br_read_string(r : BinReader) -> Result[String, AvroError] {
  let v = br_read_string_raw(r)
  if r.has_err {
    Err(r.err)
  } else {
    Ok(v)
  }
}

fn br_read_fixed(r : BinReader, size : Int) -> Result[Bytes, AvroError] {
  let v = br_read_fixed_raw(r, size)
  if r.has_err {
    Err(r.err)
  } else {
    Ok(v)
  }
}

fn br_read_block_count(r : BinReader) -> Result[Int64, AvroError] {
  let v = br_read_block_count_raw(r)
  if r.has_err {
    Err(r.err)
  } else {
    Ok(v)
  }
}

fn resolve_node_fast(schema : Schema, node_id : Int) -> Int {
  match schema.nodes[node_id].kind {
    SchemaKind::Ref(_) => schema.resolve_id(node_id)
    _ => node_id
  }
}

enum EncodeFrame {
  EncNode(Int, AvroValue, Int)
  EncArray(Int, Array[AvroValue], Int, Int)
  EncMap(Int, Array[(String, AvroValue)], Int, Int)
  EncRecord(Array[RecordField], Array[(String, AvroValue)], Int, Int)
  EncZeroByte
}

fn encode_datum_into_iter(
  w : BinWriter,
  schema : Schema,
  node_id : Int,
  value : AvroValue,
  limits : AvroLimits,
  init_depth : Int,
) -> Result[Unit, AvroError] {
  let stack : Array[EncodeFrame] = [EncodeFrame::EncNode(node_id, value, init_depth)]
  while stack.length() > 0 {
    let frame = match stack.pop() {
      Some(f) => f
      None => break
    }
    match frame {
      EncodeFrame::EncZeroByte => bw_write_byte(w, 0)
      EncodeFrame::EncArray(item_id, items, idx, depth) =>
      if idx < items.length() {
        if idx + 1 < items.length() {
          stack.push(EncodeFrame::EncArray(item_id, items, idx + 1, depth))
        }
        stack.push(EncodeFrame::EncNode(item_id, items[idx], depth))
      }
      EncodeFrame::EncMap(val_id, entries, idx, depth) =>
      if idx < entries.length() {
        let (k, v) = entries[idx]
        bw_write_string(w, k)
        if idx + 1 < entries.length() {
          stack.push(EncodeFrame::EncMap(val_id, entries, idx + 1, depth))
        }
        stack.push(EncodeFrame::EncNode(val_id, v, depth))
      }
      EncodeFrame::EncRecord(fields, vals, idx, depth) =>
      if idx < fields.length() {
        let f = fields[idx]
        let (vk, vv) = vals[idx]
        if vk != f.name {
          return Err(AvroError::SchemaMismatch("record field name mismatch: " + vk))
        }
        if idx + 1 < fields.length() {
          stack.push(EncodeFrame::EncRecord(fields, vals, idx + 1, depth))
        }
        stack.push(EncodeFrame::EncNode(f.schema_id, vv, depth))
      }
      EncodeFrame::EncNode(cur_id, cur_val, depth) => {
        if depth > limits.max_depth {
          return Err(AvroError::LimitExceeded("max_depth exceeded in encode_datum"))
        }
        let rid = resolve_node_fast(schema, cur_id)
        match (schema.nodes[rid].kind, cur_val) {
          (SchemaKind::Null, AvroValue::Null) => ()
          (SchemaKind::Boolean, AvroValue::Boolean(b)) => bw_write_byte(w, if b { 1 } else { 0 })
          (SchemaKind::Int, AvroValue::Int(v)) => bw_write_i32(w, v)
          (SchemaKind::Long, AvroValue::Long(v)) => bw_write_i64(w, v)
          (SchemaKind::Float, AvroValue::Float32(v)) => bw_write_f32_bits(w, double_to_float32_bits(v))
          (SchemaKind::Double, AvroValue::Float64(v)) => bw_write_f64_bits(w, v.to_bits())
          (SchemaKind::Bytes, AvroValue::Bytes(b)) => bw_write_len_bytes(w, b)
          (SchemaKind::String, AvroValue::String(s)) => bw_write_string(w, s)
          (SchemaKind::Fixed(_, _, size), AvroValue::Fixed(b)) => {
            if b.length() != size {
              return Err(AvroError::SchemaMismatch("fixed length mismatch"))
            }
            bw_write_bytes_raw(w, b)
          }
          (SchemaKind::Enum(_, _, symbols, _), AvroValue::Enum(idx, sym)) => {
            if idx < 0 || idx >= symbols.length() || symbols[idx] != sym {
              return Err(AvroError::SchemaMismatch("invalid enum value: " + sym))
            }
            bw_write_i32(w, idx)
          }
          (SchemaKind::Array(item_id), AvroValue::Array(items)) => {
            let n = items.length()
            if n > 0 {
              bw_write_i64(w, n.to_int64())
              stack.push(EncodeFrame::EncZeroByte)
              stack.push(EncodeFrame::EncArray(item_id, items, 0, depth + 1))
            } else {
              bw_write_byte(w, 0)
            }
          }
          (SchemaKind::Map(val_id), AvroValue::Map(entries)) => {
            let n = entries.length()
            if n > 0 {
              bw_write_i64(w, n.to_int64())
              stack.push(EncodeFrame::EncZeroByte)
              stack.push(EncodeFrame::EncMap(val_id, entries, 0, depth + 1))
            } else {
              bw_write_byte(w, 0)
            }
          }
          (SchemaKind::Union(branches), AvroValue::Union(idx, inner)) => {
            if idx < 0 || idx >= branches.length() {
              return Err(AvroError::SchemaMismatch("union branch index out of range"))
            }
            bw_write_i64(w, idx.to_int64())
            stack.push(EncodeFrame::EncNode(branches[idx], inner, depth + 1))
          }
          (SchemaKind::Record(_, _, fields), AvroValue::Record(vals)) => {
            if vals.length() != fields.length() {
              return Err(AvroError::SchemaMismatch("record field count mismatch"))
            }
            if fields.length() > 0 {
              stack.push(EncodeFrame::EncRecord(fields, vals, 0, depth + 1))
            }
          }
          _ => return Err(AvroError::SchemaMismatch("value does not match schema in encode_datum"))
        }
      }
    }
  }
  Ok(())
}

///| Unboxed direct-recursion encoder (depth < 64) with inline scalar record fields and iterative fallback.
fn encode_datum_rec(
  w : BinWriter,
  schema : Schema,
  node_id : Int,
  value : AvroValue,
  limits : AvroLimits,
  depth : Int,
) -> Unit {
  if depth > limits.max_depth {
    bw_set_err(w, AvroError::LimitExceeded("max_depth exceeded in encode_datum"))
    return
  }
  if depth >= 64 {
    match encode_datum_into_iter(w, schema, node_id, value, limits, depth) {
      Ok(_) => ()
      Err(e) => bw_set_err(w, e)
    }
    return
  }
  let rid = resolve_node_fast(schema, node_id)
  match (schema.nodes[rid].kind, value) {
    (SchemaKind::Null, AvroValue::Null) => ()
    (SchemaKind::Boolean, AvroValue::Boolean(b)) => bw_write_byte(w, if b { 1 } else { 0 })
    (SchemaKind::Int, AvroValue::Int(v)) => bw_write_i32(w, v)
    (SchemaKind::Long, AvroValue::Long(v)) => bw_write_i64(w, v)
    (SchemaKind::Float, AvroValue::Float32(v)) => bw_write_f32_bits(w, double_to_float32_bits(v))
    (SchemaKind::Double, AvroValue::Float64(v)) => bw_write_f64_bits(w, v.to_bits())
    (SchemaKind::Bytes, AvroValue::Bytes(b)) => bw_write_len_bytes(w, b)
    (SchemaKind::String, AvroValue::String(s)) => bw_write_string(w, s)
    (SchemaKind::Fixed(_, _, size), AvroValue::Fixed(b)) => {
      if b.length() != size {
        bw_set_err(w, AvroError::SchemaMismatch("fixed length mismatch"))
        return
      }
      bw_write_bytes_raw(w, b)
    }
    (SchemaKind::Enum(_, _, symbols, _), AvroValue::Enum(idx, sym)) => {
      if idx < 0 || idx >= symbols.length() || symbols[idx] != sym {
        bw_set_err(w, AvroError::SchemaMismatch("invalid enum value: " + sym))
        return
      }
      bw_write_i32(w, idx)
    }
    (SchemaKind::Array(item_id), AvroValue::Array(items)) => {
      let n = items.length()
      if n == 0 {
        bw_write_byte(w, 0)
        return
      }
      let next_depth = depth + 1
      if next_depth > limits.max_depth {
        bw_set_err(w, AvroError::LimitExceeded("max_depth exceeded in encode_datum"))
        return
      }
      bw_write_i64(w, n.to_int64())
      let item_rid = resolve_node_fast(schema, item_id)
      match schema.nodes[item_rid].kind {
        SchemaKind::String => {
          let mut i = 0
          while i < n {
            match items[i] {
              AvroValue::String(s) => bw_write_string(w, s)
              _ => {
                bw_set_err(w, AvroError::SchemaMismatch("value does not match schema in encode_datum"))
                return
              }
            }
            i = i + 1
          }
        }
        _ => {
          let mut i = 0
          while i < n {
            encode_datum_rec(w, schema, item_rid, items[i], limits, next_depth)
            if w.has_err {
              return
            }
            i = i + 1
          }
        }
      }
      bw_write_byte(w, 0)
    }
    (SchemaKind::Map(val_id), AvroValue::Map(entries)) => {
      let n = entries.length()
      if n == 0 {
        bw_write_byte(w, 0)
        return
      }
      let next_depth = depth + 1
      if next_depth > limits.max_depth {
        bw_set_err(w, AvroError::LimitExceeded("max_depth exceeded in encode_datum"))
        return
      }
      bw_write_i64(w, n.to_int64())
      let val_rid = resolve_node_fast(schema, val_id)
      match schema.nodes[val_rid].kind {
        SchemaKind::Long => {
          let mut i = 0
          while i < n {
            let (k, v) = entries[i]
            bw_write_string(w, k)
            match v {
              AvroValue::Long(lv) => bw_write_i64(w, lv)
              _ => {
                bw_set_err(w, AvroError::SchemaMismatch("value does not match schema in encode_datum"))
                return
              }
            }
            i = i + 1
          }
        }
        _ => {
          let mut i = 0
          while i < n {
            let (k, v) = entries[i]
            bw_write_string(w, k)
            encode_datum_rec(w, schema, val_rid, v, limits, next_depth)
            if w.has_err {
              return
            }
            i = i + 1
          }
        }
      }
      bw_write_byte(w, 0)
    }
    (SchemaKind::Union(branches), AvroValue::Union(idx, inner)) => {
      if idx < 0 || idx >= branches.length() {
        bw_set_err(w, AvroError::SchemaMismatch("union branch index out of range"))
        return
      }
      let next_depth = depth + 1
      if next_depth > limits.max_depth {
        bw_set_err(w, AvroError::LimitExceeded("max_depth exceeded in encode_datum"))
        return
      }
      if idx < 64 {
        bw_write_byte(w, idx << 1)
      } else {
        bw_write_i64(w, idx.to_int64())
      }
      let bid = branches[idx]
      match (schema.nodes[bid].kind, inner) {
        (SchemaKind::Null, AvroValue::Null) => ()
        (SchemaKind::String, AvroValue::String(s)) => bw_write_string(w, s)
        _ => encode_datum_rec(w, schema, bid, inner, limits, next_depth)
      }
    }
    (SchemaKind::Record(_, _, fields), AvroValue::Record(vals)) => {
      let flen = fields.length()
      if vals.length() != flen {
        bw_set_err(w, AvroError::SchemaMismatch("record field count mismatch"))
        return
      }
      if flen == 0 {
        return
      }
      let next_depth = depth + 1
      if next_depth > limits.max_depth {
        bw_set_err(w, AvroError::LimitExceeded("max_depth exceeded in encode_datum"))
        return
      }
      let nodes = schema.nodes
      let mut i = 0
      while i < flen {
        let f = fields[i]
        let (vk, vv) = vals[i]
        if vk != f.name {
          bw_set_err(w, AvroError::SchemaMismatch("record field name mismatch: " + vk))
          return
        }
        let fid = f.schema_id
        match (nodes[fid].kind, vv) {
          (SchemaKind::Null, AvroValue::Null) => ()
          (SchemaKind::Boolean, AvroValue::Boolean(b)) => bw_write_byte(w, if b { 1 } else { 0 })
          (SchemaKind::Int, AvroValue::Int(v)) => bw_write_i32(w, v)
          (SchemaKind::Long, AvroValue::Long(v)) => bw_write_i64(w, v)
          (SchemaKind::Float, AvroValue::Float32(v)) => bw_write_f32_bits(w, double_to_float32_bits(v))
          (SchemaKind::Double, AvroValue::Float64(v)) => bw_write_f64_bits(w, v.to_bits())
          (SchemaKind::Bytes, AvroValue::Bytes(b)) => bw_write_len_bytes(w, b)
          (SchemaKind::String, AvroValue::String(s)) => bw_write_string(w, s)
          _ => {
            encode_datum_rec(w, schema, fid, vv, limits, next_depth)
            if w.has_err {
              return
            }
          }
        }
        i = i + 1
      }
    }
    _ => bw_set_err(w, AvroError::SchemaMismatch("value does not match schema in encode_datum"))
  }
}

fn encode_datum_into(
  w : BinWriter,
  schema : Schema,
  node_id : Int,
  value : AvroValue,
  limits : AvroLimits,
  depth : Int,
) -> Result[Unit, AvroError] {
  encode_datum_rec(w, schema, node_id, value, limits, depth)
  if w.has_err {
    Err(w.err)
  } else {
    Ok(())
  }
}

enum DecodeFrame {
  DecArray(Int, Array[AvroValue], Int)
  DecMap(Int, Array[(String, AvroValue)], Int, String)
  DecUnion(Int)
  DecRecord(Array[RecordField], Array[(String, AvroValue)], Int)
}

fn decode_datum_iter(
  r : BinReader,
  schema : Schema,
  root_node_id : Int,
  base_depth : Int,
) -> AvroValue {
  let stack : Array[DecodeFrame] = []
  let mut cur_id = root_node_id
  let mut has_val = false
  let mut out_val = AvroValue::Null
  while true {
    if !has_val {
      if base_depth + stack.length() > r.limits.max_depth {
        br_set_err(r, AvroError::LimitExceeded("max_depth exceeded in decode_datum"))
        return AvroValue::Null
      }
      let rid = resolve_node_fast(schema, cur_id)
      match schema.nodes[rid].kind {
        SchemaKind::Null => {
          out_val = AvroValue::Null
          has_val = true
        }
        SchemaKind::Boolean => {
          let b = br_read_bool_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          out_val = AvroValue::Boolean(b)
          has_val = true
        }
        SchemaKind::Int => {
          let v = br_read_i32_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          out_val = AvroValue::Int(v)
          has_val = true
        }
        SchemaKind::Long => {
          let v = br_read_i64_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          out_val = AvroValue::Long(v)
          has_val = true
        }
        SchemaKind::Float => {
          let bits = br_read_f32_bits_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          out_val = AvroValue::Float32(float32_bits_to_double(bits))
          has_val = true
        }
        SchemaKind::Double => {
          let bits = br_read_f64_bits_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          out_val = AvroValue::Float64(Double::from_bits(bits))
          has_val = true
        }
        SchemaKind::Bytes => {
          let b = br_read_bytes_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          out_val = AvroValue::Bytes(b)
          has_val = true
        }
        SchemaKind::String => {
          let s = br_read_string_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          out_val = AvroValue::String(s)
          has_val = true
        }
        SchemaKind::Fixed(_, _, size) => {
          let b = br_read_fixed_raw(r, size)
          if r.has_err {
            return AvroValue::Null
          }
          out_val = AvroValue::Fixed(b)
          has_val = true
        }
        SchemaKind::Enum(_, _, symbols, _) => {
          let idx = br_read_i32_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          if idx < 0 || idx >= symbols.length() {
            br_set_err(r, AvroError::InvalidBinary("enum index out of range: " + idx.to_string()))
            return AvroValue::Null
          }
          out_val = AvroValue::Enum(idx, symbols[idx])
          has_val = true
        }
        SchemaKind::Array(item_id) => {
          let count = br_read_block_count_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          if count == 0L {
            out_val = AvroValue::Array([])
            has_val = true
          } else {
            if count > (r.limits.max_elements - r.elements).to_int64() {
              br_set_err(r, AvroError::LimitExceeded("array exceeds max_elements"))
              return AvroValue::Null
            }
            let n = count.to_int()
            r.elements = r.elements + n
            let cap = if n > 4096 { 4096 } else { n }
            stack.push(DecodeFrame::DecArray(item_id, Array::with_capacity(cap), n - 1))
            cur_id = item_id
          }
        }
        SchemaKind::Map(val_id) => {
          let count = br_read_block_count_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          if count == 0L {
            out_val = AvroValue::Map([])
            has_val = true
          } else {
            if count > (r.limits.max_elements - r.elements).to_int64() {
              br_set_err(r, AvroError::LimitExceeded("map exceeds max_elements"))
              return AvroValue::Null
            }
            let n = count.to_int()
            r.elements = r.elements + n
            let k = br_read_string_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            let cap = if n > 4096 { 4096 } else { n }
            stack.push(DecodeFrame::DecMap(val_id, Array::with_capacity(cap), n - 1, k))
            cur_id = val_id
          }
        }
        SchemaKind::Union(branches) => {
          let idx64 = br_read_i64_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          if idx64 < 0L || idx64 >= branches.length().to_int64() {
            br_set_err(r, AvroError::InvalidBinary("union branch index out of range"))
            return AvroValue::Null
          }
          let idx = idx64.to_int()
          stack.push(DecodeFrame::DecUnion(idx))
          cur_id = branches[idx]
        }
        SchemaKind::Record(_, _, fields) =>
        if fields.length() == 0 {
          out_val = AvroValue::Record([])
          has_val = true
        } else {
          stack.push(DecodeFrame::DecRecord(fields, Array::with_capacity(fields.length()), 0))
          cur_id = fields[0].schema_id
        }
        SchemaKind::Ref(_) => {
          br_set_err(r, AvroError::InvalidSchema("unresolved ref"))
          return AvroValue::Null
        }
      }
    } else {
      match stack.pop() {
        None => return out_val
        Some(DecodeFrame::DecUnion(idx)) => out_val = AvroValue::Union(idx, out_val)
        Some(DecodeFrame::DecRecord(fields, vals, idx)) => {
          vals.push((fields[idx].name, out_val))
          let next = idx + 1
          if next < fields.length() {
            stack.push(DecodeFrame::DecRecord(fields, vals, next))
            cur_id = fields[next].schema_id
            has_val = false
          } else {
            out_val = AvroValue::Record(vals)
          }
        }
        Some(DecodeFrame::DecArray(item_id, items, rem)) => {
          items.push(out_val)
          if rem > 0 {
            stack.push(DecodeFrame::DecArray(item_id, items, rem - 1))
            cur_id = item_id
            has_val = false
          } else {
            let count = br_read_block_count_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            if count == 0L {
              out_val = AvroValue::Array(items)
            } else {
              if count > (r.limits.max_elements - r.elements).to_int64() {
                br_set_err(r, AvroError::LimitExceeded("array exceeds max_elements"))
                return AvroValue::Null
              }
              let n = count.to_int()
              r.elements = r.elements + n
              stack.push(DecodeFrame::DecArray(item_id, items, n - 1))
              cur_id = item_id
              has_val = false
            }
          }
        }
        Some(DecodeFrame::DecMap(val_id, entries, rem, key)) => {
          entries.push((key, out_val))
          if rem > 0 {
            let next_k = br_read_string_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            stack.push(DecodeFrame::DecMap(val_id, entries, rem - 1, next_k))
            cur_id = val_id
            has_val = false
          } else {
            let count = br_read_block_count_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            if count == 0L {
              out_val = AvroValue::Map(entries)
            } else {
              if count > (r.limits.max_elements - r.elements).to_int64() {
                br_set_err(r, AvroError::LimitExceeded("map exceeds max_elements"))
                return AvroValue::Null
              }
              let n = count.to_int()
              r.elements = r.elements + n
              let next_k = br_read_string_raw(r)
              if r.has_err {
                return AvroValue::Null
              }
              stack.push(DecodeFrame::DecMap(val_id, entries, n - 1, next_k))
              cur_id = val_id
              has_val = false
            }
          }
        }
      }
    }
  }
  out_val
}

///| Direct-recursion fast path (depth < 64) with zero frame allocation and unboxed reader errors.
fn decode_datum_rec(
  r : BinReader,
  schema : Schema,
  node_id : Int,
  depth : Int,
) -> AvroValue {
  if depth > r.limits.max_depth {
    br_set_err(r, AvroError::LimitExceeded("max_depth exceeded in decode_datum"))
    return AvroValue::Null
  }
  if depth >= 64 {
    return decode_datum_iter(r, schema, node_id, depth)
  }
  let rid = resolve_node_fast(schema, node_id)
  match schema.nodes[rid].kind {
    SchemaKind::Null => AvroValue::Null
    SchemaKind::Boolean => AvroValue::Boolean(br_read_bool_raw(r))
    SchemaKind::Int => AvroValue::Int(br_read_i32_raw(r))
    SchemaKind::Long => AvroValue::Long(br_read_i64_raw(r))
    SchemaKind::Float => {
      let bits = br_read_f32_bits_raw(r)
      if r.has_err {
        return AvroValue::Null
      }
      AvroValue::Float32(float32_bits_to_double(bits))
    }
    SchemaKind::Double => {
      let bits = br_read_f64_bits_raw(r)
      if r.has_err {
        return AvroValue::Null
      }
      AvroValue::Float64(Double::from_bits(bits))
    }
    SchemaKind::Bytes => AvroValue::Bytes(br_read_bytes_raw(r))
    SchemaKind::String => AvroValue::String(br_read_string_raw(r))
    SchemaKind::Fixed(_, _, size) => AvroValue::Fixed(br_read_fixed_raw(r, size))
    SchemaKind::Enum(_, _, symbols, _) => {
      let idx = br_read_i32_raw(r)
      if r.has_err {
        return AvroValue::Null
      }
      if idx < 0 || idx >= symbols.length() {
        br_set_err(r, AvroError::InvalidBinary("enum index out of range: " + idx.to_string()))
        return AvroValue::Null
      }
      AvroValue::Enum(idx, symbols[idx])
    }
    SchemaKind::Array(item_id) => {
      let first_count = br_read_block_count_raw(r)
      if r.has_err {
        return AvroValue::Null
      }
      if first_count == 0L {
        return AvroValue::Array([])
      }
      let next_depth = depth + 1
      if next_depth > r.limits.max_depth {
        br_set_err(r, AvroError::LimitExceeded("max_depth exceeded in decode_datum"))
        return AvroValue::Null
      }
      let item_rid = resolve_node_fast(schema, item_id)
      let is_str = match schema.nodes[item_rid].kind {
        SchemaKind::String => true
        _ => false
      }
      let mut count = first_count
      let init_cap = if first_count > 4096L { 4096 } else { first_count.to_int() }
      let items : Array[AvroValue] = Array::with_capacity(init_cap)
      while count != 0L {
        if count > (r.limits.max_elements - r.elements).to_int64() {
          br_set_err(r, AvroError::LimitExceeded("array exceeds max_elements"))
          return AvroValue::Null
        }
        let n = count.to_int()
        r.elements = r.elements + n
        if is_str {
          let mut i = 0
          while i < n {
            let s = br_read_string_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            items.push(AvroValue::String(s))
            i = i + 1
          }
        } else {
          let mut i = 0
          while i < n {
            let v = decode_datum_rec(r, schema, item_rid, next_depth)
            if r.has_err {
              return AvroValue::Null
            }
            items.push(v)
            i = i + 1
          }
        }
        count = br_read_block_count_raw(r)
        if r.has_err {
          return AvroValue::Null
        }
      }
      AvroValue::Array(items)
    }
    SchemaKind::Map(val_id) => {
      let first_count = br_read_block_count_raw(r)
      if r.has_err {
        return AvroValue::Null
      }
      if first_count == 0L {
        return AvroValue::Map([])
      }
      let next_depth = depth + 1
      if next_depth > r.limits.max_depth {
        br_set_err(r, AvroError::LimitExceeded("max_depth exceeded in decode_datum"))
        return AvroValue::Null
      }
      let val_rid = resolve_node_fast(schema, val_id)
      let is_long = match schema.nodes[val_rid].kind {
        SchemaKind::Long => true
        _ => false
      }
      let mut count = first_count
      let init_cap = if first_count > 4096L { 4096 } else { first_count.to_int() }
      let entries : Array[(String, AvroValue)] = Array::with_capacity(init_cap)
      while count != 0L {
        if count > (r.limits.max_elements - r.elements).to_int64() {
          br_set_err(r, AvroError::LimitExceeded("map exceeds max_elements"))
          return AvroValue::Null
        }
        let n = count.to_int()
        r.elements = r.elements + n
        if is_long {
          let mut i = 0
          while i < n {
            let k = br_read_string_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            let lv = br_read_i64_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            entries.push((k, AvroValue::Long(lv)))
            i = i + 1
          }
        } else {
          let mut i = 0
          while i < n {
            let k = br_read_string_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            let v = decode_datum_rec(r, schema, val_rid, next_depth)
            if r.has_err {
              return AvroValue::Null
            }
            entries.push((k, v))
            i = i + 1
          }
        }
        count = br_read_block_count_raw(r)
        if r.has_err {
          return AvroValue::Null
        }
      }
      AvroValue::Map(entries)
    }
    SchemaKind::Union(branches) => {
      let idx64 = br_read_i64_raw(r)
      if r.has_err {
        return AvroValue::Null
      }
      if idx64 < 0L || idx64 >= branches.length().to_int64() {
        br_set_err(r, AvroError::InvalidBinary("union branch index out of range"))
        return AvroValue::Null
      }
      let idx = idx64.to_int()
      let next_depth = depth + 1
      if next_depth > r.limits.max_depth {
        br_set_err(r, AvroError::LimitExceeded("max_depth exceeded in decode_datum"))
        return AvroValue::Null
      }
      let bid = branches[idx]
      match schema.nodes[bid].kind {
        SchemaKind::Null =>
        if idx == 0 {
          union_null_0
        } else if idx == 1 {
          union_null_1
        } else {
          AvroValue::Union(idx, AvroValue::Null)
        }
        SchemaKind::String => {
          let s = br_read_string_raw(r)
          if r.has_err {
            return AvroValue::Null
          }
          AvroValue::Union(idx, AvroValue::String(s))
        }
        _ => {
          let inner = decode_datum_rec(r, schema, bid, next_depth)
          if r.has_err {
            return AvroValue::Null
          }
          AvroValue::Union(idx, inner)
        }
      }
    }
    SchemaKind::Record(_, _, fields) => {
      let flen = fields.length()
      if flen == 0 {
        return AvroValue::Record([])
      }
      let next_depth = depth + 1
      if next_depth > r.limits.max_depth {
        br_set_err(r, AvroError::LimitExceeded("max_depth exceeded in decode_datum"))
        return AvroValue::Null
      }
      let nodes = schema.nodes
      let vals : Array[(String, AvroValue)] = Array::with_capacity(flen)
      let mut i = 0
      while i < flen {
        let f = fields[i]
        let fid = f.schema_id
        let v = match nodes[fid].kind {
          SchemaKind::Null => AvroValue::Null
          SchemaKind::Boolean => if br_read_bool_raw(r) { val_true } else { val_false }
          SchemaKind::Int => AvroValue::Int(br_read_i32_raw(r))
          SchemaKind::Long => AvroValue::Long(br_read_i64_raw(r))
          SchemaKind::Float => {
            let bits = br_read_f32_bits_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            AvroValue::Float32(float32_bits_to_double(bits))
          }
          SchemaKind::Double => {
            let bits = br_read_f64_bits_raw(r)
            if r.has_err {
              return AvroValue::Null
            }
            AvroValue::Float64(Double::from_bits(bits))
          }
          SchemaKind::Bytes => AvroValue::Bytes(br_read_bytes_raw(r))
          SchemaKind::String => AvroValue::String(br_read_string_raw(r))
          _ => decode_datum_rec(r, schema, fid, next_depth)
        }
        if r.has_err {
          return AvroValue::Null
        }
        vals.push((f.name, v))
        i = i + 1
      }
      AvroValue::Record(vals)
    }
    SchemaKind::Ref(_) => {
      br_set_err(r, AvroError::InvalidSchema("unresolved ref"))
      AvroValue::Null
    }
  }
}

fn decode_datum_from(
  r : BinReader,
  schema : Schema,
  root_node_id : Int,
) -> Result[AvroValue, AvroError] {
  let v = decode_datum_rec(r, schema, root_node_id, 0)
  if r.has_err {
    Err(r.err)
  } else {
    Ok(v)
  }
}

enum SkipFrame {
  SkipNode(Int, Int)
  SkipArray(Int, Int, Int)
  SkipMap(Int, Int, Int)
  SkipRecord(Array[RecordField], Int, Int)
}

fn skip_datum_iter(r : BinReader, schema : Schema, root_node_id : Int, base_depth : Int) -> Unit {
  let stack : Array[SkipFrame] = [SkipFrame::SkipNode(root_node_id, base_depth)]
  while stack.length() > 0 {
    let frame = match stack.pop() {
      Some(f) => f
      None => break
    }
    match frame {
      SkipFrame::SkipRecord(fields, idx, depth) =>
      if idx < fields.length() {
        if idx + 1 < fields.length() {
          stack.push(SkipFrame::SkipRecord(fields, idx + 1, depth))
        }
        stack.push(SkipFrame::SkipNode(fields[idx].schema_id, depth))
      }
      SkipFrame::SkipArray(item_id, rem, depth) =>
      if rem > 0 {
        stack.push(SkipFrame::SkipArray(item_id, rem - 1, depth))
        stack.push(SkipFrame::SkipNode(item_id, depth))
      } else {
        let count = br_read_i64_raw(r)
        if r.has_err {
          return
        }
        if count == 0L {
          ()
        } else if count < 0L {
          let byte_size = br_read_i64_raw(r)
          if r.has_err {
            return
          }
          if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
            br_set_err(r, AvroError::InvalidBinary("invalid block byte_size during skip"))
            return
          }
          r.pos = r.pos + byte_size.to_int()
          stack.push(SkipFrame::SkipArray(item_id, 0, depth))
        } else {
          if count > (r.limits.max_elements - r.elements).to_int64() {
            br_set_err(r, AvroError::LimitExceeded("array exceeds max_elements during skip"))
            return
          }
          let n = count.to_int()
          r.elements = r.elements + n
          stack.push(SkipFrame::SkipArray(item_id, n - 1, depth))
          stack.push(SkipFrame::SkipNode(item_id, depth))
        }
      }
      SkipFrame::SkipMap(val_id, rem, depth) =>
      if rem > 0 {
        let klen = br_read_i64_raw(r)
        if r.has_err {
          return
        }
        if klen < 0L || klen > (r.end - r.pos).to_int64() {
          br_set_err(r, AvroError::UnexpectedEof("truncated map key during skip"))
          return
        }
        r.pos = r.pos + klen.to_int()
        stack.push(SkipFrame::SkipMap(val_id, rem - 1, depth))
        stack.push(SkipFrame::SkipNode(val_id, depth))
      } else {
        let count = br_read_i64_raw(r)
        if r.has_err {
          return
        }
        if count == 0L {
          ()
        } else if count < 0L {
          let byte_size = br_read_i64_raw(r)
          if r.has_err {
            return
          }
          if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
            br_set_err(r, AvroError::InvalidBinary("invalid map block byte_size during skip"))
            return
          }
          r.pos = r.pos + byte_size.to_int()
          stack.push(SkipFrame::SkipMap(val_id, 0, depth))
        } else {
          if count > (r.limits.max_elements - r.elements).to_int64() {
            br_set_err(r, AvroError::LimitExceeded("map exceeds max_elements during skip"))
            return
          }
          let n = count.to_int()
          r.elements = r.elements + n
          let klen = br_read_i64_raw(r)
          if r.has_err {
            return
          }
          if klen < 0L || klen > (r.end - r.pos).to_int64() {
            br_set_err(r, AvroError::UnexpectedEof("truncated map key during skip"))
            return
          }
          r.pos = r.pos + klen.to_int()
          stack.push(SkipFrame::SkipMap(val_id, n - 1, depth))
          stack.push(SkipFrame::SkipNode(val_id, depth))
        }
      }
      SkipFrame::SkipNode(node_id, depth) => {
        if depth > r.limits.max_depth {
          br_set_err(r, AvroError::LimitExceeded("max_depth exceeded while skipping datum"))
          return
        }
        let rid = resolve_node_fast(schema, node_id)
        match schema.nodes[rid].kind {
          SchemaKind::Null => ()
          SchemaKind::Boolean => {
            let _ = br_read_bool_raw(r)
            if r.has_err {
              return
            }
          }
          SchemaKind::Int => {
            let _ = br_read_i32_raw(r)
            if r.has_err {
              return
            }
          }
          SchemaKind::Long => {
            let _ = br_read_varint_u64_raw(r)
            if r.has_err {
              return
            }
          }
          SchemaKind::Float => {
            if r.pos + 4 > r.end {
              br_set_err(r, AvroError::UnexpectedEof("truncated float"))
              return
            }
            r.pos = r.pos + 4
          }
          SchemaKind::Double => {
            if r.pos + 8 > r.end {
              br_set_err(r, AvroError::UnexpectedEof("truncated double"))
              return
            }
            r.pos = r.pos + 8
          }
          SchemaKind::Bytes | SchemaKind::String => {
            let n64 = br_read_i64_raw(r)
            if r.has_err {
              return
            }
            if n64 < 0L || n64 > (r.end - r.pos).to_int64() {
              br_set_err(r, AvroError::UnexpectedEof("truncated bytes/string during skip"))
              return
            }
            r.pos = r.pos + n64.to_int()
          }
          SchemaKind::Fixed(_, _, size) => {
            if size < 0 || size > r.end - r.pos {
              br_set_err(r, AvroError::UnexpectedEof("truncated fixed during skip"))
              return
            }
            r.pos = r.pos + size
          }
          SchemaKind::Enum(_, _, symbols, _) => {
            let idx = br_read_i32_raw(r)
            if r.has_err {
              return
            }
            if idx < 0 || idx >= symbols.length() {
              br_set_err(r, AvroError::InvalidBinary("enum index out of range during skip"))
              return
            }
          }
          SchemaKind::Array(item_id) => stack.push(SkipFrame::SkipArray(item_id, 0, depth + 1))
          SchemaKind::Map(val_id) => stack.push(SkipFrame::SkipMap(val_id, 0, depth + 1))
          SchemaKind::Union(branches) => {
            let idx64 = br_read_i64_raw(r)
            if r.has_err {
              return
            }
            if idx64 < 0L || idx64 >= branches.length().to_int64() {
              br_set_err(r, AvroError::InvalidBinary("union branch index out of range during skip"))
              return
            }
            stack.push(SkipFrame::SkipNode(branches[idx64.to_int()], depth + 1))
          }
          SchemaKind::Record(_, _, fields) =>
          if fields.length() > 0 {
            stack.push(SkipFrame::SkipRecord(fields, 0, depth + 1))
          }
          SchemaKind::Ref(_) => {
            br_set_err(r, AvroError::InvalidSchema("unresolved ref"))
            return
          }
        }
      }
    }
  }
}

///| Zero-allocation direct-recursion binary datum skipper (falls back to iterative at depth >= 64).
fn skip_datum_rec(r : BinReader, schema : Schema, node_id : Int, depth : Int) -> Unit {
  if depth > r.limits.max_depth {
    br_set_err(r, AvroError::LimitExceeded("max_depth exceeded while skipping datum"))
    return
  }
  if depth >= 64 {
    skip_datum_iter(r, schema, node_id, depth)
    return
  }
  let rid = resolve_node_fast(schema, node_id)
  match schema.nodes[rid].kind {
    SchemaKind::Null => ()
    SchemaKind::Boolean => {
      let _ = br_read_bool_raw(r)
    }
    SchemaKind::Int => {
      let _ = br_read_i32_raw(r)
    }
    SchemaKind::Long => {
      let _ = br_read_varint_u64_raw(r)
    }
    SchemaKind::Float =>
    if r.pos + 4 > r.end {
      br_set_err(r, AvroError::UnexpectedEof("truncated float"))
    } else {
      r.pos = r.pos + 4
    }
    SchemaKind::Double =>
    if r.pos + 8 > r.end {
      br_set_err(r, AvroError::UnexpectedEof("truncated double"))
    } else {
      r.pos = r.pos + 8
    }
    SchemaKind::Bytes | SchemaKind::String => {
      let n64 = br_read_i64_raw(r)
      if r.has_err {
        return
      }
      if n64 < 0L || n64 > (r.end - r.pos).to_int64() {
        br_set_err(r, AvroError::UnexpectedEof("truncated bytes/string during skip"))
        return
      }
      r.pos = r.pos + n64.to_int()
    }
    SchemaKind::Fixed(_, _, size) =>
    if size < 0 || size > r.end - r.pos {
      br_set_err(r, AvroError::UnexpectedEof("truncated fixed during skip"))
    } else {
      r.pos = r.pos + size
    }
    SchemaKind::Enum(_, _, symbols, _) => {
      let idx = br_read_i32_raw(r)
      if r.has_err {
        return
      }
      if idx < 0 || idx >= symbols.length() {
        br_set_err(r, AvroError::InvalidBinary("enum index out of range during skip"))
      }
    }
    SchemaKind::Array(item_id) => {
      let next_depth = depth + 1
      while true {
        let count = br_read_i64_raw(r)
        if r.has_err {
          return
        }
        if count == 0L {
          return
        }
        if count < 0L {
          let byte_size = br_read_i64_raw(r)
          if r.has_err {
            return
          }
          if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
            br_set_err(r, AvroError::InvalidBinary("invalid block byte_size during skip"))
            return
          }
          r.pos = r.pos + byte_size.to_int()
        } else {
          if count > (r.limits.max_elements - r.elements).to_int64() {
            br_set_err(r, AvroError::LimitExceeded("array exceeds max_elements during skip"))
            return
          }
          let n = count.to_int()
          r.elements = r.elements + n
          let mut i = 0
          while i < n {
            skip_datum_rec(r, schema, item_id, next_depth)
            if r.has_err {
              return
            }
            i = i + 1
          }
        }
      }
    }
    SchemaKind::Map(val_id) => {
      let next_depth = depth + 1
      while true {
        let count = br_read_i64_raw(r)
        if r.has_err {
          return
        }
        if count == 0L {
          return
        }
        if count < 0L {
          let byte_size = br_read_i64_raw(r)
          if r.has_err {
            return
          }
          if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
            br_set_err(r, AvroError::InvalidBinary("invalid map block byte_size during skip"))
            return
          }
          r.pos = r.pos + byte_size.to_int()
        } else {
          if count > (r.limits.max_elements - r.elements).to_int64() {
            br_set_err(r, AvroError::LimitExceeded("map exceeds max_elements during skip"))
            return
          }
          let n = count.to_int()
          r.elements = r.elements + n
          let mut i = 0
          while i < n {
            let klen = br_read_i64_raw(r)
            if r.has_err {
              return
            }
            if klen < 0L || klen > (r.end - r.pos).to_int64() {
              br_set_err(r, AvroError::UnexpectedEof("truncated map key during skip"))
              return
            }
            r.pos = r.pos + klen.to_int()
            skip_datum_rec(r, schema, val_id, next_depth)
            if r.has_err {
              return
            }
            i = i + 1
          }
        }
      }
    }
    SchemaKind::Union(branches) => {
      let idx64 = br_read_i64_raw(r)
      if r.has_err {
        return
      }
      if idx64 < 0L || idx64 >= branches.length().to_int64() {
        br_set_err(r, AvroError::InvalidBinary("union branch index out of range during skip"))
        return
      }
      skip_datum_rec(r, schema, branches[idx64.to_int()], depth + 1)
    }
    SchemaKind::Record(_, _, fields) => {
      let flen = fields.length()
      let next_depth = depth + 1
      let mut i = 0
      while i < flen {
        skip_datum_rec(r, schema, fields[i].schema_id, next_depth)
        if r.has_err {
          return
        }
        i = i + 1
      }
    }
    SchemaKind::Ref(_) => br_set_err(r, AvroError::InvalidSchema("unresolved ref"))
  }
}

///| Encode an `AvroValue` to Avro binary format using default limits.
pub fn encode_datum(schema : Schema, value : AvroValue) -> Result[Bytes, AvroError] {
  encode_datum_with_limits(schema, value, AvroLimits::default())
}

///| Encode an `AvroValue` to Avro binary format with custom limits.
pub fn encode_datum_with_limits(
  schema : Schema,
  value : AvroValue,
  limits : AvroLimits,
) -> Result[Bytes, AvroError] {
  let w = BinWriter::new(256)
  match encode_datum_into(w, schema, schema.root, value, limits, 0) {
    Ok(_) => Ok(bw_finish(w))
    Err(e) => Err(e)
  }
}

///| Decode a single Avro binary datum using default limits (rejects trailing bytes).
pub fn decode_datum(schema : Schema, data : Bytes) -> Result[AvroValue, AvroError] {
  decode_datum_with_limits(schema, data, AvroLimits::default())
}

///| Decode a single Avro binary datum with custom limits (rejects trailing bytes).
pub fn decode_datum_with_limits(
  schema : Schema,
  data : Bytes,
  limits : AvroLimits,
) -> Result[AvroValue, AvroError] {
  let r = BinReader::new(data, 0, data.length(), limits)
  let decoded = decode_datum_rec(r, schema, schema.root, 0)
  if r.has_err {
    return Err(r.err)
  }
  if r.pos != r.end {
    return Err(AvroError::TrailingBytes(r.end - r.pos))
  }
  Ok(decoded)
}

///| Decode a datum starting at `offset` in `data`, returning `(value, next_offset)`.
pub fn decode_datum_at(
  schema : Schema,
  data : Bytes,
  offset : Int,
  limits : AvroLimits,
) -> Result[(AvroValue, Int), AvroError] {
  if offset < 0 || offset > data.length() {
    return Err(AvroError::UnexpectedEof("offset out of range"))
  }
  let r = BinReader::new(data, offset, data.length(), limits)
  let decoded = decode_datum_rec(r, schema, schema.root, 0)
  if r.has_err {
    return Err(r.err)
  }
  Ok((decoded, r.pos))
}

///| Encode a batch of datums back-to-back into a single binary buffer using one writer.
pub fn encode_datums(
  schema : Schema,
  values : Array[AvroValue],
  limits : AvroLimits,
) -> Result[Bytes, AvroError] {
  let n = values.length()
  let est = if n <= 0 {
    64
  } else if n > 65536 {
    2097152
  } else {
    let e = n * 32
    if e < 256 { 256 } else { e }
  }
  let w = BinWriter::new(est)
  let root = resolve_node_fast(schema, schema.root)
  let mut i = 0
  while i < n {
    encode_datum_rec(w, schema, root, values[i], limits, 0)
    if w.has_err {
      return Err(w.err)
    }
    i = i + 1
  }
  Ok(bw_finish(w))
}

///| Decode `count` back-to-back datums from `data` (rejects trailing bytes).
pub fn decode_datums(
  schema : Schema,
  data : Bytes,
  count : Int,
  limits : AvroLimits,
) -> Result[Array[AvroValue], AvroError] {
  let r = BinReader::new(data, 0, data.length(), limits)
  let init_cap = if count <= 0 {
    0
  } else if count > 65536 {
    65536
  } else {
    count
  }
  let out : Array[AvroValue] = Array::with_capacity(init_cap)
  let root = resolve_node_fast(schema, schema.root)
  let mut i = 0
  while i < count {
    r.elements = 0
    let v = decode_datum_rec(r, schema, root, 0)
    if r.has_err {
      return Err(r.err)
    }
    out.push(v)
    i = i + 1
  }
  if r.pos != r.end {
    return Err(AvroError::TrailingBytes(r.end - r.pos))
  }
  Ok(out)
}
