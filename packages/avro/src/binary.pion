///| Apache Avro 1.11.1 binary datum encoder, decoder, and datum skipper.

///| Chunked, amortized-growth binary writer with fast ZigZag varint and IEEE-754 helpers.
struct BinWriter {
  mut buf : Bytes
  mut len : Int
  chunks : Array[Bytes]
}

fn BinWriter::new(init_cap : Int) -> BinWriter {
  let c = if init_cap < 128 { 128 } else if init_cap > 65536 { 65536 } else { init_cap }
  BinWriter::{ buf: Bytes::new(c), len: 0, chunks: [] }
}

fn bw_ensure(w : BinWriter, extra : Int) -> Unit {
  let needed = w.len + extra
  if needed <= w.buf.length() {
    return
  }
  if w.len >= 4096 {
    w.chunks.push(w.buf.slice(0, w.len))
    w.len = 0
    if extra <= w.buf.length() {
      return
    }
    let mut cap = w.buf.length() * 2
    while cap < extra {
      cap = cap * 2
    }
    w.buf = Bytes::new(cap)
    return
  }
  let mut cap = w.buf.length() * 2
  while cap < needed {
    cap = cap * 2
  }
  let next = Bytes::new(cap)
  let mut i = 0
  while i < w.len {
    next[i] = w.buf[i]
    i = i + 1
  }
  w.buf = next
}

fn bw_write_byte(w : BinWriter, b : Int) -> Unit {
  bw_ensure(w, 1)
  w.buf[w.len] = b.to_byte()
  w.len = w.len + 1
}

fn bw_write_bytes_raw(w : BinWriter, src : Bytes) -> Unit {
  let n = src.length()
  if n == 0 {
    return
  }
  if n >= 4096 {
    if w.len > 0 {
      w.chunks.push(w.buf.slice(0, w.len))
      w.len = 0
    }
    w.chunks.push(src)
    return
  }
  bw_ensure(w, n)
  let mut i = 0
  let dst_off = w.len
  while i < n {
    w.buf[dst_off + i] = src[i]
    i = i + 1
  }
  w.len = dst_off + n
}

fn bw_write_varint_u64(w : BinWriter, v : UInt64) -> Unit {
  bw_ensure(w, 10)
  let mut u = v
  let mut pos = w.len
  while u >= 0x80UL {
    w.buf[pos] = ((u & 0x7FUL) | 0x80UL).to_int().to_byte()
    u = u >> 7
    pos = pos + 1
  }
  w.buf[pos] = (u & 0x7FUL).to_int().to_byte()
  w.len = pos + 1
}

fn bw_write_i32(w : BinWriter, n : Int) -> Unit {
  bw_write_varint_u64(w, zigzag_encode_i32(n))
}

fn bw_write_i64(w : BinWriter, n : Int64) -> Unit {
  bw_write_varint_u64(w, zigzag_encode_i64(n))
}

fn bw_write_f32_bits(w : BinWriter, bits : Int64) -> Unit {
  bw_ensure(w, 4)
  let p = w.len
  w.buf[p] = (bits & 0xFFL).to_int().to_byte()
  w.buf[p + 1] = ((bits >> 8) & 0xFFL).to_int().to_byte()
  w.buf[p + 2] = ((bits >> 16) & 0xFFL).to_int().to_byte()
  w.buf[p + 3] = ((bits >> 24) & 0xFFL).to_int().to_byte()
  w.len = p + 4
}

fn bw_write_f64_bits(w : BinWriter, bits : Int64) -> Unit {
  bw_ensure(w, 8)
  let p = w.len
  w.buf[p] = (bits & 0xFFL).to_int().to_byte()
  w.buf[p + 1] = ((bits >> 8) & 0xFFL).to_int().to_byte()
  w.buf[p + 2] = ((bits >> 16) & 0xFFL).to_int().to_byte()
  w.buf[p + 3] = ((bits >> 24) & 0xFFL).to_int().to_byte()
  w.buf[p + 4] = ((bits >> 32) & 0xFFL).to_int().to_byte()
  w.buf[p + 5] = ((bits >> 40) & 0xFFL).to_int().to_byte()
  w.buf[p + 6] = ((bits >> 48) & 0xFFL).to_int().to_byte()
  w.buf[p + 7] = ((bits >> 56) & 0xFFL).to_int().to_byte()
  w.len = p + 8
}

fn bw_write_len_bytes(w : BinWriter, b : Bytes) -> Unit {
  bw_write_i64(w, b.length().to_int64())
  bw_write_bytes_raw(w, b)
}

fn bw_write_string(w : BinWriter, s : String) -> Unit {
  let b = s.to_bytes()
  bw_write_i64(w, b.length().to_int64())
  bw_write_bytes_raw(w, b)
}

fn bw_finish(w : BinWriter) -> Bytes {
  if w.chunks.length() == 0 {
    return w.buf.slice(0, w.len)
  }
  let mut total = w.len
  let mut i = 0
  while i < w.chunks.length() {
    total = total + w.chunks[i].length()
    i = i + 1
  }
  let out = Bytes::new(total)
  let mut off = 0
  let mut c = 0
  while c < w.chunks.length() {
    let ch = w.chunks[c]
    let clen = ch.length()
    let mut k = 0
    while k < clen {
      out[off + k] = ch[k]
      k = k + 1
    }
    off = off + clen
    c = c + 1
  }
  let mut k = 0
  while k < w.len {
    out[off + k] = w.buf[k]
    k = k + 1
  }
  out
}

///| Zero-copy binary reader with depth, element count, and byte limits tracking.
struct BinReader {
  data : Bytes
  mut pos : Int
  end : Int
  limits : AvroLimits
  mut depth : Int
  mut elements : Int
}

fn BinReader::new(data : Bytes, start : Int, end : Int, limits : AvroLimits) -> BinReader {
  BinReader::{ data: data, pos: start, end: end, limits: limits, depth: 0, elements: 0 }
}

fn br_read_varint_u64(r : BinReader) -> Result[UInt64, AvroError] {
  let mut result : UInt64 = 0UL
  let mut shift = 0
  let mut count = 0
  while r.pos < r.end {
    let b = r.data[r.pos].to_int()
    r.pos = r.pos + 1
    if count == 9 {
      // 10th byte: only bit 0 is valid for 64-bit varint
      if b > 1 {
        return Err(AvroError::InvalidBinary("64-bit varint overflow"))
      }
      result = result | (b.to_int64().to_uint64() << 63)
      return Ok(result)
    }
    result = result | ((b & 0x7F).to_int64().to_uint64() << shift)
    if (b & 0x80) == 0 {
      return Ok(result)
    }
    shift = shift + 7
    count = count + 1
  }
  Err(AvroError::UnexpectedEof("truncated varint"))
}

fn br_read_i32(r : BinReader) -> Result[Int, AvroError] {
  let u = match br_read_varint_u64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if u > 0xFFFFFFFFUL {
    return Err(AvroError::InvalidBinary("32-bit int varint overflow"))
  }
  Ok(zigzag_decode_i32(u))
}

fn br_read_i64(r : BinReader) -> Result[Int64, AvroError] {
  let u = match br_read_varint_u64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok(zigzag_decode_i64(u))
}

fn br_read_bool(r : BinReader) -> Result[Bool, AvroError] {
  if r.pos >= r.end {
    return Err(AvroError::UnexpectedEof("truncated boolean"))
  }
  let b = r.data[r.pos].to_int()
  r.pos = r.pos + 1
  if b == 0 {
    Ok(false)
  } else if b == 1 {
    Ok(true)
  } else {
    Err(AvroError::InvalidBinary("invalid boolean byte: " + b.to_string()))
  }
}

fn br_read_f32_bits(r : BinReader) -> Result[Int64, AvroError] {
  if r.pos + 4 > r.end {
    return Err(AvroError::UnexpectedEof("truncated float"))
  }
  let p = r.pos
  let b0 = r.data[p].to_int().to_int64()
  let b1 = r.data[p + 1].to_int().to_int64()
  let b2 = r.data[p + 2].to_int().to_int64()
  let b3 = r.data[p + 3].to_int().to_int64()
  r.pos = p + 4
  Ok(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))
}

fn br_read_f64_bits(r : BinReader) -> Result[Int64, AvroError] {
  if r.pos + 8 > r.end {
    return Err(AvroError::UnexpectedEof("truncated double"))
  }
  let p = r.pos
  let b0 = r.data[p].to_int().to_int64()
  let b1 = r.data[p + 1].to_int().to_int64()
  let b2 = r.data[p + 2].to_int().to_int64()
  let b3 = r.data[p + 3].to_int().to_int64()
  let b4 = r.data[p + 4].to_int().to_int64()
  let b5 = r.data[p + 5].to_int().to_int64()
  let b6 = r.data[p + 6].to_int().to_int64()
  let b7 = r.data[p + 7].to_int().to_int64()
  r.pos = p + 8
  Ok(
    b0 |
    (b1 << 8) |
    (b2 << 16) |
    (b3 << 24) |
    (b4 << 32) |
    (b5 << 40) |
    (b6 << 48) |
    (b7 << 56),
  )
}

fn br_read_bytes(r : BinReader) -> Result[Bytes, AvroError] {
  let n64 = match br_read_i64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if n64 < 0L {
    return Err(AvroError::InvalidBinary("negative bytes length"))
  }
  if n64 > r.limits.max_bytes.to_int64() {
    return Err(AvroError::LimitExceeded("bytes length exceeds max_bytes"))
  }
  let n = n64.to_int()
  if n > r.end - r.pos {
    return Err(AvroError::UnexpectedEof("truncated bytes payload"))
  }
  let sl = r.data.slice(r.pos, r.pos + n)
  r.pos = r.pos + n
  Ok(sl)
}

fn br_read_string(r : BinReader) -> Result[String, AvroError] {
  let n64 = match br_read_i64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if n64 < 0L {
    return Err(AvroError::InvalidBinary("negative string length"))
  }
  if n64 > r.limits.max_bytes.to_int64() {
    return Err(AvroError::LimitExceeded("string length exceeds max_bytes"))
  }
  let n = n64.to_int()
  if n > r.end - r.pos {
    return Err(AvroError::UnexpectedEof("truncated string payload"))
  }
  if !is_valid_utf8_range(r.data, r.pos, n) {
    return Err(AvroError::InvalidUtf8("invalid UTF-8 in binary string"))
  }
  let sl = r.data.slice(r.pos, r.pos + n)
  r.pos = r.pos + n
  Ok(sl.to_string())
}

fn br_read_fixed(r : BinReader, size : Int) -> Result[Bytes, AvroError] {
  if size < 0 || size > r.end - r.pos {
    return Err(AvroError::UnexpectedEof("truncated fixed payload"))
  }
  let sl = r.data.slice(r.pos, r.pos + size)
  r.pos = r.pos + size
  Ok(sl)
}

fn br_read_block_count(r : BinReader) -> Result[Int64, AvroError] {
  let count = match br_read_i64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count == 0L {
    return Ok(0L)
  }
  if count < 0L {
    if count == (-9223372036854775807L - 1L) {
      return Err(AvroError::InvalidBinary("block count Int64::min overflow"))
    }
    let byte_size = match br_read_i64(r) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
      return Err(AvroError::InvalidBinary("invalid negative-count block byte_size"))
    }
    return Ok(-count)
  }
  Ok(count)
}

enum EncodeFrame {
  EncNode(Int, AvroValue, Int)
  EncArray(Int, Array[AvroValue], Int, Int)
  EncMap(Int, Array[(String, AvroValue)], Int, Int)
  EncRecord(Array[RecordField], Array[(String, AvroValue)], Int, Int)
  EncZeroByte
}

fn encode_datum_into(
  w : BinWriter,
  schema : Schema,
  node_id : Int,
  value : AvroValue,
  limits : AvroLimits,
  init_depth : Int,
) -> Result[Unit, AvroError] {
  let stack : Array[EncodeFrame] = [EncodeFrame::EncNode(node_id, value, init_depth)]
  while stack.length() > 0 {
    let frame = match stack.pop() {
      Some(f) => f
      None => break
    }
    match frame {
      EncodeFrame::EncZeroByte => bw_write_byte(w, 0)
      EncodeFrame::EncArray(item_id, items, idx, depth) =>
      if idx < items.length() {
        if idx + 1 < items.length() {
          stack.push(EncodeFrame::EncArray(item_id, items, idx + 1, depth))
        }
        stack.push(EncodeFrame::EncNode(item_id, items[idx], depth))
      }
      EncodeFrame::EncMap(val_id, entries, idx, depth) =>
      if idx < entries.length() {
        let (k, v) = entries[idx]
        bw_write_string(w, k)
        if idx + 1 < entries.length() {
          stack.push(EncodeFrame::EncMap(val_id, entries, idx + 1, depth))
        }
        stack.push(EncodeFrame::EncNode(val_id, v, depth))
      }
      EncodeFrame::EncRecord(fields, vals, idx, depth) =>
      if idx < fields.length() {
        let f = fields[idx]
        let (vk, vv) = vals[idx]
        if vk != f.name {
          return Err(AvroError::SchemaMismatch("record field name mismatch: " + vk))
        }
        if idx + 1 < fields.length() {
          stack.push(EncodeFrame::EncRecord(fields, vals, idx + 1, depth))
        }
        stack.push(EncodeFrame::EncNode(f.schema_id, vv, depth))
      }
      EncodeFrame::EncNode(cur_id, cur_val, depth) => {
        if depth > limits.max_depth {
          return Err(AvroError::LimitExceeded("max_depth exceeded in encode_datum"))
        }
        let rid = schema.resolve_id(cur_id)
        match (schema.nodes[rid].kind, cur_val) {
          (SchemaKind::Null, AvroValue::Null) => ()
          (SchemaKind::Boolean, AvroValue::Boolean(b)) => bw_write_byte(w, if b { 1 } else { 0 })
          (SchemaKind::Int, AvroValue::Int(v)) => bw_write_i32(w, v)
          (SchemaKind::Long, AvroValue::Long(v)) => bw_write_i64(w, v)
          (SchemaKind::Float, AvroValue::Float32(v)) => bw_write_f32_bits(w, double_to_float32_bits(v))
          (SchemaKind::Double, AvroValue::Float64(v)) => bw_write_f64_bits(w, v.to_bits())
          (SchemaKind::Bytes, AvroValue::Bytes(b)) => bw_write_len_bytes(w, b)
          (SchemaKind::String, AvroValue::String(s)) => bw_write_string(w, s)
          (SchemaKind::Fixed(_, _, size), AvroValue::Fixed(b)) => {
            if b.length() != size {
              return Err(AvroError::SchemaMismatch("fixed length mismatch"))
            }
            bw_write_bytes_raw(w, b)
          }
          (SchemaKind::Enum(_, _, symbols, _), AvroValue::Enum(idx, sym)) => {
            if idx < 0 || idx >= symbols.length() || symbols[idx] != sym {
              return Err(AvroError::SchemaMismatch("invalid enum value: " + sym))
            }
            bw_write_i32(w, idx)
          }
          (SchemaKind::Array(item_id), AvroValue::Array(items)) => {
            let n = items.length()
            if n > 0 {
              bw_write_i64(w, n.to_int64())
              stack.push(EncodeFrame::EncZeroByte)
              stack.push(EncodeFrame::EncArray(item_id, items, 0, depth + 1))
            } else {
              bw_write_byte(w, 0)
            }
          }
          (SchemaKind::Map(val_id), AvroValue::Map(entries)) => {
            let n = entries.length()
            if n > 0 {
              bw_write_i64(w, n.to_int64())
              stack.push(EncodeFrame::EncZeroByte)
              stack.push(EncodeFrame::EncMap(val_id, entries, 0, depth + 1))
            } else {
              bw_write_byte(w, 0)
            }
          }
          (SchemaKind::Union(branches), AvroValue::Union(idx, inner)) => {
            if idx < 0 || idx >= branches.length() {
              return Err(AvroError::SchemaMismatch("union branch index out of range"))
            }
            bw_write_i64(w, idx.to_int64())
            stack.push(EncodeFrame::EncNode(branches[idx], inner, depth + 1))
          }
          (SchemaKind::Record(_, _, fields), AvroValue::Record(vals)) => {
            if vals.length() != fields.length() {
              return Err(AvroError::SchemaMismatch("record field count mismatch"))
            }
            if fields.length() > 0 {
              stack.push(EncodeFrame::EncRecord(fields, vals, 0, depth + 1))
            }
          }
          _ => return Err(AvroError::SchemaMismatch("value does not match schema in encode_datum"))
        }
      }
    }
  }
  Ok(())
}

enum DecodeFrame {
  DecArray(Int, Array[AvroValue], Int)
  DecMap(Int, Array[(String, AvroValue)], Int, String)
  DecUnion(Int)
  DecRecord(Array[RecordField], Array[(String, AvroValue)], Int)
}

fn decode_datum_from(
  r : BinReader,
  schema : Schema,
  root_node_id : Int,
) -> Result[AvroValue, AvroError] {
  let stack : Array[DecodeFrame] = []
  let mut cur_id = root_node_id
  let mut has_val = false
  let mut out_val = AvroValue::Null
  while true {
    if !has_val {
      if stack.length() > r.limits.max_depth {
        return Err(AvroError::LimitExceeded("max_depth exceeded in decode_datum"))
      }
      let rid = schema.resolve_id(cur_id)
      match schema.nodes[rid].kind {
        SchemaKind::Null => {
          out_val = AvroValue::Null
          has_val = true
        }
        SchemaKind::Boolean =>
        match br_read_bool(r) {
          Ok(b) => {
            out_val = AvroValue::Boolean(b)
            has_val = true
          }
          Err(e) => return Err(e)
        }
        SchemaKind::Int =>
        match br_read_i32(r) {
          Ok(v) => {
            out_val = AvroValue::Int(v)
            has_val = true
          }
          Err(e) => return Err(e)
        }
        SchemaKind::Long =>
        match br_read_i64(r) {
          Ok(v) => {
            out_val = AvroValue::Long(v)
            has_val = true
          }
          Err(e) => return Err(e)
        }
        SchemaKind::Float =>
        match br_read_f32_bits(r) {
          Ok(bits) => {
            out_val = AvroValue::Float32(float32_bits_to_double(bits))
            has_val = true
          }
          Err(e) => return Err(e)
        }
        SchemaKind::Double =>
        match br_read_f64_bits(r) {
          Ok(bits) => {
            out_val = AvroValue::Float64(Double::from_bits(bits))
            has_val = true
          }
          Err(e) => return Err(e)
        }
        SchemaKind::Bytes =>
        match br_read_bytes(r) {
          Ok(b) => {
            out_val = AvroValue::Bytes(b)
            has_val = true
          }
          Err(e) => return Err(e)
        }
        SchemaKind::String =>
        match br_read_string(r) {
          Ok(s) => {
            out_val = AvroValue::String(s)
            has_val = true
          }
          Err(e) => return Err(e)
        }
        SchemaKind::Fixed(_, _, size) =>
        match br_read_fixed(r, size) {
          Ok(b) => {
            out_val = AvroValue::Fixed(b)
            has_val = true
          }
          Err(e) => return Err(e)
        }
        SchemaKind::Enum(_, _, symbols, _) => {
          let idx = match br_read_i32(r) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if idx < 0 || idx >= symbols.length() {
            return Err(AvroError::InvalidBinary("enum index out of range: " + idx.to_string()))
          }
          out_val = AvroValue::Enum(idx, symbols[idx])
          has_val = true
        }
        SchemaKind::Array(item_id) => {
          let count = match br_read_block_count(r) {
            Ok(c) => c
            Err(e) => return Err(e)
          }
          if count == 0L {
            out_val = AvroValue::Array([])
            has_val = true
          } else {
            if count > (r.limits.max_elements - r.elements).to_int64() {
              return Err(AvroError::LimitExceeded("array exceeds max_elements"))
            }
            let n = count.to_int()
            r.elements = r.elements + n
            stack.push(DecodeFrame::DecArray(item_id, [], n - 1))
            cur_id = item_id
          }
        }
        SchemaKind::Map(val_id) => {
          let count = match br_read_block_count(r) {
            Ok(c) => c
            Err(e) => return Err(e)
          }
          if count == 0L {
            out_val = AvroValue::Map([])
            has_val = true
          } else {
            if count > (r.limits.max_elements - r.elements).to_int64() {
              return Err(AvroError::LimitExceeded("map exceeds max_elements"))
            }
            let n = count.to_int()
            r.elements = r.elements + n
            let k = match br_read_string(r) {
              Ok(s) => s
              Err(e) => return Err(e)
            }
            stack.push(DecodeFrame::DecMap(val_id, [], n - 1, k))
            cur_id = val_id
          }
        }
        SchemaKind::Union(branches) => {
          let idx64 = match br_read_i64(r) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if idx64 < 0L || idx64 >= branches.length().to_int64() {
            return Err(AvroError::InvalidBinary("union branch index out of range"))
          }
          let idx = idx64.to_int()
          stack.push(DecodeFrame::DecUnion(idx))
          cur_id = branches[idx]
        }
        SchemaKind::Record(_, _, fields) =>
        if fields.length() == 0 {
          out_val = AvroValue::Record([])
          has_val = true
        } else {
          stack.push(DecodeFrame::DecRecord(fields, [], 0))
          cur_id = fields[0].schema_id
        }
        SchemaKind::Ref(_) => return Err(AvroError::InvalidSchema("unresolved ref"))
      }
    } else {
      match stack.pop() {
        None => return Ok(out_val)
        Some(DecodeFrame::DecUnion(idx)) => out_val = AvroValue::Union(idx, out_val)
        Some(DecodeFrame::DecRecord(fields, vals, idx)) => {
          vals.push((fields[idx].name, out_val))
          let next = idx + 1
          if next < fields.length() {
            stack.push(DecodeFrame::DecRecord(fields, vals, next))
            cur_id = fields[next].schema_id
            has_val = false
          } else {
            out_val = AvroValue::Record(vals)
          }
        }
        Some(DecodeFrame::DecArray(item_id, items, rem)) => {
          items.push(out_val)
          if rem > 0 {
            stack.push(DecodeFrame::DecArray(item_id, items, rem - 1))
            cur_id = item_id
            has_val = false
          } else {
            let count = match br_read_block_count(r) {
              Ok(c) => c
              Err(e) => return Err(e)
            }
            if count == 0L {
              out_val = AvroValue::Array(items)
            } else {
              if count > (r.limits.max_elements - r.elements).to_int64() {
                return Err(AvroError::LimitExceeded("array exceeds max_elements"))
              }
              let n = count.to_int()
              r.elements = r.elements + n
              stack.push(DecodeFrame::DecArray(item_id, items, n - 1))
              cur_id = item_id
              has_val = false
            }
          }
        }
        Some(DecodeFrame::DecMap(val_id, entries, rem, key)) => {
          entries.push((key, out_val))
          if rem > 0 {
            let next_k = match br_read_string(r) {
              Ok(s) => s
              Err(e) => return Err(e)
            }
            stack.push(DecodeFrame::DecMap(val_id, entries, rem - 1, next_k))
            cur_id = val_id
            has_val = false
          } else {
            let count = match br_read_block_count(r) {
              Ok(c) => c
              Err(e) => return Err(e)
            }
            if count == 0L {
              out_val = AvroValue::Map(entries)
            } else {
              if count > (r.limits.max_elements - r.elements).to_int64() {
                return Err(AvroError::LimitExceeded("map exceeds max_elements"))
              }
              let n = count.to_int()
              r.elements = r.elements + n
              let next_k = match br_read_string(r) {
                Ok(s) => s
                Err(e) => return Err(e)
              }
              stack.push(DecodeFrame::DecMap(val_id, entries, n - 1, next_k))
              cur_id = val_id
              has_val = false
            }
          }
        }
      }
    }
  }
  Ok(out_val)
}

enum SkipFrame {
  SkipNode(Int, Int)
  SkipArray(Int, Int, Int)
  SkipMap(Int, Int, Int)
  SkipRecord(Array[RecordField], Int, Int)
}

///| Fast iterative binary datum skipper used by Schema Evolution when writer has fields absent in reader.
fn skip_datum_from(r : BinReader, schema : Schema, root_node_id : Int) -> Result[Unit, AvroError] {
  let stack : Array[SkipFrame] = [SkipFrame::SkipNode(root_node_id, r.depth)]
  while stack.length() > 0 {
    let frame = match stack.pop() {
      Some(f) => f
      None => break
    }
    match frame {
      SkipFrame::SkipRecord(fields, idx, depth) =>
      if idx < fields.length() {
        if idx + 1 < fields.length() {
          stack.push(SkipFrame::SkipRecord(fields, idx + 1, depth))
        }
        stack.push(SkipFrame::SkipNode(fields[idx].schema_id, depth))
      }
      SkipFrame::SkipArray(item_id, rem, depth) =>
      if rem > 0 {
        stack.push(SkipFrame::SkipArray(item_id, rem - 1, depth))
        stack.push(SkipFrame::SkipNode(item_id, depth))
      } else {
        let count = match br_read_i64(r) {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        if count == 0L {
          ()
        } else if count < 0L {
          let byte_size = match br_read_i64(r) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
            return Err(AvroError::InvalidBinary("invalid block byte_size during skip"))
          }
          r.pos = r.pos + byte_size.to_int()
          stack.push(SkipFrame::SkipArray(item_id, 0, depth))
        } else {
          if count > (r.limits.max_elements - r.elements).to_int64() {
            return Err(AvroError::LimitExceeded("array exceeds max_elements during skip"))
          }
          let n = count.to_int()
          r.elements = r.elements + n
          stack.push(SkipFrame::SkipArray(item_id, n - 1, depth))
          stack.push(SkipFrame::SkipNode(item_id, depth))
        }
      }
      SkipFrame::SkipMap(val_id, rem, depth) =>
      if rem > 0 {
        let klen = match br_read_i64(r) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if klen < 0L || klen > (r.end - r.pos).to_int64() {
          return Err(AvroError::UnexpectedEof("truncated map key during skip"))
        }
        r.pos = r.pos + klen.to_int()
        stack.push(SkipFrame::SkipMap(val_id, rem - 1, depth))
        stack.push(SkipFrame::SkipNode(val_id, depth))
      } else {
        let count = match br_read_i64(r) {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        if count == 0L {
          ()
        } else if count < 0L {
          let byte_size = match br_read_i64(r) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if byte_size < 0L || byte_size > (r.end - r.pos).to_int64() {
            return Err(AvroError::InvalidBinary("invalid map block byte_size during skip"))
          }
          r.pos = r.pos + byte_size.to_int()
          stack.push(SkipFrame::SkipMap(val_id, 0, depth))
        } else {
          if count > (r.limits.max_elements - r.elements).to_int64() {
            return Err(AvroError::LimitExceeded("map exceeds max_elements during skip"))
          }
          let n = count.to_int()
          r.elements = r.elements + n
          let klen = match br_read_i64(r) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if klen < 0L || klen > (r.end - r.pos).to_int64() {
            return Err(AvroError::UnexpectedEof("truncated map key during skip"))
          }
          r.pos = r.pos + klen.to_int()
          stack.push(SkipFrame::SkipMap(val_id, n - 1, depth))
          stack.push(SkipFrame::SkipNode(val_id, depth))
        }
      }
      SkipFrame::SkipNode(node_id, depth) => {
        if depth > r.limits.max_depth {
          return Err(AvroError::LimitExceeded("max_depth exceeded while skipping datum"))
        }
        let rid = schema.resolve_id(node_id)
        match schema.nodes[rid].kind {
          SchemaKind::Null => ()
          SchemaKind::Boolean =>
          match br_read_bool(r) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          SchemaKind::Int =>
          match br_read_i32(r) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          SchemaKind::Long =>
          match br_read_i64(r) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          SchemaKind::Float => {
            if r.pos + 4 > r.end {
              return Err(AvroError::UnexpectedEof("truncated float"))
            }
            r.pos = r.pos + 4
          }
          SchemaKind::Double => {
            if r.pos + 8 > r.end {
              return Err(AvroError::UnexpectedEof("truncated double"))
            }
            r.pos = r.pos + 8
          }
          SchemaKind::Bytes | SchemaKind::String => {
            let n64 = match br_read_i64(r) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            if n64 < 0L || n64 > (r.end - r.pos).to_int64() {
              return Err(AvroError::UnexpectedEof("truncated bytes/string during skip"))
            }
            r.pos = r.pos + n64.to_int()
          }
          SchemaKind::Fixed(_, _, size) => {
            if size < 0 || size > r.end - r.pos {
              return Err(AvroError::UnexpectedEof("truncated fixed during skip"))
            }
            r.pos = r.pos + size
          }
          SchemaKind::Enum(_, _, symbols, _) => {
            let idx = match br_read_i32(r) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            if idx < 0 || idx >= symbols.length() {
              return Err(AvroError::InvalidBinary("enum index out of range during skip"))
            }
          }
          SchemaKind::Array(item_id) => stack.push(SkipFrame::SkipArray(item_id, 0, depth + 1))
          SchemaKind::Map(val_id) => stack.push(SkipFrame::SkipMap(val_id, 0, depth + 1))
          SchemaKind::Union(branches) => {
            let idx64 = match br_read_i64(r) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            if idx64 < 0L || idx64 >= branches.length().to_int64() {
              return Err(AvroError::InvalidBinary("union branch index out of range during skip"))
            }
            stack.push(SkipFrame::SkipNode(branches[idx64.to_int()], depth + 1))
          }
          SchemaKind::Record(_, _, fields) =>
          if fields.length() > 0 {
            stack.push(SkipFrame::SkipRecord(fields, 0, depth + 1))
          }
          SchemaKind::Ref(_) => return Err(AvroError::InvalidSchema("unresolved ref"))
        }
      }
    }
  }
  Ok(())
}

///| Encode an `AvroValue` to Avro binary format using default limits.
pub fn encode_datum(schema : Schema, value : AvroValue) -> Result[Bytes, AvroError] {
  encode_datum_with_limits(schema, value, AvroLimits::default())
}

///| Encode an `AvroValue` to Avro binary format with custom limits.
pub fn encode_datum_with_limits(
  schema : Schema,
  value : AvroValue,
  limits : AvroLimits,
) -> Result[Bytes, AvroError] {
  let w = BinWriter::new(256)
  match encode_datum_into(w, schema, schema.root, value, limits, 0) {
    Ok(_) => Ok(bw_finish(w))
    Err(e) => Err(e)
  }
}

///| Decode a single Avro binary datum using default limits (rejects trailing bytes).
pub fn decode_datum(schema : Schema, data : Bytes) -> Result[AvroValue, AvroError] {
  decode_datum_with_limits(schema, data, AvroLimits::default())
}

///| Decode a single Avro binary datum with custom limits (rejects trailing bytes).
pub fn decode_datum_with_limits(
  schema : Schema,
  data : Bytes,
  limits : AvroLimits,
) -> Result[AvroValue, AvroError] {
  let r = BinReader::new(data, 0, data.length(), limits)
  let decoded = match decode_datum_from(r, schema, schema.root) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if r.pos != r.end {
    return Err(AvroError::TrailingBytes(r.end - r.pos))
  }
  Ok(decoded)
}

///| Decode a datum starting at `offset` in `data`, returning `(value, next_offset)`.
pub fn decode_datum_at(
  schema : Schema,
  data : Bytes,
  offset : Int,
  limits : AvroLimits,
) -> Result[(AvroValue, Int), AvroError] {
  if offset < 0 || offset > data.length() {
    return Err(AvroError::UnexpectedEof("offset out of range"))
  }
  let r = BinReader::new(data, offset, data.length(), limits)
  let decoded = match decode_datum_from(r, schema, schema.root) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok((decoded, r.pos))
}

///| Encode a batch of datums back-to-back into a single binary buffer using one writer.
pub fn encode_datums(
  schema : Schema,
  values : Array[AvroValue],
  limits : AvroLimits,
) -> Result[Bytes, AvroError] {
  let w = BinWriter::new(4096)
  let n = values.length()
  let mut i = 0
  while i < n {
    match encode_datum_into(w, schema, schema.root, values[i], limits, 0) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(bw_finish(w))
}

///| Decode `count` back-to-back datums from `data` (rejects trailing bytes).
pub fn decode_datums(
  schema : Schema,
  data : Bytes,
  count : Int,
  limits : AvroLimits,
) -> Result[Array[AvroValue], AvroError] {
  let r = BinReader::new(data, 0, data.length(), limits)
  let out : Array[AvroValue] = []
  let mut i = 0
  while i < count {
    r.elements = 0
    let v = match decode_datum_from(r, schema, schema.root) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    out.push(v)
    i = i + 1
  }
  if r.pos != r.end {
    return Err(AvroError::TrailingBytes(r.end - r.pos))
  }
  Ok(out)
}
