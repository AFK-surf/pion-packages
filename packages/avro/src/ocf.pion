///| Apache Avro 1.11.1 Object Container File (`.avro` OCF) reader and writer.

import "flate"

///| Compression codec for Avro Object Container Files.
pub enum OcfCodec {
  Null
  Deflate
}

///| Options for writing an Avro Object Container File.
pub struct OcfOptions {
  pub codec : OcfCodec
  pub sync_marker : Bytes
  pub block_size : Int
  pub metadata : Array[(String, Bytes)]
}

///| Default OCF options (`Null` codec, deterministic 16-byte sync marker, 1000 objects/block).
pub fn OcfOptions::default() -> OcfOptions {
  let sync = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    sync[i] = ((i * 17 + 0xA5) & 0xFF).to_byte()
    i = i + 1
  }
  OcfOptions::{
    codec: OcfCodec::Null,
    sync_marker: sync,
    block_size: 1000,
    metadata: [],
  }
}

///|
pub fn OcfOptions::with_codec(self : OcfOptions, codec : OcfCodec) -> OcfOptions {
  OcfOptions::{
    codec: codec,
    sync_marker: self.sync_marker,
    block_size: self.block_size,
    metadata: self.metadata,
  }
}

///|
pub fn OcfOptions::with_sync_marker(self : OcfOptions, sync : Bytes) -> OcfOptions {
  OcfOptions::{
    codec: self.codec,
    sync_marker: sync,
    block_size: self.block_size,
    metadata: self.metadata,
  }
}

///|
pub fn OcfOptions::with_block_size(self : OcfOptions, n : Int) -> OcfOptions {
  OcfOptions::{
    codec: self.codec,
    sync_marker: self.sync_marker,
    block_size: n,
    metadata: self.metadata,
  }
}

///|
pub fn OcfOptions::with_metadata(
  self : OcfOptions,
  meta : Array[(String, Bytes)],
) -> OcfOptions {
  OcfOptions::{
    codec: self.codec,
    sync_marker: self.sync_marker,
    block_size: self.block_size,
    metadata: meta,
  }
}

///| Decoded Apache Avro Object Container File.
pub struct OcfFile {
  pub schema : Schema
  pub codec : OcfCodec
  pub sync_marker : Bytes
  pub metadata : Array[(String, Bytes)]
  pub records : Array[AvroValue]
}

fn codec_name(c : OcfCodec) -> String {
  match c {
    OcfCodec::Null => "null"
    OcfCodec::Deflate => "deflate"
  }
}

fn parse_codec(name : String) -> Result[OcfCodec, AvroError] {
  if name == "null" {
    Ok(OcfCodec::Null)
  } else if name == "deflate" {
    Ok(OcfCodec::Deflate)
  } else {
    Err(AvroError::UnsupportedCodec(name))
  }
}

///| Serialize a sequence of records into an Apache Avro `.avro` Object Container File.
pub fn write_ocf(
  schema : Schema,
  records : Array[AvroValue],
  options : OcfOptions,
) -> Result[Bytes, AvroError] {
  if options.sync_marker.length() != 16 {
    return Err(AvroError::InvalidOcf("sync marker must be exactly 16 bytes"))
  }
  let block_cap = if options.block_size <= 0 { 1000 } else { options.block_size }
  let limits = AvroLimits::default()
  let out = BinWriter::new(4096)

  // 1. Magic: Obj\x01
  bw_write_byte(out, 0x4F)
  bw_write_byte(out, 0x62)
  bw_write_byte(out, 0x6A)
  bw_write_byte(out, 0x01)

  // 2. Metadata map<bytes>: avro.schema (full schema JSON), avro.codec, plus user metadata
  let meta_entries : Array[(String, Bytes)] = []
  meta_entries.push(("avro.schema", schema_to_json(schema).to_bytes()))
  meta_entries.push(("avro.codec", codec_name(options.codec).to_bytes()))
  let mut mi = 0
  while mi < options.metadata.length() {
    let (mk, mv) = options.metadata[mi]
    if mk != "avro.schema" && mk != "avro.codec" {
      meta_entries.push((mk, mv))
    }
    mi = mi + 1
  }
  bw_write_i64(out, meta_entries.length().to_int64())
  let mut k = 0
  while k < meta_entries.length() {
    let (mk, mv) = meta_entries[k]
    bw_write_string(out, mk)
    bw_write_len_bytes(out, mv)
    k = k + 1
  }
  bw_write_byte(out, 0)

  // 3. 16-byte sync marker
  bw_write_bytes_raw(out, options.sync_marker)

  // 4. Data blocks
  let total = records.length()
  let mut idx = 0
  while idx < total {
    let mut end_idx = idx + block_cap
    if end_idx > total {
      end_idx = total
    }
    let count = end_idx - idx
    let blk = BinWriter::new(4096)
    let mut j = idx
    while j < end_idx {
      match encode_datum_into(blk, schema, schema.root, records[j], limits, 0) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      j = j + 1
    }
    let raw_block = bw_finish(blk)
    let payload = match options.codec {
      OcfCodec::Null => raw_block
      OcfCodec::Deflate =>
      match flate::deflate_compress(raw_block, 6) {
        Ok(c) => c
        Err(e) => return Err(AvroError::DecompressionError(flate::flate_error_message(e)))
      }
    }
    bw_write_i64(out, count.to_int64())
    bw_write_i64(out, payload.length().to_int64())
    bw_write_bytes_raw(out, payload)
    bw_write_bytes_raw(out, options.sync_marker)
    idx = end_idx
  }
  Ok(bw_finish(out))
}

fn read_ocf_header(
  r : BinReader,
  limits : AvroLimits,
) -> Result[(Schema, OcfCodec, Bytes, Array[(String, Bytes)]), AvroError] {
  if r.end - r.pos < 20 {
    return Err(AvroError::InvalidOcf("OCF file too short"))
  }
  if r.data[r.pos].to_int() != 0x4F ||
  r.data[r.pos + 1].to_int() != 0x62 ||
  r.data[r.pos + 2].to_int() != 0x6A ||
  r.data[r.pos + 3].to_int() != 0x01 {
    return Err(AvroError::InvalidOcf("invalid OCF magic bytes (expected Obj\\x01)"))
  }
  r.pos = r.pos + 4

  // Read metadata map<bytes>
  let meta : Array[(String, Bytes)] = []
  let mut schema_bytes : Option[Bytes] = None
  let mut codec_str = "null"
  while true {
    let count = match br_read_block_count(r) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    if count == 0L {
      break
    }
    if count > 4096L {
      return Err(AvroError::LimitExceeded("OCF metadata map too large"))
    }
    let n = count.to_int()
    let mut i = 0
    while i < n {
      let mk = match br_read_string(r) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      let mv = match br_read_bytes(r) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      if mk == "avro.schema" {
        schema_bytes = Some(mv)
      } else if mk == "avro.codec" {
        if !is_valid_utf8_range(mv, 0, mv.length()) {
          return Err(AvroError::InvalidUtf8("invalid UTF-8 in avro.codec"))
        }
        codec_str = mv.to_string()
      }
      meta.push((mk, mv))
      i = i + 1
    }
  }

  let sync = match br_read_fixed(r, 16) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let codec = match parse_codec(codec_str) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let schema_raw = match schema_bytes {
    Some(b) => b
    None => return Err(AvroError::InvalidOcf("OCF header missing required 'avro.schema' metadata"))
  }
  if !is_valid_utf8_range(schema_raw, 0, schema_raw.length()) {
    return Err(AvroError::InvalidUtf8("invalid UTF-8 in avro.schema"))
  }
  let schema = match parse_schema_with_limits(schema_raw.to_string(), limits) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok((schema, codec, sync, meta))
}

///| Streaming block-by-block Apache Avro `.avro` Object Container File reader.
pub struct OcfReader {
  data : Bytes
  mut pos : Int
  end : Int
  pub schema : Schema
  writer_schema : Schema
  pub codec : OcfCodec
  pub sync_marker : Bytes
  pub metadata : Array[(String, Bytes)]
  limits : AvroLimits
  resolver_opt : Option[SchemaResolver]
  mut total_elements : Int
  mut total_records : Int
}

fn ocf_open_impl(
  data : Bytes,
  reader_schema_opt : Option[Schema],
  limits : AvroLimits,
) -> Result[OcfReader, AvroError] {
  let r = BinReader::new(data, 0, data.length(), limits)
  let (writer_schema, codec, sync, meta) = match read_ocf_header(r, limits) {
    Ok(h) => h
    Err(e) => return Err(e)
  }
  let resolver_opt : Option[SchemaResolver] = match reader_schema_opt {
    None => None
    Some(rs) =>
    match compile_resolver(writer_schema, rs) {
      Ok(res) => Some(res)
      Err(e) => return Err(e)
    }
  }
  let out_schema = match reader_schema_opt {
    Some(rs) => rs
    None => writer_schema
  }
  Ok(
    OcfReader::{
      data: data,
      pos: r.pos,
      end: r.end,
      schema: out_schema,
      writer_schema: writer_schema,
      codec: codec,
      sync_marker: sync,
      metadata: meta,
      limits: limits,
      resolver_opt: resolver_opt,
      total_elements: 0,
      total_records: 0,
    },
  )
}

///| Open an `.avro` OCF file for streaming block-by-block decoding.
pub fn OcfReader::open(data : Bytes, limits : AvroLimits) -> Result[OcfReader, AvroError] {
  ocf_open_impl(data, None, limits)
}

///| Open an `.avro` OCF file for streaming block-by-block decoding with schema evolution.
pub fn OcfReader::open_resolved(
  data : Bytes,
  reader_schema : Schema,
  limits : AvroLimits,
) -> Result[OcfReader, AvroError] {
  ocf_open_impl(data, Some(reader_schema), limits)
}

///| Decode and return the next data block of records, or `Ok(None)` at EOF.
///| When `accumulate_elements` is true, `limits.max_elements` is enforced across the entire file.
fn ocf_next_block_impl(
  self : OcfReader,
  accumulate_elements : Bool,
) -> Result[Option[Array[AvroValue]], AvroError] {
  if self.pos >= self.end {
    return Ok(None)
  }
  let r = BinReader::new(self.data, self.pos, self.end, self.limits)
  let count64 = match br_read_i64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count64 <= 0L {
    return Err(AvroError::InvalidOcf("OCF block object count must be positive"))
  }
  let max_ocf_records = if self.limits.max_elements > 10000000 {
    self.limits.max_elements
  } else {
    10000000
  }
  if count64 > (max_ocf_records - self.total_records).to_int64() {
    return Err(AvroError::LimitExceeded("OCF total records exceed limit"))
  }
  let count = count64.to_int()
  let byte_size64 = match br_read_i64(r) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if byte_size64 < 0L || byte_size64 > self.limits.max_bytes.to_int64() {
    return Err(AvroError::LimitExceeded("OCF block byte size invalid or exceeds max_bytes"))
  }
  let byte_size = byte_size64.to_int()
  if byte_size + 16 > r.end - r.pos {
    return Err(AvroError::UnexpectedEof("truncated OCF data block"))
  }
  let raw_start = r.pos
  let raw_end = r.pos + byte_size
  r.pos = raw_end

  // Verify 16-byte sync marker
  let mut si = 0
  while si < 16 {
    if r.data[r.pos + si] != self.sync_marker[si] {
      return Err(AvroError::InvalidOcf("OCF block sync marker mismatch"))
    }
    si = si + 1
  }
  r.pos = r.pos + 16
  self.pos = r.pos

  let blk_reader = match self.codec {
    OcfCodec::Null => BinReader::new(self.data, raw_start, raw_end, self.limits)
    OcfCodec::Deflate => {
      let comp = self.data.slice(raw_start, raw_end)
      let decomp = match flate::deflate_decompress_with_limit(comp, self.limits.max_bytes) {
        Ok(d) => d
        Err(e) => return Err(AvroError::DecompressionError(flate::flate_error_message(e)))
      }
      BinReader::new(decomp, 0, decomp.length(), self.limits)
    }
  }
  if accumulate_elements {
    blk_reader.elements = self.total_elements
  }

  let block_records : Array[AvroValue] = []
  let mut i = 0
  while i < count {
    let rec = match self.resolver_opt {
      None =>
      match decode_datum_from(blk_reader, self.writer_schema, self.writer_schema.root) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      Some(res) =>
      match exec_resolve(blk_reader, res, res.root_plan) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    }
    block_records.push(rec)
    i = i + 1
  }
  if blk_reader.pos != blk_reader.end {
    return Err(AvroError::TrailingBytes(blk_reader.end - blk_reader.pos))
  }
  if accumulate_elements {
    self.total_elements = blk_reader.elements
  }
  self.total_records = self.total_records + count
  Ok(Some(block_records))
}

///| Read and decode the next block of records from this streaming `OcfReader`, or `Ok(None)` at EOF.
pub fn OcfReader::next_block(self : OcfReader) -> Result[Option[Array[AvroValue]], AvroError] {
  ocf_next_block_impl(self, false)
}

fn read_ocf_impl(
  data : Bytes,
  reader_schema_opt : Option[Schema],
  limits : AvroLimits,
) -> Result[OcfFile, AvroError] {
  let reader = match ocf_open_impl(data, reader_schema_opt, limits) {
    Ok(rd) => rd
    Err(e) => return Err(e)
  }
  let records : Array[AvroValue] = []
  while true {
    match ocf_next_block_impl(reader, true) {
      Ok(None) => break
      Ok(Some(blk)) => {
        let mut i = 0
        while i < blk.length() {
          records.push(blk[i])
          i = i + 1
        }
      }
      Err(e) => return Err(e)
    }
  }
  Ok(
    OcfFile::{
      schema: reader.schema,
      codec: reader.codec,
      sync_marker: reader.sync_marker,
      metadata: reader.metadata,
      records: records,
    },
  )
}

///| Read an Apache Avro `.avro` Object Container File using default limits.
pub fn read_ocf(data : Bytes) -> Result[OcfFile, AvroError] {
  read_ocf_with_limits(data, AvroLimits::default())
}

///| Read an Apache Avro `.avro` Object Container File with custom limits.
pub fn read_ocf_with_limits(
  data : Bytes,
  limits : AvroLimits,
) -> Result[OcfFile, AvroError] {
  read_ocf_impl(data, None, limits)
}

///| Read an `.avro` OCF file and evolve every record from its embedded writer schema to `reader_schema`.
pub fn read_ocf_resolved(
  data : Bytes,
  reader_schema : Schema,
  limits : AvroLimits,
) -> Result[OcfFile, AvroError] {
  read_ocf_impl(data, Some(reader_schema), limits)
}
