///| Apache Avro 1.11.1 Object Container File (`.avro` OCF) reader and writer.

import "flate"

///| Compression codec for Avro Object Container Files.
pub enum OcfCodec {
  Null
  Deflate
}

///| Options for writing an Avro Object Container File.
pub struct OcfOptions {
  pub codec : OcfCodec
  pub sync_marker : Bytes
  pub block_size : Int
  pub metadata : Array[(String, Bytes)]
}

///| Default OCF options (`Null` codec, deterministic 16-byte sync marker, 1000 objects/block).
pub fn OcfOptions::default() -> OcfOptions {
  let sync = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    sync[i] = ((i * 17 + 0xA5) & 0xFF).to_byte()
    i = i + 1
  }
  OcfOptions::{
    codec: OcfCodec::Null,
    sync_marker: sync,
    block_size: 1000,
    metadata: [],
  }
}

///|
pub fn OcfOptions::with_codec(self : OcfOptions, codec : OcfCodec) -> OcfOptions {
  OcfOptions::{
    codec: codec,
    sync_marker: self.sync_marker,
    block_size: self.block_size,
    metadata: self.metadata,
  }
}

///|
pub fn OcfOptions::with_sync_marker(self : OcfOptions, sync : Bytes) -> OcfOptions {
  OcfOptions::{
    codec: self.codec,
    sync_marker: sync,
    block_size: self.block_size,
    metadata: self.metadata,
  }
}

///|
pub fn OcfOptions::with_block_size(self : OcfOptions, n : Int) -> OcfOptions {
  OcfOptions::{
    codec: self.codec,
    sync_marker: self.sync_marker,
    block_size: n,
    metadata: self.metadata,
  }
}

///|
pub fn OcfOptions::with_metadata(
  self : OcfOptions,
  meta : Array[(String, Bytes)],
) -> OcfOptions {
  OcfOptions::{
    codec: self.codec,
    sync_marker: self.sync_marker,
    block_size: self.block_size,
    metadata: meta,
  }
}

///| Decoded Apache Avro Object Container File.
pub struct OcfFile {
  pub schema : Schema
  pub codec : OcfCodec
  pub sync_marker : Bytes
  pub metadata : Array[(String, Bytes)]
  pub records : Array[AvroValue]
}

///| Serialize a sequence of records into an Apache Avro `.avro` Object Container File.
pub fn write_ocf(
  schema : Schema,
  records : Array[AvroValue],
  options : OcfOptions,
) -> Result[Bytes, AvroError] {
  let _ = flate::DecompressLimits::default()
  let _ = schema
  let _ = records
  let _ = options
  Err(AvroError::InvalidOcf("not implemented"))
}

///| Read an Apache Avro `.avro` Object Container File using default limits.
pub fn read_ocf(data : Bytes) -> Result[OcfFile, AvroError] {
  read_ocf_with_limits(data, AvroLimits::default())
}

///| Read an Apache Avro `.avro` Object Container File with custom limits.
pub fn read_ocf_with_limits(
  data : Bytes,
  limits : AvroLimits,
) -> Result[OcfFile, AvroError] {
  let _ = data
  let _ = limits
  Err(AvroError::InvalidOcf("not implemented"))
}

///| Read an `.avro` OCF file and evolve every record from its embedded writer schema to `reader_schema`.
pub fn read_ocf_resolved(
  data : Bytes,
  reader_schema : Schema,
  limits : AvroLimits,
) -> Result[OcfFile, AvroError] {
  let _ = data
  let _ = reader_schema
  let _ = limits
  Err(AvroError::InvalidOcf("not implemented"))
}
