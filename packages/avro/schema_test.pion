///| Apache Avro 1.11.1 Schema Parsing, Logical Types, Namespaces, Recursion, PCF & Rabin-64 Fingerprint Tests.

fn must_parse_schema(src : String) -> Schema {
  match parse_schema(src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "expected valid schema, got error: " + error_message(e))
      Schema::{ root: 0, nodes: [], named_indices: [] }
    }
  }
}

fn assert_schema_err(src : String, label : String) -> Unit {
  match parse_schema(src) {
    Ok(_) => debug_assert(false, "expected schema error for: " + label)
    Err(_) => ()
  }
}

test "schema: all 8 primitive types (string and object forms)" {
  let prims = [
    ("\"null\"", "\"null\""),
    ("{\"type\":\"null\"}", "\"null\""),
    ("\"boolean\"", "\"boolean\""),
    ("{\"type\":\"boolean\"}", "\"boolean\""),
    ("\"int\"", "\"int\""),
    ("{\"type\":\"int\"}", "\"int\""),
    ("\"long\"", "\"long\""),
    ("{\"type\":\"long\"}", "\"long\""),
    ("\"float\"", "\"float\""),
    ("{\"type\":\"float\"}", "\"float\""),
    ("\"double\"", "\"double\""),
    ("{\"type\":\"double\"}", "\"double\""),
    ("\"bytes\"", "\"bytes\""),
    ("{\"type\":\"bytes\"}", "\"bytes\""),
    ("\"string\"", "\"string\""),
    ("{\"type\":\"string\"}", "\"string\""),
  ]
  let mut i = 0
  while i < prims.length() {
    let (src, want_pcf) = prims[i]
    let s = must_parse_schema(src)
    let got_pcf = canonical_form(s)
    debug_assert(got_pcf == want_pcf, "PCF mismatch for " + src + ": got " + got_pcf)
    i = i + 1
  }
}

test "schema: official CRC-64-AVRO Rabin fingerprint vectors for primitives and complex types" {
  let cases = [
    ("\"null\"", 0x63dd24e7cc258f8aUL, "8a8f25cce724dd63"),
    ("\"boolean\"", 0x9f42fc78a4d4f764UL, "64f7d4a478fc429f"),
    ("\"int\"", 0x7275d51a3f395c8fUL, "8f5c393f1ad57572"),
    ("\"long\"", 0xd054e14493f41db7UL, "b71df49344e154d0"),
    ("\"float\"", 0x4d7c02cb3ea8d790UL, "90d7a83ecb027c4d"),
    ("\"double\"", 0x8e7535c032ab957eUL, "7e95ab32c035758e"),
    ("\"bytes\"", 0x4fc016dac3201965UL, "651920c3da16c04f"),
    ("\"string\"", 0x8f014872634503c7UL, "c70345637248018f"),
    (
      "{\"type\":\"record\",\"namespace\":\"com.example\",\"name\":\"User\",\"doc\":\"A user\",\"fields\":[{\"name\":\"id\",\"type\":{\"type\":\"long\"},\"doc\":\"pk\"},{\"name\":\"name\",\"type\":\"string\",\"default\":\"\"}]}",
      0xf6fa0c6b05ab6859UL,
      "5968ab056b0cfaf6",
    ),
    (
      "{\"type\":\"record\",\"name\":\"Node\",\"fields\":[{\"name\":\"value\",\"type\":\"int\"},{\"name\":\"next\",\"type\":[\"null\",\"Node\"]}]}",
      0x948de612852f483cUL,
      "3c482f8512e68d94",
    ),
    (
      "{\"type\":\"enum\",\"name\":\"Suit\",\"doc\":\"cards\",\"symbols\":[\"SPADES\",\"HEARTS\",\"DIAMONDS\",\"CLUBS\"],\"default\":\"SPADES\"}",
      0x86d82b5e3a471896UL,
      "9618473a5e2bd886",
    ),
    (
      "{\"type\":\"fixed\",\"name\":\"MD5\",\"size\":16,\"aliases\":[\"Hash16\"]}",
      0x9570fb171985ccd5UL,
      "d5cc851917fb7095",
    ),
  ]
  let mut i = 0
  while i < cases.length() {
    let (src, want_fp, want_le_hex) = cases[i]
    let s = must_parse_schema(src)
    let got_fp = fingerprint_rabin(s)
    debug_assert(got_fp == want_fp, "rabin fp mismatch for case " + i.to_string())
    let got_bytes = fingerprint_rabin_bytes(s)
    debug_assert(got_bytes.length() == 8, "rabin bytes len != 8")
    let lut = "0123456789abcdef"
    let hex_buf = Bytes::new(16)
    let mut k = 0
    while k < 8 {
      let b = got_bytes[k].to_int()
      hex_buf[k * 2] = lut.code_unit_at(b >> 4).to_byte()
      hex_buf[k * 2 + 1] = lut.code_unit_at(b & 15).to_byte()
      k = k + 1
    }
    debug_assert(hex_buf.to_string() == want_le_hex, "rabin le hex mismatch for case " + i.to_string())
    i = i + 1
  }
}

test "schema: namespace inheritance, dot-qualified names, null namespace, and shared named refs" {
  let src =
  "{\"type\":\"record\",\"name\":\"Outer\",\"namespace\":\"org.apache.avro\",\"fields\":[" +
  "{\"name\":\"inner\",\"type\":{\"type\":\"record\",\"name\":\"Inner\",\"fields\":[{\"name\":\"x\",\"type\":\"int\"}]}}," +
  "{\"name\":\"inner2\",\"type\":\"Inner\"}," +
  "{\"name\":\"abs\",\"type\":{\"type\":\"fixed\",\"name\":\"com.other.Tag\",\"size\":4}}," +
  "{\"name\":\"abs2\",\"type\":\"com.other.Tag\"}," +
  "{\"name\":\"rootns\",\"type\":{\"type\":\"enum\",\"name\":\"Color\",\"namespace\":\"\",\"symbols\":[\"R\",\"G\",\"B\"]}}," +
  "{\"name\":\"rootns2\",\"type\":\"Color\"}" +
  "]}"
  let s = must_parse_schema(src)
  let pcf = canonical_form(s)
  let want =
  "{\"name\":\"org.apache.avro.Outer\",\"type\":\"record\",\"fields\":[" +
  "{\"name\":\"inner\",\"type\":{\"name\":\"org.apache.avro.Inner\",\"type\":\"record\",\"fields\":[{\"name\":\"x\",\"type\":\"int\"}]}}," +
  "{\"name\":\"inner2\",\"type\":\"org.apache.avro.Inner\"}," +
  "{\"name\":\"abs\",\"type\":{\"name\":\"com.other.Tag\",\"type\":\"fixed\",\"size\":4}}," +
  "{\"name\":\"abs2\",\"type\":\"com.other.Tag\"}," +
  "{\"name\":\"rootns\",\"type\":{\"name\":\"Color\",\"type\":\"enum\",\"symbols\":[\"R\",\"G\",\"B\"]}}," +
  "{\"name\":\"rootns2\",\"type\":\"Color\"}" +
  "]}"
  debug_assert(pcf == want, "namespace PCF mismatch:\n got:  " + pcf + "\n want: " + want)
}

test "schema: recursive self-referencing record and mutual recursion" {
  let list_src =
  "{\"type\":\"record\",\"name\":\"LongList\",\"namespace\":\"test\",\"fields\":[" +
  "{\"name\":\"value\",\"type\":\"long\"}," +
  "{\"name\":\"next\",\"type\":[\"null\",\"LongList\"],\"default\":null}" +
  "]}"
  let s = must_parse_schema(list_src)
  let pcf = canonical_form(s)
  debug_assert(
    pcf == "{\"name\":\"test.LongList\",\"type\":\"record\",\"fields\":[{\"name\":\"value\",\"type\":\"long\"},{\"name\":\"next\",\"type\":[\"null\",\"test.LongList\"]}]}",
    "recursive PCF mismatch: " + pcf,
  )
}

test "schema: all 8 logical types and invalid logical type fallback" {
  let s_dec_bytes = must_parse_schema("{\"type\":\"bytes\",\"logicalType\":\"decimal\",\"precision\":10,\"scale\":2}")
  match s_dec_bytes.root_node().logical {
    LogicalType::Decimal(p, sc) => debug_assert(p == 10 && sc == 2, "decimal bytes params")
    _ => debug_assert(false, "expected Decimal(10, 2)")
  }
  let s_dec_fixed = must_parse_schema("{\"type\":\"fixed\",\"name\":\"Dec8\",\"size\":8,\"logicalType\":\"decimal\",\"precision\":18,\"scale\":4}")
  match s_dec_fixed.root_node().logical {
    LogicalType::Decimal(p, sc) => debug_assert(p == 18 && sc == 4, "decimal fixed params")
    _ => debug_assert(false, "expected Decimal(18, 4)")
  }
  // Invalid decimal: scale > precision -> ignored per Avro 1.11.1 spec (falls back to underlying type)
  let s_dec_bad = must_parse_schema("{\"type\":\"bytes\",\"logicalType\":\"decimal\",\"precision\":4,\"scale\":5}")
  match s_dec_bad.root_node().logical {
    LogicalType::None => ()
    _ => debug_assert(false, "invalid decimal should fall back to LogicalType::None")
  }
  // Invalid fixed decimal: fixed(4) max precision is floor(log10(2^31 - 1)) = 9; precision=10 is invalid
  let s_dec_fixed_bad = must_parse_schema("{\"type\":\"fixed\",\"name\":\"Dec4\",\"size\":4,\"logicalType\":\"decimal\",\"precision\":10,\"scale\":2}")
  match s_dec_fixed_bad.root_node().logical {
    LogicalType::None => ()
    _ => debug_assert(false, "overflowing fixed decimal should fall back to LogicalType::None")
  }
  let s_uuid = must_parse_schema("{\"type\":\"string\",\"logicalType\":\"uuid\"}")
  match s_uuid.root_node().logical {
    LogicalType::Uuid => ()
    _ => debug_assert(false, "expected Uuid")
  }
  let s_date = must_parse_schema("{\"type\":\"int\",\"logicalType\":\"date\"}")
  match s_date.root_node().logical {
    LogicalType::Date => ()
    _ => debug_assert(false, "expected Date")
  }
  let s_tm = must_parse_schema("{\"type\":\"int\",\"logicalType\":\"time-millis\"}")
  match s_tm.root_node().logical {
    LogicalType::TimeMillis => ()
    _ => debug_assert(false, "expected TimeMillis")
  }
  let s_tu = must_parse_schema("{\"type\":\"long\",\"logicalType\":\"time-micros\"}")
  match s_tu.root_node().logical {
    LogicalType::TimeMicros => ()
    _ => debug_assert(false, "expected TimeMicros")
  }
  let s_tsm = must_parse_schema("{\"type\":\"long\",\"logicalType\":\"timestamp-millis\"}")
  match s_tsm.root_node().logical {
    LogicalType::TimestampMillis => ()
    _ => debug_assert(false, "expected TimestampMillis")
  }
  let s_tsu = must_parse_schema("{\"type\":\"long\",\"logicalType\":\"timestamp-micros\"}")
  match s_tsu.root_node().logical {
    LogicalType::TimestampMicros => ()
    _ => debug_assert(false, "expected TimestampMicros")
  }
  let s_dur = must_parse_schema("{\"type\":\"fixed\",\"name\":\"Dur\",\"size\":12,\"logicalType\":\"duration\"}")
  match s_dur.root_node().logical {
    LogicalType::Duration => ()
    _ => debug_assert(false, "expected Duration")
  }
  // Duration on fixed(8) is invalid -> fallback to None
  let s_dur_bad = must_parse_schema("{\"type\":\"fixed\",\"name\":\"DurBad\",\"size\":8,\"logicalType\":\"duration\"}")
  match s_dur_bad.root_node().logical {
    LogicalType::None => ()
    _ => debug_assert(false, "duration on fixed(8) should fall back to None")
  }
}

test "schema: invalid schema rejection" {
  assert_schema_err("\"unknown_type\"", "unknown primitive")
  assert_schema_err("123", "non-object/array/string root")
  let empty_u = must_parse_schema("[]")
  debug_assert(canonical_form(empty_u) == "[]", "empty union PCF")
  assert_schema_err("[\"null\", [\"int\", \"long\"]]", "nested union")
  assert_schema_err("[\"int\", \"int\"]", "duplicate primitive in union")
  assert_schema_err("{\"type\":\"record\",\"name\":\"123Bad\",\"fields\":[]}", "invalid identifier starting with digit")
  assert_schema_err("{\"type\":\"record\",\"name\":\"int\",\"fields\":[]}", "primitive name as record name")
  assert_schema_err("{\"type\":\"record\",\"name\":\"Dup\",\"fields\":[{\"name\":\"a\",\"type\":\"int\"},{\"name\":\"a\",\"type\":\"string\"}]}", "duplicate field name")
  assert_schema_err("{\"type\":\"enum\",\"name\":\"E\",\"symbols\":[\"A\",\"A\"]}", "duplicate enum symbols")
  assert_schema_err("{\"type\":\"enum\",\"name\":\"E\",\"symbols\":[\"A\"],\"default\":\"B\"}", "enum default not in symbols")
  assert_schema_err("{\"type\":\"fixed\",\"name\":\"F\",\"size\":-1}", "negative fixed size")
  assert_schema_err("{\"type\":\"array\"}", "array missing items")
  assert_schema_err("{\"type\":\"map\"}", "map missing values")
  assert_schema_err("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"x\",\"type\":[\"null\",\"string\"],\"default\":\"bad\"}]}", "union default does not match first branch")
}
