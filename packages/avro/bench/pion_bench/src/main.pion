///| Head-to-head Apache Avro 1.11.1 benchmark & interop runner (Pion Native).

import "avro"

fn schema_v1_json() -> String {
  "{\"name\":\"com.bench.TelemetryEvent\",\"type\":\"record\",\"fields\":[" +
  "{\"name\":\"id\",\"type\":\"int\"}," +
  "{\"name\":\"ts\",\"type\":\"long\"}," +
  "{\"name\":\"score\",\"type\":\"float\"}," +
  "{\"name\":\"service\",\"type\":\"string\"}," +
  "{\"name\":\"tags\",\"type\":{\"type\":\"array\",\"items\":\"string\"}}," +
  "{\"name\":\"metrics\",\"type\":{\"type\":\"map\",\"values\":\"long\"}}," +
  "{\"name\":\"note\",\"type\":[\"null\",\"string\"]}" +
  "]}"
}

fn schema_v2_json() -> String {
  "{\"name\":\"com.bench.TelemetryEvent\",\"type\":\"record\",\"fields\":[" +
  "{\"name\":\"service\",\"type\":\"string\"}," +
  "{\"name\":\"id\",\"type\":\"long\"}," +
  "{\"name\":\"score\",\"type\":\"double\"}," +
  "{\"name\":\"tags\",\"type\":{\"type\":\"array\",\"items\":\"string\"}}," +
  "{\"name\":\"note\",\"type\":[\"null\",\"string\"]}," +
  "{\"name\":\"region\",\"type\":\"string\",\"default\":\"ap-northeast-1\"}" +
  "]}"
}

fn parse_int_arg(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  v
}

fn make_v1_records(count : Int) -> Array[avro::AvroValue] {
  let svcs : Array[String] = []
  let mut s = 0
  while s < 16 {
    svcs.push("svc-" + s.to_string())
    s = s + 1
  }
  let tiers : Array[String] = ["tier:0", "tier:1", "tier:2", "tier:3"]
  let msgs : Array[String] = []
  let mut m = 0
  while m < 64 {
    msgs.push("msg-" + m.to_string())
    m = m + 1
  }

  let out : Array[avro::AvroValue] = []
  let mut i = 0
  while i < count {
    let ts = 1700000000000L + i.to_int64() * 13L
    let score = (i % 1000).to_double() * 0.25
    let note = if i % 3 == 0 {
      avro::AvroValue::Union(0, avro::AvroValue::Null)
    } else {
      avro::AvroValue::Union(1, avro::AvroValue::String(msgs[i % 64]))
    }
    out.push(
      avro::AvroValue::Record([
        ("id", avro::AvroValue::Int(i)),
        ("ts", avro::AvroValue::Long(ts)),
        ("score", avro::AvroValue::Float32(score)),
        ("service", avro::AvroValue::String(svcs[i % 16])),
        ("tags", avro::AvroValue::Array([avro::AvroValue::String("env:prod"), avro::AvroValue::String(tiers[i % 4])])),
        ("metrics", avro::AvroValue::Map([("cpu", avro::AvroValue::Long((i % 100 + 1).to_int64()))])),
        ("note", note),
      ]),
    )
    i = i + 1
  }
  out
}

fn summarize_v1(records : Array[avro::AvroValue]) -> String {
  let mut sum_id : Int64 = 0L
  let mut sum_ts : Int64 = 0L
  let mut sum_score_q4 : Int64 = 0L
  let mut sum_tags : Int64 = 0L
  let mut sum_metrics : Int64 = 0L
  let mut non_null_notes : Int64 = 0L
  let mut i = 0
  while i < records.length() {
    match records[i] {
      avro::AvroValue::Record(fields) => {
        match fields[0] {
          (_, avro::AvroValue::Int(v)) => sum_id = sum_id + v.to_int64()
          _ => ()
        }
        match fields[1] {
          (_, avro::AvroValue::Long(v)) => sum_ts = sum_ts + v
          _ => ()
        }
        match fields[2] {
          (_, avro::AvroValue::Float32(v)) => sum_score_q4 = sum_score_q4 + (v * 4.0).to_int().to_int64()
          _ => ()
        }
        match fields[4] {
          (_, avro::AvroValue::Array(arr)) => sum_tags = sum_tags + arr.length().to_int64()
          _ => ()
        }
        match fields[5] {
          (_, avro::AvroValue::Map(entries)) => {
            let mut j = 0
            while j < entries.length() {
              match entries[j] {
                (_, avro::AvroValue::Long(mv)) => sum_metrics = sum_metrics + mv
                _ => ()
              }
              j = j + 1
            }
          }
          _ => ()
        }
        match fields[6] {
          (_, avro::AvroValue::Union(1, _)) => non_null_notes = non_null_notes + 1L
          _ => ()
        }
      }
      _ => ()
    }
    i = i + 1
  }
  "count=" + records.length().to_string() +
  " sum_id=" + sum_id.to_string() +
  " sum_ts=" + sum_ts.to_string() +
  " sum_score_q4=" + sum_score_q4.to_string() +
  " sum_tags=" + sum_tags.to_string() +
  " sum_metrics=" + sum_metrics.to_string() +
  " non_null_notes=" + non_null_notes.to_string()
}

fn summarize_v2(records : Array[avro::AvroValue]) -> String {
  let mut sum_id : Int64 = 0L
  let mut sum_score_q4 : Int64 = 0L
  let mut sum_tags : Int64 = 0L
  let mut non_null_notes : Int64 = 0L
  let mut region_ok : Int64 = 0L
  let mut i = 0
  while i < records.length() {
    match records[i] {
      avro::AvroValue::Record(fields) => {
        match fields[1] {
          (_, avro::AvroValue::Long(v)) => sum_id = sum_id + v
          _ => ()
        }
        match fields[2] {
          (_, avro::AvroValue::Float64(v)) => sum_score_q4 = sum_score_q4 + (v * 4.0).to_int().to_int64()
          _ => ()
        }
        match fields[3] {
          (_, avro::AvroValue::Array(arr)) => sum_tags = sum_tags + arr.length().to_int64()
          _ => ()
        }
        match fields[4] {
          (_, avro::AvroValue::Union(1, _)) => non_null_notes = non_null_notes + 1L
          _ => ()
        }
        match fields[5] {
          (_, avro::AvroValue::String(reg)) =>
          if reg == "ap-northeast-1" {
            region_ok = region_ok + 1L
          }
          _ => ()
        }
      }
      _ => ()
    }
    i = i + 1
  }
  "count=" + records.length().to_string() +
  " sum_id=" + sum_id.to_string() +
  " sum_score_q4=" + sum_score_q4.to_string() +
  " sum_tags=" + sum_tags.to_string() +
  " non_null_notes=" + non_null_notes.to_string() +
  " region_ok=" + region_ok.to_string()
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_bench <w1|w2|w3|gen_v1|write_ocf|read_ocf|fp> ...")
    return 1
  }
  let mode = args[1]
  let s1 = match avro::parse_schema(schema_v1_json()) {
    Ok(s) => s
    Err(e) => {
      io_println(world, "schema v1 err: " + avro::error_message(e))
      return 1
    }
  }
  let s2 = match avro::parse_schema(schema_v2_json()) {
    Ok(s) => s
    Err(e) => {
      io_println(world, "schema v2 err: " + avro::error_message(e))
      return 1
    }
  }
  let limits = avro::AvroLimits::default().with_max_elements(2000000)

  if mode == "fp" {
    io_println(world, "fp_v1=" + avro::fingerprint_rabin_hex(s1))
    return 0
  }

  if mode == "gen_v1" {
    let out_path = args[2]
    let count = parse_int_arg(args[3])
    let recs = make_v1_records(count)
    let raw = match avro::encode_datums(s1, recs, limits) {
      Ok(b) => b
      Err(e) => {
        io_println(world, "encode err: " + avro::error_message(e))
        return 2
      }
    }
    match fs_write_bytes(world, out_path, raw) {
      Ok(_) => ()
      Err(_) => return 3
    }
    io_println(world, "gen_v1 bytes=" + raw.length().to_string())
    return 0
  }

  if mode == "decode_v1" {
    let in_path = args[2]
    let count = parse_int_arg(args[3])
    let raw = match fs_read_bytes(world, in_path) {
      Ok(b) => b
      Err(_) => return 2
    }
    let decoded = match avro::decode_datums(s1, raw, count, limits) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "decode_v1 err: " + avro::error_message(e))
        return 3
      }
    }
    io_println(world, "interop_v1 " + summarize_v1(decoded))
    return 0
  }

  if mode == "w1" {
    let count = parse_int_arg(args[2])
    let recs = make_v1_records(count)
    let encoded = match avro::encode_datums(s1, recs, limits) {
      Ok(b) => b
      Err(e) => {
        io_println(world, "w1 encode err: " + avro::error_message(e))
        return 2
      }
    }
    let decoded = match avro::decode_datums(s1, encoded, count, limits) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "w1 decode err: " + avro::error_message(e))
        return 3
      }
    }
    io_println(world, "mode=w1 " + summarize_v1(decoded))
    return 0
  }

  if mode == "w2" {
    let in_path = args[2]
    let count = parse_int_arg(args[3])
    let raw = match fs_read_bytes(world, in_path) {
      Ok(b) => b
      Err(_) => return 2
    }
    let resolver = match avro::compile_resolver(s1, s2) {
      Ok(r) => r
      Err(e) => {
        io_println(world, "w2 resolver err: " + avro::error_message(e))
        return 3
      }
    }
    let evolved = match avro::decode_datums_with_resolver(resolver, raw, count, limits) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "w2 decode err: " + avro::error_message(e))
        return 4
      }
    }
    io_println(world, "mode=w2 " + summarize_v2(evolved))
    return 0
  }

  if mode == "w3" {
    let count = parse_int_arg(args[2])
    let recs = make_v1_records(count)
    let opts = avro::OcfOptions::default().with_codec(avro::OcfCodec::Deflate).with_block_size(1000)
    let ocf_bytes = match avro::write_ocf(s1, recs, opts) {
      Ok(b) => b
      Err(e) => {
        io_println(world, "w3 write err: " + avro::error_message(e))
        return 2
      }
    }
    let read_back = match avro::read_ocf_with_limits(ocf_bytes, limits) {
      Ok(f) => f
      Err(e) => {
        io_println(world, "w3 read err: " + avro::error_message(e))
        return 3
      }
    }
    io_println(world, "mode=w3 " + summarize_v1(read_back.records))
    return 0
  }

  if mode == "write_ocf" {
    let out_path = args[2]
    let count = parse_int_arg(args[3])
    let recs = make_v1_records(count)
    let opts = avro::OcfOptions::default().with_codec(avro::OcfCodec::Deflate).with_block_size(1000)
    let ocf_bytes = match avro::write_ocf(s1, recs, opts) {
      Ok(b) => b
      Err(e) => {
        io_println(world, "write_ocf err: " + avro::error_message(e))
        return 2
      }
    }
    match fs_write_bytes(world, out_path, ocf_bytes) {
      Ok(_) => ()
      Err(_) => return 3
    }
    io_println(world, "write_ocf bytes=" + ocf_bytes.length().to_string())
    return 0
  }

  if mode == "read_ocf" {
    let in_path = args[2]
    let raw = match fs_read_bytes(world, in_path) {
      Ok(b) => b
      Err(_) => return 2
    }
    let read_back = match avro::read_ocf_with_limits(raw, limits) {
      Ok(f) => f
      Err(e) => {
        io_println(world, "read_ocf err: " + avro::error_message(e))
        return 3
      }
    }
    io_println(world, "interop_ocf " + summarize_v1(read_back.records))
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
