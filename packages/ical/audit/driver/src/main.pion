///| Red-team differential / DoS driver for `packages/ical` (audit only, never shipped).
///| Modes:
///|   rrule <file>       each line `DTSTART|RULE|LIMIT` -> `OK <n>:<occ,occ,...>` or `ERR`
///|   time <dtstart> <rule> <limit>   expand and print count + elapsed-independent checksum
///|   ics <file>         parse .ics, print `OK <events>` or `ERR <msg>`

import "ical"
import "time"

///|
fn split_char(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || s.code_unit_at(i) == sep {
      let sb = StringBuilder::new()
      let mut k = start
      while k < i {
        sb.write_byte(s.code_unit_at(k).to_byte())
        k = k + 1
      }
      out.push(sb.to_string())
      start = i + 1
    }
    i = i + 1
  }
  out
}

///|
fn parse_int_simple(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///|
fn fmt_dt(dt : time::DateTime) -> String {
  ical::ical_datetime_to_value(ical::IcalDateTime::Floating(dt))
}

///|
fn expand_line(line : String) -> String {
  let parts = split_char(line, 124)
  if parts.length() < 3 {
    return "ERR"
  }
  let dtstart = match ical::parse_ical_datetime(parts[0], None) {
    Ok(idt) => ical::ical_datetime_to_datetime(idt)
    Err(_) => return "ERR"
  }
  let rule = match ical::RRule::parse(parts[1]) {
    Ok(r) => r
    Err(_) => return "ERR"
  }
  let limit = parse_int_simple(parts[2])
  match rule.all(dtstart, limit) {
    Ok(occ) => {
      let sb = StringBuilder::new()
      sb.write_string("OK ")
      sb.write_string(occ.length().to_string())
      sb.write_string(":")
      let mut i = 0
      while i < occ.length() {
        if i > 0 {
          sb.write_string(",")
        }
        sb.write_string(fmt_dt(occ[i]))
        i = i + 1
      }
      sb.to_string()
    }
    Err(_) => "ERR"
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: driver rrule <file> | time <dtstart> <rule> <limit> | ics <file>")
    return 1
  }
  let mode = args[1]
  if mode == "time" {
    if args.length() < 5 {
      return 1
    }
    io_println(world, expand_line(args[2] + "|" + args[3] + "|" + args[4]))
    return 0
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_println(world, "failed to read input")
      return 1
    }
  }
  if mode == "rrule" {
    let lines = split_char(data, 10)
    let mut i = 0
    while i < lines.length() {
      if lines[i].length() > 0 {
        io_println(world, expand_line(lines[i]))
      }
      i = i + 1
    }
    return 0
  }
  if mode == "vtz" {
    // vtz <file> <YYYYMMDDTHHMMSS>: offset_at() of the first VTIMEZONE
    if args.length() < 4 {
      return 1
    }
    let cal = match ical::Calendar::parse(data) {
      Ok(c) => c
      Err(e) => {
        io_println(world, "ERR " + ical::ical_error_to_string(e))
        return 0
      }
    }
    let tzs = cal.timezones()
    if tzs.length() == 0 {
      io_println(world, "ERR no VTIMEZONE")
      return 0
    }
    let vtz = match ical::VTimeZone::from_component(tzs[0]) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "ERR " + ical::ical_error_to_string(e))
        return 0
      }
    }
    let at = match ical::parse_ical_datetime(args[3], None) {
      Ok(idt) => ical::ical_datetime_to_datetime(idt)
      Err(_) => return 1
    }
    match vtz.offset_at(at) {
      Some(o) => io_println(world, "OK " + o.seconds.to_string())
      None => io_println(world, "OK none")
    }
    return 0
  }
  if mode == "ics" {
    match ical::Calendar::parse(data) {
      Ok(cal) => io_println(world, "OK " + cal.events().length().to_string())
      Err(e) => io_println(world, "ERR " + ical::ical_error_to_string(e))
    }
    return 0
  }
  1
}
