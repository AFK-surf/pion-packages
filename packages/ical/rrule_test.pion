///| RFC 5545 §3.8.5.3 official RRULE examples + rrule.js / dateutil edge cases.

import "time"

///|
fn dt(y : Int, mo : Int, d : Int, h : Int, mi : Int, s : Int) -> time::DateTime {
  match time::DateTime::new(y, mo, d, h, mi, s, 0) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "invalid test DateTime")
      time::DateTime::min()
    }
  }
}

///|
fn must_rrule(s : String) -> RRule {
  match RRule::parse(s) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "RRule::parse failed for '" + s + "': " + ical_error_to_string(e))
      RRule::{
        freq: Freq::Daily,
        interval: 1,
        count: Some(0),
        until: None,
        until_is_utc: false,
        until_is_date: false,
        wkst: time::Weekday::Mon,
        bysetpos: [],
        bymonth: [],
        bymonthday: [],
        byyearday: [],
        byweekno: [],
        byday: [],
        byhour: [],
        byminute: [],
        bysecond: [],
        rscale: None,
        skip: None,
      }
    }
  }
}

///|
fn assert_dts(
  got : Array[time::DateTime],
  expected : Array[time::DateTime],
  label : String,
) -> Unit {
  debug_assert(
    got.length() == expected.length(),
    label + ": expected " + expected.length().to_string() + " occurrences, got " + got.length().to_string(),
  )
  let mut i = 0
  while i < got.length() && i < expected.length() {
    debug_assert(
      got[i].eq(expected[i]),
      label + " [" + i.to_string() + "]: expected " + expected[i].to_string() + ", got " + got[i].to_string(),
    )
    i = i + 1
  }
}

///|
fn expand_all(rule_str : String, start : time::DateTime, limit : Int) -> Array[time::DateTime] {
  let r = must_rrule(rule_str)
  match r.all(start, limit) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "RRule::all failed for '" + rule_str + "': " + ical_error_to_string(e))
      []
    }
  }
}

///|
test "rfc5545_daily_examples" {
  // Daily for 10 occurrences
  let res1 = expand_all("FREQ=DAILY;COUNT=10", dt(1997, 9, 2, 9, 0, 0), 100)
  debug_assert(res1.length() == 10, "daily count 10")
  debug_assert(res1[0].eq(dt(1997, 9, 2, 9, 0, 0)), "daily[0]")
  debug_assert(res1[9].eq(dt(1997, 9, 11, 9, 0, 0)), "daily[9]")

  // Daily until Dec 24, 1997 (113 occurrences: Sep 2..Dec 23)
  let res2 = expand_all("FREQ=DAILY;UNTIL=19971224T000000Z", dt(1997, 9, 2, 9, 0, 0), 500)
  debug_assert(res2.length() == 113, "daily until count=113")
  debug_assert(res2[0].eq(dt(1997, 9, 2, 9, 0, 0)), "daily until[0]")
  debug_assert(res2[112].eq(dt(1997, 12, 23, 9, 0, 0)), "daily until[112]")

  // Every 10 days, 5 occurrences
  let res3 = expand_all("FREQ=DAILY;INTERVAL=10;COUNT=5", dt(1997, 9, 2, 9, 0, 0), 100)
  assert_dts(
    res3,
    [
      dt(1997, 9, 2, 9, 0, 0),
      dt(1997, 9, 12, 9, 0, 0),
      dt(1997, 9, 22, 9, 0, 0),
      dt(1997, 10, 2, 9, 0, 0),
      dt(1997, 10, 12, 9, 0, 0),
    ],
    "every 10 days",
  )

  // Every day in January, for 3 years (two equivalent RFC 5545 forms)
  let jan_yearly = expand_all(
    "FREQ=YEARLY;UNTIL=20000131T140000Z;BYMONTH=1;BYDAY=SU,MO,TU,WE,TH,FR,SA",
    dt(1998, 1, 1, 9, 0, 0),
    200,
  )
  let jan_daily = expand_all(
    "FREQ=DAILY;UNTIL=20000131T140000Z;BYMONTH=1",
    dt(1998, 1, 1, 9, 0, 0),
    200,
  )
  debug_assert(jan_yearly.length() == 93, "jan_yearly == 93")
  assert_dts(jan_yearly, jan_daily, "jan_yearly == jan_daily")
}

///|
test "rfc5545_weekly_and_wkst_examples" {
  // Weekly on Tue and Thu for five weeks
  let res1 = expand_all(
    "FREQ=WEEKLY;UNTIL=19971007T000000Z;WKST=SU;BYDAY=TU,TH",
    dt(1997, 9, 2, 9, 0, 0),
    100,
  )
  assert_dts(
    res1,
    [
      dt(1997, 9, 2, 9, 0, 0),
      dt(1997, 9, 4, 9, 0, 0),
      dt(1997, 9, 9, 9, 0, 0),
      dt(1997, 9, 11, 9, 0, 0),
      dt(1997, 9, 16, 9, 0, 0),
      dt(1997, 9, 18, 9, 0, 0),
      dt(1997, 9, 23, 9, 0, 0),
      dt(1997, 9, 25, 9, 0, 0),
      dt(1997, 9, 30, 9, 0, 0),
      dt(1997, 10, 2, 9, 0, 0),
    ],
    "weekly TU,TH",
  )

  // Every other week on Tue and Thu, for 8 occurrences
  let res2 = expand_all(
    "FREQ=WEEKLY;INTERVAL=2;COUNT=8;WKST=SU;BYDAY=TU,TH",
    dt(1997, 9, 2, 9, 0, 0),
    100,
  )
  assert_dts(
    res2,
    [
      dt(1997, 9, 2, 9, 0, 0),
      dt(1997, 9, 4, 9, 0, 0),
      dt(1997, 9, 16, 9, 0, 0),
      dt(1997, 9, 18, 9, 0, 0),
      dt(1997, 9, 30, 9, 0, 0),
      dt(1997, 10, 2, 9, 0, 0),
      dt(1997, 10, 14, 9, 0, 0),
      dt(1997, 10, 16, 9, 0, 0),
    ],
    "biweekly TU,TH",
  )

  // RFC 5545 WKST=MO vs WKST=SU classic example
  let wkst_mo = expand_all(
    "FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=MO",
    dt(1997, 8, 5, 9, 0, 0),
    100,
  )
  assert_dts(
    wkst_mo,
    [
      dt(1997, 8, 5, 9, 0, 0),
      dt(1997, 8, 10, 9, 0, 0),
      dt(1997, 8, 19, 9, 0, 0),
      dt(1997, 8, 24, 9, 0, 0),
    ],
    "WKST=MO",
  )

  let wkst_su = expand_all(
    "FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=SU",
    dt(1997, 8, 5, 9, 0, 0),
    100,
  )
  assert_dts(
    wkst_su,
    [
      dt(1997, 8, 5, 9, 0, 0),
      dt(1997, 8, 17, 9, 0, 0),
      dt(1997, 8, 19, 9, 0, 0),
      dt(1997, 8, 31, 9, 0, 0),
    ],
    "WKST=SU",
  )
}

///|
test "rfc5545_monthly_ordinals_and_bymonthday" {
  // Monthly on the first Friday for 6 occurrences
  let res1 = expand_all("FREQ=MONTHLY;COUNT=6;BYDAY=1FR", dt(1997, 9, 5, 9, 0, 0), 100)
  assert_dts(
    res1,
    [
      dt(1997, 9, 5, 9, 0, 0),
      dt(1997, 10, 3, 9, 0, 0),
      dt(1997, 11, 7, 9, 0, 0),
      dt(1997, 12, 5, 9, 0, 0),
      dt(1998, 1, 2, 9, 0, 0),
      dt(1998, 2, 6, 9, 0, 0),
    ],
    "monthly 1FR",
  )

  // Monthly on the first and last Sunday of the month
  let res2 = expand_all("FREQ=MONTHLY;COUNT=6;BYDAY=1SU,-1SU", dt(1997, 9, 7, 9, 0, 0), 100)
  assert_dts(
    res2,
    [
      dt(1997, 9, 7, 9, 0, 0),
      dt(1997, 9, 28, 9, 0, 0),
      dt(1997, 10, 5, 9, 0, 0),
      dt(1997, 10, 26, 9, 0, 0),
      dt(1997, 11, 2, 9, 0, 0),
      dt(1997, 11, 30, 9, 0, 0),
    ],
    "monthly 1SU,-1SU",
  )

  // Monthly on second-to-last Monday (-2MO)
  let res3 = expand_all("FREQ=MONTHLY;COUNT=6;BYDAY=-2MO", dt(1997, 9, 22, 9, 0, 0), 100)
  assert_dts(
    res3,
    [
      dt(1997, 9, 22, 9, 0, 0),
      dt(1997, 10, 20, 9, 0, 0),
      dt(1997, 11, 17, 9, 0, 0),
      dt(1997, 12, 22, 9, 0, 0),
      dt(1998, 1, 19, 9, 0, 0),
      dt(1998, 2, 16, 9, 0, 0),
    ],
    "monthly -2MO",
  )

  // Monthly on third-to-last day (BYMONTHDAY=-3)
  let res4 = expand_all("FREQ=MONTHLY;BYMONTHDAY=-3;COUNT=6", dt(1997, 9, 28, 9, 0, 0), 100)
  assert_dts(
    res4,
    [
      dt(1997, 9, 28, 9, 0, 0),
      dt(1997, 10, 29, 9, 0, 0),
      dt(1997, 11, 28, 9, 0, 0),
      dt(1997, 12, 29, 9, 0, 0),
      dt(1998, 1, 29, 9, 0, 0),
      dt(1998, 2, 26, 9, 0, 0),
    ],
    "monthly BYMONTHDAY=-3",
  )

  // Monthly on 1st and last day (BYMONTHDAY=1,-1)
  let res5 = expand_all("FREQ=MONTHLY;COUNT=6;BYMONTHDAY=1,-1", dt(1997, 9, 30, 9, 0, 0), 100)
  assert_dts(
    res5,
    [
      dt(1997, 9, 30, 9, 0, 0),
      dt(1997, 10, 1, 9, 0, 0),
      dt(1997, 10, 31, 9, 0, 0),
      dt(1997, 11, 1, 9, 0, 0),
      dt(1997, 11, 30, 9, 0, 0),
      dt(1997, 12, 1, 9, 0, 0),
    ],
    "monthly BYMONTHDAY=1,-1",
  )

  // Every Friday the 13th
  let fri13 = expand_all("FREQ=MONTHLY;BYDAY=FR;BYMONTHDAY=13;COUNT=5", dt(1997, 9, 2, 9, 0, 0), 100)
  assert_dts(
    fri13,
    [
      dt(1998, 2, 13, 9, 0, 0),
      dt(1998, 3, 13, 9, 0, 0),
      dt(1998, 11, 13, 9, 0, 0),
      dt(1999, 8, 13, 9, 0, 0),
      dt(2000, 10, 13, 9, 0, 0),
    ],
    "Friday the 13th",
  )

  // Monthly on the 31st skips short months
  let day31 = expand_all("FREQ=MONTHLY;COUNT=5", dt(2007, 1, 31, 9, 0, 0), 100)
  assert_dts(
    day31,
    [
      dt(2007, 1, 31, 9, 0, 0),
      dt(2007, 3, 31, 9, 0, 0),
      dt(2007, 5, 31, 9, 0, 0),
      dt(2007, 7, 31, 9, 0, 0),
      dt(2007, 8, 31, 9, 0, 0),
    ],
    "monthly 31st skips short months",
  )
}

///|
test "rfc5545_yearly_byyearday_byweekno_bysetpos_and_leap" {
  // Every 3rd year on 1st, 100th, and 200th day (note 2000 is leap year!)
  let yd = expand_all(
    "FREQ=YEARLY;INTERVAL=3;COUNT=7;BYYEARDAY=1,100,200",
    dt(1997, 1, 1, 9, 0, 0),
    100,
  )
  assert_dts(
    yd,
    [
      dt(1997, 1, 1, 9, 0, 0),
      dt(1997, 4, 10, 9, 0, 0),
      dt(1997, 7, 19, 9, 0, 0),
      dt(2000, 1, 1, 9, 0, 0),
      dt(2000, 4, 9, 9, 0, 0),
      dt(2000, 7, 18, 9, 0, 0),
      dt(2003, 1, 1, 9, 0, 0),
    ],
    "yearly BYYEARDAY=1,100,200",
  )

  // Every 20th Monday of the year
  let m20 = expand_all("FREQ=YEARLY;BYDAY=20MO;COUNT=3", dt(1997, 5, 19, 9, 0, 0), 100)
  assert_dts(
    m20,
    [
      dt(1997, 5, 19, 9, 0, 0),
      dt(1998, 5, 18, 9, 0, 0),
      dt(1999, 5, 17, 9, 0, 0),
    ],
    "yearly 20MO",
  )

  // Monday of week number 20 (ISO week, WKST=MO)
  let w20 = expand_all("FREQ=YEARLY;BYWEEKNO=20;BYDAY=MO;COUNT=3", dt(1997, 5, 12, 9, 0, 0), 100)
  assert_dts(
    w20,
    [
      dt(1997, 5, 12, 9, 0, 0),
      dt(1998, 5, 11, 9, 0, 0),
      dt(1999, 5, 17, 9, 0, 0),
    ],
    "yearly BYWEEKNO=20;BYDAY=MO",
  )

  // US Presidential Election Day: every 4 years, first Tuesday after a Monday in November
  let elec = expand_all(
    "FREQ=YEARLY;INTERVAL=4;BYMONTH=11;BYDAY=TU;BYMONTHDAY=2,3,4,5,6,7,8;COUNT=4",
    dt(1996, 11, 5, 9, 0, 0),
    100,
  )
  assert_dts(
    elec,
    [
      dt(1996, 11, 5, 9, 0, 0),
      dt(2000, 11, 7, 9, 0, 0),
      dt(2004, 11, 2, 9, 0, 0),
      dt(2008, 11, 4, 9, 0, 0),
    ],
    "US Election Day",
  )

  // BYSETPOS=3: 3rd instance of TU,WE,TH in month
  let sp3 = expand_all(
    "FREQ=MONTHLY;COUNT=3;BYDAY=TU,WE,TH;BYSETPOS=3",
    dt(1997, 9, 4, 9, 0, 0),
    100,
  )
  assert_dts(
    sp3,
    [
      dt(1997, 9, 4, 9, 0, 0),
      dt(1997, 10, 7, 9, 0, 0),
      dt(1997, 11, 6, 9, 0, 0),
    ],
    "monthly BYSETPOS=3",
  )

  // BYSETPOS=-2: second-to-last weekday of month
  let sp_neg2 = expand_all(
    "FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-2;COUNT=5",
    dt(1997, 9, 29, 9, 0, 0),
    100,
  )
  assert_dts(
    sp_neg2,
    [
      dt(1997, 9, 29, 9, 0, 0),
      dt(1997, 10, 30, 9, 0, 0),
      dt(1997, 11, 27, 9, 0, 0),
      dt(1997, 12, 30, 9, 0, 0),
      dt(1998, 1, 29, 9, 0, 0),
    ],
    "monthly BYSETPOS=-2",
  )

  // Leap year Feb 29 skips non-leap years (including century 2100!)
  let leap = expand_all("FREQ=YEARLY;COUNT=4", dt(2020, 2, 29, 9, 0, 0), 100)
  assert_dts(
    leap,
    [
      dt(2020, 2, 29, 9, 0, 0),
      dt(2024, 2, 29, 9, 0, 0),
      dt(2028, 2, 29, 9, 0, 0),
      dt(2032, 2, 29, 9, 0, 0),
    ],
    "yearly Feb 29",
  )
  let leap_century = expand_all("FREQ=YEARLY;COUNT=2", dt(2096, 2, 29, 9, 0, 0), 100)
  assert_dts(
    leap_century,
    [dt(2096, 2, 29, 9, 0, 0), dt(2104, 2, 29, 9, 0, 0)],
    "yearly Feb 29 skips 2100",
  )
}

///|
test "rrule_subdaily_and_window_queries" {
  // HOURLY with BYHOUR
  let hr = expand_all("FREQ=HOURLY;BYHOUR=9,13,17;COUNT=5", dt(2025, 1, 1, 9, 30, 0), 100)
  assert_dts(
    hr,
    [
      dt(2025, 1, 1, 9, 30, 0),
      dt(2025, 1, 1, 13, 30, 0),
      dt(2025, 1, 1, 17, 30, 0),
      dt(2025, 1, 2, 9, 30, 0),
      dt(2025, 1, 2, 13, 30, 0),
    ],
    "hourly BYHOUR",
  )

  // MINUTELY INTERVAL=15
  let mn = expand_all("FREQ=MINUTELY;INTERVAL=15;COUNT=4", dt(2025, 1, 1, 10, 0, 0), 100)
  assert_dts(
    mn,
    [
      dt(2025, 1, 1, 10, 0, 0),
      dt(2025, 1, 1, 10, 15, 0),
      dt(2025, 1, 1, 10, 30, 0),
      dt(2025, 1, 1, 10, 45, 0),
    ],
    "minutely interval 15",
  )

  // SECONDLY INTERVAL=20
  let sc = expand_all("FREQ=SECONDLY;INTERVAL=20;COUNT=4", dt(2025, 1, 1, 10, 0, 0), 100)
  assert_dts(
    sc,
    [
      dt(2025, 1, 1, 10, 0, 0),
      dt(2025, 1, 1, 10, 0, 20),
      dt(2025, 1, 1, 10, 0, 40),
      dt(2025, 1, 1, 10, 1, 0),
    ],
    "secondly interval 20",
  )

  // between / after / before
  let rule = must_rrule("FREQ=DAILY;COUNT=10")
  let start = dt(2025, 1, 1, 9, 0, 0)
  let win_excl = match rule.between(start, dt(2025, 1, 3, 9, 0, 0), dt(2025, 1, 6, 9, 0, 0), false) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "between excl failed")
      []
    }
  }
  assert_dts(
    win_excl,
    [dt(2025, 1, 4, 9, 0, 0), dt(2025, 1, 5, 9, 0, 0)],
    "between exclusive",
  )

  let win_incl = match rule.between(start, dt(2025, 1, 3, 9, 0, 0), dt(2025, 1, 5, 9, 0, 0), true) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "between incl failed")
      []
    }
  }
  assert_dts(
    win_incl,
    [
      dt(2025, 1, 3, 9, 0, 0),
      dt(2025, 1, 4, 9, 0, 0),
      dt(2025, 1, 5, 9, 0, 0),
    ],
    "between inclusive",
  )

  match rule.after(start, dt(2025, 1, 3, 9, 0, 0), false) {
    Ok(Some(v)) => debug_assert(v.eq(dt(2025, 1, 4, 9, 0, 0)), "after exclusive")
    _ => debug_assert(false, "expected Some for after")
  }
  match rule.before(start, dt(2025, 1, 3, 9, 0, 0), false) {
    Ok(Some(v)) => debug_assert(v.eq(dt(2025, 1, 2, 9, 0, 0)), "before exclusive")
    _ => debug_assert(false, "expected Some for before")
  }
}

///|
test "rrule_validation_roundtrip_and_unsatisfiable_dos_guard" {
  // Format roundtrip
  let r = must_rrule("RRULE:FREQ=MONTHLY;INTERVAL=2;COUNT=5;BYDAY=1MO,-1FR;BYSETPOS=1;WKST=SU")
  let formatted = r.to_string()
  let r2 = must_rrule(formatted)
  debug_assert(r2.interval == 2, "roundtrip interval")
  debug_assert(r2.byday.length() == 2, "roundtrip byday")
  debug_assert(r2.bysetpos.length() == 1 && r2.bysetpos[0] == 1, "roundtrip bysetpos")

  // Validation rejects COUNT + UNTIL together, INTERVAL=0, missing FREQ, out-of-range BY*
  match RRule::parse("FREQ=DAILY;COUNT=5;UNTIL=20251231T000000Z") {
    Err(IcalError::InvalidRRule(_)) => ()
    _ => debug_assert(false, "COUNT + UNTIL must be rejected")
  }
  match RRule::parse("FREQ=DAILY;INTERVAL=0") {
    Err(IcalError::InvalidRRule(_)) => ()
    _ => debug_assert(false, "INTERVAL=0 must be rejected")
  }
  match RRule::parse("INTERVAL=2") {
    Err(IcalError::InvalidRRule(_)) => ()
    _ => debug_assert(false, "missing FREQ must be rejected")
  }
  match RRule::parse("FREQ=YEARLY;BYMONTH=13") {
    Err(IcalError::InvalidRRule(_)) => ()
    _ => debug_assert(false, "BYMONTH=13 must be rejected")
  }
  match RRule::parse("FREQ=MONTHLY;BYMONTHDAY=0") {
    Err(IcalError::InvalidRRule(_)) => ()
    _ => debug_assert(false, "BYMONTHDAY=0 must be rejected")
  }

  // Unsatisfiable RRULE (Feb 30) MUST terminate safely without hanging!
  let impossible = must_rrule("FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=30;COUNT=5")
  match impossible.all(dt(2025, 1, 1, 9, 0, 0), 10) {
    Ok(v) => debug_assert(v.length() == 0, "Feb 30 returns empty")
    Err(IcalError::LimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "unexpected error for Feb 30: " + ical_error_to_string(e))
  }
}
