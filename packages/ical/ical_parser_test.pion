///| RFC 5545 / RFC 6868 iCalendar parser, serializer, folding, escaping, and DoS limits tests.

import "time"

///|
fn assert_eq_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

///|
test "unfold_lines_rfc5545" {
  let raw = "DESCRIPTION:This is a lo\r\n ng description\r\n\tthat exists on a long line.\r\nSUMMARY:Hi\r\n"
  let unfolded = unfold_lines(raw)
  assert_eq_str(
    unfolded,
    "DESCRIPTION:This is a long descriptionthat exists on a long line.\r\nSUMMARY:Hi\r\n",
    "CRLF + SP/HTAB unfolding",
  )

  // LF-only folded input (real-world .ics files)
  let raw_lf = "SUMMARY:Hello \n World\n\t!\n"
  let unfolded_lf = unfold_lines(raw_lf)
  assert_eq_str(unfolded_lf, "SUMMARY:Hello World!\n", "LF + SP/HTAB unfolding")
}

///|
test "fold_line_75_octets_and_utf8_safety" {
  // Short line stays unchanged
  let short = "SUMMARY:Short title"
  assert_eq_str(fold_line(short), short, "short line unchanged")

  // Long ASCII line folds at 75 octets (continuation lines start with 1 space -> 74 payload bytes)
  let long_ascii = "DESCRIPTION:0123456789012345678901234567890123456789012345678901234567890123456789ABCDEF"
  let folded = fold_line(long_ascii)
  assert_eq_str(unfold_lines(folded), long_ascii, "ASCII fold/unfold roundtrip")
  // Verify every physical line is <= 75 bytes
  let mut line_bytes = 0
  let mut i = 0
  let n = folded.length()
  while i < n {
    let b = folded.code_unit_at(i)
    if b == 13 && i + 1 < n && folded.code_unit_at(i + 1) == 10 {
      debug_assert(line_bytes <= 75, "ASCII folded segment exceeds 75 octets: " + line_bytes.to_string())
      line_bytes = 0
      i = i + 2
    } else {
      line_bytes = line_bytes + 1
      i = i + 1
    }
  }
  debug_assert(line_bytes <= 75, "ASCII final segment exceeds 75 octets")

  // Multi-byte UTF-8 Chinese characters (3 bytes each) must NEVER be split mid-codepoint!
  let cjk = "SUMMARY:项目进度评审会议与全球跨时区架构对齐研讨会记录第一部分和第二部分以及第三部分"
  let folded_cjk = fold_line(cjk)
  assert_eq_str(unfold_lines(folded_cjk), cjk, "UTF-8 CJK fold/unfold roundtrip")
  // Check each physical line <= 75 bytes AND does not start/end with orphaned UTF-8 continuation byte (0x80..0xBF)
  let mut seg_start = 0
  let mut j = 0
  let m = folded_cjk.length()
  while j <= m {
    let is_end = j == m || (folded_cjk.code_unit_at(j) == 13 && j + 1 < m && folded_cjk.code_unit_at(j + 1) == 10)
    if is_end {
      let seg_len = j - seg_start
      debug_assert(seg_len <= 75, "UTF-8 folded segment exceeds 75 octets: " + seg_len.to_string())
      if seg_len > 0 {
        let first_b = folded_cjk.code_unit_at(seg_start)
        debug_assert((first_b & 0xC0) != 0x80, "UTF-8 fold split mid-codepoint at segment start")
      }
      if j == m {
        break
      }
      j = j + 2
      seg_start = j
    } else {
      j = j + 1
    }
  }
}

///|
test "text_and_rfc6868_param_escaping" {
  // RFC 5545 §3.3.11 TEXT escaping
  let raw = "Project XYZ, Phase 1; Notes:\nLine 2\\end"
  let esc = escape_text(raw)
  assert_eq_str(esc, "Project XYZ\\, Phase 1\\; Notes:\\nLine 2\\\\end", "escape_text")
  assert_eq_str(unescape_text(esc), raw, "unescape_text roundtrip")
  assert_eq_str(unescape_text("A\\NB\\nC"), "A\nB\nC", "unescape_text uppercase \\N")

  // RFC 6868 parameter value escaping
  let p_raw = "Alice \"Ace\" ^\nSmith"
  let p_esc = escape_param_value(p_raw)
  assert_eq_str(p_esc, "Alice ^'Ace^' ^^^nSmith", "RFC 6868 escape_param_value")
  assert_eq_str(unescape_param_value(p_esc), p_raw, "RFC 6868 unescape_param_value roundtrip")
  assert_eq_str(unescape_param_value("foo^xbar"), "foo^xbar", "RFC 6868 unknown ^x preserved")
}

///|
test "parse_property_line_params_and_quotes" {
  // Quoted param containing ':' and ';', multi-value param, case-insensitive normalization
  let line = "attendee;cn=\"Smith, John; Jr: Dept\";member=\"mailto:a@ex.com\",\"mailto:b@ex.com\";x-note=\"Line1^n^'Hi^'\":mailto:jsmith@example.com"
  let prop = match parse_property_line(line) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_property_line failed: " + ical_error_to_string(e))
      return
    }
  }
  assert_eq_str(prop.name, "ATTENDEE", "property name uppercased")
  assert_eq_str(prop.value, "mailto:jsmith@example.com", "property value")
  match prop.get_param_first("CN") {
    Some(cn) => assert_eq_str(cn, "Smith, John; Jr: Dept", "CN param value")
    None => debug_assert(false, "missing CN param")
  }
  match prop.get_param("MEMBER") {
    Some(vals) => {
      debug_assert(vals.length() == 2, "MEMBER should have 2 values")
      assert_eq_str(vals[0], "mailto:a@ex.com", "MEMBER[0]")
      assert_eq_str(vals[1], "mailto:b@ex.com", "MEMBER[1]")
    }
    None => debug_assert(false, "missing MEMBER param")
  }
  match prop.get_param_first("x-note") {
    Some(note) => assert_eq_str(note, "Line1\n\"Hi\"", "RFC 6868 param unescape")
    None => debug_assert(false, "missing X-NOTE param")
  }
}

///|
test "ical_datetime_parse_and_format" {
  // DATE
  match parse_ical_datetime("19970714", None) {
    Ok(v) =>
    match v {
      IcalDateTime::DateOnly(d) => {
        debug_assert(d.year == 1997 && d.month == 7 && d.day == 14, "DATE value")
        assert_eq_str(ical_datetime_to_value(v), "19970714", "DATE format")
      }
      _ => debug_assert(false, "expected DateOnly")
    }
    Err(_) => debug_assert(false, "expected Ok DateOnly")
  }
  // Floating DATE-TIME
  match parse_ical_datetime("19980118T230000", None) {
    Ok(v) =>
    match v {
      IcalDateTime::Floating(fdt) => {
        debug_assert(
          fdt.date.year == 1998 && fdt.date.month == 1 && fdt.date.day == 18 && fdt.time.hour == 23,
          "Floating DT",
        )
        assert_eq_str(ical_datetime_to_value(v), "19980118T230000", "Floating format")
      }
      _ => debug_assert(false, "expected Floating")
    }
    Err(_) => debug_assert(false, "expected Ok Floating")
  }
  // UTC DATE-TIME
  match parse_ical_datetime("19980119T070000Z", None) {
    Ok(v) =>
    match v {
      IcalDateTime::Utc(udt) => {
        debug_assert(udt.date.day == 19 && udt.time.hour == 7, "UTC DT")
        assert_eq_str(ical_datetime_to_value(v), "19980119T070000Z", "UTC format")
      }
      _ => debug_assert(false, "expected Utc")
    }
    Err(_) => debug_assert(false, "expected Ok Utc")
  }
  // Zoned DATE-TIME
  match parse_ical_datetime("19980119T020000", Some("America/New_York")) {
    Ok(v) =>
    match v {
      IcalDateTime::Zoned(zdt, tzid) => {
        debug_assert(zdt.time.hour == 2 && tzid == "America/New_York", "Zoned DT")
        assert_eq_str(ical_datetime_to_value(v), "19980119T020000", "Zoned format")
      }
      _ => debug_assert(false, "expected Zoned")
    }
    Err(_) => debug_assert(false, "expected Ok Zoned")
  }
  // Invalid date (non-leap Feb 29)
  match parse_ical_datetime("20230229T100000Z", None) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "2023-02-29 must fail")
  }
}

///|
test "calendar_full_parse_and_roundtrip" {
  let ics =
  "BEGIN:VCALENDAR\r\n" +
  "VERSION:2.0\r\n" +
  "PRODID:-//Pion//iCal Test//EN\r\n" +
  "BEGIN:VTIMEZONE\r\n" +
  "TZID:America/New_York\r\n" +
  "BEGIN:STANDARD\r\n" +
  "DTSTART:19701101T020000\r\n" +
  "RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU\r\n" +
  "TZOFFSETFROM:-0400\r\n" +
  "TZOFFSETTO:-0500\r\n" +
  "TZNAME:EST\r\n" +
  "END:STANDARD\r\n" +
  "BEGIN:DAYLIGHT\r\n" +
  "DTSTART:19700308T020000\r\n" +
  "RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU\r\n" +
  "TZOFFSETFROM:-0500\r\n" +
  "TZOFFSETTO:-0400\r\n" +
  "TZNAME:EDT\r\n" +
  "END:DAYLIGHT\r\n" +
  "END:VTIMEZONE\r\n" +
  "BEGIN:VEVENT\r\n" +
  "UID:evt-1@pion.dev\r\n" +
  "DTSTART;TZID=America/New_York:20260301T090000\r\n" +
  "SUMMARY:Weekly Sync\\, Team A\r\n" +
  "DESCRIPTION:Agenda:\\n1. Review\r\n" +
  "  metrics\\n2. Plan sprint\r\n" +
  "BEGIN:VALARM\r\n" +
  "ACTION:DISPLAY\r\n" +
  "TRIGGER:-PT15M\r\n" +
  "DESCRIPTION:Reminder\r\n" +
  "END:VALARM\r\n" +
  "END:VEVENT\r\n" +
  "BEGIN:VTODO\r\n" +
  "UID:todo-1@pion.dev\r\n" +
  "SUMMARY:Ship packages/ical\r\n" +
  "STATUS:IN-PROCESS\r\n" +
  "END:VTODO\r\n" +
  "BEGIN:VJOURNAL\r\n" +
  "UID:jrn-1@pion.dev\r\n" +
  "SUMMARY:Design Notes\r\n" +
  "END:VJOURNAL\r\n" +
  "END:VCALENDAR\r\n"

  let cal = match Calendar::parse(ics) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "Calendar::parse failed: " + ical_error_to_string(e))
      return
    }
  }
  debug_assert(cal.events().length() == 1, "1 VEVENT")
  debug_assert(cal.todos().length() == 1, "1 VTODO")
  debug_assert(cal.journals().length() == 1, "1 VJOURNAL")
  debug_assert(cal.timezones().length() == 1, "1 VTIMEZONE")

  let ev = cal.events()[0]
  debug_assert(ev.get_subcomponents("VALARM").length() == 1, "1 nested VALARM")
  match ev.get_property("SUMMARY") {
    Some(p) => assert_eq_str(unescape_text(p.value), "Weekly Sync, Team A", "SUMMARY unescaped")
    None => debug_assert(false, "missing SUMMARY")
  }
  match ev.get_property("DESCRIPTION") {
    Some(p) =>
    assert_eq_str(
      unescape_text(p.value),
      "Agenda:\n1. Review metrics\n2. Plan sprint",
      "DESCRIPTION unfolded + unescaped",
    )
    None => debug_assert(false, "missing DESCRIPTION")
  }

  // Roundtrip serialize -> re-parse
  let serialized = cal.to_ical()
  let cal2 = match Calendar::parse(serialized) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "roundtrip parse failed: " + ical_error_to_string(e))
      return
    }
  }
  debug_assert(cal2.events().length() == 1, "roundtrip 1 VEVENT")
  debug_assert(cal2.todos().length() == 1, "roundtrip 1 VTODO")
  debug_assert(cal2.journals().length() == 1, "roundtrip 1 VJOURNAL")
  debug_assert(cal2.timezones().length() == 1, "roundtrip 1 VTIMEZONE")
  debug_assert(cal2.events()[0].get_subcomponents("VALARM").length() == 1, "roundtrip 1 VALARM")
}

///|
test "parse_limits_dos_protection" {
  // Depth bomb
  let small_limits = ParseLimits::{
    max_depth: 3,
    max_lines: 100,
    max_components: 5,
    max_properties_per_component: 10,
    max_line_bytes: 128,
  }
  let deep =
  "BEGIN:VCALENDAR\r\n" +
  "BEGIN:VEVENT\r\n" +
  "BEGIN:VALARM\r\n" +
  "BEGIN:X-NESTED\r\n" +
  "END:X-NESTED\r\n" +
  "END:VALARM\r\n" +
  "END:VEVENT\r\n" +
  "END:VCALENDAR\r\n"
  match Calendar::parse_with_limits(deep, small_limits) {
    Err(IcalError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for depth bomb")
  }

  // Component count bomb
  let many_comps =
  "BEGIN:VCALENDAR\r\n" +
  "BEGIN:VEVENT\r\nEND:VEVENT\r\n" +
  "BEGIN:VEVENT\r\nEND:VEVENT\r\n" +
  "BEGIN:VEVENT\r\nEND:VEVENT\r\n" +
  "BEGIN:VEVENT\r\nEND:VEVENT\r\n" +
  "BEGIN:VEVENT\r\nEND:VEVENT\r\n" +
  "BEGIN:VEVENT\r\nEND:VEVENT\r\n" +
  "END:VCALENDAR\r\n"
  match Calendar::parse_with_limits(many_comps, small_limits) {
    Err(IcalError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for component bomb")
  }

  // Mismatched END
  let bad = "BEGIN:VCALENDAR\r\nBEGIN:VEVENT\r\nEND:VTODO\r\nEND:VCALENDAR\r\n"
  match Calendar::parse(bad) {
    Err(IcalError::InvalidSyntax(_)) => ()
    _ => debug_assert(false, "expected InvalidSyntax for mismatched END")
  }
}
