///| Pion Native head-to-head benchmark for packages/ical.
///| Modes: "ics_roundtrip" | "rrule_expand" | "rruleset_window"

import "ical"
import "time"

///|
fn mix(h : Int64, v : Int64) -> Int64 {
  let m = 1000000007L
  let r = ((h * 131L) + (v % m) + m) % m
  r
}

///|
fn hash_str(h0 : Int64, s : String) -> Int64 {
  let b = s.to_bytes()
  let n = b.length()
  let mut h = mix(h0, n.to_int64())
  let mut i = 0
  while i < n {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 1
  }
  h
}

///|
fn dt_key(dt : time::DateTime) -> Int64 {
  let ymd = (dt.date.year * 10000 + dt.date.month * 100 + dt.date.day).to_int64()
  let hms = (dt.time.hour * 10000 + dt.time.minute * 100 + dt.time.second).to_int64()
  ymd * 1000000L + hms
}

///|
fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 10 {
      let mut end = i
      if end > start && s.code_unit_at(end - 1) == 13 {
        end = end - 1
      }
      if end > start {
        let sb = StringBuilder::new()
        let mut k = start
        while k < end {
          sb.write_byte(s.code_unit_at(k).to_byte())
          k = k + 1
        }
        out.push(sb.to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    let sb = StringBuilder::new()
    let mut k = start
    while k < n {
      sb.write_byte(s.code_unit_at(k).to_byte())
      k = k + 1
    }
    out.push(sb.to_string())
  }
  out
}

///|
fn split_char(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || s.code_unit_at(i) == sep {
      let sb = StringBuilder::new()
      let mut k = start
      while k < i {
        sb.write_byte(s.code_unit_at(k).to_byte())
        k = k + 1
      }
      out.push(sb.to_string())
      start = i + 1
    }
    i = i + 1
  }
  out
}

///|
fn parse_int_simple(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///|
fn bench_ics_roundtrip(world : World, raw : String) -> Int {
  let cal = match ical::Calendar::parse(raw) {
    Ok(c) => c
    Err(_) => return 1
  }
  let serialized = cal.to_ical()
  let cal2 = match ical::Calendar::parse(serialized) {
    Ok(c) => c
    Err(_) => return 2
  }
  let events = cal2.events()
  let mut checksum = 0L
  let mut i = 0
  while i < events.length() {
    let ev = events[i]
    match ev.get_property("UID") {
      Some(p) => checksum = hash_str(checksum, p.value)
      None => ()
    }
    match ev.get_property("DTSTART") {
      Some(p) => checksum = hash_str(checksum, p.value)
      None => ()
    }
    match ev.get_property("SUMMARY") {
      Some(p) => checksum = hash_str(checksum, ical::unescape_text(p.value))
      None => ()
    }
    match ev.get_property("DESCRIPTION") {
      Some(p) => checksum = hash_str(checksum, ical::unescape_text(p.value))
      None => ()
    }
    match ev.get_property("LOCATION") {
      Some(p) => checksum = hash_str(checksum, ical::unescape_text(p.value))
      None => ()
    }
    i = i + 1
  }
  io_println(world, "events=" + events.length().to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_rrule_expand(world : World, raw : String) -> Int {
  let lines = split_lines(raw)
  let mut total = 0L
  let mut checksum = 0L
  let mut i = 0
  while i < lines.length() {
    let parts = split_char(lines[i], 124) // '|'
    if parts.length() < 3 {
      i = i + 1
      continue
    }
    let dtstart = match ical::parse_ical_datetime(parts[0], None) {
      Ok(idt) => ical::ical_datetime_to_datetime(idt)
      Err(_) => return 1
    }
    let rule = match ical::RRule::parse(parts[1]) {
      Ok(r) => r
      Err(_) => return 2
    }
    let limit = parse_int_simple(parts[2])
    let occs = match rule.all(dtstart, limit) {
      Ok(v) => v
      Err(_) => return 3
    }
    total = total + occs.length().to_int64()
    let mut j = 0
    while j < occs.length() {
      checksum = mix(checksum, dt_key(occs[j]))
      j = j + 1
    }
    i = i + 1
  }
  io_println(world, "occurrences=" + total.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_rruleset_window(world : World, raw : String) -> Int {
  let lines = split_lines(raw)
  let mut total = 0L
  let mut checksum = 0L
  let mut i = 0
  while i < lines.length() {
    let parts = split_char(lines[i], 124)
    if parts.length() < 7 {
      i = i + 1
      continue
    }
    let dtstart = match ical::parse_ical_datetime(parts[0], None) {
      Ok(idt) => ical::ical_datetime_to_datetime(idt)
      Err(_) => return 1
    }
    let set = ical::RRuleSet::new(dtstart)
    match ical::RRule::parse(parts[1]) {
      Ok(r) => set.add_rrule(r)
      Err(_) => return 2
    }
    match ical::RRule::parse(parts[2]) {
      Ok(r) => set.add_rrule(r)
      Err(_) => return 3
    }
    let rds = split_char(parts[3], 44)
    let mut k = 0
    while k < rds.length() {
      match ical::parse_ical_datetime(rds[k], None) {
        Ok(idt) => set.add_rdate(ical::ical_datetime_to_datetime(idt))
        Err(_) => return 4
      }
      k = k + 1
    }
    let exs = split_char(parts[4], 44)
    let mut m = 0
    while m < exs.length() {
      match ical::parse_ical_datetime(exs[m], None) {
        Ok(idt) => set.add_exdate(ical::ical_datetime_to_datetime(idt))
        Err(_) => return 5
      }
      m = m + 1
    }
    let win_start_dt = match ical::parse_ical_datetime(parts[5], None) {
      Ok(idt) => ical::ical_datetime_to_datetime(idt)
      Err(_) => return 6
    }
    let win_end_dt = match ical::parse_ical_datetime(parts[6], None) {
      Ok(idt) => ical::ical_datetime_to_datetime(idt)
      Err(_) => return 7
    }
    let after_ts = match time::Offset::utc().to_timestamp(win_start_dt) {
      Ok(t) => t
      Err(_) => return 8
    }
    let before_ts = match time::Offset::utc().to_timestamp(win_end_dt) {
      Ok(t) => t
      Err(_) => return 9
    }
    let occs = match set.between(after_ts, before_ts, true) {
      Ok(v) => v
      Err(_) => return 10
    }
    total = total + occs.length().to_int64()
    let mut j = 0
    while j < occs.length() {
      checksum = mix(checksum, occs[j].timestamp.as_second())
      j = j + 1
    }
    i = i + 1
  }
  io_println(world, "occurrences=" + total.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_ical_bench <mode> <corpus_path>")
    return 1
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  if mode == "ics_roundtrip" {
    bench_ics_roundtrip(world, data)
  } else if mode == "rrule_expand" {
    bench_rrule_expand(world, data)
  } else if mode == "rruleset_window" {
    bench_rruleset_window(world, data)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
