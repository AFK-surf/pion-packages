///| Native + Wasm32 4-mode smoke entry for `packages/ical`.

import "ical"
import "time"

///|
pub fn main(world : World) -> Int {
  // 1. Parse + fold/unfold + RFC 6868 + VTIMEZONE + roundtrip
  let sample_ics =
  "BEGIN:VCALENDAR\r\n" +
  "VERSION:2.0\r\n" +
  "PRODID:-//Pion//iCal Smoke//EN\r\n" +
  "BEGIN:VTIMEZONE\r\n" +
  "TZID:America/New_York\r\n" +
  "BEGIN:STANDARD\r\n" +
  "DTSTART:19701101T020000\r\n" +
  "RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU\r\n" +
  "TZOFFSETFROM:-0400\r\n" +
  "TZOFFSETTO:-0500\r\n" +
  "END:STANDARD\r\n" +
  "BEGIN:DAYLIGHT\r\n" +
  "DTSTART:19700308T020000\r\n" +
  "RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU\r\n" +
  "TZOFFSETFROM:-0500\r\n" +
  "TZOFFSETTO:-0400\r\n" +
  "END:DAYLIGHT\r\n" +
  "END:VTIMEZONE\r\n" +
  "BEGIN:VEVENT\r\n" +
  "UID:smoke-1@pion.dev\r\n" +
  "DTSTART:20240309T023000\r\n" +
  "RRULE:FREQ=DAILY;COUNT=4\r\n" +
  "EXDATE:20240311T023000\r\n" +
  "RDATE:20240315T023000\r\n" +
  "SUMMARY;X-TAG=\"A^'B^^C\":会议日程\\, 架构同步与跨时区\r\n" +
  " 评审记录\r\n" +
  "END:VEVENT\r\n" +
  "END:VCALENDAR\r\n"

  let cal = match ical::Calendar::parse(sample_ics) {
    Ok(c) => c
    Err(_) => return 1
  }
  let serialized = cal.to_ical()
  let cal2 = match ical::Calendar::parse(serialized) {
    Ok(c) => c
    Err(_) => return 2
  }
  if cal2.events().length() != 1 || cal2.timezones().length() != 1 {
    return 3
  }
  let ev = cal2.events()[0]
  let summary_prop = match ev.get_property("SUMMARY") {
    Some(p) => p
    None => return 4
  }
  let tag = match summary_prop.get_param_first("X-TAG") {
    Some(t) => t
    None => return 5
  }
  let summary_text = ical::unescape_text(summary_prop.value)

  // 2. VTIMEZONE offset resolution
  let vtz = match ical::VTimeZone::from_component(cal2.timezones()[0]) {
    Ok(v) => v
    Err(_) => return 6
  }
  let jan_dt = match time::DateTime::new(2025, 1, 15, 12, 0, 0, 0) {
    Ok(d) => d
    Err(_) => return 7
  }
  let jul_dt = match time::DateTime::new(2025, 7, 15, 12, 0, 0, 0) {
    Ok(d) => d
    Err(_) => return 8
  }
  let jan_off = match vtz.offset_at(jan_dt) {
    Some(o) => o.seconds
    None => return 9
  }
  let jul_off = match vtz.offset_at(jul_dt) {
    Some(o) => o.seconds
    None => return 10
  }

  // 3. Complex RRULE expansion (BYSETPOS + BYDAY + WKST)
  let rrule = match ical::RRule::parse("FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-2;COUNT=5") {
    Ok(r) => r
    Err(_) => return 11
  }
  let start = match time::DateTime::new(1997, 9, 29, 9, 0, 0, 0) {
    Ok(d) => d
    Err(_) => return 12
  }
  let occs = match rrule.all(start, 10) {
    Ok(v) => v
    Err(_) => return 13
  }
  if occs.length() != 5 {
    return 14
  }

  // 4. RRuleSet with POSIX TimeZone DST spring-forward gap
  let ny = match time::TimeZone::posix("EST5EDT,M3.2.0,M11.1.0") {
    Ok(z) => z
    Err(_) => return 15
  }
  let rset = match ical::RRuleSet::from_component(ev, ny) {
    Ok(s) => s
    Err(_) => return 16
  }
  let zoned_occs = match rset.all(10) {
    Ok(v) => v
    Err(_) => return 17
  }
  if zoned_occs.length() != 4 {
    return 18
  }

  // 5. Unsatisfiable RRULE DoS protection (Feb 30)
  let bad_rule = match ical::RRule::parse("FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=30;COUNT=5") {
    Ok(r) => r
    Err(_) => return 19
  }
  let bad_res = match bad_rule.all(start, 10) {
    Ok(v) => v
    Err(_) => return 20
  }
  if bad_res.length() != 0 {
    return 21
  }

  io_println(world, "ical_wasm_smoke=ok")
  io_println(world, "tag=" + tag)
  io_println(world, "summary=" + summary_text)
  io_println(world, "vtz_offsets=" + jan_off.to_string() + "," + jul_off.to_string())
  io_println(world, "bysetpos_last=" + occs[4].to_string())
  io_println(world, "dst_gap=" + zoned_occs[1].to_string())
  io_println(world, "rset_last=" + zoned_occs[3].to_string())
  0
}
