///| RRuleSet (multi-RRULE, RDATE, EXDATE, EXRULE, TimeZone DST gap/fold) and VTIMEZONE tests.

import "time"

///|
fn make_dt(y : Int, mo : Int, d : Int, h : Int, mi : Int, s : Int) -> time::DateTime {
  match time::DateTime::new(y, mo, d, h, mi, s, 0) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "invalid DateTime")
      time::DateTime::min()
    }
  }
}

///|
fn make_rule(s : String) -> RRule {
  match RRule::parse(s) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "invalid RRule: " + ical_error_to_string(e))
      RRule::{
        freq: Freq::Daily,
        interval: 1,
        count: Some(0),
        until: None,
        until_is_utc: false,
        wkst: time::Weekday::Mon,
        bysetpos: [],
        bymonth: [],
        bymonthday: [],
        byyearday: [],
        byweekno: [],
        byday: [],
        byhour: [],
        byminute: [],
        bysecond: [],
        rscale: None,
        skip: None,
      }
    }
  }
}

///|
test "rruleset_multi_rrule_rdate_exdate_exrule" {
  let set = RRuleSet::new(make_dt(2025, 1, 1, 9, 0, 0))
  // Rule 1: Jan 1, 3, 5, 7
  set.add_rrule(make_rule("FREQ=DAILY;INTERVAL=2;COUNT=4"))
  // Rule 2: Jan 1, 4, 7 (Jan 1 and Jan 7 duplicate -> deduplicated!)
  set.add_rrule(make_rule("FREQ=DAILY;INTERVAL=3;COUNT=3"))
  // RDATE: Jan 2 and Jan 4 (duplicate)
  set.add_rdate(make_dt(2025, 1, 2, 9, 0, 0))
  set.add_rdate(make_dt(2025, 1, 4, 9, 0, 0))
  // EXDATE: exclude Jan 3
  set.add_exdate(make_dt(2025, 1, 3, 9, 0, 0))
  // EXRULE: exclude Jan 1, 5 (every 4 days starting Jan 1)
  set.add_exrule(make_rule("FREQ=DAILY;INTERVAL=4;COUNT=2"))

  // Expected remaining: Jan 2, Jan 4, Jan 7
  let occs = match set.all(50) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "RRuleSet::all failed: " + ical_error_to_string(e))
      []
    }
  }
  debug_assert(occs.length() == 3, "expected 3 occurrences after dedup+exdate+exrule, got " + occs.length().to_string())
  debug_assert(occs[0].datetime.eq(make_dt(2025, 1, 2, 9, 0, 0)), "occ[0] Jan 2")
  debug_assert(occs[1].datetime.eq(make_dt(2025, 1, 4, 9, 0, 0)), "occ[1] Jan 4")
  debug_assert(occs[2].datetime.eq(make_dt(2025, 1, 7, 9, 0, 0)), "occ[2] Jan 7")

  // Window query between Jan 2 and Jan 6 inclusive -> Jan 2, Jan 4
  let after_ts = occs[0].timestamp
  let before_ts = match time::Offset::utc().to_timestamp(make_dt(2025, 1, 6, 0, 0, 0)) {
    Ok(t) => t
    Err(_) => time::Timestamp::unix_epoch()
  }
  let win = match set.between(after_ts, before_ts, true) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "RRuleSet::between failed")
      []
    }
  }
  debug_assert(win.length() == 2, "window count == 2")
  debug_assert(win[0].datetime.eq(make_dt(2025, 1, 2, 9, 0, 0)), "win[0]")
  debug_assert(win[1].datetime.eq(make_dt(2025, 1, 4, 9, 0, 0)), "win[1]")
}

///|
test "rruleset_dst_spring_forward_gap_and_fall_back_fold" {
  // America/New_York POSIX rule: EST5EDT,M3.2.0,M11.1.0
  // 2024 spring forward: 2024-03-10 02:00 EST -> 03:00 EDT (-05:00 -> -04:00)
  // 2024 fall back:      2024-11-03 02:00 EDT -> 01:00 EST (-04:00 -> -05:00)
  let ny = match time::TimeZone::posix("EST5EDT,M3.2.0,M11.1.0") {
    Ok(z) => z
    Err(_) => {
      debug_assert(false, "POSIX TZ parse failed")
      time::TimeZone::utc()
    }
  }

  // 1. Daily at 02:30 across spring-forward gap (2024-03-09, 2024-03-10, 2024-03-11)
  let gap_set = RRuleSet::with_tz(make_dt(2024, 3, 9, 2, 30, 0), ny)
  gap_set.add_rrule(make_rule("FREQ=DAILY;COUNT=3"))
  let gap_occs = match gap_set.all(10) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "gap RRuleSet failed: " + ical_error_to_string(e))
      []
    }
  }
  debug_assert(gap_occs.length() == 3, "3 gap occurrences")
  // Mar 9 02:30 EST (-18000)
  debug_assert(gap_occs[0].datetime.eq(make_dt(2024, 3, 9, 2, 30, 0)), "Mar 9 02:30")
  debug_assert(gap_occs[0].offset.seconds == -18000, "Mar 9 EST -05:00")
  // Mar 10 02:30 does not exist -> Compatible shifts forward 1h to 03:30 EDT (-14400)
  debug_assert(gap_occs[1].datetime.eq(make_dt(2024, 3, 10, 3, 30, 0)), "Mar 10 gap -> 03:30 EDT")
  debug_assert(gap_occs[1].offset.seconds == -14400, "Mar 10 EDT -04:00")
  // Mar 11 02:30 EDT (-14400)
  debug_assert(gap_occs[2].datetime.eq(make_dt(2024, 3, 11, 2, 30, 0)), "Mar 11 02:30")
  debug_assert(gap_occs[2].offset.seconds == -14400, "Mar 11 EDT -04:00")

  // 2. Daily at 01:30 across fall-back fold (2024-11-02, 2024-11-03, 2024-11-04)
  let fold_set = RRuleSet::with_tz(make_dt(2024, 11, 2, 1, 30, 0), ny)
  fold_set.add_rrule(make_rule("FREQ=DAILY;COUNT=3"))
  let fold_occs = match fold_set.all(10) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "fold RRuleSet failed: " + ical_error_to_string(e))
      []
    }
  }
  debug_assert(fold_occs.length() == 3, "3 fold occurrences")
  // Nov 2 01:30 EDT (-14400)
  debug_assert(fold_occs[0].offset.seconds == -14400, "Nov 2 EDT")
  // Nov 3 01:30 occurs twice -> RFC 5545 / Compatible picks first (earlier) occurrence EDT (-14400)
  debug_assert(fold_occs[1].datetime.eq(make_dt(2024, 11, 3, 1, 30, 0)), "Nov 3 01:30")
  debug_assert(fold_occs[1].offset.seconds == -14400, "Nov 3 fold picks earlier EDT -04:00")
  // Nov 4 01:30 EST (-18000)
  debug_assert(fold_occs[2].offset.seconds == -18000, "Nov 4 EST")
}

///|
test "rruleset_from_vevent_and_vtimezone_resolution" {
  let ics =
  "BEGIN:VCALENDAR\r\n" +
  "VERSION:2.0\r\n" +
  "PRODID:-//Pion//Test//EN\r\n" +
  "BEGIN:VTIMEZONE\r\n" +
  "TZID:America/New_York\r\n" +
  "BEGIN:STANDARD\r\n" +
  "DTSTART:19701101T020000\r\n" +
  "RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU\r\n" +
  "TZOFFSETFROM:-0400\r\n" +
  "TZOFFSETTO:-0500\r\n" +
  "TZNAME:EST\r\n" +
  "END:STANDARD\r\n" +
  "BEGIN:DAYLIGHT\r\n" +
  "DTSTART:19700308T020000\r\n" +
  "RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU\r\n" +
  "TZOFFSETFROM:-0500\r\n" +
  "TZOFFSETTO:-0400\r\n" +
  "TZNAME:EDT\r\n" +
  "END:DAYLIGHT\r\n" +
  "END:VTIMEZONE\r\n" +
  "BEGIN:VEVENT\r\n" +
  "UID:standup@pion.dev\r\n" +
  "DTSTART:20250106T090000Z\r\n" +
  "RRULE:FREQ=WEEKLY;BYDAY=MO,WE,FR;COUNT=5\r\n" +
  "EXDATE:20250108T090000Z\r\n" +
  "RDATE:20250109T090000Z\r\n" +
  "END:VEVENT\r\n" +
  "END:VCALENDAR\r\n"

  let cal = match Calendar::parse(ics) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "parse failed: " + ical_error_to_string(e))
      return
    }
  }

  // VTIMEZONE resolution
  let vtz = match VTimeZone::from_component(cal.timezones()[0]) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "VTimeZone::from_component failed: " + ical_error_to_string(e))
      return
    }
  }
  debug_assert(vtz.tzid == "America/New_York", "VTIMEZONE TZID")
  match vtz.offset_at(make_dt(2025, 1, 15, 12, 0, 0)) {
    Some(off) => debug_assert(off.seconds == -18000, "Jan is EST (-05:00)")
    None => debug_assert(false, "expected offset in Jan")
  }
  match vtz.offset_at(make_dt(2025, 7, 15, 12, 0, 0)) {
    Some(off) => debug_assert(off.seconds == -14400, "Jul is EDT (-04:00)")
    None => debug_assert(false, "expected offset in Jul")
  }

  // VEVENT -> RRuleSet
  let rset = match RRuleSet::from_component(cal.events()[0], time::TimeZone::utc()) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "RRuleSet::from_component failed: " + ical_error_to_string(e))
      return
    }
  }
  let occs = match rset.all(20) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "rset.all failed")
      []
    }
  }
  // MO Jan 6, [WE Jan 8 excluded], TH Jan 9 (RDATE), FR Jan 10, MO Jan 13, WE Jan 15 -> 5 occurrences
  debug_assert(occs.length() == 5, "expected 5 occurrences from VEVENT")
  debug_assert(occs[0].datetime.eq(make_dt(2025, 1, 6, 9, 0, 0)), "Jan 6")
  debug_assert(occs[1].datetime.eq(make_dt(2025, 1, 9, 9, 0, 0)), "Jan 9 RDATE")
  debug_assert(occs[2].datetime.eq(make_dt(2025, 1, 10, 9, 0, 0)), "Jan 10")
  debug_assert(occs[3].datetime.eq(make_dt(2025, 1, 13, 9, 0, 0)), "Jan 13")
  debug_assert(occs[4].datetime.eq(make_dt(2025, 1, 15, 9, 0, 0)), "Jan 15")
}

///|
test "parse_utc_offset_formats" {
  match parse_utc_offset("-0500") {
    Ok(o) => debug_assert(o.seconds == -18000, "-0500")
    Err(_) => debug_assert(false, "-0500 failed")
  }
  match parse_utc_offset("+0530") {
    Ok(o) => debug_assert(o.seconds == 19800, "+0530")
    Err(_) => debug_assert(false, "+0530 failed")
  }
  match parse_utc_offset("+010203") {
    Ok(o) => debug_assert(o.seconds == 3723, "+010203")
    Err(_) => debug_assert(false, "+010203 failed")
  }
  match parse_utc_offset("0500") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "missing sign must fail")
  }
}
