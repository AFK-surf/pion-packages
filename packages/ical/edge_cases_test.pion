///| Additional RFC 5545 / RFC 6868 / RFC 7529 edge-case and security tests.

import "time"

///|
fn edt(y : Int, mo : Int, d : Int, h : Int, mi : Int, s : Int) -> time::DateTime {
  match time::DateTime::new(y, mo, d, h, mi, s, 0) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "invalid DateTime")
      time::DateTime::min()
    }
  }
}

///|
fn erule(s : String) -> RRule {
  match RRule::parse(s) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "RRule::parse failed: " + ical_error_to_string(e))
      RRule::{
        freq: Freq::Daily,
        interval: 1,
        count: Some(0),
        until: None,
        until_is_utc: false,
        wkst: time::Weekday::Mon,
        bysetpos: [],
        bymonth: [],
        bymonthday: [],
        byyearday: [],
        byweekno: [],
        byday: [],
        byhour: [],
        byminute: [],
        bysecond: [],
        rscale: None,
        skip: None,
      }
    }
  }
}

///|
test "edge_byweekno_53_and_negative_byyearday_366" {
  // 2020 has 53 ISO weeks (week 53 Mon is 2020-12-28); 2021..2025 have 52 weeks; 2026 has 53 weeks (2026-12-28)
  let r53 = erule("FREQ=YEARLY;BYWEEKNO=53;BYDAY=MO;COUNT=2")
  let w53 = match r53.all(edt(2020, 1, 1, 9, 0, 0), 10) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "BYWEEKNO=53 failed")
      []
    }
  }
  debug_assert(w53.length() == 2, "BYWEEKNO=53 count=2")
  debug_assert(w53[0].eq(edt(2020, 12, 28, 9, 0, 0)), "2020-W53-1 == 2020-12-28")
  debug_assert(w53[1].eq(edt(2026, 12, 28, 9, 0, 0)), "2026-W53-1 == 2026-12-28")

  // BYYEARDAY=-366 only matches Jan 1 of leap years!
  let r366 = erule("FREQ=YEARLY;BYYEARDAY=-366;COUNT=3")
  let y366 = match r366.all(edt(2020, 1, 1, 9, 0, 0), 10) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "BYYEARDAY=-366 failed")
      []
    }
  }
  debug_assert(y366.length() == 3, "BYYEARDAY=-366 count=3")
  debug_assert(y366[0].eq(edt(2020, 1, 1, 9, 0, 0)), "2020 leap")
  debug_assert(y366[1].eq(edt(2024, 1, 1, 9, 0, 0)), "2024 leap")
  debug_assert(y366[2].eq(edt(2028, 1, 1, 9, 0, 0)), "2028 leap")
}

///|
test "edge_5th_monday_and_monthly_interval_18" {
  // 5th Monday of the month in 2025: Mar 31, Jun 30, Sep 29, Dec 29
  let r5mo = erule("FREQ=MONTHLY;BYDAY=5MO;COUNT=4")
  let m5 = match r5mo.all(edt(2025, 1, 1, 9, 0, 0), 10) {
    Ok(v) => v
    Err(_) => []
  }
  debug_assert(m5.length() == 4, "4 fifth Mondays in 2025")
  debug_assert(m5[0].eq(edt(2025, 3, 31, 9, 0, 0)), "2025-03-31")
  debug_assert(m5[1].eq(edt(2025, 6, 30, 9, 0, 0)), "2025-06-30")
  debug_assert(m5[2].eq(edt(2025, 9, 29, 9, 0, 0)), "2025-09-29")
  debug_assert(m5[3].eq(edt(2025, 12, 29, 9, 0, 0)), "2025-12-29")

  // RFC 5545: Every 18 months on 10th..15th for 10 occurrences
  let r18 = erule("FREQ=MONTHLY;INTERVAL=18;COUNT=10;BYMONTHDAY=10,11,12,13,14,15")
  let o18 = match r18.all(edt(1997, 9, 10, 9, 0, 0), 20) {
    Ok(v) => v
    Err(_) => []
  }
  debug_assert(o18.length() == 10, "interval 18 count=10")
  debug_assert(o18[0].eq(edt(1997, 9, 10, 9, 0, 0)), "1997-09-10")
  debug_assert(o18[5].eq(edt(1997, 9, 15, 9, 0, 0)), "1997-09-15")
  debug_assert(o18[6].eq(edt(1999, 3, 10, 9, 0, 0)), "1999-03-10")
  debug_assert(o18[9].eq(edt(1999, 3, 13, 9, 0, 0)), "1999-03-13")
}

///|
test "edge_daily_bysetpos_with_timeset_and_unsatisfiable" {
  // DAILY with BYHOUR=8,12,18;BYMINUTE=0,30;BYSETPOS=1,-1 -> 08:00 and 18:30 each day
  let r = erule("FREQ=DAILY;BYHOUR=8,12,18;BYMINUTE=0,30;BYSETPOS=1,-1;COUNT=4")
  let occs = match r.all(edt(2025, 1, 1, 0, 0, 0), 10) {
    Ok(v) => v
    Err(_) => []
  }
  debug_assert(occs.length() == 4, "4 occurrences")
  debug_assert(occs[0].eq(edt(2025, 1, 1, 8, 0, 0)), "day1 first")
  debug_assert(occs[1].eq(edt(2025, 1, 1, 18, 30, 0)), "day1 last")
  debug_assert(occs[2].eq(edt(2025, 1, 2, 8, 0, 0)), "day2 first")
  debug_assert(occs[3].eq(edt(2025, 1, 2, 18, 30, 0)), "day2 last")

  // Unsatisfiable April 31 and Feb 31 terminate cleanly
  let r_apr31 = erule("FREQ=YEARLY;BYMONTH=4;BYMONTHDAY=31;COUNT=3")
  match r_apr31.all(edt(2025, 1, 1, 9, 0, 0), 10) {
    Ok(v) => debug_assert(v.length() == 0, "Apr 31 empty")
    Err(_) => debug_assert(false, "Apr 31 should return empty")
  }
  let r_feb31 = erule("FREQ=MONTHLY;BYMONTH=2;BYMONTHDAY=31;COUNT=3")
  match r_feb31.all(edt(2025, 1, 1, 9, 0, 0), 10) {
    Ok(v) => debug_assert(v.length() == 0, "Feb 31 empty")
    Err(_) => debug_assert(false, "Feb 31 should return empty")
  }
}

///|
test "edge_utf8_4byte_emoji_fold_and_bom_parse" {
  // 4-byte UTF-8 emojis repeated past 75 bytes must never be split mid-codepoint
  let line = "SUMMARY:🎉🚀🎉🚀🎉🚀🎉🚀🎉🚀🎉🚀🎉🚀🎉🚀🎉🚀🎉🚀🎉🚀🎉🚀"
  let folded = fold_line(line)
  debug_assert(unfold_lines(folded) == line, "4-byte emoji fold/unfold roundtrip")
  let mut i = 0
  let n = folded.length()
  let mut seg_len = 0
  while i < n {
    if folded.code_unit_at(i) == 13 && i + 1 < n && folded.code_unit_at(i + 1) == 10 {
      debug_assert(seg_len <= 75, "emoji segment <= 75 bytes")
      if i + 3 < n {
        let b = folded.code_unit_at(i + 3)
        debug_assert((b & 0xC0) != 0x80, "no continuation byte after fold space")
      }
      seg_len = 0
      i = i + 2
    } else {
      seg_len = seg_len + 1
      i = i + 1
    }
  }
  debug_assert(seg_len <= 75, "final emoji segment <= 75 bytes")

  // UTF-8 BOM + lowercase component names + comma-separated EXDATE
  let bom_ics = "\u{FEFF}begin:vcalendar\r\nversion:2.0\r\nbegin:vevent\r\ndtstart:20250101T090000Z\r\nrrule:FREQ=DAILY;COUNT=4\r\nexdate:20250102T090000Z,20250103T090000Z\r\nend:vevent\r\nend:vcalendar\r\n"
  let cal = match Calendar::parse(bom_ics) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "BOM parse failed: " + ical_error_to_string(e))
      return
    }
  }
  let rset = match RRuleSet::from_component(cal.events()[0], time::TimeZone::utc()) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "RRuleSet::from_component failed: " + ical_error_to_string(e))
      return
    }
  }
  let occs = match rset.all(10) {
    Ok(v) => v
    Err(_) => []
  }
  debug_assert(occs.length() == 2, "2 occurrences after 2 CSV EXDATEs")
  debug_assert(occs[0].datetime.eq(edt(2025, 1, 1, 9, 0, 0)), "Jan 1")
  debug_assert(occs[1].datetime.eq(edt(2025, 1, 4, 9, 0, 0)), "Jan 4")

  // RRuleSet::after and RRuleSet::before
  let ts2 = match time::Offset::utc().to_timestamp(edt(2025, 1, 2, 0, 0, 0)) {
    Ok(t) => t
    Err(_) => time::Timestamp::unix_epoch()
  }
  match rset.after(ts2, true) {
    Ok(Some(z)) => debug_assert(z.datetime.eq(edt(2025, 1, 4, 9, 0, 0)), "rset.after -> Jan 4")
    _ => debug_assert(false, "rset.after failed")
  }
  match rset.before(ts2, true) {
    Ok(Some(z)) => debug_assert(z.datetime.eq(edt(2025, 1, 1, 9, 0, 0)), "rset.before -> Jan 1")
    _ => debug_assert(false, "rset.before failed")
  }
}
