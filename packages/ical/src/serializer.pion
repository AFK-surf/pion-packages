///| RFC 5545 canonical serializer with 75-octet UTF-8-safe folding and RFC 6868 parameter escaping.

///| Escape RFC 5545 §3.3.11 TEXT value.
pub fn escape_text(s : String) -> String {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 || b == 59 || b == 44 || b == 10 || b == 13 {
      break
    }
    i = i + 1
  }
  if i >= n {
    return s
  }
  let sb = StringBuilder::with_capacity(n + 8)
  let mut chunk_start = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 || b == 59 || b == 44 {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      sb.write_byte((92).to_byte())
      sb.write_byte(b.to_byte())
      i = i + 1
      chunk_start = i
    } else if b == 10 {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      sb.write_byte((92).to_byte())
      sb.write_byte((110).to_byte())
      i = i + 1
      chunk_start = i
    } else if b == 13 {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      if i + 1 < n && s.code_unit_at(i + 1) == 10 {
        i = i + 1
      }
      sb.write_byte((92).to_byte())
      sb.write_byte((110).to_byte())
      i = i + 1
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if chunk_start < n {
    sb.write_substring(s, chunk_start, n)
  }
  sb.to_string()
}

///| Escape RFC 6868 parameter value (`^` -> `^^`, `\n` -> `^n`, `"` -> `^'`).
pub fn escape_param_value(s : String) -> String {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 94 || b == 10 || b == 13 || b == 34 {
      break
    }
    i = i + 1
  }
  if i >= n {
    return s
  }
  let sb = StringBuilder::with_capacity(n + 8)
  let mut chunk_start = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 94 {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      sb.write_byte((94).to_byte())
      sb.write_byte((94).to_byte())
      i = i + 1
      chunk_start = i
    } else if b == 10 {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      sb.write_byte((94).to_byte())
      sb.write_byte((110).to_byte())
      i = i + 1
      chunk_start = i
    } else if b == 13 {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      if i + 1 < n && s.code_unit_at(i + 1) == 10 {
        i = i + 1
      }
      sb.write_byte((94).to_byte())
      sb.write_byte((110).to_byte())
      i = i + 1
      chunk_start = i
    } else if b == 34 {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      sb.write_byte((94).to_byte())
      sb.write_byte((39).to_byte())
      i = i + 1
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if chunk_start < n {
    sb.write_substring(s, chunk_start, n)
  }
  sb.to_string()
}

///| Fold a single content line into `sb` at <= 75 UTF-8 octets per physical line without splitting codepoints.
fn write_folded_line_to(sb : StringBuilder, line : String) -> Unit {
  let n = line.length()
  if n <= 75 {
    sb.write_string(line)
    return
  }
  let mut pos = 0
  let mut first = true
  while pos < n {
    let max_chunk = if first { 75 } else { 74 }
    if !first {
      sb.write_string("\r\n ")
    }
    let mut end = pos + max_chunk
    if end >= n {
      end = n
    } else {
      // Back up if `end` lands on a UTF-8 continuation byte (10xxxxxx)
      while end > pos && (line.code_unit_at(end) & 0xC0) == 0x80 {
        end = end - 1
      }
      if end == pos {
        // Pathological single sequence > max_chunk; advance at least one byte
        end = pos + 1
      }
    }
    sb.write_substring(line, pos, end)
    pos = end
    first = false
  }
}

///| Fold a single `NAME:VAL` line directly into `sb` without allocating an intermediate `line` String.
fn write_folded_kv_to(sb : StringBuilder, name : String, value : String) -> Unit {
  let nl = name.length()
  let vl = value.length()
  let total = nl + 1 + vl
  if total <= 75 {
    sb.write_string(name)
    sb.write_byte((58).to_byte())
    sb.write_string(value)
    return
  }
  if nl + 1 >= 75 {
    let line_sb = StringBuilder::with_capacity(total)
    line_sb.write_string(name)
    line_sb.write_byte((58).to_byte())
    line_sb.write_string(value)
    write_folded_line_to(sb, line_sb.to_string())
    return
  }
  // First chunk contains `name` (ASCII), `:`, and up to `75 - (nl + 1)` bytes of `value`
  let first_val_max = 75 - (nl + 1)
  let mut end = first_val_max
  if end >= vl {
    end = vl
  } else {
    while end > 0 && (value.code_unit_at(end) & 0xC0) == 0x80 {
      end = end - 1
    }
  }
  sb.write_string(name)
  sb.write_byte((58).to_byte())
  if end > 0 {
    sb.write_substring(value, 0, end)
  }
  let mut pos = end
  while pos < vl {
    sb.write_string("\r\n ")
    let mut next_end = pos + 74
    if next_end >= vl {
      next_end = vl
    } else {
      while next_end > pos && (value.code_unit_at(next_end) & 0xC0) == 0x80 {
        next_end = next_end - 1
      }
      if next_end == pos {
        next_end = pos + 1
      }
    }
    sb.write_substring(value, pos, next_end)
    pos = next_end
  }
}

///| Fold a single content line to <= 75 UTF-8 octets per physical line using `\r\n ` without splitting UTF-8 codepoints.
pub fn fold_line(line : String) -> String {
  if line.length() <= 75 {
    return line
  }
  let sb = StringBuilder::with_capacity(line.length() + (line.length() / 74) * 3 + 4)
  write_folded_line_to(sb, line)
  sb.to_string()
}

///| Check whether an escaped parameter value needs double-quoting per RFC 5545 §3.1.
fn param_needs_quotes(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 58 || c == 59 || c == 44 {
      return true
    }
    i = i + 1
  }
  false
}

///| Neutralize raw CR/LF in property values so serialization can never inject new content lines.
fn sanitize_property_value(s : String) -> String {
  let n = s.length()
  let mut first = -1
  let mut i = 0
  while i + 4 <= n {
    let b0 = s.code_unit_at(i)
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    let b3 = s.code_unit_at(i + 3)
    if b0 != 10 && b0 != 13 && b1 != 10 && b1 != 13 && b2 != 10 && b2 != 13 && b3 != 10 && b3 != 13 {
      i = i + 4
      continue
    }
    break
  }
  while i < n {
    let b = s.code_unit_at(i)
    if b == 10 || b == 13 {
      first = i
      break
    }
    i = i + 1
  }
  if first < 0 {
    return s
  }
  let sb = StringBuilder::with_capacity(n + 8)
  let mut chunk_start = 0
  let mut k = first
  while k < n {
    let b = s.code_unit_at(k)
    if b == 13 {
      if k > chunk_start {
        sb.write_substring(s, chunk_start, k)
      }
      if k + 1 < n && s.code_unit_at(k + 1) == 10 {
        k = k + 1
      }
      sb.write_byte((92).to_byte())
      sb.write_byte((110).to_byte())
      k = k + 1
      chunk_start = k
    } else if b == 10 {
      if k > chunk_start {
        sb.write_substring(s, chunk_start, k)
      }
      sb.write_byte((92).to_byte())
      sb.write_byte((110).to_byte())
      k = k + 1
      chunk_start = k
    } else {
      k = k + 1
    }
  }
  if chunk_start < n {
    sb.write_substring(s, chunk_start, n)
  }
  sb.to_string()
}

///| Serialize a single `Property` as a folded CRLF-terminated line.
fn write_property_to(sb : StringBuilder, prop : Property) -> Unit {
  let pname = sanitize_ical_name(prop.name)
  let pval = sanitize_property_value(prop.value)
  let np = prop.params.length()
  if np == 0 {
    write_folded_kv_to(sb, pname, pval)
    sb.write_string("\r\n")
    return
  }
  let line_sb = StringBuilder::with_capacity(pname.length() + pval.length() + np * 16 + 4)
  line_sb.write_string(pname)
  let mut i = 0
  while i < np {
    let p = prop.params[i]
    line_sb.write_byte((59).to_byte())
    line_sb.write_string(sanitize_ical_name(p.name))
    line_sb.write_byte((61).to_byte())
    let nv = p.values.length()
    let mut j = 0
    while j < nv {
      if j > 0 {
        line_sb.write_byte((44).to_byte())
      }
      let esc = escape_param_value(p.values[j])
      if param_needs_quotes(esc) {
        line_sb.write_byte((34).to_byte())
        line_sb.write_string(esc)
        line_sb.write_byte((34).to_byte())
      } else {
        line_sb.write_string(esc)
      }
      j = j + 1
    }
    i = i + 1
  }
  line_sb.write_byte((58).to_byte())
  line_sb.write_string(pval)
  write_folded_line_to(sb, line_sb.to_string())
  sb.write_string("\r\n")
}

///| Estimate serialized byte length of a `Property` (for exact `StringBuilder` pre-sizing).
fn estimate_property_bytes(prop : Property) -> Int {
  let mut len = prop.name.length() + prop.value.length() + 3
  let np = prop.params.length()
  let mut i = 0
  while i < np {
    let p = prop.params[i]
    len = len + p.name.length() + 2
    let mut j = 0
    while j < p.values.length() {
      len = len + p.values[j].length() + 3
      j = j + 1
    }
    i = i + 1
  }
  if len > 75 {
    len = len + (len / 74) * 3
  }
  len
}

///| Estimate serialized byte length of a `Component` tree.
fn estimate_component_bytes(comp : Component) -> Int {
  let mut total = comp.name.length() * 2 + 14
  let mut i = 0
  while i < comp.properties.length() {
    total = total + estimate_property_bytes(comp.properties[i])
    i = i + 1
  }
  let mut j = 0
  while j < comp.subcomponents.length() {
    total = total + estimate_component_bytes(comp.subcomponents[j])
    j = j + 1
  }
  total
}

///| Serialize a `Component` tree recursively.
fn write_component_to(sb : StringBuilder, comp : Component) -> Unit {
  let cname = sanitize_ical_name(comp.name)
  sb.write_string("BEGIN:")
  sb.write_string(cname)
  sb.write_string("\r\n")
  let mut i = 0
  while i < comp.properties.length() {
    write_property_to(sb, comp.properties[i])
    i = i + 1
  }
  let mut j = 0
  while j < comp.subcomponents.length() {
    write_component_to(sb, comp.subcomponents[j])
    j = j + 1
  }
  sb.write_string("END:")
  sb.write_string(cname)
  sb.write_string("\r\n")
}

///| Serialize a `Calendar` to canonical RFC 5545 text (CRLF, 75-octet folded).
pub fn Calendar::to_ical(self : Calendar) -> String {
  let mut est = 32
  let mut pi = 0
  while pi < self.properties.length() {
    est = est + estimate_property_bytes(self.properties[pi])
    pi = pi + 1
  }
  let mut ci = 0
  while ci < self.components.length() {
    est = est + estimate_component_bytes(self.components[ci])
    ci = ci + 1
  }
  let sb = StringBuilder::with_capacity(est)
  sb.write_string("BEGIN:VCALENDAR\r\n")
  let mut i = 0
  while i < self.properties.length() {
    write_property_to(sb, self.properties[i])
    i = i + 1
  }
  let mut j = 0
  while j < self.components.length() {
    write_component_to(sb, self.components[j])
    j = j + 1
  }
  sb.write_string("END:VCALENDAR\r\n")
  sb.to_string()
}
