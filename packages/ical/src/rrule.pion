///| RFC 5545 §3.3.10 / §3.8.5.3 RRULE parser, formatter, and recurrence expansion engine.

import "time"

///| Parsed RFC 5545 recurrence rule (`RRULE`).
pub struct RRule {
  pub freq : Freq
  pub interval : Int
  pub count : Option[Int]
  pub until : Option[time::DateTime]
  pub until_is_utc : Bool
  pub until_is_date : Bool
  pub wkst : time::Weekday
  pub bysetpos : Array[Int]
  pub bymonth : Array[Int]
  pub bymonthday : Array[Int]
  pub byyearday : Array[Int]
  pub byweekno : Array[Int]
  pub byday : Array[NWeekday]
  pub byhour : Array[Int]
  pub byminute : Array[Int]
  pub bysecond : Array[Int]
  pub rscale : Option[String]
  pub skip : Option[String]
}

///| Parse a signed integer in `[min_val, max_val]` from slice `[start, end)`.
fn parse_int_range(
  s : String,
  start : Int,
  end : Int,
  min_val : Int,
  max_val : Int,
  allow_zero : Bool,
) -> Result[Int, IcalError] {
  if start >= end {
    return Err(IcalError::InvalidRRule("empty integer in RRULE"))
  }
  let mut pos = start
  let mut neg = false
  let c0 = s.code_unit_at(pos)
  if c0 == 45 {
    neg = true
    pos = pos + 1
  } else if c0 == 43 {
    pos = pos + 1
  }
  if pos >= end {
    return Err(IcalError::InvalidRRule("expected digits after sign in RRULE"))
  }
  let mut acc = 0L
  let mut digits = 0
  while pos < end {
    let d = s.code_unit_at(pos) - 48
    if d < 0 || d > 9 {
      return Err(IcalError::InvalidRRule("non-digit in RRULE integer"))
    }
    digits = digits + 1
    if digits > 10 {
      return Err(IcalError::InvalidRRule("integer overflow in RRULE"))
    }
    acc = acc * 10L + d.to_int64()
    if acc > 2147483647L {
      return Err(IcalError::InvalidRRule("integer overflow in RRULE"))
    }
    pos = pos + 1
  }
  let num = if neg { (-acc).to_int() } else { acc.to_int() }
  if (!allow_zero && num == 0) || num < min_val || num > max_val {
    return Err(IcalError::InvalidRRule("RRULE integer out of range: " + num.to_string()))
  }
  Ok(num)
}

///| Parse a comma-separated list of integers in `[min_val, max_val]`.
fn parse_int_list(
  s : String,
  start : Int,
  end : Int,
  min_val : Int,
  max_val : Int,
  allow_zero : Bool,
) -> Result[Array[Int], IcalError] {
  let out : Array[Int] = []
  let mut pos = start
  while pos <= end {
    let mut comma = pos
    while comma < end && s.code_unit_at(comma) != 44 {
      comma = comma + 1
    }
    match parse_int_range(s, pos, comma, min_val, max_val, allow_zero) {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
    if comma >= end {
      break
    }
    pos = comma + 1
  }
  if out.length() == 0 {
    return Err(IcalError::InvalidRRule("empty integer list in RRULE"))
  }
  Ok(out)
}

///| Decode 2 ASCII bytes of an RFC 5545 weekday (`MO`..`SU`, case-insensitive) into Monday=0..Sunday=6, or -1 if invalid.
pub fn parse_weekday_2_bytes(a0 : Int, b0 : Int) -> Int {
  let a = ascii_upper_byte(a0)
  let b = ascii_upper_byte(b0)
  if a == 77 && b == 79 {
    return 0
  }
  if a == 84 && b == 85 {
    return 1
  }
  if a == 87 && b == 69 {
    return 2
  }
  if a == 84 && b == 72 {
    return 3
  }
  if a == 70 && b == 82 {
    return 4
  }
  if a == 83 && b == 65 {
    return 5
  }
  if a == 83 && b == 85 {
    return 6
  }
  -1
}

///| Parse a 2-letter RFC 5545 weekday (`MO`..`SU`).
fn parse_weekday_2(s : String, pos : Int) -> Result[time::Weekday, IcalError] {
  if pos + 2 > s.length() {
    return Err(IcalError::InvalidRRule("truncated weekday"))
  }
  let code = parse_weekday_2_bytes(s.code_unit_at(pos), s.code_unit_at(pos + 1))
  match code {
    0 => Ok(time::Weekday::Mon)
    1 => Ok(time::Weekday::Tue)
    2 => Ok(time::Weekday::Wed)
    3 => Ok(time::Weekday::Thu)
    4 => Ok(time::Weekday::Fri)
    5 => Ok(time::Weekday::Sat)
    6 => Ok(time::Weekday::Sun)
    _ => Err(IcalError::InvalidRRule("invalid weekday token"))
  }
}

///| Format a `time::Weekday` as a 2-letter RFC 5545 token.
fn weekday_to_ical(w : time::Weekday) -> String {
  match w {
    time::Weekday::Mon => "MO"
    time::Weekday::Tue => "TU"
    time::Weekday::Wed => "WE"
    time::Weekday::Thu => "TH"
    time::Weekday::Fri => "FR"
    time::Weekday::Sat => "SA"
    time::Weekday::Sun => "SU"
  }
}

///| Parse a comma-separated `BYDAY` list (e.g. `MO,2TU,-1FR`).
fn parse_byday_list(s : String, start : Int, end : Int) -> Result[Array[NWeekday], IcalError] {
  let out : Array[NWeekday] = []
  let mut pos = start
  while pos <= end {
    let mut comma = pos
    while comma < end && s.code_unit_at(comma) != 44 {
      comma = comma + 1
    }
    let tok_len = comma - pos
    if tok_len < 2 {
      return Err(IcalError::InvalidRRule("invalid BYDAY token"))
    }
    let wd_pos = comma - 2
    let wd = match parse_weekday_2(s, wd_pos) {
      Ok(w) => w
      Err(e) => return Err(e)
    }
    let ord = if wd_pos > pos {
      match parse_int_range(s, pos, wd_pos, -53, 53, false) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else {
      0
    }
    out.push(NWeekday::{ weekday: wd, n: ord })
    if comma >= end {
      break
    }
    pos = comma + 1
  }
  if out.length() == 0 {
    return Err(IcalError::InvalidRRule("empty BYDAY list"))
  }
  Ok(out)
}

///| Parse an RFC 5545 `RRULE` value (optional leading `RRULE:`).
pub fn RRule::parse(s : String) -> Result[RRule, IcalError] {
  let n = s.length()
  let mut pos = 0
  // Strip optional leading "RRULE:"
  if n >= 6 && ascii_eq_ignore_case(slice_to_upper(s, 0, 6), "RRULE:") {
    pos = 6
  }
  if pos >= n {
    return Err(IcalError::InvalidRRule("empty RRULE"))
  }

  let mut has_freq = false
  let mut seen_interval = false
  let mut seen_count = false
  let mut seen_until = false
  let mut seen_wkst = false
  let mut seen_bysetpos = false
  let mut seen_bymonth = false
  let mut seen_bymonthday = false
  let mut seen_byyearday = false
  let mut seen_byweekno = false
  let mut seen_byday = false
  let mut seen_byhour = false
  let mut seen_byminute = false
  let mut seen_bysecond = false
  let mut seen_rscale = false
  let mut seen_skip = false

  let mut freq = Freq::Daily
  let mut interval = 1
  let mut count : Option[Int] = None
  let mut until : Option[time::DateTime] = None
  let mut until_is_utc = false
  let mut until_is_date = false
  let mut wkst = time::Weekday::Mon
  let mut bysetpos : Array[Int] = []
  let mut bymonth : Array[Int] = []
  let mut bymonthday : Array[Int] = []
  let mut byyearday : Array[Int] = []
  let mut byweekno : Array[Int] = []
  let mut byday : Array[NWeekday] = []
  let mut byhour : Array[Int] = []
  let mut byminute : Array[Int] = []
  let mut bysecond : Array[Int] = []
  let mut rscale : Option[String] = None
  let mut skip : Option[String] = None

  while pos < n {
    let mut semi = pos
    while semi < n && s.code_unit_at(semi) != 59 {
      semi = semi + 1
    }
    if semi == pos {
      pos = semi + 1
      continue
    }
    let mut eq = pos
    while eq < semi && s.code_unit_at(eq) != 61 {
      eq = eq + 1
    }
    if eq == pos || eq >= semi {
      return Err(IcalError::InvalidRRule("expected KEY=VALUE in RRULE"))
    }
    let key = slice_to_upper(s, pos, eq)
    let vstart = eq + 1
    let vend = semi

    if key == "FREQ" {
      if has_freq {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: FREQ"))
      }
      let fval = slice_to_upper(s, vstart, vend)
      if fval == "YEARLY" {
        freq = Freq::Yearly
      } else if fval == "MONTHLY" {
        freq = Freq::Monthly
      } else if fval == "WEEKLY" {
        freq = Freq::Weekly
      } else if fval == "DAILY" {
        freq = Freq::Daily
      } else if fval == "HOURLY" {
        freq = Freq::Hourly
      } else if fval == "MINUTELY" {
        freq = Freq::Minutely
      } else if fval == "SECONDLY" {
        freq = Freq::Secondly
      } else {
        return Err(IcalError::InvalidRRule("unknown FREQ: " + fval))
      }
      has_freq = true
    } else if key == "INTERVAL" {
      if seen_interval {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: INTERVAL"))
      }
      seen_interval = true
      match parse_int_range(s, vstart, vend, 1, 2147483647, false) {
        Ok(v) => interval = v
        Err(e) => return Err(e)
      }
    } else if key == "COUNT" {
      if seen_count {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: COUNT"))
      }
      seen_count = true
      match parse_int_range(s, vstart, vend, 0, 2147483647, true) {
        Ok(v) => count = Some(v)
        Err(e) => return Err(e)
      }
    } else if key == "UNTIL" {
      if seen_until {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: UNTIL"))
      }
      seen_until = true
      let uval = slice_to_upper(s, vstart, vend)
      match parse_ical_datetime(uval, None) {
        Ok(idt) =>
        match idt {
          IcalDateTime::DateOnly(d) => {
            let eod = match time::Time::new(23, 59, 59, 0) {
              Ok(t) => t
              Err(_) => time::Time::midnight()
            }
            until = Some(time::DateTime::from_parts(d, eod))
            until_is_utc = false
            until_is_date = true
          }
          IcalDateTime::Utc(dt) => {
            until = Some(dt)
            until_is_utc = true
            until_is_date = false
          }
          IcalDateTime::Floating(dt) => {
            until = Some(dt)
            until_is_utc = false
            until_is_date = false
          }
          IcalDateTime::Zoned(dt, _) => {
            until = Some(dt)
            until_is_utc = false
            until_is_date = false
          }
        }
        Err(e) => return Err(IcalError::InvalidRRule("invalid UNTIL: " + ical_error_to_string(e)))
      }
    } else if key == "WKST" {
      if seen_wkst {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: WKST"))
      }
      seen_wkst = true
      if vend - vstart != 2 {
        return Err(IcalError::InvalidRRule("invalid WKST"))
      }
      match parse_weekday_2(s, vstart) {
        Ok(w) => wkst = w
        Err(e) => return Err(e)
      }
    } else if key == "BYSETPOS" {
      if seen_bysetpos {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: BYSETPOS"))
      }
      seen_bysetpos = true
      match parse_int_list(s, vstart, vend, -366, 366, false) {
        Ok(v) => bysetpos = v
        Err(e) => return Err(e)
      }
    } else if key == "BYMONTH" {
      if seen_bymonth {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: BYMONTH"))
      }
      seen_bymonth = true
      match parse_int_list(s, vstart, vend, 1, 12, false) {
        Ok(v) => bymonth = v
        Err(e) => return Err(e)
      }
    } else if key == "BYMONTHDAY" {
      if seen_bymonthday {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: BYMONTHDAY"))
      }
      seen_bymonthday = true
      match parse_int_list(s, vstart, vend, -31, 31, false) {
        Ok(v) => bymonthday = v
        Err(e) => return Err(e)
      }
    } else if key == "BYYEARDAY" {
      if seen_byyearday {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: BYYEARDAY"))
      }
      seen_byyearday = true
      match parse_int_list(s, vstart, vend, -366, 366, false) {
        Ok(v) => byyearday = v
        Err(e) => return Err(e)
      }
    } else if key == "BYWEEKNO" {
      if seen_byweekno {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: BYWEEKNO"))
      }
      seen_byweekno = true
      match parse_int_list(s, vstart, vend, -53, 53, false) {
        Ok(v) => byweekno = v
        Err(e) => return Err(e)
      }
    } else if key == "BYDAY" {
      if seen_byday {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: BYDAY"))
      }
      seen_byday = true
      match parse_byday_list(s, vstart, vend) {
        Ok(v) => byday = v
        Err(e) => return Err(e)
      }
    } else if key == "BYHOUR" {
      if seen_byhour {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: BYHOUR"))
      }
      seen_byhour = true
      match parse_int_list(s, vstart, vend, 0, 23, true) {
        Ok(v) => byhour = v
        Err(e) => return Err(e)
      }
    } else if key == "BYMINUTE" {
      if seen_byminute {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: BYMINUTE"))
      }
      seen_byminute = true
      match parse_int_list(s, vstart, vend, 0, 59, true) {
        Ok(v) => byminute = v
        Err(e) => return Err(e)
      }
    } else if key == "BYSECOND" {
      if seen_bysecond {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: BYSECOND"))
      }
      seen_bysecond = true
      match parse_int_list(s, vstart, vend, 0, 60, true) {
        Ok(v) => bysecond = v
        Err(e) => return Err(e)
      }
    } else if key == "RSCALE" {
      if seen_rscale {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: RSCALE"))
      }
      seen_rscale = true
      rscale = Some(slice_to_upper(s, vstart, vend))
    } else if key == "SKIP" {
      if seen_skip {
        return Err(IcalError::InvalidRRule("duplicate RRULE parameter: SKIP"))
      }
      seen_skip = true
      let sk = slice_to_upper(s, vstart, vend)
      if sk != "OMIT" && sk != "BACKWARD" && sk != "FORWARD" {
        return Err(IcalError::InvalidRRule("invalid SKIP value: " + sk))
      }
      skip = Some(sk)
    } else {
      return Err(IcalError::InvalidRRule("unknown RRULE parameter: " + key))
    }
    pos = semi + 1
  }

  if !has_freq {
    return Err(IcalError::InvalidRRule("RRULE missing required FREQ"))
  }
  if byweekno.length() > 0 {
    match freq {
      Freq::Yearly => ()
      _ => return Err(IcalError::InvalidRRule("BYWEEKNO MUST NOT be used when FREQ is not YEARLY"))
    }
  }
  let has_count = match count { Some(_) => true; None => false }
  let has_until = match until { Some(_) => true; None => false }
  if has_count && has_until {
    return Err(IcalError::InvalidRRule("COUNT and UNTIL are mutually exclusive"))
  }

  Ok(RRule::{
    freq: freq,
    interval: interval,
    count: count,
    until: until,
    until_is_utc: until_is_utc,
    until_is_date: until_is_date,
    wkst: wkst,
    bysetpos: bysetpos,
    bymonth: bymonth,
    bymonthday: bymonthday,
    byyearday: byyearday,
    byweekno: byweekno,
    byday: byday,
    byhour: byhour,
    byminute: byminute,
    bysecond: bysecond,
    rscale: rscale,
    skip: skip,
  })
}

///| Write a comma-separated list of integers to `sb`.
fn write_int_list(sb : StringBuilder, key : String, arr : Array[Int]) -> Unit {
  if arr.length() == 0 {
    return
  }
  sb.write_byte((59).to_byte())
  sb.write_string(key)
  sb.write_byte((61).to_byte())
  let mut i = 0
  while i < arr.length() {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_string(arr[i].to_string())
    i = i + 1
  }
}

///| Format an `RRule` into its canonical RFC 5545 string.
pub fn RRule::to_string(self : RRule) -> String {
  let sb = StringBuilder::new()
  sb.write_string("FREQ=")
  match self.freq {
    Freq::Yearly => sb.write_string("YEARLY")
    Freq::Monthly => sb.write_string("MONTHLY")
    Freq::Weekly => sb.write_string("WEEKLY")
    Freq::Daily => sb.write_string("DAILY")
    Freq::Hourly => sb.write_string("HOURLY")
    Freq::Minutely => sb.write_string("MINUTELY")
    Freq::Secondly => sb.write_string("SECONDLY")
  }
  match self.rscale {
    Some(rs) => {
      sb.write_string(";RSCALE=")
      sb.write_string(rs)
    }
    None => ()
  }
  match self.skip {
    Some(sk) => {
      sb.write_string(";SKIP=")
      sb.write_string(sk)
    }
    None => ()
  }
  if self.interval != 1 {
    sb.write_string(";INTERVAL=")
    sb.write_string(self.interval.to_string())
  }
  match self.count {
    Some(c) => {
      sb.write_string(";COUNT=")
      sb.write_string(c.to_string())
    }
    None => ()
  }
  match self.until {
    Some(u) => {
      sb.write_string(";UNTIL=")
      if self.until_is_date {
        sb.write_string(ical_datetime_to_value(IcalDateTime::DateOnly(u.date)))
      } else if self.until_is_utc {
        sb.write_string(ical_datetime_to_value(IcalDateTime::Utc(u)))
      } else {
        sb.write_string(ical_datetime_to_value(IcalDateTime::Floating(u)))
      }
    }
    None => ()
  }
  write_int_list(sb, "BYMONTH", self.bymonth)
  write_int_list(sb, "BYWEEKNO", self.byweekno)
  write_int_list(sb, "BYYEARDAY", self.byyearday)
  write_int_list(sb, "BYMONTHDAY", self.bymonthday)
  if self.byday.length() > 0 {
    sb.write_string(";BYDAY=")
    let mut i = 0
    while i < self.byday.length() {
      if i > 0 {
        sb.write_byte((44).to_byte())
      }
      if self.byday[i].n != 0 {
        sb.write_string(self.byday[i].n.to_string())
      }
      sb.write_string(weekday_to_ical(self.byday[i].weekday))
      i = i + 1
    }
  }
  write_int_list(sb, "BYHOUR", self.byhour)
  write_int_list(sb, "BYMINUTE", self.byminute)
  write_int_list(sb, "BYSECOND", self.bysecond)
  write_int_list(sb, "BYSETPOS", self.bysetpos)
  match self.wkst {
    time::Weekday::Mon => ()
    _ => {
      sb.write_string(";WKST=")
      sb.write_string(weekday_to_ical(self.wkst))
    }
  }
  sb.to_string()
}

// =============================================================================
// Calendar math helpers for fast RRULE expansion
// =============================================================================

///| Return Monday=0..Sunday=6 weekday of an epoch day (1970-01-01 = Thu = 3).
#verify
pub fn epoch_day_weekday_mon0(ed : Int) -> Int {
  let r = (ed + 3) % 7
  if r < 0 { r + 7 } else { r }
}

///| Fast Date from epoch days (valid for 0001..9999).
fn date_from_ed(ed : Int) -> time::Date {
  match time::Date::from_epoch_days(ed) {
    Ok(d) => d
    Err(_) => time::Date::min()
  }
}

///| Epoch days of `(year, month, day)`.
fn ymd_to_ed(year : Int, month : Int, day : Int) -> Int {
  match time::Date::new(year, month, day) {
    Ok(d) => d.to_epoch_days()
    Err(_) => 0
  }
}

///| Days in `year` (365 or 366).
fn days_in_year(year : Int) -> Int {
  if time::is_leap_year(year) { 366 } else { 365 }
}

///| Day-of-year (1..366) of `ed` given `jan1_ed = ymd_to_ed(year, 1, 1)`.
pub fn doy_of(ed : Int, jan1_ed : Int) -> Int {
  ed - jan1_ed + 1
}

///| Sort and deduplicate an `Array[Int]` in place (fast path when already strictly sorted).
fn sort_dedup_ints(arr : Array[Int]) -> Array[Int] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mut strictly_sorted = true
  let mut s = 1
  while s < n {
    if arr[s] <= arr[s - 1] {
      strictly_sorted = false
      break
    }
    s = s + 1
  }
  if strictly_sorted {
    return arr
  }
  // Shell sort (gap sequence: fast, zero extra allocation, O(n log n) practical)
  let mut gap = n / 2
  while gap > 0 {
    let mut i = gap
    while i < n {
      let temp = arr[i]
      let mut j = i
      while j >= gap && arr[j - gap] > temp {
        arr[j] = arr[j - gap]
        j = j - gap
      }
      arr[j] = temp
      i = i + 1
    }
    gap = gap / 2
  }
  let mut has_dup = false
  let mut d = 1
  while d < n {
    if arr[d] == arr[d - 1] {
      has_dup = true
      break
    }
    d = d + 1
  }
  if !has_dup {
    return arr
  }
  let out : Array[Int] = Array::with_capacity(n)
  out.push(arr[0])
  let mut k = 1
  while k < n {
    if arr[k] != arr[k - 1] {
      out.push(arr[k])
    }
    k = k + 1
  }
  out
}

///| Check if `target` is in `arr`.
fn array_contains_int(arr : Array[Int], target : Int) -> Bool {
  let mut i = 0
  let n = arr.length()
  while i < n {
    if arr[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

///| Check if `target` is in sorted `arr` using binary search.
fn array_contains_int_sorted(arr : Array[Int], target : Int) -> Bool {
  let mut lo = 0
  let mut hi = arr.length()
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let v = arr[mid]
    if v == target {
      return true
    } else if v < target {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  false
}

///| Find first index in sorted `arr` with `arr[i] >= target` (or `arr.length()`).
fn lower_bound_int(arr : Array[Int], target : Int) -> Int {
  let mut lo = 0
  let mut hi = arr.length()
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if arr[mid] < target {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  lo
}

///| Floor division of signed `Int64` seconds by 86400.
#verify
pub fn floor_div_86400(sec : Int64) -> Int {
  if sec >= 0L {
    (sec / 86400L).to_int()
  } else {
    ((sec - 86399L) / 86400L).to_int()
  }
}

///| Greatest common divisor of two positive `Int64` values.
fn gcd64(a0 : Int64, b0 : Int64) -> Int64 {
  let mut a = if a0 < 0L { -a0 } else { a0 }
  let mut b = if b0 < 0L { -b0 } else { b0 }
  while b != 0L {
    let t = a % b
    a = b
    b = t
  }
  a
}

///| Check whether any `NWeekday` in `byday` carries a non-zero ordinal.
fn byday_has_ordinal(byday : Array[NWeekday]) -> Bool {
  let mut i = 0
  while i < byday.length() {
    if byday[i].n != 0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Check if `wd_mon0` (0=Mon..6=Sun) matches any `NWeekday` in `byday` (ignoring ordinal).
fn byday_contains_wd(byday : Array[NWeekday], wd_mon0 : Int) -> Bool {
  let mut i = 0
  let n = byday.length()
  while i < n {
    if time::weekday_to_monday_zero_offset(byday[i].weekday) == wd_mon0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Check if a day matches `bymonthday` (positive or negative) for its month.
///| Convert 1-based day/doy in `1..total` to its equivalent negative RFC 5545 index in `-total..-1`.
#verify
pub fn neg_ordinal_day(day : Int, total : Int) -> Int {
  day - total - 1
}

fn matches_bymonthday(day : Int, dim : Int, bymonthday : Array[Int]) -> Bool {
  let neg = neg_ordinal_day(day, dim)
  let mut i = 0
  let n = bymonthday.length()
  while i < n {
    let md = bymonthday[i]
    if md == day || md == neg {
      return true
    }
    i = i + 1
  }
  false
}

///| Check if a day-of-year (1..diy) matches `byyearday` (positive or negative).
fn matches_byyearday(doy : Int, diy : Int, byyearday : Array[Int]) -> Bool {
  let neg = neg_ordinal_day(doy, diy)
  let mut i = 0
  let n = byyearday.length()
  while i < n {
    let yd = byyearday[i]
    if yd == doy || yd == neg {
      return true
    }
    i = i + 1
  }
  false
}

///| Compute RFC 5545 §3.3.10 week-1 start epoch day from Jan 1 epoch day and `wkst_mon0` (0..6).
#verify
pub fn week1_start_of(jan1 : Int, wkst_mon0 : Int) -> Int {
  let jan1_wd = epoch_day_weekday_mon0(jan1)
  let offset = (jan1_wd - wkst_mon0 + 7) % 7
  if 7 - offset >= 4 {
    jan1 - offset
  } else {
    jan1 + (7 - offset)
  }
}

///| Compute RFC 5545 §3.3.10 week-1 start epoch day for `(year, wkst_mon0)` and total weeks in `year`.
///| Week 1 is the first week containing at least 4 days in `year`.
fn year_week1_info(year : Int, wkst_mon0 : Int) -> (Int, Int) {
  let jan1 = ymd_to_ed(year, 1, 1)
  let week1_start = week1_start_of(jan1, wkst_mon0)
  // Compute next year's week1_start to get exact number of weeks (52 or 53)
  let next_jan1 = ymd_to_ed(year + 1, 1, 1)
  let next_w1 = week1_start_of(next_jan1, wkst_mon0)
  let num_weeks = (next_w1 - week1_start) / 7
  (week1_start, num_weeks)
}

///| Expand `BYDAY` (including positive/negative ordinals) within `[range_start_ed, range_end_ed]` inclusive.
fn expand_byday_in_range(
  range_start_ed : Int,
  range_end_ed : Int,
  byday : Array[NWeekday],
  out : Array[Int],
) -> Unit {
  let start_wd = epoch_day_weekday_mon0(range_start_ed)
  let end_wd = epoch_day_weekday_mon0(range_end_ed)
  let mut i = 0
  let nb = byday.length()
  while i < nb {
    let nw = byday[i]
    let target_wd = time::weekday_to_monday_zero_offset(nw.weekday)
    if nw.n == 0 {
      let mut ed = range_start_ed + (target_wd - start_wd + 7) % 7
      while ed <= range_end_ed {
        out.push(ed)
        ed = ed + 7
      }
    } else if nw.n > 0 {
      let first = range_start_ed + (target_wd - start_wd + 7) % 7
      let ed = first + (nw.n - 1) * 7
      if ed <= range_end_ed {
        out.push(ed)
      }
    } else {
      let last = range_end_ed - (end_wd - target_wd + 7) % 7
      let ed = last + (nw.n + 1) * 7
      if ed >= range_start_ed {
        out.push(ed)
      }
    }
    i = i + 1
  }
}

///| Copy an `Array[Int]`.
fn copy_int_array(arr : Array[Int]) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < arr.length() {
    out.push(arr[i])
    i = i + 1
  }
  out
}

///| Normalize `BYSECOND` (clamping leap second 60 -> 59 *before* deduplication) and sort.
fn normalized_bysecond(rule : RRule, dtstart : time::DateTime) -> Array[Int] {
  if rule.bysecond.length() == 0 {
    return [dtstart.time.second]
  }
  let raw : Array[Int] = []
  let mut i = 0
  while i < rule.bysecond.length() {
    let s = rule.bysecond[i]
    raw.push(if s == 60 { 59 } else { s })
    i = i + 1
  }
  sort_dedup_ints(raw)
}

///| Build sorted unique times-of-day (in seconds `0..86399`) for a daily+ rule.
fn build_timeset(rule : RRule, dtstart : time::DateTime) -> Array[Int] {
  let hours = if rule.byhour.length() > 0 {
    sort_dedup_ints(copy_int_array(rule.byhour))
  } else {
    [dtstart.time.hour]
  }
  let mins = if rule.byminute.length() > 0 {
    sort_dedup_ints(copy_int_array(rule.byminute))
  } else {
    [dtstart.time.minute]
  }
  let secs = normalized_bysecond(rule, dtstart)
  let out : Array[Int] = []
  let mut hi = 0
  while hi < hours.length() {
    let h = hours[hi] * 3600
    let mut mi = 0
    while mi < mins.length() {
      let hm = h + mins[mi] * 60
      let mut si = 0
      while si < secs.length() {
        out.push(hm + secs[si])
        si = si + 1
      }
      mi = mi + 1
    }
    hi = hi + 1
  }
  out
}

///| Convert `(epoch_day, sec_of_day)` to `time::DateTime` (`sec` in `0..86399`).
fn ed_sec_to_datetime(ed : Int, sec : Int) -> time::DateTime {
  let d = date_from_ed(ed)
  let h = sec / 3600
  let rem = sec - h * 3600
  let mi = rem / 60
  let sc = rem - mi * 60
  time::DateTime::{
    date: d,
    time: time::Time::{ hour: h, minute: mi, second: sc, nanosecond: 0 },
  }
}

///| Convert `timeset` seconds-of-day array into precomputed `Array[time::Time]`.
fn build_timeset_times(timeset : Array[Int]) -> Array[time::Time] {
  let n = timeset.length()
  let out : Array[time::Time] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let sec = timeset[i]
    let h = sec / 3600
    let rem = sec - h * 3600
    let mi = rem / 60
    let sc = rem - mi * 60
    out.push(time::Time::{ hour: h, minute: mi, second: sc, nanosecond: 0 })
    i = i + 1
  }
  out
}

///| Precompute a 7-bit mask of Monday=0..Sunday=6 weekdays present in `byday`.
fn compute_byday_wd_mask(byday : Array[NWeekday]) -> Int {
  let mut mask = 0
  let mut i = 0
  let n = byday.length()
  while i < n {
    mask = mask | (1 << time::weekday_to_monday_zero_offset(byday[i].weekday))
    i = i + 1
  }
  mask
}

///| Precompute a 13-bit mask of months `1..12` present in `bymonth`.
fn compute_bymonth_mask(bymonth : Array[Int]) -> Int {
  let mut mask = 0
  let mut i = 0
  let n = bymonth.length()
  while i < n {
    let m = bymonth[i]
    if m >= 1 && m <= 12 {
      mask = mask | (1 << m)
    }
    i = i + 1
  }
  mask
}

///| Filter candidate `epoch_days` for a single year according to RFC 5545 `YEARLY` rules.
fn yearly_candidate_days(rule : RRule, dtstart : time::DateTime, year : Int) -> Array[Int] {
  let jan1 = ymd_to_ed(year, 1, 1)
  let diy = days_in_year(year)
  let dec31 = jan1 + diy - 1
  let raw : Array[Int] = []

  if rule.byweekno.length() > 0 {
    let wkst_m0 = time::weekday_to_monday_zero_offset(rule.wkst)
    let winfo = year_week1_info(year, wkst_m0)
    let w1_start = winfo.0
    let num_weeks = winfo.1
    let mut i = 0
    while i < rule.byweekno.length() {
      let wn = rule.byweekno[i]
      let idx = if wn > 0 { wn - 1 } else { num_weeks + wn }
      if idx >= 0 && idx < num_weeks {
        let ws = w1_start + idx * 7
        let mut d = 0
        while d < 7 {
          let ed = ws + d
          if ed >= jan1 && ed <= dec31 {
            raw.push(ed)
          }
          d = d + 1
        }
      }
      i = i + 1
    }
    // Check week 1 of next year spilling into late December of `year` (matches dateutil / Rust rrule)
    let next_w1 = w1_start + num_weeks * 7
    if next_w1 <= dec31 && array_contains_int(rule.byweekno, 1) {
      let mut ed = next_w1
      while ed <= dec31 {
        raw.push(ed)
        ed = ed + 1
      }
    }
    // Check last week of previous year spilling into early January of `year` (matches dateutil / Rust rrule)
    if w1_start > jan1 && year > 1 {
      let prev_weeks = year_week1_info(year - 1, wkst_m0).1
      if array_contains_int(rule.byweekno, -1) || array_contains_int(rule.byweekno, prev_weeks) {
        let mut ed = jan1
        while ed < w1_start {
          raw.push(ed)
          ed = ed + 1
        }
      }
    }
  } else if rule.byyearday.length() > 0 {
    let mut i = 0
    while i < rule.byyearday.length() {
      let yd = rule.byyearday[i]
      let doy = if yd > 0 { yd } else { diy + 1 + yd }
      if doy >= 1 && doy <= diy {
        raw.push(jan1 + doy - 1)
      }
      i = i + 1
    }
  } else if rule.bymonth.length() > 0 {
    let mut mi = 0
    while mi < rule.bymonth.length() {
      let mo = rule.bymonth[mi]
      let dim = time::days_in_month_of(year, mo)
      let m_start = ymd_to_ed(year, mo, 1)
      if rule.bymonthday.length() > 0 {
        let mut di = 0
        while di < rule.bymonthday.length() {
          let md = rule.bymonthday[di]
          let day = if md > 0 { md } else { dim + 1 + md }
          if day >= 1 && day <= dim {
            raw.push(m_start + day - 1)
          }
          di = di + 1
        }
      } else if rule.byday.length() > 0 {
        expand_byday_in_range(m_start, m_start + dim - 1, rule.byday, raw)
      } else {
        if dtstart.date.day <= dim {
          raw.push(m_start + dtstart.date.day - 1)
        }
      }
      mi = mi + 1
    }
  } else if rule.bymonthday.length() > 0 {
    // RFC 5545 §3.3.10: BYMONTHDAY with FREQ=YEARLY (without BYMONTH) expands across all 12 months.
    let mut mo = 1
    while mo <= 12 {
      let dim = time::days_in_month_of(year, mo)
      let m_start = ymd_to_ed(year, mo, 1)
      let mut di = 0
      while di < rule.bymonthday.length() {
        let md = rule.bymonthday[di]
        let day = if md > 0 { md } else { dim + 1 + md }
        if day >= 1 && day <= dim {
          raw.push(m_start + day - 1)
        }
        di = di + 1
      }
      mo = mo + 1
    }
  } else if rule.byday.length() > 0 {
    expand_byday_in_range(jan1, dec31, rule.byday, raw)
  } else {
    let mo = dtstart.date.month
    let dim = time::days_in_month_of(year, mo)
    if dtstart.date.day <= dim {
      raw.push(ymd_to_ed(year, mo, dtstart.date.day))
    }
  }

  let sorted = sort_dedup_ints(raw)
  // Apply remaining filters (intersection semantics per RFC 5545 Table 1)
  let need_month_filter = rule.bymonth.length() > 0 && (rule.byweekno.length() > 0 || rule.byyearday.length() > 0)
  let need_yd_filter = rule.byyearday.length() > 0 && rule.byweekno.length() > 0
  let need_md_filter = rule.bymonthday.length() > 0 && (rule.byweekno.length() > 0 || rule.byyearday.length() > 0)
  let need_wd_filter = rule.byday.length() > 0 && (rule.byweekno.length() > 0 || rule.byyearday.length() > 0 || rule.bymonthday.length() > 0)
  if !need_month_filter && !need_yd_filter && !need_md_filter && !need_wd_filter {
    return sorted
  }
  let wd_has_ord = need_wd_filter && byday_has_ordinal(rule.byday)
  let byday_eds : Array[Int] = if wd_has_ord {
    let bd_raw : Array[Int] = []
    if rule.bymonth.length() > 0 {
      let mut mi = 0
      while mi < rule.bymonth.length() {
        let mo = rule.bymonth[mi]
        let dim = time::days_in_month_of(year, mo)
        let m_start = ymd_to_ed(year, mo, 1)
        expand_byday_in_range(m_start, m_start + dim - 1, rule.byday, bd_raw)
        mi = mi + 1
      }
    } else {
      expand_byday_in_range(jan1, dec31, rule.byday, bd_raw)
    }
    sort_dedup_ints(bd_raw)
  } else {
    []
  }
  let out : Array[Int] = []
  let mut i = 0
  while i < sorted.length() {
    let ed = sorted[i]
    let d = date_from_ed(ed)
    if need_month_filter && !array_contains_int(rule.bymonth, d.month) {
      i = i + 1
      continue
    }
    if need_yd_filter {
      let doy = doy_of(ed, jan1)
      if !matches_byyearday(doy, diy, rule.byyearday) {
        i = i + 1
        continue
      }
    }
    if need_md_filter {
      let dim = time::days_in_month_of(d.year, d.month)
      if !matches_bymonthday(d.day, dim, rule.bymonthday) {
        i = i + 1
        continue
      }
    }
    if need_wd_filter {
      if wd_has_ord {
        if !array_contains_int_sorted(byday_eds, ed) {
          i = i + 1
          continue
        }
      } else if !byday_contains_wd(rule.byday, epoch_day_weekday_mon0(ed)) {
        i = i + 1
        continue
      }
    }
    out.push(ed)
    i = i + 1
  }
  out
}

///| Filter candidate `epoch_days` for a single `(year, month)` into `out` (reusing buffer).
fn monthly_candidate_days_into(
  rule : RRule,
  dtstart : time::DateTime,
  byday_wd_mask : Int,
  bymonth_mask : Int,
  byday_has_ord : Bool,
  year : Int,
  month : Int,
  out : Array[Int],
) -> Unit {
  out.clear()
  if bymonth_mask != 0 && (bymonth_mask & (1 << month)) == 0 {
    return
  }
  let dim = time::days_in_month_of(year, month)
  let m_start = ymd_to_ed(year, month, 1)

  // Fast path: un-numbered BYDAY without BYMONTHDAY or BYYEARDAY -> emit in ascending order directly (no sort!)
  if rule.bymonthday.length() == 0 && rule.byday.length() > 0 && !byday_has_ord && rule.byyearday.length() == 0 {
    let mut wd = epoch_day_weekday_mon0(m_start)
    let mut d = 0
    while d < dim {
      if (byday_wd_mask & (1 << wd)) != 0 {
        out.push(m_start + d)
      }
      wd = if wd == 6 { 0 } else { wd + 1 }
      d = d + 1
    }
    return
  }

  let raw : Array[Int] = Array::with_capacity(8)
  if rule.bymonthday.length() > 0 {
    let mut di = 0
    while di < rule.bymonthday.length() {
      let md = rule.bymonthday[di]
      let day = if md > 0 { md } else { dim + 1 + md }
      if day >= 1 && day <= dim {
        raw.push(m_start + day - 1)
      }
      di = di + 1
    }
  } else if rule.byday.length() > 0 {
    expand_byday_in_range(m_start, m_start + dim - 1, rule.byday, raw)
  } else {
    if dtstart.date.day <= dim {
      out.push(m_start + dtstart.date.day - 1)
      if rule.byyearday.length() == 0 {
        return
      }
      raw.push(m_start + dtstart.date.day - 1)
      out.clear()
    } else {
      return
    }
  }

  let sorted = sort_dedup_ints(raw)
  let need_wd = rule.byday.length() > 0 && rule.bymonthday.length() > 0
  let need_yd = rule.byyearday.length() > 0
  if !need_wd && !need_yd {
    let mut s = 0
    while s < sorted.length() {
      out.push(sorted[s])
      s = s + 1
    }
    return
  }
  let wd_has_ord = need_wd && byday_has_ord
  let byday_eds : Array[Int] = if wd_has_ord {
    let bd_raw : Array[Int] = []
    expand_byday_in_range(m_start, m_start + dim - 1, rule.byday, bd_raw)
    sort_dedup_ints(bd_raw)
  } else {
    []
  }
  let jan1 = ymd_to_ed(year, 1, 1)
  let diy = days_in_year(year)
  let mut i = 0
  while i < sorted.length() {
    let ed = sorted[i]
    if need_wd {
      if wd_has_ord {
        if !array_contains_int_sorted(byday_eds, ed) {
          i = i + 1
          continue
        }
      } else if (byday_wd_mask & (1 << epoch_day_weekday_mon0(ed))) == 0 {
        i = i + 1
        continue
      }
    }
    if need_yd && !matches_byyearday(doy_of(ed, jan1), diy, rule.byyearday) {
      i = i + 1
      continue
    }
    out.push(ed)
    i = i + 1
  }
}

///| Filter candidate `epoch_days` for a single week starting at `week_start_ed` (`WKST`) into `out`.
fn weekly_candidate_days_into(
  rule : RRule,
  dtstart_wd : Int,
  byday_wd_mask : Int,
  bymonth_mask : Int,
  week_start_ed : Int,
  out : Array[Int],
) -> Unit {
  out.clear()
  let mut wd = epoch_day_weekday_mon0(week_start_ed)
  let has_byday = rule.byday.length() > 0
  let has_md_or_yd = rule.bymonthday.length() > 0 || rule.byyearday.length() > 0
  let no_date_filters = bymonth_mask == 0 && !has_md_or_yd
  let mut off = 0
  while off < 7 {
    let wd_ok = if has_byday {
      (byday_wd_mask & (1 << wd)) != 0
    } else if has_md_or_yd {
      true
    } else {
      wd == dtstart_wd
    }
    if wd_ok {
      let ed = week_start_ed + off
      if no_date_filters {
        out.push(ed)
      } else {
        let d = date_from_ed(ed)
        let mut ok = true
        if bymonth_mask != 0 && (bymonth_mask & (1 << d.month)) == 0 {
          ok = false
        }
        if ok && rule.bymonthday.length() > 0 {
          let dim = time::days_in_month_of(d.year, d.month)
          if !matches_bymonthday(d.day, dim, rule.bymonthday) {
            ok = false
          }
        }
        if ok && rule.byyearday.length() > 0 {
          let jan1 = ymd_to_ed(d.year, 1, 1)
          let diy = days_in_year(d.year)
          if !matches_byyearday(doy_of(ed, jan1), diy, rule.byyearday) {
            ok = false
          }
        }
        if ok {
          out.push(ed)
        }
      }
    }
    wd = if wd == 6 { 0 } else { wd + 1 }
    off = off + 1
  }
}

///| Check if a single day `ed` passes `DAILY` / sub-daily date filters.
fn day_matches_filters(
  rule : RRule,
  byday_wd_mask : Int,
  bymonth_mask : Int,
  ed : Int,
) -> Bool {
  if byday_wd_mask != 0 && (byday_wd_mask & (1 << epoch_day_weekday_mon0(ed))) == 0 {
    return false
  }
  if bymonth_mask == 0 && rule.bymonthday.length() == 0 && rule.byyearday.length() == 0 {
    return true
  }
  let d = date_from_ed(ed)
  if bymonth_mask != 0 && (bymonth_mask & (1 << d.month)) == 0 {
    return false
  }
  if rule.bymonthday.length() > 0 {
    let dim = time::days_in_month_of(d.year, d.month)
    if !matches_bymonthday(d.day, dim, rule.bymonthday) {
      return false
    }
  }
  if rule.byyearday.length() > 0 {
    let jan1 = ymd_to_ed(d.year, 1, 1)
    let diy = days_in_year(d.year)
    if !matches_byyearday(doy_of(ed, jan1), diy, rule.byyearday) {
      return false
    }
  }
  true
}

///| Apply `BYSETPOS` selection to a sorted list of period candidates.
fn apply_bysetpos(
  cands : Array[time::DateTime],
  bysetpos : Array[Int],
) -> Array[time::DateTime] {
  if bysetpos.length() == 0 || cands.length() == 0 {
    return cands
  }
  let n = cands.length()
  let idxs : Array[Int] = []
  let mut i = 0
  while i < bysetpos.length() {
    let p = bysetpos[i]
    let idx = if p > 0 { p - 1 } else { n + p }
    if idx >= 0 && idx < n {
      idxs.push(idx)
    }
    i = i + 1
  }
  let sorted_idxs = sort_dedup_ints(idxs)
  let out : Array[time::DateTime] = []
  let mut k = 0
  while k < sorted_idxs.length() {
    out.push(cands[sorted_idxs[k]])
    k = k + 1
  }
  out
}

///| Sort and deduplicate an `Array[Int64]` in place.
fn sort_dedup_i64(arr : Array[Int64]) -> Array[Int64] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mut gap = n / 2
  while gap > 0 {
    let mut i = gap
    while i < n {
      let temp = arr[i]
      let mut j = i
      while j >= gap && arr[j - gap] > temp {
        arr[j] = arr[j - gap]
        j = j - gap
      }
      arr[j] = temp
      i = i + 1
    }
    gap = gap / 2
  }
  let out : Array[Int64] = []
  out.push(arr[0])
  let mut k = 1
  while k < n {
    if arr[k] != arr[k - 1] {
      out.push(arr[k])
    }
    k = k + 1
  }
  out
}

///| Apply `BYSETPOS` directly onto a virtual `(days × timeset)` grid without materializing the Cartesian product.
fn apply_bysetpos_grid(
  days : Array[Int],
  timeset_times : Array[time::Time],
  bysetpos : Array[Int],
) -> Array[time::DateTime] {
  let nd = days.length()
  let nt = timeset_times.length()
  let nb = bysetpos.length()
  if nd == 0 || nt == 0 || nb == 0 {
    return []
  }
  let total = nd.to_int64() * nt.to_int64()
  let nt64 = nt.to_int64()
  if nb == 1 {
    let p = bysetpos[0].to_int64()
    let idx = if p > 0L { p - 1L } else { total + p }
    if idx >= 0L && idx < total {
      let di = if nt == 1 { idx.to_int() } else { (idx / nt64).to_int() }
      let ti = if nt == 1 { 0 } else { (idx % nt64).to_int() }
      return [time::DateTime::{ date: date_from_ed(days[di]), time: timeset_times[ti] }]
    }
    return []
  }
  let idxs : Array[Int64] = Array::with_capacity(nb)
  let mut i = 0
  while i < nb {
    let p = bysetpos[i].to_int64()
    let idx = if p > 0L { p - 1L } else { total + p }
    if idx >= 0L && idx < total {
      idxs.push(idx)
    }
    i = i + 1
  }
  let sorted_idxs = sort_dedup_i64(idxs)
  let out : Array[time::DateTime] = Array::with_capacity(sorted_idxs.length())
  let mut k = 0
  while k < sorted_idxs.length() {
    let idx = sorted_idxs[k]
    let di = if nt == 1 { idx.to_int() } else { (idx / nt64).to_int() }
    let ti = if nt == 1 { 0 } else { (idx % nt64).to_int() }
    out.push(time::DateTime::{ date: date_from_ed(days[di]), time: timeset_times[ti] })
    k = k + 1
  }
  out
}

///| Find the next day `>= start_ed` (up to `max_ed`, at most 400 years) matching `day_matches_filters`.
///| Skips non-matching months in O(1) to avoid scanning millions of seconds/days.
fn next_matching_day(
  rule : RRule,
  byday_wd_mask : Int,
  bymonth_mask : Int,
  sorted_bymonth : Array[Int],
  start_ed : Int,
  max_ed : Int,
) -> Option[Int] {
  let hard_max = if start_ed + 146097 < max_ed { start_ed + 146097 } else { max_ed }
  let mut ed = start_ed
  while ed <= hard_max {
    if sorted_bymonth.length() > 0 {
      let d = date_from_ed(ed)
      if (bymonth_mask & (1 << d.month)) == 0 {
        // Jump directly to day 1 of the next allowed month
        let idx = lower_bound_int(sorted_bymonth, d.month)
        let (ny, nm) = if idx < sorted_bymonth.length() {
          (d.year, sorted_bymonth[idx])
        } else {
          (d.year + 1, sorted_bymonth[0])
        }
        if ny > 9999 {
          return None
        }
        ed = ymd_to_ed(ny, nm, 1)
        continue
      }
    }
    if day_matches_filters(rule, byday_wd_mask, bymonth_mask, ed) {
      return Some(ed)
    }
    ed = ed + 1
  }
  None
}

///| Check whether a sub-daily rule's `(INTERVAL, dtstart)` time-of-day grid can ever hit an allowed time.
fn subdaily_grid_satisfiable(
  rule : RRule,
  dtstart : time::DateTime,
  sorted_byhour : Array[Int],
  sorted_byminute : Array[Int],
  sorted_bysecond : Array[Int],
) -> Bool {
  match rule.freq {
    Freq::Hourly => {
      if sorted_byhour.length() == 0 {
        return true
      }
      let step = rule.interval.to_int64() * 3600L
      let g = gcd64(step, 86400L)
      if g <= 3600L {
        return true
      }
      let rem0 = (dtstart.time.hour.to_int64() * 3600L) % g
      let mut i = 0
      while i < sorted_byhour.length() {
        if (sorted_byhour[i].to_int64() * 3600L) % g == rem0 {
          return true
        }
        i = i + 1
      }
      false
    }
    Freq::Minutely => {
      if sorted_byhour.length() == 0 && sorted_byminute.length() == 0 {
        return true
      }
      let step = rule.interval.to_int64() * 60L
      let g = gcd64(step, 86400L)
      if g <= 60L {
        return true
      }
      let rem0 = (dtstart.time.hour.to_int64() * 3600L + dtstart.time.minute.to_int64() * 60L) % g
      let mut h = 0
      while h < 24 {
        if sorted_byhour.length() == 0 || array_contains_int_sorted(sorted_byhour, h) {
          let mut m = 0
          while m < 60 {
            if sorted_byminute.length() == 0 || array_contains_int_sorted(sorted_byminute, m) {
              if (h.to_int64() * 3600L + m.to_int64() * 60L) % g == rem0 {
                return true
              }
            }
            m = m + 1
          }
        }
        h = h + 1
      }
      false
    }
    Freq::Secondly => {
      if sorted_byhour.length() == 0 && sorted_byminute.length() == 0 && sorted_bysecond.length() == 0 {
        return true
      }
      let step = rule.interval.to_int64()
      let g = gcd64(step, 86400L)
      if g <= 1L {
        return true
      }
      let rem0 = dtstart.time.to_second_of_day().to_int64() % g
      let mut h = 0
      while h < 24 {
        if sorted_byhour.length() == 0 || array_contains_int_sorted(sorted_byhour, h) {
          let mut m = 0
          while m < 60 {
            if sorted_byminute.length() == 0 || array_contains_int_sorted(sorted_byminute, m) {
              let mut s = 0
              while s < 60 {
                if sorted_bysecond.length() == 0 || array_contains_int_sorted(sorted_bysecond, s) {
                  if (h.to_int64() * 3600L + m.to_int64() * 60L + s.to_int64()) % g == rem0 {
                    return true
                  }
                }
                s = s + 1
              }
            }
            m = m + 1
          }
        }
        h = h + 1
      }
      false
    }
    _ => true
  }
}

///| Advance `cur_sec` along the `step`-second grid to the smallest grid point `>= target_sec`.
#verify
pub fn jump_grid_to(cur_sec : Int64, target_sec : Int64, step : Int64) -> Int64 {
  if target_sec <= cur_sec {
    return cur_sec + step
  }
  let diff = target_sec - cur_sec
  let steps = (diff + step - 1L) / step
  cur_sec + steps * step
}

///| Stateful recurrence expansion iterator (lazy streaming, O(|days| + |timeset|) memory).
pub struct RRuleIter {
  rule : RRule
  dtstart : time::DateTime
  dtstart_ed : Int
  dtstart_sod : Int
  dtstart_wd : Int
  dtstart_sec : Int64
  tz : Option[time::TimeZone]
  disambiguation : time::Disambiguation
  until_ts : Option[time::Timestamp]
  has_until : Bool
  has_zoned_utc_until : Bool
  until_sec : Int64
  byday_wd_mask : Int
  bymonth_mask : Int
  byday_has_ord : Bool
  timeset : Array[Int]
  timeset_times : Array[time::Time]
  sorted_bymonth : Array[Int]
  sorted_byhour : Array[Int]
  sorted_byminute : Array[Int]
  sorted_bysecond : Array[Int]
  days_buf : Array[Int]
  single_day_buf : Array[Int]
  mut cur_year : Int
  mut cur_month : Int
  mut cur_ed : Int
  mut cur_sec : Int64
  mut emitted : Int
  mut cur_days : Array[Int]
  mut day_idx : Int
  mut time_idx : Int
  mut buf : Array[time::DateTime]
  mut buf_idx : Int
  mut done : Bool
}

///| Create a streaming recurrence iterator starting at `dtstart` (civil / UTC).
pub fn RRule::iter(self : RRule, dtstart : time::DateTime) -> RRuleIter {
  rrule_iter_internal(self, dtstart, None, time::Disambiguation::Compatible)
}

///| Create a timezone-aware streaming recurrence iterator (honors `until_is_utc` in `tz`).
pub fn RRule::iter_with_tz(
  self : RRule,
  dtstart : time::DateTime,
  tz : time::TimeZone,
  disambiguation : time::Disambiguation,
) -> RRuleIter {
  rrule_iter_internal(self, dtstart, Some(tz), disambiguation)
}

///| Internal constructor for `RRuleIter`.
fn rrule_iter_internal(
  self : RRule,
  dtstart : time::DateTime,
  tz : Option[time::TimeZone],
  disambiguation : time::Disambiguation,
) -> RRuleIter {
  let ed = dtstart.date.to_epoch_days()
  let sod = dtstart.time.to_second_of_day()
  let wkst_m0 = time::weekday_to_monday_zero_offset(self.wkst)
  let dt_wd = epoch_day_weekday_mon0(ed)
  let week_start = ed - (dt_wd - wkst_m0 + 7) % 7
  let start_sec = ed.to_int64() * 86400L + sod.to_int64()
  let timeset = match self.freq {
    Freq::Yearly | Freq::Monthly | Freq::Weekly | Freq::Daily => build_timeset(self, dtstart)
    _ => []
  }
  let timeset_times = build_timeset_times(timeset)
  let byday_wd_mask = compute_byday_wd_mask(self.byday)
  let bymonth_mask = compute_bymonth_mask(self.bymonth)
  let byday_has_ord = byday_has_ordinal(self.byday)
  let sorted_bymonth = sort_dedup_ints(copy_int_array(self.bymonth))
  let sorted_byhour = sort_dedup_ints(copy_int_array(self.byhour))
  let sorted_byminute = sort_dedup_ints(copy_int_array(self.byminute))
  let sorted_bysecond = if self.bysecond.length() > 0 {
    normalized_bysecond(self, dtstart)
  } else {
    []
  }
  let until_ts : Option[time::Timestamp] = if self.until_is_utc {
    match self.until {
      Some(u) =>
      match time::Offset::utc().to_timestamp(u) {
        Ok(ts) => Some(ts)
        Err(_) => None
      }
      None => None
    }
  } else {
    None
  }
  let has_until = match self.until { Some(_) => true; None => false }
  let until_sec = match self.until {
    Some(u) => dt_to_epoch_sec(u)
    None => 0L
  }
  let has_zoned_utc_until = match (tz, until_ts) {
    (Some(_), Some(_)) => true
    _ => false
  }
  let mut initial_done = match self.count {
    Some(0) => true
    _ => false
  }
  if !initial_done && !subdaily_grid_satisfiable(self, dtstart, sorted_byhour, sorted_byminute, sorted_bysecond) {
    initial_done = true
  }
  let init_ed = match self.freq {
    Freq::Weekly => week_start
    _ => ed
  }
  RRuleIter::{
    rule: self,
    dtstart: dtstart,
    dtstart_ed: ed,
    dtstart_sod: sod,
    dtstart_wd: dt_wd,
    dtstart_sec: start_sec,
    tz: tz,
    disambiguation: disambiguation,
    until_ts: until_ts,
    has_until: has_until,
    has_zoned_utc_until: has_zoned_utc_until,
    until_sec: until_sec,
    byday_wd_mask: byday_wd_mask,
    bymonth_mask: bymonth_mask,
    byday_has_ord: byday_has_ord,
    timeset: timeset,
    timeset_times: timeset_times,
    sorted_bymonth: sorted_bymonth,
    sorted_byhour: sorted_byhour,
    sorted_byminute: sorted_byminute,
    sorted_bysecond: sorted_bysecond,
    days_buf: Array::with_capacity(32),
    single_day_buf: [0],
    cur_year: dtstart.date.year,
    cur_month: dtstart.date.month,
    cur_ed: init_ed,
    cur_sec: start_sec,
    emitted: 0,
    cur_days: [],
    day_idx: 0,
    time_idx: 0,
    buf: [],
    buf_idx: 0,
    done: initial_done,
  }
}

///| O(1) period fast-forward for COUNT-less rules when querying windows starting at `target_ed`.
///| Guarantees no occurrence with epoch day `>= target_ed` is skipped.
fn RRuleIter::fast_forward_to_ed(self : RRuleIter, target_ed : Int) -> Unit {
  if self.done {
    return
  }
  match self.rule.count {
    Some(_) => return
    None => ()
  }
  let iv = self.rule.interval.to_int64()
  if iv <= 0L {
    return
  }
  match self.rule.freq {
    Freq::Daily => {
      let diff = target_ed.to_int64() - self.cur_ed.to_int64()
      if diff > iv {
        let skip = (diff - 1L) / iv
        let next_ed = self.cur_ed.to_int64() + skip * iv
        self.cur_ed = if next_ed > 2932897L { 2932897 } else { next_ed.to_int() }
      }
    }
    Freq::Weekly => {
      let step = iv * 7L
      let diff = target_ed.to_int64() - 7L - self.cur_ed.to_int64()
      if diff >= step {
        let skip = diff / step
        let next_ed = self.cur_ed.to_int64() + skip * step
        self.cur_ed = if next_ed > 2932897L { 2932897 } else { next_ed.to_int() }
      }
    }
    Freq::Monthly => {
      let td = date_from_ed(target_ed)
      let cur_m = self.cur_year.to_int64() * 12L + (self.cur_month - 1).to_int64()
      let tgt_m = td.year.to_int64() * 12L + (td.month - 1).to_int64() - 1L
      let diff = tgt_m - cur_m
      if diff >= iv {
        let skip = diff / iv
        let nm = cur_m + skip * iv
        let ny = nm / 12L
        if ny > 10000L {
          self.cur_year = 10000
          self.cur_month = 1
        } else {
          self.cur_year = ny.to_int()
          self.cur_month = (nm - ny * 12L).to_int() + 1
        }
      }
    }
    Freq::Yearly => {
      let ty = date_from_ed(target_ed).year
      let diff = (ty - 1).to_int64() - self.cur_year.to_int64()
      if diff >= iv {
        let skip = diff / iv
        let ny = self.cur_year.to_int64() + skip * iv
        self.cur_year = if ny > 10000L { 10000 } else { ny.to_int() }
      }
    }
    _ => ()
  }
}

///| Check candidate `c` against `UNTIL` (returns `0` = ok, `1` = skip this candidate, `2` = past until, stop).
fn RRuleIter::check_until(self : RRuleIter, c : time::DateTime) -> Result[Int, IcalError] {
  match self.rule.until {
    None => Ok(0)
    Some(u) =>
    match (self.tz, self.until_ts) {
      (Some(tz), Some(uts)) => {
        // Zoned comparison against UTC UNTIL instant (RFC 5545 §3.3.10)
        let z = match tz.to_ambiguous_zoned(c).disambiguate(self.disambiguation) {
          Ok(v) => v
          Err(e) => return Err(IcalError::InvalidDateTime(e.message))
        }
        if z.timestamp.cmp(uts) <= 0 {
          Ok(0)
        } else if dt_to_epoch_sec(c) > dt_to_epoch_sec(u) + 86400L {
          Ok(2)
        } else {
          Ok(1)
        }
      }
      _ => if c.cmp(u) > 0 { Ok(2) } else { Ok(0) }
    }
  }
}

///| Refill either `(cur_days, day_idx, time_idx)` (lazy) or `self.buf` from the next period.
fn RRuleIter::refill(self : RRuleIter) -> Result[Bool, IcalError] {
  let max_empty = match self.rule.freq {
    Freq::Yearly => 400
    Freq::Monthly => 4800
    Freq::Weekly => 20800
    Freq::Daily => 146097
    _ => 200000
  }
  let mut empty_periods = 0
  let rule = self.rule
  let has_zoned_utc_until = match (self.tz, self.until_ts) {
    (Some(_), Some(_)) => true
    _ => false
  }
  let until_day_slack = if has_zoned_utc_until { 2 } else { 0 }

  while empty_periods <= max_empty {
    match rule.freq {
      Freq::Yearly => {
        if self.cur_year > 9999 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => if self.cur_year > u.date.year + 1 {
            self.done = true
            return Ok(false)
          }
          None => ()
        }
        let days = yearly_candidate_days(rule, self.dtstart, self.cur_year)
        let next_y = self.cur_year.to_int64() + rule.interval.to_int64()
        self.cur_year = if next_y > 10000L { 10000 } else { next_y.to_int() }
        if days.length() > 0 && self.timeset.length() > 0 {
          if rule.bysetpos.length() > 0 {
            let sel = apply_bysetpos_grid(days, self.timeset_times, rule.bysetpos)
            if sel.length() > 0 {
              self.buf = sel
              self.buf_idx = 0
              return Ok(true)
            }
          } else {
            self.cur_days = days
            self.day_idx = 0
            self.time_idx = 0
            return Ok(true)
          }
        }
      }
      Freq::Monthly => {
        if self.cur_year > 9999 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => {
            let lim_y = u.date.year
            let lim_m = u.date.month + (if has_zoned_utc_until { 1 } else { 0 })
            if self.cur_year > lim_y + (lim_m - 1) / 12 ||
            (self.cur_year == lim_y + (lim_m - 1) / 12 && self.cur_month > ((lim_m - 1) % 12) + 1) {
              self.done = true
              return Ok(false)
            }
          }
          None => ()
        }
        monthly_candidate_days_into(
          rule,
          self.dtstart,
          self.byday_wd_mask,
          self.bymonth_mask,
          self.byday_has_ord,
          self.cur_year,
          self.cur_month,
          self.days_buf,
        )
        let total_months = (self.cur_month - 1).to_int64() + rule.interval.to_int64()
        let next_y = self.cur_year.to_int64() + total_months / 12L
        if next_y > 10000L {
          self.cur_year = 10000
          self.cur_month = 1
        } else {
          self.cur_year = next_y.to_int()
          self.cur_month = (total_months % 12L).to_int() + 1
        }
        if self.days_buf.length() > 0 && self.timeset.length() > 0 {
          if rule.bysetpos.length() > 0 {
            let sel = apply_bysetpos_grid(self.days_buf, self.timeset_times, rule.bysetpos)
            if sel.length() > 0 {
              self.buf = sel
              self.buf_idx = 0
              return Ok(true)
            }
          } else {
            self.cur_days = self.days_buf
            self.day_idx = 0
            self.time_idx = 0
            return Ok(true)
          }
        }
      }
      Freq::Weekly => {
        if self.cur_ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => if self.cur_ed > u.date.to_epoch_days() + until_day_slack {
            self.done = true
            return Ok(false)
          }
          None => ()
        }
        weekly_candidate_days_into(
          rule,
          self.dtstart_wd,
          self.byday_wd_mask,
          self.bymonth_mask,
          self.cur_ed,
          self.days_buf,
        )
        let next_ed = self.cur_ed.to_int64() + rule.interval.to_int64() * 7L
        self.cur_ed = if next_ed > 2932897L { 2932897 } else { next_ed.to_int() }
        if self.days_buf.length() > 0 && self.timeset.length() > 0 {
          if rule.bysetpos.length() > 0 {
            let sel = apply_bysetpos_grid(self.days_buf, self.timeset_times, rule.bysetpos)
            if sel.length() > 0 {
              self.buf = sel
              self.buf_idx = 0
              return Ok(true)
            }
          } else {
            self.cur_days = self.days_buf
            self.day_idx = 0
            self.time_idx = 0
            return Ok(true)
          }
        }
      }
      Freq::Daily => {
        if self.cur_ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => if self.cur_ed > u.date.to_epoch_days() + until_day_slack {
            self.done = true
            return Ok(false)
          }
          None => ()
        }
        let ed = self.cur_ed
        let next_ed = self.cur_ed.to_int64() + rule.interval.to_int64()
        self.cur_ed = if next_ed > 2932897L { 2932897 } else { next_ed.to_int() }
        if day_matches_filters(rule, self.byday_wd_mask, self.bymonth_mask, ed) &&
        self.timeset.length() > 0 {
          self.single_day_buf[0] = ed
          if rule.bysetpos.length() > 0 {
            let sel = apply_bysetpos_grid(self.single_day_buf, self.timeset_times, rule.bysetpos)
            if sel.length() > 0 {
              self.buf = sel
              self.buf_idx = 0
              return Ok(true)
            }
          } else {
            self.cur_days = self.single_day_buf
            self.day_idx = 0
            self.time_idx = 0
            return Ok(true)
          }
        }
      }
      Freq::Hourly => {
        let ed = floor_div_86400(self.cur_sec)
        let sod = (self.cur_sec - ed.to_int64() * 86400L).to_int()
        let hour = sod / 3600
        if ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        let max_ed = match rule.until {
          Some(u) => {
            let u_sec = dt_to_epoch_sec(u) + (if has_zoned_utc_until { 86400L } else { 0L })
            if self.cur_sec > u_sec + 3600L {
              self.done = true
              return Ok(false)
            }
            u.date.to_epoch_days() + until_day_slack
          }
          None => 2932896
        }
        let step = rule.interval.to_int64() * 3600L
        if !day_matches_filters(rule, self.byday_wd_mask, self.bymonth_mask, ed) {
          match next_matching_day(rule, self.byday_wd_mask, self.bymonth_mask, self.sorted_bymonth, ed + 1, max_ed) {
            Some(ned) => {
              self.cur_sec = jump_grid_to(self.cur_sec, ned.to_int64() * 86400L, step)
              empty_periods = empty_periods + 1
              continue
            }
            None => {
              self.done = true
              return Ok(false)
            }
          }
        }
        if self.sorted_byhour.length() > 0 && !array_contains_int_sorted(self.sorted_byhour, hour) {
          let idx = lower_bound_int(self.sorted_byhour, hour + 1)
          let target = if idx < self.sorted_byhour.length() {
            ed.to_int64() * 86400L + self.sorted_byhour[idx].to_int64() * 3600L
          } else {
            (ed + 1).to_int64() * 86400L
          }
          self.cur_sec = jump_grid_to(self.cur_sec, target, step)
          empty_periods = empty_periods + 1
          continue
        }
        let mins = if self.sorted_byminute.length() > 0 {
          self.sorted_byminute
        } else {
          [self.dtstart.time.minute]
        }
        let secs = if self.sorted_bysecond.length() > 0 {
          self.sorted_bysecond
        } else {
          [self.dtstart.time.second]
        }
        let period_cands : Array[time::DateTime] = []
        let mut mi = 0
        while mi < mins.length() {
          let mut si = 0
          while si < secs.length() {
            period_cands.push(ed_sec_to_datetime(ed, hour * 3600 + mins[mi] * 60 + secs[si]))
            si = si + 1
          }
          mi = mi + 1
        }
        self.cur_sec = self.cur_sec + step
        let sel = apply_bysetpos(period_cands, rule.bysetpos)
        if sel.length() > 0 {
          self.buf = sel
          self.buf_idx = 0
          return Ok(true)
        }
      }
      Freq::Minutely => {
        let ed = floor_div_86400(self.cur_sec)
        let sod = (self.cur_sec - ed.to_int64() * 86400L).to_int()
        let hour = sod / 3600
        let minute = (sod - hour * 3600) / 60
        if ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        let max_ed = match rule.until {
          Some(u) => {
            let u_sec = dt_to_epoch_sec(u) + (if has_zoned_utc_until { 86400L } else { 0L })
            if self.cur_sec > u_sec + 60L {
              self.done = true
              return Ok(false)
            }
            u.date.to_epoch_days() + until_day_slack
          }
          None => 2932896
        }
        let step = rule.interval.to_int64() * 60L
        if !day_matches_filters(rule, self.byday_wd_mask, self.bymonth_mask, ed) {
          match next_matching_day(rule, self.byday_wd_mask, self.bymonth_mask, self.sorted_bymonth, ed + 1, max_ed) {
            Some(ned) => {
              self.cur_sec = jump_grid_to(self.cur_sec, ned.to_int64() * 86400L, step)
              empty_periods = empty_periods + 1
              continue
            }
            None => {
              self.done = true
              return Ok(false)
            }
          }
        }
        if self.sorted_byhour.length() > 0 && !array_contains_int_sorted(self.sorted_byhour, hour) {
          let idx = lower_bound_int(self.sorted_byhour, hour + 1)
          let target = if idx < self.sorted_byhour.length() {
            ed.to_int64() * 86400L + self.sorted_byhour[idx].to_int64() * 3600L
          } else {
            (ed + 1).to_int64() * 86400L
          }
          self.cur_sec = jump_grid_to(self.cur_sec, target, step)
          empty_periods = empty_periods + 1
          continue
        }
        if self.sorted_byminute.length() > 0 && !array_contains_int_sorted(self.sorted_byminute, minute) {
          let idx = lower_bound_int(self.sorted_byminute, minute + 1)
          let target = if idx < self.sorted_byminute.length() {
            ed.to_int64() * 86400L + hour.to_int64() * 3600L + self.sorted_byminute[idx].to_int64() * 60L
          } else {
            ed.to_int64() * 86400L + (hour + 1).to_int64() * 3600L
          }
          self.cur_sec = jump_grid_to(self.cur_sec, target, step)
          empty_periods = empty_periods + 1
          continue
        }
        let secs = if self.sorted_bysecond.length() > 0 {
          self.sorted_bysecond
        } else {
          [self.dtstart.time.second]
        }
        let period_cands : Array[time::DateTime] = []
        let mut si = 0
        while si < secs.length() {
          period_cands.push(ed_sec_to_datetime(ed, hour * 3600 + minute * 60 + secs[si]))
          si = si + 1
        }
        self.cur_sec = self.cur_sec + step
        let sel = apply_bysetpos(period_cands, rule.bysetpos)
        if sel.length() > 0 {
          self.buf = sel
          self.buf_idx = 0
          return Ok(true)
        }
      }
      Freq::Secondly => {
        let ed = floor_div_86400(self.cur_sec)
        let sod = (self.cur_sec - ed.to_int64() * 86400L).to_int()
        let hour = sod / 3600
        let rem = sod - hour * 3600
        let minute = rem / 60
        let second = rem - minute * 60
        if ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        let max_ed = match rule.until {
          Some(u) => {
            let u_sec = dt_to_epoch_sec(u) + (if has_zoned_utc_until { 86400L } else { 0L })
            if self.cur_sec > u_sec {
              self.done = true
              return Ok(false)
            }
            u.date.to_epoch_days() + until_day_slack
          }
          None => 2932896
        }
        let step = rule.interval.to_int64()
        if !day_matches_filters(rule, self.byday_wd_mask, self.bymonth_mask, ed) {
          match next_matching_day(rule, self.byday_wd_mask, self.bymonth_mask, self.sorted_bymonth, ed + 1, max_ed) {
            Some(ned) => {
              self.cur_sec = jump_grid_to(self.cur_sec, ned.to_int64() * 86400L, step)
              empty_periods = empty_periods + 1
              continue
            }
            None => {
              self.done = true
              return Ok(false)
            }
          }
        }
        if self.sorted_byhour.length() > 0 && !array_contains_int_sorted(self.sorted_byhour, hour) {
          let idx = lower_bound_int(self.sorted_byhour, hour + 1)
          let target = if idx < self.sorted_byhour.length() {
            ed.to_int64() * 86400L + self.sorted_byhour[idx].to_int64() * 3600L
          } else {
            (ed + 1).to_int64() * 86400L
          }
          self.cur_sec = jump_grid_to(self.cur_sec, target, step)
          empty_periods = empty_periods + 1
          continue
        }
        if self.sorted_byminute.length() > 0 && !array_contains_int_sorted(self.sorted_byminute, minute) {
          let idx = lower_bound_int(self.sorted_byminute, minute + 1)
          let target = if idx < self.sorted_byminute.length() {
            ed.to_int64() * 86400L + hour.to_int64() * 3600L + self.sorted_byminute[idx].to_int64() * 60L
          } else {
            ed.to_int64() * 86400L + (hour + 1).to_int64() * 3600L
          }
          self.cur_sec = jump_grid_to(self.cur_sec, target, step)
          empty_periods = empty_periods + 1
          continue
        }
        if self.sorted_bysecond.length() > 0 && !array_contains_int_sorted(self.sorted_bysecond, second) {
          let idx = lower_bound_int(self.sorted_bysecond, second + 1)
          let target = if idx < self.sorted_bysecond.length() {
            ed.to_int64() * 86400L + hour.to_int64() * 3600L + minute.to_int64() * 60L + self.sorted_bysecond[idx].to_int64()
          } else {
            ed.to_int64() * 86400L + hour.to_int64() * 3600L + (minute + 1).to_int64() * 60L
          }
          self.cur_sec = jump_grid_to(self.cur_sec, target, step)
          empty_periods = empty_periods + 1
          continue
        }
        let period_cands = [ed_sec_to_datetime(ed, sod)]
        self.cur_sec = self.cur_sec + step
        let sel = apply_bysetpos(period_cands, rule.bysetpos)
        if sel.length() > 0 {
          self.buf = sel
          self.buf_idx = 0
          return Ok(true)
        }
      }
    }
    empty_periods = empty_periods + 1
  }

  self.done = true
  Ok(false)
}

///| Advance the iterator and return the next occurrence directly as epoch seconds (UTC/civil fast path).
///| Requires `self.tz` is `None`. Avoids constructing `time::DateTime` on the common `(cur_days × timeset)` path.
fn RRuleIter::next_epoch_sec(self : RRuleIter) -> Result[Option[Int64], IcalError] {
  if self.done {
    return Ok(None)
  }
  match self.rule.count {
    Some(c) => if self.emitted >= c {
      self.done = true
      return Ok(None)
    }
    None => ()
  }
  while true {
    if self.buf_idx < self.buf.length() {
      let c = self.buf[self.buf_idx]
      self.buf_idx = self.buf_idx + 1
      let sec = dt_to_epoch_sec(c)
      if sec < self.dtstart_sec {
        continue
      }
      if self.has_until && sec > self.until_sec {
        self.done = true
        return Ok(None)
      }
      self.emitted = self.emitted + 1
      return Ok(Some(sec))
    }
    if self.day_idx < self.cur_days.length() {
      while self.day_idx < self.cur_days.length() && self.cur_days[self.day_idx] < self.dtstart_ed {
        self.day_idx = self.day_idx + 1
        self.time_idx = 0
      }
      if self.day_idx >= self.cur_days.length() {
        continue
      }
      let ed = self.cur_days[self.day_idx]
      if ed == self.dtstart_ed && self.time_idx < self.timeset.length() && self.timeset[self.time_idx] < self.dtstart_sod {
        self.time_idx = lower_bound_int(self.timeset, self.dtstart_sod)
      }
      if self.time_idx >= self.timeset.length() {
        self.day_idx = self.day_idx + 1
        self.time_idx = 0
        continue
      }
      let sod = self.timeset[self.time_idx]
      self.time_idx = self.time_idx + 1
      let sec = ed.to_int64() * 86400L + sod.to_int64()
      if self.has_until && sec > self.until_sec {
        self.done = true
        return Ok(None)
      }
      self.emitted = self.emitted + 1
      return Ok(Some(sec))
    }
    match self.refill() {
      Ok(true) => ()
      Ok(false) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  Ok(None)
}

///| Advance the iterator and return the next recurrence `DateTime`.
pub fn RRuleIter::next(self : RRuleIter) -> Result[Option[time::DateTime], IcalError] {
  if self.done {
    return Ok(None)
  }
  match self.rule.count {
    Some(c) => if self.emitted >= c {
      self.done = true
      return Ok(None)
    }
    None => ()
  }
  while true {
    if self.buf_idx < self.buf.length() {
      let c = self.buf[self.buf_idx]
      self.buf_idx = self.buf_idx + 1
      if c.cmp(self.dtstart) < 0 {
        continue
      }
      if !self.has_until {
        self.emitted = self.emitted + 1
        return Ok(Some(c))
      }
      match self.check_until(c) {
        Ok(0) => {
          self.emitted = self.emitted + 1
          return Ok(Some(c))
        }
        Ok(1) => continue
        Ok(_) => {
          self.done = true
          return Ok(None)
        }
        Err(e) => return Err(e)
      }
    }
    if self.day_idx < self.cur_days.length() {
      // Skip days strictly before dtstart_ed
      while self.day_idx < self.cur_days.length() && self.cur_days[self.day_idx] < self.dtstart_ed {
        self.day_idx = self.day_idx + 1
        self.time_idx = 0
      }
      if self.day_idx >= self.cur_days.length() {
        continue
      }
      let ed = self.cur_days[self.day_idx]
      if ed == self.dtstart_ed && self.time_idx < self.timeset.length() && self.timeset[self.time_idx] < self.dtstart_sod {
        self.time_idx = lower_bound_int(self.timeset, self.dtstart_sod)
      }
      if self.time_idx >= self.timeset.length() {
        self.day_idx = self.day_idx + 1
        self.time_idx = 0
        continue
      }
      let ti = self.time_idx
      self.time_idx = ti + 1
      if !self.has_until {
        self.emitted = self.emitted + 1
        return Ok(Some(time::DateTime::{ date: date_from_ed(ed), time: self.timeset_times[ti] }))
      }
      if !self.has_zoned_utc_until {
        let sec = ed.to_int64() * 86400L + self.timeset[ti].to_int64()
        if sec > self.until_sec {
          self.done = true
          return Ok(None)
        }
        self.emitted = self.emitted + 1
        return Ok(Some(time::DateTime::{ date: date_from_ed(ed), time: self.timeset_times[ti] }))
      }
      let c = time::DateTime::{ date: date_from_ed(ed), time: self.timeset_times[ti] }
      match self.check_until(c) {
        Ok(0) => {
          self.emitted = self.emitted + 1
          return Ok(Some(c))
        }
        Ok(1) => continue
        Ok(_) => {
          self.done = true
          return Ok(None)
        }
        Err(e) => return Err(e)
      }
    }
    match self.refill() {
      Ok(true) => ()
      Ok(false) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  Ok(None)
}

///| Expand up to `limit` occurrences of `self` starting at `dtstart`.
pub fn RRule::all(
  self : RRule,
  dtstart : time::DateTime,
  limit : Int,
) -> Result[Array[time::DateTime], IcalError] {
  if limit <= 0 {
    return Ok([])
  }
  let est = match self.count {
    Some(c) => if c < limit { c } else { limit }
    None => limit
  }
  let cap = if est > 1024 { 1024 } else if est > 0 { est } else { 0 }
  let out : Array[time::DateTime] = Array::with_capacity(cap)
  let it = self.iter(dtstart)
  while out.length() < limit {
    match it.next() {
      Ok(Some(v)) => out.push(v)
      Ok(None) => break
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///| Expand occurrences in window `(after, before)` (or `[after, before]` if `inclusive`).
pub fn RRule::between(
  self : RRule,
  dtstart : time::DateTime,
  after : time::DateTime,
  before : time::DateTime,
  inclusive : Bool,
) -> Result[Array[time::DateTime], IcalError] {
  let out : Array[time::DateTime] = []
  if after.cmp(before) > 0 {
    return Ok(out)
  }
  let it = self.iter(dtstart)
  while true {
    match it.next() {
      Ok(Some(v)) => {
        let cb = v.cmp(before)
        if cb > 0 || (!inclusive && cb == 0) {
          break
        }
        let ca = v.cmp(after)
        if ca > 0 || (inclusive && ca == 0) {
          out.push(v)
        }
      }
      Ok(None) => break
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///| Return the first occurrence after (or at, if `inclusive`) `dt`.
pub fn RRule::after(
  self : RRule,
  dtstart : time::DateTime,
  dt : time::DateTime,
  inclusive : Bool,
) -> Result[Option[time::DateTime], IcalError] {
  let it = self.iter(dtstart)
  while true {
    match it.next() {
      Ok(Some(v)) => {
        let c = v.cmp(dt)
        if c > 0 || (inclusive && c == 0) {
          return Ok(Some(v))
        }
      }
      Ok(None) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  Ok(None)
}

///| Return the last occurrence before (or at, if `inclusive`) `dt`.
pub fn RRule::before(
  self : RRule,
  dtstart : time::DateTime,
  dt : time::DateTime,
  inclusive : Bool,
) -> Result[Option[time::DateTime], IcalError] {
  let it = self.iter(dtstart)
  let mut last : Option[time::DateTime] = None
  while true {
    match it.next() {
      Ok(Some(v)) => {
        let c = v.cmp(dt)
        if c > 0 || (!inclusive && c == 0) {
          return Ok(last)
        }
        last = Some(v)
      }
      Ok(None) => return Ok(last)
      Err(e) => return Err(e)
    }
  }
  Ok(last)
}
