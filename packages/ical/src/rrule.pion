///| RFC 5545 §3.3.10 / §3.8.5.3 RRULE parser, formatter, and recurrence expansion engine.

import "time"

///| Parsed RFC 5545 recurrence rule (`RRULE`).
pub struct RRule {
  pub freq : Freq
  pub interval : Int
  pub count : Option[Int]
  pub until : Option[time::DateTime]
  pub until_is_utc : Bool
  pub wkst : time::Weekday
  pub bysetpos : Array[Int]
  pub bymonth : Array[Int]
  pub bymonthday : Array[Int]
  pub byyearday : Array[Int]
  pub byweekno : Array[Int]
  pub byday : Array[NWeekday]
  pub byhour : Array[Int]
  pub byminute : Array[Int]
  pub bysecond : Array[Int]
  pub rscale : Option[String]
  pub skip : Option[String]
}

///| Parse a signed integer in `[min_val, max_val]` from slice `[start, end)`.
fn parse_int_range(
  s : String,
  start : Int,
  end : Int,
  min_val : Int,
  max_val : Int,
  allow_zero : Bool,
) -> Result[Int, IcalError] {
  if start >= end {
    return Err(IcalError::InvalidRRule("empty integer in RRULE"))
  }
  let mut pos = start
  let mut neg = false
  let c0 = s.code_unit_at(pos)
  if c0 == 45 {
    neg = true
    pos = pos + 1
  } else if c0 == 43 {
    pos = pos + 1
  }
  if pos >= end {
    return Err(IcalError::InvalidRRule("expected digits after sign in RRULE"))
  }
  let mut acc = 0
  let mut digits = 0
  while pos < end {
    let d = s.code_unit_at(pos) - 48
    if d < 0 || d > 9 {
      return Err(IcalError::InvalidRRule("non-digit in RRULE integer"))
    }
    digits = digits + 1
    if digits > 9 {
      return Err(IcalError::InvalidRRule("integer overflow in RRULE"))
    }
    acc = acc * 10 + d
    pos = pos + 1
  }
  let num = if neg { -acc } else { acc }
  if (!allow_zero && num == 0) || num < min_val || num > max_val {
    return Err(IcalError::InvalidRRule("RRULE integer out of range: " + num.to_string()))
  }
  Ok(num)
}

///| Parse a comma-separated list of integers in `[min_val, max_val]`.
fn parse_int_list(
  s : String,
  start : Int,
  end : Int,
  min_val : Int,
  max_val : Int,
  allow_zero : Bool,
) -> Result[Array[Int], IcalError] {
  let out : Array[Int] = []
  let mut pos = start
  while pos <= end {
    let mut comma = pos
    while comma < end && s.code_unit_at(comma) != 44 {
      comma = comma + 1
    }
    match parse_int_range(s, pos, comma, min_val, max_val, allow_zero) {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
    if comma >= end {
      break
    }
    pos = comma + 1
  }
  if out.length() == 0 {
    return Err(IcalError::InvalidRRule("empty integer list in RRULE"))
  }
  Ok(out)
}

///| Parse a 2-letter RFC 5545 weekday (`MO`..`SU`).
fn parse_weekday_2(s : String, pos : Int) -> Result[time::Weekday, IcalError] {
  if pos + 2 > s.length() {
    return Err(IcalError::InvalidRRule("truncated weekday"))
  }
  let mut a = s.code_unit_at(pos)
  let mut b = s.code_unit_at(pos + 1)
  if a >= 97 && a <= 122 {
    a = a - 32
  }
  if b >= 97 && b <= 122 {
    b = b - 32
  }
  if a == 77 && b == 79 {
    return Ok(time::Weekday::Mon)
  }
  if a == 84 && b == 85 {
    return Ok(time::Weekday::Tue)
  }
  if a == 87 && b == 69 {
    return Ok(time::Weekday::Wed)
  }
  if a == 84 && b == 72 {
    return Ok(time::Weekday::Thu)
  }
  if a == 70 && b == 82 {
    return Ok(time::Weekday::Fri)
  }
  if a == 83 && b == 65 {
    return Ok(time::Weekday::Sat)
  }
  if a == 83 && b == 85 {
    return Ok(time::Weekday::Sun)
  }
  Err(IcalError::InvalidRRule("invalid weekday token"))
}

///| Format a `time::Weekday` as a 2-letter RFC 5545 token.
fn weekday_to_ical(w : time::Weekday) -> String {
  match w {
    time::Weekday::Mon => "MO"
    time::Weekday::Tue => "TU"
    time::Weekday::Wed => "WE"
    time::Weekday::Thu => "TH"
    time::Weekday::Fri => "FR"
    time::Weekday::Sat => "SA"
    time::Weekday::Sun => "SU"
  }
}

///| Parse a comma-separated `BYDAY` list (e.g. `MO,2TU,-1FR`).
fn parse_byday_list(s : String, start : Int, end : Int) -> Result[Array[NWeekday], IcalError] {
  let out : Array[NWeekday] = []
  let mut pos = start
  while pos <= end {
    let mut comma = pos
    while comma < end && s.code_unit_at(comma) != 44 {
      comma = comma + 1
    }
    let tok_len = comma - pos
    if tok_len < 2 {
      return Err(IcalError::InvalidRRule("invalid BYDAY token"))
    }
    let wd_pos = comma - 2
    let wd = match parse_weekday_2(s, wd_pos) {
      Ok(w) => w
      Err(e) => return Err(e)
    }
    let ord = if wd_pos > pos {
      match parse_int_range(s, pos, wd_pos, -53, 53, false) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else {
      0
    }
    out.push(NWeekday::{ weekday: wd, n: ord })
    if comma >= end {
      break
    }
    pos = comma + 1
  }
  if out.length() == 0 {
    return Err(IcalError::InvalidRRule("empty BYDAY list"))
  }
  Ok(out)
}

///| Parse an RFC 5545 `RRULE` value (optional leading `RRULE:`).
pub fn RRule::parse(s : String) -> Result[RRule, IcalError] {
  let n = s.length()
  let mut pos = 0
  // Strip optional leading "RRULE:"
  if n >= 6 && ascii_eq_ignore_case(slice_to_upper(s, 0, 6), "RRULE:") {
    pos = 6
  }
  if pos >= n {
    return Err(IcalError::InvalidRRule("empty RRULE"))
  }

  let mut has_freq = false
  let mut freq = Freq::Daily
  let mut interval = 1
  let mut count : Option[Int] = None
  let mut until : Option[time::DateTime] = None
  let mut until_is_utc = false
  let mut wkst = time::Weekday::Mon
  let mut bysetpos : Array[Int] = []
  let mut bymonth : Array[Int] = []
  let mut bymonthday : Array[Int] = []
  let mut byyearday : Array[Int] = []
  let mut byweekno : Array[Int] = []
  let mut byday : Array[NWeekday] = []
  let mut byhour : Array[Int] = []
  let mut byminute : Array[Int] = []
  let mut bysecond : Array[Int] = []
  let mut rscale : Option[String] = None
  let mut skip : Option[String] = None

  while pos < n {
    let mut semi = pos
    while semi < n && s.code_unit_at(semi) != 59 {
      semi = semi + 1
    }
    if semi == pos {
      pos = semi + 1
      continue
    }
    let mut eq = pos
    while eq < semi && s.code_unit_at(eq) != 61 {
      eq = eq + 1
    }
    if eq == pos || eq >= semi {
      return Err(IcalError::InvalidRRule("expected KEY=VALUE in RRULE"))
    }
    let key = slice_to_upper(s, pos, eq)
    let vstart = eq + 1
    let vend = semi

    if key == "FREQ" {
      let fval = slice_to_upper(s, vstart, vend)
      if fval == "YEARLY" {
        freq = Freq::Yearly
      } else if fval == "MONTHLY" {
        freq = Freq::Monthly
      } else if fval == "WEEKLY" {
        freq = Freq::Weekly
      } else if fval == "DAILY" {
        freq = Freq::Daily
      } else if fval == "HOURLY" {
        freq = Freq::Hourly
      } else if fval == "MINUTELY" {
        freq = Freq::Minutely
      } else if fval == "SECONDLY" {
        freq = Freq::Secondly
      } else {
        return Err(IcalError::InvalidRRule("unknown FREQ: " + fval))
      }
      has_freq = true
    } else if key == "INTERVAL" {
      match parse_int_range(s, vstart, vend, 1, 999999, false) {
        Ok(v) => interval = v
        Err(e) => return Err(e)
      }
    } else if key == "COUNT" {
      match parse_int_range(s, vstart, vend, 0, 999999999, true) {
        Ok(v) => count = Some(v)
        Err(e) => return Err(e)
      }
    } else if key == "UNTIL" {
      let uval = slice_to_upper(s, vstart, vend)
      match parse_ical_datetime(uval, None) {
        Ok(idt) =>
        match idt {
          IcalDateTime::DateOnly(d) => {
            let eod = match time::Time::new(23, 59, 59, 0) {
              Ok(t) => t
              Err(_) => time::Time::midnight()
            }
            until = Some(time::DateTime::from_parts(d, eod))
            until_is_utc = false
          }
          IcalDateTime::Utc(dt) => {
            until = Some(dt)
            until_is_utc = true
          }
          IcalDateTime::Floating(dt) => {
            until = Some(dt)
            until_is_utc = false
          }
          IcalDateTime::Zoned(dt, _) => {
            until = Some(dt)
            until_is_utc = false
          }
        }
        Err(e) => return Err(IcalError::InvalidRRule("invalid UNTIL: " + ical_error_to_string(e)))
      }
    } else if key == "WKST" {
      if vend - vstart != 2 {
        return Err(IcalError::InvalidRRule("invalid WKST"))
      }
      match parse_weekday_2(s, vstart) {
        Ok(w) => wkst = w
        Err(e) => return Err(e)
      }
    } else if key == "BYSETPOS" {
      match parse_int_list(s, vstart, vend, -366, 366, false) {
        Ok(v) => bysetpos = v
        Err(e) => return Err(e)
      }
    } else if key == "BYMONTH" {
      match parse_int_list(s, vstart, vend, 1, 12, false) {
        Ok(v) => bymonth = v
        Err(e) => return Err(e)
      }
    } else if key == "BYMONTHDAY" {
      match parse_int_list(s, vstart, vend, -31, 31, false) {
        Ok(v) => bymonthday = v
        Err(e) => return Err(e)
      }
    } else if key == "BYYEARDAY" {
      match parse_int_list(s, vstart, vend, -366, 366, false) {
        Ok(v) => byyearday = v
        Err(e) => return Err(e)
      }
    } else if key == "BYWEEKNO" {
      match parse_int_list(s, vstart, vend, -53, 53, false) {
        Ok(v) => byweekno = v
        Err(e) => return Err(e)
      }
    } else if key == "BYDAY" {
      match parse_byday_list(s, vstart, vend) {
        Ok(v) => byday = v
        Err(e) => return Err(e)
      }
    } else if key == "BYHOUR" {
      match parse_int_list(s, vstart, vend, 0, 23, true) {
        Ok(v) => byhour = v
        Err(e) => return Err(e)
      }
    } else if key == "BYMINUTE" {
      match parse_int_list(s, vstart, vend, 0, 59, true) {
        Ok(v) => byminute = v
        Err(e) => return Err(e)
      }
    } else if key == "BYSECOND" {
      match parse_int_list(s, vstart, vend, 0, 60, true) {
        Ok(v) => bysecond = v
        Err(e) => return Err(e)
      }
    } else if key == "RSCALE" {
      rscale = Some(slice_to_upper(s, vstart, vend))
    } else if key == "SKIP" {
      let sk = slice_to_upper(s, vstart, vend)
      if sk != "OMIT" && sk != "BACKWARD" && sk != "FORWARD" {
        return Err(IcalError::InvalidRRule("invalid SKIP value: " + sk))
      }
      skip = Some(sk)
    } else {
      return Err(IcalError::InvalidRRule("unknown RRULE parameter: " + key))
    }
    pos = semi + 1
  }

  if !has_freq {
    return Err(IcalError::InvalidRRule("RRULE missing required FREQ"))
  }
  let has_count = match count { Some(_) => true; None => false }
  let has_until = match until { Some(_) => true; None => false }
  if has_count && has_until {
    return Err(IcalError::InvalidRRule("COUNT and UNTIL are mutually exclusive"))
  }

  Ok(RRule::{
    freq: freq,
    interval: interval,
    count: count,
    until: until,
    until_is_utc: until_is_utc,
    wkst: wkst,
    bysetpos: bysetpos,
    bymonth: bymonth,
    bymonthday: bymonthday,
    byyearday: byyearday,
    byweekno: byweekno,
    byday: byday,
    byhour: byhour,
    byminute: byminute,
    bysecond: bysecond,
    rscale: rscale,
    skip: skip,
  })
}

///| Write a comma-separated list of integers to `sb`.
fn write_int_list(sb : StringBuilder, key : String, arr : Array[Int]) -> Unit {
  if arr.length() == 0 {
    return
  }
  sb.write_byte((59).to_byte())
  sb.write_string(key)
  sb.write_byte((61).to_byte())
  let mut i = 0
  while i < arr.length() {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_string(arr[i].to_string())
    i = i + 1
  }
}

///| Format an `RRule` into its canonical RFC 5545 string.
pub fn RRule::to_string(self : RRule) -> String {
  let sb = StringBuilder::new()
  sb.write_string("FREQ=")
  match self.freq {
    Freq::Yearly => sb.write_string("YEARLY")
    Freq::Monthly => sb.write_string("MONTHLY")
    Freq::Weekly => sb.write_string("WEEKLY")
    Freq::Daily => sb.write_string("DAILY")
    Freq::Hourly => sb.write_string("HOURLY")
    Freq::Minutely => sb.write_string("MINUTELY")
    Freq::Secondly => sb.write_string("SECONDLY")
  }
  match self.rscale {
    Some(rs) => {
      sb.write_string(";RSCALE=")
      sb.write_string(rs)
    }
    None => ()
  }
  match self.skip {
    Some(sk) => {
      sb.write_string(";SKIP=")
      sb.write_string(sk)
    }
    None => ()
  }
  if self.interval != 1 {
    sb.write_string(";INTERVAL=")
    sb.write_string(self.interval.to_string())
  }
  match self.count {
    Some(c) => {
      sb.write_string(";COUNT=")
      sb.write_string(c.to_string())
    }
    None => ()
  }
  match self.until {
    Some(u) => {
      sb.write_string(";UNTIL=")
      if self.until_is_utc {
        sb.write_string(ical_datetime_to_value(IcalDateTime::Utc(u)))
      } else {
        sb.write_string(ical_datetime_to_value(IcalDateTime::Floating(u)))
      }
    }
    None => ()
  }
  write_int_list(sb, "BYMONTH", self.bymonth)
  write_int_list(sb, "BYWEEKNO", self.byweekno)
  write_int_list(sb, "BYYEARDAY", self.byyearday)
  write_int_list(sb, "BYMONTHDAY", self.bymonthday)
  if self.byday.length() > 0 {
    sb.write_string(";BYDAY=")
    let mut i = 0
    while i < self.byday.length() {
      if i > 0 {
        sb.write_byte((44).to_byte())
      }
      if self.byday[i].n != 0 {
        sb.write_string(self.byday[i].n.to_string())
      }
      sb.write_string(weekday_to_ical(self.byday[i].weekday))
      i = i + 1
    }
  }
  write_int_list(sb, "BYHOUR", self.byhour)
  write_int_list(sb, "BYMINUTE", self.byminute)
  write_int_list(sb, "BYSECOND", self.bysecond)
  write_int_list(sb, "BYSETPOS", self.bysetpos)
  match self.wkst {
    time::Weekday::Mon => ()
    _ => {
      sb.write_string(";WKST=")
      sb.write_string(weekday_to_ical(self.wkst))
    }
  }
  sb.to_string()
}

// =============================================================================
// Calendar math helpers for fast RRULE expansion
// =============================================================================

///| Return Monday=0..Sunday=6 weekday of an epoch day (1970-01-01 = Thu = 3).
fn epoch_day_weekday_mon0(ed : Int) -> Int {
  let r = (ed + 3) % 7
  if r < 0 { r + 7 } else { r }
}

///| Fast Date from epoch days (valid for 0001..9999).
fn date_from_ed(ed : Int) -> time::Date {
  match time::Date::from_epoch_days(ed) {
    Ok(d) => d
    Err(_) => time::Date::min()
  }
}

///| Epoch days of `(year, month, day)`.
fn ymd_to_ed(year : Int, month : Int, day : Int) -> Int {
  match time::Date::new(year, month, day) {
    Ok(d) => d.to_epoch_days()
    Err(_) => 0
  }
}

///| Days in `year` (365 or 366).
fn days_in_year(year : Int) -> Int {
  if time::is_leap_year(year) { 366 } else { 365 }
}

///| Day-of-year (1..366) of `ed` given `jan1_ed = ymd_to_ed(year, 1, 1)`.
fn doy_of(ed : Int, jan1_ed : Int) -> Int {
  ed - jan1_ed + 1
}

///| Sort and deduplicate an `Array[Int]` in place (insertion sort for small arrays, merge/comb for larger).
fn sort_dedup_ints(arr : Array[Int]) -> Array[Int] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  // Shell sort (gap sequence: fast, zero extra allocation, O(n log n) practical)
  let mut gap = n / 2
  while gap > 0 {
    let mut i = gap
    while i < n {
      let temp = arr[i]
      let mut j = i
      while j >= gap && arr[j - gap] > temp {
        arr[j] = arr[j - gap]
        j = j - gap
      }
      arr[j] = temp
      i = i + 1
    }
    gap = gap / 2
  }
  let out : Array[Int] = []
  out.push(arr[0])
  let mut k = 1
  while k < n {
    if arr[k] != arr[k - 1] {
      out.push(arr[k])
    }
    k = k + 1
  }
  out
}

///| Check if `target` is in `arr`.
fn array_contains_int(arr : Array[Int], target : Int) -> Bool {
  let mut i = 0
  let n = arr.length()
  while i < n {
    if arr[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

///| Check if `wd_mon0` (0=Mon..6=Sun) matches any `NWeekday` in `byday` (ignoring ordinal).
fn byday_contains_wd(byday : Array[NWeekday], wd_mon0 : Int) -> Bool {
  let mut i = 0
  let n = byday.length()
  while i < n {
    if time::weekday_to_monday_zero_offset(byday[i].weekday) == wd_mon0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Check if a day matches `bymonthday` (positive or negative) for its month.
fn matches_bymonthday(day : Int, dim : Int, bymonthday : Array[Int]) -> Bool {
  let neg = day - dim - 1
  let mut i = 0
  let n = bymonthday.length()
  while i < n {
    let md = bymonthday[i]
    if md == day || md == neg {
      return true
    }
    i = i + 1
  }
  false
}

///| Check if a day-of-year (1..diy) matches `byyearday` (positive or negative).
fn matches_byyearday(doy : Int, diy : Int, byyearday : Array[Int]) -> Bool {
  let neg = doy - diy - 1
  let mut i = 0
  let n = byyearday.length()
  while i < n {
    let yd = byyearday[i]
    if yd == doy || yd == neg {
      return true
    }
    i = i + 1
  }
  false
}

///| Compute RFC 5545 §3.3.10 week-1 start epoch day for `(year, wkst_mon0)` and total weeks in `year`.
///| Week 1 is the first week containing at least 4 days in `year`.
fn year_week1_info(year : Int, wkst_mon0 : Int) -> (Int, Int) {
  let jan1 = ymd_to_ed(year, 1, 1)
  let jan1_wd = epoch_day_weekday_mon0(jan1)
  // Offset of jan1 from wkst (0..6)
  let offset = (jan1_wd - wkst_mon0 + 7) % 7
  // Days in the week of jan1 that fall in `year` = 7 - offset
  let week1_start = if 7 - offset >= 4 {
    jan1 - offset
  } else {
    jan1 + (7 - offset)
  }
  // Compute next year's week1_start to get exact number of weeks (52 or 53)
  let next_jan1 = ymd_to_ed(year + 1, 1, 1)
  let next_wd = epoch_day_weekday_mon0(next_jan1)
  let next_off = (next_wd - wkst_mon0 + 7) % 7
  let next_w1 = if 7 - next_off >= 4 {
    next_jan1 - next_off
  } else {
    next_jan1 + (7 - next_off)
  }
  let num_weeks = (next_w1 - week1_start) / 7
  (week1_start, num_weeks)
}

///| Expand `BYDAY` (including positive/negative ordinals) within `[range_start_ed, range_end_ed]` inclusive.
fn expand_byday_in_range(
  range_start_ed : Int,
  range_end_ed : Int,
  byday : Array[NWeekday],
  out : Array[Int],
) -> Unit {
  let start_wd = epoch_day_weekday_mon0(range_start_ed)
  let end_wd = epoch_day_weekday_mon0(range_end_ed)
  let mut i = 0
  let nb = byday.length()
  while i < nb {
    let nw = byday[i]
    let target_wd = time::weekday_to_monday_zero_offset(nw.weekday)
    if nw.n == 0 {
      let mut ed = range_start_ed + (target_wd - start_wd + 7) % 7
      while ed <= range_end_ed {
        out.push(ed)
        ed = ed + 7
      }
    } else if nw.n > 0 {
      let first = range_start_ed + (target_wd - start_wd + 7) % 7
      let ed = first + (nw.n - 1) * 7
      if ed <= range_end_ed {
        out.push(ed)
      }
    } else {
      let last = range_end_ed - (end_wd - target_wd + 7) % 7
      let ed = last + (nw.n + 1) * 7
      if ed >= range_start_ed {
        out.push(ed)
      }
    }
    i = i + 1
  }
}

///| Copy an `Array[Int]`.
fn copy_int_array(arr : Array[Int]) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < arr.length() {
    out.push(arr[i])
    i = i + 1
  }
  out
}

///| Build sorted unique times-of-day (in seconds `0..86399`) for a daily+ rule.
fn build_timeset(rule : RRule, dtstart : time::DateTime) -> Array[Int] {
  let hours = if rule.byhour.length() > 0 {
    sort_dedup_ints(copy_int_array(rule.byhour))
  } else {
    [dtstart.time.hour]
  }
  let mins = if rule.byminute.length() > 0 {
    sort_dedup_ints(copy_int_array(rule.byminute))
  } else {
    [dtstart.time.minute]
  }
  let secs = if rule.bysecond.length() > 0 {
    sort_dedup_ints(copy_int_array(rule.bysecond))
  } else {
    [dtstart.time.second]
  }
  let out : Array[Int] = []
  let mut hi = 0
  while hi < hours.length() {
    let h = hours[hi] * 3600
    let mut mi = 0
    while mi < mins.length() {
      let hm = h + mins[mi] * 60
      let mut si = 0
      while si < secs.length() {
        let s = if secs[si] == 60 { 59 } else { secs[si] }
        out.push(hm + s)
        si = si + 1
      }
      mi = mi + 1
    }
    hi = hi + 1
  }
  out
}

///| Convert `(epoch_day, sec_of_day)` to `time::DateTime`.
fn ed_sec_to_datetime(ed : Int, sec : Int) -> time::DateTime {
  let d = date_from_ed(ed)
  let h = sec / 3600
  let rem = sec - h * 3600
  let mi = rem / 60
  let sc = rem - mi * 60
  let t = match time::Time::new(h, mi, sc, 0) {
    Ok(v) => v
    Err(_) => time::Time::midnight()
  }
  time::DateTime::from_parts(d, t)
}

///| Filter candidate `epoch_days` for a single year according to RFC 5545 `YEARLY` rules.
fn yearly_candidate_days(rule : RRule, dtstart : time::DateTime, year : Int) -> Array[Int] {
  let jan1 = ymd_to_ed(year, 1, 1)
  let diy = days_in_year(year)
  let dec31 = jan1 + diy - 1
  let raw : Array[Int] = []

  if rule.byweekno.length() > 0 {
    let wkst_m0 = time::weekday_to_monday_zero_offset(rule.wkst)
    let winfo = year_week1_info(year, wkst_m0)
    let w1_start = winfo.0
    let num_weeks = winfo.1
    let mut i = 0
    while i < rule.byweekno.length() {
      let wn = rule.byweekno[i]
      let idx = if wn > 0 { wn - 1 } else { num_weeks + wn }
      if idx >= 0 && idx < num_weeks {
        let ws = w1_start + idx * 7
        let mut d = 0
        while d < 7 {
          raw.push(ws + d)
          d = d + 1
        }
      }
      i = i + 1
    }
  } else if rule.byyearday.length() > 0 {
    let mut i = 0
    while i < rule.byyearday.length() {
      let yd = rule.byyearday[i]
      let doy = if yd > 0 { yd } else { diy + 1 + yd }
      if doy >= 1 && doy <= diy {
        raw.push(jan1 + doy - 1)
      }
      i = i + 1
    }
  } else if rule.bymonth.length() > 0 {
    let mut mi = 0
    while mi < rule.bymonth.length() {
      let mo = rule.bymonth[mi]
      let dim = time::days_in_month_of(year, mo)
      let m_start = ymd_to_ed(year, mo, 1)
      if rule.bymonthday.length() > 0 {
        let mut di = 0
        while di < rule.bymonthday.length() {
          let md = rule.bymonthday[di]
          let day = if md > 0 { md } else { dim + 1 + md }
          if day >= 1 && day <= dim {
            raw.push(m_start + day - 1)
          }
          di = di + 1
        }
      } else if rule.byday.length() > 0 {
        expand_byday_in_range(m_start, m_start + dim - 1, rule.byday, raw)
      } else {
        if dtstart.date.day <= dim {
          raw.push(m_start + dtstart.date.day - 1)
        }
      }
      mi = mi + 1
    }
  } else if rule.bymonthday.length() > 0 {
    let mo = dtstart.date.month
    let dim = time::days_in_month_of(year, mo)
    let m_start = ymd_to_ed(year, mo, 1)
    let mut di = 0
    while di < rule.bymonthday.length() {
      let md = rule.bymonthday[di]
      let day = if md > 0 { md } else { dim + 1 + md }
      if day >= 1 && day <= dim {
        raw.push(m_start + day - 1)
      }
      di = di + 1
    }
  } else if rule.byday.length() > 0 {
    expand_byday_in_range(jan1, dec31, rule.byday, raw)
  } else {
    let mo = dtstart.date.month
    let dim = time::days_in_month_of(year, mo)
    if dtstart.date.day <= dim {
      raw.push(ymd_to_ed(year, mo, dtstart.date.day))
    }
  }

  let sorted = sort_dedup_ints(raw)
  // Apply remaining filters (intersection semantics per RFC 5545 Table 1)
  let need_month_filter = rule.bymonth.length() > 0 && (rule.byweekno.length() > 0 || rule.byyearday.length() > 0)
  let need_yd_filter = rule.byyearday.length() > 0 && rule.byweekno.length() > 0
  let need_md_filter = rule.bymonthday.length() > 0 && (rule.byweekno.length() > 0 || rule.byyearday.length() > 0)
  let need_wd_filter = rule.byday.length() > 0 && (rule.byweekno.length() > 0 || rule.byyearday.length() > 0 || rule.bymonthday.length() > 0)
  if !need_month_filter && !need_yd_filter && !need_md_filter && !need_wd_filter {
    return sorted
  }
  let out : Array[Int] = []
  let mut i = 0
  while i < sorted.length() {
    let ed = sorted[i]
    let d = date_from_ed(ed)
    if need_month_filter && !array_contains_int(rule.bymonth, d.month) {
      i = i + 1
      continue
    }
    if need_yd_filter {
      let doy = doy_of(ed, jan1)
      if !matches_byyearday(doy, diy, rule.byyearday) {
        i = i + 1
        continue
      }
    }
    if need_md_filter {
      let dim = time::days_in_month_of(d.year, d.month)
      if !matches_bymonthday(d.day, dim, rule.bymonthday) {
        i = i + 1
        continue
      }
    }
    if need_wd_filter && !byday_contains_wd(rule.byday, epoch_day_weekday_mon0(ed)) {
      i = i + 1
      continue
    }
    out.push(ed)
    i = i + 1
  }
  out
}

///| Filter candidate `epoch_days` for a single `(year, month)` according to RFC 5545 `MONTHLY` rules.
fn monthly_candidate_days(
  rule : RRule,
  dtstart : time::DateTime,
  year : Int,
  month : Int,
) -> Array[Int] {
  if rule.bymonth.length() > 0 && !array_contains_int(rule.bymonth, month) {
    return []
  }
  let dim = time::days_in_month_of(year, month)
  let m_start = ymd_to_ed(year, month, 1)
  let raw : Array[Int] = []

  if rule.bymonthday.length() > 0 {
    let mut di = 0
    while di < rule.bymonthday.length() {
      let md = rule.bymonthday[di]
      let day = if md > 0 { md } else { dim + 1 + md }
      if day >= 1 && day <= dim {
        raw.push(m_start + day - 1)
      }
      di = di + 1
    }
  } else if rule.byday.length() > 0 {
    expand_byday_in_range(m_start, m_start + dim - 1, rule.byday, raw)
  } else {
    if dtstart.date.day <= dim {
      raw.push(m_start + dtstart.date.day - 1)
    }
  }

  let sorted = sort_dedup_ints(raw)
  let need_wd = rule.byday.length() > 0 && rule.bymonthday.length() > 0
  let need_yd = rule.byyearday.length() > 0
  if !need_wd && !need_yd {
    return sorted
  }
  let jan1 = ymd_to_ed(year, 1, 1)
  let diy = days_in_year(year)
  let out : Array[Int] = []
  let mut i = 0
  while i < sorted.length() {
    let ed = sorted[i]
    if need_wd && !byday_contains_wd(rule.byday, epoch_day_weekday_mon0(ed)) {
      i = i + 1
      continue
    }
    if need_yd && !matches_byyearday(doy_of(ed, jan1), diy, rule.byyearday) {
      i = i + 1
      continue
    }
    out.push(ed)
    i = i + 1
  }
  out
}

///| Filter candidate `epoch_days` for a single week starting at `week_start_ed` (`WKST`).
fn weekly_candidate_days(
  rule : RRule,
  dtstart : time::DateTime,
  week_start_ed : Int,
) -> Array[Int] {
  let out : Array[Int] = []
  let start_wd = epoch_day_weekday_mon0(week_start_ed)
  let dtstart_wd = time::weekday_to_monday_zero_offset(dtstart.date.weekday())
  let mut off = 0
  while off < 7 {
    let ed = week_start_ed + off
    let wd = (start_wd + off) % 7
    let wd_ok = if rule.byday.length() > 0 {
      byday_contains_wd(rule.byday, wd)
    } else {
      wd == dtstart_wd
    }
    if wd_ok {
      if rule.bymonth.length() == 0 && rule.bymonthday.length() == 0 && rule.byyearday.length() == 0 {
        out.push(ed)
      } else {
        let d = date_from_ed(ed)
        let mut ok = true
        if rule.bymonth.length() > 0 && !array_contains_int(rule.bymonth, d.month) {
          ok = false
        }
        if ok && rule.bymonthday.length() > 0 {
          let dim = time::days_in_month_of(d.year, d.month)
          if !matches_bymonthday(d.day, dim, rule.bymonthday) {
            ok = false
          }
        }
        if ok && rule.byyearday.length() > 0 {
          let jan1 = ymd_to_ed(d.year, 1, 1)
          let diy = days_in_year(d.year)
          if !matches_byyearday(doy_of(ed, jan1), diy, rule.byyearday) {
            ok = false
          }
        }
        if ok {
          out.push(ed)
        }
      }
    }
    off = off + 1
  }
  out
}

///| Check if a single day `ed` passes `DAILY` / sub-daily date filters.
fn day_matches_filters(rule : RRule, ed : Int) -> Bool {
  if rule.byday.length() > 0 && !byday_contains_wd(rule.byday, epoch_day_weekday_mon0(ed)) {
    return false
  }
  if rule.bymonth.length() == 0 && rule.bymonthday.length() == 0 && rule.byyearday.length() == 0 {
    return true
  }
  let d = date_from_ed(ed)
  if rule.bymonth.length() > 0 && !array_contains_int(rule.bymonth, d.month) {
    return false
  }
  if rule.bymonthday.length() > 0 {
    let dim = time::days_in_month_of(d.year, d.month)
    if !matches_bymonthday(d.day, dim, rule.bymonthday) {
      return false
    }
  }
  if rule.byyearday.length() > 0 {
    let jan1 = ymd_to_ed(d.year, 1, 1)
    let diy = days_in_year(d.year)
    if !matches_byyearday(doy_of(ed, jan1), diy, rule.byyearday) {
      return false
    }
  }
  true
}

///| Apply `BYSETPOS` selection to a sorted list of period candidates.
fn apply_bysetpos(
  cands : Array[time::DateTime],
  bysetpos : Array[Int],
) -> Array[time::DateTime] {
  if bysetpos.length() == 0 || cands.length() == 0 {
    return cands
  }
  let n = cands.length()
  let idxs : Array[Int] = []
  let mut i = 0
  while i < bysetpos.length() {
    let p = bysetpos[i]
    let idx = if p > 0 { p - 1 } else { n + p }
    if idx >= 0 && idx < n {
      idxs.push(idx)
    }
    i = i + 1
  }
  let sorted_idxs = sort_dedup_ints(idxs)
  let out : Array[time::DateTime] = []
  let mut k = 0
  while k < sorted_idxs.length() {
    out.push(cands[sorted_idxs[k]])
    k = k + 1
  }
  out
}

///| Stateful recurrence expansion iterator.
pub struct RRuleIter {
  rule : RRule
  dtstart : time::DateTime
  timeset : Array[Int]
  mut cur_year : Int
  mut cur_month : Int
  mut cur_ed : Int
  mut cur_sec : Int64
  mut emitted : Int
  mut buf : Array[time::DateTime]
  mut buf_idx : Int
  mut done : Bool
}

///| Create a streaming recurrence iterator starting at `dtstart`.
pub fn RRule::iter(self : RRule, dtstart : time::DateTime) -> RRuleIter {
  let ed = dtstart.date.to_epoch_days()
  let wkst_m0 = time::weekday_to_monday_zero_offset(self.wkst)
  let dt_wd = epoch_day_weekday_mon0(ed)
  let week_start = ed - (dt_wd - wkst_m0 + 7) % 7
  let start_sec = ed.to_int64() * 86400L + dtstart.time.to_second_of_day().to_int64()
  let timeset = match self.freq {
    Freq::Yearly | Freq::Monthly | Freq::Weekly | Freq::Daily => build_timeset(self, dtstart)
    _ => []
  }
  let initial_done = match self.count {
    Some(0) => true
    _ => false
  }
  let init_ed = match self.freq {
    Freq::Weekly => week_start
    _ => ed
  }
  RRuleIter::{
    rule: self,
    dtstart: dtstart,
    timeset: timeset,
    cur_year: dtstart.date.year,
    cur_month: dtstart.date.month,
    cur_ed: init_ed,
    cur_sec: start_sec,
    emitted: 0,
    buf: [],
    buf_idx: 0,
    done: initial_done,
  }
}

///| Refill `self.buf` from the next period. Returns false when exhausted.
fn RRuleIter::refill(self : RRuleIter) -> Result[Bool, IcalError] {
  let max_empty = match self.rule.freq {
    Freq::Yearly => 400
    Freq::Monthly => 4800
    Freq::Weekly => 20800
    Freq::Daily => 146097
    _ => 200000
  }
  let mut empty_periods = 0
  let rule = self.rule

  while empty_periods <= max_empty {
    let period_cands : Array[time::DateTime] = []
    match rule.freq {
      Freq::Yearly => {
        if self.cur_year > 9999 {
          self.done = true
          return Ok(false)
        }
        // Check UNTIL early exit (Jan 1 of cur_year > until)
        match rule.until {
          Some(u) => if self.cur_year > u.date.year + 1 {
            self.done = true
            return Ok(false)
          }
          None => ()
        }
        let days = yearly_candidate_days(rule, self.dtstart, self.cur_year)
        let mut di = 0
        while di < days.length() {
          let mut ti = 0
          while ti < self.timeset.length() {
            period_cands.push(ed_sec_to_datetime(days[di], self.timeset[ti]))
            ti = ti + 1
          }
          di = di + 1
        }
        self.cur_year = self.cur_year + rule.interval
      }
      Freq::Monthly => {
        if self.cur_year > 9999 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => if self.cur_year > u.date.year || (self.cur_year == u.date.year && self.cur_month > u.date.month) {
            self.done = true
            return Ok(false)
          }
          None => ()
        }
        let days = monthly_candidate_days(rule, self.dtstart, self.cur_year, self.cur_month)
        let mut di = 0
        while di < days.length() {
          let mut ti = 0
          while ti < self.timeset.length() {
            period_cands.push(ed_sec_to_datetime(days[di], self.timeset[ti]))
            ti = ti + 1
          }
          di = di + 1
        }
        let total_months = (self.cur_month - 1) + rule.interval
        self.cur_year = self.cur_year + total_months / 12
        self.cur_month = (total_months % 12) + 1
      }
      Freq::Weekly => {
        if self.cur_ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => if self.cur_ed > u.date.to_epoch_days() {
            self.done = true
            return Ok(false)
          }
          None => ()
        }
        let days = weekly_candidate_days(rule, self.dtstart, self.cur_ed)
        let mut di = 0
        while di < days.length() {
          let mut ti = 0
          while ti < self.timeset.length() {
            period_cands.push(ed_sec_to_datetime(days[di], self.timeset[ti]))
            ti = ti + 1
          }
          di = di + 1
        }
        self.cur_ed = self.cur_ed + rule.interval * 7
      }
      Freq::Daily => {
        if self.cur_ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => if self.cur_ed > u.date.to_epoch_days() {
            self.done = true
            return Ok(false)
          }
          None => ()
        }
        if day_matches_filters(rule, self.cur_ed) {
          let mut ti = 0
          while ti < self.timeset.length() {
            period_cands.push(ed_sec_to_datetime(self.cur_ed, self.timeset[ti]))
            ti = ti + 1
          }
        }
        self.cur_ed = self.cur_ed + rule.interval
      }
      Freq::Hourly => {
        let ed = (self.cur_sec / 86400L).to_int()
        let sod = (self.cur_sec - ed.to_int64() * 86400L).to_int()
        let hour = sod / 3600
        if ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => {
            let u_sec = u.date.to_epoch_days().to_int64() * 86400L + u.time.to_second_of_day().to_int64()
            if self.cur_sec > u_sec + 3600L {
              self.done = true
              return Ok(false)
            }
          }
          None => ()
        }
        if day_matches_filters(rule, ed) && (rule.byhour.length() == 0 || array_contains_int(rule.byhour, hour)) {
          let mins = if rule.byminute.length() > 0 {
            sort_dedup_ints(copy_int_array(rule.byminute))
          } else {
            [self.dtstart.time.minute]
          }
          let secs = if rule.bysecond.length() > 0 {
            sort_dedup_ints(copy_int_array(rule.bysecond))
          } else {
            [self.dtstart.time.second]
          }
          let mut mi = 0
          while mi < mins.length() {
            let mut si = 0
            while si < secs.length() {
              let sc = if secs[si] == 60 { 59 } else { secs[si] }
              period_cands.push(ed_sec_to_datetime(ed, hour * 3600 + mins[mi] * 60 + sc))
              si = si + 1
            }
            mi = mi + 1
          }
        }
        self.cur_sec = self.cur_sec + rule.interval.to_int64() * 3600L
      }
      Freq::Minutely => {
        let ed = (self.cur_sec / 86400L).to_int()
        let sod = (self.cur_sec - ed.to_int64() * 86400L).to_int()
        let hour = sod / 3600
        let minute = (sod - hour * 3600) / 60
        if ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => {
            let u_sec = u.date.to_epoch_days().to_int64() * 86400L + u.time.to_second_of_day().to_int64()
            if self.cur_sec > u_sec + 60L {
              self.done = true
              return Ok(false)
            }
          }
          None => ()
        }
        if day_matches_filters(rule, ed) &&
        (rule.byhour.length() == 0 || array_contains_int(rule.byhour, hour)) &&
        (rule.byminute.length() == 0 || array_contains_int(rule.byminute, minute)) {
          let secs = if rule.bysecond.length() > 0 {
            sort_dedup_ints(copy_int_array(rule.bysecond))
          } else {
            [self.dtstart.time.second]
          }
          let mut si = 0
          while si < secs.length() {
            let sc = if secs[si] == 60 { 59 } else { secs[si] }
            period_cands.push(ed_sec_to_datetime(ed, hour * 3600 + minute * 60 + sc))
            si = si + 1
          }
        }
        self.cur_sec = self.cur_sec + rule.interval.to_int64() * 60L
      }
      Freq::Secondly => {
        let ed = (self.cur_sec / 86400L).to_int()
        let sod = (self.cur_sec - ed.to_int64() * 86400L).to_int()
        let hour = sod / 3600
        let rem = sod - hour * 3600
        let minute = rem / 60
        let second = rem - minute * 60
        if ed > 2932896 {
          self.done = true
          return Ok(false)
        }
        match rule.until {
          Some(u) => {
            let u_sec = u.date.to_epoch_days().to_int64() * 86400L + u.time.to_second_of_day().to_int64()
            if self.cur_sec > u_sec {
              self.done = true
              return Ok(false)
            }
          }
          None => ()
        }
        if day_matches_filters(rule, ed) &&
        (rule.byhour.length() == 0 || array_contains_int(rule.byhour, hour)) &&
        (rule.byminute.length() == 0 || array_contains_int(rule.byminute, minute)) &&
        (rule.bysecond.length() == 0 || array_contains_int(rule.bysecond, second)) {
          period_cands.push(ed_sec_to_datetime(ed, sod))
        }
        self.cur_sec = self.cur_sec + rule.interval.to_int64()
      }
    }

    let selected = apply_bysetpos(period_cands, rule.bysetpos)
    // Filter >= dtstart and <= until
    let filtered : Array[time::DateTime] = []
    let mut k = 0
    while k < selected.length() {
      let c = selected[k]
      if c.cmp(self.dtstart) >= 0 {
        match rule.until {
          Some(u) => {
            if c.cmp(u) > 0 {
              if filtered.length() > 0 {
                self.buf = filtered
                self.buf_idx = 0
                return Ok(true)
              }
              self.done = true
              return Ok(false)
            }
          }
          None => ()
        }
        filtered.push(c)
      }
      k = k + 1
    }

    if filtered.length() > 0 {
      self.buf = filtered
      self.buf_idx = 0
      return Ok(true)
    }
    empty_periods = empty_periods + 1
  }

  self.done = true
  Ok(false)
}

///| Advance the iterator and return the next recurrence `DateTime`.
pub fn RRuleIter::next(self : RRuleIter) -> Result[Option[time::DateTime], IcalError] {
  if self.done {
    return Ok(None)
  }
  match self.rule.count {
    Some(c) => if self.emitted >= c {
      self.done = true
      return Ok(None)
    }
    None => ()
  }
  if self.buf_idx >= self.buf.length() {
    match self.refill() {
      Ok(true) => ()
      Ok(false) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  let v = self.buf[self.buf_idx]
  self.buf_idx = self.buf_idx + 1
  self.emitted = self.emitted + 1
  Ok(Some(v))
}

///| Expand up to `limit` occurrences of `self` starting at `dtstart`.
pub fn RRule::all(
  self : RRule,
  dtstart : time::DateTime,
  limit : Int,
) -> Result[Array[time::DateTime], IcalError] {
  let out : Array[time::DateTime] = []
  if limit <= 0 {
    return Ok(out)
  }
  let it = self.iter(dtstart)
  while out.length() < limit {
    match it.next() {
      Ok(Some(v)) => out.push(v)
      Ok(None) => break
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///| Expand occurrences in window `(after, before)` (or `[after, before]` if `inclusive`).
pub fn RRule::between(
  self : RRule,
  dtstart : time::DateTime,
  after : time::DateTime,
  before : time::DateTime,
  inclusive : Bool,
) -> Result[Array[time::DateTime], IcalError] {
  let out : Array[time::DateTime] = []
  if after.cmp(before) > 0 {
    return Ok(out)
  }
  let it = self.iter(dtstart)
  while true {
    match it.next() {
      Ok(Some(v)) => {
        let cb = v.cmp(before)
        if cb > 0 || (!inclusive && cb == 0) {
          break
        }
        let ca = v.cmp(after)
        if ca > 0 || (inclusive && ca == 0) {
          out.push(v)
        }
      }
      Ok(None) => break
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///| Return the first occurrence after (or at, if `inclusive`) `dt`.
pub fn RRule::after(
  self : RRule,
  dtstart : time::DateTime,
  dt : time::DateTime,
  inclusive : Bool,
) -> Result[Option[time::DateTime], IcalError] {
  let it = self.iter(dtstart)
  while true {
    match it.next() {
      Ok(Some(v)) => {
        let c = v.cmp(dt)
        if c > 0 || (inclusive && c == 0) {
          return Ok(Some(v))
        }
      }
      Ok(None) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  Ok(None)
}

///| Return the last occurrence before (or at, if `inclusive`) `dt`.
pub fn RRule::before(
  self : RRule,
  dtstart : time::DateTime,
  dt : time::DateTime,
  inclusive : Bool,
) -> Result[Option[time::DateTime], IcalError] {
  let it = self.iter(dtstart)
  let mut last : Option[time::DateTime] = None
  while true {
    match it.next() {
      Ok(Some(v)) => {
        let c = v.cmp(dt)
        if c > 0 || (!inclusive && c == 0) {
          return Ok(last)
        }
        last = Some(v)
      }
      Ok(None) => return Ok(last)
      Err(e) => return Err(e)
    }
  }
  Ok(last)
}
