///| RFC 5545 §3.1 content-line unfolding, lexing, RFC 6868 parameter unescaping, and component parser.

///| Unfold RFC 5545 §3.1 folded lines (`CRLF`/`LF` followed by single `SP` or `HTAB`).
pub fn unfold_lines(input : String) -> String {
  let n = input.length()
  let mut i = 0
  let mut first_fold = -1
  while i < n {
    let b = input.code_unit_at(i)
    if b == 13 && i + 2 < n && input.code_unit_at(i + 1) == 10 {
      let next = input.code_unit_at(i + 2)
      if next == 32 || next == 9 {
        first_fold = i
        break
      }
    } else if b == 10 && i + 1 < n {
      let next = input.code_unit_at(i + 1)
      if next == 32 || next == 9 {
        first_fold = i
        break
      }
    }
    i = i + 1
  }
  if first_fold < 0 {
    return input
  }
  let sb = StringBuilder::with_capacity(n)
  let mut chunk_start = 0
  i = first_fold
  while i < n {
    let b = input.code_unit_at(i)
    if b == 13 && i + 2 < n && input.code_unit_at(i + 1) == 10 {
      let next = input.code_unit_at(i + 2)
      if next == 32 || next == 9 {
        if i > chunk_start {
          sb.write_substring(input, chunk_start, i)
        }
        i = i + 3
        chunk_start = i
        continue
      }
    } else if b == 10 && i + 1 < n {
      let next = input.code_unit_at(i + 1)
      if next == 32 || next == 9 {
        if i > chunk_start {
          sb.write_substring(input, chunk_start, i)
        }
        i = i + 2
        chunk_start = i
        continue
      }
    }
    i = i + 1
  }
  if chunk_start < n {
    sb.write_substring(input, chunk_start, n)
  }
  sb.to_string()
}

///| Unescape RFC 5545 §3.3.11 TEXT value (`\n`/`\N`, `\,`, `\;`, `\\`).
pub fn unescape_text(s : String) -> String {
  let n = s.length()
  let mut i = 0
  while i < n && s.code_unit_at(i) != 92 {
    i = i + 1
  }
  if i >= n {
    return s
  }
  let sb = StringBuilder::with_capacity(n)
  let mut chunk_start = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 && i + 1 < n {
      let next = s.code_unit_at(i + 1)
      if next == 110 || next == 78 {
        if i > chunk_start {
          sb.write_substring(s, chunk_start, i)
        }
        sb.write_byte((10).to_byte())
        i = i + 2
        chunk_start = i
        continue
      }
      if next == 44 || next == 59 || next == 92 {
        if i > chunk_start {
          sb.write_substring(s, chunk_start, i)
        }
        sb.write_byte(next.to_byte())
        i = i + 2
        chunk_start = i
        continue
      }
    }
    i = i + 1
  }
  if chunk_start == 0 {
    return s
  }
  if chunk_start < n {
    sb.write_substring(s, chunk_start, n)
  }
  sb.to_string()
}

///| Unescape RFC 6868 parameter value (`^n` -> LF, `^'` -> `"`, `^^` -> `^`; unknown `^x` preserved).
pub fn unescape_param_value(s : String) -> String {
  let n = s.length()
  let mut i = 0
  while i < n && s.code_unit_at(i) != 94 {
    i = i + 1
  }
  if i >= n {
    return s
  }
  let sb = StringBuilder::with_capacity(n)
  let mut chunk_start = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 94 && i + 1 < n {
      let next = s.code_unit_at(i + 1)
      if next == 110 {
        if i > chunk_start {
          sb.write_substring(s, chunk_start, i)
        }
        sb.write_byte((10).to_byte())
        i = i + 2
        chunk_start = i
        continue
      }
      if next == 39 {
        if i > chunk_start {
          sb.write_substring(s, chunk_start, i)
        }
        sb.write_byte((34).to_byte())
        i = i + 2
        chunk_start = i
        continue
      }
      if next == 94 {
        if i > chunk_start {
          sb.write_substring(s, chunk_start, i)
        }
        sb.write_byte((94).to_byte())
        i = i + 2
        chunk_start = i
        continue
      }
    }
    i = i + 1
  }
  if chunk_start == 0 {
    return s
  }
  if chunk_start < n {
    sb.write_substring(s, chunk_start, n)
  }
  sb.to_string()
}

///| Case-insensitive match of `s[start..end)` against an uppercase ASCII literal `lit`.
fn slice_eq_upper(s : String, start : Int, end : Int, lit : String) -> Bool {
  let n = end - start
  if n != lit.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if ascii_upper_byte(s.code_unit_at(start + i)) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Intern common uppercase RFC 5545 names (zero allocation), or normalize & validate `[start, end)`.
fn parse_and_intern_name(s : String, start : Int, end : Int) -> Option[String] {
  let len = end - start
  if len <= 0 {
    return None
  }
  let c0 = ascii_upper_byte(s.code_unit_at(start))
  if len == 3 {
    if c0 == 85 && slice_eq_upper(s, start, end, "UID") {
      return Some("UID")
    }
    if c0 == 69 && slice_eq_upper(s, start, end, "END") {
      return Some("END")
    }
  } else if len == 5 {
    if c0 == 68 && slice_eq_upper(s, start, end, "DTEND") {
      return Some("DTEND")
    }
    if c0 == 66 && slice_eq_upper(s, start, end, "BEGIN") {
      return Some("BEGIN")
    }
    if c0 == 82 && slice_eq_upper(s, start, end, "RRULE") {
      return Some("RRULE")
    }
    if c0 == 82 && slice_eq_upper(s, start, end, "RDATE") {
      return Some("RDATE")
    }
    if c0 == 86 && slice_eq_upper(s, start, end, "VTODO") {
      return Some("VTODO")
    }
  } else if len == 6 {
    if c0 == 86 && slice_eq_upper(s, start, end, "VEVENT") {
      return Some("VEVENT")
    }
    if c0 == 86 && slice_eq_upper(s, start, end, "VALARM") {
      return Some("VALARM")
    }
    if c0 == 83 && slice_eq_upper(s, start, end, "STATUS") {
      return Some("STATUS")
    }
    if c0 == 65 && slice_eq_upper(s, start, end, "ACTION") {
      return Some("ACTION")
    }
    if c0 == 69 && slice_eq_upper(s, start, end, "EXDATE") {
      return Some("EXDATE")
    }
    if c0 == 80 && slice_eq_upper(s, start, end, "PRODID") {
      return Some("PRODID")
    }
    if c0 == 77 && slice_eq_upper(s, start, end, "METHOD") {
      return Some("METHOD")
    }
  } else if len == 7 {
    if c0 == 68 && slice_eq_upper(s, start, end, "DTSTART") {
      return Some("DTSTART")
    }
    if c0 == 68 && slice_eq_upper(s, start, end, "DTSTAMP") {
      return Some("DTSTAMP")
    }
    if c0 == 83 && slice_eq_upper(s, start, end, "SUMMARY") {
      return Some("SUMMARY")
    }
    if c0 == 84 && slice_eq_upper(s, start, end, "TRIGGER") {
      return Some("TRIGGER")
    }
    if c0 == 86 && slice_eq_upper(s, start, end, "VERSION") {
      return Some("VERSION")
    }
  } else if len == 8 {
    if c0 == 76 && slice_eq_upper(s, start, end, "LOCATION") {
      return Some("LOCATION")
    }
    if c0 == 67 && slice_eq_upper(s, start, end, "CALSCALE") {
      return Some("CALSCALE")
    }
    if c0 == 83 && slice_eq_upper(s, start, end, "SEQUENCE") {
      return Some("SEQUENCE")
    }
  } else if len == 9 {
    if c0 == 86 && slice_eq_upper(s, start, end, "VCALENDAR") {
      return Some("VCALENDAR")
    }
    if c0 == 86 && slice_eq_upper(s, start, end, "VTIMEZONE") {
      return Some("VTIMEZONE")
    }
  } else if len == 11 {
    if c0 == 68 && slice_eq_upper(s, start, end, "DESCRIPTION") {
      return Some("DESCRIPTION")
    }
  } else if len == 4 {
    if c0 == 84 && slice_eq_upper(s, start, end, "TZID") {
      return Some("TZID")
    }
  }
  // General path: validate all bytes and check if already uppercase
  let mut has_lower = false
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if !is_ical_name_byte(b) {
      return None
    }
    if b >= 97 && b <= 122 {
      has_lower = true
    }
    i = i + 1
  }
  if !has_lower {
    Some(s.slice(start, end))
  } else {
    Some(slice_to_upper(s, start, end))
  }
}

///| Parse a single unfolded iCalendar content line slice `line[start..end)` into a `Property`.
fn parse_property_slice(line : String, start : Int, end : Int) -> Result[Property, IcalError] {
  if start >= end {
    return Err(IcalError::InvalidSyntax("empty content line"))
  }
  // 1. Property name up to ';' or ':'
  let mut pos = start
  while pos < end {
    let c = line.code_unit_at(pos)
    if c == 59 || c == 58 {
      break
    }
    pos = pos + 1
  }
  if pos == start || pos >= end {
    return Err(IcalError::InvalidSyntax("missing property name or ':' in line"))
  }
  let prop_name = match parse_and_intern_name(line, start, pos) {
    Some(nm) => nm
    None => return Err(IcalError::InvalidSyntax("invalid property name: " + slice_to_upper(line, start, pos)))
  }

  // Fast path: no parameters (line[pos] == ':')
  if line.code_unit_at(pos) == 58 {
    return Ok(Property::{ name: prop_name, params: [], value: line.slice(pos + 1, end) })
  }

  let params : Array[Param] = []
  // 2. Parse optional `;PARAM=val1,val2` segments
  while pos < end && line.code_unit_at(pos) == 59 {
    pos = pos + 1
    let pname_start = pos
    while pos < end {
      let c = line.code_unit_at(pos)
      if c == 61 || c == 58 || c == 59 {
        break
      }
      pos = pos + 1
    }
    if pos == pname_start || pos >= end || line.code_unit_at(pos) != 61 {
      return Err(IcalError::InvalidParameter("expected '=' after parameter name"))
    }
    let pname = match parse_and_intern_name(line, pname_start, pos) {
      Some(nm) => nm
      None => return Err(IcalError::InvalidParameter("invalid parameter name: " + slice_to_upper(line, pname_start, pos)))
    }
    pos = pos + 1 // skip '='

    let vals : Array[String] = []
    while true {
      if pos < end && line.code_unit_at(pos) == 34 {
        // Quoted parameter value
        pos = pos + 1
        let q_start = pos
        let mut closed = false
        while pos < end {
          if line.code_unit_at(pos) == 34 {
            closed = true
            break
          }
          pos = pos + 1
        }
        if !closed {
          return Err(IcalError::InvalidParameter("unclosed quoted parameter value"))
        }
        let raw_val = line.slice(q_start, pos)
        pos = pos + 1 // skip closing '"'
        vals.push(unescape_param_value(raw_val))
      } else {
        // Unquoted parameter value up to ',', ';', or ':'
        let u_start = pos
        while pos < end {
          let c = line.code_unit_at(pos)
          if c == 44 || c == 59 || c == 58 {
            break
          }
          if c == 34 {
            return Err(IcalError::InvalidParameter("unexpected quote in unquoted parameter value"))
          }
          pos = pos + 1
        }
        vals.push(unescape_param_value(line.slice(u_start, pos)))
      }
      if pos < end && line.code_unit_at(pos) == 44 {
        pos = pos + 1
        continue
      }
      break
    }
    params.push(Param::{ name: pname, values: vals })
  }

  if pos >= end || line.code_unit_at(pos) != 58 {
    return Err(IcalError::InvalidSyntax("expected ':' before property value"))
  }
  Ok(Property::{ name: prop_name, params: params, value: line.slice(pos + 1, end) })
}

///| Parse a single unfolded iCalendar content line into a `Property`.
pub fn parse_property_line(line : String) -> Result[Property, IcalError] {
  parse_property_slice(line, 0, line.length())
}

///| Parse an iCalendar stream with default limits.
pub fn Calendar::parse(input : String) -> Result[Calendar, IcalError] {
  Calendar::parse_with_limits(input, ParseLimits::default())
}

///| Parse an iCalendar stream enforcing `ParseLimits` with streaming line unfolding.
pub fn Calendar::parse_with_limits(
  input : String,
  limits : ParseLimits,
) -> Result[Calendar, IcalError] {
  let n = input.length()
  let mut pos = 0
  // Skip UTF-8 BOM if present
  if n >= 3 && input.code_unit_at(0) == 0xEF && input.code_unit_at(1) == 0xBB && input.code_unit_at(2) == 0xBF {
    pos = 3
  }

  let stack : Array[Component] = Array::with_capacity(8)
  let mut result_cal : Option[Calendar] = None
  let mut line_count = 0
  let mut comp_count = 0

  while pos < n {
    // Scan first physical line [chunk_start, chunk_end) with 4-byte unrolled ASCII loop
    let chunk_start = pos
    while pos + 4 <= n {
      let b0 = input.code_unit_at(pos)
      let b1 = input.code_unit_at(pos + 1)
      let b2 = input.code_unit_at(pos + 2)
      let b3 = input.code_unit_at(pos + 3)
      if b0 != 13 && b0 != 10 && b1 != 13 && b1 != 10 && b2 != 13 && b2 != 10 && b3 != 13 && b3 != 10 {
        pos = pos + 4
        continue
      }
      break
    }
    while pos < n {
      let b = input.code_unit_at(pos)
      if b == 13 && pos + 1 < n && input.code_unit_at(pos + 1) == 10 {
        break
      }
      if b == 10 {
        break
      }
      pos = pos + 1
    }
    let chunk_end = pos
    let mut line_bytes = chunk_end - chunk_start
    if line_bytes > limits.max_line_bytes {
      return Err(IcalError::LimitExceeded("content line exceeds max_line_bytes"))
    }
    // Advance past CRLF or LF
    if pos < n {
      if input.code_unit_at(pos) == 13 {
        pos = pos + 2
      } else {
        pos = pos + 1
      }
    }
    // Check whether continuation lines follow (RFC 5545 §3.1: SP or HTAB)
    let is_folded = pos < n && (input.code_unit_at(pos) == 32 || input.code_unit_at(pos) == 9)

    // Fast path for unfolded `BEGIN:<NAME>` and `END:<NAME>` (avoids Property & params allocation)
    if !is_folded && line_bytes >= 5 {
      let c0 = input.code_unit_at(chunk_start)
      if (c0 == 66 || c0 == 98) && line_bytes >= 7 && input.code_unit_at(chunk_start + 5) == 58 &&
      slice_eq_upper(input, chunk_start, chunk_start + 5, "BEGIN") {
        line_count = line_count + 1
        if line_count > limits.max_lines {
          return Err(IcalError::LimitExceeded("line count exceeds max_lines"))
        }
        let cname = match parse_and_intern_name(input, chunk_start + 6, chunk_end) {
          Some(nm) => nm
          None => return Err(IcalError::InvalidSyntax("invalid component name in BEGIN: " + slice_to_upper(input, chunk_start + 6, chunk_end)))
        }
        if stack.length() == 0 {
          if cname != "VCALENDAR" {
            return Err(IcalError::InvalidSyntax("root component must be VCALENDAR, got " + cname))
          }
          if match result_cal { Some(_) => true; None => false } {
            return Err(IcalError::InvalidSyntax("multiple VCALENDAR blocks in single parse"))
          }
        } else {
          comp_count = comp_count + 1
          if comp_count > limits.max_components {
            return Err(IcalError::LimitExceeded("component count exceeds max_components"))
          }
        }
        if stack.length() + 1 > limits.max_depth {
          return Err(IcalError::LimitExceeded("component nesting exceeds max_depth"))
        }
        let prop_cap = if cname == "VEVENT" { 9 } else if cname == "VALARM" { 4 } else { 4 }
        stack.push(Component::{ name: cname, properties: Array::with_capacity(prop_cap), subcomponents: [] })
        continue
      }
      if (c0 == 69 || c0 == 101) && input.code_unit_at(chunk_start + 3) == 58 &&
      slice_eq_upper(input, chunk_start, chunk_start + 3, "END") {
        line_count = line_count + 1
        if line_count > limits.max_lines {
          return Err(IcalError::LimitExceeded("line count exceeds max_lines"))
        }
        let cname = match parse_and_intern_name(input, chunk_start + 4, chunk_end) {
          Some(nm) => nm
          None => slice_to_upper(input, chunk_start + 4, chunk_end)
        }
        if stack.length() == 0 {
          return Err(IcalError::InvalidSyntax("unexpected END:" + cname + " outside component"))
        }
        let top = match stack.pop() {
          Some(c) => c
          None => return Err(IcalError::InvalidSyntax("component stack underflow"))
        }
        if top.name != cname {
          return Err(
            IcalError::InvalidSyntax("mismatched END:" + cname + " (expected END:" + top.name + ")"),
          )
        }
        if stack.length() == 0 {
          result_cal = Some(Calendar::{ properties: top.properties, components: top.subcomponents })
        } else {
          let parent_idx = stack.length() - 1
          stack[parent_idx].subcomponents.push(top)
        }
        continue
      }
    }

    let prop = if !is_folded {
      if line_bytes == 0 {
        continue
      }
      line_count = line_count + 1
      if line_count > limits.max_lines {
        return Err(IcalError::LimitExceeded("line count exceeds max_lines"))
      }
      match parse_property_slice(input, chunk_start, chunk_end) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
    } else {
      let line_buf = StringBuilder::with_capacity(line_bytes + 128)
      if line_bytes > 0 {
        line_buf.write_substring(input, chunk_start, chunk_end)
      }
      while pos < n && (input.code_unit_at(pos) == 32 || input.code_unit_at(pos) == 9) {
        pos = pos + 1 // skip single SP/HTAB fold marker
        let cont_start = pos
        while pos < n {
          let b = input.code_unit_at(pos)
          if b == 13 && pos + 1 < n && input.code_unit_at(pos + 1) == 10 {
            break
          }
          if b == 10 {
            break
          }
          pos = pos + 1
        }
        let cont_end = pos
        let cont_len = cont_end - cont_start
        line_bytes = line_bytes + cont_len
        if line_bytes > limits.max_line_bytes {
          return Err(IcalError::LimitExceeded("content line exceeds max_line_bytes"))
        }
        if cont_len > 0 {
          line_buf.write_substring(input, cont_start, cont_end)
        }
        if pos < n {
          if input.code_unit_at(pos) == 13 {
            pos = pos + 2
          } else {
            pos = pos + 1
          }
        }
      }
      if line_bytes == 0 {
        continue
      }
      line_count = line_count + 1
      if line_count > limits.max_lines {
        return Err(IcalError::LimitExceeded("line count exceeds max_lines"))
      }
      let unfolded = line_buf.to_string()
      match parse_property_slice(unfolded, 0, unfolded.length()) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
    }

    if prop.name == "BEGIN" {
      let cname = match parse_and_intern_name(prop.value, 0, prop.value.length()) {
        Some(nm) => nm
        None => return Err(IcalError::InvalidSyntax("invalid component name in BEGIN: " + ascii_to_upper(prop.value)))
      }
      if stack.length() == 0 {
        if cname != "VCALENDAR" {
          return Err(IcalError::InvalidSyntax("root component must be VCALENDAR, got " + cname))
        }
        if match result_cal { Some(_) => true; None => false } {
          return Err(IcalError::InvalidSyntax("multiple VCALENDAR blocks in single parse"))
        }
      } else {
        comp_count = comp_count + 1
        if comp_count > limits.max_components {
          return Err(IcalError::LimitExceeded("component count exceeds max_components"))
        }
      }
      if stack.length() + 1 > limits.max_depth {
        return Err(IcalError::LimitExceeded("component nesting exceeds max_depth"))
      }
      stack.push(Component::{ name: cname, properties: [], subcomponents: [] })
    } else if prop.name == "END" {
      let cname = match parse_and_intern_name(prop.value, 0, prop.value.length()) {
        Some(nm) => nm
        None => ascii_to_upper(prop.value)
      }
      if stack.length() == 0 {
        return Err(IcalError::InvalidSyntax("unexpected END:" + cname + " outside component"))
      }
      let top = match stack.pop() {
        Some(c) => c
        None => return Err(IcalError::InvalidSyntax("component stack underflow"))
      }
      if top.name != cname {
        return Err(
          IcalError::InvalidSyntax("mismatched END:" + cname + " (expected END:" + top.name + ")"),
        )
      }
      if stack.length() == 0 {
        result_cal = Some(Calendar::{ properties: top.properties, components: top.subcomponents })
      } else {
        let parent_idx = stack.length() - 1
        stack[parent_idx].subcomponents.push(top)
      }
    } else {
      if stack.length() == 0 {
        return Err(IcalError::InvalidSyntax("property outside VCALENDAR: " + prop.name))
      }
      let top_idx = stack.length() - 1
      if stack[top_idx].properties.length() >= limits.max_properties_per_component {
        return Err(IcalError::LimitExceeded("properties per component exceeds limit"))
      }
      stack[top_idx].properties.push(prop)
    }
  }

  if stack.length() > 0 {
    return Err(IcalError::InvalidSyntax("unclosed component: " + stack[stack.length() - 1].name))
  }
  match result_cal {
    Some(cal) => Ok(cal)
    None => Err(IcalError::InvalidSyntax("missing VCALENDAR component"))
  }
}
