///| RFC 5545 §3.8.5 RRuleSet (multi-RRULE, RDATE, EXDATE, EXRULE) with TimeZone DST support.

import "time"

///| Recurrence set combining multiple `RRULE`s, `RDATE`s, `EXDATE`s, `EXRULE`s, and a `TimeZone`.
pub struct RRuleSet {
  pub dtstart : time::DateTime
  pub tz : time::TimeZone
  pub rrules : Array[RRule]
  pub rdates : Array[time::DateTime]
  pub exdates : Array[time::DateTime]
  pub exrules : Array[RRule]
  pub disambiguation : time::Disambiguation
  dtstart_is_utc : Bool
  utc_rdates : Array[time::Timestamp]
  utc_exdates : Array[time::Timestamp]
}

///| Construct a UTC `RRuleSet`.
pub fn RRuleSet::new(dtstart : time::DateTime) -> RRuleSet {
  RRuleSet::{
    dtstart: dtstart,
    tz: time::TimeZone::utc(),
    rrules: [],
    rdates: [],
    exdates: [],
    exrules: [],
    disambiguation: time::Disambiguation::Compatible,
    dtstart_is_utc: false,
    utc_rdates: [],
    utc_exdates: [],
  }
}

///| Construct a timezone-aware `RRuleSet` with RFC 5545 `Compatible` DST disambiguation.
pub fn RRuleSet::with_tz(dtstart : time::DateTime, tz : time::TimeZone) -> RRuleSet {
  RRuleSet::{
    dtstart: dtstart,
    tz: tz,
    rrules: [],
    rdates: [],
    exdates: [],
    exrules: [],
    disambiguation: time::Disambiguation::Compatible,
    dtstart_is_utc: false,
    utc_rdates: [],
    utc_exdates: [],
  }
}

///| Add an `RRULE` to the set.
pub fn RRuleSet::add_rrule(self : RRuleSet, rule : RRule) -> Unit {
  self.rrules.push(rule)
}

///| Add an explicit recurrence date (`RDATE`) to the set.
pub fn RRuleSet::add_rdate(self : RRuleSet, dt : time::DateTime) -> Unit {
  self.rdates.push(dt)
}

///| Add an exception date (`EXDATE`) to the set.
pub fn RRuleSet::add_exdate(self : RRuleSet, dt : time::DateTime) -> Unit {
  self.exdates.push(dt)
}

///| Add an exception rule (`EXRULE`) to the set.
pub fn RRuleSet::add_exrule(self : RRuleSet, rule : RRule) -> Unit {
  self.exrules.push(rule)
}

///| Parse a comma-separated list of iCalendar DATE/DATE-TIME values into `out` (used by VTIMEZONE).
fn parse_datetime_csv(
  raw : String,
  tzid : Option[String],
  out : Array[time::DateTime],
) -> Result[Unit, IcalError] {
  let n = raw.length()
  let mut pos = 0
  while pos < n {
    let mut comma = pos
    while comma < n && raw.code_unit_at(comma) != 44 {
      comma = comma + 1
    }
    let sb = StringBuilder::new()
    let mut k = pos
    while k < comma {
      sb.write_byte(raw.code_unit_at(k).to_byte())
      k = k + 1
    }
    match parse_ical_datetime(sb.to_string(), tzid) {
      Ok(idt) => out.push(ical_datetime_to_datetime(idt))
      Err(e) => return Err(e)
    }
    pos = comma + 1
  }
  Ok(())
}

///| Parse a comma-separated list of `RDATE`/`EXDATE` values (supporting `Z`, `TZID`, and `VALUE=PERIOD`).
fn parse_rset_datetime_csv(
  raw : String,
  tzid : Option[String],
  is_period : Bool,
  local_out : Array[time::DateTime],
  utc_out : Array[time::Timestamp],
) -> Result[Unit, IcalError] {
  let n = raw.length()
  let mut pos = 0
  while pos < n {
    let mut comma = pos
    while comma < n && raw.code_unit_at(comma) != 44 {
      comma = comma + 1
    }
    // For VALUE=PERIOD (RFC 5545 §3.8.5.2), extract the start date-time before '/'.
    let mut tok_end = comma
    if is_period {
      let mut slash = pos
      while slash < comma && raw.code_unit_at(slash) != 47 {
        slash = slash + 1
      }
      if slash < comma {
        if slash + 1 >= comma {
          return Err(IcalError::InvalidDateTime("empty duration/end in PERIOD value"))
        }
        tok_end = slash
      }
    }
    let sb = StringBuilder::new()
    let mut k = pos
    while k < tok_end {
      sb.write_byte(raw.code_unit_at(k).to_byte())
      k = k + 1
    }
    match parse_ical_datetime(sb.to_string(), tzid) {
      Ok(idt) =>
      match idt {
        IcalDateTime::Utc(udt) =>
        match time::Offset::utc().to_timestamp(udt) {
          Ok(ts) => utc_out.push(ts)
          Err(e) => return Err(IcalError::InvalidDateTime(e.message))
        }
        _ => local_out.push(ical_datetime_to_datetime(idt))
      }
      Err(e) => return Err(e)
    }
    pos = comma + 1
  }
  Ok(())
}

///| Build an `RRuleSet` from a parsed `VEVENT` / `VTODO` component.
pub fn RRuleSet::from_component(
  comp : Component,
  tz : time::TimeZone,
) -> Result[RRuleSet, IcalError] {
  let dtstart_prop = match comp.get_property("DTSTART") {
    Some(p) => p
    None => return Err(IcalError::InvalidProperty("component missing DTSTART"))
  }
  let dtstart_idt = match parse_ical_datetime(dtstart_prop.value, dtstart_prop.get_param_first("TZID")) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dtstart_is_utc = match dtstart_idt {
    IcalDateTime::Utc(_) => true
    _ => false
  }
  let set = RRuleSet::{
    dtstart: ical_datetime_to_datetime(dtstart_idt),
    tz: tz,
    rrules: [],
    rdates: [],
    exdates: [],
    exrules: [],
    disambiguation: time::Disambiguation::Compatible,
    dtstart_is_utc: dtstart_is_utc,
    utc_rdates: [],
    utc_exdates: [],
  }

  let rrule_props = comp.get_properties("RRULE")
  let mut i = 0
  while i < rrule_props.length() {
    match RRule::parse(rrule_props[i].value) {
      Ok(r) => set.add_rrule(r)
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  let exrule_props = comp.get_properties("EXRULE")
  let mut j = 0
  while j < exrule_props.length() {
    match RRule::parse(exrule_props[j].value) {
      Ok(r) => set.add_exrule(r)
      Err(e) => return Err(e)
    }
    j = j + 1
  }

  let rdate_props = comp.get_properties("RDATE")
  let mut k = 0
  while k < rdate_props.length() {
    let is_period = match rdate_props[k].get_param_first("VALUE") {
      Some(v) => ascii_eq_ignore_case(v, "PERIOD")
      None => false
    }
    match parse_rset_datetime_csv(
      rdate_props[k].value,
      rdate_props[k].get_param_first("TZID"),
      is_period,
      set.rdates,
      set.utc_rdates,
    ) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    k = k + 1
  }

  let exdate_props = comp.get_properties("EXDATE")
  let mut m = 0
  while m < exdate_props.length() {
    match parse_rset_datetime_csv(
      exdate_props[m].value,
      exdate_props[m].get_param_first("TZID"),
      false,
      set.exdates,
      set.utc_exdates,
    ) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    m = m + 1
  }

  Ok(set)
}

///| Sort an `Array[time::Zoned]` by ascending `timestamp` and deduplicate identical timestamps.
fn sort_dedup_zoned(arr : Array[time::Zoned]) -> Array[time::Zoned] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mut gap = n / 2
  while gap > 0 {
    let mut i = gap
    while i < n {
      let temp = arr[i]
      let mut j = i
      while j >= gap && arr[j - gap].timestamp.cmp(temp.timestamp) > 0 {
        arr[j] = arr[j - gap]
        j = j - gap
      }
      arr[j] = temp
      i = i + 1
    }
    gap = gap / 2
  }
  let out : Array[time::Zoned] = []
  out.push(arr[0])
  let mut k = 1
  while k < n {
    if arr[k].timestamp.cmp(arr[k - 1].timestamp) != 0 {
      out.push(arr[k])
    }
    k = k + 1
  }
  out
}

///| Resolve a civil `DateTime` in `tz` using `mode`.
fn resolve_zoned(
  dt : time::DateTime,
  tz : time::TimeZone,
  mode : time::Disambiguation,
) -> Result[time::Zoned, IcalError] {
  match tz.to_ambiguous_zoned(dt).disambiguate(mode) {
    Ok(z) => Ok(z)
    Err(e) => Err(IcalError::InvalidDateTime(e.message))
  }
}

///| Binary search whether `ts` exists in a sorted `Array[time::Zoned]`.
fn zoned_array_contains_ts(arr : Array[time::Zoned], ts : time::Timestamp) -> Bool {
  let mut lo = 0
  let mut hi = arr.length()
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let c = arr[mid].timestamp.cmp(ts)
    if c == 0 {
      return true
    } else if c < 0 {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  false
}

///| Resolve a civil `DateTime` in `tz` using `mode`, or as UTC if `as_utc` is true.
fn resolve_rule_dt(
  dt : time::DateTime,
  tz : time::TimeZone,
  mode : time::Disambiguation,
  as_utc : Bool,
) -> Result[time::Zoned, IcalError] {
  if as_utc {
    match time::Offset::utc().to_timestamp(dt) {
      Ok(ts) => Ok(tz.to_zoned(ts))
      Err(e) => Err(IcalError::InvalidDateTime(e.message))
    }
  } else {
    resolve_zoned(dt, tz, mode)
  }
}

///| Monotone, deduplicated `Zoned` stream wrapper around an `RRuleIter`.
///| Uses a bounded 4-hour lookahead reorder buffer for non-UTC zoned streams so spring-forward
///| DST gaps never emit out-of-order or duplicated UTC instants.
struct ZonedRuleStream {
  iter : RRuleIter
  tz : time::TimeZone
  mode : time::Disambiguation
  as_utc : Bool
  needs_reorder : Bool
  mut buf : Array[time::Zoned]
  mut max_seen_sec : Int64
  mut has_max : Bool
  mut exhausted : Bool
  mut last_emitted : Option[time::Timestamp]
}

///| Create a `ZonedRuleStream` for an `RRule` in `set`.
fn ZonedRuleStream::new(rule : RRule, set : RRuleSet) -> ZonedRuleStream {
  let iter = if set.dtstart_is_utc {
    rule.iter(set.dtstart)
  } else {
    rule.iter_with_tz(set.dtstart, set.tz, set.disambiguation)
  }
  let is_utc_tz = set.tz.iana_name() == "UTC"
  let needs_reorder = !set.dtstart_is_utc && !is_utc_tz
  ZonedRuleStream::{
    iter: iter,
    tz: set.tz,
    mode: set.disambiguation,
    as_utc: set.dtstart_is_utc,
    needs_reorder: needs_reorder,
    buf: [],
    max_seen_sec: 0L,
    has_max: false,
    exhausted: false,
    last_emitted: None,
  }
}

///| Insert `z` into `self.buf` in ascending timestamp order, ignoring duplicate timestamps.
fn ZonedRuleStream::insert_sorted(self : ZonedRuleStream, z : time::Zoned) -> Unit {
  let n = self.buf.length()
  let mut pos = n
  while pos > 0 {
    let c = self.buf[pos - 1].timestamp.cmp(z.timestamp)
    if c == 0 {
      return
    }
    if c < 0 {
      break
    }
    pos = pos - 1
  }
  self.buf.push(z)
  let mut k = n
  while k > pos {
    self.buf[k] = self.buf[k - 1]
    k = k - 1
  }
  self.buf[pos] = z
}

///| Pop the next strictly-ascending `time::Zoned` from this stream.
fn ZonedRuleStream::next(self : ZonedRuleStream) -> Result[Option[time::Zoned], IcalError] {
  if !self.needs_reorder {
    while true {
      match self.iter.next() {
        Ok(Some(dt)) =>
        match resolve_rule_dt(dt, self.tz, self.mode, self.as_utc) {
          Ok(z) =>
          match self.last_emitted {
            Some(prev) => if z.timestamp.cmp(prev) == 0 { continue } else {
              self.last_emitted = Some(z.timestamp)
              return Ok(Some(z))
            }
            None => {
              self.last_emitted = Some(z.timestamp)
              return Ok(Some(z))
            }
          }
          Err(e) => return Err(e)
        }
        Ok(None) => return Ok(None)
        Err(e) => return Err(e)
      }
    }
  }
  // Lookahead reorder window (14400s = 4 hours > any DST spring-forward gap).
  while true {
    while !self.exhausted &&
    (self.buf.length() == 0 || !self.has_max || self.max_seen_sec - self.buf[0].timestamp.as_second() < 14400L) {
      match self.iter.next() {
        Ok(Some(dt)) =>
        match resolve_rule_dt(dt, self.tz, self.mode, false) {
          Ok(z) => {
            let s = z.timestamp.as_second()
            if !self.has_max || s > self.max_seen_sec {
              self.max_seen_sec = s
              self.has_max = true
            }
            self.insert_sorted(z)
          }
          Err(e) => return Err(e)
        }
        Ok(None) => self.exhausted = true
        Err(e) => return Err(e)
      }
    }
    if self.buf.length() == 0 {
      return Ok(None)
    }
    let chosen = self.buf[0]
    // Shift left (buf is tiny: typically 1..8 elements)
    let new_buf : Array[time::Zoned] = []
    let mut i = 1
    while i < self.buf.length() {
      new_buf.push(self.buf[i])
      i = i + 1
    }
    self.buf = new_buf
    match self.last_emitted {
      Some(prev) => if chosen.timestamp.cmp(prev) <= 0 { continue }
      None => ()
    }
    self.last_emitted = Some(chosen.timestamp)
    return Ok(Some(chosen))
  }
  Ok(None)
}

///| Streaming k-way merge state for `RRuleSet`.
struct RRuleSetMerger {
  inc_streams : Array[ZonedRuleStream]
  inc_heads : Array[Option[time::Zoned]]
  rdates : Array[time::Zoned]
  mut rdate_idx : Int
  ex_streams : Array[ZonedRuleStream]
  ex_heads : Array[Option[time::Zoned]]
  exdates : Array[time::Zoned]
  mut exdate_idx : Int
  mut last_emitted : Option[time::Timestamp]
}

///| Initialize a streaming `RRuleSetMerger`.
fn RRuleSetMerger::new(set : RRuleSet) -> Result[RRuleSetMerger, IcalError] {
  let inc_streams : Array[ZonedRuleStream] = []
  let inc_heads : Array[Option[time::Zoned]] = []
  let mut i = 0
  while i < set.rrules.length() {
    let st = ZonedRuleStream::new(set.rrules[i], set)
    let head = match st.next() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    inc_streams.push(st)
    inc_heads.push(head)
    i = i + 1
  }

  let rdates_raw : Array[time::Zoned] = []
  let mut j = 0
  while j < set.rdates.length() {
    match resolve_zoned(set.rdates[j], set.tz, set.disambiguation) {
      Ok(z) => rdates_raw.push(z)
      Err(e) => return Err(e)
    }
    j = j + 1
  }
  let mut j2 = 0
  while j2 < set.utc_rdates.length() {
    rdates_raw.push(set.tz.to_zoned(set.utc_rdates[j2]))
    j2 = j2 + 1
  }
  let rdates = sort_dedup_zoned(rdates_raw)

  let ex_streams : Array[ZonedRuleStream] = []
  let ex_heads : Array[Option[time::Zoned]] = []
  let mut k = 0
  while k < set.exrules.length() {
    let st = ZonedRuleStream::new(set.exrules[k], set)
    let head = match st.next() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    ex_streams.push(st)
    ex_heads.push(head)
    k = k + 1
  }

  let exdates_raw : Array[time::Zoned] = []
  let mut m = 0
  while m < set.exdates.length() {
    match resolve_zoned(set.exdates[m], set.tz, set.disambiguation) {
      Ok(z) => exdates_raw.push(z)
      Err(e) => return Err(e)
    }
    m = m + 1
  }
  let mut m2 = 0
  while m2 < set.utc_exdates.length() {
    exdates_raw.push(set.tz.to_zoned(set.utc_exdates[m2]))
    m2 = m2 + 1
  }
  let exdates = sort_dedup_zoned(exdates_raw)

  Ok(RRuleSetMerger::{
    inc_streams: inc_streams,
    inc_heads: inc_heads,
    rdates: rdates,
    rdate_idx: 0,
    ex_streams: ex_streams,
    ex_heads: ex_heads,
    exdates: exdates,
    exdate_idx: 0,
    last_emitted: None,
  })
}

///| Check whether `ts` is excluded by `exdates` or `ex_streams` (advancing exclusion streams up to `ts`).
fn RRuleSetMerger::is_excluded(self : RRuleSetMerger, ts : time::Timestamp) -> Result[Bool, IcalError] {
  while self.exdate_idx < self.exdates.length() {
    let c = self.exdates[self.exdate_idx].timestamp.cmp(ts)
    if c < 0 {
      self.exdate_idx = self.exdate_idx + 1
    } else if c == 0 {
      return Ok(true)
    } else {
      break
    }
  }
  let mut i = 0
  while i < self.ex_streams.length() {
    while true {
      match self.ex_heads[i] {
        None => break
        Some(h) => {
          let c = h.timestamp.cmp(ts)
          if c < 0 {
            match self.ex_streams[i].next() {
              Ok(v) => self.ex_heads[i] = v
              Err(e) => return Err(e)
            }
          } else if c == 0 {
            return Ok(true)
          } else {
            break
          }
        }
      }
    }
    i = i + 1
  }
  Ok(false)
}

///| Pop the next deduplicated, non-excluded `time::Zoned` occurrence in ascending timestamp order.
fn RRuleSetMerger::next(self : RRuleSetMerger) -> Result[Option[time::Zoned], IcalError] {
  while true {
    // Pick minimum among inc_heads and rdates[rdate_idx]
    let mut best : Option[time::Zoned] = None
    let mut best_src = -2 // -1 = rdates, >=0 = inc_streams[idx]
    if self.rdate_idx < self.rdates.length() {
      best = Some(self.rdates[self.rdate_idx])
      best_src = -1
    }
    let mut i = 0
    while i < self.inc_heads.length() {
      match self.inc_heads[i] {
        Some(h) =>
        match best {
          None => {
            best = Some(h)
            best_src = i
          }
          Some(b) =>
          if h.timestamp.cmp(b.timestamp) < 0 {
            best = Some(h)
            best_src = i
          }
        }
        None => ()
      }
      i = i + 1
    }
    let chosen = match best {
      Some(z) => z
      None => return Ok(None)
    }
    // Advance chosen source
    if best_src == -1 {
      self.rdate_idx = self.rdate_idx + 1
    } else {
      match self.inc_streams[best_src].next() {
        Ok(v) => self.inc_heads[best_src] = v
        Err(e) => return Err(e)
      }
    }
    // Deduplicate against last_emitted
    match self.last_emitted {
      Some(prev) => if chosen.timestamp.cmp(prev) <= 0 { continue }
      None => ()
    }
    // Check exclusions
    match self.is_excluded(chosen.timestamp) {
      Ok(true) => continue
      Ok(false) => {
        self.last_emitted = Some(chosen.timestamp)
        return Ok(Some(chosen))
      }
      Err(e) => return Err(e)
    }
  }
  Ok(None)
}

///| Check whether `self` is eligible for the zero-lookup UTC whole-second fast path.
fn RRuleSet::is_utc_whole_sec(self : RRuleSet) -> Bool {
  if self.tz.iana_name() != "UTC" || self.dtstart.time.nanosecond != 0 {
    return false
  }
  let mut i = 0
  while i < self.rdates.length() {
    if self.rdates[i].time.nanosecond != 0 {
      return false
    }
    i = i + 1
  }
  let mut j = 0
  while j < self.exdates.length() {
    if self.exdates[j].time.nanosecond != 0 {
      return false
    }
    j = j + 1
  }
  let mut k = 0
  while k < self.utc_rdates.length() {
    if self.utc_rdates[k].nanos != 0 {
      return false
    }
    k = k + 1
  }
  let mut m = 0
  while m < self.utc_exdates.length() {
    if self.utc_exdates[m].nanos != 0 {
      return false
    }
    m = m + 1
  }
  true
}

///| Construct a UTC `time::Zoned` directly from whole epoch seconds without timezone table lookup.
fn sec_to_utc_zoned(sec : Int64, tz : time::TimeZone) -> time::Zoned {
  let ed = floor_div_86400(sec)
  let sod = (sec - ed.to_int64() * 86400L).to_int()
  time::Zoned::{
    timestamp: time::Timestamp::{ secs: sec, nanos: 0 },
    datetime: ed_sec_to_datetime(ed, sod),
    offset: time::Offset::{ seconds: 0 },
    tz: tz,
  }
}

///| Collect sorted deduplicated UTC epoch seconds from `local_dts` and `utc_ts`, optionally bounded to `[min_sec, max_sec]`.
fn collect_utc_secs(
  local_dts : Array[time::DateTime],
  utc_ts : Array[time::Timestamp],
  bounded : Bool,
  min_sec : Int64,
  max_sec : Int64,
) -> Array[Int64] {
  let n = local_dts.length() + utc_ts.length()
  if n == 0 {
    return []
  }
  let raw : Array[Int64] = Array::with_capacity(n)
  let mut i = 0
  while i < local_dts.length() {
    let s = dt_to_epoch_sec(local_dts[i])
    if !bounded || (s >= min_sec && s <= max_sec) {
      raw.push(s)
    }
    i = i + 1
  }
  let mut j = 0
  while j < utc_ts.length() {
    let s = utc_ts[j].secs
    if !bounded || (s >= min_sec && s <= max_sec) {
      raw.push(s)
    }
    j = j + 1
  }
  sort_dedup_i64(raw)
}

///| UTC whole-second fast path for `RRuleSet::between`.
fn RRuleSet::between_utc_fast(
  self : RRuleSet,
  after : time::Timestamp,
  before : time::Timestamp,
  inclusive : Bool,
) -> Result[Array[time::Zoned], IcalError] {
  let min_sec = if after.nanos > 0 {
    after.secs + 1L
  } else if inclusive {
    after.secs
  } else {
    after.secs + 1L
  }
  let max_sec = if before.nanos > 0 {
    before.secs
  } else if inclusive {
    before.secs
  } else {
    before.secs - 1L
  }
  if min_sec > max_sec {
    return Ok([])
  }
  let min_ed = floor_div_86400(min_sec)

  let n_inc = self.rrules.length()
  let inc_iters : Array[RRuleIter] = Array::with_capacity(n_inc)
  let inc_heads : Array[Int64] = Array::with_capacity(n_inc)
  let inc_active : Array[Bool] = Array::with_capacity(n_inc)
  let mut i = 0
  while i < n_inc {
    let it = self.rrules[i].iter(self.dtstart)
    it.fast_forward_to_ed(min_ed)
    let mut active = false
    let mut head_sec = 0L
    while true {
      match it.next_epoch_sec() {
        Ok(Some(s)) => {
          if s < min_sec {
            continue
          }
          if s <= max_sec {
            active = true
            head_sec = s
          }
          break
        }
        Ok(None) => break
        Err(e) => return Err(e)
      }
    }
    inc_iters.push(it)
    inc_heads.push(head_sec)
    inc_active.push(active)
    i = i + 1
  }

  let rdate_secs = collect_utc_secs(self.rdates, self.utc_rdates, true, min_sec, max_sec)
  let mut rd_idx = 0
  let rd_len = rdate_secs.length()

  let exdate_secs = collect_utc_secs(self.exdates, self.utc_exdates, true, min_sec, max_sec)
  let mut ex_idx = 0
  let ex_len = exdate_secs.length()

  let n_ex = self.exrules.length()
  let ex_iters : Array[RRuleIter] = Array::with_capacity(n_ex)
  let ex_heads : Array[Int64] = Array::with_capacity(n_ex)
  let ex_active : Array[Bool] = Array::with_capacity(n_ex)
  let mut k = 0
  while k < n_ex {
    let it = self.exrules[k].iter(self.dtstart)
    it.fast_forward_to_ed(min_ed)
    let mut active = false
    let mut head_sec = 0L
    while true {
      match it.next_epoch_sec() {
        Ok(Some(s)) => {
          if s < min_sec {
            continue
          }
          if s <= max_sec {
            active = true
            head_sec = s
          }
          break
        }
        Ok(None) => break
        Err(e) => return Err(e)
      }
    }
    ex_iters.push(it)
    ex_heads.push(head_sec)
    ex_active.push(active)
    k = k + 1
  }

  let out : Array[time::Zoned] = Array::with_capacity(64)
  let tz = self.tz
  let utc_off = time::Offset::{ seconds: 0 }
  let mut has_last = false
  let mut last_sec = 0L
  let mut cached_sod = -1
  let mut cached_time = time::Time::midnight()

  // Fast specialized merge when 2 RRULEs and 0 EXRULEs (avoids inner loop & array indexing)
  if n_inc == 2 && n_ex == 0 {
    let it0 = inc_iters[0]
    let it1 = inc_iters[1]
    let mut a0 = inc_active[0]
    let mut a1 = inc_active[1]
    let mut h0 = inc_heads[0]
    let mut h1 = inc_heads[1]
    while true {
      let mut has_best = false
      let mut best_sec = 0L
      let mut best_src = -2
      if rd_idx < rd_len {
        has_best = true
        best_sec = rdate_secs[rd_idx]
        best_src = -1
      }
      if a0 && (!has_best || h0 < best_sec) {
        has_best = true
        best_sec = h0
        best_src = 0
      }
      if a1 && (!has_best || h1 < best_sec) {
        has_best = true
        best_sec = h1
        best_src = 1
      }
      if !has_best {
        break
      }
      if best_src == 0 {
        match it0.next_epoch_sec() {
          Ok(Some(ns)) => if ns <= max_sec { h0 = ns } else { a0 = false }
          Ok(None) => a0 = false
          Err(e) => return Err(e)
        }
      } else if best_src == 1 {
        match it1.next_epoch_sec() {
          Ok(Some(ns)) => if ns <= max_sec { h1 = ns } else { a1 = false }
          Ok(None) => a1 = false
          Err(e) => return Err(e)
        }
      } else {
        rd_idx = rd_idx + 1
      }
      if has_last && best_sec <= last_sec {
        continue
      }
      let mut excluded = false
      while ex_idx < ex_len {
        let es = exdate_secs[ex_idx]
        if es < best_sec {
          ex_idx = ex_idx + 1
        } else if es == best_sec {
          excluded = true
          break
        } else {
          break
        }
      }
      if excluded {
        continue
      }
      has_last = true
      last_sec = best_sec
      let ed = floor_div_86400(best_sec)
      let sod = (best_sec - ed.to_int64() * 86400L).to_int()
      if sod != cached_sod {
        cached_sod = sod
        let hh = sod / 3600
        let rem = sod - hh * 3600
        let mm = rem / 60
        let ss = rem - mm * 60
        cached_time = time::Time::{ hour: hh, minute: mm, second: ss, nanosecond: 0 }
      }
      out.push(time::Zoned::{
        timestamp: time::Timestamp::{ secs: best_sec, nanos: 0 },
        datetime: time::DateTime::{ date: date_from_ed(ed), time: cached_time },
        offset: utc_off,
        tz: tz,
      })
    }
    return Ok(out)
  }

  while true {
    let mut has_best = false
    let mut best_sec = 0L
    let mut best_src = -2
    if rd_idx < rd_len {
      has_best = true
      best_sec = rdate_secs[rd_idx]
      best_src = -1
    }
    let mut idx = 0
    while idx < n_inc {
      if inc_active[idx] {
        let h = inc_heads[idx]
        if !has_best || h < best_sec {
          has_best = true
          best_sec = h
          best_src = idx
        }
      }
      idx = idx + 1
    }
    if !has_best {
      break
    }
    // Advance chosen source
    if best_src == -1 {
      rd_idx = rd_idx + 1
    } else {
      match inc_iters[best_src].next_epoch_sec() {
        Ok(Some(ns)) => if ns <= max_sec {
          inc_heads[best_src] = ns
        } else {
          inc_active[best_src] = false
        }
        Ok(None) => inc_active[best_src] = false
        Err(e) => return Err(e)
      }
    }
    // Deduplicate
    if has_last && best_sec <= last_sec {
      continue
    }
    // Single-pointer EXDATE check
    let mut excluded = false
    while ex_idx < ex_len {
      let es = exdate_secs[ex_idx]
      if es < best_sec {
        ex_idx = ex_idx + 1
      } else if es == best_sec {
        excluded = true
        break
      } else {
        break
      }
    }
    // EXRULE check (only when exrules exist)
    if !excluded && n_ex > 0 {
      let mut ei = 0
      while ei < n_ex {
        while ex_active[ei] {
          let eh = ex_heads[ei]
          if eh < best_sec {
            match ex_iters[ei].next_epoch_sec() {
              Ok(Some(ns)) => if ns <= max_sec {
                ex_heads[ei] = ns
              } else {
                ex_active[ei] = false
              }
              Ok(None) => ex_active[ei] = false
              Err(e) => return Err(e)
            }
          } else if eh == best_sec {
            excluded = true
            break
          } else {
            break
          }
        }
        if excluded {
          break
        }
        ei = ei + 1
      }
    }
    if excluded {
      continue
    }
    has_last = true
    last_sec = best_sec
    let ed = floor_div_86400(best_sec)
    let sod = (best_sec - ed.to_int64() * 86400L).to_int()
    if sod != cached_sod {
      cached_sod = sod
      let hh = sod / 3600
      let rem = sod - hh * 3600
      let mm = rem / 60
      let ss = rem - mm * 60
      cached_time = time::Time::{ hour: hh, minute: mm, second: ss, nanosecond: 0 }
    }
    out.push(time::Zoned::{
      timestamp: time::Timestamp::{ secs: best_sec, nanos: 0 },
      datetime: time::DateTime::{ date: date_from_ed(ed), time: cached_time },
      offset: utc_off,
      tz: tz,
    })
  }
  Ok(out)
}

///| Expand up to `limit` zoned occurrences in ascending instant order.
pub fn RRuleSet::all(
  self : RRuleSet,
  limit : Int,
) -> Result[Array[time::Zoned], IcalError] {
  let out : Array[time::Zoned] = []
  if limit <= 0 {
    return Ok(out)
  }
  let m = match RRuleSetMerger::new(self) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  while out.length() < limit {
    match m.next() {
      Ok(Some(z)) => out.push(z)
      Ok(None) => break
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///| Expand zoned occurrences in `[after, before]` (if `inclusive`) or `(after, before)`.
pub fn RRuleSet::between(
  self : RRuleSet,
  after : time::Timestamp,
  before : time::Timestamp,
  inclusive : Bool,
) -> Result[Array[time::Zoned], IcalError] {
  if after.cmp(before) > 0 {
    return Ok([])
  }
  if self.is_utc_whole_sec() {
    return self.between_utc_fast(after, before, inclusive)
  }
  let out : Array[time::Zoned] = []
  let m = match RRuleSetMerger::new(self) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  while true {
    match m.next() {
      Ok(Some(z)) => {
        let cb = z.timestamp.cmp(before)
        if cb > 0 || (!inclusive && cb == 0) {
          break
        }
        let ca = z.timestamp.cmp(after)
        if ca > 0 || (inclusive && ca == 0) {
          out.push(z)
        }
      }
      Ok(None) => break
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///| Return the first zoned occurrence after (or at, if `inclusive`) `ts`.
pub fn RRuleSet::after(
  self : RRuleSet,
  ts : time::Timestamp,
  inclusive : Bool,
) -> Result[Option[time::Zoned], IcalError] {
  let m = match RRuleSetMerger::new(self) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  while true {
    match m.next() {
      Ok(Some(z)) => {
        let c = z.timestamp.cmp(ts)
        if c > 0 || (inclusive && c == 0) {
          return Ok(Some(z))
        }
      }
      Ok(None) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  Ok(None)
}

///| Return the last zoned occurrence before (or at, if `inclusive`) `ts`.
pub fn RRuleSet::before(
  self : RRuleSet,
  ts : time::Timestamp,
  inclusive : Bool,
) -> Result[Option[time::Zoned], IcalError] {
  let m = match RRuleSetMerger::new(self) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let mut last : Option[time::Zoned] = None
  while true {
    match m.next() {
      Ok(Some(z)) => {
        let c = z.timestamp.cmp(ts)
        if c > 0 || (!inclusive && c == 0) {
          return Ok(last)
        }
        last = Some(z)
      }
      Ok(None) => return Ok(last)
      Err(e) => return Err(e)
    }
  }
  Ok(last)
}
