///| RFC 5545 §3.6.5 VTIMEZONE observance model & UTC offset parser.

import "time"

///| A single `STANDARD` or `DAYLIGHT` observance inside `VTIMEZONE`.
pub struct TzObservance {
  pub is_daylight : Bool
  pub dtstart : time::DateTime
  pub offset_from : time::Offset
  pub offset_to : time::Offset
  pub tzname : Option[String]
  pub rrules : Array[RRule]
  pub rdates : Array[time::DateTime]
}

///| Parsed `VTIMEZONE` component.
pub struct VTimeZone {
  pub tzid : String
  pub observances : Array[TzObservance]
}

///| Parse an RFC 5545 §3.3.14 UTC-OFFSET (`+HHMM`, `-HHMM`, `+HHMMSS`, `-HHMMSS`).
pub fn parse_utc_offset(s : String) -> Result[time::Offset, IcalError] {
  let n = s.length()
  if n != 5 && n != 7 {
    return Err(IcalError::InvalidDateTime("invalid UTC-OFFSET length: " + s))
  }
  let sign_b = s.code_unit_at(0)
  let neg = if sign_b == 45 {
    true
  } else if sign_b == 43 {
    false
  } else {
    return Err(IcalError::InvalidDateTime("UTC-OFFSET must start with '+' or '-': " + s))
  }
  let h = parse_2_digits(s, 1)
  let m = parse_2_digits(s, 3)
  let sc = if n == 7 { parse_2_digits(s, 5) } else { 0 }
  if h < 0 || h > 23 || m < 0 || m > 59 || sc < 0 || sc > 59 {
    return Err(IcalError::InvalidDateTime("invalid UTC-OFFSET components: " + s))
  }
  let mag = h * 3600 + m * 60 + sc
  let secs = if neg { -mag } else { mag }
  match time::Offset::from_seconds(secs) {
    Ok(off) => Ok(off)
    Err(e) => Err(IcalError::InvalidDateTime(e.message))
  }
}

///| Parse a `STANDARD` or `DAYLIGHT` subcomponent into `TzObservance`.
fn parse_tz_observance(comp : Component, is_daylight : Bool) -> Result[TzObservance, IcalError] {
  let dtstart_prop = match comp.get_property("DTSTART") {
    Some(p) => p
    None => return Err(IcalError::InvalidProperty("VTIMEZONE observance missing DTSTART"))
  }
  let dtstart = match parse_ical_datetime(dtstart_prop.value, None) {
    Ok(idt) => ical_datetime_to_datetime(idt)
    Err(e) => return Err(e)
  }
  let from_prop = match comp.get_property("TZOFFSETFROM") {
    Some(p) => p
    None => return Err(IcalError::InvalidProperty("VTIMEZONE observance missing TZOFFSETFROM"))
  }
  let offset_from = match parse_utc_offset(from_prop.value) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let to_prop = match comp.get_property("TZOFFSETTO") {
    Some(p) => p
    None => return Err(IcalError::InvalidProperty("VTIMEZONE observance missing TZOFFSETTO"))
  }
  let offset_to = match parse_utc_offset(to_prop.value) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let tzname = match comp.get_property("TZNAME") {
    Some(p) => Some(p.value)
    None => None
  }
  let rrules : Array[RRule] = []
  let rr_props = comp.get_properties("RRULE")
  let mut i = 0
  while i < rr_props.length() {
    match RRule::parse(rr_props[i].value) {
      Ok(r) => rrules.push(r)
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  let rdates : Array[time::DateTime] = []
  let rd_props = comp.get_properties("RDATE")
  let mut j = 0
  while j < rd_props.length() {
    match parse_datetime_csv(rd_props[j].value, None, rdates) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    j = j + 1
  }
  Ok(TzObservance::{
    is_daylight: is_daylight,
    dtstart: dtstart,
    offset_from: offset_from,
    offset_to: offset_to,
    tzname: tzname,
    rrules: rrules,
    rdates: rdates,
  })
}

///| Parse a `VTIMEZONE` component into a structured `VTimeZone`.
pub fn VTimeZone::from_component(comp : Component) -> Result[VTimeZone, IcalError] {
  if !ascii_eq_ignore_case(comp.name, "VTIMEZONE") {
    return Err(IcalError::InvalidProperty("expected VTIMEZONE component, got " + comp.name))
  }
  let tzid = match comp.get_property("TZID") {
    Some(p) => p.value
    None => return Err(IcalError::InvalidProperty("VTIMEZONE missing TZID"))
  }
  let observances : Array[TzObservance] = []
  let mut i = 0
  while i < comp.subcomponents.length() {
    let sub = comp.subcomponents[i]
    if ascii_eq_ignore_case(sub.name, "STANDARD") {
      match parse_tz_observance(sub, false) {
        Ok(obs) => observances.push(obs)
        Err(e) => return Err(e)
      }
    } else if ascii_eq_ignore_case(sub.name, "DAYLIGHT") {
      match parse_tz_observance(sub, true) {
        Ok(obs) => observances.push(obs)
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }
  if observances.length() == 0 {
    return Err(IcalError::InvalidProperty("VTIMEZONE has no STANDARD or DAYLIGHT observances"))
  }
  Ok(VTimeZone::{ tzid: tzid, observances: observances })
}

///| Resolve the UTC offset active for a given civil `DateTime` according to this `VTimeZone`.
pub fn VTimeZone::offset_at(self : VTimeZone, dt : time::DateTime) -> Option[time::Offset] {
  let mut best_trans : Option[time::DateTime] = None
  let mut best_offset : Option[time::Offset] = None
  let mut i = 0
  while i < self.observances.length() {
    let obs = self.observances[i]
    // Candidate 1: dtstart itself
    if obs.dtstart.cmp(dt) <= 0 {
      let better = match best_trans {
        None => true
        Some(prev) => obs.dtstart.cmp(prev) > 0
      }
      if better {
        best_trans = Some(obs.dtstart)
        best_offset = Some(obs.offset_to)
      }
    }
    // Candidate 2: explicit RDATEs
    let mut j = 0
    while j < obs.rdates.length() {
      let rd = obs.rdates[j]
      if rd.cmp(dt) <= 0 {
        let better = match best_trans {
          None => true
          Some(prev) => rd.cmp(prev) > 0
        }
        if better {
          best_trans = Some(rd)
          best_offset = Some(obs.offset_to)
        }
      }
      j = j + 1
    }
    // Candidate 3: RRULEs
    let mut k = 0
    while k < obs.rrules.length() {
      match obs.rrules[k].before(obs.dtstart, dt, true) {
        Ok(Some(occ)) => {
          let better = match best_trans {
            None => true
            Some(prev) => occ.cmp(prev) > 0
          }
          if better {
            best_trans = Some(occ)
            best_offset = Some(obs.offset_to)
          }
        }
        _ => ()
      }
      k = k + 1
    }
    i = i + 1
  }
  best_offset
}
