///| Core types, lookup helpers, and RFC 5545 DATE / DATE-TIME parsing & formatting for `packages/ical`.

import "time"

///| Structured error type for iCalendar parsing, serialization, and RRULE evaluation.
pub enum IcalError {
  InvalidSyntax(String)
  InvalidProperty(String)
  InvalidParameter(String)
  InvalidDateTime(String)
  InvalidRRule(String)
  LimitExceeded(String)
  Unimplemented(String)
}

///| Format an `IcalError` as a human-readable string.
pub fn ical_error_to_string(e : IcalError) -> String {
  match e {
    IcalError::InvalidSyntax(m) => "InvalidSyntax: " + m
    IcalError::InvalidProperty(m) => "InvalidProperty: " + m
    IcalError::InvalidParameter(m) => "InvalidParameter: " + m
    IcalError::InvalidDateTime(m) => "InvalidDateTime: " + m
    IcalError::InvalidRRule(m) => "InvalidRRule: " + m
    IcalError::LimitExceeded(m) => "LimitExceeded: " + m
    IcalError::Unimplemented(m) => "Unimplemented: " + m
  }
}

///| Uppercase an ASCII byte (`'a'..'z'` -> `'A'..'Z'`).
#verify
pub fn ascii_upper_byte(c : Int) -> Int {
  if c >= 97 && c <= 122 {
    c - 32
  } else {
    c
  }
}

///| Check whether byte `c` is a valid RFC 5545 §3.1 name byte (`ALPHA / DIGIT / "-"`).
#verify
pub fn is_ical_name_byte(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45
}

///| Clamp RFC 5545 leap second `60` to `59` for civil DateTime compatibility.
#verify
pub fn clamp_leap_second(sc : Int) -> Int {
  if sc == 60 { 59 } else { sc }
}

///| ASCII case-insensitive equality helper.
fn ascii_eq_ignore_case(a : String, b : String) -> Bool {
  let la = a.length()
  if la != b.length() {
    return false
  }
  let mut i = 0
  while i < la {
    let ca = ascii_upper_byte(a.code_unit_at(i))
    let cb = ascii_upper_byte(b.code_unit_at(i))
    if ca != cb {
      return false
    }
    i = i + 1
  }
  true
}

///| Convert an ASCII string slice `[start, end)` to uppercase.
fn slice_to_upper(s : String, start : Int, end : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = start
  while i < end {
    let c = ascii_upper_byte(s.code_unit_at(i))
    sb.write_byte(c.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Convert an entire ASCII string to uppercase.
fn ascii_to_upper(s : String) -> String {
  slice_to_upper(s, 0, s.length())
}

///| Check whether `s` is a valid RFC 5545 §3.1 name (`1*(ALPHA / DIGIT / "-")`).
fn is_valid_ical_name(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    if !is_ical_name_byte(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Sanitize a component, property, or parameter name to RFC 5545 `ALPHA / DIGIT / "-"`.
fn sanitize_ical_name(s : String) -> String {
  if is_valid_ical_name(s) {
    return s
  }
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if is_ical_name_byte(c) {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  let out = sb.to_string()
  if out.length() == 0 { "X-INVALID" } else { out }
}

///| Convert a civil `time::DateTime` to signed seconds since 1970-01-01T00:00:00.
fn dt_to_epoch_sec(dt : time::DateTime) -> Int64 {
  dt.date.to_epoch_days().to_int64() * 86400L + dt.time.to_second_of_day().to_int64()
}

///| Parse 2 ASCII digits at `pos`, returning -1 on failure.
fn parse_2_digits(s : String, pos : Int) -> Int {
  if pos + 2 > s.length() {
    return -1
  }
  let c0 = s.code_unit_at(pos) - 48
  let c1 = s.code_unit_at(pos + 1) - 48
  if c0 < 0 || c0 > 9 || c1 < 0 || c1 > 9 {
    return -1
  }
  c0 * 10 + c1
}

///| Parse 4 ASCII digits at `pos`, returning -1 on failure.
fn parse_4_digits(s : String, pos : Int) -> Int {
  let hi = parse_2_digits(s, pos)
  let lo = parse_2_digits(s, pos + 2)
  if hi < 0 || lo < 0 {
    return -1
  }
  hi * 100 + lo
}

///| Write a 2-digit zero-padded non-negative integer to `sb`.
fn write_2_digits(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + (v / 10) % 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

///| Write a 4-digit zero-padded non-negative integer to `sb`.
fn write_4_digits(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + (v / 1000) % 10).to_byte())
  sb.write_byte((48 + (v / 100) % 10).to_byte())
  sb.write_byte((48 + (v / 10) % 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

///| Resource limits enforced during iCalendar parsing to defend against DoS bombs.
#verify
pub val struct ParseLimits {
  pub max_depth : Int
  pub max_lines : Int
  pub max_components : Int
  pub max_properties_per_component : Int
  pub max_line_bytes : Int
}

///| Default conservative parsing limits.
#verify
pub fn ParseLimits::default() -> ParseLimits {
  ParseLimits::{
    max_depth: 32,
    max_lines: 200000,
    max_components: 50000,
    max_properties_per_component: 10000,
    max_line_bytes: 1048576,
  }
}

///| A property parameter (`NAME=val1,val2`).
pub struct Param {
  pub name : String
  pub values : Array[String]
}

///| Construct a `Param` with a single value.
pub fn Param::new(name : String, value : String) -> Param {
  Param::{ name: ascii_to_upper(name), values: [value] }
}

///| Construct a `Param` with multiple values.
pub fn Param::with_values(name : String, values : Array[String]) -> Param {
  Param::{ name: ascii_to_upper(name), values: values }
}

///| An iCalendar content-line property (`NAME;PARAM=VAL:VALUE`).
pub struct Property {
  pub name : String
  pub params : Array[Param]
  pub value : String
}

///| Construct a `Property` without parameters.
pub fn Property::new(name : String, value : String) -> Property {
  Property::{ name: ascii_to_upper(name), params: [], value: value }
}

///| Construct a `Property` with parameters.
pub fn Property::with_params(
  name : String,
  params : Array[Param],
  value : String,
) -> Property {
  Property::{ name: ascii_to_upper(name), params: params, value: value }
}

///| Look up all values of a parameter by case-insensitive name.
pub fn Property::get_param(self : Property, name : String) -> Option[Array[String]] {
  let mut i = 0
  let n = self.params.length()
  while i < n {
    if ascii_eq_ignore_case(self.params[i].name, name) {
      return Some(self.params[i].values)
    }
    i = i + 1
  }
  None
}

///| Look up the first value of a parameter by case-insensitive name.
pub fn Property::get_param_first(self : Property, name : String) -> Option[String] {
  match self.get_param(name) {
    Some(vals) => if vals.length() > 0 { Some(vals[0]) } else { None }
    None => None
  }
}

///| An iCalendar component (`VEVENT`, `VTODO`, `VJOURNAL`, `VALARM`, `VTIMEZONE`, etc.).
pub struct Component {
  pub name : String
  pub properties : Array[Property]
  pub subcomponents : Array[Component]
}

///| Construct an empty `Component`.
pub fn Component::new(name : String) -> Component {
  Component::{ name: ascii_to_upper(name), properties: [], subcomponents: [] }
}

///| Return the first property matching `name` (case-insensitive).
pub fn Component::get_property(self : Component, name : String) -> Option[Property] {
  let mut i = 0
  let n = self.properties.length()
  while i < n {
    if ascii_eq_ignore_case(self.properties[i].name, name) {
      return Some(self.properties[i])
    }
    i = i + 1
  }
  None
}

///| Return all properties matching `name` (case-insensitive).
pub fn Component::get_properties(self : Component, name : String) -> Array[Property] {
  let out : Array[Property] = []
  let mut i = 0
  let n = self.properties.length()
  while i < n {
    if ascii_eq_ignore_case(self.properties[i].name, name) {
      out.push(self.properties[i])
    }
    i = i + 1
  }
  out
}

///| Return all direct subcomponents matching `name` (case-insensitive).
pub fn Component::get_subcomponents(self : Component, name : String) -> Array[Component] {
  let out : Array[Component] = []
  let mut i = 0
  let n = self.subcomponents.length()
  while i < n {
    if ascii_eq_ignore_case(self.subcomponents[i].name, name) {
      out.push(self.subcomponents[i])
    }
    i = i + 1
  }
  out
}

///| Top-level `VCALENDAR` object.
pub struct Calendar {
  pub properties : Array[Property]
  pub components : Array[Component]
}

///| Construct an empty `Calendar`.
pub fn Calendar::new() -> Calendar {
  Calendar::{ properties: [], components: [] }
}

///| Filter top-level components by case-insensitive name.
fn calendar_components_named(cal : Calendar, name : String) -> Array[Component] {
  let out : Array[Component] = []
  let mut i = 0
  let n = cal.components.length()
  while i < n {
    if ascii_eq_ignore_case(cal.components[i].name, name) {
      out.push(cal.components[i])
    }
    i = i + 1
  }
  out
}

///| Return all `VEVENT` components.
pub fn Calendar::events(self : Calendar) -> Array[Component] {
  calendar_components_named(self, "VEVENT")
}

///| Return all `VTODO` components.
pub fn Calendar::todos(self : Calendar) -> Array[Component] {
  calendar_components_named(self, "VTODO")
}

///| Return all `VJOURNAL` components.
pub fn Calendar::journals(self : Calendar) -> Array[Component] {
  calendar_components_named(self, "VJOURNAL")
}

///| Return all `VTIMEZONE` components.
pub fn Calendar::timezones(self : Calendar) -> Array[Component] {
  calendar_components_named(self, "VTIMEZONE")
}

///| Return the first calendar-level property matching `name` (case-insensitive).
pub fn Calendar::get_property(self : Calendar, name : String) -> Option[Property] {
  let mut i = 0
  let n = self.properties.length()
  while i < n {
    if ascii_eq_ignore_case(self.properties[i].name, name) {
      return Some(self.properties[i])
    }
    i = i + 1
  }
  None
}

///| RFC 5545 §3.3.4 / §3.3.5 date or date-time value.
pub enum IcalDateTime {
  DateOnly(time::Date)
  Floating(time::DateTime)
  Utc(time::DateTime)
  Zoned(time::DateTime, String)
}

///| Parse an iCalendar DATE (`YYYYMMDD`) or DATE-TIME (`YYYYMMDDTHHMMSS[Z]`) value.
pub fn parse_ical_datetime(
  value : String,
  tzid : Option[String],
) -> Result[IcalDateTime, IcalError] {
  let len = value.length()
  if len == 8 {
    let y = parse_4_digits(value, 0)
    let mo = parse_2_digits(value, 4)
    let d = parse_2_digits(value, 6)
    if y < 0 || mo < 0 || d < 0 {
      return Err(IcalError::InvalidDateTime("invalid DATE digits: " + value))
    }
    match time::Date::new(y, mo, d) {
      Ok(date) => return Ok(IcalDateTime::DateOnly(date))
      Err(e) => return Err(IcalError::InvalidDateTime(e.message))
    }
  }
  if len == 15 || len == 16 {
    let sep = value.code_unit_at(8)
    if sep != 84 && sep != 116 {
      return Err(IcalError::InvalidDateTime("expected 'T' separator in DATE-TIME: " + value))
    }
    let is_utc = if len == 16 {
      let z = value.code_unit_at(15)
      if z != 90 && z != 122 {
        return Err(IcalError::InvalidDateTime("expected trailing 'Z' in UTC DATE-TIME: " + value))
      }
      true
    } else {
      false
    }
    let y = parse_4_digits(value, 0)
    let mo = parse_2_digits(value, 4)
    let d = parse_2_digits(value, 6)
    let h = parse_2_digits(value, 9)
    let mi = parse_2_digits(value, 11)
    let sc = parse_2_digits(value, 13)
    if y < 0 || mo < 0 || d < 0 || h < 0 || mi < 0 || sc < 0 {
      return Err(IcalError::InvalidDateTime("invalid DATE-TIME digits: " + value))
    }
    // RFC 5545 allows leap second 60; clamp to 59 for civil DateTime compatibility
    let sec_clamped = clamp_leap_second(sc)
    let dt = match time::DateTime::new(y, mo, d, h, mi, sec_clamped, 0) {
      Ok(v) => v
      Err(e) => return Err(IcalError::InvalidDateTime(e.message))
    }
    if is_utc {
      return Ok(IcalDateTime::Utc(dt))
    }
    match tzid {
      Some(tz_name) => return Ok(IcalDateTime::Zoned(dt, tz_name))
      None => return Ok(IcalDateTime::Floating(dt))
    }
  }
  Err(IcalError::InvalidDateTime("invalid iCalendar date/date-time length: " + value))
}

///| Format an `IcalDateTime` into its RFC 5545 value string.
pub fn ical_datetime_to_value(self : IcalDateTime) -> String {
  let sb = StringBuilder::new()
  match self {
    IcalDateTime::DateOnly(d) => {
      write_4_digits(sb, d.year)
      write_2_digits(sb, d.month)
      write_2_digits(sb, d.day)
    }
    IcalDateTime::Floating(dt) => {
      write_4_digits(sb, dt.date.year)
      write_2_digits(sb, dt.date.month)
      write_2_digits(sb, dt.date.day)
      sb.write_byte((84).to_byte())
      write_2_digits(sb, dt.time.hour)
      write_2_digits(sb, dt.time.minute)
      write_2_digits(sb, dt.time.second)
    }
    IcalDateTime::Utc(dt) => {
      write_4_digits(sb, dt.date.year)
      write_2_digits(sb, dt.date.month)
      write_2_digits(sb, dt.date.day)
      sb.write_byte((84).to_byte())
      write_2_digits(sb, dt.time.hour)
      write_2_digits(sb, dt.time.minute)
      write_2_digits(sb, dt.time.second)
      sb.write_byte((90).to_byte())
    }
    IcalDateTime::Zoned(dt, _) => {
      write_4_digits(sb, dt.date.year)
      write_2_digits(sb, dt.date.month)
      write_2_digits(sb, dt.date.day)
      sb.write_byte((84).to_byte())
      write_2_digits(sb, dt.time.hour)
      write_2_digits(sb, dt.time.minute)
      write_2_digits(sb, dt.time.second)
    }
  }
  sb.to_string()
}

///| Convert an `IcalDateTime` to a civil `time::DateTime` (midnight for `DateOnly`).
pub fn ical_datetime_to_datetime(self : IcalDateTime) -> time::DateTime {
  match self {
    IcalDateTime::DateOnly(d) => time::DateTime::from_parts(d, time::Time::midnight())
    IcalDateTime::Floating(dt) => dt
    IcalDateTime::Utc(dt) => dt
    IcalDateTime::Zoned(dt, _) => dt
  }
}

///| RFC 5545 §3.3.10 recurrence frequency.
pub enum Freq {
  Yearly
  Monthly
  Weekly
  Daily
  Hourly
  Minutely
  Secondly
}

///| Ordinal weekday entry in `BYDAY` (e.g. `MO` has `n = 0`, `2MO` has `n = 2`, `-1FR` has `n = -1`).
pub val struct NWeekday {
  pub weekday : time::Weekday
  pub n : Int
}

///| Construct an un-numbered `NWeekday` (`n = 0`).
pub fn NWeekday::every(weekday : time::Weekday) -> NWeekday {
  NWeekday::{ weekday: weekday, n: 0 }
}

///| Construct an ordinal `NWeekday` (`n` positive or negative).
pub fn NWeekday::nth(weekday : time::Weekday, n : Int) -> NWeekday {
  NWeekday::{ weekday: weekday, n: n }
}
