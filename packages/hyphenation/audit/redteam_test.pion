///| Red-team regression tests for packages/hyphenation @ 62b43a6 (branch feat/pkg-hyphenation).
///
/// `p1_*` / `p2_*` tests assert what the reference implementation does (Rust `hyphenation =0.8.4`,
/// via `rust/` and `scripts/one.py`) or what TeX's `\patterns` / `\hyphenation` semantics say where
/// the oracle is silent; every expectation was checked against the oracle (see REPORT.md) — a
/// FAILURE here is the evidence. `control_*` tests are attacks the package survived, including
/// places where it is more TeX-correct than the oracle; they must keep passing.
/// Large-scale differentials, DoS timings and 4-mode parity are reproduced by run_audit.sh.

import "hyphenation"

///|
fn ints(xs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  sb.write_string("[")
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(xs[i].to_string())
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///|
fn expect_opps(d : hyphenation::Dictionary, word : String, expected : String, ctx : String) -> Unit {
  let got = ints(d.opportunities(word))
  debug_assert(got == expected, ctx + ": opportunities(" + word + ") = " + got + ", expected " + expected)
}

///|
fn custom(pats : String, excs : String, lmin : Int, rmin : Int) -> hyphenation::Dictionary {
  match hyphenation::Dictionary::from_tex(pats, excs, lmin, rmin) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "from_tex failed: " + e.message)
      hyphenation::Dictionary::en_us()
    }
  }
}

///|
fn is_err(r : Result[hyphenation::Dictionary, hyphenation::HyphError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::with_capacity(s.length() * n + 1)
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn strip(s : String, sep : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let m = sep.length()
  let mut i = 0
  while i < n {
    if m > 0 && i + m <= n && s.slice(i, i + m) == sep {
      i = i + m
    } else {
      sb.write_string(s.slice(i, i + 1))
      i = i + 1
    }
  }
  sb.to_string()
}

// ---------------------------------------------------------------------------------------------
// P1: built-in en_us is not the hyph-utf8 / Rust en-us dictionary

///|
test "p1_en_us_exception_table_is_texbook_14_not_hyph_utf8_1441" {
  // hyph-utf8 hyph-en-us.hyp.txt (shipped by hyphenation 0.8.4 and embedded in from_embedded)
  // has 1,441 entries and none of the 14 TeXbook words Pion embeds.
  let d = hyphenation::Dictionary::en_us()
  debug_assert(
    d.exception_count() == 1441,
    "en_us exception_count = " + d.exception_count().to_string() + ", hyph-utf8 / Rust en-us = 1441",
  )
}

///|
test "p1_en_us_diverges_from_rust_en_us_on_common_words" {
  // Rust Standard::from_embedded(Language::EnglishUS).hyphenate(w).breaks
  let d = hyphenation::Dictionary::en_us()
  expect_opps(d, "hyphenation", "[2,6,7]", "rust: hy-phen-a-tion")
  expect_opps(d, "acronym", "[4]", "rust: acro-nym")
  expect_opps(d, "accusative", "[2,4,6]", "rust: ac-cu-sa-tive")
  expect_opps(d, "acupuncture", "[3,7]", "rust: acu-punc-ture")
}

// ---------------------------------------------------------------------------------------------
// P1: non-ASCII letters are never case-folded

///|
test "p1_uppercase_cyrillic_greek_get_no_breaks" {
  // Rust lowercases the query with str::to_lowercase before matching (case_folding.rs).
  let d = custom("а1б α1β", "", 1, 1)
  expect_opps(d, "аб", "[2]", "control lowercase cyrillic")
  expect_opps(d, "АБ", "[2]", "rust: uppercase cyrillic")
  expect_opps(d, "ΑΒ", "[2]", "rust: uppercase greek")
}

///|
test "p1_uppercase_umlaut_hides_inhibiting_pattern_and_adds_forbidden_break" {
  // `ä2b` forbids the break that `1b` allows; for "Äb" Pion no longer sees `ä` and breaks anyway.
  let d = custom("1b ä2b", "", 1, 1)
  expect_opps(d, "äb", "[]", "control lowercase")
  expect_opps(d, "Äb", "[]", "rust: Äb is folded to äb")
}

// ---------------------------------------------------------------------------------------------
// P1: hyphenate_text glues Unicode punctuation / spaces to the word

///|
test "p1_hyphenate_text_em_dash_breaks_minima" {
  let d = hyphenation::Dictionary::en_us()
  // bare words: com-puter, ty-pog-ra-phy
  let got = d.hyphenate_text("computer\u{2014}typography", "-")
  debug_assert(
    got == "com-puter\u{2014}ty-pog-ra-phy",
    "em dash: got " + got + " (right_min=3 violated before the dash, break right after it)",
  )
}

///|
test "p1_hyphenate_text_nbsp_breaks_left_min" {
  let d = hyphenation::Dictionary::en_us()
  let got = d.hyphenate_text("hyphenation\u{00A0}typography", "-")
  debug_assert(
    got == "hy-phen-a-tion\u{00A0}ty-pog-ra-phy",
    "NBSP: got " + got + " (hyphen inserted directly after the no-break space)",
  )
}

///|
test "p1_hyphenate_text_curly_quote_breaks_right_min" {
  let d = hyphenation::Dictionary::en_us()
  let bare = d.hyphenate_text("greenth", "-")
  let got = d.hyphenate_text("\u{2022}greenth\u{200B}", "-")
  debug_assert(bare == "greenth", "control: bare word has no break")
  debug_assert(
    got == "\u{2022}greenth\u{200B}",
    "bullet + ZWSP: got " + got + " (green-th: 2 letters after the break, right_min=3)",
  )
}

// ---------------------------------------------------------------------------------------------
// P2: TeX / oracle semantics

///|
test "p2_duplicate_pattern_silently_last_wins" {
  // TeX: "Duplicate pattern" error. Rust 0.8.4 keeps the first (stable sort + dedup) -> no break.
  // Pion keeps the last one -> odd value -> break.
  let r = hyphenation::Dictionary::from_tex("a2b a1b", "", 1, 1)
  match r {
    Err(_) => ()
    Ok(d) => expect_opps(d, "ab", "[]", "duplicate key a2b / a1b")
  }
}

///|
test "p2_patterns_with_hyphen_are_dead" {
  // hyph-pt `1-`, hyph-ru `.а-8`, hyph-uk/be/tk/af: patterns that mention '-' are accepted into the
  // alphabet but opportunities() always splits at '-' so they never match. Rust: ab-cd -> [2].
  let d = custom("1-", "", 1, 1)
  expect_opps(d, "ab-cd", "[2]", "rust: 1- allows the break before the hyphen")
}

///|
test "p2_soft_hyphen_not_honoured" {
  // Rust: a word that already carries U+00AD returns exactly those positions.
  let d = hyphenation::Dictionary::en_us()
  expect_opps(d, "hy\u{00AD}phen\u{00AD}ation", "[2,8]", "rust: existing soft hyphens")
}

///|
test "p2_opportunities_vs_hyphenate_text_apostrophe" {
  // opportunities() refuses the whole token while hyphenate_text() hyphenates the same word.
  let d = hyphenation::Dictionary::en_us()
  let t = d.hyphenate_text("organization's", "-")
  debug_assert(t == "or-ga-ni-za-tion's", "control: hyphenate_text = " + t)
  expect_opps(d, "organization's", "[2,4,6,8]", "rust and hyphenate_text agree")
}

///|
test "p2_dotted_capital_i_not_refolded" {
  // Rust refolds U+0130 to plain i (case_folding.rs) and realigns offsets.
  let d = hyphenation::Dictionary::en_us()
  expect_opps(d, "allopİhyle", "[2,5,7]", "rust: refold İ -> i")
}

// ---------------------------------------------------------------------------------------------
// Controls (must pass)

///|
test "control_engine_parity_with_crate_tables" {
  let d = hyphenation::Dictionary::en_us()
  expect_opps(d, "algorithm", "[2,4]", "algorithm")
  expect_opps(d, "internationalization", "[2,5,7,11,13,16]", "internationalization")
  expect_opps(d, "INTERNATIONALIZATION", "[2,5,7,11,13,16]", "upper")
  expect_opps(d, "\"hyphenation\"", "[3,7,8]", "ASCII quotes trimmed")
  expect_opps(d, "\u{201C}hyphenation\u{201D}", "[5,9,10]", "curly quotes, byte offsets")
  expect_opps(d, "", "[]", "empty")
  expect_opps(d, "a", "[]", "one letter")
  expect_opps(d, "abcd", "[]", "below left_min + right_min")
}

///|
test "control_capitalised_exception_is_case_insensitive_like_tex" {
  // Rust stores exception keys verbatim and lowercases only the query, so `Ar-kan-sas` never
  // matches there; TeX's \hyphenation is case-insensitive. Pion is right.
  let d = custom("", "Ar-kan-sas ATP-ase", 2, 3)
  expect_opps(d, "arkansas", "[2,5]", "lowercase query")
  expect_opps(d, "ARKANSAS", "[2,5]", "uppercase query")
  expect_opps(d, "ATPase", "[3]", "ATP-ase")
}

///|
test "control_uppercase_ascii_pattern_folded_like_tex_lccode" {
  let d = custom("A1B", "", 1, 1)
  expect_opps(d, "ab", "[1]", "A1B folded")
}

///|
test "control_malformed_patterns_rejected" {
  debug_assert(is_err(hyphenation::Dictionary::from_tex("a12b", "", 1, 1)), "consecutive digits")
  debug_assert(is_err(hyphenation::Dictionary::from_tex("a.b", "", 1, 1)), "interior dot")
  debug_assert(is_err(hyphenation::Dictionary::from_tex("1.2", "", 1, 1)), "no letter")
  debug_assert(is_err(hyphenation::Dictionary::from_tex("", "-ab", 1, 1)), "leading hyphen")
  debug_assert(is_err(hyphenation::Dictionary::from_tex("", "a--b", 1, 1)), "double hyphen")
  debug_assert(is_err(hyphenation::Dictionary::from_tex("", "ab-", 1, 1)), "trailing hyphen")
  // a single digit 9 is a legal TeX value
  let d = custom("a9b", "", 1, 1)
  expect_opps(d, "ab", "[1]", "value 9 is odd")
}

///|
test "control_minima_edges" {
  debug_assert(is_err(hyphenation::Dictionary::from_tex("a1b", "", 0, 1)), "left_min 0")
  debug_assert(is_err(hyphenation::Dictionary::from_tex("a1b", "", 1, -5)), "right_min < 0")
  let big = custom("a1b", "a-b", 2147483647, 2147483647)
  expect_opps(big, "ababababab", "[]", "INT_MAX minima, overflowing sum")
  let one_max = custom("a1b", "", 1, 2147483647)
  expect_opps(one_max, "ababababab", "[]", "1 + INT_MAX wraps negative")
  let longer = custom("a1b", "", 6, 6)
  expect_opps(longer, "ababab", "[]", "minima longer than word")
}

///|
test "control_limits_zero_negative_and_exact" {
  let base = hyphenation::Limits::default()
  let zero = hyphenation::Limits::{ ..base, max_trie_nodes: 0 }
  debug_assert(
    is_err(hyphenation::Dictionary::from_tex_with_limits("a1b", "", 1, 1, zero)),
    "max_trie_nodes 0",
  )
  let neg = hyphenation::Limits::{ ..base, max_input_bytes: -1 }
  debug_assert(is_err(hyphenation::Dictionary::from_tex_with_limits("", "", 1, 1, neg)), "negative bytes")
  let np = hyphenation::Limits::{ ..base, max_patterns: 2 }
  debug_assert(!is_err(hyphenation::Dictionary::from_tex_with_limits("a1b c1d", "", 1, 1, np)), "2 of 2")
  debug_assert(is_err(hyphenation::Dictionary::from_tex_with_limits("a1b c1d e1f", "", 1, 1, np)), "3 of 2")
  // root + a + b = 3 trie nodes
  let nodes3 = hyphenation::Limits::{ ..base, max_trie_nodes: 3 }
  debug_assert(!is_err(hyphenation::Dictionary::from_tex_with_limits("a1b", "", 1, 1, nodes3)), "3 nodes")
  let nodes2 = hyphenation::Limits::{ ..base, max_trie_nodes: 2 }
  debug_assert(is_err(hyphenation::Dictionary::from_tex_with_limits("a1b", "", 1, 1, nodes2)), "2 nodes")
  let plen = hyphenation::Limits::{ ..base, max_pattern_len: 3 }
  debug_assert(is_err(hyphenation::Dictionary::from_tex_with_limits("a1bc", "", 1, 1, plen)), "len 4 > 3")
}

///|
test "control_utf8_never_split_and_roundtrip" {
  let d = custom("ü1be be1ra 1ß 2ä1 €1 1😀 😀1", "über-all", 1, 1)
  let words = ["überall", "überbera", "aßä€😀b😀", "😀😀😀", "Straße", "ÜBERALL", "x\u{00AD}y\u{0301}z"]
  let mut i = 0
  while i < words.length() {
    let w = words[i]
    let parts = d.split_word(w)
    let sb = StringBuilder::new()
    let mut k = 0
    while k < parts.length() {
      debug_assert(parts[k].length() > 0, "empty part in " + w)
      sb.write_string(parts[k])
      k = k + 1
    }
    debug_assert(sb.to_string() == w, "split_word round-trip " + w)
    debug_assert(strip(d.hyphenate(w, "|"), "|") == w, "hyphenate round-trip " + w)
    i = i + 1
  }
}

///|
test "control_hyphenate_text_roundtrip_and_empty_sep" {
  let d = hyphenation::Dictionary::en_us()
  let text = "  Typography,\t\talgorithm--based;\n\r\nextraordinary... (computer)!? 2026: hyphenation.\u{2014}\u{00A0}"
  debug_assert(d.hyphenate_text(text, "") == text, "empty sep is identity")
  debug_assert(strip(d.hyphenate_text(text, "\u{00AD}"), "\u{00AD}") == text, "SHY round-trip")
  debug_assert(d.hyphenate_text("", "-") == "", "empty text")
  debug_assert(d.hyphenate_text("---...", "-") == "---...", "only punctuation")
}

///|
test "control_long_word_linear_no_panic" {
  let d = hyphenation::Dictionary::en_us()
  let w = repeat("internationalization", 20000)
  let pts = d.opportunities(w)
  debug_assert(pts.length() > 0, "long word gets breaks")
  let t = d.hyphenate_text(repeat("hyphenation ", 20000), "-")
  debug_assert(t.length() > 240000, "long text")
}
