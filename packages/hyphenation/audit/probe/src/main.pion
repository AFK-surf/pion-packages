///| Red-team differential probe for `packages/hyphenation` (batch, length-framed I/O).
///|
///| Dictionary spec `<pats> <hyp> <lmin> <rmin>`: `<pats>` = `@en_us` uses `Dictionary::en_us()`
///| (the other three arguments are then ignored), otherwise both files go through `from_tex`.
///| Input records: `<len>\n<bytes>` repeated. Output records: `<len>\n<bytes>` repeated.
///|   opp  <pats> <hyp> <lmin> <rmin> <in> <out> [6 limits] : `opportunities` as `o1,o2,...`
///|   all  <pats> <hyp> <lmin> <rmin> <in> <out> : `opportunities` 0x1E `split_word` joined by 0x1F
///|                                               0x1E `hyphenate(w, "=")`
///|   text <pats> <hyp> <lmin> <rmin> <in> <out> <sep> : `hyphenate_text(rec, sep)`
///|   load <pats> <hyp> <lmin> <rmin> <reps> [in_bytes pats excs pat_len exc_len nodes]
///|        : `from_tex_with_limits` `reps` times, prints `ok <patterns> <checksum of 6 probe words>`
///|        or `ERR <msg>`
///|   bulk <pats> <hyp> <lmin> <rmin> <in> <reps> : `opportunities_into` (reused buffer) over every
///|        record `reps` times (DoS / perf), prints an Int64 checksum identical to the Rust oracle's
///|   bulka : same with the allocating `opportunities`

import "hyphenation"

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut neg = false
  let mut i = 0
  if s.length() > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  if neg {
    -v
  } else {
    v
  }
}

///|
fn read_records(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    let ls = i
    while i < n && src.code_unit_at(i) != 10 {
      i = i + 1
    }
    let len = parse_int(src.slice(ls, i))
    i = i + 1
    out.push(src.slice(i, i + len))
    i = i + len
  }
  out
}

///|
fn emit(sb : StringBuilder, h : String) -> Unit {
  sb.write_string(h.length().to_string())
  sb.write_byte((10).to_byte())
  sb.write_string(h)
}

///|
fn ints(xs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(xs[i].to_string())
    i = i + 1
  }
  sb.to_string()
}

///|
fn load(
  world : World,
  pats : String,
  hyp : String,
  lmin : Int,
  rmin : Int,
  limits : hyphenation::Limits,
) -> Result[hyphenation::Dictionary, String] {
  if pats == "@en_us" {
    return Ok(hyphenation::Dictionary::en_us())
  }
  let p = match fs_read(world, pats) {
    Ok(s) => s
    Err(_) => return Err("read patterns failed")
  }
  let e = if hyp == "-" {
    ""
  } else {
    match fs_read(world, hyp) {
      Ok(s) => s
      Err(_) => return Err("read exceptions failed")
    }
  }
  match hyphenation::Dictionary::from_tex_with_limits(p, e, lmin, rmin, limits) {
    Ok(d) => Ok(d)
    Err(err) => Err(err.message)
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 7 {
    io_eprintln(world, "usage: probe opp|all|text|load|bulk <pats> <hyp> <lmin> <rmin> ...")
    return 2
  }
  let mode = args[1]
  let lmin = parse_int(args[4])
  let rmin = parse_int(args[5])
  if mode == "load" {
    let reps = parse_int(args[6])
    let limits = if args.length() >= 13 {
      hyphenation::Limits::{
        max_input_bytes: parse_int(args[7]),
        max_patterns: parse_int(args[8]),
        max_exceptions: parse_int(args[9]),
        max_pattern_len: parse_int(args[10]),
        max_exception_len: parse_int(args[11]),
        max_trie_nodes: parse_int(args[12]),
      }
    } else {
      hyphenation::Limits::default()
    }
    let p = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(_) => {
        io_eprintln(world, "read failed")
        return 1
      }
    }
    let e = if args[3] == "-" {
      ""
    } else {
      match fs_read(world, args[3]) {
        Ok(s) => s
        Err(_) => {
          io_eprintln(world, "read failed")
          return 1
        }
      }
    }
    let probes = ["hyphenation", "internationalization", "associate", "present", "typography", "algorithm"]
    let buf : Array[Int] = Array::new()
    let mut r = 0
    let mut last = "ERR no reps"
    while r < reps {
      match hyphenation::Dictionary::from_tex_with_limits(p, e, lmin, rmin, limits) {
        Ok(d) => {
          let mut sum : Int64 = 0L
          let mut k = 0
          while k < probes.length() {
            d.opportunities_into(probes[k], buf)
            let mut j = 0
            while j < buf.length() {
              sum = (sum * 131L + (buf[j] + 1).to_int64()) % 1000000007L
              j = j + 1
            }
            k = k + 1
          }
          last = "ok " + d.pattern_count().to_string() + " " + sum.to_string()
        }
        Err(err) => last = "ERR " + err.message
      }
      r = r + 1
    }
    io_println(world, last)
    return 0
  }
  // `opp` / `all` accept the six Limits after <out> (same order as `load`).
  let qlimits = if args.length() >= 14 && (mode == "opp" || mode == "all") {
    hyphenation::Limits::{
      max_input_bytes: parse_int(args[8]),
      max_patterns: parse_int(args[9]),
      max_exceptions: parse_int(args[10]),
      max_pattern_len: parse_int(args[11]),
      max_exception_len: parse_int(args[12]),
      max_trie_nodes: parse_int(args[13]),
    }
  } else {
    hyphenation::Limits::default()
  }
  let dict = match load(world, args[2], args[3], lmin, rmin, qlimits) {
    Ok(d) => d
    Err(m) => {
      io_println(world, "ERR " + m)
      return 0
    }
  }
  let src = match fs_read(world, args[6]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "read input failed")
      return 1
    }
  }
  let recs = read_records(src)
  if mode == "bulk" || mode == "bulka" {
    let reps = if args.length() > 7 { parse_int(args[7]) } else { 1 }
    let buf : Array[Int] = Array::new()
    let mut sum : Int64 = 0L
    let mut r = 0
    while r < reps {
      let mut i = 0
      while i < recs.length() {
        let pts = if mode == "bulk" {
          dict.opportunities_into(recs[i], buf)
          buf
        } else {
          dict.opportunities(recs[i])
        }
        let mut k = 0
        while k < pts.length() {
          sum = (sum * 131L + (pts[k] + 1).to_int64()) % 1000000007L
          k = k + 1
        }
        i = i + 1
      }
      r = r + 1
    }
    io_println(world, "ok " + sum.to_string())
    return 0
  }
  let out = StringBuilder::with_capacity(src.length() * 2 + 64)
  let sep = if args.length() > 8 { args[8] } else { "-" }
  let mut i = 0
  while i < recs.length() {
    let w = recs[i]
    if mode == "opp" {
      emit(out, ints(dict.opportunities(w)))
    } else if mode == "all" {
      let parts = dict.split_word(w)
      let sb = StringBuilder::new()
      sb.write_string(ints(dict.opportunities(w)))
      sb.write_byte((30).to_byte())
      let mut k = 0
      while k < parts.length() {
        if k > 0 {
          sb.write_byte((31).to_byte())
        }
        sb.write_string(parts[k])
        k = k + 1
      }
      sb.write_byte((30).to_byte())
      sb.write_string(dict.hyphenate(w, "="))
      emit(out, sb.to_string())
    } else if mode == "text" {
      emit(out, dict.hyphenate_text(w, sep))
    } else {
      io_eprintln(world, "unknown mode")
      return 2
    }
    i = i + 1
  }
  match fs_write(world, args[7], out.to_string()) {
    Ok(_) => 0
    Err(_) => {
      io_eprintln(world, "write failed")
      1
    }
  }
}
