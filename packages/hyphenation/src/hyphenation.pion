///| Knuth-Liang hyphenation engine backed by a compact Double-Array Trie.

struct EnUsCache {
  mut loaded : Option[Dictionary]
}

let en_us_cache : EnUsCache = EnUsCache::{ loaded: None }

fn hyph_err(kind : HyphErrorKind, message : String) -> Result[Dictionary, HyphError] {
  Err(HyphError::{ kind, message })
}

fn is_ascii_ws(b : Int) -> Bool {
  b == 32 || b == 10 || b == 13 || b == 9
}

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_ascii_upper(b : Int) -> Bool {
  b >= 65 && b <= 90
}

fn is_ascii_lower(b : Int) -> Bool {
  b >= 97 && b <= 122
}

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn fold_ascii_lower(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

///| Load a dictionary from TeX `.pat.txt` patterns and `.hyp.txt` exceptions with default limits.
pub fn Dictionary::from_tex(
  patterns : String,
  exceptions : String,
  left_min : Int,
  right_min : Int,
) -> Result[Dictionary, HyphError] {
  Dictionary::from_tex_with_limits(
    patterns,
    exceptions,
    left_min,
    right_min,
    Limits::default(),
  )
}

///| Load a dictionary from TeX `.pat.txt` patterns and `.hyp.txt` exceptions with explicit limits.
pub fn Dictionary::from_tex_with_limits(
  patterns : String,
  exceptions : String,
  left_min : Int,
  right_min : Int,
  limits : Limits,
) -> Result[Dictionary, HyphError] {
  if left_min < 1 || right_min < 1 {
    return hyph_err(
      HyphErrorKind::InvalidMinima,
      "left_min and right_min must both be >= 1",
    )
  }
  let pat_bytes_len = patterns.length()
  let exc_bytes_len = exceptions.length()
  if pat_bytes_len + exc_bytes_len > limits.max_input_bytes {
    return hyph_err(
      HyphErrorKind::InputTooLarge,
      "combined pattern and exception input exceeds max_input_bytes",
    )
  }

  let used_bytes = FixedArray::make(256, 0)
  let pat_starts : Array[Int] = Array::new()
  let pat_ends : Array[Int] = Array::new()

  // Pass 1a: scan and validate pattern tokens, collecting alphabet bytes.
  let mut i = 0
  while i < pat_bytes_len {
    while i < pat_bytes_len && is_ascii_ws(patterns.code_unit_at(i)) {
      i = i + 1
    }
    if i >= pat_bytes_len {
      break
    }
    let start = i
    while i < pat_bytes_len && !is_ascii_ws(patterns.code_unit_at(i)) {
      i = i + 1
    }
    let end = i
    let tok_len = end - start
    if pat_starts.length() >= limits.max_patterns {
      return hyph_err(
        HyphErrorKind::TooManyPatterns,
        "pattern count exceeds max_patterns",
      )
    }
    if tok_len > limits.max_pattern_len {
      return hyph_err(
        HyphErrorKind::PatternTooLong,
        "pattern length exceeds max_pattern_len",
      )
    }

    let mut prev_digit = false
    let mut non_digit_count = 0
    let mut non_dot_count = 0
    let mut saw_end_dot = false
    let mut j = start
    while j < end {
      let b = patterns.code_unit_at(j)
      if is_ascii_digit(b) {
        if prev_digit {
          return hyph_err(
            HyphErrorKind::InvalidPattern,
            "consecutive digits in TeX pattern",
          )
        }
        prev_digit = true
      } else {
        prev_digit = false
        if saw_end_dot {
          return hyph_err(
            HyphErrorKind::InvalidPattern,
            "interior '.' in TeX pattern",
          )
        }
        if b == 46 {
          if non_digit_count > 0 {
            saw_end_dot = true
          }
        } else {
          non_dot_count = non_dot_count + 1
        }
        non_digit_count = non_digit_count + 1
        used_bytes[fold_ascii_lower(b)] = 1
      }
      j = j + 1
    }
    if non_dot_count == 0 {
      return hyph_err(
        HyphErrorKind::InvalidPattern,
        "TeX pattern must contain at least one letter",
      )
    }
    pat_starts.push(start)
    pat_ends.push(end)
  }

  // Pass 1b: scan and validate exception tokens, collecting alphabet bytes.
  let exc_starts : Array[Int] = Array::new()
  let exc_ends : Array[Int] = Array::new()
  i = 0
  while i < exc_bytes_len {
    while i < exc_bytes_len && is_ascii_ws(exceptions.code_unit_at(i)) {
      i = i + 1
    }
    if i >= exc_bytes_len {
      break
    }
    let start = i
    while i < exc_bytes_len && !is_ascii_ws(exceptions.code_unit_at(i)) {
      i = i + 1
    }
    let end = i
    let tok_len = end - start
    if exc_starts.length() >= limits.max_exceptions {
      return hyph_err(
        HyphErrorKind::TooManyExceptions,
        "exception count exceeds max_exceptions",
      )
    }
    if tok_len > limits.max_exception_len {
      return hyph_err(
        HyphErrorKind::ExceptionTooLong,
        "exception length exceeds max_exception_len",
      )
    }

    let mut prev_hyphen = false
    let mut letter_count = 0
    let mut j = start
    while j < end {
      let b = exceptions.code_unit_at(j)
      if b == 45 {
        if j == start || j == end - 1 || prev_hyphen {
          return hyph_err(
            HyphErrorKind::InvalidException,
            "invalid hyphen placement in TeX exception",
          )
        }
        prev_hyphen = true
      } else {
        prev_hyphen = false
        letter_count = letter_count + 1
        used_bytes[fold_ascii_lower(b)] = 1
      }
      j = j + 1
    }
    if letter_count == 0 {
      return hyph_err(
        HyphErrorKind::InvalidException,
        "TeX exception must contain at least one letter",
      )
    }
    exc_starts.push(start)
    exc_ends.push(end)
  }

  // Pass 2: assign compact dense alphabet IDs 1..alpha_size and fold A..Z -> a..z.
  let char_map = FixedArray::make(256, 0)
  let mut alpha_size = 0
  let mut is_ascii_only = true
  let mut b_idx = 0
  while b_idx < 256 {
    if used_bytes[b_idx] != 0 {
      alpha_size = alpha_size + 1
      char_map[b_idx] = alpha_size
      if b_idx >= 128 {
        is_ascii_only = false
      }
    }
    b_idx = b_idx + 1
  }
  let mut lc = 97
  while lc <= 122 {
    if char_map[lc] != 0 {
      char_map[lc - 32] = char_map[lc]
    }
    lc = lc + 1
  }
  let dot_id = char_map[46]

  // Pass 3: insert patterns into intermediate flat trie.
  let pat_trie = RawTrie::new(0)
  let val_pairs_buf : Array[Int] = Array::new()
  let tmp_pairs : Array[Int] = Array::new()
  let mut pi = 0
  while pi < pat_starts.length() {
    let start = pat_starts[pi]
    let end = pat_ends[pi]
    tmp_pairs.clear()
    let mut node = 0
    let mut letter_pos = 0
    let mut j = start
    while j < end {
      let b = patterns.code_unit_at(j)
      if is_ascii_digit(b) {
        let digit = b - 48
        if digit > 0 {
          tmp_pairs.push((letter_pos << 4) | digit)
        }
      } else {
        let cid = char_map[b]
        let next = pat_trie.step_or_insert(node, cid, 0, limits.max_trie_nodes)
        if next < 0 {
          return hyph_err(
            HyphErrorKind::TooManyTrieNodes,
            "pattern trie node count exceeds max_trie_nodes",
          )
        }
        node = next
        letter_pos = letter_pos + 1
      }
      j = j + 1
    }
    let cnt = tmp_pairs.length()
    if cnt > 255 {
      return hyph_err(
        HyphErrorKind::PatternTooLong,
        "pattern has too many non-zero values",
      )
    }
    if cnt == 1 {
      pat_trie.node_meta[node] = tmp_pairs[0]
    } else if cnt > 1 {
      let off = val_pairs_buf.length()
      let mut k = 0
      while k < cnt {
        val_pairs_buf.push(tmp_pairs[k])
        k = k + 1
      }
      pat_trie.node_meta[node] = -((off << 8) | cnt)
    }
    pi = pi + 1
  }

  let packed_pat = pack_raw_trie(pat_trie, 0)
  let val_pairs = FixedArray::make(val_pairs_buf.length(), 0)
  let mut vi = 0
  while vi < val_pairs_buf.length() {
    val_pairs[vi] = val_pairs_buf[vi]
    vi = vi + 1
  }

  // Pass 4: insert exceptions into compact exception trie.
  let exc_has_first = FixedArray::make(256, 0)
  let exc_points_buf : Array[Int] = Array::new()
  let tmp_pts : Array[Int] = Array::new()
  let tmp_char_idxs : Array[Int] = Array::new()
  let exc_trie = RawTrie::new(-1)
  let mut ei = 0
  while ei < exc_starts.length() {
    let start = exc_starts[ei]
    let end = exc_ends[ei]
    tmp_pts.clear()
    tmp_char_idxs.clear()
    let mut node = 0
    let mut byte_pos = 0
    let mut char_pos = 0
    let mut j = start
    while j < end {
      let b = exceptions.code_unit_at(j)
      if b == 45 {
        tmp_pts.push(byte_pos)
        tmp_char_idxs.push(char_pos)
        j = j + 1
      } else {
        if byte_pos == 0 {
          exc_has_first[fold_ascii_lower(b)] = 1
        }
        let clen = utf8_char_len(b)
        let mut cb = 0
        while cb < clen && j + cb < end {
          let cid = char_map[exceptions.code_unit_at(j + cb)]
          let next = exc_trie.step_or_insert(node, cid, -1, limits.max_trie_nodes)
          if next < 0 {
            return hyph_err(
              HyphErrorKind::TooManyTrieNodes,
              "exception trie node count exceeds max_trie_nodes",
            )
          }
          node = next
          byte_pos = byte_pos + 1
          cb = cb + 1
        }
        char_pos = char_pos + 1
        j = j + cb
      }
    }
    let max_char = char_pos - right_min
    let off = exc_points_buf.length()
    let mut kept = 0
    let mut k = 0
    while k < tmp_pts.length() {
      let ci = tmp_char_idxs[k]
      if ci >= left_min && ci <= max_char {
        exc_points_buf.push(tmp_pts[k])
        kept = kept + 1
      }
      k = k + 1
    }
    if kept > 255 {
      return hyph_err(
        HyphErrorKind::ExceptionTooLong,
        "exception has too many hyphenation points",
      )
    }
    if kept == 0 {
      exc_trie.node_meta[node] = 0
    } else {
      exc_trie.node_meta[node] = (off << 8) | kept
    }
    ei = ei + 1
  }

  let packed_exc = pack_raw_trie(exc_trie, -1)
  let exc_points = FixedArray::make(exc_points_buf.length(), 0)
  let mut epi = 0
  while epi < exc_points_buf.length() {
    exc_points[epi] = exc_points_buf[epi]
    epi = epi + 1
  }

  Ok(Dictionary::{
    left_min,
    right_min,
    pattern_count: pat_starts.length(),
    exception_count: exc_starts.length(),
    dot_id,
    alpha_size,
    is_ascii_only,
    char_map,
    dat_base: packed_pat.base,
    dat_check: packed_pat.check,
    dat_meta: packed_pat.meta,
    val_pairs,
    exc_has_first,
    exc_base: packed_exc.base,
    exc_check: packed_exc.check,
    exc_meta: packed_exc.meta,
    exc_points,
  })
}

///| Return the built-in US English (`hyph-en-us`, `left_min = 2`, `right_min = 3`) dictionary.
pub fn Dictionary::en_us() -> Dictionary {
  match en_us_cache.loaded {
    Some(d) => d
    None =>
    match Dictionary::from_tex(en_us_patterns, en_us_exceptions, 2, 3) {
      Ok(d) => {
        en_us_cache.loaded = Some(d)
        d
      }
      Err(_) => {
        // Built-in hyph-en-us tables are statically valid.
        let empty_map = FixedArray::make(256, 0)
        let empty1 = FixedArray::make(1, 0)
        let empty_chk = FixedArray::make(1, -1)
        let empty0 : FixedArray[Int] = FixedArray::make(0, 0)
        Dictionary::{
          left_min: 2,
          right_min: 3,
          pattern_count: 0,
          exception_count: 0,
          dot_id: 0,
          alpha_size: 0,
          is_ascii_only: true,
          char_map: empty_map,
          dat_base: empty1,
          dat_check: empty_chk,
          dat_meta: empty1,
          val_pairs: empty0,
          exc_has_first: empty_map,
          exc_base: empty1,
          exc_check: empty_chk,
          exc_meta: empty_chk,
          exc_points: empty0,
        }
      }
    }
  }
}

///| Minimum number of characters required before the first hyphenation break.
pub fn Dictionary::left_min(self : Dictionary) -> Int {
  self.left_min
}

///| Minimum number of characters required after the last hyphenation break.
pub fn Dictionary::right_min(self : Dictionary) -> Int {
  self.right_min
}

///| Number of loaded Knuth-Liang patterns.
pub fn Dictionary::pattern_count(self : Dictionary) -> Int {
  self.pattern_count
}

///| Number of loaded hyphenation exceptions.
pub fn Dictionary::exception_count(self : Dictionary) -> Int {
  self.exception_count
}

fn is_word_byte(self : Dictionary, b : Int) -> Bool {
  if is_ascii_alpha(b) || b >= 128 {
    return true
  }
  if b == 45 || b == 46 {
    return false
  }
  self.char_map[b] != 0
}

fn utf8_char_len(b0 : Int) -> Int {
  if b0 < 0x80 {
    1
  } else if (b0 & 0xE0) == 0xC0 {
    2
  } else if (b0 & 0xF0) == 0xE0 {
    3
  } else if (b0 & 0xF8) == 0xF0 {
    4
  } else {
    1
  }
}

fn hyphenate_segment_into(
  self : Dictionary,
  word : String,
  start : Int,
  end : Int,
  out : Array[Int],
) -> Unit {
  let seg_len = end - start
  if seg_len <= 0 {
    return
  }

  // Validate bytes and detect whether the segment is pure ASCII.
  let mut has_non_ascii = false
  let mut k = start
  while k < end {
    let b = word.code_unit_at(k)
    if b >= 128 {
      has_non_ascii = true
    } else if !is_ascii_alpha(b) && (b == 45 || b == 46 || self.char_map[b] == 0) {
      return
    }
    k = k + 1
  }

  // If dictionary only has ASCII patterns/exceptions and segment has non-ASCII bytes,
  // check if any bytes could still match; for en-us (ASCII-only), non-ASCII words
  // can still be safely skipped if all bytes are non-ASCII, or processed safely below.
  let char_map = self.char_map

  // Fast exception lookup (zero allocations).
  if self.exception_count > 0 {
    let first_b = fold_ascii_lower(word.code_unit_at(start))
    if self.exc_has_first[first_b] != 0 {
      let exc_base = self.exc_base
      let exc_check = self.exc_check
      let exc_len = exc_base.length()
      let mut st = 0
      let mut matched = true
      let mut ek = start
      while ek < end {
        let cid = char_map[word.code_unit_at(ek)]
        if cid == 0 {
          matched = false
          break
        }
        let next = exc_base[st] + cid
        if next >= exc_len || exc_check[next] != st {
          matched = false
          break
        }
        st = next
        ek = ek + 1
      }
      if matched {
        let meta = self.exc_meta[st]
        if meta >= 0 {
          if meta > 0 {
            let off = meta >> 8
            let cnt = meta & 255
            let exc_pts = self.exc_points
            let mut j = 0
            while j < cnt {
              out.push(start + exc_pts[off + j])
              j = j + 1
            }
          }
          return
        }
      }
    }
  }

  let lmin = self.left_min
  let rmin = self.right_min
  let mut char_count = seg_len
  if has_non_ascii {
    char_count = 0
    let mut p = start
    while p < end {
      let clen = utf8_char_len(word.code_unit_at(p))
      char_count = char_count + 1
      p = p + clen
    }
  }
  if char_count < lmin + rmin {
    return
  }

  // Single contiguous scratch buffer:
  //   [0 .. wn)            : pre-mapped alphabet IDs for '.' + word[start..end] + '.'
  //   [wn .. 2 * wn + 1)   : Knuth-Liang score array
  let wn = seg_len + 2
  let buf = FixedArray::make(wn * 2 + 1, 0)
  buf[0] = self.dot_id
  let mut m = 0
  while m < seg_len {
    buf[m + 1] = char_map[word.code_unit_at(start + m)]
    m = m + 1
  }
  buf[wn - 1] = self.dot_id

  let dat_base = self.dat_base
  let dat_check = self.dat_check
  let dat_meta = self.dat_meta
  let val_pairs = self.val_pairs
  let dat_len = dat_base.length()

  let mut i = 0
  while i < wn {
    let mut state = 0
    let mut j = i
    while j < wn {
      let cid = buf[j]
      if cid == 0 {
        break
      }
      let next = dat_base[state] + cid
      if next >= dat_len || dat_check[next] != state {
        break
      }
      state = next
      let meta = dat_meta[state]
      if meta > 0 {
        let v = meta & 15
        let p = wn + i + (meta >> 4)
        if v > buf[p] {
          buf[p] = v
        }
      } else if meta < 0 {
        let packed = -meta
        let idx = packed >> 8
        let cnt = packed & 255
        let mut r = 0
        while r < cnt {
          let pair = val_pairs[idx + r]
          let v = pair & 15
          let p = wn + i + (pair >> 4)
          if v > buf[p] {
            buf[p] = v
          }
          r = r + 1
        }
      }
      j = j + 1
    }
    i = i + 1
  }

  if !has_non_ascii {
    let mut pos = lmin
    let limit = seg_len - rmin
    while pos <= limit {
      if (buf[wn + pos + 1] & 1) == 1 {
        out.push(start + pos)
      }
      pos = pos + 1
    }
  } else {
    let max_char = char_count - rmin
    let mut char_idx = 0
    let mut pos = 0
    while pos < seg_len {
      if char_idx >= lmin && char_idx <= max_char {
        if (buf[wn + pos + 1] & 1) == 1 {
          out.push(start + pos)
        }
      }
      let clen = utf8_char_len(word.code_unit_at(start + pos))
      pos = pos + clen
      char_idx = char_idx + 1
    }
  }
}

///| Compute all permitted hyphenation break positions as ascending UTF-8 byte offsets within `word`.
pub fn Dictionary::opportunities(self : Dictionary, word : String) -> Array[Int] {
  let out : Array[Int] = Array::new()
  self.opportunities_into(word, out)
  out
}

///| Zero-allocation hot path: clears `out` and appends ascending UTF-8 byte offsets within `word`.
pub fn Dictionary::opportunities_into(
  self : Dictionary,
  word : String,
  out : Array[Int],
) -> Unit {
  out.clear()
  let n = word.length()
  if n == 0 {
    return
  }

  // Trim leading and trailing ASCII punctuation / non-word bytes.
  let mut a = 0
  let mut b = n
  while a < b && !is_word_byte(self, word.code_unit_at(a)) {
    a = a + 1
  }
  while b > a && !is_word_byte(self, word.code_unit_at(b - 1)) {
    b = b - 1
  }
  if a >= b {
    return
  }

  // Check for internal ASCII hyphens '-' (compound words like "super-computer").
  let mut has_hyphen = false
  let mut k = a
  while k < b {
    if word.code_unit_at(k) == 45 {
      has_hyphen = true
      break
    }
    k = k + 1
  }

  if !has_hyphen {
    hyphenate_segment_into(self, word, a, b, out)
    return
  }

  let mut seg_start = a
  k = a
  while k <= b {
    if k == b || word.code_unit_at(k) == 45 {
      if k > seg_start {
        hyphenate_segment_into(self, word, seg_start, k, out)
      }
      seg_start = k + 1
    }
    k = k + 1
  }
}

///| Split `word` at every permitted hyphenation opportunity.
pub fn Dictionary::split_word(self : Dictionary, word : String) -> Array[String] {
  let n = word.length()
  if n == 0 {
    return Array::new()
  }
  let pts = self.opportunities(word)
  if pts.length() == 0 {
    return [word]
  }
  let out : Array[String] = Array::new()
  let mut prev = 0
  let mut i = 0
  while i < pts.length() {
    let p = pts[i]
    out.push(word.slice(prev, p))
    prev = p
    i = i + 1
  }
  out.push(word.slice(prev, n))
  out
}

///| Insert `sep` at every permitted hyphenation opportunity within `word`.
pub fn Dictionary::hyphenate(self : Dictionary, word : String, sep : String) -> String {
  let n = word.length()
  if n == 0 {
    return word
  }
  let pts = self.opportunities(word)
  if pts.length() == 0 {
    return word
  }
  let sb = StringBuilder::with_capacity(n + pts.length() * sep.length())
  let mut prev = 0
  let mut i = 0
  while i < pts.length() {
    let p = pts[i]
    sb.write_string(word.slice(prev, p))
    sb.write_string(sep)
    prev = p
    i = i + 1
  }
  sb.write_string(word.slice(prev, n))
  sb.to_string()
}

///| Hyphenate all words inside `text` with `sep`, preserving punctuation, whitespace, and non-words.
pub fn Dictionary::hyphenate_text(self : Dictionary, text : String, sep : String) -> String {
  let n = text.length()
  if n == 0 {
    return text
  }
  let sb = StringBuilder::with_capacity(n + n / 8)
  let pts : Array[Int] = Array::new()
  let mut i = 0
  while i < n {
    if is_word_byte(self, text.code_unit_at(i)) {
      let start = i
      while i < n && is_word_byte(self, text.code_unit_at(i)) {
        i = i + 1
      }
      pts.clear()
      hyphenate_segment_into(self, text, start, i, pts)
      if pts.length() == 0 {
        sb.write_string(text.slice(start, i))
      } else {
        let mut prev = start
        let mut pi = 0
        while pi < pts.length() {
          let p = pts[pi]
          sb.write_string(text.slice(prev, p))
          sb.write_string(sep)
          prev = p
          pi = pi + 1
        }
        sb.write_string(text.slice(prev, i))
      }
    } else {
      let start = i
      while i < n && !is_word_byte(self, text.code_unit_at(i)) {
        i = i + 1
      }
      sb.write_string(text.slice(start, i))
    }
  }
  sb.to_string()
}
