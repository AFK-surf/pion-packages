///| Knuth-Liang hyphenation engine backed by a compact Double-Array Trie.

struct EnUsCache {
  mut loaded : Option[Dictionary]
}

let en_us_cache : EnUsCache = EnUsCache::{ loaded: None }

fn hyph_err(kind : HyphErrorKind, message : String) -> Result[Dictionary, HyphError] {
  Err(HyphError::{ kind, message })
}

fn is_ascii_ws(b : Int) -> Bool {
  b == 32 || b == 10 || b == 13 || b == 9
}

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn fold_ascii_lower(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

///| Load a dictionary from TeX `.pat.txt` patterns and `.hyp.txt` exceptions with default limits.
pub fn Dictionary::from_tex(
  patterns : String,
  exceptions : String,
  left_min : Int,
  right_min : Int,
) -> Result[Dictionary, HyphError] {
  Dictionary::from_tex_with_limits(
    patterns,
    exceptions,
    left_min,
    right_min,
    Limits::default(),
  )
}

///| Load a dictionary from TeX `.pat.txt` patterns and `.hyp.txt` exceptions with explicit limits.
pub fn Dictionary::from_tex_with_limits(
  patterns : String,
  exceptions : String,
  left_min : Int,
  right_min : Int,
  limits : Limits,
) -> Result[Dictionary, HyphError] {
  if left_min < 1 || right_min < 1 {
    return hyph_err(
      HyphErrorKind::InvalidMinima,
      "left_min and right_min must both be >= 1",
    )
  }
  let pat_bytes_len = patterns.length()
  let exc_bytes_len = exceptions.length()
  // Overflow-safe check (avoids Int32 wrap on pat_bytes_len + exc_bytes_len).
  if limits.max_input_bytes < 0 ||
  pat_bytes_len > limits.max_input_bytes ||
  exc_bytes_len > limits.max_input_bytes - pat_bytes_len {
    return hyph_err(
      HyphErrorKind::InputTooLarge,
      "combined pattern and exception input exceeds max_input_bytes",
    )
  }
  if limits.max_patterns < 0 {
    return hyph_err(HyphErrorKind::TooManyPatterns, "max_patterns must be >= 0")
  }
  if limits.max_exceptions < 0 {
    return hyph_err(HyphErrorKind::TooManyExceptions, "max_exceptions must be >= 0")
  }
  if limits.max_pattern_len < 0 {
    return hyph_err(HyphErrorKind::PatternTooLong, "max_pattern_len must be >= 0")
  }
  if limits.max_exception_len < 0 {
    return hyph_err(HyphErrorKind::ExceptionTooLong, "max_exception_len must be >= 0")
  }
  if limits.max_trie_nodes < 1 {
    return hyph_err(HyphErrorKind::TooManyTrieNodes, "max_trie_nodes must be >= 1")
  }

  let used_bytes = FixedArray::make(256, 0)
  let pat_starts : Array[Int] = Array::new()
  let pat_ends : Array[Int] = Array::new()
  let tmp_utf8 : Array[Int] = Array::new()

  // Pass 1a: scan and validate pattern tokens, collecting alphabet bytes.
  let mut i = 0
  while i < pat_bytes_len {
    while i < pat_bytes_len && is_ascii_ws(patterns.code_unit_at(i)) {
      i = i + 1
    }
    if i >= pat_bytes_len {
      break
    }
    let start = i
    while i < pat_bytes_len && !is_ascii_ws(patterns.code_unit_at(i)) {
      i = i + 1
    }
    let end = i
    let tok_len = end - start
    if pat_starts.length() >= limits.max_patterns {
      return hyph_err(
        HyphErrorKind::TooManyPatterns,
        "pattern count exceeds max_patterns",
      )
    }
    if tok_len > limits.max_pattern_len {
      return hyph_err(
        HyphErrorKind::PatternTooLong,
        "pattern length exceeds max_pattern_len",
      )
    }

    let mut prev_digit = false
    let mut non_digit_count = 0
    let mut non_dot_count = 0
    let mut saw_end_dot = false
    let mut j = start
    while j < end {
      let b = patterns.code_unit_at(j)
      if is_ascii_digit(b) {
        if prev_digit {
          return hyph_err(
            HyphErrorKind::InvalidPattern,
            "consecutive digits in TeX pattern",
          )
        }
        prev_digit = true
        j = j + 1
      } else {
        prev_digit = false
        if saw_end_dot {
          return hyph_err(
            HyphErrorKind::InvalidPattern,
            "interior '.' in TeX pattern",
          )
        }
        if b == 46 {
          if non_digit_count > 0 {
            saw_end_dot = true
          }
          non_digit_count = non_digit_count + 1
          used_bytes[46] = 1
          j = j + 1
        } else if b < 128 {
          non_dot_count = non_dot_count + 1
          non_digit_count = non_digit_count + 1
          used_bytes[fold_ascii_lower(b)] = 1
          j = j + 1
        } else {
          let (cp, clen) = decode_utf8_at(patterns, j)
          let lcp = unicode_to_lower(cp)
          tmp_utf8.clear()
          push_utf8_bytes(tmp_utf8, lcp)
          let mut u = 0
          while u < tmp_utf8.length() {
            used_bytes[tmp_utf8[u]] = 1
            u = u + 1
          }
          non_dot_count = non_dot_count + 1
          non_digit_count = non_digit_count + 1
          j = j + clen
        }
      }
    }
    if non_dot_count == 0 {
      return hyph_err(
        HyphErrorKind::InvalidPattern,
        "TeX pattern must contain at least one letter",
      )
    }
    pat_starts.push(start)
    pat_ends.push(end)
  }

  // Pass 1b: scan and validate exception tokens, collecting alphabet bytes.
  let exc_starts : Array[Int] = Array::new()
  let exc_ends : Array[Int] = Array::new()
  i = 0
  while i < exc_bytes_len {
    while i < exc_bytes_len && is_ascii_ws(exceptions.code_unit_at(i)) {
      i = i + 1
    }
    if i >= exc_bytes_len {
      break
    }
    let start = i
    while i < exc_bytes_len && !is_ascii_ws(exceptions.code_unit_at(i)) {
      i = i + 1
    }
    let end = i
    let tok_len = end - start
    if exc_starts.length() >= limits.max_exceptions {
      return hyph_err(
        HyphErrorKind::TooManyExceptions,
        "exception count exceeds max_exceptions",
      )
    }
    if tok_len > limits.max_exception_len {
      return hyph_err(
        HyphErrorKind::ExceptionTooLong,
        "exception length exceeds max_exception_len",
      )
    }

    let mut prev_hyphen = false
    let mut letter_count = 0
    let mut j = start
    while j < end {
      let b = exceptions.code_unit_at(j)
      if b == 45 {
        if j == start || j == end - 1 || prev_hyphen {
          return hyph_err(
            HyphErrorKind::InvalidException,
            "invalid hyphen placement in TeX exception",
          )
        }
        prev_hyphen = true
        j = j + 1
      } else if b < 128 {
        prev_hyphen = false
        letter_count = letter_count + 1
        used_bytes[fold_ascii_lower(b)] = 1
        j = j + 1
      } else {
        prev_hyphen = false
        let (cp, clen) = decode_utf8_at(exceptions, j)
        let lcp = unicode_to_lower(cp)
        tmp_utf8.clear()
        push_utf8_bytes(tmp_utf8, lcp)
        let mut u = 0
        while u < tmp_utf8.length() {
          used_bytes[tmp_utf8[u]] = 1
          u = u + 1
        }
        letter_count = letter_count + 1
        j = j + clen
      }
    }
    if letter_count == 0 {
      return hyph_err(
        HyphErrorKind::InvalidException,
        "TeX exception must contain at least one letter",
      )
    }
    exc_starts.push(start)
    exc_ends.push(end)
  }

  // Pass 2: assign compact dense alphabet IDs 1..alpha_size and fold A..Z -> a..z.
  let char_map = FixedArray::make(256, 0)
  let mut alpha_size = 0
  let mut is_ascii_only = true
  let mut b_idx = 0
  while b_idx < 256 {
    if used_bytes[b_idx] != 0 {
      alpha_size = alpha_size + 1
      char_map[b_idx] = alpha_size
      if b_idx >= 128 {
        is_ascii_only = false
      }
    }
    b_idx = b_idx + 1
  }
  let mut lc = 97
  while lc <= 122 {
    if char_map[lc] != 0 {
      char_map[lc - 32] = char_map[lc]
    }
    lc = lc + 1
  }
  let dot_id = char_map[46]
  let has_hyphen_pattern = char_map[45] != 0

  // Pass 3: insert patterns into intermediate flat trie (first-wins on duplicate keys, matching Rust).
  let pat_trie = RawTrie::new(0)
  let val_pairs_buf : Array[Int] = Array::new()
  let val_group_off_buf : Array[Int] = Array::new()
  let val_group_cnt_buf : Array[Int] = Array::new()
  let tmp_pairs : Array[Int] = Array::new()
  let mut pi = 0
  while pi < pat_starts.length() {
    let start = pat_starts[pi]
    let end = pat_ends[pi]
    tmp_pairs.clear()
    let mut node = 0
    let mut letter_pos = 0
    let mut j = start
    while j < end {
      let b = patterns.code_unit_at(j)
      if is_ascii_digit(b) {
        let digit = b - 48
        if digit > 0 {
          tmp_pairs.push((letter_pos << 4) | digit)
        }
        j = j + 1
      } else if b < 128 {
        let cid = char_map[b]
        let next = pat_trie.step_or_insert(node, cid, 0, limits.max_trie_nodes)
        if next < 0 {
          return hyph_err(
            HyphErrorKind::TooManyTrieNodes,
            "pattern trie node count exceeds max_trie_nodes",
          )
        }
        node = next
        letter_pos = letter_pos + 1
        j = j + 1
      } else {
        let (cp, clen) = decode_utf8_at(patterns, j)
        let lcp = unicode_to_lower(cp)
        tmp_utf8.clear()
        push_utf8_bytes(tmp_utf8, lcp)
        let mut u = 0
        while u < tmp_utf8.length() {
          let cid = char_map[tmp_utf8[u]]
          let next = pat_trie.step_or_insert(node, cid, 0, limits.max_trie_nodes)
          if next < 0 {
            return hyph_err(
              HyphErrorKind::TooManyTrieNodes,
              "pattern trie node count exceeds max_trie_nodes",
            )
          }
          node = next
          letter_pos = letter_pos + 1
          u = u + 1
        }
        j = j + clen
      }
    }
    // First pattern wins on duplicate keys (matches Rust hyphenation =0.8.4).
    if pat_trie.has_entry[node] == 0 {
      pat_trie.has_entry[node] = 1
      let cnt = tmp_pairs.length()
      if cnt == 1 {
        pat_trie.node_meta[node] = tmp_pairs[0]
      } else if cnt > 1 {
        let off = val_pairs_buf.length()
        let mut k = 0
        while k < cnt {
          val_pairs_buf.push(tmp_pairs[k])
          k = k + 1
        }
        let gid = val_group_off_buf.length()
        val_group_off_buf.push(off)
        val_group_cnt_buf.push(cnt)
        pat_trie.node_meta[node] = -(gid + 1)
      }
    }
    pi = pi + 1
  }

  let packed_pat = pack_raw_trie(pat_trie, 0)
  let val_pairs = FixedArray::make(val_pairs_buf.length(), 0)
  let mut vi = 0
  while vi < val_pairs_buf.length() {
    val_pairs[vi] = val_pairs_buf[vi]
    vi = vi + 1
  }
  let val_group_off = FixedArray::make(val_group_off_buf.length(), 0)
  let val_group_cnt = FixedArray::make(val_group_cnt_buf.length(), 0)
  let mut gi = 0
  while gi < val_group_off_buf.length() {
    val_group_off[gi] = val_group_off_buf[gi]
    val_group_cnt[gi] = val_group_cnt_buf[gi]
    gi = gi + 1
  }

  // Pass 4: insert exceptions into compact exception trie (first-wins on duplicates).
  let exc_has_first = FixedArray::make(256, 0)
  let exc_points_buf : Array[Int] = Array::new()
  let exc_group_off_buf : Array[Int] = Array::new()
  let exc_group_cnt_buf : Array[Int] = Array::new()
  let tmp_pts : Array[Int] = Array::new()
  let tmp_char_idxs : Array[Int] = Array::new()
  let exc_trie = RawTrie::new(-1)
  let mut ei = 0
  while ei < exc_starts.length() {
    let start = exc_starts[ei]
    let end = exc_ends[ei]
    tmp_pts.clear()
    tmp_char_idxs.clear()
    let mut node = 0
    let mut byte_pos = 0
    let mut char_pos = 0
    let mut j = start
    while j < end {
      let b = exceptions.code_unit_at(j)
      if b == 45 {
        tmp_pts.push(byte_pos)
        tmp_char_idxs.push(char_pos)
        j = j + 1
      } else if b < 128 {
        if byte_pos == 0 {
          exc_has_first[fold_ascii_lower(b)] = 1
        }
        let cid = char_map[b]
        let next = exc_trie.step_or_insert(node, cid, -1, limits.max_trie_nodes)
        if next < 0 {
          return hyph_err(
            HyphErrorKind::TooManyTrieNodes,
            "exception trie node count exceeds max_trie_nodes",
          )
        }
        node = next
        byte_pos = byte_pos + 1
        char_pos = char_pos + 1
        j = j + 1
      } else {
        let (cp, clen) = decode_utf8_at(exceptions, j)
        let lcp = unicode_to_lower(cp)
        tmp_utf8.clear()
        push_utf8_bytes(tmp_utf8, lcp)
        let mut u = 0
        while u < tmp_utf8.length() {
          let fb = tmp_utf8[u]
          if byte_pos == 0 {
            exc_has_first[fb] = 1
          }
          let cid = char_map[fb]
          let next = exc_trie.step_or_insert(node, cid, -1, limits.max_trie_nodes)
          if next < 0 {
            return hyph_err(
              HyphErrorKind::TooManyTrieNodes,
              "exception trie node count exceeds max_trie_nodes",
            )
          }
          node = next
          byte_pos = byte_pos + 1
          u = u + 1
        }
        char_pos = char_pos + 1
        j = j + clen
      }
    }
    if exc_trie.has_entry[node] == 0 {
      exc_trie.has_entry[node] = 1
      let max_char = char_pos - right_min
      let off = exc_points_buf.length()
      let mut kept = 0
      let mut k = 0
      while k < tmp_pts.length() {
        let ci = tmp_char_idxs[k]
        if ci >= left_min && ci <= max_char {
          exc_points_buf.push(tmp_pts[k])
          kept = kept + 1
        }
        k = k + 1
      }
      if kept == 0 {
        exc_trie.node_meta[node] = 0
      } else {
        let gid = exc_group_off_buf.length()
        exc_group_off_buf.push(off)
        exc_group_cnt_buf.push(kept)
        exc_trie.node_meta[node] = gid + 1
      }
    }
    ei = ei + 1
  }

  let packed_exc = pack_raw_trie(exc_trie, -1)
  let exc_points = FixedArray::make(exc_points_buf.length(), 0)
  let mut epi = 0
  while epi < exc_points_buf.length() {
    exc_points[epi] = exc_points_buf[epi]
    epi = epi + 1
  }
  let exc_group_off = FixedArray::make(exc_group_off_buf.length(), 0)
  let exc_group_cnt = FixedArray::make(exc_group_cnt_buf.length(), 0)
  let mut egi = 0
  while egi < exc_group_off_buf.length() {
    exc_group_off[egi] = exc_group_off_buf[egi]
    exc_group_cnt[egi] = exc_group_cnt_buf[egi]
    egi = egi + 1
  }

  Ok(Dictionary::{
    left_min,
    right_min,
    pattern_count: pat_starts.length(),
    exception_count: exc_starts.length(),
    dot_id,
    alpha_size,
    is_ascii_only,
    has_hyphen_pattern,
    char_map,
    dat_base: packed_pat.base,
    dat_check: packed_pat.check,
    dat_meta: packed_pat.meta,
    val_pairs,
    val_group_off,
    val_group_cnt,
    exc_has_first,
    exc_base: packed_exc.base,
    exc_check: packed_exc.check,
    exc_meta: packed_exc.meta,
    exc_points,
    exc_group_off,
    exc_group_cnt,
  })
}

///| Return the built-in US English (`hyph-en-us`, `left_min = 2`, `right_min = 3`) dictionary.
pub fn Dictionary::en_us() -> Dictionary {
  match en_us_cache.loaded {
    Some(d) => d
    None =>
    match Dictionary::from_tex(en_us_patterns, en_us_exceptions, 2, 3) {
      Ok(d) => {
        en_us_cache.loaded = Some(d)
        d
      }
      Err(_) => {
        let empty_map = FixedArray::make(256, 0)
        let empty1 = FixedArray::make(1, 0)
        let empty_chk = FixedArray::make(1, -1)
        let empty0 : FixedArray[Int] = FixedArray::make(0, 0)
        Dictionary::{
          left_min: 2,
          right_min: 3,
          pattern_count: 0,
          exception_count: 0,
          dot_id: 0,
          alpha_size: 0,
          is_ascii_only: true,
          has_hyphen_pattern: false,
          char_map: empty_map,
          dat_base: empty1,
          dat_check: empty_chk,
          dat_meta: empty1,
          val_pairs: empty0,
          val_group_off: empty0,
          val_group_cnt: empty0,
          exc_has_first: empty_map,
          exc_base: empty1,
          exc_check: empty_chk,
          exc_meta: empty_chk,
          exc_points: empty0,
          exc_group_off: empty0,
          exc_group_cnt: empty0,
        }
      }
    }
  }
}

///| Minimum number of characters required before the first hyphenation break.
pub fn Dictionary::left_min(self : Dictionary) -> Int {
  self.left_min
}

///| Minimum number of characters required after the last hyphenation break.
pub fn Dictionary::right_min(self : Dictionary) -> Int {
  self.right_min
}

///| Number of loaded Knuth-Liang patterns.
pub fn Dictionary::pattern_count(self : Dictionary) -> Int {
  self.pattern_count
}

///| Number of loaded hyphenation exceptions.
pub fn Dictionary::exception_count(self : Dictionary) -> Int {
  self.exception_count
}

fn is_ascii_word_byte(self : Dictionary, b : Int) -> Bool {
  if is_ascii_alpha(b) {
    return true
  }
  if b == 45 {
    return self.has_hyphen_pattern
  }
  if b == 46 {
    return false
  }
  self.char_map[b] != 0
}

fn is_scalar_in_dict(self : Dictionary, s : String, idx : Int, clen : Int) -> Bool {
  let mut k = 0
  while k < clen {
    if self.char_map[s.code_unit_at(idx + k)] == 0 {
      return false
    }
    k = k + 1
  }
  true
}

///| Returns `(is_word, byte_len)` for the UTF-8 scalar at `idx` in `s`.
fn classify_word_scalar(self : Dictionary, s : String, idx : Int) -> (Bool, Int) {
  let b0 = s.code_unit_at(idx)
  if b0 < 128 {
    return (is_ascii_word_byte(self, b0), 1)
  }
  let (cp, clen) = decode_utf8_at(s, idx)
  // Soft hyphen U+00AD stays attached to the word so existing SHYs are honoured.
  if cp == 0xAD || is_unicode_word_scalar(cp) {
    return (true, clen)
  }
  if !self.is_ascii_only && is_scalar_in_dict(self, s, idx, clen) {
    return (true, clen)
  }
  (false, clen)
}

fn hyphenate_ascii_segment_into(
  self : Dictionary,
  word : String,
  start : Int,
  end : Int,
  out : Array[Int],
) -> Unit {
  let seg_len = end - start
  if seg_len <= 0 {
    return
  }
  let char_map = self.char_map

  // Fast exception lookup (zero String allocations).
  if self.exception_count > 0 {
    let first_b = fold_ascii_lower(word.code_unit_at(start))
    if self.exc_has_first[first_b] != 0 {
      let exc_base = self.exc_base
      let exc_check = self.exc_check
      let exc_len = exc_base.length()
      let mut st = 0
      let mut matched = true
      let mut ek = start
      while ek < end {
        let cid = char_map[word.code_unit_at(ek)]
        if cid == 0 {
          matched = false
          break
        }
        let next = exc_base[st] + cid
        if next >= exc_len || exc_check[next] != st {
          matched = false
          break
        }
        st = next
        ek = ek + 1
      }
      if matched {
        let meta = self.exc_meta[st]
        if meta >= 0 {
          if meta > 0 {
            let gid = meta - 1
            let off = self.exc_group_off[gid]
            let cnt = self.exc_group_cnt[gid]
            let exc_pts = self.exc_points
            let mut j = 0
            while j < cnt {
              out.push(start + exc_pts[off + j])
              j = j + 1
            }
          }
          return
        }
      }
    }
  }

  let lmin = self.left_min
  let rmin = self.right_min
  if seg_len < lmin || seg_len - lmin < rmin {
    return
  }

  let wn = seg_len + 2
  let buf = FixedArray::make(wn * 2 + 1, 0)
  buf[0] = self.dot_id
  let mut m = 0
  while m < seg_len {
    buf[m + 1] = char_map[word.code_unit_at(start + m)]
    m = m + 1
  }
  buf[wn - 1] = self.dot_id

  let dat_base = self.dat_base
  let dat_check = self.dat_check
  let dat_meta = self.dat_meta
  let val_pairs = self.val_pairs
  let val_group_off = self.val_group_off
  let val_group_cnt = self.val_group_cnt
  let dat_len = dat_base.length()

  let mut i = 0
  while i < wn {
    let mut state = 0
    let mut j = i
    while j < wn {
      let cid = buf[j]
      if cid == 0 {
        break
      }
      let next = dat_base[state] + cid
      if next >= dat_len || dat_check[next] != state {
        break
      }
      state = next
      let meta = dat_meta[state]
      if meta > 0 {
        let v = meta & 15
        let p = wn + i + (meta >> 4)
        if v > buf[p] {
          buf[p] = v
        }
      } else if meta < 0 {
        let gid = -meta - 1
        let idx = val_group_off[gid]
        let cnt = val_group_cnt[gid]
        let mut r = 0
        while r < cnt {
          let pair = val_pairs[idx + r]
          let v = pair & 15
          let p = wn + i + (pair >> 4)
          if v > buf[p] {
            buf[p] = v
          }
          r = r + 1
        }
      }
      j = j + 1
    }
    i = i + 1
  }

  let mut pos = lmin
  let limit = seg_len - rmin
  while pos <= limit {
    if (buf[wn + pos + 1] & 1) == 1 {
      out.push(start + pos)
    }
    pos = pos + 1
  }
}

fn hyphenate_unicode_segment_into(
  self : Dictionary,
  word : String,
  start : Int,
  end : Int,
  out : Array[Int],
) -> Unit {
  let seg_len = end - start
  if seg_len <= 0 {
    return
  }

  // Soft-hyphen check (U+00AD = 0xC2 0xAD): if present, return strictly interior positions (0 < p < end).
  let mut has_shy = false
  let mut p = start
  while p < end {
    let b0 = word.code_unit_at(p)
    if b0 == 0xC2 && p + 1 < end && word.code_unit_at(p + 1) == 0xAD {
      has_shy = true
      if p > start {
        out.push(p)
      }
      p = p + 2
    } else {
      p = p + 1
    }
  }
  if has_shy {
    return
  }

  // Unicode lowercase folding + original byte-offset mapping (handles U+0130 -> 'i',
  // Greek final sigma Σ -> ς, and all cased scripts).
  let char_map = self.char_map
  let folded_bytes : Array[Int] = Array::new()
  let orig_at_folded : Array[Int] = Array::new()
  let tmp_utf8 : Array[Int] = Array::new()
  let mut char_count = 0
  p = start
  while p < end {
    let orig_rel = p - start
    let (cp, clen) = decode_utf8_at(word, p)
    let lcp = if cp == 0x03A3 && char_count > 0 && p + clen == end {
      0x03C2
    } else {
      unicode_to_lower(cp)
    }
    tmp_utf8.clear()
    push_utf8_bytes(tmp_utf8, lcp)
    let mut u = 0
    while u < tmp_utf8.length() {
      folded_bytes.push(tmp_utf8[u])
      orig_at_folded.push(if u == 0 { orig_rel } else { -1 })
      u = u + 1
    }
    char_count = char_count + 1
    p = p + clen
  }

  let flen = folded_bytes.length()
  if flen == 0 {
    return
  }

  // Exception lookup on folded bytes.
  if self.exception_count > 0 && self.exc_has_first[folded_bytes[0]] != 0 {
    let exc_base = self.exc_base
    let exc_check = self.exc_check
    let exc_len = exc_base.length()
    let mut st = 0
    let mut matched = true
    let mut ek = 0
    while ek < flen {
      let cid = char_map[folded_bytes[ek]]
      if cid == 0 {
        matched = false
        break
      }
      let next = exc_base[st] + cid
      if next >= exc_len || exc_check[next] != st {
        matched = false
        break
      }
      st = next
      ek = ek + 1
    }
    if matched {
      let meta = self.exc_meta[st]
      if meta >= 0 {
        if meta > 0 {
          let gid = meta - 1
          let off = self.exc_group_off[gid]
          let cnt = self.exc_group_cnt[gid]
          let exc_pts = self.exc_points
          let mut j = 0
          while j < cnt {
            let fpos = exc_pts[off + j]
            if fpos >= 0 && fpos < flen && orig_at_folded[fpos] >= 0 {
              out.push(start + orig_at_folded[fpos])
            }
            j = j + 1
          }
        }
        return
      }
    }
  }

  let lmin = self.left_min
  let rmin = self.right_min
  if char_count < lmin || char_count - lmin < rmin {
    return
  }

  let wn = flen + 2
  let buf = FixedArray::make(wn * 2 + 1, 0)
  buf[0] = self.dot_id
  let mut m = 0
  while m < flen {
    buf[m + 1] = char_map[folded_bytes[m]]
    m = m + 1
  }
  buf[wn - 1] = self.dot_id

  let dat_base = self.dat_base
  let dat_check = self.dat_check
  let dat_meta = self.dat_meta
  let val_pairs = self.val_pairs
  let val_group_off = self.val_group_off
  let val_group_cnt = self.val_group_cnt
  let dat_len = dat_base.length()

  let mut i = 0
  while i < wn {
    let mut state = 0
    let mut j = i
    while j < wn {
      let cid = buf[j]
      if cid == 0 {
        break
      }
      let next = dat_base[state] + cid
      if next >= dat_len || dat_check[next] != state {
        break
      }
      state = next
      let meta = dat_meta[state]
      if meta > 0 {
        let v = meta & 15
        let pos_idx = wn + i + (meta >> 4)
        if v > buf[pos_idx] {
          buf[pos_idx] = v
        }
      } else if meta < 0 {
        let gid = -meta - 1
        let idx = val_group_off[gid]
        let cnt = val_group_cnt[gid]
        let mut r = 0
        while r < cnt {
          let pair = val_pairs[idx + r]
          let v = pair & 15
          let pos_idx = wn + i + (pair >> 4)
          if v > buf[pos_idx] {
            buf[pos_idx] = v
          }
          r = r + 1
        }
      }
      j = j + 1
    }
    i = i + 1
  }

  let max_char = char_count - rmin
  let mut char_idx = 0
  let mut fpos = 0
  while fpos < flen {
    let orig_rel = orig_at_folded[fpos]
    if orig_rel >= 0 {
      if char_idx >= lmin && char_idx <= max_char {
        if (buf[wn + fpos + 1] & 1) == 1 {
          out.push(start + orig_rel)
        }
      }
      char_idx = char_idx + 1
    }
    fpos = fpos + 1
  }
}

///| Compute all permitted hyphenation break positions as ascending UTF-8 byte offsets within `word`.
pub fn Dictionary::opportunities(self : Dictionary, word : String) -> Array[Int] {
  let out : Array[Int] = Array::new()
  self.opportunities_into(word, out)
  out
}

///| Reusable-buffer hot path: clears `out` and appends ascending UTF-8 byte offsets within `word`.
pub fn Dictionary::opportunities_into(
  self : Dictionary,
  word : String,
  out : Array[Int],
) -> Unit {
  out.clear()
  let n = word.length()
  if n == 0 {
    return
  }

  // Fast path: check if entire word is pure ASCII word bytes (single linear scan).
  let mut pure_ascii_word = true
  let mut k = 0
  while k < n {
    let b = word.code_unit_at(k)
    if b >= 128 || !is_ascii_word_byte(self, b) {
      pure_ascii_word = false
      break
    }
    k = k + 1
  }
  if pure_ascii_word {
    hyphenate_ascii_segment_into(self, word, 0, n, out)
    return
  }

  // Check if word contains any soft hyphens (U+00AD = 0xC2 0xAD); if so, return strictly interior positions.
  let mut has_shy = false
  k = 0
  while k < n {
    if word.code_unit_at(k) == 0xC2 && k + 1 < n && word.code_unit_at(k + 1) == 0xAD {
      has_shy = true
      if k > 0 {
        out.push(k)
      }
      k = k + 2
    } else {
      k = k + 1
    }
  }
  if has_shy {
    return
  }

  // Segment into word-scalar runs (identical segmentation to hyphenate_text).
  let mut i = 0
  while i < n {
    let (is_w, clen) = classify_word_scalar(self, word, i)
    if is_w {
      let start = i
      let mut seg_non_ascii = word.code_unit_at(i) >= 128
      i = i + clen
      while i < n {
        let (is_w2, clen2) = classify_word_scalar(self, word, i)
        if !is_w2 {
          break
        }
        if word.code_unit_at(i) >= 128 {
          seg_non_ascii = true
        }
        i = i + clen2
      }
      if seg_non_ascii {
        hyphenate_unicode_segment_into(self, word, start, i, out)
      } else {
        hyphenate_ascii_segment_into(self, word, start, i, out)
      }
    } else {
      i = i + clen
    }
  }
}

///| Split `word` at every permitted hyphenation opportunity.
pub fn Dictionary::split_word(self : Dictionary, word : String) -> Array[String] {
  let n = word.length()
  if n == 0 {
    return Array::new()
  }
  let pts = self.opportunities(word)
  if pts.length() == 0 {
    return [word]
  }
  let out : Array[String] = Array::new()
  let mut prev = 0
  let mut i = 0
  while i < pts.length() {
    let p = pts[i]
    out.push(word.slice(prev, p))
    prev = p
    i = i + 1
  }
  out.push(word.slice(prev, n))
  out
}

///| Insert `sep` at every permitted hyphenation opportunity within `word`.
pub fn Dictionary::hyphenate(self : Dictionary, word : String, sep : String) -> String {
  let n = word.length()
  if n == 0 {
    return word
  }
  let pts = self.opportunities(word)
  if pts.length() == 0 {
    return word
  }
  let sb = StringBuilder::with_capacity(n + pts.length() * sep.length())
  let mut prev = 0
  let mut i = 0
  while i < pts.length() {
    let p = pts[i]
    sb.write_string(word.slice(prev, p))
    sb.write_string(sep)
    prev = p
    i = i + 1
  }
  sb.write_string(word.slice(prev, n))
  sb.to_string()
}

///| Hyphenate all words inside `text` with `sep`, preserving punctuation, whitespace, and non-words.
pub fn Dictionary::hyphenate_text(self : Dictionary, text : String, sep : String) -> String {
  let n = text.length()
  if n == 0 || sep.length() == 0 {
    return text
  }
  let sb = StringBuilder::with_capacity(n + n / 8)
  let pts : Array[Int] = Array::new()
  let mut i = 0
  while i < n {
    let (is_w, clen) = classify_word_scalar(self, text, i)
    if is_w {
      let start = i
      let mut seg_non_ascii = text.code_unit_at(i) >= 128
      i = i + clen
      while i < n {
        let (is_w2, clen2) = classify_word_scalar(self, text, i)
        if !is_w2 {
          break
        }
        if text.code_unit_at(i) >= 128 {
          seg_non_ascii = true
        }
        i = i + clen2
      }
      pts.clear()
      if seg_non_ascii {
        hyphenate_unicode_segment_into(self, text, start, i, pts)
      } else {
        hyphenate_ascii_segment_into(self, text, start, i, pts)
      }
      if pts.length() == 0 {
        sb.write_string(text.slice(start, i))
      } else {
        let mut prev = start
        let mut pi = 0
        while pi < pts.length() {
          let p = pts[pi]
          sb.write_string(text.slice(prev, p))
          sb.write_string(sep)
          prev = p
          pi = pi + 1
        }
        sb.write_string(text.slice(prev, i))
      }
    } else {
      let start = i
      i = i + clen
      while i < n {
        let (is_w2, clen2) = classify_word_scalar(self, text, i)
        if is_w2 {
          break
        }
        i = i + clen2
      }
      sb.write_string(text.slice(start, i))
    }
  }
  sb.to_string()
}
