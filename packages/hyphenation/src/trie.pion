///| Compact O(N) Double-Array Trie builder using a doubly-linked free-slot list.

struct RawTrie {
  first_child : Array[Int]
  next_sibling : Array[Int]
  edge_char : Array[Int]
  node_meta : Array[Int]
  has_entry : Array[Int]
}

fn RawTrie::new(default_meta : Int) -> RawTrie {
  let fc : Array[Int] = Array::new()
  let ns : Array[Int] = Array::new()
  let ec : Array[Int] = Array::new()
  let nm : Array[Int] = Array::new()
  let he : Array[Int] = Array::new()
  fc.push(-1)
  ns.push(-1)
  ec.push(0)
  nm.push(default_meta)
  he.push(0)
  RawTrie::{
    first_child: fc,
    next_sibling: ns,
    edge_char: ec,
    node_meta: nm,
    has_entry: he,
  }
}

fn RawTrie::step_or_insert(
  self : RawTrie,
  node : Int,
  cid : Int,
  default_meta : Int,
  max_nodes : Int,
) -> Int {
  let mut cur = self.first_child[node]
  while cur != -1 {
    if self.edge_char[cur] == cid {
      return cur
    }
    cur = self.next_sibling[cur]
  }
  let idx = self.first_child.length()
  if idx >= max_nodes {
    return -1
  }
  self.first_child.push(-1)
  self.next_sibling.push(self.first_child[node])
  self.edge_char.push(cid)
  self.node_meta.push(default_meta)
  self.has_entry.push(0)
  self.first_child[node] = idx
  idx
}

struct PackedDat {
  base : FixedArray[Int]
  check : FixedArray[Int]
  meta : FixedArray[Int]
}

fn ensure_dat_cap(
  base : Array[Int],
  check : Array[Int],
  meta : Array[Int],
  free_next : Array[Int],
  free_prev : Array[Int],
  tail_ref : Array[Int],
  needed : Int,
  default_meta : Int,
) -> Unit {
  let old_len = base.length()
  if old_len >= needed {
    return
  }
  let mut new_cap = old_len * 2
  if new_cap < 64 {
    new_cap = 64
  }
  while new_cap < needed {
    new_cap = new_cap * 2
  }
  let mut tail = tail_ref[0]
  let mut idx = old_len
  while idx < new_cap {
    base.push(0)
    check.push(-1)
    meta.push(default_meta)
    free_next.push(-1)
    free_prev.push(tail)
    if tail >= 0 {
      free_next[tail] = idx
    }
    tail = idx
    idx = idx + 1
  }
  tail_ref[0] = tail
}

fn unlink_free(
  slot : Int,
  free_next : Array[Int],
  free_prev : Array[Int],
  head_ref : Array[Int],
  tail_ref : Array[Int],
) -> Unit {
  let p = free_prev[slot]
  let n = free_next[slot]
  if p >= 0 {
    free_next[p] = n
  } else {
    head_ref[0] = n
  }
  if n >= 0 {
    free_prev[n] = p
  } else {
    tail_ref[0] = p
  }
  free_prev[slot] = -1
  free_next[slot] = -1
}

fn pack_raw_trie(trie : RawTrie, default_meta : Int) -> PackedDat {
  let node_count = trie.first_child.length()
  let init_cap = if node_count * 2 > 64 { node_count * 2 } else { 64 }
  let base : Array[Int] = Array::new()
  let check : Array[Int] = Array::new()
  let meta : Array[Int] = Array::new()
  let free_next : Array[Int] = Array::new()
  let free_prev : Array[Int] = Array::new()

  // Slot 0 is root (occupied). Slots 1..init_cap-1 form the initial free list.
  base.push(0)
  check.push(0)
  meta.push(trie.node_meta[0])
  free_next.push(-1)
  free_prev.push(-1)

  let mut k = 1
  while k < init_cap {
    base.push(0)
    check.push(-1)
    meta.push(default_meta)
    free_prev.push(if k == 1 { -1 } else { k - 1 })
    free_next.push(if k + 1 < init_cap { k + 1 } else { -1 })
    k = k + 1
  }

  let head_ref : Array[Int] = [1]
  let tail_ref : Array[Int] = [init_cap - 1]

  let q_src : Array[Int] = Array::new()
  let q_dat : Array[Int] = Array::new()
  q_src.push(0)
  q_dat.push(0)
  let mut q_head = 0

  let c_ids : Array[Int] = Array::new()
  let c_nodes : Array[Int] = Array::new()
  let mut max_used = 0

  while q_head < q_src.length() {
    let src_u = q_src[q_head]
    let dat_u = q_dat[q_head]
    q_head = q_head + 1

    c_ids.clear()
    c_nodes.clear()
    let mut ch = trie.first_child[src_u]
    let mut min_c = 1000000
    let mut max_c = 0
    while ch != -1 {
      let cid = trie.edge_char[ch]
      c_ids.push(cid)
      c_nodes.push(ch)
      if cid < min_c {
        min_c = cid
      }
      if cid > max_c {
        max_c = cid
      }
      ch = trie.next_sibling[ch]
    }
    let nc = c_ids.length()
    if nc == 0 {
      base[dat_u] = 0
      continue
    }

    // Walk the doubly-linked free list with a bounded hop cap (strict O(1) amortized per node).
    let mut b = 0
    let mut found = false
    let mut slot = head_ref[0]
    let mut hops = 0
    let max_hops = if nc > 8 { 16 } else { 64 }
    let min_slot = min_c + 1
    while slot != -1 && hops < max_hops {
      if slot < min_slot {
        slot = free_next[slot]
        continue
      }
      let cand_b = slot - min_c
      let need = cand_b + max_c + 1
      if need > base.length() {
        ensure_dat_cap(base, check, meta, free_next, free_prev, tail_ref, need, default_meta)
      }
      let mut ok = true
      let mut ci = 0
      while ci < nc {
        if check[cand_b + c_ids[ci]] != -1 {
          ok = false
          break
        }
        ci = ci + 1
      }
      if ok {
        b = cand_b
        found = true
        break
      }
      hops = hops + 1
      slot = free_next[slot]
    }

    if !found {
      // Fall back to fresh tail beyond max_used: guaranteed conflict-free in O(1).
      let tail_slot = if max_used + 1 > min_slot { max_used + 1 } else { min_slot }
      b = tail_slot - min_c
      let need = b + max_c + 1
      ensure_dat_cap(base, check, meta, free_next, free_prev, tail_ref, need, default_meta)
    }

    base[dat_u] = b
    let mut ci = 0
    while ci < nc {
      let ns = b + c_ids[ci]
      let child_src = c_nodes[ci]
      check[ns] = dat_u
      meta[ns] = trie.node_meta[child_src]
      unlink_free(ns, free_next, free_prev, head_ref, tail_ref)
      if ns > max_used {
        max_used = ns
      }
      q_src.push(child_src)
      q_dat.push(ns)
      ci = ci + 1
    }
  }

  let final_len = max_used + 1
  let out_base = FixedArray::make(final_len, 0)
  let out_check = FixedArray::make(final_len, -1)
  let out_meta = FixedArray::make(final_len, default_meta)
  let mut i = 0
  while i < final_len {
    out_base[i] = base[i]
    out_check[i] = check[i]
    out_meta[i] = meta[i]
    i = i + 1
  }
  PackedDat::{ base: out_base, check: out_check, meta: out_meta }
}
