///| Compact Double-Array Trie builder for TeX Knuth-Liang patterns and exceptions.

struct RawTrie {
  first_child : Array[Int]
  next_sibling : Array[Int]
  edge_char : Array[Int]
  node_meta : Array[Int]
}

fn RawTrie::new(default_meta : Int) -> RawTrie {
  let fc : Array[Int] = Array::new()
  let ns : Array[Int] = Array::new()
  let ec : Array[Int] = Array::new()
  let nm : Array[Int] = Array::new()
  fc.push(-1)
  ns.push(-1)
  ec.push(0)
  nm.push(default_meta)
  RawTrie::{ first_child: fc, next_sibling: ns, edge_char: ec, node_meta: nm }
}

fn RawTrie::step_or_insert(
  self : RawTrie,
  node : Int,
  cid : Int,
  default_meta : Int,
  max_nodes : Int,
) -> Int {
  let mut cur = self.first_child[node]
  while cur != -1 {
    if self.edge_char[cur] == cid {
      return cur
    }
    cur = self.next_sibling[cur]
  }
  let idx = self.first_child.length()
  if idx >= max_nodes {
    return -1
  }
  self.first_child.push(-1)
  self.next_sibling.push(self.first_child[node])
  self.edge_char.push(cid)
  self.node_meta.push(default_meta)
  self.first_child[node] = idx
  idx
}

struct PackedDat {
  base : FixedArray[Int]
  check : FixedArray[Int]
  meta : FixedArray[Int]
}

fn ensure_dat_cap(
  base : Array[Int],
  check : Array[Int],
  meta : Array[Int],
  needed : Int,
  default_meta : Int,
) -> Unit {
  if base.length() >= needed {
    return
  }
  let mut new_cap = base.length() * 2
  if new_cap < 64 {
    new_cap = 64
  }
  while new_cap < needed {
    new_cap = new_cap * 2
  }
  while base.length() < new_cap {
    base.push(0)
    check.push(-1)
    meta.push(default_meta)
  }
}

fn pack_raw_trie(trie : RawTrie, default_meta : Int) -> PackedDat {
  let node_count = trie.first_child.length()
  let init_cap = if node_count * 2 > 64 { node_count * 2 } else { 64 }
  let base : Array[Int] = Array::new()
  let check : Array[Int] = Array::new()
  let meta : Array[Int] = Array::new()
  let mut k = 0
  while k < init_cap {
    base.push(0)
    check.push(-1)
    meta.push(default_meta)
    k = k + 1
  }
  check[0] = 0
  meta[0] = trie.node_meta[0]

  let q_src : Array[Int] = Array::new()
  let q_dat : Array[Int] = Array::new()
  q_src.push(0)
  q_dat.push(0)
  let mut q_head = 0

  let c_ids : Array[Int] = Array::new()
  let c_nodes : Array[Int] = Array::new()
  let mut first_free = 1
  let mut max_used = 0

  while q_head < q_src.length() {
    let src_u = q_src[q_head]
    let dat_u = q_dat[q_head]
    q_head = q_head + 1

    c_ids.clear()
    c_nodes.clear()
    let mut ch = trie.first_child[src_u]
    let mut min_c = 1000000
    let mut max_c = 0
    while ch != -1 {
      let cid = trie.edge_char[ch]
      c_ids.push(cid)
      c_nodes.push(ch)
      if cid < min_c {
        min_c = cid
      }
      if cid > max_c {
        max_c = cid
      }
      ch = trie.next_sibling[ch]
    }
    let nc = c_ids.length()
    if nc == 0 {
      base[dat_u] = 0
      continue
    }

    while first_free < check.length() && check[first_free] != -1 {
      first_free = first_free + 1
    }

    let mut pos = first_free
    if pos < min_c + 1 {
      pos = min_c + 1
    }
    let mut b = pos - min_c
    let mut nonzero_num = 0
    let mut first_attempt = true

    while true {
      let need = b + max_c + 1
      ensure_dat_cap(base, check, meta, need, default_meta)
      if check[b + min_c] != -1 {
        nonzero_num = nonzero_num + 1
        b = b + 1
        continue
      }
      if first_attempt {
        first_attempt = false
      }
      let mut ok = true
      let mut ci = 0
      while ci < nc {
        if check[b + c_ids[ci]] != -1 {
          ok = false
          break
        }
        ci = ci + 1
      }
      if ok {
        break
      }
      b = b + 1
    }

    // Darts-clone heuristic: advance first_free when prefix is >= 95% full.
    let scanned = b + min_c - first_free + 1
    if scanned > 0 && nonzero_num * 20 >= scanned * 19 {
      first_free = b + min_c
    }

    base[dat_u] = b
    let mut ci = 0
    while ci < nc {
      let ns = b + c_ids[ci]
      let child_src = c_nodes[ci]
      check[ns] = dat_u
      meta[ns] = trie.node_meta[child_src]
      if ns > max_used {
        max_used = ns
      }
      q_src.push(child_src)
      q_dat.push(ns)
      ci = ci + 1
    }
  }

  let final_len = max_used + 1
  let out_base = FixedArray::make(final_len, 0)
  let out_check = FixedArray::make(final_len, -1)
  let out_meta = FixedArray::make(final_len, default_meta)
  let mut i = 0
  while i < final_len {
    out_base[i] = base[i]
    out_check[i] = check[i]
    out_meta[i] = meta[i]
    i = i + 1
  }
  PackedDat::{ base: out_base, check: out_check, meta: out_meta }
}
