///| Compact Unicode case folding and word-scalar classification for `packages/hyphenation`.
///| Generated from Unicode Simple_Lowercase_Mapping (with Turkish U+0130 -> 'i' refold)
///| and General_Category L*/M* + ZWJ/ZWNJ.

///| Decode one UTF-8 scalar at `idx` in `s`, returning `(codepoint, byte_len)`.
fn decode_utf8_at(s : String, idx : Int) -> (Int, Int) {
  let n = s.length()
  if idx >= n {
    return (0, 0)
  }
  let b0 = s.code_unit_at(idx)
  if b0 < 0x80 {
    return (b0, 1)
  }
  if (b0 & 0xE0) == 0xC0 && idx + 1 < n {
    let b1 = s.code_unit_at(idx + 1)
    return (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
  }
  if (b0 & 0xF0) == 0xE0 && idx + 2 < n {
    let b1 = s.code_unit_at(idx + 1)
    let b2 = s.code_unit_at(idx + 2)
    return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
  }
  if (b0 & 0xF8) == 0xF0 && idx + 3 < n {
    let b1 = s.code_unit_at(idx + 1)
    let b2 = s.code_unit_at(idx + 2)
    let b3 = s.code_unit_at(idx + 3)
    return (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), 4)
  }
  (b0, 1)
}

///| Encode a Unicode scalar `cp` as UTF-8 bytes pushed into `out`.
fn push_utf8_bytes(out : Array[Int], cp : Int) -> Unit {
  if cp < 0x80 {
    out.push(cp)
  } else if cp < 0x800 {
    out.push(0xC0 | (cp >> 6))
    out.push(0x80 | (cp & 0x3F))
  } else if cp < 0x10000 {
    out.push(0xE0 | (cp >> 12))
    out.push(0x80 | ((cp >> 6) & 0x3F))
    out.push(0x80 | (cp & 0x3F))
  } else {
    out.push(0xF0 | (cp >> 18))
    out.push(0x80 | ((cp >> 12) & 0x3F))
    out.push(0x80 | ((cp >> 6) & 0x3F))
    out.push(0x80 | (cp & 0x3F))
  }
}

