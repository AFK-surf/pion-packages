///| Simple Unicode lowercase folding (including Turkish U+0130 -> 'i').
fn unicode_to_lower(cp : Int) -> Int {
  if cp < 0x80 {
    if cp >= 65 && cp <= 90 {
      return cp + 32
    }
    return cp
  }
  let mut lo = 0
  let mut hi = lc_starts.length() - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let s = lc_starts[mid]
    if cp < s {
      hi = mid - 1
    } else if cp > lc_ends[mid] {
      lo = mid + 1
    } else {
      let op = lc_ops[mid]
      if op >= 0x40000000 {
        let parity = op & 1
        if (cp & 1) == parity {
          return cp + 1
        }
        return cp
      }
      return cp + op
    }
  }
  cp
}

