///| Returns true if `cp` is a Unicode letter, combining mark, ZWJ or ZWNJ.
fn is_unicode_word_scalar(cp : Int) -> Bool {
  if cp < 0x80 {
    return (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
  }
  let mut lo = 0
  let mut hi = word_scalar_starts.length() - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if cp < word_scalar_starts[mid] {
      hi = mid - 1
    } else if cp > word_scalar_ends[mid] {
      lo = mid + 1
    } else {
      return true
    }
  }
  false
}
