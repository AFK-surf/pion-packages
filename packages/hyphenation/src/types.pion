///| Public API types and limits for `packages/hyphenation`.

///| Error kind returned when loading or validating a TeX Knuth-Liang dictionary.
pub enum HyphErrorKind {
  InvalidMinima
  InputTooLarge
  TooManyPatterns
  TooManyExceptions
  PatternTooLong
  ExceptionTooLong
  InvalidPattern
  InvalidException
  TooManyTrieNodes
  Unimplemented
}

///| Structured error returned by `Dictionary::from_tex` and `Dictionary::from_tex_with_limits`.
pub val struct HyphError {
  pub kind : HyphErrorKind
  pub message : String
}

///| Format a `HyphError` for display.
pub fn HyphError::to_string(self : HyphError) -> String {
  self.message
}

///| Resource limits protecting dictionary loading from malformed or adversarial inputs.
pub val struct Limits {
  pub max_input_bytes : Int
  pub max_patterns : Int
  pub max_exceptions : Int
  pub max_pattern_len : Int
  pub max_exception_len : Int
  pub max_trie_nodes : Int
}

///| Default resource limits suitable for standard TeX hyphenation dictionaries.
pub fn Limits::default() -> Limits {
  Limits::{
    max_input_bytes: 1048576,
    max_patterns: 65536,
    max_exceptions: 16384,
    max_pattern_len: 64,
    max_exception_len: 128,
    max_trie_nodes: 262144,
  }
}

///| Compiled Knuth-Liang hyphenation dictionary backed by a compact Double-Array Trie.
pub struct Dictionary {
  left_min : Int
  right_min : Int
  pattern_count : Int
  exception_count : Int
  dot_id : Int
  alpha_size : Int
  is_ascii_only : Bool
  has_hyphen_pattern : Bool
  char_map : FixedArray[Int]
  dat_base : FixedArray[Int]
  dat_check : FixedArray[Int]
  dat_meta : FixedArray[Int]
  val_pairs : FixedArray[Int]
  val_group_off : FixedArray[Int]
  val_group_cnt : FixedArray[Int]
  exc_has_first : FixedArray[Int]
  exc_base : FixedArray[Int]
  exc_check : FixedArray[Int]
  exc_meta : FixedArray[Int]
  exc_points : FixedArray[Int]
  exc_group_off : FixedArray[Int]
  exc_group_cnt : FixedArray[Int]
}
