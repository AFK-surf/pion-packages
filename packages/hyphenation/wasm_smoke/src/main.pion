///| Four-mode (Native/Wasm32 x debug/--release) smoke entry for `packages/hyphenation`.

import "hyphenation"

fn format_ints(xs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  sb.write_string("[")
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(xs[i].to_string())
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let d = hyphenation::Dictionary::en_us()
  if d.left_min() != 2 || d.right_min() != 3 || d.pattern_count() != 4938 || d.exception_count() != 1441 {
    io_println(world, "error: invalid en_us metadata")
    return 1
  }

  let h1 = d.hyphenate("hyphenation", "-")
  let h2 = d.hyphenate("internationalization", "-")
  let h3 = d.hyphenate("acronym", "-")
  let h4 = d.hyphenate("organization's", "-")
  let h5 = d.hyphenate("super-computer", "|")
  let h6 = d.hyphenate_text("Typography, computer\u{2014}algorithm 2026: extraordinary & acronym!", "-")

  if h1 != "hy-phen-a-tion" || h3 != "acro-nym" || h4 != "or-ga-ni-za-tion's" {
    io_println(world, "error: en_us hyphenation mismatch")
    return 2
  }

  let pts = d.opportunities("algorithm")
  let parts = d.split_word("algorithm")
  if parts.length() != 3 || parts[0] != "al" || parts[1] != "go" || parts[2] != "rithm" {
    io_println(world, "error: split_word mismatch")
    return 3
  }

  let de = match hyphenation::Dictionary::from_tex("ü1be be1ra", "", 2, 2) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "error: custom from_tex failed: " + e.message)
      return 4
    }
  }
  let de_h = de.hyphenate("ÜBERALL", "-")
  if de_h != "ÜBE-RALL" {
    io_println(world, "error: UTF-8 uppercase hyphenation mismatch")
    return 5
  }

  let lim = hyphenation::Limits::{
    max_input_bytes: 1024,
    max_patterns: 1,
    max_exceptions: 10,
    max_pattern_len: 32,
    max_exception_len: 32,
    max_trie_nodes: 128,
  }
  let lim_ok = match hyphenation::Dictionary::from_tex_with_limits("a1b c1d", "", 2, 2, lim) {
    Ok(_) => false
    Err(_) => true
  }
  if !lim_ok {
    io_println(world, "error: limits check failed")
    return 6
  }

  io_println(world, "en_us=" + d.pattern_count().to_string() + "/" + d.exception_count().to_string())
  io_println(world, "h1=" + h1)
  io_println(world, "h2=" + h2)
  io_println(world, "h3=" + h3)
  io_println(world, "h4=" + h4)
  io_println(world, "h5=" + h5)
  io_println(world, "h6=" + h6)
  io_println(world, "pts=" + format_ints(pts))
  io_println(world, "de=" + de_h)
  io_println(world, "limits=ok")
  0
}
