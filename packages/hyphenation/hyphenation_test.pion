///| Comprehensive Knuth-Liang hyphenation compliance and safety tests.

fn assert_int_array_eq(actual : Array[Int], expected : Array[Int], ctx : String) -> Unit {
  debug_assert(
    actual.length() == expected.length(),
    ctx + ": length mismatch (got " + actual.length().to_string() + ", expected " + expected.length().to_string() + ")",
  )
  let mut i = 0
  while i < actual.length() && i < expected.length() {
    debug_assert(
      actual[i] == expected[i],
      ctx + ": mismatch at index " + i.to_string() + " (got " + actual[i].to_string() + ", expected " + expected[i].to_string() + ")",
    )
    i = i + 1
  }
}

fn assert_str_array_eq(actual : Array[String], expected : Array[String], ctx : String) -> Unit {
  debug_assert(
    actual.length() == expected.length(),
    ctx + ": length mismatch (got " + actual.length().to_string() + ", expected " + expected.length().to_string() + ")",
  )
  let mut i = 0
  while i < actual.length() && i < expected.length() {
    debug_assert(
      actual[i] == expected[i],
      ctx + ": mismatch at index " + i.to_string() + " (got '" + actual[i] + "', expected '" + expected[i] + "')",
    )
    i = i + 1
  }
}

fn expect_err_kind(res : Result[Dictionary, HyphError], expected : HyphErrorKind, ctx : String) -> Unit {
  match res {
    Ok(_) => debug_assert(false, ctx + ": expected Err, got Ok")
    Err(e) => {
      let matched = match (e.kind, expected) {
        (HyphErrorKind::InvalidMinima, HyphErrorKind::InvalidMinima) => true
        (HyphErrorKind::InputTooLarge, HyphErrorKind::InputTooLarge) => true
        (HyphErrorKind::TooManyPatterns, HyphErrorKind::TooManyPatterns) => true
        (HyphErrorKind::TooManyExceptions, HyphErrorKind::TooManyExceptions) => true
        (HyphErrorKind::PatternTooLong, HyphErrorKind::PatternTooLong) => true
        (HyphErrorKind::ExceptionTooLong, HyphErrorKind::ExceptionTooLong) => true
        (HyphErrorKind::InvalidPattern, HyphErrorKind::InvalidPattern) => true
        (HyphErrorKind::InvalidException, HyphErrorKind::InvalidException) => true
        (HyphErrorKind::TooManyTrieNodes, HyphErrorKind::TooManyTrieNodes) => true
        _ => false
      }
      debug_assert(matched, ctx + ": unexpected error kind, message=" + e.message)
    }
  }
}

test "en_us dictionary metadata" {
  let d = Dictionary::en_us()
  debug_assert(d.left_min() == 2, "en_us left_min should be 2")
  debug_assert(d.right_min() == 3, "en_us right_min should be 3")
  debug_assert(d.pattern_count() == 4938, "en_us should load all 4938 hyph-en-us patterns")
  debug_assert(d.exception_count() == 14, "en_us should load all 14 hyph-en-us exceptions")
}

test "en_us standard English words" {
  let d = Dictionary::en_us()
  assert_int_array_eq(d.opportunities("hyphenation"), [2, 6], "hyphenation")
  assert_int_array_eq(d.opportunities("algorithm"), [2, 4], "algorithm")
  assert_int_array_eq(d.opportunities("computer"), [3], "computer")
  assert_int_array_eq(d.opportunities("typography"), [2, 5, 7], "typography")
  assert_int_array_eq(
    d.opportunities("internationalization"),
    [2, 5, 7, 11, 13, 16],
    "internationalization",
  )
  assert_int_array_eq(d.opportunities("representation"), [3, 5, 8, 10], "representation")
  assert_int_array_eq(d.opportunities("extraordinary"), [2, 5, 7, 9], "extraordinary")
  assert_int_array_eq(d.opportunities("unbelievable"), [2, 4, 8], "unbelievable")
  assert_int_array_eq(d.opportunities("communication"), [3, 5, 7, 9], "communication")
  assert_int_array_eq(d.opportunities("programming"), [3, 7], "programming")
  assert_int_array_eq(d.opportunities("miscellaneous"), [3, 6, 8], "miscellaneous")
  assert_int_array_eq(d.opportunities("university"), [3, 6], "university")
  assert_int_array_eq(d.opportunities("beautiful"), [4, 6], "beautiful")
  assert_int_array_eq(d.opportunities("information"), [2, 5, 7], "information")
  assert_int_array_eq(d.opportunities("implementation"), [2, 5, 8, 10], "implementation")
  assert_int_array_eq(d.opportunities("dictionary"), [3, 6], "dictionary")
  assert_int_array_eq(d.opportunities("performance"), [3, 6], "performance")
  assert_int_array_eq(
    d.opportunities("supercalifragilisticexpialidocious"),
    [2, 5, 8, 13, 17, 20, 22, 24, 27, 29],
    "supercalifragilisticexpialidocious",
  )
  assert_int_array_eq(
    d.opportunities("antidisestablishmentarianism"),
    [2, 7, 9, 12, 16, 19, 22, 23, 25],
    "antidisestablishmentarianism",
  )
  assert_int_array_eq(d.opportunities("cat"), [], "short word cat")
  assert_int_array_eq(d.opportunities("word"), [], "short word word")
  assert_int_array_eq(d.opportunities("book"), [], "short word book")
  assert_int_array_eq(d.opportunities(""), [], "empty word")
}

test "en_us all 14 TeX exceptions take precedence" {
  let d = Dictionary::en_us()
  debug_assert(d.hyphenate("associate", "-") == "as-so-ciate", "associate")
  debug_assert(d.hyphenate("associates", "-") == "as-so-ciates", "associates")
  debug_assert(d.hyphenate("declination", "-") == "dec-li-na-tion", "declination")
  debug_assert(d.hyphenate("obligatory", "-") == "oblig-a-tory", "obligatory")
  debug_assert(d.hyphenate("philanthropic", "-") == "phil-an-thropic", "philanthropic")
  debug_assert(d.hyphenate("present", "-") == "present", "present no-break exception")
  debug_assert(d.hyphenate("presents", "-") == "presents", "presents no-break exception")
  debug_assert(d.hyphenate("project", "-") == "project", "project no-break exception")
  debug_assert(d.hyphenate("projects", "-") == "projects", "projects no-break exception")
  debug_assert(d.hyphenate("reciprocity", "-") == "reci-procity", "reciprocity")
  debug_assert(d.hyphenate("recognizance", "-") == "re-cog-ni-zance", "recognizance")
  debug_assert(d.hyphenate("reformation", "-") == "ref-or-ma-tion", "reformation")
  debug_assert(d.hyphenate("retribution", "-") == "ret-ri-bu-tion", "retribution")
  debug_assert(d.hyphenate("table", "-") == "ta-ble", "table")
}

test "case folding preserves original casing" {
  let d = Dictionary::en_us()
  debug_assert(d.hyphenate("HYPHENATION", "-") == "HY-PHEN-ATION", "uppercase hyphenation")
  debug_assert(d.hyphenate("Algorithm", "-") == "Al-go-rithm", "titlecase algorithm")
  debug_assert(d.hyphenate("TABLE", "-") == "TA-BLE", "uppercase exception table")
  debug_assert(d.hyphenate("Present", "-") == "Present", "titlecase no-break exception")
  debug_assert(d.hyphenate("InTeRnAtIoNaLiZaTiOn", "-") == "In-TeR-nA-tIoN-aL-iZa-TiOn", "mixed case")
}

test "split_word and hyphenate helpers" {
  let d = Dictionary::en_us()
  assert_str_array_eq(d.split_word("hyphenation"), ["hy", "phen", "ation"], "split hyphenation")
  assert_str_array_eq(d.split_word("algorithm"), ["al", "go", "rithm"], "split algorithm")
  assert_str_array_eq(d.split_word("cat"), ["cat"], "split short word")
  assert_str_array_eq(d.split_word(""), [], "split empty word")
  debug_assert(d.hyphenate("algorithm", "\u{00AD}") == "al\u{00AD}go\u{00AD}rithm", "soft hyphen")
  debug_assert(d.hyphenate("cat", "-") == "cat", "no-break word unchanged")
}

test "opportunities_into reuses buffer cleanly" {
  let d = Dictionary::en_us()
  let buf : Array[Int] = [99, 100, 101]
  d.opportunities_into("algorithm", buf)
  assert_int_array_eq(buf, [2, 4], "first reuse")
  d.opportunities_into("cat", buf)
  assert_int_array_eq(buf, [], "cleared on no breaks")
  d.opportunities_into("table", buf)
  assert_int_array_eq(buf, [2], "exception into reused buffer")
}

test "punctuated and hyphenated compound words" {
  let d = Dictionary::en_us()
  debug_assert(d.hyphenate("(algorithm),", "-") == "(al-go-rithm),", "wrapped punctuation")
  debug_assert(d.hyphenate("\"hyphenation\"!", "-") == "\"hy-phen-ation\"!", "quoted punctuation")
  debug_assert(d.hyphenate("super-computer", "|") == "su|per-com|puter", "hyphenated compound")
  debug_assert(d.hyphenate("well-known", "|") == "well-known", "short hyphenated compound")
  debug_assert(d.hyphenate("re-representation", "|") == "re-rep|re|sen|ta|tion", "prefix hyphenated compound")
  debug_assert(d.hyphenate("abc123def", "-") == "abc123def", "alphanumeric token not hyphenated")
  debug_assert(d.hyphenate("v1.2.3", "-") == "v1.2.3", "version string not hyphenated")
}

test "hyphenate_text preserves whitespace punctuation and numbers" {
  let d = Dictionary::en_us()
  let input = "Typography, algorithm-based 2026: extraordinary & table!"
  let expected = "Ty-pog-ra-phy, al-go-rithm-based 2026: ex-tra-or-di-nary & ta-ble!"
  debug_assert(d.hyphenate_text(input, "-") == expected, "hyphenate_text mismatch: got " + d.hyphenate_text(input, "-"))
  debug_assert(d.hyphenate_text("", "-") == "", "empty text")
  debug_assert(d.hyphenate_text("   ... 123 !", "-") == "   ... 123 !", "punctuation only text")
}

test "custom TeX dictionary left_min and right_min" {
  let pats = "a1b b2c c3d .a1b1c1d1e."
  let d11 = match Dictionary::from_tex(pats, "", 1, 1) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "from_tex failed: " + e.message)
      return
    }
  }
  // pattern .a1b1c1d1e. gives 1 at pos 1,2,3,4; b2c overrides pos 2 to 2 (even=no break); c3d overrides pos 3 to 3 (odd=break)
  // positions: 1(1), 2(2), 3(3), 4(1) -> breaks at 1, 3, 4
  assert_int_array_eq(d11.opportunities("abcde"), [1, 3, 4], "left_min=1 right_min=1")

  let d22 = match Dictionary::from_tex(pats, "", 2, 2) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "from_tex failed: " + e.message)
      return
    }
  }
  assert_int_array_eq(d22.opportunities("abcde"), [3], "left_min=2 right_min=2")

  let d_exc = match Dictionary::from_tex(pats, "ab-cde rec-i-proc-i-ty", 2, 3) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "from_tex with exception failed: " + e.message)
      return
    }
  }
  assert_int_array_eq(d_exc.opportunities("abcde"), [2], "custom exception overrides pattern")
  // rec-i-proc-i-ty with right_min=3 filters out break before final 2-char "ty"
  assert_int_array_eq(d_exc.opportunities("reciprocity"), [3, 4, 8], "exception respects right_min")
}

test "unicode and multi-byte UTF-8 safety" {
  let d = Dictionary::en_us()
  // Non-ASCII words must never split inside multi-byte UTF-8 sequences
  assert_int_array_eq(d.opportunities("中文测试断字"), [], "CJK word safe")
  assert_int_array_eq(d.opportunities("café"), [], "short accented word")
  debug_assert(
    d.hyphenate_text("中文 typography 算法 algorithm！", "-") == "中文 ty-pog-ra-phy 算法 al-go-rithm！",
    "mixed CJK and English text",
  )

  // Custom dictionary with multi-byte UTF-8 patterns (e.g. German umlaut: ä = 2 bytes, ö = 2 bytes)
  // Word "überall": ü(2 bytes) b(1) e(1) r(1) a(1) l(1) l(1) => total 8 bytes, 7 chars
  // Pattern "be1ra" breaks between e (byte 4) and r (byte 4) -> byte offset 4 ("übe" = 4 bytes, "rall" = 4 bytes)
  let de = match Dictionary::from_tex("ü1be be1ra", "", 2, 2) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "UTF-8 pattern load failed: " + e.message)
      return
    }
  }
  // ü1be has break after ü (char index 1 < left_min 2, filtered out); be1ra has break at char index 3 (byte offset 4)
  assert_int_array_eq(de.opportunities("überall"), [4], "UTF-8 byte offset respects char left_min")
  debug_assert(de.hyphenate("überall", "-") == "übe-rall", "UTF-8 hyphenate")
  assert_str_array_eq(de.split_word("überall"), ["übe", "rall"], "UTF-8 split_word")
}

test "validation and DoS Limits enforcement" {
  expect_err_kind(
    Dictionary::from_tex("a1b", "", 0, 2),
    HyphErrorKind::InvalidMinima,
    "left_min == 0",
  )
  expect_err_kind(
    Dictionary::from_tex("a1b", "", 2, 0),
    HyphErrorKind::InvalidMinima,
    "right_min == 0",
  )
  expect_err_kind(
    Dictionary::from_tex("123", "", 2, 2),
    HyphErrorKind::InvalidPattern,
    "digits only pattern",
  )
  expect_err_kind(
    Dictionary::from_tex("a12b", "", 2, 2),
    HyphErrorKind::InvalidPattern,
    "consecutive digits in pattern",
  )
  expect_err_kind(
    Dictionary::from_tex("a.b", "", 2, 2),
    HyphErrorKind::InvalidPattern,
    "interior dot in pattern",
  )
  expect_err_kind(
    Dictionary::from_tex("a1b", "-abc", 2, 2),
    HyphErrorKind::InvalidException,
    "leading hyphen in exception",
  )
  expect_err_kind(
    Dictionary::from_tex("a1b", "abc-", 2, 2),
    HyphErrorKind::InvalidException,
    "trailing hyphen in exception",
  )
  expect_err_kind(
    Dictionary::from_tex("a1b", "ab--cd", 2, 2),
    HyphErrorKind::InvalidException,
    "double hyphen in exception",
  )

  let tiny_input = Limits::{
    max_input_bytes: 5,
    max_patterns: 100,
    max_exceptions: 100,
    max_pattern_len: 64,
    max_exception_len: 64,
    max_trie_nodes: 1000,
  }
  expect_err_kind(
    Dictionary::from_tex_with_limits("a1b c1d e1f", "", 2, 2, tiny_input),
    HyphErrorKind::InputTooLarge,
    "max_input_bytes exceeded",
  )

  let tiny_pats = Limits::{
    max_input_bytes: 1024,
    max_patterns: 2,
    max_exceptions: 100,
    max_pattern_len: 64,
    max_exception_len: 64,
    max_trie_nodes: 1000,
  }
  expect_err_kind(
    Dictionary::from_tex_with_limits("a1b c1d e1f", "", 2, 2, tiny_pats),
    HyphErrorKind::TooManyPatterns,
    "max_patterns exceeded",
  )

  let tiny_excs = Limits::{
    max_input_bytes: 1024,
    max_patterns: 100,
    max_exceptions: 1,
    max_pattern_len: 64,
    max_exception_len: 64,
    max_trie_nodes: 1000,
  }
  expect_err_kind(
    Dictionary::from_tex_with_limits("a1b", "ta-ble pro-ject", 2, 2, tiny_excs),
    HyphErrorKind::TooManyExceptions,
    "max_exceptions exceeded",
  )

  let tiny_plen = Limits::{
    max_input_bytes: 1024,
    max_patterns: 100,
    max_exceptions: 100,
    max_pattern_len: 4,
    max_exception_len: 64,
    max_trie_nodes: 1000,
  }
  expect_err_kind(
    Dictionary::from_tex_with_limits("a1b2c3d", "", 2, 2, tiny_plen),
    HyphErrorKind::PatternTooLong,
    "max_pattern_len exceeded",
  )

  let tiny_elen = Limits::{
    max_input_bytes: 1024,
    max_patterns: 100,
    max_exceptions: 100,
    max_pattern_len: 64,
    max_exception_len: 4,
    max_trie_nodes: 1000,
  }
  expect_err_kind(
    Dictionary::from_tex_with_limits("a1b", "ta-ble", 2, 2, tiny_elen),
    HyphErrorKind::ExceptionTooLong,
    "max_exception_len exceeded",
  )

  let tiny_nodes = Limits::{
    max_input_bytes: 1024,
    max_patterns: 100,
    max_exceptions: 100,
    max_pattern_len: 64,
    max_exception_len: 64,
    max_trie_nodes: 3,
  }
  expect_err_kind(
    Dictionary::from_tex_with_limits("a1b2c3d4e", "", 2, 2, tiny_nodes),
    HyphErrorKind::TooManyTrieNodes,
    "max_trie_nodes exceeded",
  )
}
