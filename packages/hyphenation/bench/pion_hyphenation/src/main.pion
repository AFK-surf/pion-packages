///| Head-to-head Hyphenation benchmark (Pion Native).

import "hyphenation"

fn parse_pos_int(s : String, fallback : Int) -> Int {
  if s.length() == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  if acc <= 0 {
    fallback
  } else {
    acc
  }
}

fn run_words(
  world : World,
  words_file : String,
  pats_file : String,
  excs_file : String,
  iters : Int,
) -> Int {
  let raw = match fs_read(world, words_file) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read words file")
      return 1
    }
  }
  let pats = match fs_read(world, pats_file) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read patterns file")
      return 1
    }
  }
  let excs = match fs_read(world, excs_file) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read exceptions file")
      return 1
    }
  }
  let lines = raw.split("\n")
  let words : Array[String] = Array::new()
  let mut i = 0
  while i < lines.length() {
    if lines[i].length() > 0 {
      words.push(lines[i])
    }
    i = i + 1
  }

  let dict = match hyphenation::Dictionary::from_tex(pats, excs, 2, 3) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "error: from_tex failed: " + e.message)
      return 1
    }
  }
  let buf : Array[Int] = Array::new()
  let mut hyphenated_words : Int64 = 0L
  let mut total_breaks : Int64 = 0L
  let mut checksum : Int64 = 0L

  let nw = words.length()
  let mut it = 0
  while it < iters {
    let mut wi = 0
    while wi < nw {
      dict.opportunities_into(words[wi], buf)
      let nb = buf.length()
      if nb > 0 {
        hyphenated_words = hyphenated_words + 1L
        total_breaks = total_breaks + nb.to_int64()
        let mut bi = 0
        while bi < nb {
          checksum = (checksum * 131L + (buf[bi] + 1).to_int64()) % 1000000007L
          bi = bi + 1
        }
      }
      wi = wi + 1
    }
    it = it + 1
  }

  io_println(world, "words=" + nw.to_string())
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "hyphenated_words=" + hyphenated_words.to_string())
  io_println(world, "total_breaks=" + total_breaks.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

fn run_load(world : World, pats_file : String, excs_file : String, iters : Int) -> Int {
  let pats = match fs_read(world, pats_file) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read patterns file")
      return 1
    }
  }
  let excs = match fs_read(world, excs_file) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read exceptions file")
      return 1
    }
  }

  let probes = [
    "hyphenation",
    "internationalization",
    "associate",
    "present",
    "typography",
    "algorithm",
  ]
  let buf : Array[Int] = Array::new()
  let mut total_breaks : Int64 = 0L
  let mut checksum : Int64 = 0L

  let mut it = 0
  while it < iters {
    let d = match hyphenation::Dictionary::from_tex(pats, excs, 2, 3) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "error: from_tex failed: " + e.message)
        return 1
      }
    }
    let mut pi = 0
    while pi < probes.length() {
      d.opportunities_into(probes[pi], buf)
      let nb = buf.length()
      total_breaks = total_breaks + nb.to_int64()
      let mut bi = 0
      while bi < nb {
        checksum = (checksum * 131L + (buf[bi] + 1).to_int64()) % 1000000007L
        bi = bi + 1
      }
      pi = pi + 1
    }
    it = it + 1
  }

  io_println(world, "loads=" + iters.to_string())
  io_println(world, "total_breaks=" + total_breaks.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_hyphenation <words|load> ...")
    return 1
  }
  let mode = args[1]
  if mode == "words" {
    let words_file = if args.length() > 2 { args[2] } else { "/tmp/pion-hyphenation-bench/words_100k.txt" }
    let pats_file = if args.length() > 3 { args[3] } else { "/tmp/pion-hyphenation-bench/hyph-en-us.pat.txt" }
    let excs_file = if args.length() > 4 { args[4] } else { "/tmp/pion-hyphenation-bench/hyph-en-us.hyp.txt" }
    let iters = if args.length() > 5 { parse_pos_int(args[5], 10) } else { 10 }
    return run_words(world, words_file, pats_file, excs_file, iters)
  }
  if mode == "load" {
    let pats_file = if args.length() > 2 { args[2] } else { "/tmp/pion-hyphenation-bench/hyph-en-us.pat.txt" }
    let excs_file = if args.length() > 3 { args[3] } else { "/tmp/pion-hyphenation-bench/hyph-en-us.hyp.txt" }
    let iters = if args.length() > 4 { parse_pos_int(args[4], 20) } else { 20 }
    return run_load(world, pats_file, excs_file, iters)
  }
  io_println(world, "error: unknown mode " + mode)
  1
}
