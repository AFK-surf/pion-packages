///| Red-team CLI for `packages/dash` (native + wasm32, see ../REPORT.md).
///|   dump <file>   -> one block per corpus line `<name>\t<hex>`: `=<name>` then the canonical dump (src/dump.pion)
///|   fmt <file>    -> one block per corpus line: `=<name>` then the hex of format_mpd(parse(doc)) or `-`
///|   bomb <file> [max_xml_depth] -> parse the whole file once, resolve every Representation, one-line summary
///|   time <file> <iters> -> bomb <iters> times, print `<us> <fnv>`
///|   api <file>    -> public-API vector sweep (src/api.pion)
///|   list | case <name> -> red-team / control cases (src/cases.pion)

import "dash"

///|
pub fn split_lines(data : String) -> Array[String] {
  let out : Array[String] = []
  let n = data.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if data.code_unit_at(i) == 10 {
      out.push(data.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(data.slice(start, n))
  }
  out
}

///|
fn for_cases(text : String, f : (String) -> String) -> String {
  let lines = split_lines(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    let mut t = 0
    while t < l.length() && l.code_unit_at(t) != 9 {
      t = t + 1
    }
    if t < l.length() {
      sb.write_string("=" + l.slice(0, t) + "\n")
      sb.write_string(f(unhex(l.slice(t + 1, l.length()))))
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn fmt_hex(doc : String) -> String {
  match dash::parse(doc) {
    Err(_) => "-\n"
    Ok(m) =>
    match dash::format_mpd(m) {
      Err(e) => "FMTERR " + err_kind(e) + "\n"
      Ok(t) => tohex(t) + "\n"
    }
  }
}

///| One-line summary of a parse + full resolution (sizes of everything retained), used for DoS bombs.
pub fn bomb_summary(text : String, depth : Int) -> String {
  let lim = if depth > 0 {
    dash::DashLimits::{ ..dash::DashLimits::default(), max_xml_depth: depth, max_elements: 100000000 }
  } else {
    dash::DashLimits::default()
  }
  match dash::parse_with_limits(text, lim) {
    Err(e) => "ERR " + err_kind(e)
    Ok(m) => {
      let mut reps = 0
      let mut segs = 0L
      let mut bytes = 0L
      let mut errs = 0
      let mut pi = 0
      while pi < m.periods.length() {
        let p = m.periods[pi]
        let mut ai = 0
        while ai < p.adaptation_sets.length() {
          let mut ri = 0
          while ri < p.adaptation_sets[ai].representations.length() {
            reps = reps + 1
            match dash::resolve_segments(m, pi, ai, ri, dash::DashLimits::default()) {
              Err(_) => errs = errs + 1
              Ok(t) => {
                let mut k = 0
                while k < t.segments.length() {
                  bytes = bytes + t.segments[k].url.length().to_int64()
                  k = k + 1
                }
                segs = segs + t.segments.length().to_int64()
              }
            }
            ri = ri + 1
          }
          ai = ai + 1
        }
        pi = pi + 1
      }
      let fl = match dash::format_mpd(m) {
        Ok(t) => t.length().to_string()
        Err(e) => err_kind(e)
      }
      "OK periods=" + m.periods.length().to_string() + " reps=" + reps.to_string() + " segments=" + segs.to_string() +
      " url_bytes=" + bytes.to_string() + " resolve_errors=" + errs.to_string() + " format=" + fl
    }
  }
}

///|
pub fn fnv(h : UInt64, s : String) -> UInt64 {
  let mut x = h
  let mut i = 0
  while i < s.length() {
    x = (x ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  x
}

///|
fn parse_uint(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  v
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: dash_audit dump|fmt|bomb|api <file> | time <file> <iters> | list | case <name>")
    return 2
  }
  let mode = args[1]
  if (mode == "dump" || mode == "fmt" || mode == "bomb" || mode == "time") && args.length() >= 3 {
    let text = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => {
        io_eprintln(world, "cannot read " + args[2])
        return 2
      }
    }
    if mode == "dump" {
      io_print(world, for_cases(text, dump_case))
    } else if mode == "fmt" {
      io_print(world, for_cases(text, fmt_hex))
    } else if mode == "bomb" {
      let depth = if args.length() >= 4 { parse_uint(args[3]) } else { 0 }
      io_println(world, bomb_summary(text, depth))
    } else {
      let iters = if args.length() >= 4 { parse_uint(args[3]) } else { 1 }
      let t0 = clock_monotonic_us()
      let mut h = 14695981039346656037UL
      let mut k = 0
      while k < iters {
        h = fnv(h, bomb_summary(text, 0))
        k = k + 1
      }
      let t1 = clock_monotonic_us()
      io_println(world, (t1 - t0).to_string() + " " + h.to_string())
    }
    return 0
  }
  if mode == "api" && args.length() >= 3 {
    match fs_read_bytes(world, args[2]) {
      Ok(b) => io_print(world, run_api(b.to_string()))
      Err(_) => return 2
    }
    return 0
  }
  if mode == "list" {
    io_println(world, case_names().join(" "))
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = run_case(args[2])
    io_println(world, (if r == "" { "PASS " } else { "FAIL " }) + args[2] + (if r == "" { "" } else { " :: " + r }))
    return 0
  }
  io_println(world, "bad arguments")
  2
}
