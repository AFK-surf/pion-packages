///| Canonical, field-complete dump of the `packages/dash` data model (one record per line).
///| The same format is produced by the independent Python reference model (../diff/model.py),
///| so the two outputs can be compared byte-for-byte. See ../REPORT.md, "Canonical dump".
///|
///| Strings are written as `"` + esc(s); `None` is `-`. esc() writes bytes outside 0x21..0x7E and
///| `% | \ " ,` as %XX, so every output line is printable ASCII.

import "dash"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode a hex string into a byte string.
pub fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < s.length() {
    sb.write_byte(((hexval(s.code_unit_at(i)) << 4) | hexval(s.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
fn hexdigit(v : Int) -> Int {
  if v < 10 {
    48 + v
  } else {
    55 + v
  }
}

///| Hex-encode a byte string (uppercase).
pub fn tohex(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i) & 255
    sb.write_byte(hexdigit(c >> 4).to_byte())
    sb.write_byte(hexdigit(c & 15).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Escape a string so that the output is printable ASCII without `| % \ " ,`.
pub fn esc(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    if c > 32 && c < 127 && c != 37 && c != 124 && c != 92 && c != 34 && c != 44 {
      sb.write_byte(c.to_byte())
    } else {
      sb.write_byte(37.to_byte())
      sb.write_byte(hexdigit(c >> 4).to_byte())
      sb.write_byte(hexdigit(c & 15).to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn qs(s : String) -> String {
  "\"" + esc(s)
}

///|
pub fn os(o : Option[String]) -> String {
  match o {
    Some(s) => qs(s)
    None => "-"
  }
}

///|
pub fn oi(o : Option[Int64]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "-"
  }
}

///|
pub fn ob(o : Option[Bool]) -> String {
  match o {
    Some(true) => "1"
    Some(false) => "0"
    None => "-"
  }
}

///|
pub fn orat(o : Option[dash::Rational]) -> String {
  match o {
    Some(r) => r.num.to_string() + "/" + r.den.to_string()
    None => "-"
  }
}

///| Error variant name (messages are implementation detail and are not compared).
pub fn err_kind(e : dash::DashError) -> String {
  let s = dash::dash_error_to_string(e)
  let mut i = 0
  while i < s.length() && s.code_unit_at(i) != 58 {
    i = i + 1
  }
  s.slice(0, i)
}

///|
fn ct_s(o : Option[dash::ContentType]) -> String {
  match o {
    Some(c) => qs(dash::content_type_to_string(c))
    None => "-"
  }
}

///|
fn w_desc(sb : StringBuilder, tag : String, ds : Array[dash::Descriptor]) -> Unit {
  let mut i = 0
  while i < ds.length() {
    let d = ds[i]
    sb.write_string(tag + "|" + qs(d.scheme_id_uri) + "|" + os(d.value) + "|" + os(d.id) + "\n")
    i = i + 1
  }
}

///|
fn w_bu(sb : StringBuilder, tag : String, us : Array[String]) -> Unit {
  let mut i = 0
  while i < us.length() {
    sb.write_string(tag + "|" + qs(us[i]) + "\n")
    i = i + 1
  }
}

///|
fn w_cp(sb : StringBuilder, cps : Array[dash::ContentProtection]) -> Unit {
  let mut i = 0
  while i < cps.length() {
    let c = cps[i]
    sb.write_string(
      "CP|" + qs(c.scheme_id_uri) + "|" + os(c.value) + "|" + os(c.default_kid) + "|" + c.pssh.length().to_string() +
      "\n",
    )
    let mut k = 0
    while k < c.pssh.length() {
      sb.write_string("PSSH|" + qs(c.pssh[k]) + "\n")
      k = k + 1
    }
    k = 0
    while k < c.pro.length() {
      sb.write_string("PRO|" + qs(c.pro[k]) + "\n")
      k = k + 1
    }
    i = i + 1
  }
}

///|
fn w_segs(
  sb : StringBuilder,
  b : Option[dash::SegmentBase],
  l : Option[dash::SegmentList],
  t : Option[dash::SegmentTemplate],
) -> Unit {
  match b {
    Some(x) =>
    sb.write_string(
      "SB|" + oi(x.timescale) + "|" + oi(x.presentation_time_offset) + "|" + os(x.index_range) + "|" +
      ob(x.index_range_exact) + "|" + os(x.initialization_source_url) + "|" + os(x.initialization_range) + "\n",
    )
    None => ()
  }
  match l {
    Some(x) => {
      sb.write_string(
        "LIST|" + oi(x.timescale) + "|" + oi(x.duration) + "|" + oi(x.start_number) + "|" +
        oi(x.presentation_time_offset) + "|" + os(x.initialization_source_url) + "|" + os(x.initialization_range) + "|" +
        x.segment_urls.length().to_string() + "\n",
      )
      let mut i = 0
      while i < x.segment_urls.length() {
        let u = x.segment_urls[i]
        sb.write_string("SU|" + os(u.media) + "|" + os(u.media_range) + "|" + os(u.index) + "|" + os(u.index_range) + "\n")
        i = i + 1
      }
    }
    None => ()
  }
  match t {
    Some(x) => {
      sb.write_string(
        "TPL|" + oi(x.timescale) + "|" + oi(x.duration) + "|" + oi(x.start_number) + "|" +
        oi(x.presentation_time_offset) + "|" + os(x.initialization) + "|" + os(x.media) + "|" +
        x.timeline.length().to_string() + "\n",
      )
      let mut i = 0
      while i < x.timeline.length() {
        let e = x.timeline[i]
        sb.write_string("S|" + oi(e.t) + "|" + e.d.to_string() + "|" + e.r.to_string() + "\n")
        i = i + 1
      }
    }
    None => ()
  }
}

///| Structure only (no resolution): used for the format round-trip comparison too.
pub fn dump_structure(m : dash::Mpd) -> String {
  let sb = StringBuilder::new()
  sb.write_string(
    "MPD|" + os(m.id) + "|" + dash::mpd_type_to_string(m.mpd_type) + "|" + qs(m.profiles) + "|" +
    oi(m.media_presentation_duration_us) + "|" + oi(m.min_buffer_time_us) + "|" + oi(m.minimum_update_period_us) + "|" +
    os(m.availability_start_time) + "|" + oi(m.availability_start_time_us) + "|" + os(m.publish_time) + "|" +
    oi(m.publish_time_us) + "|" + oi(m.time_shift_buffer_depth_us) + "|" + oi(m.suggested_presentation_delay_us) + "|" +
    oi(m.max_segment_duration_us) + "\n",
  )
  w_bu(sb, "BU", m.base_urls)
  w_bu(sb, "LOC", m.locations)
  w_desc(sb, "UTC", m.utc_timings)
  let mut pi = 0
  while pi < m.periods.length() {
    let p = m.periods[pi]
    sb.write_string(
      "P|" + pi.to_string() + "|" + os(p.id) + "|" + oi(p.start_us) + "|" + oi(p.duration_us) + "|" +
      ob(p.bitstream_switching) + "\n",
    )
    w_bu(sb, "BU", p.base_urls)
    w_segs(sb, p.segment_base, p.segment_list, p.segment_template)
    let mut ai = 0
    while ai < p.adaptation_sets.length() {
      let a = p.adaptation_sets[ai]
      sb.write_string(
        "A|" + pi.to_string() + "." + ai.to_string() + "|" + os(a.id) + "|" + oi(a.group) + "|" + ct_s(a.content_type) +
        "|" + os(a.mime_type) + "|" + os(a.codecs) + "|" + os(a.lang) + "|" + ob(a.segment_alignment) + "|" +
        ob(a.subsegment_alignment) + "|" + ob(a.bitstream_switching) + "|" + oi(a.min_bandwidth) + "|" +
        oi(a.max_bandwidth) + "|" + oi(a.min_width) + "|" + oi(a.max_width) + "|" + oi(a.min_height) + "|" +
        oi(a.max_height) + "|" + os(a.par) + "|" + orat(a.frame_rate) + "|" + os(a.sar) + "|" +
        os(a.audio_sampling_rate) + "|" + oi(a.start_with_sap) + "\n",
      )
      w_bu(sb, "BU", a.base_urls)
      w_desc(sb, "ROLE", a.roles)
      w_cp(sb, a.content_protections)
      w_desc(sb, "ACC", a.accessibilities)
      w_desc(sb, "ACH", a.audio_channel_configurations)
      w_desc(sb, "SUPP", a.supplemental_properties)
      w_desc(sb, "ESS", a.essential_properties)
      w_segs(sb, a.segment_base, a.segment_list, a.segment_template)
      let mut ri = 0
      while ri < a.representations.length() {
        let r = a.representations[ri]
        sb.write_string(
          "R|" + pi.to_string() + "." + ai.to_string() + "." + ri.to_string() + "|" + qs(r.id) + "|" +
          r.bandwidth.to_string() + "|" + oi(r.width) + "|" + oi(r.height) + "|" + orat(r.frame_rate) + "|" + os(r.sar) +
          "|" + os(r.codecs) + "|" + os(r.mime_type) + "|" + os(r.audio_sampling_rate) + "|" + oi(r.start_with_sap) +
          "\n",
        )
        w_bu(sb, "BU", r.base_urls)
        w_cp(sb, r.content_protections)
        w_desc(sb, "ACH", r.audio_channel_configurations)
        w_segs(sb, r.segment_base, r.segment_list, r.segment_template)
        ri = ri + 1
      }
      ai = ai + 1
    }
    pi = pi + 1
  }
  sb.to_string()
}

///|
fn seg_line(s : dash::ResolvedSegment) -> String {
  "SEG|" + s.number.to_string() + "|" + qs(s.url) + "|" + s.start_time.to_string() + "|" + s.duration.to_string() + "|" +
  s.timescale.to_string() + "|" + os(s.media_range) + "\n"
}

///| Resolved tracks of every Representation (first 6 and last 3 segments of each).
pub fn dump_tracks(m : dash::Mpd, limits : dash::DashLimits) -> String {
  let sb = StringBuilder::new()
  let mut pi = 0
  while pi < m.periods.length() {
    let p = m.periods[pi]
    let mut ai = 0
    while ai < p.adaptation_sets.length() {
      let a = p.adaptation_sets[ai]
      let mut ri = 0
      while ri < a.representations.length() {
        let tag = "TRK|" + pi.to_string() + "." + ai.to_string() + "." + ri.to_string() + "|"
        match dash::resolve_segments(m, pi, ai, ri, limits) {
          Err(e) => sb.write_string(tag + "ERR " + err_kind(e) + "\n")
          Ok(t) => {
            let n = t.segments.length()
            sb.write_string(
              tag + os(t.initialization_url) + "|" + os(t.initialization_range) + "|" + os(t.index_range) + "|" +
              n.to_string() + "\n",
            )
            let mut k = 0
            while k < n {
              if k < 6 || k >= n - 3 {
                sb.write_string(seg_line(t.segments[k]))
              }
              k = k + 1
            }
          }
        }
        ri = ri + 1
      }
      ai = ai + 1
    }
    pi = pi + 1
  }
  sb.to_string()
}

///|
pub fn abr_budgets() -> Array[Int64] {
  [-1L, 0L, 500000L, 1000000L, 3000000L, 1000000000000000000L]
}

///|
pub fn abr_prefs() -> Array[Array[String]] {
  [[], ["avc1"], ["av01", "avc1"], ["mp4a"], ["hvc1", "hev1"], ["AVC1"]]
}

///| ABR selection for every AdaptationSet over a fixed grid of budgets x codec preferences.
pub fn dump_abr(m : dash::Mpd) -> String {
  let sb = StringBuilder::new()
  let budgets = abr_budgets()
  let prefs = abr_prefs()
  let mut pi = 0
  while pi < m.periods.length() {
    let p = m.periods[pi]
    let mut ai = 0
    while ai < p.adaptation_sets.length() {
      let parts : Array[String] = []
      let mut q = 0
      while q < prefs.length() {
        let mut b = 0
        while b < budgets.length() {
          match dash::select_representation(p.adaptation_sets[ai], budgets[b], prefs[q]) {
            Some(i) => parts.push(i.to_string())
            None => parts.push("-")
          }
          b = b + 1
        }
        q = q + 1
      }
      sb.write_string("ABR|" + pi.to_string() + "." + ai.to_string() + "|" + parts.join(",") + "\n")
      ai = ai + 1
    }
    pi = pi + 1
  }
  sb.to_string()
}

///| format_mpd -> parse round trip status.
pub fn fmt_status(m : dash::Mpd) -> String {
  match dash::format_mpd(m) {
    Err(e) => "FMT|FMTERR " + err_kind(e) + "\n"
    Ok(t) =>
    match dash::parse(t) {
      Err(e) => "FMT|REPARSE " + err_kind(e) + "\n"
      Ok(m2) => {
        let a = dump_structure(m)
        let b = dump_structure(m2)
        if a == b {
          "FMT|SAME\n"
        } else {
          "FMT|DIFF\n"
        }
      }
    }
  }
}

///| Full dump of one input document.
pub fn dump_case(text : String) -> String {
  match dash::parse(text) {
    Err(e) => "ERR " + err_kind(e) + "\n"
    Ok(m) => dump_structure(m) + dump_tracks(m, dash::DashLimits::default()) + dump_abr(m) + fmt_status(m)
  }
}
