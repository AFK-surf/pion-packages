///| Public-API sweep driven by a vector file (../diff/gen.py writes it, ../diff/model.py predicts it).
///| One vector per line, fields separated by TAB, strings hex-encoded:
///|   DUR <s> | DT <s> | RAT <s> | FDUR <int> | URL <base> <rel> | TPL <template> <rep_id> <number> <bandwidth> <time>

import "dash"

///|
fn split_tabs(l : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < l.length() {
    if l.code_unit_at(i) == 9 {
      out.push(l.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(l.slice(start, l.length()))
  out
}

///|
fn parse_i64(s : String) -> Int64 {
  let mut neg = false
  let mut i = 0
  if s.length() > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  let mut v = 0L
  while i < s.length() {
    v = v * 10L - (s.code_unit_at(i) - 48).to_int64()
    i = i + 1
  }
  if neg {
    v
  } else {
    0L - v
  }
}

///|
fn res_i64(r : Result[Int64, dash::DashError]) -> String {
  match r {
    Ok(v) => v.to_string()
    Err(e) => "ERR " + err_kind(e)
  }
}

///|
pub fn api_line(l : String) -> String {
  let f = split_tabs(l)
  let k = f[0]
  if k == "DUR" && f.length() >= 2 {
    let s = unhex(f[1])
    "DUR|" + qs(s) + "|" + res_i64(dash::parse_iso8601_duration_us(s)) + "\n"
  } else if k == "DT" && f.length() >= 2 {
    let s = unhex(f[1])
    "DT|" + qs(s) + "|" + res_i64(dash::parse_iso8601_datetime_us(s)) + "\n"
  } else if k == "RAT" && f.length() >= 2 {
    let s = unhex(f[1])
    let r = match dash::parse_rational(s) {
      Ok(x) => x.num.to_string() + "/" + x.den.to_string() + " " + dash::format_rational(x)
      Err(e) => "ERR " + err_kind(e)
    }
    "RAT|" + qs(s) + "|" + r + "\n"
  } else if k == "FDUR" && f.length() >= 2 {
    let v = parse_i64(f[1])
    let s = dash::format_iso8601_duration_us(v)
    "FDUR|" + v.to_string() + "|" + s + "|" + res_i64(dash::parse_iso8601_duration_us(s)) + "\n"
  } else if k == "URL" && f.length() >= 3 {
    let b = unhex(f[1])
    let r = unhex(f[2])
    "URL|" + qs(b) + "|" + qs(r) + "|" + qs(dash::resolve_url(b, r)) + "\n"
  } else if k == "TPL" && f.length() >= 6 {
    let t = unhex(f[1])
    let id = unhex(f[2])
    let r = match dash::expand_template(t, id, parse_i64(f[3]), parse_i64(f[4]), parse_i64(f[5])) {
      Ok(s) => qs(s)
      Err(e) => "ERR " + err_kind(e)
    }
    "TPL|" + qs(t) + "|" + qs(id) + "|" + f[3] + "|" + f[4] + "|" + f[5] + "|" + r + "\n"
  } else {
    "?\n"
  }
}

///|
pub fn run_api(text : String) -> String {
  let lines = split_lines(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    if lines[i].length() > 0 {
      sb.write_string(api_line(lines[i]))
    }
    i = i + 1
  }
  sb.to_string()
}
