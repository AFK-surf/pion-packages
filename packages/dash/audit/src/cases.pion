///| Red-team (`redteam_p<sev>_<n>_*`) and control (`control_*`) cases. Each returns "" on PASS, else the reason.
///|
///| Red-team cases assert the conforming behaviour and FAIL while the finding of the same id in REPORT.md is open.
///| They test behaviour only through the public API, accept every reasonable fix (reject the input, or produce a
///| correct value), and build values with record-update syntax from parsed documents, so a fix that adds fields
///| to the public types does not break them. Control cases must PASS before and after any fix; the bug-injection
///| gate of run_audit.sh relies on them.

import "dash"
import "url"

///|
fn rep(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn index_of(hay : String, needle : String) -> Int {
  let n = hay.length()
  let m = needle.length()
  let mut i = 0
  while i + m <= n {
    let mut k = 0
    while k < m && hay.code_unit_at(i + k) == needle.code_unit_at(k) {
      k = k + 1
    }
    if k == m {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn contains(hay : String, needle : String) -> Bool {
  index_of(hay, needle) >= 0
}

///|
fn short(s : String) -> String {
  esc(if s.length() > 80 { s.slice(0, 80) } else { s })
}

///|
fn mpd_of(src : String) -> Option[dash::Mpd] {
  match dash::parse(src) {
    Ok(m) => Some(m)
    Err(_) => None
  }
}

///|
fn kind_of(src : String) -> String {
  match dash::parse(src) {
    Ok(_) => "OK"
    Err(e) => err_kind(e)
  }
}

///| Static MPD with one Period (attributes `pattrs`) holding `body`.
fn doc(pattrs : String, body : String) -> String {
  "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" type=\"static\" mediaPresentationDuration=\"PT10S\"><Period" +
  pattrs +
  ">" +
  body +
  "</Period></MPD>"
}

///| One AdaptationSet with one Representation `v` (bandwidth 1000) containing `inner`.
fn as1(inner : String) -> String {
  "<AdaptationSet><Representation id=\"v\" bandwidth=\"1000\">" + inner + "</Representation></AdaptationSet>"
}

///|
fn track_of(src : String, pi : Int) -> Result[dash::ResolvedTrack, String] {
  match dash::parse(src) {
    Err(e) => Err("parse " + err_kind(e))
    Ok(m) =>
    match dash::resolve_segments(m, pi, 0, 0, dash::DashLimits::default()) {
      Err(e) => Err("resolve " + err_kind(e))
      Ok(t) => Ok(t)
    }
  }
}

///| Segment count of track (period pi, 0, 0), or -1 on error.
fn nsegs(src : String, pi : Int) -> Int {
  match track_of(src, pi) {
    Ok(t) => t.segments.length()
    Err(_) => -1
  }
}

///| WHATWG URL resolution (packages/url): independent oracle for RFC 3986 reference resolution.
fn wjoin(base : String, rel : String) -> String {
  match url::Url::parse(base) {
    Err(_) => "<bad base>"
    Ok(b) =>
    match b.join(rel) {
      Ok(u) => u.href()
      Err(_) => "<bad ref>"
    }
  }
}

///|
fn probe_url() -> String {
  "http://probe.invalid/a/b/c/d/manifest.mpd"
}

// ---------------------------------------------------------------- P0

///| P0-1: resolve_segments has no aggregate output budget: |BaseURL| x max_segments bytes are materialised.
fn p0_1() -> String {
  let base = "http://cdn.example/" + rep("a", 4000) + "/"
  let src = "<MPD type=\"static\" mediaPresentationDuration=\"PT10S\"><BaseURL>" +
  base +
  "</BaseURL><Period>" +
  as1("<SegmentTemplate media=\"$Number$\"><SegmentTimeline><S d=\"1\" r=\"99998\"/></SegmentTimeline></SegmentTemplate>") +
  "</Period></MPD>"
  match track_of(src, 0) {
    Err(_) => ""
    Ok(t) => {
      let mut bytes = 0L
      let mut i = 0
      while i < t.segments.length() {
        bytes = bytes + t.segments[i].url.length().to_int64()
        i = i + 1
      }
      if bytes > 268435456L {
        src.length().to_string() + " B MPD materialised " + bytes.to_string() + " B of segment URLs (" +
        t.segments.length().to_string() + " segments, no aggregate budget)"
      } else {
        ""
      }
    }
  }
}

// ---------------------------------------------------------------- P1

///| P1-1: resolve_url is not RFC 3986 §5.2 reference resolution (dot segments, empty segments, relative bases).
fn p1_1() -> String {
  let vectors : Array[(String, String)] = [
    ("http://h/a/b/c", ".."),
    ("http://h/a/b/", "."),
    ("http://h/a/b", "x//y"),
    ("http://h/a?q=1", "#f"),
    ("http://h/a/b", "http://g/x/../y"),
    ("../media/", "seg.m4s"),
    ("video/../../x/", "s.m4s"),
    ("http://h/a/b/c", "./"),
  ]
  let mut bad = ""
  let mut i = 0
  while i < vectors.length() {
    let (b, r) = vectors[i]
    let got = dash::resolve_url(b, r)
    // the composed reference, resolved against any document URL, must equal step-by-step resolution
    let want = wjoin(wjoin(probe_url(), b), r)
    let have = wjoin(probe_url(), got)
    if have != want {
      bad = bad + " resolve_url(" + esc(b) + "," + esc(r) + ")=" + esc(got) + " (-> " + esc(have) + ", want " + esc(want) + ")"
    }
    i = i + 1
  }
  // document level: a relative Period BaseURL with "../" (the MPD URL is not known to the parser)
  let src = doc(
    "",
    "<BaseURL>../media/</BaseURL>" + as1("<SegmentTemplate duration=\"5\" media=\"s$Number$.m4s\"/>"),
  )
  match track_of(src, 0) {
    Ok(t) =>
    if t.segments.length() > 0 {
      let have = wjoin(probe_url(), t.segments[0].url)
      let want = "http://probe.invalid/a/b/c/media/s1.m4s"
      if have != want {
        bad = bad + " segment URL " + esc(t.segments[0].url) + " resolves to " + esc(have) + " (want " + want + ")"
      }
    }
    Err(e) => bad = bad + " " + e
  }
  bad
}

///| P1-2: segment numbers wrap around Int64 (duration-based SegmentTemplate and SegmentList).
fn p1_2() -> String {
  let mut bad = ""
  let a = doc("", as1("<SegmentTemplate duration=\"5\" startNumber=\"9223372036854775807\" media=\"s$Number$\"/>"))
  match track_of(a, 0) {
    Ok(t) => {
      let mut i = 0
      while i < t.segments.length() {
        if t.segments[i].number < 0L {
          bad = bad + " template seg " + i.to_string() + " number=" + t.segments[i].number.to_string() + " url=" +
          t.segments[i].url
          break
        }
        i = i + 1
      }
    }
    Err(_) => ()
  }
  let b = doc(
    "",
    as1(
      "<SegmentList duration=\"5\" startNumber=\"9223372036854775807\"><SegmentURL media=\"a\"/><SegmentURL media=\"b\"/></SegmentList>",
    ),
  )
  match track_of(b, 0) {
    Ok(t) =>
    if t.segments.length() == 2 && t.segments[1].number < 0L {
      bad = bad + " SegmentList seg 1 number=" + t.segments[1].number.to_string()
    }
    Err(_) => ()
  }
  bad
}

///| P1-3: SegmentTimeline `r="-1"` ignores presentationTimeOffset when it repeats up to the Period end.
fn p1_3() -> String {
  let src = doc(
    "",
    as1(
      "<SegmentTemplate timescale=\"1\" presentationTimeOffset=\"1000\" media=\"s$Time$\"><SegmentTimeline><S t=\"1000\" d=\"2\" r=\"-1\"/></SegmentTimeline></SegmentTemplate>",
    ),
  )
  let n = nsegs(src, 0)
  // Period end in the timeline's time base = PTO + 10 s * timescale = 1010 -> t = 1000, 1002, ..., 1008
  if n == 5 {
    ""
  } else {
    "PTO=1000 S@t=1000 d=2 r=-1 in a 10 s Period: " + n.to_string() + " segments (want 5)"
  }
}

///| P1-4: max_xml_depth above a few thousand turns deep input into a native SIGSEGV / wasm32 stack overflow.
fn p1_4() -> String {
  let lim = dash::DashLimits::{ ..dash::DashLimits::default(), max_xml_depth: 1000000 }
  let n = 20000
  let src = "<MPD>" + rep("<a>", n) + rep("</a>", n) + "</MPD>"
  match dash::parse_with_limits(src, lim) {
    Ok(_) => ""
    Err(_) => ""
  }
}

// ---------------------------------------------------------------- P2

///| P2-1: Period@start is not inferred (first Period of a static MPD; previous start + duration).
fn p2_1() -> String {
  let tpl = as1("<SegmentTemplate duration=\"2\" media=\"s$Number$\"/>")
  let mut bad = ""
  let a = "<MPD type=\"static\" mediaPresentationDuration=\"PT10S\"><Period>" + tpl + "</Period><Period start=\"PT4S\">" + tpl +
  "</Period></MPD>"
  let na = nsegs(a, 0)
  if na != 2 {
    bad = bad + " first Period without @start (next starts at 4 s): " + na.to_string() + " segments (want 2)"
  }
  let b = "<MPD type=\"static\" mediaPresentationDuration=\"PT10S\"><Period start=\"PT0S\" duration=\"PT4S\">" + tpl +
  "</Period><Period>" + tpl + "</Period></MPD>"
  let nb = nsegs(b, 1)
  if nb != 3 {
    bad = bad + " second Period without @start after a 4 s Period: " + nb.to_string() + " segments (want 3)"
  }
  bad
}

///| P2-2: SegmentTimeline `S@r` below -1 is accepted (treated like -1).
fn p2_2() -> String {
  let src = doc("", as1("<SegmentTemplate media=\"s$Time$\"><SegmentTimeline><S t=\"0\" d=\"2\" r=\"-5\"/></SegmentTimeline></SegmentTemplate>"))
  match track_of(src, 0) {
    Err(_) => ""
    Ok(t) => "r=-5 accepted, " + t.segments.length().to_string() + " segments"
  }
}

///| P2-4: xs lexical spaces: dateTime without timezone / 24:00:00, unsignedInt with '+' fail the whole MPD.
fn p2_4() -> String {
  let mut bad = ""
  let a = "<MPD type=\"dynamic\" availabilityStartTime=\"2024-01-01T00:00:00\"><Period/></MPD>"
  let ka = kind_of(a)
  if ka != "OK" {
    bad = bad + " availabilityStartTime without timezone: " + ka
  }
  let b = "<MPD type=\"dynamic\" availabilityStartTime=\"2024-01-01T24:00:00Z\"><Period/></MPD>"
  match mpd_of(b) {
    Some(m) =>
    if oi(m.availability_start_time_us) != "1704153600000000" {
      bad = bad + " 24:00:00Z -> " + oi(m.availability_start_time_us)
    }
    None => bad = bad + " 24:00:00Z rejected"
  }
  let c = doc("", as1("<SegmentTemplate duration=\"5\" startNumber=\"+5\" media=\"s$Number$\"/>"))
  let kc = kind_of(c)
  if kc != "OK" {
    bad = bad + " startNumber=\"+5\": " + kc
  }
  bad
}

///| P2-5: XML 1.0 well-formedness constraints not enforced (all of these are fatal errors for an XML processor).
fn p2_5() -> String {
  let cases : Array[(String, String)] = [
    ("']]>' in character data", "<MPD><BaseURL>a]]>b</BaseURL></MPD>"),
    ("XML declaration inside the root element", "<MPD><?xml version=\"1.0\"?></MPD>"),
    ("XML declaration with an unsupported version", "<?xml version=\"9.0\"?><MPD/>"),
    ("U+FFFE in character data", "<MPD><BaseURL>a\u{fffe}b</BaseURL></MPD>"),
    ("U+00D7 as a NameStartChar", "<MPD \u{d7}x=\"1\"/>"),
    ("control character in a comment", "<MPD><!-- \u{1} --></MPD>"),
    ("PI without a target", "<MPD><? ?></MPD>"),
  ]
  let mut bad = ""
  let mut i = 0
  while i < cases.length() {
    let (label, src) = cases[i]
    if kind_of(src) == "OK" {
      bad = bad + " accepted: " + label + ";"
    }
    i = i + 1
  }
  // invalid UTF-8 (lone 0xFF byte)
  let raw = Bytes::new(17)
  let t = "<MPD><BaseURL>a"
  let mut k = 0
  while k < t.length() {
    raw[k] = t.code_unit_at(k).to_byte()
    k = k + 1
  }
  raw[15] = (255).to_byte()
  raw[16] = (62).to_byte()
  let src2 = raw.to_string() + "</BaseURL></MPD>"
  if kind_of(src2) == "OK" {
    bad = bad + " accepted: invalid UTF-8 byte 0xFF;"
  }
  bad
}

///| P2-6: attribute-value normalisation (XML 1.0 §3.3.3) is not applied: literal TAB / LF / CR survive.
fn p2_6() -> String {
  let src = doc("", "<AdaptationSet><Representation id=\"a\tb\nc\r\nd\" bandwidth=\"1\"/></AdaptationSet>")
  match mpd_of(src) {
    None => "rejected"
    Some(m) => {
      let id = m.periods[0].adaptation_sets[0].representations[0].id
      if id == "a b c d" {
        ""
      } else {
        "id=\"a<TAB>b<LF>c<CR><LF>d\" parsed as " + qs(id) + " (want \"a b c d\")"
      }
    }
  }
}

///| P2-7: format_mpd returns Ok for values that its own output cannot carry (silent loss / unparsable XML).
fn p2_7() -> String {
  let src = doc(
    " duration=\"PT10S\"",
    as1("<SegmentTemplate timescale=\"10\" duration=\"20\" media=\"s$Number$\"/>"),
  )
  let m = match mpd_of(src) {
    Some(m) => m
    None => return "base document rejected"
  }
  let p = m.periods[0]
  let a = p.adaptation_sets[0]
  let r = a.representations[0]
  let variants : Array[(String, dash::Mpd)] = [
    (
      "bandwidth=-5",
      dash::Mpd::{
        ..m,
        periods: [
          dash::Period::{
            ..p,
            adaptation_sets: [dash::AdaptationSet::{ ..a, representations: [dash::Representation::{ ..r, bandwidth: -5L }] }],
          },
        ],
      },
    ),
    (
      "Representation id empty",
      dash::Mpd::{
        ..m,
        periods: [
          dash::Period::{
            ..p,
            adaptation_sets: [dash::AdaptationSet::{ ..a, representations: [dash::Representation::{ ..r, id: "" }] }],
          },
        ],
      },
    ),
    ("mediaPresentationDuration=-1 us", dash::Mpd::{ ..m, media_presentation_duration_us: Some(-1L) }),
    ("availabilityStartTime=\"garbage\"", dash::Mpd::{ ..m, availability_start_time: Some("garbage") }),
    ("Period duration=-3 s", dash::Mpd::{ ..m, periods: [dash::Period::{ ..p, duration_us: Some(-3000000L) }] }),
    ("BaseURL text with CR", dash::Mpd::{ ..m, base_urls: ["http://h/a\rb/"] }),
    ("MPD@id with U+FFFE (not an XML Char)", dash::Mpd::{ ..m, id: Some("a\u{fffe}b") }),
  ]
  let mut bad = ""
  let mut i = 0
  while i < variants.length() {
    let (label, v) = variants[i]
    match dash::format_mpd(v) {
      Err(_) => ()
      Ok(t) =>
      if contains(t, "\u{fffe}") {
        bad = bad + " " + label + ": Ok but output is not well-formed XML;"
      } else {
        match dash::parse(t) {
          Err(e) => bad = bad + " " + label + ": Ok but output does not parse (" + err_kind(e) + ");"
          Ok(m2) =>
          if dump_structure(m2) != dump_structure(v) {
            bad = bad + " " + label + ": Ok but value silently changed;"
          }
        }
      }
    }
    i = i + 1
  }
  bad
}

///| P2-8: select_representation only matches the first codec of a multi-codec `@codecs` list.
fn p2_8() -> String {
  let src = doc(
    "",
    "<AdaptationSet><Representation id=\"muxed\" bandwidth=\"3000000\" codecs=\"mp4a.40.2,avc1.640028\"/>" +
    "<Representation id=\"hevc\" bandwidth=\"4000000\" codecs=\"hvc1.1.6.L93.B0\"/></AdaptationSet>",
  )
  match mpd_of(src) {
    None => "rejected"
    Some(m) =>
    match dash::select_representation(m.periods[0].adaptation_sets[0], 5000000L, ["avc1"]) {
      Some(0) => ""
      Some(i) => "preferred avc1, codecs=\"mp4a.40.2,avc1.640028\" not matched: picked index " + i.to_string()
      None => "None"
    }
  }
}

///| P2-9: namespace-unaware lookup: foreign-namespace elements / attributes are taken for DASH ones.
fn p2_9() -> String {
  let mut bad = ""
  let a = "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:x=\"urn:example:other\" type=\"static\" mediaPresentationDuration=\"PT10S\">" +
  "<x:Period><AdaptationSet/></x:Period></MPD>"
  match mpd_of(a) {
    Some(m) =>
    if m.periods.length() != 0 {
      bad = bad + " <x:Period> (urn:example:other) parsed as a DASH Period;"
    }
    None => ()
  }
  let b = "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:x=\"urn:example:other\" type=\"static\"><Period><AdaptationSet>" +
  "<Representation x:id=\"evil\" id=\"v\" bandwidth=\"1\"/></AdaptationSet></Period></MPD>"
  match mpd_of(b) {
    Some(m) => {
      let id = m.periods[0].adaptation_sets[0].representations[0].id
      if id != "v" {
        bad = bad + " Representation@id taken from x:id (" + qs(id) + ");"
      }
    }
    None => bad = bad + " document with a foreign x:id attribute rejected;"
  }
  bad
}

///| P2-10: PlayReady `<mspr:pro>` payloads inside ContentProtection are dropped (parse -> format loses them).
fn p2_10() -> String {
  let src = "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:cenc=\"urn:mpeg:cenc:2013\" xmlns:mspr=\"urn:microsoft:playready\" type=\"static\" mediaPresentationDuration=\"PT10S\"><Period>" +
  "<AdaptationSet><ContentProtection schemeIdUri=\"urn:uuid:9a04f079-9840-4286-ab92-e65be0885f95\" value=\"MSPR 2.0\">" +
  "<mspr:pro>UFJPREFUQVBMQVlSRUFEWQ==</mspr:pro></ContentProtection><Representation id=\"v\" bandwidth=\"1\"/></AdaptationSet></Period></MPD>"
  match mpd_of(src) {
    None => "rejected"
    Some(m) =>
    match dash::format_mpd(m) {
      Err(e) => "format " + err_kind(e)
      Ok(t) =>
      if contains(t, "UFJPREFUQVBMQVlSRUFEWQ==") {
        ""
      } else {
        "mspr:pro payload lost (not in the data model, not in format_mpd output)"
      }
    }
  }
}

// ---------------------------------------------------------------- controls

///| XXE / Billion Laughs / DOCTYPE in every position and case.
fn control_security() -> String {
  let cases = [
    "<?xml version=\"1.0\"?><!DOCTYPE MPD [<!ENTITY x SYSTEM \"file:///etc/passwd\">]><MPD>&x;</MPD>",
    "<!doctype MPD><MPD/>", "<!DoCtYpE MPD><MPD/>", "<MPD><!DOCTYPE x></MPD>", "<MPD><!ENTITY a \"b\"></MPD>",
    "<!ENTITY a \"b\"><MPD/>", "<MPD/><!DOCTYPE x>",
    "<!DOCTYPE lolz [<!ENTITY lol \"lol\"><!ENTITY lol2 \"&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;\">]><MPD>&lol2;</MPD>",
  ]
  let mut i = 0
  while i < cases.length() {
    let k = kind_of(cases[i])
    if k != "SecurityRejected" && !(i == 6 && k != "OK") {
      return "case " + i.to_string() + " -> " + k
    }
    i = i + 1
  }
  if kind_of("<MPD>&x;</MPD>") == "OK" {
    return "undefined entity accepted"
  }
  ""
}

///| XML lexer: character references, CDATA, comments, predefined entities, structure errors.
fn control_xml() -> String {
  let ok : Array[(String, String)] = [
    ("&#x41;&#66;&amp;&lt;&gt;&quot;&apos;&#x1F600;", "AB&<>\"'\u{1f600}"),
    ("<![CDATA[<x>&amp;]]>", "<x>&amp;"),
    ("a<!-- c -->b<?pi x?>c", "abc"),
    ("x&#x9;&#xA;&#xD;y", "x\t\n\ry"),
    ("x&#xFFFD;y", "x\u{fffd}y"),
  ]
  let mut i = 0
  while i < ok.length() {
    let (body, want) = ok[i]
    match mpd_of("<MPD><Location>" + body + "</Location></MPD>") {
      Some(m) => if m.locations.length() != 1 || m.locations[0] != want {
        return "text " + short(body) + " -> " + (if m.locations.length() == 1 { qs(m.locations[0]) } else { "?" })
      }
      None => return "rejected valid text " + short(body)
    }
    i = i + 1
  }
  let bad = [
    "<MPD><Location>&#x110000;</Location></MPD>", "<MPD><Location>&#xD800;</Location></MPD>",
    "<MPD><Location>&#0;</Location></MPD>", "<MPD><Location>&#xFFFE;</Location></MPD>", "<MPD><Location>&#x;</Location></MPD>",
    "<MPD><Location>&#99999999999999;</Location></MPD>", "<MPD><Location>&nbsp;</Location></MPD>",
    "<MPD><Location>&amp</Location></MPD>", "<MPD><!-- a -- b --></MPD>", "<MPD><!-- a ---></MPD>", "<MPD><![CDATA[x]]</MPD>",
    "<MPD a=\"1\" a=\"2\"/>", "<MPD a=\"1\"b=\"2\"/>", "<MPD a=1/>", "<MPD a=\"<\"/>", "<MPD></mpd>", "<MPD>", "<MPD/><MPD/>",
    "x<MPD/>", "<MPD/>x", "<MPD>\u{1}</MPD>", "<MPD a=\"\u{1}\"/>", "<MPD><![CDATA[\u{1}]]></MPD>", "", "  ", "<MPD><BaseURL></MPD>",
  ]
  i = 0
  while i < bad.length() {
    if kind_of(bad[i]) == "OK" {
      return "accepted malformed " + short(bad[i])
    }
    i = i + 1
  }
  if kind_of("\u{feff}<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- x -->\n<MPD/>\n<!-- y -->\n") != "OK" {
    return "BOM + prolog + epilog rejected"
  }
  match mpd_of("<MPD><Location>a\r\nb\rc</Location></MPD>") {
    Some(m) => if m.locations[0] != "a\nb\nc" {
      return "CR normalisation -> " + qs(m.locations[0])
    }
    None => return "CRLF text rejected"
  }
  match mpd_of("<x:MPD xmlns:x=\"urn:mpeg:dash:schema:mpd:2011\" x:type=\"dynamic\"/>") {
    Some(m) => if dash::mpd_type_to_string(m.mpd_type) != "dynamic" {
      return "prefixed MPD@type ignored"
    }
    None => return "prefixed root rejected"
  }
  ""
}

///| Every DashLimits field: N passes, N+1 fails with LimitExceeded, negative fails, 0 permits 0.
fn control_limits() -> String {
  let d = dash::DashLimits::default()
  let tl = "<MPD><Period><AdaptationSet><Representation id=\"v\" bandwidth=\"1\"><SegmentTemplate media=\"$Number$\"><SegmentTimeline>" +
  rep("<S d=\"1\"/>", 3) +
  "</SegmentTimeline></SegmentTemplate></Representation></AdaptationSet></Period></MPD>"
  let two_p = "<MPD><Period/><Period/></MPD>"
  let checks : Array[(String, String, dash::DashLimits, dash::DashLimits)] = [
    ("max_input_bytes", two_p, dash::DashLimits::{ ..d, max_input_bytes: two_p.length() }, dash::DashLimits::{ ..d, max_input_bytes: two_p.length() - 1 }),
    ("max_xml_depth", "<MPD><a><b/></a></MPD>", dash::DashLimits::{ ..d, max_xml_depth: 3 }, dash::DashLimits::{ ..d, max_xml_depth: 2 }),
    ("max_elements", "<MPD><a><b/></a></MPD>", dash::DashLimits::{ ..d, max_elements: 3 }, dash::DashLimits::{ ..d, max_elements: 2 }),
    ("max_attributes", "<MPD a=\"1\" b=\"2\"/>", dash::DashLimits::{ ..d, max_attributes: 2 }, dash::DashLimits::{ ..d, max_attributes: 1 }),
    ("max_periods", two_p, dash::DashLimits::{ ..d, max_periods: 2 }, dash::DashLimits::{ ..d, max_periods: 1 }),
    (
      "max_adaptation_sets", "<MPD><Period><AdaptationSet/></Period><Period><AdaptationSet/></Period></MPD>",
      dash::DashLimits::{ ..d, max_adaptation_sets: 2 }, dash::DashLimits::{ ..d, max_adaptation_sets: 1 },
    ),
    (
      "max_representations", "<MPD><Period><AdaptationSet><Representation id=\"a\" bandwidth=\"1\"/><Representation id=\"b\" bandwidth=\"1\"/></AdaptationSet></Period></MPD>",
      dash::DashLimits::{ ..d, max_representations: 2 }, dash::DashLimits::{ ..d, max_representations: 1 },
    ),
    ("max_timeline_entries", tl, dash::DashLimits::{ ..d, max_timeline_entries: 3 }, dash::DashLimits::{ ..d, max_timeline_entries: 2 }),
    ("max_text_bytes", "<MPD><Location>abcd</Location></MPD>", dash::DashLimits::{ ..d, max_text_bytes: 4 }, dash::DashLimits::{ ..d, max_text_bytes: 3 }),
  ]
  let mut i = 0
  while i < checks.length() {
    let (name, src, at, over) = checks[i]
    match dash::parse_with_limits(src, at) {
      Ok(_) => ()
      Err(e) => return name + " = N rejected: " + err_kind(e)
    }
    match dash::parse_with_limits(src, over) {
      Ok(_) => return name + " = N-1 accepted"
      Err(e) => if err_kind(e) != "LimitExceeded" {
        return name + " = N-1 -> " + err_kind(e)
      }
    }
    i = i + 1
  }
  let negs = [
    dash::DashLimits::{ ..d, max_input_bytes: -1 }, dash::DashLimits::{ ..d, max_xml_depth: -1 }, dash::DashLimits::{ ..d, max_elements: -1 },
    dash::DashLimits::{ ..d, max_attributes: -1 }, dash::DashLimits::{ ..d, max_periods: -1 }, dash::DashLimits::{ ..d, max_adaptation_sets: -1 },
    dash::DashLimits::{ ..d, max_representations: -1 }, dash::DashLimits::{ ..d, max_segments: -1 },
    dash::DashLimits::{ ..d, max_timeline_entries: -1 }, dash::DashLimits::{ ..d, max_text_bytes: -1 },
  ]
  i = 0
  while i < negs.length() {
    match dash::parse_with_limits("<MPD/>", negs[i]) {
      Err(e) => if err_kind(e) != "LimitExceeded" {
        return "negative limit " + i.to_string() + " -> " + err_kind(e)
      }
      Ok(_) => return "negative limit " + i.to_string() + " accepted"
    }
    i = i + 1
  }
  // max_segments at resolution time: 3 segments, limit 3 passes, 2 fails
  let m = match mpd_of(tl) {
    Some(m) => m
    None => return "timeline doc rejected"
  }
  match dash::resolve_segments(m, 0, 0, 0, dash::DashLimits::{ ..d, max_segments: 3 }) {
    Ok(t) => if t.segments.length() != 3 {
      return "max_segments=3 -> " + t.segments.length().to_string()
    }
    Err(e) => return "max_segments=3 -> " + err_kind(e)
  }
  match dash::resolve_segments(m, 0, 0, 0, dash::DashLimits::{ ..d, max_segments: 2 }) {
    Ok(_) => return "max_segments=2 accepted 3 segments"
    Err(e) => if err_kind(e) != "LimitExceeded" {
      return "max_segments=2 -> " + err_kind(e)
    }
  }
  match dash::resolve_segments(m, 0, 0, 0, dash::DashLimits::{ ..d, max_segments: -1 }) {
    Ok(_) => return "max_segments=-1 accepted"
    Err(_) => ()
  }
  match dash::resolve_segments(m, 0, 0, 1, d) {
    Ok(_) => return "rep_idx out of range accepted"
    Err(e) => if err_kind(e) != "IndexOutOfBounds" {
      return "rep_idx out of range -> " + err_kind(e)
    }
  }
  match dash::resolve_segments(m, -1, 0, 0, d) {
    Ok(_) => return "period_idx -1 accepted"
    Err(_) => ()
  }
  ""
}

///| ISO 8601 durations (xs:duration subset used by DASH), formatting.
fn control_duration() -> String {
  let ok : Array[(String, Int64)] = [
    ("PT0S", 0L), ("PT1H2M3.5S", 3723500000L), ("P1Y2M3DT4H5M6.123456S", 36993906123456L), ("P1W", 604800000000L),
    ("PT0.0000019S", 1L), ("P0D", 0L), ("PT36H", 129600000000L), (" PT1S ", 1000000L), ("PT9223372036854.775807S", 9223372036854775807L),
  ]
  let mut i = 0
  while i < ok.length() {
    let (s, want) = ok[i]
    match dash::parse_iso8601_duration_us(s) {
      Ok(v) => if v != want {
        return s + " -> " + v.to_string()
      }
      Err(_) => return s + " rejected"
    }
    i = i + 1
  }
  let bad = [
    "", "P", "PT", "1S", "-PT1S", "PT1S2M", "P1DT", "PT1.5H", "P1.5D", "PT.5S", "PT1.S", "P1H", "PTS", "PT9223372036855S",
    "P999999999999Y", "P1D1D", "PT1M1M", "pt1s",
  ]
  i = 0
  while i < bad.length() {
    match dash::parse_iso8601_duration_us(bad[i]) {
      Ok(v) => return "accepted " + qs(bad[i]) + " -> " + v.to_string()
      Err(_) => ()
    }
    i = i + 1
  }
  let fm : Array[(Int64, String)] = [(0L, "PT0S"), (3723500000L, "PT1H2M3.5S"), (1L, "PT0.000001S"), (86400000000L, "PT24H"), (60000000L, "PT1M")]
  i = 0
  while i < fm.length() {
    let (v, want) = fm[i]
    if dash::format_iso8601_duration_us(v) != want {
      return "format " + v.to_string() + " -> " + dash::format_iso8601_duration_us(v)
    }
    i = i + 1
  }
  ""
}

///| xs:dateTime with Z / offsets, Gregorian calendar.
fn control_datetime() -> String {
  let ok : Array[(String, Int64)] = [
    ("1970-01-01T00:00:00Z", 0L), ("2024-02-29T12:00:00Z", 1709208000000000L), ("2000-02-29T00:00:00Z", 951782400000000L),
    ("2024-03-01T01:30:00+01:30", 1709251200000000L), ("2024-03-01T00:00:00-05:00", 1709269200000000L),
    ("2024-01-01T00:00:00.5Z", 1704067200500000L), ("1969-12-31T23:59:59Z", -1000000L),
  ]
  let mut i = 0
  while i < ok.length() {
    let (s, want) = ok[i]
    match dash::parse_iso8601_datetime_us(s) {
      Ok(v) => if v != want {
        return s + " -> " + v.to_string()
      }
      Err(_) => return s + " rejected"
    }
    i = i + 1
  }
  let bad = [
    "2023-02-29T00:00:00Z", "1900-02-29T00:00:00Z", "2024-04-31T00:00:00Z", "2024-13-01T00:00:00Z", "2024-00-01T00:00:00Z",
    "2024-01-01T25:00:00Z", "2024-01-01T00:60:00Z", "2024-01-01T00:00:60Z", "2024-01-01 00:00:00Z", "2024-01-01T00:00:00+0100",
    "2024-01-01T00:00:00+01", "2024-01-01T00:00:00Zjunk", "2024-1-01T00:00:00Z",
  ]
  i = 0
  while i < bad.length() {
    match dash::parse_iso8601_datetime_us(bad[i]) {
      Ok(_) => return "accepted " + bad[i]
      Err(_) => ()
    }
    i = i + 1
  }
  ""
}

///| frameRate rationals.
fn control_rational() -> String {
  match dash::parse_rational("30000/1001") {
    Ok(r) => if r.num != 30000L || r.den != 1001L || dash::format_rational(r) != "30000/1001" {
      return "30000/1001"
    }
    Err(_) => return "30000/1001 rejected"
  }
  match dash::parse_rational("25") {
    Ok(r) => if dash::format_rational(r) != "25" || r.den != 1L {
      return "25"
    }
    Err(_) => return "25 rejected"
  }
  let bad = ["30/0", "0", "-30", "30/-1", "1/2/3", "/2", "2/", "", "29.97", "99999999999999999999"]
  let mut i = 0
  while i < bad.length() {
    match dash::parse_rational(bad[i]) {
      Ok(_) => return "accepted " + qs(bad[i])
      Err(_) => ()
    }
    i = i + 1
  }
  ""
}

///| SegmentTemplate identifier expansion (§5.3.9.4.4).
fn control_template() -> String {
  let ok : Array[(String, String)] = [
    ("$RepresentationID$/$Number$-$Bandwidth$-$Time$.m4s", "v1/7-500-90000.m4s"),
    ("$Number%05d$_$Time%012d$_$Bandwidth%2d$", "00007_000000090000_500"), ("a$$b$$$Number$", "a$b$7"), ("$Number%032d$", rep("0", 31) + "7"),
    ("", ""), ("plain", "plain"),
  ]
  let mut i = 0
  while i < ok.length() {
    let (t, want) = ok[i]
    match dash::expand_template(t, "v1", 7L, 500L, 90000L) {
      Ok(s) => if s != want {
        return qs(t) + " -> " + qs(s)
      }
      Err(e) => return qs(t) + " -> " + err_kind(e)
    }
    i = i + 1
  }
  let bad = ["$Number%999999999d$", "$Number%033d$", "$Time%x$", "$Number%05x$", "$Foo$", "$Number", "a$", "$RepresentationID%05d$", "$Number%-5d$"]
  i = 0
  while i < bad.length() {
    match dash::expand_template(bad[i], "v1", 7L, 500L, 90000L) {
      Ok(s) => return "accepted " + qs(bad[i]) + " -> " + short(s)
      Err(_) => ()
    }
    i = i + 1
  }
  ""
}

///|
fn seg_sig(t : dash::ResolvedTrack) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < t.segments.length() {
    let s = t.segments[i]
    parts.push(s.number.to_string() + ":" + s.url + ":" + s.start_time.to_string() + "+" + s.duration.to_string())
    i = i + 1
  }
  parts.join(" ")
}

///| SegmentTimeline: t / d / r >= 0 / r = -1 to the next S@t and to the Period end (PTO = 0), limits, overflow.
fn control_timeline() -> String {
  let a = doc(
    "",
    as1(
      "<SegmentTemplate timescale=\"10\" startNumber=\"5\" media=\"$Number$_$Time$\"><SegmentTimeline><S t=\"100\" d=\"20\" r=\"1\"/><S d=\"10\"/><S t=\"200\" d=\"5\" r=\"-1\"/><S t=\"210\" d=\"30\" r=\"-1\"/></SegmentTimeline></SegmentTemplate>",
    ),
  )
  match track_of(a, 0) {
    Ok(t) => {
      let want = "5:5_100:100+20 6:6_120:120+20 7:7_140:140+10 8:8_200:200+5 9:9_205:205+5"
      let sig = seg_sig(t)
      if !(sig.length() >= want.length() && sig.slice(0, want.length()) == want) {
        return "timeline -> " + short(sig)
      }
      // last S: r=-1 to the Period end (100 ticks): t=210 > 100 -> 0 more segments
      if t.segments.length() != 5 {
        return "timeline count " + t.segments.length().to_string()
      }
    }
    Err(e) => return e
  }
  let b = doc("", as1("<SegmentTemplate timescale=\"1\" media=\"$Time$\"><SegmentTimeline><S d=\"3\" r=\"-1\"/></SegmentTimeline></SegmentTemplate>"))
  if nsegs(b, 0) != 4 {
    return "r=-1 to Period end (10 s / 3) -> " + nsegs(b, 0).to_string()
  }
  let c = doc("", as1("<SegmentTemplate media=\"$Time$\"><SegmentTimeline><S d=\"1\" r=\"100000\"/></SegmentTimeline></SegmentTemplate>"))
  match track_of(c, 0) {
    Ok(_) => return "r=100000 (> max_segments) accepted"
    Err(_) => ()
  }
  let o = doc("", as1("<SegmentTemplate media=\"$Time$\"><SegmentTimeline><S t=\"9223372036854775800\" d=\"5\" r=\"3\"/></SegmentTimeline></SegmentTemplate>"))
  match track_of(o, 0) {
    Ok(t) => {
      let mut i = 0
      while i < t.segments.length() {
        if t.segments[i].start_time < 0L {
          return "S@t near Int64::MAX wrapped"
        }
        i = i + 1
      }
    }
    Err(_) => ()
  }
  if kind_of(doc("", as1("<SegmentTemplate media=\"x\"><SegmentTimeline><S t=\"0\"/></SegmentTimeline></SegmentTemplate>"))) == "OK" {
    return "S without @d accepted"
  }
  if kind_of(doc("", as1("<SegmentTemplate media=\"x\"><SegmentTimeline><S d=\"0\"/></SegmentTimeline></SegmentTemplate>"))) == "OK" {
    return "S@d=0 accepted"
  }
  ""
}

///| SegmentTemplate / SegmentList / SegmentBase inheritance (attribute-wise) Period -> AdaptationSet -> Representation.
fn control_inheritance() -> String {
  let src = "<MPD type=\"static\" mediaPresentationDuration=\"PT10S\"><BaseURL>http://h/root/</BaseURL><Period>" +
  "<SegmentTemplate timescale=\"1000\" startNumber=\"3\" initialization=\"$RepresentationID$/init.mp4\" media=\"p/$Number$.m4s\"/>" +
  "<AdaptationSet><BaseURL>as/</BaseURL><SegmentTemplate duration=\"4000\" media=\"a/$RepresentationID$/$Number%03d$.m4s\"/>" +
  "<Representation id=\"r1\" bandwidth=\"1\"><SegmentTemplate startNumber=\"10\"/></Representation>" +
  "<Representation id=\"r2\" bandwidth=\"2\"><BaseURL>http://other/x/</BaseURL></Representation>" +
  "</AdaptationSet></Period></MPD>"
  let m = match mpd_of(src) {
    Some(m) => m
    None => return "rejected"
  }
  match dash::resolve_segments(m, 0, 0, 0, dash::DashLimits::default()) {
    Ok(t) => {
      if os(t.initialization_url) != qs("http://h/root/as/r1/init.mp4") {
        return "r1 init " + os(t.initialization_url)
      }
      if t.segments.length() != 3 || t.segments[0].url != "http://h/root/as/a/r1/010.m4s" || t.segments[2].number != 12L ||
      t.segments[1].start_time != 4000L || t.segments[0].timescale != 1000L {
        return "r1 segments " + short(seg_sig(t))
      }
    }
    Err(e) => return "r1 " + err_kind(e)
  }
  match dash::resolve_segments(m, 0, 0, 1, dash::DashLimits::default()) {
    Ok(t) => if t.segments.length() != 3 || t.segments[0].url != "http://other/x/a/r2/003.m4s" {
      return "r2 segments " + short(seg_sig(t))
    }
    Err(e) => return "r2 " + err_kind(e)
  }
  let l = doc(
    "",
    "<AdaptationSet><SegmentList timescale=\"10\" duration=\"20\"><Initialization sourceURL=\"init.mp4\"/></SegmentList>" +
    "<Representation id=\"v\" bandwidth=\"1\"><BaseURL>http://h/v/</BaseURL><SegmentList startNumber=\"0\"><SegmentURL media=\"a.m4s\" mediaRange=\"0-99\"/><SegmentURL media=\"b.m4s\"/></SegmentList></Representation></AdaptationSet>",
  )
  match track_of(l, 0) {
    Ok(t) => if os(t.initialization_url) != qs("http://h/v/init.mp4") || seg_sig(t) != "0:http://h/v/a.m4s:0+20 1:http://h/v/b.m4s:20+20" ||
    os(t.segments[0].media_range) != qs("0-99") {
      return "SegmentList " + os(t.initialization_url) + " " + short(seg_sig(t))
    }
    Err(e) => return "SegmentList " + e
  }
  let b = doc(
    "",
    "<AdaptationSet><SegmentBase timescale=\"1000\" indexRange=\"100-200\"/><Representation id=\"v\" bandwidth=\"1\"><BaseURL>http://h/v.mp4</BaseURL><SegmentBase><Initialization range=\"0-99\"/></SegmentBase></Representation></AdaptationSet>",
  )
  match track_of(b, 0) {
    Ok(t) => if os(t.index_range) != qs("100-200") || os(t.initialization_range) != qs("0-99") || t.segments.length() != 1 ||
    t.segments[0].duration != 10000L {
      return "SegmentBase " + os(t.index_range) + " " + os(t.initialization_range) + " " + short(seg_sig(t))
    }
    Err(e) => return "SegmentBase " + e
  }
  ""
}

///| resolve_url vectors that the package resolves correctly (absolute bases, RFC 3986 §5.4.1 subset).
fn control_resolve_url() -> String {
  let base = "http://a/b/c/d;p?q"
  let v : Array[(String, String)] = [
    ("g", "http://a/b/c/g"), ("./g", "http://a/b/c/g"), ("g/", "http://a/b/c/g/"), ("/g", "http://a/g"), ("//g", "http://g"),
    ("?y", "http://a/b/c/d;p?y"), ("g?y", "http://a/b/c/g?y"), ("g#s", "http://a/b/c/g#s"), ("../g", "http://a/b/g"),
    ("../..", "http://a/"), ("../../g", "http://a/g"), ("../../../g", "http://a/g"), ("/./g", "http://a/g"), ("g.", "http://a/b/c/g."),
    ("./../g", "http://a/b/g"), ("g;x=1/../y", "http://a/b/c/y"), ("https://x/y?z", "https://x/y?z"), ("", base),
  ]
  let mut i = 0
  while i < v.length() {
    let (r, want) = v[i]
    let got = dash::resolve_url(base, r)
    if got != want {
      return "resolve_url(" + base + ", " + qs(r) + ") = " + qs(got) + " (want " + want + ")"
    }
    i = i + 1
  }
  if dash::resolve_url("https://cdn/path/?token=abc", "seg.m4s") != "https://cdn/path/seg.m4s" {
    return "query of the base kept"
  }
  if dash::resolve_url("", "x/y") != "x/y" {
    return "empty base"
  }
  ""
}

///| select_representation: budget fit, fallback to the lowest, codec prefixes, ties, empty sets.
fn control_abr() -> String {
  let src = doc(
    "",
    "<AdaptationSet codecs=\"avc1.4d401f\"><Representation id=\"lo\" bandwidth=\"500000\"/>" +
    "<Representation id=\"av1\" bandwidth=\"2000000\" codecs=\"av01.0.08M.08\"/><Representation id=\"mid\" bandwidth=\"1000000\"/>" +
    "<Representation id=\"mid2\" bandwidth=\"1000000\"/><Representation id=\"x10\" bandwidth=\"1500000\" codecs=\"avc10\"/>" +
    "<Representation id=\"hi\" bandwidth=\"3000000\" codecs=\"AVC1.640028\"/></AdaptationSet><AdaptationSet/>",
  )
  let m = match mpd_of(src) {
    Some(m) => m
    None => return "rejected"
  }
  let a = m.periods[0].adaptation_sets[0]
  let v : Array[(Int64, Array[String], Int)] = [
    (1000000L, [], 2), (999999L, [], 0), (100L, [], 0), (0L, [], 0), (-5L, [], 0), (3000000L, [], 5), (1600000L, [], 4),
    (1600000L, ["avc1"], 2), (5000000L, ["avc1"], 5), (5000000L, ["av01"], 1), (100L, ["av01"], 1), (5000000L, ["vp09"], 5),
    (1600000L, ["avc10"], 4), (5000000L, ["avc1."], 5), (1999999L, ["av01", "avc1"], 2),
  ]
  let mut i = 0
  while i < v.length() {
    let (bw, prefs, want) = v[i]
    match dash::select_representation(a, bw, prefs) {
      Some(got) => if got != want {
        return "select(" + bw.to_string() + ", [" + prefs.join(",") + "]) = " + got.to_string() + " (want " + want.to_string() + ")"
      }
      None => return "select(" + bw.to_string() + ") = None"
    }
    i = i + 1
  }
  match dash::select_representation(m.periods[0].adaptation_sets[1], 1000L, []) {
    None => ()
    Some(_) => return "empty AdaptationSet -> Some"
  }
  ""
}

///| format_mpd: hostile strings stay inside their attribute / element, control characters are refused, round trip.
fn control_format() -> String {
  let src = doc(
    " id=\"p\"",
    "<AdaptationSet mimeType=\"video/mp4\"><ContentProtection schemeIdUri=\"urn:mpeg:dash:mp4protection:2011\" value=\"cenc\" cenc:default_KID=\"k\"/>" +
    "<Representation id=\"v\" bandwidth=\"1\"><BaseURL>b/</BaseURL><SegmentTemplate media=\"m\"/></Representation></AdaptationSet>",
  )
  let m = match mpd_of(src) {
    Some(m) => m
    None => return "rejected"
  }
  let evil = "\"/><Evil a=\"1\"/>'&<![CDATA[]]>\t\n\r" + "x"
  let p = m.periods[0]
  let a = p.adaptation_sets[0]
  let r = a.representations[0]
  let cp = a.content_protections[0]
  let tpl = match r.segment_template {
    Some(t) => t
    None => return "no template"
  }
  let hostile = dash::Mpd::{
    ..m,
    id: Some(evil),
    profiles: evil,
    base_urls: ["</BaseURL><Evil/>&amp;"],
    periods: [
      dash::Period::{
        ..p,
        id: Some(evil),
        adaptation_sets: [
          dash::AdaptationSet::{
            ..a,
            mime_type: Some(evil),
            codecs: Some(evil),
            content_protections: [dash::ContentProtection::{ ..cp, scheme_id_uri: evil, default_kid: Some(evil), pssh: ["]]></cenc:pssh><Evil/>"] }],
            representations: [
              dash::Representation::{
                ..r,
                id: evil,
                codecs: Some(evil),
                base_urls: ["]]><Evil/>"],
                segment_template: Some(dash::SegmentTemplate::{ ..tpl, media: Some(evil) }),
              },
            ],
          },
        ],
      },
    ],
  }
  match dash::format_mpd(hostile) {
    Err(e) => return "hostile strings refused: " + err_kind(e)
    Ok(t) => {
      if contains(t, "<Evil") {
        return "element injected: " + short(t)
      }
      match dash::parse(t) {
        Err(e) => return "formatted hostile MPD does not parse: " + err_kind(e)
        Ok(m2) => {
          let r2 = m2.periods[0].adaptation_sets[0].representations[0]
          if r2.id != evil {
            return "Representation@id round trip " + qs(r2.id)
          }
          if os(m2.id) != qs(evil) || m2.base_urls[0] != "</BaseURL><Evil/>&amp;" {
            return "MPD round trip"
          }
          if m2.periods[0].adaptation_sets[0].content_protections[0].pssh[0] != "]]></cenc:pssh><Evil/>" {
            return "pssh round trip"
          }
        }
      }
    }
  }
  let ctl = ["\u{0}", "\u{1}", "\u{1b}", "\u{1f}"]
  let mut i = 0
  while i < ctl.length() {
    match dash::format_mpd(dash::Mpd::{ ..m, id: Some("a" + ctl[i]) }) {
      Ok(_) => return "control character " + i.to_string() + " serialised"
      Err(_) => ()
    }
    match dash::format_mpd(dash::Mpd::{ ..m, base_urls: ["a" + ctl[i]] }) {
      Ok(_) => return "control character in text " + i.to_string() + " serialised"
      Err(_) => ()
    }
    i = i + 1
  }
  match dash::format_mpd(m) {
    Err(e) => return "format " + err_kind(e)
    Ok(t) =>
    match dash::parse(t) {
      Err(e) => return "reparse " + err_kind(e)
      Ok(m2) => if dump_structure(m2) != dump_structure(m) {
        return "round trip changed the structure"
      }
    }
  }
  ""
}

///| Multi-DRM: Widevine + PlayReady + ClearKey + mp4protection side by side, multiple pssh boxes, default_KID.
fn control_drm() -> String {
  let src = "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:cenc=\"urn:mpeg:cenc:2013\" type=\"static\"><Period><AdaptationSet>" +
  "<ContentProtection schemeIdUri=\"urn:mpeg:dash:mp4protection:2011\" value=\"cenc\" cenc:default_KID=\"34e5db32-8625-47cd-ba06-68fca0655a72\"/>" +
  "<ContentProtection schemeIdUri=\"urn:uuid:edef8ba9-79d6-4ace-a3c8-27dcd51d21ed\"><cenc:pssh>AAAA</cenc:pssh><cenc:pssh> BBBB\n</cenc:pssh></ContentProtection>" +
  "<ContentProtection schemeIdUri=\"urn:uuid:9a04f079-9840-4286-ab92-e65be0885f95\" value=\"MSPR 2.0\"><cenc:pssh>CCCC</cenc:pssh></ContentProtection>" +
  "<ContentProtection schemeIdUri=\"urn:uuid:e2719d58-a985-b3c9-781a-b030af78d30e\" value=\"ClearKey1.0\"/>" +
  "<Representation id=\"v\" bandwidth=\"1\"><ContentProtection schemeIdUri=\"urn:uuid:94ce86fb-07ff-4f43-adb8-93d2fa968ca2\"/></Representation>" +
  "</AdaptationSet></Period></MPD>"
  match mpd_of(src) {
    None => "rejected"
    Some(m) => {
      let a = m.periods[0].adaptation_sets[0]
      if a.content_protections.length() != 4 || a.representations[0].content_protections.length() != 1 {
        return "ContentProtection count " + a.content_protections.length().to_string()
      }
      if os(a.content_protections[0].default_kid) != qs("34e5db32-8625-47cd-ba06-68fca0655a72") {
        return "default_KID"
      }
      let wv = a.content_protections[1]
      if wv.pssh.length() != 2 || wv.pssh[0] != "AAAA" || wv.pssh[1] != "BBBB" || a.content_protections[2].pssh[0] != "CCCC" {
        return "pssh " + wv.pssh.join(",")
      }
      match dash::format_mpd(m) {
        Err(e) => "format " + err_kind(e)
        Ok(t) =>
        match dash::parse(t) {
          Err(e) => "reparse " + err_kind(e)
          Ok(m2) => if dump_structure(m2) == dump_structure(m) { "" } else { "DRM round trip changed the structure" }
        }
      }
    }
  }
}

///|
pub fn case_names() -> Array[String] {
  [
    "redteam_p0_1_output_amplification", "redteam_p1_1_url_resolution", "redteam_p1_2_number_wrap", "redteam_p1_3_timeline_pto",
    "redteam_p1_4_depth_stack_overflow", "redteam_p2_1_period_start_inference", "redteam_p2_2_timeline_r_below_minus_one",
    "redteam_p2_4_xs_lexical", "redteam_p2_5_xml_wellformedness", "redteam_p2_6_attribute_normalisation",
    "redteam_p2_7_format_ok_unparsable", "redteam_p2_8_abr_multi_codec", "redteam_p2_9_namespaces", "redteam_p2_10_playready_pro",
    "control_security", "control_xml", "control_limits", "control_duration", "control_datetime", "control_rational",
    "control_template", "control_timeline", "control_inheritance", "control_resolve_url", "control_abr", "control_format",
    "control_drm",
  ]
}

///|
pub fn run_case(name : String) -> String {
  if name == "redteam_p0_1_output_amplification" {
    p0_1()
  } else if name == "redteam_p1_1_url_resolution" {
    p1_1()
  } else if name == "redteam_p1_2_number_wrap" {
    p1_2()
  } else if name == "redteam_p1_3_timeline_pto" {
    p1_3()
  } else if name == "redteam_p1_4_depth_stack_overflow" {
    p1_4()
  } else if name == "redteam_p2_1_period_start_inference" {
    p2_1()
  } else if name == "redteam_p2_2_timeline_r_below_minus_one" {
    p2_2()
  } else if name == "redteam_p2_4_xs_lexical" {
    p2_4()
  } else if name == "redteam_p2_5_xml_wellformedness" {
    p2_5()
  } else if name == "redteam_p2_6_attribute_normalisation" {
    p2_6()
  } else if name == "redteam_p2_7_format_ok_unparsable" {
    p2_7()
  } else if name == "redteam_p2_8_abr_multi_codec" {
    p2_8()
  } else if name == "redteam_p2_9_namespaces" {
    p2_9()
  } else if name == "redteam_p2_10_playready_pro" {
    p2_10()
  } else if name == "control_security" {
    control_security()
  } else if name == "control_xml" {
    control_xml()
  } else if name == "control_limits" {
    control_limits()
  } else if name == "control_duration" {
    control_duration()
  } else if name == "control_datetime" {
    control_datetime()
  } else if name == "control_rational" {
    control_rational()
  } else if name == "control_template" {
    control_template()
  } else if name == "control_timeline" {
    control_timeline()
  } else if name == "control_inheritance" {
    control_inheritance()
  } else if name == "control_resolve_url" {
    control_resolve_url()
  } else if name == "control_abr" {
    control_abr()
  } else if name == "control_format" {
    control_format()
  } else if name == "control_drm" {
    control_drm()
  } else {
    "unknown case " + name
  }
}
