///| Red-team tests: each asserts conforming behaviour and FAILS while the finding of the same id (REPORT.md) is open.
///| redteam_p1_4_depth_stack_overflow is run out of process only (run_audit.sh `cases`): while open it kills the
///| process (native SIGSEGV / wasm32 stack overflow), which would abort the whole `pionc test` run.

///|
test "redteam_p0_1_output_amplification" {
  let r = run_case("redteam_p0_1_output_amplification")
  debug_assert(r == "", r)
}

