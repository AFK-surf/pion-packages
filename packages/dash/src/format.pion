///| Deterministic, injection-safe XML serializer for `Mpd`.
///| Validates UTF-8, XML 1.0 Char, and all semantic field constraints so that every `Ok(xml)`
///| is well-formed XML that round-trips cleanly through `parse`.

fn validate_xml_string(s : String) -> Result[Unit, DashError] {
  match xml_validate_utf8_and_chars(s) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

fn write_xml_escaped_attr(sb : StringBuilder, s : String) -> Result[Unit, DashError] {
  match validate_xml_string(s) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 38 {
      sb.write_string("&amp;")
    } else if c == 60 {
      sb.write_string("&lt;")
    } else if c == 62 {
      sb.write_string("&gt;")
    } else if c == 34 {
      sb.write_string("&quot;")
    } else if c == 39 {
      sb.write_string("&apos;")
    } else if c == 10 {
      sb.write_string("&#10;")
    } else if c == 13 {
      sb.write_string("&#13;")
    } else if c == 9 {
      sb.write_string("&#9;")
    } else {
      let start = i
      while i < n {
        let rc = s.code_unit_at(i)
        if rc == 38 || rc == 60 || rc == 62 || rc == 34 || rc == 39 || rc == 10 || rc == 13 || rc == 9 {
          break
        }
        i = i + 1
      }
      sb.write_string(s.slice(start, i))
      continue
    }
    i = i + 1
  }
  Ok(())
}

fn write_xml_escaped_text(sb : StringBuilder, s : String) -> Result[Unit, DashError] {
  match validate_xml_string(s) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 38 {
      sb.write_string("&amp;")
    } else if c == 60 {
      sb.write_string("&lt;")
    } else if c == 62 {
      sb.write_string("&gt;")
    } else if c == 13 {
      sb.write_string("&#13;")
    } else {
      let start = i
      while i < n {
        let rc = s.code_unit_at(i)
        if rc == 38 || rc == 60 || rc == 62 || rc == 13 {
          break
        }
        i = i + 1
      }
      sb.write_string(s.slice(start, i))
      continue
    }
    i = i + 1
  }
  Ok(())
}

fn write_attr(sb : StringBuilder, name : String, value : String) -> Result[Unit, DashError] {
  sb.write_string(" ")
  sb.write_string(name)
  sb.write_string("=\"")
  match write_xml_escaped_attr(sb, value) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string("\"")
  Ok(())
}

fn write_opt_attr_str(sb : StringBuilder, name : String, value : Option[String]) -> Result[Unit, DashError] {
  match value {
    None => Ok(())
    Some(v) => write_attr(sb, name, v)
  }
}

fn write_opt_attr_nonneg_i64(sb : StringBuilder, name : String, value : Option[Int64]) -> Result[Unit, DashError] {
  match value {
    None => Ok(())
    Some(v) => {
      if v < 0L {
        return Err(DashError::InvalidNumber("negative unsigned integer for @" + name))
      }
      sb.write_string(" ")
      sb.write_string(name)
      sb.write_string("=\"")
      sb.write_string(v.to_string())
      sb.write_string("\"")
      Ok(())
    }
  }
}

fn write_opt_attr_pos_i64(sb : StringBuilder, name : String, value : Option[Int64]) -> Result[Unit, DashError] {
  match value {
    None => Ok(())
    Some(v) => {
      if v <= 0L {
        return Err(DashError::InvalidNumber("non-positive integer for @" + name))
      }
      sb.write_string(" ")
      sb.write_string(name)
      sb.write_string("=\"")
      sb.write_string(v.to_string())
      sb.write_string("\"")
      Ok(())
    }
  }
}

fn write_opt_attr_bool(sb : StringBuilder, name : String, value : Option[Bool]) -> Unit {
  match value {
    None => ()
    Some(b) => {
      sb.write_string(" ")
      sb.write_string(name)
      sb.write_string("=\"")
      sb.write_string(if b { "true" } else { "false" })
      sb.write_string("\"")
    }
  }
}

fn write_opt_attr_dur(sb : StringBuilder, name : String, value : Option[Int64]) -> Result[Unit, DashError] {
  match value {
    None => Ok(())
    Some(us) => {
      if us < 0L {
        return Err(DashError::InvalidDuration("negative duration for @" + name))
      }
      sb.write_string(" ")
      sb.write_string(name)
      sb.write_string("=\"")
      sb.write_string(format_iso8601_duration_us(us))
      sb.write_string("\"")
      Ok(())
    }
  }
}

fn write_opt_attr_rational(sb : StringBuilder, name : String, value : Option[Rational]) -> Result[Unit, DashError] {
  match value {
    None => Ok(())
    Some(r) => {
      if r.num <= 0L || r.den <= 0L {
        return Err(DashError::InvalidNumber("non-positive rational for @" + name))
      }
      sb.write_string(" ")
      sb.write_string(name)
      sb.write_string("=\"")
      sb.write_string(format_rational(r))
      sb.write_string("\"")
      Ok(())
    }
  }
}

fn write_opt_attr_datetime(sb : StringBuilder, name : String, value : Option[String]) -> Result[Unit, DashError] {
  match value {
    None => Ok(())
    Some(s) => {
      match parse_iso8601_datetime_us(s) {
        Ok(_) => write_attr(sb, name, s)
        Err(e) => Err(e)
      }
    }
  }
}

fn write_indent(sb : StringBuilder, level : Int) -> Unit {
  let mut i = 0
  while i < level {
    sb.write_string("  ")
    i = i + 1
  }
}

fn write_text_elem(sb : StringBuilder, level : Int, tag : String, text : String) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<")
  sb.write_string(tag)
  sb.write_string(">")
  match write_xml_escaped_text(sb, text) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string("</")
  sb.write_string(tag)
  sb.write_string(">\n")
  Ok(())
}

fn write_descriptor(sb : StringBuilder, level : Int, tag : String, d : Descriptor) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<")
  sb.write_string(tag)
  match write_attr(sb, "schemeIdUri", d.scheme_id_uri) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "value", d.value) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "id", d.id) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string("/>\n")
  Ok(())
}

fn write_content_protection(sb : StringBuilder, level : Int, cp : ContentProtection) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<ContentProtection")
  match write_attr(sb, "schemeIdUri", cp.scheme_id_uri) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "value", cp.value) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "cenc:default_KID", cp.default_kid) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if cp.pssh.length() == 0 && cp.pro.length() == 0 {
    sb.write_string("/>\n")
    return Ok(())
  }
  sb.write_string(">\n")
  let mut i = 0
  while i < cp.pssh.length() {
    match write_text_elem(sb, level + 1, "cenc:pssh", cp.pssh[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  i = 0
  while i < cp.pro.length() {
    match write_text_elem(sb, level + 1, "mspr:pro", cp.pro[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  write_indent(sb, level)
  sb.write_string("</ContentProtection>\n")
  Ok(())
}

fn write_segment_base(sb : StringBuilder, level : Int, sbase : SegmentBase) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<SegmentBase")
  match write_opt_attr_pos_i64(sb, "timescale", sbase.timescale) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "presentationTimeOffset", sbase.presentation_time_offset) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "indexRange", sbase.index_range) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  write_opt_attr_bool(sb, "indexRangeExact", sbase.index_range_exact)
  let has_init = sbase.initialization_source_url is Some(_) || sbase.initialization_range is Some(_)
  if !has_init {
    sb.write_string("/>\n")
    return Ok(())
  }
  sb.write_string(">\n")
  write_indent(sb, level + 1)
  sb.write_string("<Initialization")
  match write_opt_attr_str(sb, "sourceURL", sbase.initialization_source_url) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "range", sbase.initialization_range) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string("/>\n")
  write_indent(sb, level)
  sb.write_string("</SegmentBase>\n")
  Ok(())
}

fn write_segment_list(sb : StringBuilder, level : Int, sl : SegmentList) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<SegmentList")
  match write_opt_attr_pos_i64(sb, "timescale", sl.timescale) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_pos_i64(sb, "duration", sl.duration) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "startNumber", sl.start_number) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "presentationTimeOffset", sl.presentation_time_offset) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let has_init = sl.initialization_source_url is Some(_) || sl.initialization_range is Some(_)
  if !has_init && sl.segment_urls.length() == 0 {
    sb.write_string("/>\n")
    return Ok(())
  }
  sb.write_string(">\n")
  if has_init {
    write_indent(sb, level + 1)
    sb.write_string("<Initialization")
    match write_opt_attr_str(sb, "sourceURL", sl.initialization_source_url) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match write_opt_attr_str(sb, "range", sl.initialization_range) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string("/>\n")
  }
  let mut i = 0
  while i < sl.segment_urls.length() {
    let su = sl.segment_urls[i]
    write_indent(sb, level + 1)
    sb.write_string("<SegmentURL")
    match write_opt_attr_str(sb, "media", su.media) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match write_opt_attr_str(sb, "mediaRange", su.media_range) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match write_opt_attr_str(sb, "index", su.index) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match write_opt_attr_str(sb, "indexRange", su.index_range) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string("/>\n")
    i = i + 1
  }
  write_indent(sb, level)
  sb.write_string("</SegmentList>\n")
  Ok(())
}

fn write_segment_template(sb : StringBuilder, level : Int, st : SegmentTemplate) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<SegmentTemplate")
  match write_opt_attr_pos_i64(sb, "timescale", st.timescale) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_pos_i64(sb, "duration", st.duration) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "startNumber", st.start_number) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "presentationTimeOffset", st.presentation_time_offset) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "initialization", st.initialization) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "media", st.media) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if st.timeline.length() == 0 {
    sb.write_string("/>\n")
    return Ok(())
  }
  sb.write_string(">\n")
  write_indent(sb, level + 1)
  sb.write_string("<SegmentTimeline>\n")
  let mut i = 0
  while i < st.timeline.length() {
    let e = st.timeline[i]
    if e.d <= 0L {
      return Err(DashError::InvalidNumber("SegmentTimeline S@d must be positive"))
    }
    if e.r < -1L {
      return Err(DashError::InvalidMpd("SegmentTimeline S@r must be >= -1"))
    }
    write_indent(sb, level + 2)
    sb.write_string("<S")
    match write_opt_attr_nonneg_i64(sb, "t", e.t) {
      Ok(_) => ()
      Err(err) => return Err(err)
    }
    sb.write_string(" d=\"")
    sb.write_string(e.d.to_string())
    sb.write_string("\"")
    if e.r != 0L {
      sb.write_string(" r=\"")
      sb.write_string(e.r.to_string())
      sb.write_string("\"")
    }
    sb.write_string("/>\n")
    i = i + 1
  }
  write_indent(sb, level + 1)
  sb.write_string("</SegmentTimeline>\n")
  write_indent(sb, level)
  sb.write_string("</SegmentTemplate>\n")
  Ok(())
}

fn mpd_uses_cenc(mpd : Mpd) -> Bool {
  let mut pi = 0
  while pi < mpd.periods.length() {
    let p = mpd.periods[pi]
    let mut ai = 0
    while ai < p.adaptation_sets.length() {
      let a = p.adaptation_sets[ai]
      let mut ci = 0
      while ci < a.content_protections.length() {
        if a.content_protections[ci].default_kid is Some(_) || a.content_protections[ci].pssh.length() > 0 {
          return true
        }
        ci = ci + 1
      }
      let mut ri = 0
      while ri < a.representations.length() {
        let r = a.representations[ri]
        let mut rci = 0
        while rci < r.content_protections.length() {
          if r.content_protections[rci].default_kid is Some(_) || r.content_protections[rci].pssh.length() > 0 {
            return true
          }
          rci = rci + 1
        }
        ri = ri + 1
      }
      ai = ai + 1
    }
    pi = pi + 1
  }
  false
}

fn mpd_uses_mspr(mpd : Mpd) -> Bool {
  let mut pi = 0
  while pi < mpd.periods.length() {
    let p = mpd.periods[pi]
    let mut ai = 0
    while ai < p.adaptation_sets.length() {
      let a = p.adaptation_sets[ai]
      let mut ci = 0
      while ci < a.content_protections.length() {
        if a.content_protections[ci].pro.length() > 0 {
          return true
        }
        ci = ci + 1
      }
      let mut ri = 0
      while ri < a.representations.length() {
        let r = a.representations[ri]
        let mut rci = 0
        while rci < r.content_protections.length() {
          if r.content_protections[rci].pro.length() > 0 {
            return true
          }
          rci = rci + 1
        }
        ri = ri + 1
      }
      ai = ai + 1
    }
    pi = pi + 1
  }
  false
}

fn write_representation(sb : StringBuilder, r : Representation) -> Result[Unit, DashError] {
  if r.id.length() == 0 {
    return Err(DashError::InvalidMpd("<Representation> attribute id must not be empty"))
  }
  if r.bandwidth <= 0L {
    return Err(DashError::InvalidNumber("<Representation> attribute bandwidth must be positive"))
  }
  write_indent(sb, 3)
  sb.write_string("<Representation")
  match write_attr(sb, "id", r.id) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string(" bandwidth=\"")
  sb.write_string(r.bandwidth.to_string())
  sb.write_string("\"")
  match write_opt_attr_nonneg_i64(sb, "width", r.width) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "height", r.height) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_rational(sb, "frameRate", r.frame_rate) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "sar", r.sar) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "codecs", r.codecs) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "mimeType", r.mime_type) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "audioSamplingRate", r.audio_sampling_rate) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "startWithSAP", r.start_with_sap) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let has_children = r.base_urls.length() > 0 ||
  r.content_protections.length() > 0 ||
  r.audio_channel_configurations.length() > 0 ||
  r.segment_base is Some(_) ||
  r.segment_list is Some(_) ||
  r.segment_template is Some(_)
  if !has_children {
    sb.write_string("/>\n")
    return Ok(())
  }
  sb.write_string(">\n")
  let mut k = 0
  while k < r.base_urls.length() {
    match write_text_elem(sb, 4, "BaseURL", r.base_urls[k]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    k = k + 1
  }
  k = 0
  while k < r.content_protections.length() {
    match write_content_protection(sb, 4, r.content_protections[k]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    k = k + 1
  }
  k = 0
  while k < r.audio_channel_configurations.length() {
    match write_descriptor(sb, 4, "AudioChannelConfiguration", r.audio_channel_configurations[k]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    k = k + 1
  }
  match r.segment_base {
    Some(s) => {
      match write_segment_base(sb, 4, s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match r.segment_list {
    Some(s) => {
      match write_segment_list(sb, 4, s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match r.segment_template {
    Some(s) => {
      match write_segment_template(sb, 4, s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  write_indent(sb, 3)
  sb.write_string("</Representation>\n")
  Ok(())
}

fn write_adaptation_set(sb : StringBuilder, a : AdaptationSet) -> Result[Unit, DashError] {
  write_indent(sb, 2)
  sb.write_string("<AdaptationSet")
  match write_opt_attr_str(sb, "id", a.id) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "group", a.group) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match a.content_type {
    Some(ct) => {
      match write_attr(sb, "contentType", content_type_to_string(ct)) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match write_opt_attr_str(sb, "mimeType", a.mime_type) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "codecs", a.codecs) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "lang", a.lang) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  write_opt_attr_bool(sb, "segmentAlignment", a.segment_alignment)
  write_opt_attr_bool(sb, "subsegmentAlignment", a.subsegment_alignment)
  write_opt_attr_bool(sb, "bitstreamSwitching", a.bitstream_switching)
  match write_opt_attr_nonneg_i64(sb, "minBandwidth", a.min_bandwidth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "maxBandwidth", a.max_bandwidth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "minWidth", a.min_width) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "maxWidth", a.max_width) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "minHeight", a.min_height) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "maxHeight", a.max_height) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "par", a.par) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_rational(sb, "frameRate", a.frame_rate) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "sar", a.sar) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "audioSamplingRate", a.audio_sampling_rate) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_nonneg_i64(sb, "startWithSAP", a.start_with_sap) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string(">\n")

  let mut j = 0
  while j < a.base_urls.length() {
    match write_text_elem(sb, 3, "BaseURL", a.base_urls[j]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    j = j + 1
  }
  j = 0
  while j < a.roles.length() {
    match write_descriptor(sb, 3, "Role", a.roles[j]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    j = j + 1
  }
  j = 0
  while j < a.content_protections.length() {
    match write_content_protection(sb, 3, a.content_protections[j]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    j = j + 1
  }
  j = 0
  while j < a.accessibilities.length() {
    match write_descriptor(sb, 3, "Accessibility", a.accessibilities[j]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    j = j + 1
  }
  j = 0
  while j < a.audio_channel_configurations.length() {
    match write_descriptor(sb, 3, "AudioChannelConfiguration", a.audio_channel_configurations[j]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    j = j + 1
  }
  j = 0
  while j < a.supplemental_properties.length() {
    match write_descriptor(sb, 3, "SupplementalProperty", a.supplemental_properties[j]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    j = j + 1
  }
  j = 0
  while j < a.essential_properties.length() {
    match write_descriptor(sb, 3, "EssentialProperty", a.essential_properties[j]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    j = j + 1
  }
  match a.segment_base {
    Some(s) => {
      match write_segment_base(sb, 3, s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match a.segment_list {
    Some(s) => {
      match write_segment_list(sb, 3, s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match a.segment_template {
    Some(s) => {
      match write_segment_template(sb, 3, s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }

  let mut ri = 0
  while ri < a.representations.length() {
    match write_representation(sb, a.representations[ri]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    ri = ri + 1
  }

  write_indent(sb, 2)
  sb.write_string("</AdaptationSet>\n")
  Ok(())
}

fn write_period(sb : StringBuilder, p : Period) -> Result[Unit, DashError] {
  write_indent(sb, 1)
  sb.write_string("<Period")
  match write_opt_attr_str(sb, "id", p.id) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_dur(sb, "start", p.start_us) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_dur(sb, "duration", p.duration_us) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  write_opt_attr_bool(sb, "bitstreamSwitching", p.bitstream_switching)
  sb.write_string(">\n")

  let mut bi = 0
  while bi < p.base_urls.length() {
    match write_text_elem(sb, 2, "BaseURL", p.base_urls[bi]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    bi = bi + 1
  }
  match p.segment_base {
    Some(s) => {
      match write_segment_base(sb, 2, s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match p.segment_list {
    Some(s) => {
      match write_segment_list(sb, 2, s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match p.segment_template {
    Some(s) => {
      match write_segment_template(sb, 2, s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }

  let mut ai = 0
  while ai < p.adaptation_sets.length() {
    match write_adaptation_set(sb, p.adaptation_sets[ai]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    ai = ai + 1
  }

  write_indent(sb, 1)
  sb.write_string("</Period>\n")
  Ok(())
}

///| Deterministically serialize an `Mpd` back to strictly escaped XML.
pub fn format_mpd(mpd : Mpd) -> Result[String, DashError] {
  let sb = StringBuilder::new()
  sb.write_string("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
  sb.write_string("<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\"")
  if mpd_uses_cenc(mpd) {
    sb.write_string(" xmlns:cenc=\"urn:mpeg:cenc:2013\"")
  }
  if mpd_uses_mspr(mpd) {
    sb.write_string(" xmlns:mspr=\"urn:microsoft:playready\"")
  }
  match write_opt_attr_str(sb, "id", mpd.id) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_attr(sb, "type", mpd_type_to_string(mpd.mpd_type)) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if mpd.profiles.length() > 0 {
    match write_attr(sb, "profiles", mpd.profiles) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  match write_opt_attr_dur(sb, "mediaPresentationDuration", mpd.media_presentation_duration_us) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_dur(sb, "minBufferTime", mpd.min_buffer_time_us) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_dur(sb, "minimumUpdatePeriod", mpd.minimum_update_period_us) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_datetime(sb, "availabilityStartTime", mpd.availability_start_time) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_datetime(sb, "publishTime", mpd.publish_time) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_dur(sb, "timeShiftBufferDepth", mpd.time_shift_buffer_depth_us) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_dur(sb, "suggestedPresentationDelay", mpd.suggested_presentation_delay_us) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_dur(sb, "maxSegmentDuration", mpd.max_segment_duration_us) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string(">\n")

  let mut i = 0
  while i < mpd.base_urls.length() {
    match write_text_elem(sb, 1, "BaseURL", mpd.base_urls[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  i = 0
  while i < mpd.locations.length() {
    match write_text_elem(sb, 1, "Location", mpd.locations[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  i = 0
  while i < mpd.utc_timings.length() {
    match write_descriptor(sb, 1, "UTCTiming", mpd.utc_timings[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  let mut pi = 0
  while pi < mpd.periods.length() {
    match write_period(sb, mpd.periods[pi]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    pi = pi + 1
  }

  sb.write_string("</MPD>\n")
  Ok(sb.to_string())
}
