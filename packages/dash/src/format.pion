///| Deterministic, injection-safe XML serializer for `Mpd`.
///| Rejects illegal XML 1.0 control characters and escapes all attribute/text metacharacters.

fn validate_xml_string(s : String) -> Result[Unit, DashError] {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 32 && c != 9 && c != 10 && c != 13 {
      return Err(DashError::InvalidXml("illegal XML 1.0 control character in serialized string"))
    }
    i = i + 1
  }
  Ok(())
}

fn write_xml_escaped_attr(sb : StringBuilder, s : String) -> Result[Unit, DashError] {
  match validate_xml_string(s) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 38 {
      sb.write_string("&amp;")
    } else if c == 60 {
      sb.write_string("&lt;")
    } else if c == 62 {
      sb.write_string("&gt;")
    } else if c == 34 {
      sb.write_string("&quot;")
    } else if c == 39 {
      sb.write_string("&apos;")
    } else if c == 10 {
      sb.write_string("&#10;")
    } else if c == 13 {
      sb.write_string("&#13;")
    } else if c == 9 {
      sb.write_string("&#9;")
    } else {
      let start = i
      while i < n {
        let rc = s.code_unit_at(i)
        if rc == 38 || rc == 60 || rc == 62 || rc == 34 || rc == 39 || rc == 10 || rc == 13 || rc == 9 {
          break
        }
        i = i + 1
      }
      sb.write_string(s.slice(start, i))
      continue
    }
    i = i + 1
  }
  Ok(())
}

fn write_xml_escaped_text(sb : StringBuilder, s : String) -> Result[Unit, DashError] {
  match validate_xml_string(s) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 38 {
      sb.write_string("&amp;")
    } else if c == 60 {
      sb.write_string("&lt;")
    } else if c == 62 {
      sb.write_string("&gt;")
    } else {
      let start = i
      while i < n {
        let rc = s.code_unit_at(i)
        if rc == 38 || rc == 60 || rc == 62 {
          break
        }
        i = i + 1
      }
      sb.write_string(s.slice(start, i))
      continue
    }
    i = i + 1
  }
  Ok(())
}

fn write_attr(sb : StringBuilder, name : String, value : String) -> Result[Unit, DashError] {
  sb.write_string(" ")
  sb.write_string(name)
  sb.write_string("=\"")
  match write_xml_escaped_attr(sb, value) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string("\"")
  Ok(())
}

fn write_opt_attr_str(sb : StringBuilder, name : String, value : Option[String]) -> Result[Unit, DashError] {
  match value {
    None => Ok(())
    Some(v) => write_attr(sb, name, v)
  }
}

fn write_opt_attr_i64(sb : StringBuilder, name : String, value : Option[Int64]) -> Unit {
  match value {
    None => ()
    Some(v) => {
      sb.write_string(" ")
      sb.write_string(name)
      sb.write_string("=\"")
      sb.write_string(v.to_string())
      sb.write_string("\"")
    }
  }
}

fn write_opt_attr_bool(sb : StringBuilder, name : String, value : Option[Bool]) -> Unit {
  match value {
    None => ()
    Some(b) => {
      sb.write_string(" ")
      sb.write_string(name)
      sb.write_string("=\"")
      sb.write_string(if b { "true" } else { "false" })
      sb.write_string("\"")
    }
  }
}

fn write_opt_attr_dur(sb : StringBuilder, name : String, value : Option[Int64]) -> Unit {
  match value {
    None => ()
    Some(us) => {
      sb.write_string(" ")
      sb.write_string(name)
      sb.write_string("=\"")
      sb.write_string(format_iso8601_duration_us(us))
      sb.write_string("\"")
    }
  }
}

fn write_opt_attr_rational(sb : StringBuilder, name : String, value : Option[Rational]) -> Unit {
  match value {
    None => ()
    Some(r) => {
      sb.write_string(" ")
      sb.write_string(name)
      sb.write_string("=\"")
      sb.write_string(format_rational(r))
      sb.write_string("\"")
    }
  }
}

fn write_indent(sb : StringBuilder, level : Int) -> Unit {
  let mut i = 0
  while i < level {
    sb.write_string("  ")
    i = i + 1
  }
}

fn write_text_elem(sb : StringBuilder, level : Int, tag : String, text : String) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<")
  sb.write_string(tag)
  sb.write_string(">")
  match write_xml_escaped_text(sb, text) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string("</")
  sb.write_string(tag)
  sb.write_string(">\n")
  Ok(())
}

fn write_descriptor(sb : StringBuilder, level : Int, tag : String, d : Descriptor) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<")
  sb.write_string(tag)
  match write_attr(sb, "schemeIdUri", d.scheme_id_uri) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "value", d.value) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "id", d.id) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string("/>\n")
  Ok(())
}

fn write_content_protection(sb : StringBuilder, level : Int, cp : ContentProtection) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<ContentProtection")
  match write_attr(sb, "schemeIdUri", cp.scheme_id_uri) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "value", cp.value) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "cenc:default_KID", cp.default_kid) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if cp.pssh.length() == 0 {
    sb.write_string("/>\n")
    return Ok(())
  }
  sb.write_string(">\n")
  let mut i = 0
  while i < cp.pssh.length() {
    match write_text_elem(sb, level + 1, "cenc:pssh", cp.pssh[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  write_indent(sb, level)
  sb.write_string("</ContentProtection>\n")
  Ok(())
}

fn write_segment_base(sb : StringBuilder, level : Int, sbase : SegmentBase) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<SegmentBase")
  write_opt_attr_i64(sb, "timescale", sbase.timescale)
  write_opt_attr_i64(sb, "presentationTimeOffset", sbase.presentation_time_offset)
  match write_opt_attr_str(sb, "indexRange", sbase.index_range) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  write_opt_attr_bool(sb, "indexRangeExact", sbase.index_range_exact)
  let has_init = sbase.initialization_source_url is Some(_) || sbase.initialization_range is Some(_)
  if !has_init {
    sb.write_string("/>\n")
    return Ok(())
  }
  sb.write_string(">\n")
  write_indent(sb, level + 1)
  sb.write_string("<Initialization")
  match write_opt_attr_str(sb, "sourceURL", sbase.initialization_source_url) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "range", sbase.initialization_range) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string("/>\n")
  write_indent(sb, level)
  sb.write_string("</SegmentBase>\n")
  Ok(())
}

fn write_segment_list(sb : StringBuilder, level : Int, sl : SegmentList) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<SegmentList")
  write_opt_attr_i64(sb, "timescale", sl.timescale)
  write_opt_attr_i64(sb, "duration", sl.duration)
  write_opt_attr_i64(sb, "startNumber", sl.start_number)
  write_opt_attr_i64(sb, "presentationTimeOffset", sl.presentation_time_offset)
  let has_init = sl.initialization_source_url is Some(_) || sl.initialization_range is Some(_)
  if !has_init && sl.segment_urls.length() == 0 {
    sb.write_string("/>\n")
    return Ok(())
  }
  sb.write_string(">\n")
  if has_init {
    write_indent(sb, level + 1)
    sb.write_string("<Initialization")
    match write_opt_attr_str(sb, "sourceURL", sl.initialization_source_url) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match write_opt_attr_str(sb, "range", sl.initialization_range) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string("/>\n")
  }
  let mut i = 0
  while i < sl.segment_urls.length() {
    let su = sl.segment_urls[i]
    write_indent(sb, level + 1)
    sb.write_string("<SegmentURL")
    match write_opt_attr_str(sb, "media", su.media) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match write_opt_attr_str(sb, "mediaRange", su.media_range) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match write_opt_attr_str(sb, "index", su.index) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match write_opt_attr_str(sb, "indexRange", su.index_range) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string("/>\n")
    i = i + 1
  }
  write_indent(sb, level)
  sb.write_string("</SegmentList>\n")
  Ok(())
}

fn write_segment_template(sb : StringBuilder, level : Int, st : SegmentTemplate) -> Result[Unit, DashError] {
  write_indent(sb, level)
  sb.write_string("<SegmentTemplate")
  write_opt_attr_i64(sb, "timescale", st.timescale)
  write_opt_attr_i64(sb, "duration", st.duration)
  write_opt_attr_i64(sb, "startNumber", st.start_number)
  write_opt_attr_i64(sb, "presentationTimeOffset", st.presentation_time_offset)
  match write_opt_attr_str(sb, "initialization", st.initialization) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "media", st.media) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if st.timeline.length() == 0 {
    sb.write_string("/>\n")
    return Ok(())
  }
  sb.write_string(">\n")
  write_indent(sb, level + 1)
  sb.write_string("<SegmentTimeline>\n")
  let mut i = 0
  while i < st.timeline.length() {
    let e = st.timeline[i]
    write_indent(sb, level + 2)
    sb.write_string("<S")
    write_opt_attr_i64(sb, "t", e.t)
    sb.write_string(" d=\"")
    sb.write_string(e.d.to_string())
    sb.write_string("\"")
    if e.r != 0L {
      sb.write_string(" r=\"")
      sb.write_string(e.r.to_string())
      sb.write_string("\"")
    }
    sb.write_string("/>\n")
    i = i + 1
  }
  write_indent(sb, level + 1)
  sb.write_string("</SegmentTimeline>\n")
  write_indent(sb, level)
  sb.write_string("</SegmentTemplate>\n")
  Ok(())
}

fn mpd_uses_cenc(mpd : Mpd) -> Bool {
  let mut pi = 0
  while pi < mpd.periods.length() {
    let p = mpd.periods[pi]
    let mut ai = 0
    while ai < p.adaptation_sets.length() {
      let a = p.adaptation_sets[ai]
      let mut ci = 0
      while ci < a.content_protections.length() {
        if a.content_protections[ci].default_kid is Some(_) || a.content_protections[ci].pssh.length() > 0 {
          return true
        }
        ci = ci + 1
      }
      let mut ri = 0
      while ri < a.representations.length() {
        let r = a.representations[ri]
        let mut rci = 0
        while rci < r.content_protections.length() {
          if r.content_protections[rci].default_kid is Some(_) || r.content_protections[rci].pssh.length() > 0 {
            return true
          }
          rci = rci + 1
        }
        ri = ri + 1
      }
      ai = ai + 1
    }
    pi = pi + 1
  }
  false
}

///| Deterministically serialize an `Mpd` back to strictly escaped XML.
pub fn format_mpd(mpd : Mpd) -> Result[String, DashError] {
  let sb = StringBuilder::new()
  sb.write_string("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
  sb.write_string("<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\"")
  if mpd_uses_cenc(mpd) {
    sb.write_string(" xmlns:cenc=\"urn:mpeg:cenc:2013\"")
  }
  match write_opt_attr_str(sb, "id", mpd.id) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_attr(sb, "type", mpd_type_to_string(mpd.mpd_type)) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if mpd.profiles.length() > 0 {
    match write_attr(sb, "profiles", mpd.profiles) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  write_opt_attr_dur(sb, "mediaPresentationDuration", mpd.media_presentation_duration_us)
  write_opt_attr_dur(sb, "minBufferTime", mpd.min_buffer_time_us)
  write_opt_attr_dur(sb, "minimumUpdatePeriod", mpd.minimum_update_period_us)
  match write_opt_attr_str(sb, "availabilityStartTime", mpd.availability_start_time) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match write_opt_attr_str(sb, "publishTime", mpd.publish_time) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  write_opt_attr_dur(sb, "timeShiftBufferDepth", mpd.time_shift_buffer_depth_us)
  write_opt_attr_dur(sb, "suggestedPresentationDelay", mpd.suggested_presentation_delay_us)
  write_opt_attr_dur(sb, "maxSegmentDuration", mpd.max_segment_duration_us)
  sb.write_string(">\n")

  let mut i = 0
  while i < mpd.base_urls.length() {
    match write_text_elem(sb, 1, "BaseURL", mpd.base_urls[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  i = 0
  while i < mpd.locations.length() {
    match write_text_elem(sb, 1, "Location", mpd.locations[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  i = 0
  while i < mpd.utc_timings.length() {
    match write_descriptor(sb, 1, "UTCTiming", mpd.utc_timings[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  let mut pi = 0
  while pi < mpd.periods.length() {
    let p = mpd.periods[pi]
    write_indent(sb, 1)
    sb.write_string("<Period")
    match write_opt_attr_str(sb, "id", p.id) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    write_opt_attr_dur(sb, "start", p.start_us)
    write_opt_attr_dur(sb, "duration", p.duration_us)
    write_opt_attr_bool(sb, "bitstreamSwitching", p.bitstream_switching)
    sb.write_string(">\n")

    let mut bi = 0
    while bi < p.base_urls.length() {
      match write_text_elem(sb, 2, "BaseURL", p.base_urls[bi]) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      bi = bi + 1
    }
    match p.segment_base {
      Some(s) => {
        match write_segment_base(sb, 2, s) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match p.segment_list {
      Some(s) => {
        match write_segment_list(sb, 2, s) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match p.segment_template {
      Some(s) => {
        match write_segment_template(sb, 2, s) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }

    let mut ai = 0
    while ai < p.adaptation_sets.length() {
      let a = p.adaptation_sets[ai]
      write_indent(sb, 2)
      sb.write_string("<AdaptationSet")
      match write_opt_attr_str(sb, "id", a.id) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      write_opt_attr_i64(sb, "group", a.group)
      match a.content_type {
        Some(ct) => {
          match write_attr(sb, "contentType", content_type_to_string(ct)) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        None => ()
      }
      match write_opt_attr_str(sb, "mimeType", a.mime_type) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match write_opt_attr_str(sb, "codecs", a.codecs) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match write_opt_attr_str(sb, "lang", a.lang) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      write_opt_attr_bool(sb, "segmentAlignment", a.segment_alignment)
      write_opt_attr_bool(sb, "subsegmentAlignment", a.subsegment_alignment)
      write_opt_attr_bool(sb, "bitstreamSwitching", a.bitstream_switching)
      write_opt_attr_i64(sb, "minBandwidth", a.min_bandwidth)
      write_opt_attr_i64(sb, "maxBandwidth", a.max_bandwidth)
      write_opt_attr_i64(sb, "minWidth", a.min_width)
      write_opt_attr_i64(sb, "maxWidth", a.max_width)
      write_opt_attr_i64(sb, "minHeight", a.min_height)
      write_opt_attr_i64(sb, "maxHeight", a.max_height)
      match write_opt_attr_str(sb, "par", a.par) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      write_opt_attr_rational(sb, "frameRate", a.frame_rate)
      match write_opt_attr_str(sb, "sar", a.sar) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match write_opt_attr_str(sb, "audioSamplingRate", a.audio_sampling_rate) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      write_opt_attr_i64(sb, "startWithSAP", a.start_with_sap)
      sb.write_string(">\n")

      let mut j = 0
      while j < a.base_urls.length() {
        match write_text_elem(sb, 3, "BaseURL", a.base_urls[j]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        j = j + 1
      }
      j = 0
      while j < a.roles.length() {
        match write_descriptor(sb, 3, "Role", a.roles[j]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        j = j + 1
      }
      j = 0
      while j < a.content_protections.length() {
        match write_content_protection(sb, 3, a.content_protections[j]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        j = j + 1
      }
      j = 0
      while j < a.accessibilities.length() {
        match write_descriptor(sb, 3, "Accessibility", a.accessibilities[j]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        j = j + 1
      }
      j = 0
      while j < a.audio_channel_configurations.length() {
        match write_descriptor(sb, 3, "AudioChannelConfiguration", a.audio_channel_configurations[j]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        j = j + 1
      }
      j = 0
      while j < a.supplemental_properties.length() {
        match write_descriptor(sb, 3, "SupplementalProperty", a.supplemental_properties[j]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        j = j + 1
      }
      j = 0
      while j < a.essential_properties.length() {
        match write_descriptor(sb, 3, "EssentialProperty", a.essential_properties[j]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        j = j + 1
      }
      match a.segment_base {
        Some(s) => {
          match write_segment_base(sb, 3, s) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        None => ()
      }
      match a.segment_list {
        Some(s) => {
          match write_segment_list(sb, 3, s) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        None => ()
      }
      match a.segment_template {
        Some(s) => {
          match write_segment_template(sb, 3, s) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        None => ()
      }

      let mut ri = 0
      while ri < a.representations.length() {
        let r = a.representations[ri]
        write_indent(sb, 3)
        sb.write_string("<Representation")
        match write_attr(sb, "id", r.id) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        sb.write_string(" bandwidth=\"")
        sb.write_string(r.bandwidth.to_string())
        sb.write_string("\"")
        write_opt_attr_i64(sb, "width", r.width)
        write_opt_attr_i64(sb, "height", r.height)
        write_opt_attr_rational(sb, "frameRate", r.frame_rate)
        match write_opt_attr_str(sb, "sar", r.sar) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match write_opt_attr_str(sb, "codecs", r.codecs) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match write_opt_attr_str(sb, "mimeType", r.mime_type) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match write_opt_attr_str(sb, "audioSamplingRate", r.audio_sampling_rate) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        write_opt_attr_i64(sb, "startWithSAP", r.start_with_sap)

        let has_children = r.base_urls.length() > 0 ||
        r.content_protections.length() > 0 ||
        r.audio_channel_configurations.length() > 0 ||
        r.segment_base is Some(_) ||
        r.segment_list is Some(_) ||
        r.segment_template is Some(_)
        if !has_children {
          sb.write_string("/>\n")
        } else {
          sb.write_string(">\n")
          let mut k = 0
          while k < r.base_urls.length() {
            match write_text_elem(sb, 4, "BaseURL", r.base_urls[k]) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            k = k + 1
          }
          k = 0
          while k < r.content_protections.length() {
            match write_content_protection(sb, 4, r.content_protections[k]) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            k = k + 1
          }
          k = 0
          while k < r.audio_channel_configurations.length() {
            match write_descriptor(sb, 4, "AudioChannelConfiguration", r.audio_channel_configurations[k]) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            k = k + 1
          }
          match r.segment_base {
            Some(s) => {
              match write_segment_base(sb, 4, s) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
            }
            None => ()
          }
          match r.segment_list {
            Some(s) => {
              match write_segment_list(sb, 4, s) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
            }
            None => ()
          }
          match r.segment_template {
            Some(s) => {
              match write_segment_template(sb, 4, s) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
            }
            None => ()
          }
          write_indent(sb, 3)
          sb.write_string("</Representation>\n")
        }
        ri = ri + 1
      }

      write_indent(sb, 2)
      sb.write_string("</AdaptationSet>\n")
      ai = ai + 1
    }

    write_indent(sb, 1)
    sb.write_string("</Period>\n")
    pi = pi + 1
  }

  sb.write_string("</MPD>\n")
  Ok(sb.to_string())
}
