///| Core types, limits, and errors for `dash` (ISO/IEC 23009-1 MPEG-DASH).
///| 100% pure Pion, zero external dependencies, Wasm32-compatible, Send-safe.

///| Structured error variants for MPEG-DASH parsing, resolution, and formatting.
pub enum DashError {
  InvalidXml(String)
  SecurityRejected(String)
  InvalidMpd(String)
  InvalidDuration(String)
  InvalidDateTime(String)
  InvalidNumber(String)
  InvalidTemplate(String)
  IndexOutOfBounds(String)
  LimitExceeded(String)
}

///|
pub fn dash_error_to_string(err : DashError) -> String {
  match err {
    DashError::InvalidXml(m) => "InvalidXml: " + m
    DashError::SecurityRejected(m) => "SecurityRejected: " + m
    DashError::InvalidMpd(m) => "InvalidMpd: " + m
    DashError::InvalidDuration(m) => "InvalidDuration: " + m
    DashError::InvalidDateTime(m) => "InvalidDateTime: " + m
    DashError::InvalidNumber(m) => "InvalidNumber: " + m
    DashError::InvalidTemplate(m) => "InvalidTemplate: " + m
    DashError::IndexOutOfBounds(m) => "IndexOutOfBounds: " + m
    DashError::LimitExceeded(m) => "LimitExceeded: " + m
  }
}

///| Resource and DoS protection limits enforced during parsing and segment expansion.
///| Any negative limit immediately returns `Err(DashError::LimitExceeded(_))`.
///| A limit of `0` strictly permits 0 items.
pub struct DashLimits {
  pub max_input_bytes : Int
  pub max_xml_depth : Int
  pub max_elements : Int
  pub max_attributes : Int
  pub max_periods : Int
  pub max_adaptation_sets : Int
  pub max_representations : Int
  pub max_segments : Int
  pub max_timeline_entries : Int
  pub max_text_bytes : Int
}

///|
pub fn DashLimits::default() -> DashLimits {
  DashLimits::{
    max_input_bytes: 16777216,
    max_xml_depth: 64,
    max_elements: 200000,
    max_attributes: 256,
    max_periods: 1024,
    max_adaptation_sets: 1024,
    max_representations: 4096,
    max_segments: 100000,
    max_timeline_entries: 100000,
    max_text_bytes: 1048576,
  }
}

///| Exact integer rational number (`num / den`, `den > 0`), used for frameRate/SAR/PAR.
pub val struct Rational {
  pub num : Int64
  pub den : Int64
}

///|
pub fn Rational::new(num : Int64, den : Int64) -> Rational {
  Rational::{ num: num, den: den }
}

///| MPD presentation type (`static` for VOD, `dynamic` for live/linear).
pub enum MpdType {
  Static
  Dynamic
}

///|
pub fn mpd_type_to_string(t : MpdType) -> String {
  match t {
    MpdType::Static => "static"
    MpdType::Dynamic => "dynamic"
  }
}

///| AdaptationSet contentType classification.
pub enum ContentType {
  Video
  Audio
  Text
  Image
  Other(String)
}

///|
pub fn content_type_to_string(ct : ContentType) -> String {
  match ct {
    ContentType::Video => "video"
    ContentType::Audio => "audio"
    ContentType::Text => "text"
    ContentType::Image => "image"
    ContentType::Other(s) => s
  }
}

///| Generic DASH descriptor (`Role`, `Accessibility`, `AudioChannelConfiguration`,
///| `SupplementalProperty`, `EssentialProperty`, `UTCTiming`).
pub struct Descriptor {
  pub scheme_id_uri : String
  pub value : Option[String]
  pub id : Option[String]
}

///| DRM / ContentProtection descriptor with CENC `default_KID` and `<cenc:pssh>` payloads.
pub struct ContentProtection {
  pub scheme_id_uri : String
  pub value : Option[String]
  pub default_kid : Option[String]
  pub pssh : Array[String]
}

///| `<SegmentBase>` element for single-segment / byte-range indexed streams.
pub struct SegmentBase {
  pub timescale : Option[Int64]
  pub presentation_time_offset : Option[Int64]
  pub index_range : Option[String]
  pub index_range_exact : Option[Bool]
  pub initialization_source_url : Option[String]
  pub initialization_range : Option[String]
}

///| `<SegmentURL>` entry inside `<SegmentList>`.
pub struct SegmentUrl {
  pub media : Option[String]
  pub media_range : Option[String]
  pub index : Option[String]
  pub index_range : Option[String]
}

///| `<SegmentList>` element.
pub struct SegmentList {
  pub timescale : Option[Int64]
  pub duration : Option[Int64]
  pub start_number : Option[Int64]
  pub presentation_time_offset : Option[Int64]
  pub initialization_source_url : Option[String]
  pub initialization_range : Option[String]
  pub segment_urls : Array[SegmentUrl]
}

///| `<S t="..." d="..." r="..."/>` entry inside `<SegmentTimeline>`.
pub val struct SegmentTimelineEntry {
  pub t : Option[Int64]
  pub d : Int64
  pub r : Int64
}

///| `<SegmentTemplate>` element with optional `<SegmentTimeline>`.
pub struct SegmentTemplate {
  pub timescale : Option[Int64]
  pub duration : Option[Int64]
  pub start_number : Option[Int64]
  pub presentation_time_offset : Option[Int64]
  pub initialization : Option[String]
  pub media : Option[String]
  pub timeline : Array[SegmentTimelineEntry]
}

///| `<Representation>` element.
pub struct Representation {
  pub id : String
  pub bandwidth : Int64
  pub width : Option[Int64]
  pub height : Option[Int64]
  pub frame_rate : Option[Rational]
  pub sar : Option[String]
  pub codecs : Option[String]
  pub mime_type : Option[String]
  pub audio_sampling_rate : Option[String]
  pub start_with_sap : Option[Int64]
  pub base_urls : Array[String]
  pub content_protections : Array[ContentProtection]
  pub audio_channel_configurations : Array[Descriptor]
  pub segment_base : Option[SegmentBase]
  pub segment_list : Option[SegmentList]
  pub segment_template : Option[SegmentTemplate]
}

///| `<AdaptationSet>` element.
pub struct AdaptationSet {
  pub id : Option[String]
  pub group : Option[Int64]
  pub content_type : Option[ContentType]
  pub mime_type : Option[String]
  pub codecs : Option[String]
  pub lang : Option[String]
  pub segment_alignment : Option[Bool]
  pub subsegment_alignment : Option[Bool]
  pub bitstream_switching : Option[Bool]
  pub min_bandwidth : Option[Int64]
  pub max_bandwidth : Option[Int64]
  pub min_width : Option[Int64]
  pub max_width : Option[Int64]
  pub min_height : Option[Int64]
  pub max_height : Option[Int64]
  pub par : Option[String]
  pub frame_rate : Option[Rational]
  pub sar : Option[String]
  pub audio_sampling_rate : Option[String]
  pub start_with_sap : Option[Int64]
  pub base_urls : Array[String]
  pub roles : Array[Descriptor]
  pub content_protections : Array[ContentProtection]
  pub accessibilities : Array[Descriptor]
  pub audio_channel_configurations : Array[Descriptor]
  pub supplemental_properties : Array[Descriptor]
  pub essential_properties : Array[Descriptor]
  pub segment_base : Option[SegmentBase]
  pub segment_list : Option[SegmentList]
  pub segment_template : Option[SegmentTemplate]
  pub representations : Array[Representation]
}

///| `<Period>` element.
pub struct Period {
  pub id : Option[String]
  pub start_us : Option[Int64]
  pub duration_us : Option[Int64]
  pub bitstream_switching : Option[Bool]
  pub base_urls : Array[String]
  pub segment_base : Option[SegmentBase]
  pub segment_list : Option[SegmentList]
  pub segment_template : Option[SegmentTemplate]
  pub adaptation_sets : Array[AdaptationSet]
}

///| Top-level `<MPD>` Media Presentation Description.
pub struct Mpd {
  pub id : Option[String]
  pub mpd_type : MpdType
  pub profiles : String
  pub media_presentation_duration_us : Option[Int64]
  pub min_buffer_time_us : Option[Int64]
  pub minimum_update_period_us : Option[Int64]
  pub availability_start_time : Option[String]
  pub availability_start_time_us : Option[Int64]
  pub publish_time : Option[String]
  pub publish_time_us : Option[Int64]
  pub time_shift_buffer_depth_us : Option[Int64]
  pub suggested_presentation_delay_us : Option[Int64]
  pub max_segment_duration_us : Option[Int64]
  pub base_urls : Array[String]
  pub locations : Array[String]
  pub utc_timings : Array[Descriptor]
  pub periods : Array[Period]
}

///| A single resolved media segment produced by `resolve_segments`.
pub struct ResolvedSegment {
  pub number : Int64
  pub url : String
  pub start_time : Int64
  pub duration : Int64
  pub timescale : Int64
  pub media_range : Option[String]
}

///| Resolved initialization and media segments for a specific Representation.
pub struct ResolvedTrack {
  pub initialization_url : Option[String]
  pub initialization_range : Option[String]
  pub index_range : Option[String]
  pub segments : Array[ResolvedSegment]
}
