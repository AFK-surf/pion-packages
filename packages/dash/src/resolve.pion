///| Hierarchical BaseURL resolution (RFC 3986 §5.2), ISO/IEC 23009-1 §5.3.9.4.4
///| SegmentTemplate URL expansion, and segment timeline / list / base resolver
///| with strict overflow, PTO, Period timing inference, and aggregate output byte bounds.

fn url_scheme_end(s : String) -> Int {
  let n = s.length()
  if n == 0 {
    return -1
  }
  let c0 = s.code_unit_at(0)
  let is_alpha0 = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)
  if !is_alpha0 {
    return -1
  }
  let mut i = 1
  while i < n {
    let c = s.code_unit_at(i)
    if c == 58 {
      return i
    }
    let ok = (c >= 65 && c <= 90) ||
    (c >= 97 && c <= 122) ||
    (c >= 48 && c <= 57) ||
    c == 43 ||
    c == 45 ||
    c == 46
    if !ok {
      return -1
    }
    i = i + 1
  }
  -1
}

struct UriRef {
  scheme : Option[String]
  auth : Option[String]
  path : String
  query : Option[String]
  frag : Option[String]
}

///| RFC 3986 Appendix B split.
fn split_uri_ref(u : String) -> UriRef {
  let n = u.length()
  let mut i = 0
  let mut scheme : Option[String] = None
  let sc = url_scheme_end(u)
  if sc >= 0 {
    scheme = Some(u.slice(0, sc))
    i = sc + 1
  }
  // Find '#'
  let mut hash_pos = -1
  let mut k = i
  while k < n {
    if u.code_unit_at(k) == 35 {
      hash_pos = k
      break
    }
    k = k + 1
  }
  let frag : Option[String] = if hash_pos >= 0 { Some(u.slice(hash_pos + 1, n)) } else { None }
  let before_frag = if hash_pos >= 0 { hash_pos } else { n }

  // Find '?' before '#'
  let mut q_pos = -1
  k = i
  while k < before_frag {
    if u.code_unit_at(k) == 63 {
      q_pos = k
      break
    }
    k = k + 1
  }
  let query : Option[String] = if q_pos >= 0 { Some(u.slice(q_pos + 1, before_frag)) } else { None }
  let before_q = if q_pos >= 0 { q_pos } else { before_frag }

  // Authority if rest starts with "//"
  let mut auth : Option[String] = None
  if i + 1 < before_q && u.code_unit_at(i) == 47 && u.code_unit_at(i + 1) == 47 {
    let mut aend = i + 2
    while aend < before_q && u.code_unit_at(aend) != 47 {
      aend = aend + 1
    }
    auth = Some(u.slice(i + 2, aend))
    i = aend
  }
  let path = u.slice(i, before_q)
  UriRef::{ scheme: scheme, auth: auth, path: path, query: query, frag: frag }
}

///| O(n) RFC 3986 §5.2.4 `remove_dot_segments`.
fn remove_dot_segments(path : String) -> String {
  let n = path.length()
  let out : Array[String] = []
  let mut pos = 0
  while pos < n {
    let rem = n - pos
    let c0 = path.code_unit_at(pos)
    // A: "../" or "./"
    if rem >= 3 && c0 == 46 && path.code_unit_at(pos + 1) == 46 && path.code_unit_at(pos + 2) == 47 {
      pos = pos + 3
    } else if rem >= 2 && c0 == 46 && path.code_unit_at(pos + 1) == 47 {
      pos = pos + 2
    } else if rem >= 3 && c0 == 47 && path.code_unit_at(pos + 1) == 46 && path.code_unit_at(pos + 2) == 47 {
      // B1: "/./" -> "/"
      pos = pos + 2
    } else if rem == 2 && c0 == 47 && path.code_unit_at(pos + 1) == 46 {
      // B2: "/." -> "/"
      out.push("/")
      pos = n
    } else if rem >= 4 &&
    c0 == 47 &&
    path.code_unit_at(pos + 1) == 46 &&
    path.code_unit_at(pos + 2) == 46 &&
    path.code_unit_at(pos + 3) == 47 {
      // C1: "/../" -> "/" and pop last output segment
      if out.length() > 0 {
        let _ = out.pop()
      }
      pos = pos + 3
    } else if rem == 3 && c0 == 47 && path.code_unit_at(pos + 1) == 46 && path.code_unit_at(pos + 2) == 46 {
      // C2: "/.." -> "/" and pop last output segment
      if out.length() > 0 {
        let _ = out.pop()
      }
      out.push("/")
      pos = n
    } else if (rem == 1 && c0 == 46) || (rem == 2 && c0 == 46 && path.code_unit_at(pos + 1) == 46) {
      // D: "." or ".."
      pos = n
    } else {
      // E: move first path segment (including initial '/' if any) to output
      let start = pos
      if c0 == 47 {
        pos = pos + 1
      }
      while pos < n && path.code_unit_at(pos) != 47 {
        pos = pos + 1
      }
      out.push(path.slice(start, pos))
    }
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < out.length() {
    sb.write_string(out[i])
    i = i + 1
  }
  sb.to_string()
}

///| O(n) dot-segment normalisation for rootless relative paths (relative BaseURL chains):
///| preserves unresolvable leading `..`, preserves empty segments, and keeps a trailing `/`
///| after a final `.` or `..`.
fn rootless_norm(path : String) -> String {
  let n = path.length()
  let out : Array[String] = []
  let mut pos = 0
  while true {
    let mut end = pos
    while end < n && path.code_unit_at(end) != 47 {
      end = end + 1
    }
    let last = end >= n
    let sg = path.slice(pos, end)
    if sg == "." {
      if last {
        out.push("")
      }
    } else if sg == ".." {
      if out.length() > 0 && out[out.length() - 1] != ".." {
        let _ = out.pop()
      } else {
        out.push("..")
      }
      if last {
        out.push("")
      }
    } else {
      out.push(sg)
    }
    if last {
      break
    }
    pos = end + 1
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < out.length() {
    if i > 0 {
      sb.write_string("/")
    }
    sb.write_string(out[i])
    i = i + 1
  }
  sb.to_string()
}

fn recompose_uri(
  scheme : Option[String],
  auth : Option[String],
  path : String,
  query : Option[String],
  frag : Option[String],
) -> String {
  let sb = StringBuilder::new()
  match scheme {
    Some(s) => {
      sb.write_string(s)
      sb.write_string(":")
    }
    None => ()
  }
  match auth {
    Some(a) => {
      sb.write_string("//")
      sb.write_string(a)
    }
    None => ()
  }
  sb.write_string(path)
  match query {
    Some(q) => {
      sb.write_string("?")
      sb.write_string(q)
    }
    None => ()
  }
  match frag {
    Some(f) => {
      sb.write_string("#")
      sb.write_string(f)
    }
    None => ()
  }
  sb.to_string()
}

///| Resolve a relative URL against a base URL following RFC 3986 §5.2.
pub fn resolve_url(base : String, rel : String) -> String {
  if rel.length() == 0 {
    return base
  }
  if base.length() == 0 {
    return rel
  }
  let r = split_uri_ref(rel)
  let b = split_uri_ref(base)
  let rs = r.scheme
  let ra = r.auth
  let rp = r.path
  let rq = r.query
  let rf = r.frag
  let bs = b.scheme
  let ba = b.auth
  let bp = b.path
  let bq = b.query

  let mut ts : Option[String] = None
  let mut ta : Option[String] = None
  let mut tp = ""
  let mut tq : Option[String] = None

  match rs {
    Some(_) => {
      ts = rs
      ta = ra
      tp = remove_dot_segments(rp)
      tq = rq
    }
    None => {
      match ra {
        Some(_) => {
          ta = ra
          tp = remove_dot_segments(rp)
          tq = rq
        }
        None => {
          if rp.length() == 0 {
            tp = bp
            tq = match rq {
              Some(_) => rq
              None => bq
            }
          } else {
            if rp.code_unit_at(0) == 47 {
              tp = remove_dot_segments(rp)
            } else {
              let merged = if ba is Some(_) && bp.length() == 0 {
                "/" + rp
              } else {
                let mut last_slash = -1
                let mut k = bp.length() - 1
                while k >= 0 {
                  if bp.code_unit_at(k) == 47 {
                    last_slash = k
                    break
                  }
                  k = k - 1
                }
                if last_slash >= 0 {
                  bp.slice(0, last_slash + 1) + rp
                } else {
                  rp
                }
              }
              let rootless = bs is None && ba is None && (merged.length() == 0 || merged.code_unit_at(0) != 47)
              tp = if rootless { rootless_norm(merged) } else { remove_dot_segments(merged) }
            }
            tq = rq
          }
          ta = ba
        }
      }
      ts = bs
    }
  }
  recompose_uri(ts, ta, tp, tq, rf)
}

///| Pre-normalise the directory prefix of a resolved BaseURL once per track so that
///| resolving N segments does not repeatedly scan/normalise a huge BaseURL.
fn pre_normalize_base_url(base : String) -> String {
  if base.length() == 0 {
    return ""
  }
  let b = split_uri_ref(base)
  let bs = b.scheme
  let ba = b.auth
  let bp = b.path
  let bq = b.query
  let bf = b.frag
  if bp.length() == 0 {
    return base
  }
  let mut last_slash = -1
  let mut k = bp.length() - 1
  while k >= 0 {
    if bp.code_unit_at(k) == 47 {
      last_slash = k
      break
    }
    k = k - 1
  }
  if last_slash < 0 {
    return base
  }
  let dir = bp.slice(0, last_slash + 1)
  let tail = bp.slice(last_slash + 1, bp.length())
  let rootless = bs is None && ba is None && (dir.length() == 0 || dir.code_unit_at(0) != 47)
  let norm_dir = if rootless { rootless_norm(dir) } else { remove_dot_segments(dir) }
  recompose_uri(bs, ba, norm_dir + tail, bq, bf)
}

fn format_padded_i64(v : Int64, width : Int) -> String {
  let s = v.to_string()
  if width <= s.length() {
    return s
  }
  let sb = StringBuilder::new()
  let mut pad = width - s.length()
  while pad > 0 {
    sb.write_string("0")
    pad = pad - 1
  }
  sb.write_string(s)
  sb.to_string()
}

///| Parse optional `%0Nd` / `%Nd` width specifier from a template identifier suffix.
///| Enforces maximum width of 32 digits to block OOM/CPU width bombs.
fn parse_template_width(spec : String) -> Result[Int, DashError] {
  let n = spec.length()
  if n == 0 {
    return Ok(0)
  }
  if n < 2 || spec.code_unit_at(0) != 37 || spec.code_unit_at(n - 1) != 100 {
    return Err(DashError::InvalidTemplate("invalid format tag: " + spec))
  }
  let mut i = 1
  let mut width = 0
  let mut digits = 0
  while i < n - 1 {
    let c = spec.code_unit_at(i)
    if !is_ascii_digit(c) {
      return Err(DashError::InvalidTemplate("invalid width in format tag: " + spec))
    }
    width = width * 10 + (c - 48)
    digits = digits + 1
    if width > 32 || digits > 4 {
      return Err(DashError::LimitExceeded("template format width exceeds maximum (32): " + spec))
    }
    i = i + 1
  }
  Ok(width)
}

///| Internal bounded template expander: aborts immediately with `LimitExceeded` if the
///| expanded URL would exceed `max_bytes` (when `max_bytes >= 0`), preventing single-segment OOM.
fn expand_template_bounded(
  template : String,
  rep_id : String,
  number : Int64,
  bandwidth : Int64,
  time : Int64,
  max_bytes : Int64,
) -> Result[String, DashError] {
  let sb = StringBuilder::new()
  let mut out_len = 0L
  let n = template.length()
  let mut i = 0
  while i < n {
    if template.code_unit_at(i) != 36 {
      let start = i
      while i < n && template.code_unit_at(i) != 36 {
        i = i + 1
      }
      let seg = template.slice(start, i)
      out_len = out_len + seg.length().to_int64()
      if max_bytes >= 0L && out_len > max_bytes {
        return Err(DashError::LimitExceeded("expanded template URL exceeds max_output_bytes"))
      }
      sb.write_string(seg)
      continue
    }
    // Found '$'
    if i + 1 < n && template.code_unit_at(i + 1) == 36 {
      out_len = out_len + 1L
      if max_bytes >= 0L && out_len > max_bytes {
        return Err(DashError::LimitExceeded("expanded template URL exceeds max_output_bytes"))
      }
      sb.write_string("$")
      i = i + 2
      continue
    }
    let mut end = i + 1
    while end < n && template.code_unit_at(end) != 36 {
      end = end + 1
    }
    if end >= n {
      return Err(DashError::InvalidTemplate("unterminated '$' identifier in template"))
    }
    let token = template.slice(i + 1, end)
    let piece = if token == "RepresentationID" {
      rep_id
    } else if token == "Number" {
      number.to_string()
    } else if token.length() > 6 && token.slice(0, 6) == "Number" {
      let w = match parse_template_width(token.slice(6, token.length())) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      format_padded_i64(number, w)
    } else if token == "Bandwidth" {
      bandwidth.to_string()
    } else if token.length() > 9 && token.slice(0, 9) == "Bandwidth" {
      let w = match parse_template_width(token.slice(9, token.length())) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      format_padded_i64(bandwidth, w)
    } else if token == "Time" {
      time.to_string()
    } else if token.length() > 4 && token.slice(0, 4) == "Time" {
      let w = match parse_template_width(token.slice(4, token.length())) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      format_padded_i64(time, w)
    } else {
      return Err(DashError::InvalidTemplate("unknown template identifier: $" + token + "$"))
    }
    out_len = out_len + piece.length().to_int64()
    if max_bytes >= 0L && out_len > max_bytes {
      return Err(DashError::LimitExceeded("expanded template URL exceeds max_output_bytes"))
    }
    sb.write_string(piece)
    i = end + 1
  }
  Ok(sb.to_string())
}

///| Expand an ISO/IEC 23009-1 §5.3.9.4.4 SegmentTemplate URL template.
///| Supports `$$`, `$RepresentationID$`, `$Number[%0Nd]$`, `$Bandwidth[%0Nd]$`, `$Time[%0Nd]$`.
pub fn expand_template(
  template : String,
  rep_id : String,
  number : Int64,
  bandwidth : Int64,
  time : Int64,
) -> Result[String, DashError] {
  expand_template_bounded(template, rep_id, number, bandwidth, time, -1L)
}

fn opt_or_i64(a : Option[Int64], b : Option[Int64]) -> Option[Int64] {
  match a {
    Some(_) => a
    None => b
  }
}

fn opt_or_str(a : Option[String], b : Option[String]) -> Option[String] {
  match a {
    Some(_) => a
    None => b
  }
}

fn opt_or_bool(a : Option[Bool], b : Option[Bool]) -> Option[Bool] {
  match a {
    Some(_) => a
    None => b
  }
}

fn merge_segment_template(
  parent : Option[SegmentTemplate],
  child : Option[SegmentTemplate],
) -> Option[SegmentTemplate] {
  match (parent, child) {
    (None, None) => None
    (Some(p), None) => Some(p)
    (None, Some(c)) => Some(c)
    (Some(p), Some(c)) => {
      let tl = if c.timeline.length() > 0 { c.timeline } else { p.timeline }
      Some(SegmentTemplate::{
        timescale: opt_or_i64(c.timescale, p.timescale),
        duration: opt_or_i64(c.duration, p.duration),
        start_number: opt_or_i64(c.start_number, p.start_number),
        presentation_time_offset: opt_or_i64(c.presentation_time_offset, p.presentation_time_offset),
        initialization: opt_or_str(c.initialization, p.initialization),
        media: opt_or_str(c.media, p.media),
        timeline: tl,
      })
    }
    _ => None
  }
}

fn merge_segment_list(
  parent : Option[SegmentList],
  child : Option[SegmentList],
) -> Option[SegmentList] {
  match (parent, child) {
    (None, None) => None
    (Some(p), None) => Some(p)
    (None, Some(c)) => Some(c)
    (Some(p), Some(c)) => {
      let urls = if c.segment_urls.length() > 0 { c.segment_urls } else { p.segment_urls }
      Some(SegmentList::{
        timescale: opt_or_i64(c.timescale, p.timescale),
        duration: opt_or_i64(c.duration, p.duration),
        start_number: opt_or_i64(c.start_number, p.start_number),
        presentation_time_offset: opt_or_i64(c.presentation_time_offset, p.presentation_time_offset),
        initialization_source_url: opt_or_str(c.initialization_source_url, p.initialization_source_url),
        initialization_range: opt_or_str(c.initialization_range, p.initialization_range),
        segment_urls: urls,
      })
    }
    _ => None
  }
}

fn merge_segment_base(
  parent : Option[SegmentBase],
  child : Option[SegmentBase],
) -> Option[SegmentBase] {
  match (parent, child) {
    (None, None) => None
    (Some(p), None) => Some(p)
    (None, Some(c)) => Some(c)
    (Some(p), Some(c)) => {
      Some(SegmentBase::{
        timescale: opt_or_i64(c.timescale, p.timescale),
        presentation_time_offset: opt_or_i64(c.presentation_time_offset, p.presentation_time_offset),
        index_range: opt_or_str(c.index_range, p.index_range),
        index_range_exact: opt_or_bool(c.index_range_exact, p.index_range_exact),
        initialization_source_url: opt_or_str(c.initialization_source_url, p.initialization_source_url),
        initialization_range: opt_or_str(c.initialization_range, p.initialization_range),
      })
    }
    _ => None
  }
}

///| Infer Period@start per ISO/IEC 23009-1 §5.3.2.1:
///| - explicit `@start` if present;
///| - 0 for the first Period of a static MPD;
///| - previous Period's inferred start + explicit `@duration` if both are known.
fn compute_period_starts(mpd : Mpd) -> Array[Option[Int64]] {
  let n = mpd.periods.length()
  let starts : Array[Option[Int64]] = []
  let mut i = 0
  while i < n {
    let p = mpd.periods[i]
    let st = match p.start_us {
      Some(s) => Some(s)
      None => {
        if i == 0 {
          match mpd.mpd_type {
            MpdType::Static => Some(0L)
            MpdType::Dynamic => None
          }
        } else {
          match (starts[i - 1], mpd.periods[i - 1].duration_us) {
            (Some(ps), Some(pd)) => checked_add_i64(ps, pd)
            _ => None
          }
        }
      }
    }
    starts.push(st)
    i = i + 1
  }
  starts
}

fn effective_period_duration_us(mpd : Mpd, period_idx : Int) -> Option[Int64] {
  let period = mpd.periods[period_idx]
  match period.duration_us {
    Some(d) => Some(d)
    None => {
      let starts = compute_period_starts(mpd)
      if period_idx + 1 < mpd.periods.length() {
        match (starts[period_idx], starts[period_idx + 1]) {
          (Some(s0), Some(s1)) => {
            if s1 >= s0 {
              Some(s1 - s0)
            } else {
              None
            }
          }
          _ => None
        }
      } else {
        match mpd.media_presentation_duration_us {
          Some(total) => {
            let start = match starts[period_idx] {
              Some(s) => s
              None => 0L
            }
            if total >= start {
              Some(total - start)
            } else {
              Some(0L)
            }
          }
          None => None
        }
      }
    }
  }
}

///| Convert microseconds to timescale ticks without overflow, returning `(floor_ticks, has_fraction)`.
fn us_to_ticks_exact(us : Int64, timescale : Int64) -> Option[(Int64, Bool)] {
  let secs = us / 1000000L
  let rem_us = us % 1000000L
  let p1 = match checked_mul_i64(secs, timescale) {
    Some(v) => v
    None => return None
  }
  let prod2 = match checked_mul_i64(rem_us, timescale) {
    Some(v) => v
    None => return None
  }
  let p2 = prod2 / 1000000L
  let has_frac = (prod2 % 1000000L) != 0L
  match checked_add_i64(p1, p2) {
    Some(tk) => Some((tk, has_frac))
    None => None
  }
}

fn resolve_template_timeline(
  mpd : Mpd,
  period_idx : Int,
  rep : Representation,
  base : String,
  tpl : SegmentTemplate,
  timescale : Int64,
  start_num : Int64,
  media_tpl : String,
  limits : DashLimits,
  max_out : Int64,
  init_out_bytes : Int64,
) -> Result[Array[ResolvedSegment], DashError] {
  let segments : Array[ResolvedSegment] = []
  let mut out_bytes = init_out_bytes
  let pto = match tpl.presentation_time_offset {
    Some(v) => v
    None => 0L
  }
  let period_end_ticks = match effective_period_duration_us(mpd, period_idx) {
    Some(dur_us) => {
      match us_to_ticks_exact(dur_us, timescale) {
        Some((tk, has_frac)) => {
          let adj = if has_frac {
            match checked_add_i64(tk, 1L) {
              Some(v) => v
              None => return Err(DashError::InvalidNumber("period end ticks overflow"))
            }
          } else {
            tk
          }
          match checked_add_i64(adj, pto) {
            Some(pe) => Some(pe)
            None => return Err(DashError::InvalidNumber("period end + PTO overflow"))
          }
        }
        None => None
      }
    }
    None => None
  }
  let mut cur_time = 0L
  let mut cur_num = start_num
  let mut num_overflowed = false
  let mut ti = 0
  while ti < tpl.timeline.length() {
    let entry = tpl.timeline[ti]
    match entry.t {
      Some(t) => cur_time = t
      None => ()
    }
    let d = entry.d
    let seg_count = if entry.r >= 0L {
      if entry.r >= limits.max_segments.to_int64() {
        return Err(DashError::LimitExceeded("SegmentTimeline repeat count exceeds max_segments"))
      }
      entry.r + 1L
    } else {
      if entry.r < -1L {
        return Err(DashError::InvalidMpd("SegmentTimeline S@r must be >= -1"))
      }
      let end_time_opt = if ti + 1 < tpl.timeline.length() {
        tpl.timeline[ti + 1].t
      } else {
        period_end_ticks
      }
      match end_time_opt {
        Some(end_t) => {
          if end_t <= cur_time {
            0L
          } else {
            let span = end_t - cur_time
            let q = span / d
            let rem = span % d
            let cnt = if rem > 0L { q + 1L } else { q }
            if cnt > limits.max_segments.to_int64() {
              return Err(DashError::LimitExceeded("SegmentTimeline r<0 expansion exceeds max_segments"))
            }
            cnt
          }
        }
        None => 1L
      }
    }

    let mut k = 0L
    while k < seg_count {
      if segments.length() >= limits.max_segments {
        return Err(DashError::LimitExceeded("resolved segments exceed max_segments"))
      }
      if num_overflowed {
        return Err(DashError::InvalidNumber("segment number Int64 overflow"))
      }
      let next_time = match checked_add_i64(cur_time, d) {
        Some(nt) => nt
        None => return Err(DashError::InvalidNumber("SegmentTimeline time Int64 overflow"))
      }
      let rem_budget = max_out - out_bytes
      let expanded = match expand_template_bounded(media_tpl, rep.id, cur_num, rep.bandwidth, cur_time, rem_budget) {
        Ok(u) => u
        Err(e) => return Err(e)
      }
      let seg_url = resolve_url(base, expanded)
      out_bytes = out_bytes + seg_url.length().to_int64()
      if out_bytes > max_out {
        return Err(DashError::LimitExceeded("resolved segment URLs exceed max_output_bytes"))
      }
      segments.push(ResolvedSegment::{
        number: cur_num,
        url: seg_url,
        start_time: cur_time,
        duration: d,
        timescale: timescale,
        media_range: None,
      })
      cur_time = next_time
      match checked_add_i64(cur_num, 1L) {
        Some(nn) => cur_num = nn
        None => num_overflowed = true
      }
      k = k + 1L
    }
    ti = ti + 1
  }
  Ok(segments)
}

fn resolve_template_duration(
  mpd : Mpd,
  period_idx : Int,
  rep : Representation,
  base : String,
  tpl : SegmentTemplate,
  timescale : Int64,
  start_num : Int64,
  media_tpl : String,
  limits : DashLimits,
  max_out : Int64,
  init_out_bytes : Int64,
) -> Result[Array[ResolvedSegment], DashError] {
  let segments : Array[ResolvedSegment] = []
  let mut out_bytes = init_out_bytes
  let seg_dur = match tpl.duration {
    Some(d) => d
    None => return Ok(segments)
  }
  let dur_us = match effective_period_duration_us(mpd, period_idx) {
    Some(d) => d
    None => return Ok(segments)
  }
  let (total_ticks, has_frac) = match us_to_ticks_exact(dur_us, timescale) {
    Some(v) => v
    None => return Err(DashError::InvalidNumber("period duration ticks overflow"))
  }
  let q = total_ticks / seg_dur
  let rem = total_ticks % seg_dur
  let count = if has_frac {
    q + 1L
  } else if rem > 0L {
    q + 1L
  } else {
    q
  }
  if count > limits.max_segments.to_int64() {
    return Err(DashError::LimitExceeded("duration-based segment count exceeds max_segments"))
  }
  let mut cur_time = 0L
  let mut cur_num = start_num
  let mut num_overflowed = false
  let mut k = 0L
  while k < count {
    if segments.length() >= limits.max_segments {
      return Err(DashError::LimitExceeded("resolved segments exceed max_segments"))
    }
    if num_overflowed {
      return Err(DashError::InvalidNumber("segment number Int64 overflow"))
    }
    let next_time = match checked_add_i64(cur_time, seg_dur) {
      Some(nt) => nt
      None => return Err(DashError::InvalidNumber("segment time Int64 overflow"))
    }
    let rem_budget = max_out - out_bytes
    let expanded = match expand_template_bounded(media_tpl, rep.id, cur_num, rep.bandwidth, cur_time, rem_budget) {
      Ok(u) => u
      Err(e) => return Err(e)
    }
    let seg_url = resolve_url(base, expanded)
    out_bytes = out_bytes + seg_url.length().to_int64()
    if out_bytes > max_out {
      return Err(DashError::LimitExceeded("resolved segment URLs exceed max_output_bytes"))
    }
    segments.push(ResolvedSegment::{
      number: cur_num,
      url: seg_url,
      start_time: cur_time,
      duration: seg_dur,
      timescale: timescale,
      media_range: None,
    })
    cur_time = next_time
    match checked_add_i64(cur_num, 1L) {
      Some(nn) => cur_num = nn
      None => num_overflowed = true
    }
    k = k + 1L
  }
  Ok(segments)
}

fn resolve_segment_list(
  sl : SegmentList,
  base : String,
  limits : DashLimits,
  max_out : Int64,
) -> Result[ResolvedTrack, DashError] {
  let mut out_bytes = 0L
  let timescale = match sl.timescale {
    Some(ts) => ts
    None => 1L
  }
  let seg_dur = match sl.duration {
    Some(d) => d
    None => 0L
  }
  let start_num = match sl.start_number {
    Some(sn) => sn
    None => 1L
  }
  let init_url = match sl.initialization_source_url {
    Some(u) => Some(resolve_url(base, u))
    None => if sl.initialization_range is Some(_) && base.length() > 0 { Some(base) } else { None }
  }
  match init_url {
    Some(u) => {
      out_bytes = out_bytes + u.length().to_int64()
      if out_bytes > max_out {
        return Err(DashError::LimitExceeded("resolved URLs exceed max_output_bytes"))
      }
    }
    None => ()
  }
  if sl.segment_urls.length() > limits.max_segments {
    return Err(DashError::LimitExceeded("SegmentList entries exceed max_segments"))
  }
  let segments : Array[ResolvedSegment] = []
  let mut cur_time = 0L
  let mut i = 0
  while i < sl.segment_urls.length() {
    let seg_num = match checked_add_i64(start_num, i.to_int64()) {
      Some(n) => n
      None => return Err(DashError::InvalidNumber("SegmentList segment number Int64 overflow"))
    }
    let su = sl.segment_urls[i]
    let url = match su.media {
      Some(m) => resolve_url(base, m)
      None => base
    }
    out_bytes = out_bytes + url.length().to_int64()
    if out_bytes > max_out {
      return Err(DashError::LimitExceeded("resolved segment URLs exceed max_output_bytes"))
    }
    segments.push(ResolvedSegment::{
      number: seg_num,
      url: url,
      start_time: cur_time,
      duration: seg_dur,
      timescale: timescale,
      media_range: su.media_range,
    })
    if seg_dur > 0L {
      cur_time = match checked_add_i64(cur_time, seg_dur) {
        Some(nt) => nt
        None => return Err(DashError::InvalidNumber("SegmentList time overflow"))
      }
    }
    i = i + 1
  }
  Ok(ResolvedTrack::{
    initialization_url: init_url,
    initialization_range: sl.initialization_range,
    index_range: None,
    segments: segments,
  })
}

///| Resolve initialization and media segment URLs and timeline for a specific Representation.
pub fn resolve_segments(
  mpd : Mpd,
  period_idx : Int,
  as_idx : Int,
  rep_idx : Int,
  limits : DashLimits,
) -> Result[ResolvedTrack, DashError] {
  match xml_validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if period_idx < 0 || period_idx >= mpd.periods.length() {
    return Err(DashError::IndexOutOfBounds("period_idx out of bounds"))
  }
  let period = mpd.periods[period_idx]
  if as_idx < 0 || as_idx >= period.adaptation_sets.length() {
    return Err(DashError::IndexOutOfBounds("as_idx out of bounds"))
  }
  let aset = period.adaptation_sets[as_idx]
  if rep_idx < 0 || rep_idx >= aset.representations.length() {
    return Err(DashError::IndexOutOfBounds("rep_idx out of bounds"))
  }
  let rep = aset.representations[rep_idx]

  // Hierarchical BaseURL chain: MPD -> Period -> AdaptationSet -> Representation
  let mut base = ""
  if mpd.base_urls.length() > 0 {
    base = resolve_url(base, mpd.base_urls[0])
  }
  if period.base_urls.length() > 0 {
    base = resolve_url(base, period.base_urls[0])
  }
  if aset.base_urls.length() > 0 {
    base = resolve_url(base, aset.base_urls[0])
  }
  if rep.base_urls.length() > 0 {
    base = resolve_url(base, rep.base_urls[0])
  }
  // Pre-normalise the BaseURL directory once per track for segment URL resolution
  // to prevent O(|BaseURL| * N) CPU bombs, while keeping `base` for bare/SegmentBase presence checks.
  let seg_base_url = pre_normalize_base_url(base)

  let max_out = limits.max_output_bytes.to_int64()
  let mut out_bytes = 0L

  let tpl_opt = merge_segment_template(
    merge_segment_template(period.segment_template, aset.segment_template),
    rep.segment_template,
  )
  let list_opt = merge_segment_list(
    merge_segment_list(period.segment_list, aset.segment_list),
    rep.segment_list,
  )
  let base_opt = merge_segment_base(
    merge_segment_base(period.segment_base, aset.segment_base),
    rep.segment_base,
  )

  // 1. SegmentTemplate
  match tpl_opt {
    Some(tpl) => {
      let timescale = match tpl.timescale {
        Some(ts) => ts
        None => 1L
      }
      let start_num = match tpl.start_number {
        Some(sn) => sn
        None => 1L
      }
      let init_url = match tpl.initialization {
        Some(itpl) => {
          match expand_template_bounded(itpl, rep.id, start_num, rep.bandwidth, 0L, max_out) {
            Ok(u) => {
              let resolved = resolve_url(seg_base_url, u)
              out_bytes = out_bytes + resolved.length().to_int64()
              if out_bytes > max_out {
                return Err(DashError::LimitExceeded("resolved URLs exceed max_output_bytes"))
              }
              Some(resolved)
            }
            Err(e) => return Err(e)
          }
        }
        None => None
      }
      let media_tpl = match tpl.media {
        Some(m) => m
        None => {
          return Ok(ResolvedTrack::{
            initialization_url: init_url,
            initialization_range: None,
            index_range: None,
            segments: [],
          })
        }
      }
      let segments = if tpl.timeline.length() > 0 {
        match resolve_template_timeline(
          mpd, period_idx, rep, seg_base_url, tpl, timescale, start_num, media_tpl, limits, max_out, out_bytes,
        ) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
      } else {
        match resolve_template_duration(
          mpd, period_idx, rep, seg_base_url, tpl, timescale, start_num, media_tpl, limits, max_out, out_bytes,
        ) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
      }
      return Ok(ResolvedTrack::{
        initialization_url: init_url,
        initialization_range: None,
        index_range: None,
        segments: segments,
      })
    }
    None => ()
  }

  // 2. SegmentList
  match list_opt {
    Some(sl) => return resolve_segment_list(sl, seg_base_url, limits, max_out)
    None => ()
  }

  // 3. SegmentBase (or bare BaseURL single-segment representation)
  match base_opt {
    Some(sb) => {
      let timescale = match sb.timescale {
        Some(ts) => ts
        None => 1L
      }
      let init_url = match sb.initialization_source_url {
        Some(u) => Some(resolve_url(base, u))
        None => if base.length() > 0 { Some(base) } else { None }
      }
      match init_url {
        Some(u) => {
          out_bytes = out_bytes + u.length().to_int64()
          if out_bytes > max_out {
            return Err(DashError::LimitExceeded("resolved URLs exceed max_output_bytes"))
          }
        }
        None => ()
      }
      let segments : Array[ResolvedSegment] = []
      if base.length() > 0 {
        if limits.max_segments < 1 {
          return Err(DashError::LimitExceeded("max_segments=0 rejects SegmentBase media segment"))
        }
        out_bytes = out_bytes + base.length().to_int64()
        if out_bytes > max_out {
          return Err(DashError::LimitExceeded("resolved segment URLs exceed max_output_bytes"))
        }
        let dur_ticks = match effective_period_duration_us(mpd, period_idx) {
          Some(dur_us) => {
            match us_to_ticks_exact(dur_us, timescale) {
              Some((t, _)) => t
              None => 0L
            }
          }
          None => 0L
        }
        segments.push(ResolvedSegment::{
          number: 1L,
          url: base,
          start_time: 0L,
          duration: dur_ticks,
          timescale: timescale,
          media_range: None,
        })
      }
      return Ok(ResolvedTrack::{
        initialization_url: init_url,
        initialization_range: sb.initialization_range,
        index_range: sb.index_range,
        segments: segments,
      })
    }
    None => ()
  }

  // Bare representation without segment container
  let segments : Array[ResolvedSegment] = []
  if base.length() > 0 && limits.max_segments >= 1 {
    if base.length().to_int64() > max_out {
      return Err(DashError::LimitExceeded("resolved segment URLs exceed max_output_bytes"))
    }
    segments.push(ResolvedSegment::{
      number: 1L,
      url: base,
      start_time: 0L,
      duration: 0L,
      timescale: 1L,
      media_range: None,
    })
  }
  Ok(ResolvedTrack::{
    initialization_url: None,
    initialization_range: None,
    index_range: None,
    segments: segments,
  })
}
