///| Hierarchical BaseURL resolution, ISO/IEC 23009-1 §5.3.9.4.4 SegmentTemplate URL expansion,
///| and segment timeline / list / base resolver with strict overflow and DoS bounds.

fn url_scheme_end(s : String) -> Int {
  let n = s.length()
  if n == 0 {
    return -1
  }
  let c0 = s.code_unit_at(0)
  let is_alpha0 = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)
  if !is_alpha0 {
    return -1
  }
  let mut i = 1
  while i < n {
    let c = s.code_unit_at(i)
    if c == 58 {
      return i
    }
    let ok = (c >= 65 && c <= 90) ||
    (c >= 97 && c <= 122) ||
    (c >= 48 && c <= 57) ||
    c == 43 ||
    c == 45 ||
    c == 46
    if !ok {
      return -1
    }
    i = i + 1
  }
  -1
}

fn normalize_dot_segments(path : String) -> String {
  let leading_slash = path.length() > 0 && path.code_unit_at(0) == 47
  let trailing_slash = path.length() > 0 && path.code_unit_at(path.length() - 1) == 47
  let segs : Array[String] = []
  let n = path.length()
  let mut i = 0
  while i < n {
    while i < n && path.code_unit_at(i) == 47 {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && path.code_unit_at(i) != 47 {
      i = i + 1
    }
    let part = path.slice(start, i)
    if part == "." {
      // skip
    } else if part == ".." {
      if segs.length() > 0 {
        let _ = segs.pop()
      }
    } else {
      segs.push(part)
    }
  }
  let sb = StringBuilder::new()
  if leading_slash {
    sb.write_string("/")
  }
  let mut k = 0
  while k < segs.length() {
    if k > 0 {
      sb.write_string("/")
    }
    sb.write_string(segs[k])
    k = k + 1
  }
  if trailing_slash && segs.length() > 0 {
    sb.write_string("/")
  }
  sb.to_string()
}

///| Resolve a relative URL against a base URL following RFC 3986 §5.2.
pub fn resolve_url(base : String, rel : String) -> String {
  if rel.length() == 0 {
    return base
  }
  if base.length() == 0 {
    return rel
  }
  // Absolute URL with scheme
  if url_scheme_end(rel) >= 0 {
    return rel
  }
  // Extract base scheme and authority
  let scheme_colon = url_scheme_end(base)
  // Scheme-relative URL ("//host/path")
  if rel.length() >= 2 && rel.code_unit_at(0) == 47 && rel.code_unit_at(1) == 47 {
    if scheme_colon >= 0 {
      return base.slice(0, scheme_colon + 1) + rel
    }
    return rel
  }

  // Strip query/fragment from base
  let mut base_end = base.length()
  let mut bi = 0
  while bi < base.length() {
    let c = base.code_unit_at(bi)
    if c == 63 || c == 35 {
      base_end = bi
      break
    }
    bi = bi + 1
  }
  let base_clean = base.slice(0, base_end)

  // Find origin prefix (scheme://authority) if present
  let mut origin_end = 0
  if scheme_colon >= 0 &&
  scheme_colon + 2 < base_clean.length() &&
  base_clean.code_unit_at(scheme_colon + 1) == 47 &&
  base_clean.code_unit_at(scheme_colon + 2) == 47 {
    let mut p = scheme_colon + 3
    while p < base_clean.length() && base_clean.code_unit_at(p) != 47 {
      p = p + 1
    }
    origin_end = p
  }

  // Split rel into path and query/fragment suffix
  let mut rel_path_end = rel.length()
  let mut ri = 0
  while ri < rel.length() {
    let c = rel.code_unit_at(ri)
    if c == 63 || c == 35 {
      rel_path_end = ri
      break
    }
    ri = ri + 1
  }
  let rel_path = rel.slice(0, rel_path_end)
  let rel_suffix = rel.slice(rel_path_end, rel.length())

  // Root-relative path ("/...")
  if rel_path.length() > 0 && rel_path.code_unit_at(0) == 47 {
    let norm = normalize_dot_segments(rel_path)
    if origin_end > 0 {
      return base_clean.slice(0, origin_end) + norm + rel_suffix
    }
    return norm + rel_suffix
  }

  // Query-only or fragment-only relative reference
  if rel_path.length() == 0 {
    return base_clean + rel_suffix
  }

  // Merge base path directory with rel_path
  let base_path = if origin_end > 0 {
    base_clean.slice(origin_end, base_clean.length())
  } else {
    base_clean
  }
  let mut last_slash = -1
  let mut k = base_path.length() - 1
  while k >= 0 {
    if base_path.code_unit_at(k) == 47 {
      last_slash = k
      break
    }
    k = k - 1
  }
  let merged = if last_slash >= 0 {
    base_path.slice(0, last_slash + 1) + rel_path
  } else if origin_end > 0 {
    "/" + rel_path
  } else {
    rel_path
  }
  let norm = normalize_dot_segments(merged)
  if origin_end > 0 {
    base_clean.slice(0, origin_end) + norm + rel_suffix
  } else {
    norm + rel_suffix
  }
}

fn format_padded_i64(v : Int64, width : Int) -> String {
  let s = v.to_string()
  if width <= s.length() {
    return s
  }
  let sb = StringBuilder::new()
  let mut pad = width - s.length()
  while pad > 0 {
    sb.write_string("0")
    pad = pad - 1
  }
  sb.write_string(s)
  sb.to_string()
}

///| Parse optional `%0Nd` / `%Nd` width specifier from a template identifier suffix.
///| Enforces maximum width of 32 digits to block OOM/CPU width bombs.
fn parse_template_width(spec : String) -> Result[Int, DashError] {
  let n = spec.length()
  if n == 0 {
    return Ok(0)
  }
  if n < 2 || spec.code_unit_at(0) != 37 || spec.code_unit_at(n - 1) != 100 {
    return Err(DashError::InvalidTemplate("invalid format tag: " + spec))
  }
  let mut i = 1
  let mut width = 0
  let mut digits = 0
  while i < n - 1 {
    let c = spec.code_unit_at(i)
    if !is_ascii_digit(c) {
      return Err(DashError::InvalidTemplate("invalid width in format tag: " + spec))
    }
    width = width * 10 + (c - 48)
    digits = digits + 1
    if width > 32 || digits > 4 {
      return Err(DashError::LimitExceeded("template format width exceeds maximum (32): " + spec))
    }
    i = i + 1
  }
  Ok(width)
}

///| Expand an ISO/IEC 23009-1 §5.3.9.4.4 SegmentTemplate URL template.
///| Supports `$$`, `$RepresentationID$`, `$Number[%0Nd]$`, `$Bandwidth[%0Nd]$`, `$Time[%0Nd]$`.
pub fn expand_template(
  template : String,
  rep_id : String,
  number : Int64,
  bandwidth : Int64,
  time : Int64,
) -> Result[String, DashError] {
  let sb = StringBuilder::new()
  let n = template.length()
  let mut i = 0
  while i < n {
    if template.code_unit_at(i) != 36 {
      let start = i
      while i < n && template.code_unit_at(i) != 36 {
        i = i + 1
      }
      sb.write_string(template.slice(start, i))
      continue
    }
    // Found '$'
    if i + 1 < n && template.code_unit_at(i + 1) == 36 {
      // Escaped '$$' -> '$'
      sb.write_string("$")
      i = i + 2
      continue
    }
    let mut end = i + 1
    while end < n && template.code_unit_at(end) != 36 {
      end = end + 1
    }
    if end >= n {
      return Err(DashError::InvalidTemplate("unterminated '$' identifier in template"))
    }
    let token = template.slice(i + 1, end)
    if token == "RepresentationID" {
      sb.write_string(rep_id)
    } else if token == "Number" {
      sb.write_string(number.to_string())
    } else if token.length() > 6 && token.slice(0, 6) == "Number" {
      let w = match parse_template_width(token.slice(6, token.length())) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      sb.write_string(format_padded_i64(number, w))
    } else if token == "Bandwidth" {
      sb.write_string(bandwidth.to_string())
    } else if token.length() > 9 && token.slice(0, 9) == "Bandwidth" {
      let w = match parse_template_width(token.slice(9, token.length())) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      sb.write_string(format_padded_i64(bandwidth, w))
    } else if token == "Time" {
      sb.write_string(time.to_string())
    } else if token.length() > 4 && token.slice(0, 4) == "Time" {
      let w = match parse_template_width(token.slice(4, token.length())) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      sb.write_string(format_padded_i64(time, w))
    } else {
      return Err(DashError::InvalidTemplate("unknown template identifier: $" + token + "$"))
    }
    i = end + 1
  }
  Ok(sb.to_string())
}

fn opt_or_i64(a : Option[Int64], b : Option[Int64]) -> Option[Int64] {
  match a {
    Some(_) => a
    None => b
  }
}

fn opt_or_str(a : Option[String], b : Option[String]) -> Option[String] {
  match a {
    Some(_) => a
    None => b
  }
}

fn opt_or_bool(a : Option[Bool], b : Option[Bool]) -> Option[Bool] {
  match a {
    Some(_) => a
    None => b
  }
}

fn merge_segment_template(
  parent : Option[SegmentTemplate],
  child : Option[SegmentTemplate],
) -> Option[SegmentTemplate] {
  match (parent, child) {
    (None, None) => None
    (Some(p), None) => Some(p)
    (None, Some(c)) => Some(c)
    (Some(p), Some(c)) => {
      let tl = if c.timeline.length() > 0 { c.timeline } else { p.timeline }
      Some(SegmentTemplate::{
        timescale: opt_or_i64(c.timescale, p.timescale),
        duration: opt_or_i64(c.duration, p.duration),
        start_number: opt_or_i64(c.start_number, p.start_number),
        presentation_time_offset: opt_or_i64(c.presentation_time_offset, p.presentation_time_offset),
        initialization: opt_or_str(c.initialization, p.initialization),
        media: opt_or_str(c.media, p.media),
        timeline: tl,
      })
    }
    _ => None
  }
}

fn merge_segment_list(
  parent : Option[SegmentList],
  child : Option[SegmentList],
) -> Option[SegmentList] {
  match (parent, child) {
    (None, None) => None
    (Some(p), None) => Some(p)
    (None, Some(c)) => Some(c)
    (Some(p), Some(c)) => {
      let urls = if c.segment_urls.length() > 0 { c.segment_urls } else { p.segment_urls }
      Some(SegmentList::{
        timescale: opt_or_i64(c.timescale, p.timescale),
        duration: opt_or_i64(c.duration, p.duration),
        start_number: opt_or_i64(c.start_number, p.start_number),
        presentation_time_offset: opt_or_i64(c.presentation_time_offset, p.presentation_time_offset),
        initialization_source_url: opt_or_str(c.initialization_source_url, p.initialization_source_url),
        initialization_range: opt_or_str(c.initialization_range, p.initialization_range),
        segment_urls: urls,
      })
    }
    _ => None
  }
}

fn merge_segment_base(
  parent : Option[SegmentBase],
  child : Option[SegmentBase],
) -> Option[SegmentBase] {
  match (parent, child) {
    (None, None) => None
    (Some(p), None) => Some(p)
    (None, Some(c)) => Some(c)
    (Some(p), Some(c)) => {
      Some(SegmentBase::{
        timescale: opt_or_i64(c.timescale, p.timescale),
        presentation_time_offset: opt_or_i64(c.presentation_time_offset, p.presentation_time_offset),
        index_range: opt_or_str(c.index_range, p.index_range),
        index_range_exact: opt_or_bool(c.index_range_exact, p.index_range_exact),
        initialization_source_url: opt_or_str(c.initialization_source_url, p.initialization_source_url),
        initialization_range: opt_or_str(c.initialization_range, p.initialization_range),
      })
    }
    _ => None
  }
}

fn effective_period_duration_us(mpd : Mpd, period_idx : Int) -> Option[Int64] {
  let period = mpd.periods[period_idx]
  match period.duration_us {
    Some(d) => Some(d)
    None => {
      // If there is a next period with start_us and this period has start_us
      if period_idx + 1 < mpd.periods.length() {
        match (period.start_us, mpd.periods[period_idx + 1].start_us) {
          (Some(s0), Some(s1)) => {
            if s1 >= s0 {
              return Some(s1 - s0)
            }
          }
          _ => ()
        }
      }
      // Fall back to MPD mediaPresentationDuration minus period start
      match mpd.media_presentation_duration_us {
        Some(total) => {
          let start = match period.start_us {
            Some(s) => s
            None => 0L
          }
          if total >= start {
            Some(total - start)
          } else {
            Some(0L)
          }
        }
        None => None
      }
    }
  }
}

///| Convert microseconds to timescale ticks without overflow: `floor(us * timescale / 1_000_000)`.
fn us_to_ticks(us : Int64, timescale : Int64) -> Option[Int64] {
  let secs = us / 1000000L
  let rem_us = us % 1000000L
  let p1 = match checked_mul_i64(secs, timescale) {
    Some(v) => v
    None => return None
  }
  let p2 = match checked_mul_i64(rem_us, timescale) {
    Some(v) => v / 1000000L
    None => return None
  }
  checked_add_i64(p1, p2)
}

///| Resolve initialization and media segment URLs and timeline for a specific Representation.
pub fn resolve_segments(
  mpd : Mpd,
  period_idx : Int,
  as_idx : Int,
  rep_idx : Int,
  limits : DashLimits,
) -> Result[ResolvedTrack, DashError] {
  match xml_validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if period_idx < 0 || period_idx >= mpd.periods.length() {
    return Err(DashError::IndexOutOfBounds("period_idx out of bounds"))
  }
  let period = mpd.periods[period_idx]
  if as_idx < 0 || as_idx >= period.adaptation_sets.length() {
    return Err(DashError::IndexOutOfBounds("as_idx out of bounds"))
  }
  let aset = period.adaptation_sets[as_idx]
  if rep_idx < 0 || rep_idx >= aset.representations.length() {
    return Err(DashError::IndexOutOfBounds("rep_idx out of bounds"))
  }
  let rep = aset.representations[rep_idx]

  // Hierarchical BaseURL chain: MPD -> Period -> AdaptationSet -> Representation
  let mut base = ""
  if mpd.base_urls.length() > 0 {
    base = resolve_url(base, mpd.base_urls[0])
  }
  if period.base_urls.length() > 0 {
    base = resolve_url(base, period.base_urls[0])
  }
  if aset.base_urls.length() > 0 {
    base = resolve_url(base, aset.base_urls[0])
  }
  if rep.base_urls.length() > 0 {
    base = resolve_url(base, rep.base_urls[0])
  }

  let tpl_opt = merge_segment_template(
    merge_segment_template(period.segment_template, aset.segment_template),
    rep.segment_template,
  )
  let list_opt = merge_segment_list(
    merge_segment_list(period.segment_list, aset.segment_list),
    rep.segment_list,
  )
  let base_opt = merge_segment_base(
    merge_segment_base(period.segment_base, aset.segment_base),
    rep.segment_base,
  )

  // 1. SegmentTemplate
  match tpl_opt {
    Some(tpl) => {
      let timescale = match tpl.timescale {
        Some(ts) => ts
        None => 1L
      }
      let start_num = match tpl.start_number {
        Some(sn) => sn
        None => 1L
      }
      let init_url = match tpl.initialization {
        Some(itpl) => {
          match expand_template(itpl, rep.id, start_num, rep.bandwidth, 0L) {
            Ok(u) => Some(resolve_url(base, u))
            Err(e) => return Err(e)
          }
        }
        None => None
      }
      let segments : Array[ResolvedSegment] = []
      let media_tpl = match tpl.media {
        Some(m) => m
        None => {
          return Ok(ResolvedTrack::{
            initialization_url: init_url,
            initialization_range: None,
            index_range: None,
            segments: segments,
          })
        }
      }

      if tpl.timeline.length() > 0 {
        let period_dur_ticks = match effective_period_duration_us(mpd, period_idx) {
          Some(dur_us) => us_to_ticks(dur_us, timescale)
          None => None
        }
        let mut cur_time = 0L
        let mut cur_num = start_num
        let mut ti = 0
        while ti < tpl.timeline.length() {
          let entry = tpl.timeline[ti]
          match entry.t {
            Some(t) => cur_time = t
            None => ()
          }
          let d = entry.d
          // Compute repeat count (number of segments = reps)
          let seg_count = if entry.r >= 0L {
            if entry.r >= limits.max_segments.to_int64() {
              return Err(DashError::LimitExceeded("SegmentTimeline repeat count exceeds max_segments"))
            }
            entry.r + 1L
          } else {
            // r < 0: repeat until next S@t or Period end
            let end_time_opt = if ti + 1 < tpl.timeline.length() {
              tpl.timeline[ti + 1].t
            } else {
              period_dur_ticks
            }
            match end_time_opt {
              Some(end_t) => {
                if end_t <= cur_time {
                  0L
                } else {
                  let span = end_t - cur_time
                  // ceil(span / d) without overflow
                  let q = span / d
                  let rem = span % d
                  let cnt = if rem > 0L { q + 1L } else { q }
                  if cnt > limits.max_segments.to_int64() {
                    return Err(DashError::LimitExceeded("SegmentTimeline r<0 expansion exceeds max_segments"))
                  }
                  cnt
                }
              }
              None => 1L
            }
          }

          let mut k = 0L
          while k < seg_count {
            if segments.length() >= limits.max_segments {
              return Err(DashError::LimitExceeded("resolved segments exceed max_segments"))
            }
            let next_time = match checked_add_i64(cur_time, d) {
              Some(nt) => nt
              None => return Err(DashError::InvalidNumber("SegmentTimeline time Int64 overflow"))
            }
            let expanded = match expand_template(media_tpl, rep.id, cur_num, rep.bandwidth, cur_time) {
              Ok(u) => u
              Err(e) => return Err(e)
            }
            segments.push(ResolvedSegment::{
              number: cur_num,
              url: resolve_url(base, expanded),
              start_time: cur_time,
              duration: d,
              timescale: timescale,
              media_range: None,
            })
            cur_time = next_time
            cur_num = match checked_add_i64(cur_num, 1L) {
              Some(nn) => nn
              None => return Err(DashError::InvalidNumber("segment number Int64 overflow"))
            }
            k = k + 1L
          }
          ti = ti + 1
        }
      } else {
        // Duration-based SegmentTemplate
        match tpl.duration {
          Some(seg_dur) => {
            match effective_period_duration_us(mpd, period_idx) {
              Some(dur_us) => {
                let total_ticks = match us_to_ticks(dur_us, timescale) {
                  Some(tt) => tt
                  None => return Err(DashError::InvalidNumber("period duration ticks overflow"))
                }
                let q = total_ticks / seg_dur
                let rem = total_ticks % seg_dur
                let count = if rem > 0L { q + 1L } else { q }
                if count > limits.max_segments.to_int64() {
                  return Err(DashError::LimitExceeded("duration-based segment count exceeds max_segments"))
                }
                let mut cur_time = 0L
                let mut cur_num = start_num
                let mut k = 0L
                while k < count {
                  if segments.length() >= limits.max_segments {
                    return Err(DashError::LimitExceeded("resolved segments exceed max_segments"))
                  }
                  let next_time = match checked_add_i64(cur_time, seg_dur) {
                    Some(nt) => nt
                    None => return Err(DashError::InvalidNumber("segment time Int64 overflow"))
                  }
                  let expanded = match expand_template(media_tpl, rep.id, cur_num, rep.bandwidth, cur_time) {
                    Ok(u) => u
                    Err(e) => return Err(e)
                  }
                  segments.push(ResolvedSegment::{
                    number: cur_num,
                    url: resolve_url(base, expanded),
                    start_time: cur_time,
                    duration: seg_dur,
                    timescale: timescale,
                    media_range: None,
                  })
                  cur_time = next_time
                  cur_num = cur_num + 1L
                  k = k + 1L
                }
              }
              None => ()
            }
          }
          None => ()
        }
      }

      return Ok(ResolvedTrack::{
        initialization_url: init_url,
        initialization_range: None,
        index_range: None,
        segments: segments,
      })
    }
    None => ()
  }

  // 2. SegmentList
  match list_opt {
    Some(sl) => {
      let timescale = match sl.timescale {
        Some(ts) => ts
        None => 1L
      }
      let seg_dur = match sl.duration {
        Some(d) => d
        None => 0L
      }
      let start_num = match sl.start_number {
        Some(sn) => sn
        None => 1L
      }
      let init_url = match sl.initialization_source_url {
        Some(u) => Some(resolve_url(base, u))
        None => if sl.initialization_range is Some(_) && base.length() > 0 { Some(base) } else { None }
      }
      if sl.segment_urls.length() > limits.max_segments {
        return Err(DashError::LimitExceeded("SegmentList entries exceed max_segments"))
      }
      let segments : Array[ResolvedSegment] = []
      let mut cur_time = 0L
      let mut i = 0
      while i < sl.segment_urls.length() {
        let su = sl.segment_urls[i]
        let url = match su.media {
          Some(m) => resolve_url(base, m)
          None => base
        }
        segments.push(ResolvedSegment::{
          number: start_num + i.to_int64(),
          url: url,
          start_time: cur_time,
          duration: seg_dur,
          timescale: timescale,
          media_range: su.media_range,
        })
        if seg_dur > 0L {
          cur_time = match checked_add_i64(cur_time, seg_dur) {
            Some(nt) => nt
            None => return Err(DashError::InvalidNumber("SegmentList time overflow"))
          }
        }
        i = i + 1
      }
      return Ok(ResolvedTrack::{
        initialization_url: init_url,
        initialization_range: sl.initialization_range,
        index_range: None,
        segments: segments,
      })
    }
    None => ()
  }

  // 3. SegmentBase (or bare BaseURL single-segment representation)
  match base_opt {
    Some(sb) => {
      let timescale = match sb.timescale {
        Some(ts) => ts
        None => 1L
      }
      let init_url = match sb.initialization_source_url {
        Some(u) => Some(resolve_url(base, u))
        None => if base.length() > 0 { Some(base) } else { None }
      }
      let segments : Array[ResolvedSegment] = []
      if base.length() > 0 {
        if limits.max_segments < 1 {
          return Err(DashError::LimitExceeded("max_segments=0 rejects SegmentBase media segment"))
        }
        let dur_ticks = match effective_period_duration_us(mpd, period_idx) {
          Some(dur_us) => {
            match us_to_ticks(dur_us, timescale) {
              Some(t) => t
              None => 0L
            }
          }
          None => 0L
        }
        segments.push(ResolvedSegment::{
          number: 1L,
          url: base,
          start_time: 0L,
          duration: dur_ticks,
          timescale: timescale,
          media_range: None,
        })
      }
      return Ok(ResolvedTrack::{
        initialization_url: init_url,
        initialization_range: sb.initialization_range,
        index_range: sb.index_range,
        segments: segments,
      })
    }
    None => ()
  }

  // Bare representation without segment container
  let segments : Array[ResolvedSegment] = []
  if base.length() > 0 && limits.max_segments >= 1 {
    segments.push(ResolvedSegment::{
      number: 1L,
      url: base,
      start_time: 0L,
      duration: 0L,
      timescale: 1L,
      media_range: None,
    })
  }
  Ok(ResolvedTrack::{
    initialization_url: None,
    initialization_range: None,
    index_range: None,
    segments: segments,
  })
}
