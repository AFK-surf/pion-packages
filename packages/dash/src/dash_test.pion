///| Comprehensive unit and red-team security test suite for `packages/dash`.

fn assert_eq_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

fn assert_eq_int(got : Int, expected : Int, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected " + expected.to_string() + ", got " + got.to_string(),
  )
}

fn assert_eq_i64(got : Int64, expected : Int64, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected " + expected.to_string() + ", got " + got.to_string(),
  )
}

fn assert_opt_str(got : Option[String], expected : Option[String], label : String) -> Unit {
  match (got, expected) {
    (None, None) => ()
    (Some(a), Some(b)) => assert_eq_str(a, b, label)
    (Some(a), None) => debug_assert(false, label + ": expected None, got Some(\"" + a + "\")")
    (None, Some(b)) => debug_assert(false, label + ": expected Some(\"" + b + "\"), got None")
    _ => ()
  }
}

fn assert_opt_i64(got : Option[Int64], expected : Option[Int64], label : String) -> Unit {
  match (got, expected) {
    (None, None) => ()
    (Some(a), Some(b)) => assert_eq_i64(a, b, label)
    (Some(a), None) => debug_assert(false, label + ": expected None, got Some(" + a.to_string() + ")")
    (None, Some(b)) => debug_assert(false, label + ": expected Some(" + b.to_string() + "), got None")
    _ => ()
  }
}

fn must_parse(xml : String) -> Mpd {
  match parse(xml) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "expected parse Ok, got " + dash_error_to_string(e))
      panic("unreachable")
    }
  }
}

// ---------------------------------------------------------------------------
// 1. ISO-8601 Duration parsing & formatting
// ---------------------------------------------------------------------------

test "iso8601_duration_parse_and_format" {
  match parse_iso8601_duration_us("PT0S") {
    Ok(v) => assert_eq_i64(v, 0L, "PT0S")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_iso8601_duration_us("PT1H2M3.5S") {
    Ok(v) => assert_eq_i64(v, 3723500000L, "PT1H2M3.5S")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_iso8601_duration_us("PT0H9M56.46S") {
    Ok(v) => assert_eq_i64(v, 596460000L, "PT0H9M56.46S")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_iso8601_duration_us("P1DT2H3M4.123456S") {
    Ok(v) => assert_eq_i64(v, 93784123456L, "P1DT2H3M4.123456S")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_iso8601_duration_us("PT1.5000009S") {
    Ok(v) => assert_eq_i64(v, 1500000L, "sub-microsecond truncation")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_iso8601_duration_us("PT2,25S") {
    Ok(_) => debug_assert(false, "comma decimal must be rejected per xs:duration")
    Err(_) => ()
  }

  assert_eq_str(format_iso8601_duration_us(0L), "PT0S", "fmt 0")
  assert_eq_str(format_iso8601_duration_us(3723500000L), "PT1H2M3.5S", "fmt 1h2m3.5s")
  assert_eq_str(format_iso8601_duration_us(60000000L), "PT1M", "fmt 1m")
  assert_eq_str(format_iso8601_duration_us(500L), "PT0.0005S", "fmt 500us")
}

test "iso8601_duration_invalid_and_overflow" {
  let bad = [
    "",
    "P",
    "PT",
    "-PT1S",
    "PT-1S",
    "10S",
    "PT1S2M",
    "PT1.S",
    "PT.5S",
    "PT999999999999999999S",
    "P999999999Y",
  ]
  let mut i = 0
  while i < bad.length() {
    match parse_iso8601_duration_us(bad[i]) {
      Ok(_) => debug_assert(false, "expected duration error for: " + bad[i])
      Err(_) => ()
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// 2. ISO-8601 DateTime & Leap Year validation
// ---------------------------------------------------------------------------

test "iso8601_datetime_calendar_and_leap_year" {
  match parse_iso8601_datetime_us("1970-01-01T00:00:00Z") {
    Ok(v) => assert_eq_i64(v, 0L, "unix epoch")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_iso8601_datetime_us("2024-02-29T12:30:45.25Z") {
    Ok(v) => debug_assert(v > 0L, "2024 leap day valid")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_iso8601_datetime_us("2000-02-29T00:00:00+02:00") {
    Ok(v) => debug_assert(v > 0L, "2000 leap day with tz valid")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_iso8601_datetime_us("2024-01-01T00:00:00") {
    Ok(v) => assert_eq_i64(v, 1704067200000000L, "datetime without timezone defaults to UTC")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_iso8601_datetime_us("2024-01-01T24:00:00Z") {
    Ok(v) => assert_eq_i64(v, 1704153600000000L, "24:00:00Z midnight next day")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  // Invalid non-leap years and out-of-range dates
  let bad_dates = [
    "2023-02-29T00:00:00Z",
    "1900-02-29T00:00:00Z",
    "2024-04-31T00:00:00Z",
    "2024-13-01T00:00:00Z",
    "2024-01-01T24:00:01Z",
    "2024-01-01T25:00:00Z",
    "2024-01-01T00:60:00Z",
    "2024-01-01T00:00:60Z",
    "2024-01-01T00:00:00+14:01",
    "2024-01-01T00:00:00+25:00",
    "2024-01-01t00:00:00z",
    "not-a-date",
  ]
  let mut i = 0
  while i < bad_dates.length() {
    match parse_iso8601_datetime_us(bad_dates[i]) {
      Ok(_) => debug_assert(false, "expected invalid datetime: " + bad_dates[i])
      Err(_) => ()
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// 3. Rational numbers (frameRate)
// ---------------------------------------------------------------------------

test "rational_parse_and_format" {
  match parse_rational("30") {
    Ok(r) => {
      assert_eq_i64(r.num, 30L, "30 num")
      assert_eq_i64(r.den, 1L, "30 den")
      assert_eq_str(format_rational(r), "30", "fmt 30")
    }
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match parse_rational("30000/1001") {
    Ok(r) => {
      assert_eq_i64(r.num, 30000L, "ntsc num")
      assert_eq_i64(r.den, 1001L, "ntsc den")
      assert_eq_str(format_rational(r), "30000/1001", "fmt ntsc")
    }
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  let bad = ["", "0", "30/0", "-30", "30/-1", "30/1/2", "abc"]
  let mut i = 0
  while i < bad.length() {
    match parse_rational(bad[i]) {
      Ok(_) => debug_assert(false, "expected invalid rational: " + bad[i])
      Err(_) => ()
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// 4. Static VOD MPD with SegmentBase (YouTube-style fMP4)
// ---------------------------------------------------------------------------

test "parse_static_segment_base_mpd" {
  let xml = "\xEF\xBB\xBF<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
  "<!-- Static VOD MPD -->\n" +
  "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" type=\"static\" " +
  "profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" " +
  "mediaPresentationDuration=\"PT2M30.5S\" minBufferTime=\"PT2S\">\n" +
  "  <BaseURL>https://cdn.example.com/vod/clip1/</BaseURL>\n" +
  "  <Period id=\"p0\" start=\"PT0S\">\n" +
  "    <AdaptationSet id=\"1\" contentType=\"video\" mimeType=\"video/mp4\" " +
  "segmentAlignment=\"true\" par=\"16:9\" minWidth=\"640\" maxWidth=\"1920\" " +
  "minHeight=\"360\" maxHeight=\"1080\">\n" +
  "      <Role schemeIdUri=\"urn:mpeg:dash:role:2011\" value=\"main\"/>\n" +
  "      <Representation id=\"v1080\" bandwidth=\"4500000\" width=\"1920\" height=\"1080\" " +
  "frameRate=\"30000/1001\" sar=\"1:1\" codecs=\"avc1.640028\" startWithSAP=\"1\">\n" +
  "        <BaseURL>video_1080p.mp4</BaseURL>\n" +
  "        <SegmentBase timescale=\"30000\" indexRange=\"708-1234\" indexRangeExact=\"true\">\n" +
  "          <Initialization range=\"0-707\"/>\n" +
  "        </SegmentBase>\n" +
  "      </Representation>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>\n"

  let mpd = must_parse(xml)
  assert_eq_str(mpd_type_to_string(mpd.mpd_type), "static", "mpd type")
  assert_opt_i64(mpd.media_presentation_duration_us, Some(150500000L), "mpd duration")
  assert_opt_i64(mpd.min_buffer_time_us, Some(2000000L), "minBufferTime")
  assert_eq_int(mpd.periods.length(), 1, "periods")
  let aset = mpd.periods[0].adaptation_sets[0]
  assert_eq_int(aset.roles.length(), 1, "roles")
  assert_opt_str(aset.roles[0].value, Some("main"), "role value")
  let rep = aset.representations[0]
  assert_eq_str(rep.id, "v1080", "rep id")
  assert_eq_i64(rep.bandwidth, 4500000L, "bandwidth")
  match rep.frame_rate {
    Some(fr) => assert_eq_str(format_rational(fr), "30000/1001", "frameRate")
    None => debug_assert(false, "missing frameRate")
  }

  let track = match resolve_segments(mpd, 0, 0, 0, DashLimits::default()) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, dash_error_to_string(e))
      panic("unreachable")
    }
  }
  assert_opt_str(track.initialization_url, Some("https://cdn.example.com/vod/clip1/video_1080p.mp4"), "init url")
  assert_opt_str(track.initialization_range, Some("0-707"), "init range")
  assert_opt_str(track.index_range, Some("708-1234"), "index range")
  assert_eq_int(track.segments.length(), 1, "single segment")
  assert_eq_str(track.segments[0].url, "https://cdn.example.com/vod/clip1/video_1080p.mp4", "seg url")
}

// ---------------------------------------------------------------------------
// 5. Dynamic Live MPD with UTCTiming, Location, PublishTime
// ---------------------------------------------------------------------------

test "parse_dynamic_live_mpd" {
  let xml = "<MPD type=\"dynamic\" profiles=\"urn:mpeg:dash:profile:isoff-live:2011\" " +
  "availabilityStartTime=\"2026-01-01T00:00:00Z\" publishTime=\"2026-01-01T01:00:00Z\" " +
  "minimumUpdatePeriod=\"PT4S\" timeShiftBufferDepth=\"PT60S\" " +
  "suggestedPresentationDelay=\"PT12S\" maxSegmentDuration=\"PT4S\" minBufferTime=\"PT2S\">\n" +
  "  <Location>https://live.example.com/stream/manifest.mpd</Location>\n" +
  "  <UTCTiming schemeIdUri=\"urn:mpeg:dash:utc:http-iso:2014\" value=\"https://time.example.com/iso\"/>\n" +
  "  <Period id=\"live-1\" start=\"PT0S\">\n" +
  "    <AdaptationSet contentType=\"audio\" mimeType=\"audio/mp4\" lang=\"en\">\n" +
  "      <AudioChannelConfiguration schemeIdUri=\"urn:mpeg:dash:23003:3:audio_channel_configuration:2011\" value=\"2\"/>\n" +
  "      <Representation id=\"a128\" bandwidth=\"128000\" codecs=\"mp4a.40.2\" audioSamplingRate=\"48000\">\n" +
  "        <SegmentTemplate timescale=\"48000\" initialization=\"audio_$RepresentationID$_init.m4s\" " +
  "media=\"audio_$RepresentationID$_$Time$.m4s\">\n" +
  "          <SegmentTimeline>\n" +
  "            <S t=\"960000\" d=\"192000\" r=\"2\"/>\n" +
  "          </SegmentTimeline>\n" +
  "        </SegmentTemplate>\n" +
  "      </Representation>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"

  let mpd = must_parse(xml)
  assert_eq_str(mpd_type_to_string(mpd.mpd_type), "dynamic", "dynamic")
  assert_eq_int(mpd.locations.length(), 1, "locations")
  assert_eq_int(mpd.utc_timings.length(), 1, "utc timings")
  assert_opt_i64(mpd.minimum_update_period_us, Some(4000000L), "mup")
  assert_opt_i64(mpd.time_shift_buffer_depth_us, Some(60000000L), "tsbd")
  assert_opt_i64(mpd.suggested_presentation_delay_us, Some(12000000L), "spd")

  let track = match resolve_segments(mpd, 0, 0, 0, DashLimits::default()) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, dash_error_to_string(e))
      panic("unreachable")
    }
  }
  assert_eq_int(track.segments.length(), 3, "r=2 -> 3 segments")
  assert_eq_str(track.segments[0].url, "audio_a128_960000.m4s", "seg 0")
  assert_eq_str(track.segments[1].url, "audio_a128_1152000.m4s", "seg 1")
  assert_eq_str(track.segments[2].url, "audio_a128_1344000.m4s", "seg 2")
}

// ---------------------------------------------------------------------------
// 6. SegmentTemplate URL expansion ($RepresentationID$, $Number%04d$, $Bandwidth$, $Time$, $$)
// ---------------------------------------------------------------------------

test "expand_template_identifiers_and_escaping" {
  match expand_template("chunk_$RepresentationID$_$Number%04d$_$Bandwidth$_$Time%06d$_$$.m4s", "vid1", 7L, 2500000L, 420L) {
    Ok(u) => assert_eq_str(u, "chunk_vid1_0007_2500000_000420_$.m4s", "full expansion")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match expand_template("seg_$Number$.m4s", "r0", 123L, 100L, 0L) {
    Ok(u) => assert_eq_str(u, "seg_123.m4s", "plain number")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
  match expand_template("price_$$100_$Number%02d$.m4s", "r0", 105L, 100L, 0L) {
    Ok(u) => assert_eq_str(u, "price_$100_105.m4s", "width smaller than digits")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
}

// ---------------------------------------------------------------------------
// 7. SegmentTimeline with r=0, r>0, and r=-1 (until next S@t and until Period end)
// ---------------------------------------------------------------------------

test "segment_timeline_r_negative_one_and_inheritance" {
  let xml = "<MPD type=\"static\" profiles=\"urn:mpeg:dash:profile:isoff-live:2011\" mediaPresentationDuration=\"PT20S\">\n" +
  "  <BaseURL>https://cdn.example.com/live/</BaseURL>\n" +
  "  <Period id=\"p0\" start=\"PT0S\" duration=\"PT20S\">\n" +
  "    <AdaptationSet contentType=\"video\" mimeType=\"video/mp4\">\n" +
  "      <SegmentTemplate timescale=\"1000\" startNumber=\"1\" initialization=\"$RepresentationID$/init.mp4\" media=\"$RepresentationID$/seg_$Number%03d$_$Time$.m4s\">\n" +
  "        <SegmentTimeline>\n" +
  "          <S t=\"0\" d=\"4000\" r=\"-1\"/>\n" +
  "          <S t=\"12000\" d=\"4000\" r=\"-1\"/>\n" +
  "        </SegmentTimeline>\n" +
  "      </SegmentTemplate>\n" +
  "      <Representation id=\"hd\" bandwidth=\"3000000\"/>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"

  let mpd = must_parse(xml)
  let track = match resolve_segments(mpd, 0, 0, 0, DashLimits::default()) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, dash_error_to_string(e))
      panic("unreachable")
    }
  }
  // 0..12000 with d=4000 -> 3 segments (0, 4000, 8000); 12000..20000 with d=4000 -> 2 segments (12000, 16000)
  assert_eq_int(track.segments.length(), 5, "total segments with r=-1")
  assert_opt_str(track.initialization_url, Some("https://cdn.example.com/live/hd/init.mp4"), "init url")
  assert_eq_str(track.segments[0].url, "https://cdn.example.com/live/hd/seg_001_0.m4s", "seg 0")
  assert_eq_str(track.segments[2].url, "https://cdn.example.com/live/hd/seg_003_8000.m4s", "seg 2")
  assert_eq_str(track.segments[3].url, "https://cdn.example.com/live/hd/seg_004_12000.m4s", "seg 3")
  assert_eq_str(track.segments[4].url, "https://cdn.example.com/live/hd/seg_005_16000.m4s", "seg 4")
}

// ---------------------------------------------------------------------------
// 8. SegmentTemplate duration-based (no SegmentTimeline)
// ---------------------------------------------------------------------------

test "segment_template_duration_based" {
  let xml = "<MPD type=\"static\" profiles=\"urn:mpeg:dash:profile:isoff-live:2011\" mediaPresentationDuration=\"PT10S\">\n" +
  "  <Period id=\"p0\">\n" +
  "    <AdaptationSet contentType=\"video\">\n" +
  "      <SegmentTemplate timescale=\"1000\" duration=\"3000\" startNumber=\"10\" media=\"seg_$Number$.m4s\"/>\n" +
  "      <Representation id=\"v1\" bandwidth=\"1000000\"/>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"

  let mpd = must_parse(xml)
  let track = match resolve_segments(mpd, 0, 0, 0, DashLimits::default()) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, dash_error_to_string(e))
      panic("unreachable")
    }
  }
  // ceil(10000 / 3000) = 4 segments: numbers 10, 11, 12, 13
  assert_eq_int(track.segments.length(), 4, "4 duration segments")
  assert_eq_i64(track.segments[0].number, 10L, "start number 10")
  assert_eq_str(track.segments[3].url, "seg_13.m4s", "last seg")
}

// ---------------------------------------------------------------------------
// 9. SegmentList resolution
// ---------------------------------------------------------------------------

test "segment_list_resolution" {
  let xml = "<MPD type=\"static\" profiles=\"urn:mpeg:dash:profile:isoff-main:2011\" mediaPresentationDuration=\"PT8S\">\n" +
  "  <BaseURL>https://cdn.example.com/media/</BaseURL>\n" +
  "  <Period id=\"p0\">\n" +
  "    <AdaptationSet contentType=\"video\">\n" +
  "      <Representation id=\"v1\" bandwidth=\"1500000\">\n" +
  "        <SegmentList timescale=\"1000\" duration=\"4000\" startNumber=\"1\">\n" +
  "          <Initialization sourceURL=\"init.mp4\" range=\"0-511\"/>\n" +
  "          <SegmentURL media=\"part1.m4s\" mediaRange=\"512-1023\"/>\n" +
  "          <SegmentURL media=\"part2.m4s\" mediaRange=\"1024-2047\"/>\n" +
  "        </SegmentList>\n" +
  "      </Representation>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"

  let mpd = must_parse(xml)
  let track = match resolve_segments(mpd, 0, 0, 0, DashLimits::default()) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, dash_error_to_string(e))
      panic("unreachable")
    }
  }
  assert_opt_str(track.initialization_url, Some("https://cdn.example.com/media/init.mp4"), "init")
  assert_opt_str(track.initialization_range, Some("0-511"), "init range")
  assert_eq_int(track.segments.length(), 2, "2 list segs")
  assert_eq_str(track.segments[0].url, "https://cdn.example.com/media/part1.m4s", "part1")
  assert_opt_str(track.segments[0].media_range, Some("512-1023"), "part1 range")
  assert_eq_str(track.segments[1].url, "https://cdn.example.com/media/part2.m4s", "part2")
}

// ---------------------------------------------------------------------------
// 10. ContentProtection / DRM (Widevine, PlayReady, FairPlay, CENC PSSH)
// ---------------------------------------------------------------------------

test "content_protection_drm_pssh" {
  let xml = "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:cenc=\"urn:mpeg:cenc:2013\" type=\"static\" profiles=\"urn:mpeg:dash:profile:isoff-live:2011\">\n" +
  "  <Period id=\"p0\">\n" +
  "    <AdaptationSet contentType=\"video\" mimeType=\"video/mp4\">\n" +
  "      <ContentProtection schemeIdUri=\"urn:mpeg:dash:mp4protection:2011\" value=\"cenc\" cenc:default_KID=\"01020304-0506-0708-090a-0b0c0d0e0f10\"/>\n" +
  "      <ContentProtection schemeIdUri=\"urn:uuid:edef8ba9-79d6-4ace-a3c8-27dcd51d21ed\" value=\"Widevine\">\n" +
  "        <cenc:pssh>AAAAW3Bzc2gAAAAA7e+LqXnWSs6jyCfc1R0h7QAAADsIARIQ</cenc:pssh>\n" +
  "      </ContentProtection>\n" +
  "      <ContentProtection schemeIdUri=\"urn:uuid:9a04f079-9840-4286-ab92-e65be0885f95\" value=\"PlayReady\">\n" +
  "        <cenc:pssh>AAACBnBzc2gAAAAAmgTweZhAQoarkuZb4IhflQ==</cenc:pssh>\n" +
  "      </ContentProtection>\n" +
  "      <Representation id=\"v1\" bandwidth=\"2000000\"/>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"

  let mpd = must_parse(xml)
  let cps = mpd.periods[0].adaptation_sets[0].content_protections
  assert_eq_int(cps.length(), 3, "3 DRM descriptors")
  assert_opt_str(cps[0].default_kid, Some("01020304-0506-0708-090a-0b0c0d0e0f10"), "default_KID")
  assert_eq_int(cps[1].pssh.length(), 1, "widevine pssh")
  assert_eq_str(cps[1].pssh[0], "AAAAW3Bzc2gAAAAA7e+LqXnWSs6jyCfc1R0h7QAAADsIARIQ", "wv pssh payload")
  assert_eq_int(cps[2].pssh.length(), 1, "playready pssh")
}

// ---------------------------------------------------------------------------
// 11. ABR Representation selection
// ---------------------------------------------------------------------------

test "abr_select_representation" {
  let xml = "<MPD type=\"static\" profiles=\"urn:mpeg:dash:profile:isoff-live:2011\">\n" +
  "  <Period id=\"p0\">\n" +
  "    <AdaptationSet contentType=\"video\" mimeType=\"video/mp4\">\n" +
  "      <Representation id=\"avc_low\" bandwidth=\"500000\" codecs=\"avc1.4d401e\"/>\n" +
  "      <Representation id=\"avc_mid\" bandwidth=\"1500000\" codecs=\"avc1.64001f\"/>\n" +
  "      <Representation id=\"av1_hd\" bandwidth=\"2000000\" codecs=\"av01.0.08M.08\"/>\n" +
  "      <Representation id=\"avc_4k\" bandwidth=\"8000000\" codecs=\"avc1.640033\"/>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"

  let mpd = must_parse(xml)
  let aset = mpd.periods[0].adaptation_sets[0]
  // Prefer av01 within 3 Mbps -> index 2 (av1_hd)
  match select_representation(aset, 3000000L, ["av01"]) {
    Some(idx) => assert_eq_int(idx, 2, "prefer av01")
    None => debug_assert(false, "expected Some(2)")
  }
  // Prefer avc1 within 2.5 Mbps -> index 1 (avc_mid)
  match select_representation(aset, 2500000L, ["avc1"]) {
    Some(idx) => assert_eq_int(idx, 1, "prefer avc1 within budget")
    None => debug_assert(false, "expected Some(1)")
  }
  // Budget below all representations -> fallback to lowest bandwidth (index 0)
  match select_representation(aset, 100000L, []) {
    Some(idx) => assert_eq_int(idx, 0, "below min -> lowest")
    None => debug_assert(false, "expected Some(0)")
  }
  // Unmatched preferred codec -> fallback to all representations within budget (index 2)
  match select_representation(aset, 2500000L, ["vp9"]) {
    Some(idx) => assert_eq_int(idx, 2, "fallback when preferred missing")
    None => debug_assert(false, "expected Some(2)")
  }
}

// ---------------------------------------------------------------------------
// 12. Deterministic XML serialization & roundtrip + injection escaping
// ---------------------------------------------------------------------------

test "format_mpd_roundtrip_and_escaping" {
  let xml = "<MPD id=\"m&amp;1\" type=\"static\" profiles=\"urn:mpeg:dash:profile:isoff-live:2011\" mediaPresentationDuration=\"PT1M30S\" minBufferTime=\"PT2S\">\n" +
  "  <BaseURL>https://cdn.example.com/a?x=1&amp;y=2</BaseURL>\n" +
  "  <Period id=\"p0\" start=\"PT0S\" duration=\"PT1M30S\">\n" +
  "    <AdaptationSet id=\"1\" contentType=\"video\" mimeType=\"video/mp4\" lang=\"en\">\n" +
  "      <SupplementalProperty schemeIdUri=\"urn:example:prop\" value=\"a&lt;b&gt;&quot;c&quot;&apos;\"/>\n" +
  "      <Representation id=\"v1\" bandwidth=\"1200000\" width=\"1280\" height=\"720\" frameRate=\"24000/1001\" codecs=\"avc1.64001f\">\n" +
  "        <SegmentTemplate timescale=\"1000\" startNumber=\"1\" initialization=\"init.mp4\" media=\"seg_$Number$.m4s\">\n" +
  "          <SegmentTimeline>\n" +
  "            <S t=\"0\" d=\"2000\" r=\"4\"/>\n" +
  "          </SegmentTimeline>\n" +
  "        </SegmentTemplate>\n" +
  "      </Representation>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"

  let mpd1 = must_parse(xml)
  let out1 = match format_mpd(mpd1) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, dash_error_to_string(e))
      panic("unreachable")
    }
  }
  let mpd2 = must_parse(out1)
  let out2 = match format_mpd(mpd2) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, dash_error_to_string(e))
      panic("unreachable")
    }
  }
  assert_eq_str(out1, out2, "deterministic canonical roundtrip")
  assert_opt_str(mpd2.id, Some("m&1"), "escaped attr roundtrip")
  assert_eq_str(mpd2.base_urls[0], "https://cdn.example.com/a?x=1&y=2", "escaped text roundtrip")
  assert_opt_str(mpd2.periods[0].adaptation_sets[0].supplemental_properties[0].value, Some("a<b>\"c\"'"), "prop escaping")
}

// ---------------------------------------------------------------------------
// 13. XML CDATA, comments, entities, numeric character references
// ---------------------------------------------------------------------------

test "xml_cdata_comments_and_char_refs" {
  let xml = "<?xml version=\"1.0\"?>\n" +
  "<!-- leading comment -->\n" +
  "<MPD type=\"static\" profiles=\"p\">\n" +
  "  <BaseURL><![CDATA[https://cdn.example.com/path?a=1&b=2]]></BaseURL>\n" +
  "  <Period id=\"&#65;&#x42;&#x4E2D;\">\n" +
  "    <AdaptationSet contentType=\"text\" mimeType=\"text/vtt\" lang=\"zh\">\n" +
  "      <Accessibility schemeIdUri=\"urn:tva:metadata:cs:AudioPurposeCS:2007\" value=\"1\"/>\n" +
  "      <EssentialProperty schemeIdUri=\"urn:mpeg:dash:essential\" value=\"yes\"/>\n" +
  "      <Representation id=\"sub1\" bandwidth=\"1000\"/>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"

  let mpd = must_parse(xml)
  assert_eq_str(mpd.base_urls[0], "https://cdn.example.com/path?a=1&b=2", "CDATA url")
  assert_opt_str(mpd.periods[0].id, Some("AB中"), "numeric char refs")
  assert_eq_int(mpd.periods[0].adaptation_sets[0].accessibilities.length(), 1, "accessibility")
  assert_eq_int(mpd.periods[0].adaptation_sets[0].essential_properties.length(), 1, "essential")
}

// ---------------------------------------------------------------------------
// 14. BaseURL RFC 3986 hierarchical resolution
// ---------------------------------------------------------------------------

test "base_url_hierarchical_resolution" {
  assert_eq_str(
    resolve_url("https://cdn.example.com/a/b/manifest.mpd", "seg/1.m4s"),
    "https://cdn.example.com/a/b/seg/1.m4s",
    "relative sibling",
  )
  assert_eq_str(
    resolve_url("https://cdn.example.com/a/b/c/", "../d/1.m4s"),
    "https://cdn.example.com/a/b/d/1.m4s",
    "dotdot",
  )
  assert_eq_str(
    resolve_url("https://cdn.example.com/a/b/", "/root/1.m4s"),
    "https://cdn.example.com/root/1.m4s",
    "root-relative",
  )
  assert_eq_str(
    resolve_url("https://cdn.example.com/a/", "https://other.example.com/x.m4s"),
    "https://other.example.com/x.m4s",
    "absolute override",
  )
  assert_eq_str(
    resolve_url("https://cdn.example.com/a/", "//mirror.example.com/x.m4s"),
    "https://mirror.example.com/x.m4s",
    "scheme-relative",
  )
}

// ---------------------------------------------------------------------------
// 15. RED TEAM: XXE & Billion Laughs rejection
// ---------------------------------------------------------------------------

test "redteam_xxe_and_billion_laughs_rejected" {
  let xxe = "<?xml version=\"1.0\"?>\n" +
  "<!DOCTYPE foo [ <!ENTITY xxe SYSTEM \"file:///etc/passwd\"> ]>\n" +
  "<MPD type=\"static\" profiles=\"p\"><BaseURL>&xxe;</BaseURL></MPD>"
  match parse(xxe) {
    Err(DashError::SecurityRejected(_)) => ()
    Ok(_) => debug_assert(false, "XXE must be rejected")
    Err(e) => debug_assert(false, "expected SecurityRejected for XXE, got " + dash_error_to_string(e))
  }

  let laughs = "<?xml version=\"1.0\"?>\n" +
  "<!DOCTYPE lolz [\n" +
  "  <!ENTITY lol \"lol\">\n" +
  "  <!ENTITY lol2 \"&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;\">\n" +
  "]>\n" +
  "<MPD type=\"static\" profiles=\"p\"><BaseURL>&lol2;</BaseURL></MPD>"
  match parse(laughs) {
    Err(DashError::SecurityRejected(_)) => ()
    _ => debug_assert(false, "Billion Laughs must be rejected with SecurityRejected")
  }
}

// ---------------------------------------------------------------------------
// 16. RED TEAM: SegmentTimeline r=999999999 OOM bomb
// ---------------------------------------------------------------------------

test "redteam_timeline_repeat_oom_bomb" {
  let xml = "<MPD type=\"static\" profiles=\"p\">\n" +
  "  <Period id=\"p0\">\n" +
  "    <AdaptationSet contentType=\"video\">\n" +
  "      <Representation id=\"v1\" bandwidth=\"1000000\">\n" +
  "        <SegmentTemplate timescale=\"1000\" media=\"$Number$.m4s\">\n" +
  "          <SegmentTimeline><S t=\"0\" d=\"1000\" r=\"999999999\"/></SegmentTimeline>\n" +
  "        </SegmentTemplate>\n" +
  "      </Representation>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"
  let mpd = must_parse(xml)
  let limits = DashLimits::{
    ..DashLimits::default(),
    max_segments: 100,
  }
  match resolve_segments(mpd, 0, 0, 0, limits) {
    Err(DashError::LimitExceeded(_)) => ()
    Ok(_) => debug_assert(false, "r=999999999 must hit LimitExceeded")
    Err(e) => debug_assert(false, "expected LimitExceeded, got " + dash_error_to_string(e))
  }
}

// ---------------------------------------------------------------------------
// 17. RED TEAM: Template width bomb ($Number%999999999d$)
// ---------------------------------------------------------------------------

test "redteam_template_width_bomb_and_malformed" {
  let bad_templates = [
    "seg_$Number%999999999d$.m4s",
    "seg_$Time%99999d$.m4s",
    "seg_$Number%0-5d$.m4s",
    "seg_$Number",
    "seg_$UnknownIdentifier$.m4s",
    "seg_$Number%04x$.m4s",
  ]
  let mut i = 0
  while i < bad_templates.length() {
    match expand_template(bad_templates[i], "r1", 1L, 1000L, 0L) {
      Err(_) => ()
      Ok(u) => debug_assert(false, "expected template error for " + bad_templates[i] + ", got " + u)
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// 18. RED TEAM: Deeply nested XML DoS
// ---------------------------------------------------------------------------

test "redteam_deep_xml_nesting" {
  let sb = StringBuilder::new()
  sb.write_string("<MPD type=\"static\" profiles=\"p\">")
  let mut i = 0
  while i < 80 {
    sb.write_string("<a>")
    i = i + 1
  }
  i = 0
  while i < 80 {
    sb.write_string("</a>")
    i = i + 1
  }
  sb.write_string("</MPD>")
  match parse(sb.to_string()) {
    Err(DashError::LimitExceeded(_)) => ()
    Ok(_) => debug_assert(false, "depth 80 must exceed default max_xml_depth=64")
    Err(e) => debug_assert(false, "expected LimitExceeded, got " + dash_error_to_string(e))
  }
}

// ---------------------------------------------------------------------------
// 19. RED TEAM: Int64 overflow in bandwidth & timeline accumulation
// ---------------------------------------------------------------------------

test "redteam_int64_overflow" {
  let bad_bw = "<MPD type=\"static\" profiles=\"p\"><Period><AdaptationSet>" +
  "<Representation id=\"v1\" bandwidth=\"99999999999999999999\"/>" +
  "</AdaptationSet></Period></MPD>"
  match parse(bad_bw) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "overflowing bandwidth must fail")
  }

  let bad_zero_bw = "<MPD type=\"static\" profiles=\"p\"><Period><AdaptationSet>" +
  "<Representation id=\"v1\" bandwidth=\"0\"/>" +
  "</AdaptationSet></Period></MPD>"
  match parse(bad_zero_bw) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "zero bandwidth must fail")
  }

  let overflow_tl = "<MPD type=\"static\" profiles=\"p\"><Period><AdaptationSet>" +
  "<Representation id=\"v1\" bandwidth=\"1000\">" +
  "<SegmentTemplate timescale=\"1\" media=\"$Time$.m4s\">" +
  "<SegmentTimeline><S t=\"9223372036854775000\" d=\"1000\" r=\"2\"/></SegmentTimeline>" +
  "</SegmentTemplate></Representation></AdaptationSet></Period></MPD>"
  let mpd = must_parse(overflow_tl)
  match resolve_segments(mpd, 0, 0, 0, DashLimits::default()) {
    Err(DashError::InvalidNumber(_)) => ()
    Ok(_) => debug_assert(false, "timeline Int64 overflow must fail")
    Err(e) => debug_assert(false, "expected InvalidNumber on overflow, got " + dash_error_to_string(e))
  }
}

// ---------------------------------------------------------------------------
// 20. RED TEAM: Negative and zero DashLimits
// ---------------------------------------------------------------------------

test "redteam_negative_and_zero_limits" {
  let simple = "<MPD type=\"static\" profiles=\"p\"><Period><AdaptationSet><Representation id=\"v1\" bandwidth=\"1000\"/></AdaptationSet></Period></MPD>"

  let neg = DashLimits::{ ..DashLimits::default(), max_periods: -1 }
  match parse_with_limits(simple, neg) {
    Err(DashError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative max_periods must return LimitExceeded")
  }

  let neg_seg = DashLimits::{ ..DashLimits::default(), max_segments: -1 }
  let mpd = must_parse(simple)
  match resolve_segments(mpd, 0, 0, 0, neg_seg) {
    Err(DashError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative max_segments must return LimitExceeded")
  }

  let zero_periods = DashLimits::{ ..DashLimits::default(), max_periods: 0 }
  match parse_with_limits(simple, zero_periods) {
    Err(DashError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_periods=0 must reject 1 Period")
  }

  let zero_ok = "<MPD type=\"static\" profiles=\"p\"/>"
  match parse_with_limits(zero_ok, zero_periods) {
    Ok(m) => assert_eq_int(m.periods.length(), 0, "0 periods allowed when max_periods=0")
    Err(e) => debug_assert(false, "0 periods should succeed when max_periods=0: " + dash_error_to_string(e))
  }
}

// ---------------------------------------------------------------------------
// 21. RED TEAM: Invalid XML numeric char refs (surrogates, NUL, overflow)
// ---------------------------------------------------------------------------

test "redteam_invalid_char_refs_and_xml_errors" {
  let bad_xmls = [
    "<MPD type=\"static\" profiles=\"&#0;\"/>",
    "<MPD type=\"static\" profiles=\"&#xD800;\"/>",
    "<MPD type=\"static\" profiles=\"&#xDFFF;\"/>",
    "<MPD type=\"static\" profiles=\"&#x110000;\"/>",
    "<MPD type=\"static\" profiles=\"&#x999999999999;\"/>",
    "<MPD type=\"static\" profiles=\"&unknown;\"/>",
    "<MPD type=\"static\" profiles=\"p\" type=\"dynamic\"/>",
    "<MPD type=\"static\" profiles=\"p\"></Period>",
    "<NotMPD/>",
  ]
  let mut i = 0
  while i < bad_xmls.length() {
    match parse(bad_xmls[i]) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "expected XML/MPD error for: " + bad_xmls[i])
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// 22. RED TEAM: Control character rejection in format_mpd
// ---------------------------------------------------------------------------

test "redteam_format_mpd_rejects_control_chars" {
  let mpd = must_parse("<MPD type=\"static\" profiles=\"p\"/>")
  let bad_mpd = Mpd::{ ..mpd, profiles: "bad\x07profile" }
  match format_mpd(bad_mpd) {
    Err(DashError::InvalidXml(_)) => ()
    Ok(_) => debug_assert(false, "control char in format_mpd must be rejected")
    Err(e) => debug_assert(false, "expected InvalidXml, got " + dash_error_to_string(e))
  }
}

// ---------------------------------------------------------------------------
// 23. Period-level SegmentTemplate inherited by AdaptationSet & Representation
// ---------------------------------------------------------------------------

test "period_level_segment_template_inheritance" {
  let xml = "<MPD type=\"static\" profiles=\"p\" mediaPresentationDuration=\"PT6S\">\n" +
  "  <Period id=\"p0\">\n" +
  "    <SegmentTemplate timescale=\"1000\" duration=\"2000\" startNumber=\"1\" initialization=\"$RepresentationID$/init.mp4\" media=\"$RepresentationID$/$Number$.m4s\"/>\n" +
  "    <AdaptationSet contentType=\"video\">\n" +
  "      <Representation id=\"r720\" bandwidth=\"2000000\"/>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"
  let mpd = must_parse(xml)
  let track = match resolve_segments(mpd, 0, 0, 0, DashLimits::default()) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, dash_error_to_string(e))
      panic("unreachable")
    }
  }
  assert_opt_str(track.initialization_url, Some("r720/init.mp4"), "inherited init")
  assert_eq_int(track.segments.length(), 3, "3 segments")
  assert_eq_str(track.segments[2].url, "r720/3.m4s", "seg 3")
}

// ---------------------------------------------------------------------------
// 24. Required Representation attributes (id, bandwidth) & bounds check
// ---------------------------------------------------------------------------

test "missing_required_representation_attrs_and_bounds" {
  let no_id = "<MPD type=\"static\" profiles=\"p\"><Period><AdaptationSet><Representation bandwidth=\"1000\"/></AdaptationSet></Period></MPD>"
  match parse(no_id) {
    Err(DashError::InvalidMpd(_)) => ()
    _ => debug_assert(false, "missing Representation@id must fail")
  }

  let no_bw = "<MPD type=\"static\" profiles=\"p\"><Period><AdaptationSet><Representation id=\"v1\"/></AdaptationSet></Period></MPD>"
  match parse(no_bw) {
    Err(DashError::InvalidMpd(_)) => ()
    _ => debug_assert(false, "missing Representation@bandwidth must fail")
  }

  let mpd = must_parse("<MPD type=\"static\" profiles=\"p\"><Period><AdaptationSet><Representation id=\"v1\" bandwidth=\"1000\"/></AdaptationSet></Period></MPD>")
  match resolve_segments(mpd, 1, 0, 0, DashLimits::default()) {
    Err(DashError::IndexOutOfBounds(_)) => ()
    _ => debug_assert(false, "out-of-bounds period_idx must fail")
  }
}

// ---------------------------------------------------------------------------
// 25. Regression tests for audit findings (P0-1, P1-1..P1-4, P2-1..P2-10)
// ---------------------------------------------------------------------------

test "audit_regressions_rfc3986_pto_namespaces_playready" {
  // P1-1: RFC 3986 reference resolution
  assert_eq_str(resolve_url("http://h/a/b/c", ".."), "http://h/a/", "dotdot trailing slash")
  assert_eq_str(resolve_url("http://h/a/b/", "."), "http://h/a/b/", "dot trailing slash")
  assert_eq_str(resolve_url("http://h/a/b", "x//y"), "http://h/a/x//y", "preserve empty segment")
  assert_eq_str(resolve_url("http://h/a?q=1", "#f"), "http://h/a?q=1#f", "fragment keeps base query")
  assert_eq_str(resolve_url("../media/", "seg.m4s"), "../media/seg.m4s", "relative BaseURL keeps leading ..")
  assert_eq_str(resolve_url("video/../../x/", "s.m4s"), "../x/s.m4s", "rootless relative ..")

  // P1-3: r=-1 with presentationTimeOffset
  let pto_xml = "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" type=\"static\" mediaPresentationDuration=\"PT10S\">" +
  "<Period><AdaptationSet><Representation id=\"v\" bandwidth=\"1000\">" +
  "<SegmentTemplate timescale=\"1\" presentationTimeOffset=\"1000\" media=\"s$Time$\">" +
  "<SegmentTimeline><S t=\"1000\" d=\"2\" r=\"-1\"/></SegmentTimeline></SegmentTemplate>" +
  "</Representation></AdaptationSet></Period></MPD>"
  let pto_mpd = must_parse(pto_xml)
  match resolve_segments(pto_mpd, 0, 0, 0, DashLimits::default()) {
    Ok(t) => assert_eq_int(t.segments.length(), 5, "PTO=1000 r=-1 -> 5 segments")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }

  // P2-1: Period@start inference
  let p_xml = "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" type=\"static\" mediaPresentationDuration=\"PT10S\">" +
  "<Period><AdaptationSet><Representation id=\"v\" bandwidth=\"1000\"><SegmentTemplate duration=\"2\" media=\"s$Number$\"/></Representation></AdaptationSet></Period>" +
  "<Period start=\"PT4S\"><AdaptationSet><Representation id=\"v\" bandwidth=\"1000\"><SegmentTemplate duration=\"2\" media=\"s$Number$\"/></Representation></AdaptationSet></Period></MPD>"
  let p_mpd = must_parse(p_xml)
  match resolve_segments(p_mpd, 0, 0, 0, DashLimits::default()) {
    Ok(t) => assert_eq_int(t.segments.length(), 2, "inferred first Period duration 4s -> 2 segs")
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }

  // P2-2: S@r < -1 rejected
  let bad_r = "<MPD type=\"static\"><Period><AdaptationSet><Representation id=\"v\" bandwidth=\"1\">" +
  "<SegmentTemplate media=\"s$Time$\"><SegmentTimeline><S t=\"0\" d=\"2\" r=\"-5\"/></SegmentTimeline></SegmentTemplate>" +
  "</Representation></AdaptationSet></Period></MPD>"
  match parse(bad_r) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "S@r=-5 must be rejected")
  }

  // P2-6: attribute-value normalisation
  let norm_mpd = must_parse("<MPD type=\"static\"><Period><AdaptationSet><Representation id=\"a\tb\nc\r\nd\" bandwidth=\"1\"/></AdaptationSet></Period></MPD>")
  assert_eq_str(norm_mpd.periods[0].adaptation_sets[0].representations[0].id, "a b c d", "attr norm")

  // P2-8: multi-codec ABR matching
  let abr_mpd = must_parse(
    "<MPD type=\"static\"><Period><AdaptationSet>" +
    "<Representation id=\"mux\" bandwidth=\"3000000\" codecs=\"mp4a.40.2,avc1.640028\"/>" +
    "<Representation id=\"hevc\" bandwidth=\"4000000\" codecs=\"hvc1.1.6.L93.B0\"/>" +
    "</AdaptationSet></Period></MPD>",
  )
  match select_representation(abr_mpd.periods[0].adaptation_sets[0], 5000000L, ["avc1"]) {
    Some(0) => ()
    _ => debug_assert(false, "expected muxed avc1 representation")
  }

  // P2-9: namespace-aware lookup
  let ns_mpd = must_parse(
    "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:x=\"urn:example:other\" type=\"static\">" +
    "<x:Period><AdaptationSet/></x:Period>" +
    "<Period><AdaptationSet><Representation x:id=\"evil\" id=\"v\" bandwidth=\"1\"/></AdaptationSet></Period></MPD>",
  )
  assert_eq_int(ns_mpd.periods.length(), 1, "foreign x:Period ignored")
  assert_eq_str(ns_mpd.periods[0].adaptation_sets[0].representations[0].id, "v", "foreign x:id ignored")

  // P2-10: PlayReady <mspr:pro> preserved & round-tripped
  let pro_xml = "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:mspr=\"urn:microsoft:playready\" type=\"static\">" +
  "<Period><AdaptationSet><ContentProtection schemeIdUri=\"urn:uuid:9a04f079-9840-4286-ab92-e65be0885f95\" value=\"MSPR 2.0\">" +
  "<mspr:pro>UFJPREFUQVBMQVlSRUFEWQ==</mspr:pro></ContentProtection><Representation id=\"v\" bandwidth=\"1\"/></AdaptationSet></Period></MPD>"
  let pro_mpd = must_parse(pro_xml)
  assert_eq_int(pro_mpd.periods[0].adaptation_sets[0].content_protections[0].pro.length(), 1, "mspr:pro parsed")
  assert_eq_str(pro_mpd.periods[0].adaptation_sets[0].content_protections[0].pro[0], "UFJPREFUQVBMQVlSRUFEWQ==", "mspr:pro value")
  match format_mpd(pro_mpd) {
    Ok(out) => {
      let reparsed = must_parse(out)
      assert_eq_str(reparsed.periods[0].adaptation_sets[0].content_protections[0].pro[0], "UFJPREFUQVBMQVlSRUFEWQ==", "mspr:pro roundtrip")
    }
    Err(e) => debug_assert(false, dash_error_to_string(e))
  }
}
