///| Security-hardened, zero-dependency XML 1.0 + Namespaces parser for MPEG-DASH `.mpd` documents.
///| Explicitly rejects `<!DOCTYPE` and `<!ENTITY` (eliminating XXE & Billion Laughs),
///| enforces XML 1.0 well-formedness (UTF-8 / Char / Name / XMLDecl / PI / ']]>' / attr normalisation),
///| uses an explicit heap stack (no recursion stack overflow), and enforces `DashLimits`.

struct XmlAttr {
  name : String
  prefix : String
  local_name : String
  ns : String
  value : String
}

struct XmlElement {
  name : String
  prefix : String
  local_name : String
  ns : String
  attrs : Array[XmlAttr]
  text : String
  children : Array[XmlElement]
}

struct XmlFrame {
  name : String
  prefix : String
  local_name : String
  ns : String
  attrs : Array[XmlAttr]
  ns_mark : Int
  children : Array[XmlElement]
  text_sb : StringBuilder
  mut text_bytes : Int
}

fn xml_split_qname(qname : String) -> (String, String) {
  let n = qname.length()
  let mut i = 0
  while i < n {
    if qname.code_unit_at(i) == 58 {
      return (qname.slice(0, i), qname.slice(i + 1, n))
    }
    i = i + 1
  }
  ("", qname)
}

fn xml_is_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

fn xml_is_valid_scalar(cp : Int) -> Bool {
  if cp == 9 || cp == 10 || cp == 13 {
    return true
  }
  if cp >= 32 && cp <= 55295 {
    return true
  }
  if cp >= 57344 && cp <= 65533 {
    return true
  }
  if cp >= 65536 && cp <= 1114111 {
    return true
  }
  false
}

///| XML 1.0 (5th ed.) NameStartChar.
fn xml_is_name_start_cp(cp : Int) -> Bool {
  if cp < 128 {
    return (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp == 95 || cp == 58
  }
  (cp >= 0xC0 && cp <= 0xD6) ||
  (cp >= 0xD8 && cp <= 0xF6) ||
  (cp >= 0xF8 && cp <= 0x2FF) ||
  (cp >= 0x370 && cp <= 0x37D) ||
  (cp >= 0x37F && cp <= 0x1FFF) ||
  cp == 0x200C ||
  cp == 0x200D ||
  (cp >= 0x2070 && cp <= 0x218F) ||
  (cp >= 0x2C00 && cp <= 0x2FEF) ||
  (cp >= 0x3001 && cp <= 0xD7FF) ||
  (cp >= 0xF900 && cp <= 0xFDCF) ||
  (cp >= 0xFDF0 && cp <= 0xFFFD) ||
  (cp >= 0x10000 && cp <= 0xEFFFF)
}

///| XML 1.0 (5th ed.) NameChar.
fn xml_is_name_char_cp(cp : Int) -> Bool {
  if cp < 128 {
    return (cp >= 65 && cp <= 90) ||
    (cp >= 97 && cp <= 122) ||
    (cp >= 48 && cp <= 57) ||
    cp == 95 ||
    cp == 58 ||
    cp == 45 ||
    cp == 46
  }
  xml_is_name_start_cp(cp) || cp == 0xB7 || (cp >= 0x300 && cp <= 0x36F) || cp == 0x203F || cp == 0x2040
}

///| Decode a UTF-8 code point at `pos` in a pre-validated UTF-8 string. Returns `(cp, byte_len)`.
fn utf8_decode_valid_at(s : String, pos : Int) -> (Int, Int) {
  let b0 = s.code_unit_at(pos)
  if b0 < 128 {
    return (b0, 1)
  }
  if b0 < 224 {
    let b1 = s.code_unit_at(pos + 1)
    return (((b0 & 31) << 6) | (b1 & 63), 2)
  }
  if b0 < 240 {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    return (((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63), 3)
  }
  let b1 = s.code_unit_at(pos + 1)
  let b2 = s.code_unit_at(pos + 2)
  let b3 = s.code_unit_at(pos + 3)
  (((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63), 4)
}

///| Validate strict UTF-8 and XML 1.0 `Char` across the entire string.
///| Returns `Ok(has_cr)` on success.
fn xml_validate_utf8_and_chars(s : String) -> Result[Bool, DashError] {
  let n = s.length()
  let mut i = 0
  let mut has_cr = false
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 128 {
      if b0 >= 32 || b0 == 9 || b0 == 10 {
        i = i + 1
        continue
      }
      if b0 == 13 {
        has_cr = true
        i = i + 1
        continue
      }
      return Err(DashError::InvalidXml("illegal XML 1.0 control character"))
    }
    if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return Err(DashError::InvalidXml("truncated 2-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 {
        return Err(DashError::InvalidXml("invalid UTF-8 continuation byte"))
      }
      i = i + 2
      continue
    }
    if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return Err(DashError::InvalidXml("truncated 3-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return Err(DashError::InvalidXml("invalid UTF-8 continuation byte"))
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return Err(DashError::InvalidXml("overlong 3-byte UTF-8 sequence"))
      }
      if b0 == 0xED && b1 > 0x9F {
        return Err(DashError::InvalidXml("UTF-8 encoded surrogate code point"))
      }
      let cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
      if cp == 0xFFFE || cp == 0xFFFF {
        return Err(DashError::InvalidXml("non-character U+FFFE/U+FFFF not allowed in XML 1.0"))
      }
      i = i + 3
      continue
    }
    if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return Err(DashError::InvalidXml("truncated 4-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return Err(DashError::InvalidXml("invalid UTF-8 continuation byte"))
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return Err(DashError::InvalidXml("overlong 4-byte UTF-8 sequence"))
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return Err(DashError::InvalidXml("UTF-8 code point exceeds U+10FFFF"))
      }
      i = i + 4
      continue
    }
    return Err(DashError::InvalidXml("invalid UTF-8 lead byte"))
  }
  Ok(has_cr)
}

///| Normalize `\r\n` and `\r` to `\n` (XML 1.0 §2.11 End-of-Line Handling).
fn xml_normalize_eol(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let start = i
    while i < n && s.code_unit_at(i) != 13 {
      i = i + 1
    }
    if i > start {
      sb.write_string(s.slice(start, i))
    }
    if i < n {
      sb.write_string("\n")
      if i + 1 < n && s.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
    }
  }
  sb.to_string()
}

fn write_utf8_codepoint(sb : StringBuilder, cp : Int) -> Unit {
  if cp <= 127 {
    let b = Bytes::new(1)
    b[0] = cp.to_byte()
    sb.write_string(b.to_string())
  } else if cp <= 2047 {
    let b = Bytes::new(2)
    b[0] = (192 | (cp >> 6)).to_byte()
    b[1] = (128 | (cp & 63)).to_byte()
    sb.write_string(b.to_string())
  } else if cp <= 65535 {
    let b = Bytes::new(3)
    b[0] = (224 | (cp >> 12)).to_byte()
    b[1] = (128 | ((cp >> 6) & 63)).to_byte()
    b[2] = (128 | (cp & 63)).to_byte()
    sb.write_string(b.to_string())
  } else {
    let b = Bytes::new(4)
    b[0] = (240 | (cp >> 18)).to_byte()
    b[1] = (128 | ((cp >> 12) & 63)).to_byte()
    b[2] = (128 | ((cp >> 6) & 63)).to_byte()
    b[3] = (128 | (cp & 63)).to_byte()
    sb.write_string(b.to_string())
  }
}

fn xml_validate_limits(limits : DashLimits) -> Result[Unit, DashError] {
  if limits.max_input_bytes < 0 ||
  limits.max_xml_depth < 0 ||
  limits.max_elements < 0 ||
  limits.max_attributes < 0 ||
  limits.max_periods < 0 ||
  limits.max_adaptation_sets < 0 ||
  limits.max_representations < 0 ||
  limits.max_segments < 0 ||
  limits.max_timeline_entries < 0 ||
  limits.max_text_bytes < 0 ||
  limits.max_output_bytes < 0 {
    return Err(DashError::LimitExceeded("negative limit is not allowed"))
  }
  Ok(())
}

fn xml_starts_with_at(s : String, pos : Int, prefix : String) -> Bool {
  let pn = prefix.length()
  if pos + pn > s.length() {
    return false
  }
  let mut i = 0
  while i < pn {
    if s.code_unit_at(pos + i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn xml_starts_with_ci_at(s : String, pos : Int, upper_prefix : String) -> Bool {
  let pn = upper_prefix.length()
  if pos + pn > s.length() {
    return false
  }
  let mut i = 0
  while i < pn {
    let mut c = s.code_unit_at(pos + i)
    if c >= 97 && c <= 122 {
      c = c - 32
    }
    if c != upper_prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn xml_eq_ci_ascii(s : String, lower : String) -> Bool {
  if s.length() != lower.length() {
    return false
  }
  let mut i = 0
  while i < s.length() {
    let mut c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      c = c + 32
    }
    if c != lower.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn xml_decode_entities(
  s : String,
  start : Int,
  end : Int,
  max_text_bytes : Int,
  is_attr : Bool,
) -> Result[String, DashError] {
  // Fast path: check if '&', attribute whitespace (TAB/LF), or ']]>' (in text) exists.
  // Note: `s` has already been UTF-8 validated, XML Char validated, and EOL-normalized (\r -> \n).
  let mut has_special = false
  let mut scan = start
  while scan < end {
    let c = s.code_unit_at(scan)
    if c == 38 {
      has_special = true
      break
    }
    if is_attr {
      if c == 9 || c == 10 {
        has_special = true
        break
      }
    } else if c == 93 && scan + 2 < end && s.code_unit_at(scan + 1) == 93 && s.code_unit_at(scan + 2) == 62 {
      return Err(DashError::InvalidXml("']]>' is not permitted in XML character data"))
    }
    scan = scan + 1
  }
  if !has_special {
    if end - start > max_text_bytes {
      return Err(DashError::LimitExceeded("text exceeds max_text_bytes"))
    }
    return Ok(s.slice(start, end))
  }

  let sb = StringBuilder::new()
  let mut out_len = 0
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if !is_attr && c == 93 && i + 2 < end && s.code_unit_at(i + 1) == 93 && s.code_unit_at(i + 2) == 62 {
      return Err(DashError::InvalidXml("']]>' is not permitted in XML character data"))
    }
    if is_attr && (c == 9 || c == 10) {
      // XML 1.0 §3.3.3 attribute-value normalisation: literal TAB/LF become space
      out_len = out_len + 1
      if out_len > max_text_bytes {
        return Err(DashError::LimitExceeded("text exceeds max_text_bytes"))
      }
      sb.write_string(" ")
      i = i + 1
      continue
    }
    if c != 38 {
      let run_start = i
      while i < end {
        let rc = s.code_unit_at(i)
        if rc == 38 {
          break
        }
        if is_attr && (rc == 9 || rc == 10) {
          break
        }
        if !is_attr && rc == 93 && i + 2 < end && s.code_unit_at(i + 1) == 93 && s.code_unit_at(i + 2) == 62 {
          return Err(DashError::InvalidXml("']]>' is not permitted in XML character data"))
        }
        i = i + 1
      }
      out_len = out_len + (i - run_start)
      if out_len > max_text_bytes {
        return Err(DashError::LimitExceeded("text exceeds max_text_bytes"))
      }
      sb.write_string(s.slice(run_start, i))
      continue
    }

    // Entity or numeric character reference (arbitrary length permitted per XML 1.0)
    let mut semi = i + 1
    while semi < end && s.code_unit_at(semi) != 59 {
      semi = semi + 1
    }
    if semi >= end || s.code_unit_at(semi) != 59 {
      return Err(DashError::InvalidXml("unterminated entity reference"))
    }
    let body = s.slice(i + 1, semi)
    if body == "amp" {
      out_len = out_len + 1
      if out_len > max_text_bytes {
        return Err(DashError::LimitExceeded("text exceeds max_text_bytes"))
      }
      sb.write_string("&")
    } else if body == "lt" {
      out_len = out_len + 1
      if out_len > max_text_bytes {
        return Err(DashError::LimitExceeded("text exceeds max_text_bytes"))
      }
      sb.write_string("<")
    } else if body == "gt" {
      out_len = out_len + 1
      if out_len > max_text_bytes {
        return Err(DashError::LimitExceeded("text exceeds max_text_bytes"))
      }
      sb.write_string(">")
    } else if body == "quot" {
      out_len = out_len + 1
      if out_len > max_text_bytes {
        return Err(DashError::LimitExceeded("text exceeds max_text_bytes"))
      }
      sb.write_string("\"")
    } else if body == "apos" {
      out_len = out_len + 1
      if out_len > max_text_bytes {
        return Err(DashError::LimitExceeded("text exceeds max_text_bytes"))
      }
      sb.write_string("'")
    } else if body.length() >= 2 && body.code_unit_at(0) == 35 {
      // Numeric character reference: &#...; or &#x...; (lowercase 'x' only per XML 1.0)
      let mut cp = 0
      if body.code_unit_at(1) == 120 {
        if body.length() < 3 {
          return Err(DashError::InvalidXml("empty hex character reference"))
        }
        let mut k = 2
        while k < body.length() {
          let hc = body.code_unit_at(k)
          let dv = if hc >= 48 && hc <= 57 {
            hc - 48
          } else if hc >= 65 && hc <= 70 {
            hc - 55
          } else if hc >= 97 && hc <= 102 {
            hc - 87
          } else {
            return Err(DashError::InvalidXml("invalid hex digit in char ref"))
          }
          if cp > 1114111 {
            return Err(DashError::InvalidXml("char ref overflow"))
          }
          cp = cp * 16 + dv
          k = k + 1
        }
      } else {
        let mut k = 1
        while k < body.length() {
          let dc = body.code_unit_at(k)
          if dc < 48 || dc > 57 {
            return Err(DashError::InvalidXml("invalid decimal digit in char ref"))
          }
          if cp > 1114111 {
            return Err(DashError::InvalidXml("char ref overflow"))
          }
          cp = cp * 10 + (dc - 48)
          k = k + 1
        }
      }
      if !xml_is_valid_scalar(cp) {
        return Err(DashError::InvalidXml("invalid XML 1.0 Unicode scalar in char ref"))
      }
      let utf8_len = if cp <= 127 {
        1
      } else if cp <= 2047 {
        2
      } else if cp <= 65535 {
        3
      } else {
        4
      }
      out_len = out_len + utf8_len
      if out_len > max_text_bytes {
        return Err(DashError::LimitExceeded("text exceeds max_text_bytes"))
      }
      write_utf8_codepoint(sb, cp)
    } else {
      return Err(DashError::InvalidXml("unknown XML entity: &" + body + ";"))
    }
    i = semi + 1
  }
  Ok(sb.to_string())
}

struct XmlParserState {
  src : String
  len : Int
  bom_end : Int
  mut pos : Int
  mut elem_count : Int
  limits : DashLimits
  ns_prefixes : Array[String]
  ns_uris : Array[String]
}

fn xp_ns_lookup(st : XmlParserState, prefix : String) -> String {
  if prefix == "xml" {
    return "http://www.w3.org/XML/1998/namespace"
  }
  let mut i = st.ns_prefixes.length() - 1
  while i >= 0 {
    if st.ns_prefixes[i] == prefix {
      return st.ns_uris[i]
    }
    i = i - 1
  }
  ""
}

fn xp_ns_pop_to(st : XmlParserState, mark : Int) -> Unit {
  while st.ns_prefixes.length() > mark {
    let _ = st.ns_prefixes.pop()
    let _ = st.ns_uris.pop()
  }
}

fn xp_skip_ws(st : XmlParserState) -> Unit {
  while st.pos < st.len && xml_is_ws(st.src.code_unit_at(st.pos)) {
    st.pos = st.pos + 1
  }
}

fn xp_read_name(st : XmlParserState) -> Result[String, DashError] {
  if st.pos >= st.len {
    return Err(DashError::InvalidXml("expected XML name"))
  }
  let b0 = st.src.code_unit_at(st.pos)
  let start = st.pos
  if b0 < 128 {
    if !((b0 >= 65 && b0 <= 90) || (b0 >= 97 && b0 <= 122) || b0 == 95 || b0 == 58) {
      return Err(DashError::InvalidXml("expected XML name"))
    }
    st.pos = st.pos + 1
  } else {
    let (cp, blen) = utf8_decode_valid_at(st.src, st.pos)
    if !xml_is_name_start_cp(cp) {
      return Err(DashError::InvalidXml("invalid XML NameStartChar"))
    }
    st.pos = st.pos + blen
  }
  while st.pos < st.len {
    let b = st.src.code_unit_at(st.pos)
    if b < 128 {
      if (b >= 65 && b <= 90) ||
      (b >= 97 && b <= 122) ||
      (b >= 48 && b <= 57) ||
      b == 95 ||
      b == 58 ||
      b == 45 ||
      b == 46 {
        st.pos = st.pos + 1
      } else {
        break
      }
    } else {
      let (cp, blen) = utf8_decode_valid_at(st.src, st.pos)
      if xml_is_name_char_cp(cp) {
        st.pos = st.pos + blen
      } else {
        break
      }
    }
  }
  Ok(st.src.slice(start, st.pos))
}

fn xp_skip_comment(st : XmlParserState) -> Result[Unit, DashError] {
  // Assumes st.pos is right at "<!--"
  st.pos = st.pos + 4
  while st.pos + 2 < st.len {
    if st.src.code_unit_at(st.pos) == 45 && st.src.code_unit_at(st.pos + 1) == 45 {
      if st.src.code_unit_at(st.pos + 2) == 62 {
        st.pos = st.pos + 3
        return Ok(())
      } else {
        return Err(DashError::InvalidXml("'--' is not permitted inside XML comment"))
      }
    }
    st.pos = st.pos + 1
  }
  Err(DashError::InvalidXml("unterminated XML comment"))
}

fn xp_read_xmldecl_attr(st : XmlParserState, name : String) -> Result[Option[String], DashError] {
  let saved = st.pos
  xp_skip_ws(st)
  if !xml_starts_with_at(st.src, st.pos, name) {
    st.pos = saved
    return Ok(None)
  }
  st.pos = st.pos + name.length()
  xp_skip_ws(st)
  if st.pos >= st.len || st.src.code_unit_at(st.pos) != 61 {
    return Err(DashError::InvalidXml("invalid XMLDecl attribute " + name))
  }
  st.pos = st.pos + 1
  xp_skip_ws(st)
  if st.pos >= st.len {
    return Err(DashError::InvalidXml("unterminated XMLDecl"))
  }
  let q = st.src.code_unit_at(st.pos)
  if q != 34 && q != 39 {
    return Err(DashError::InvalidXml("XMLDecl attribute must be quoted"))
  }
  st.pos = st.pos + 1
  let vstart = st.pos
  while st.pos < st.len && st.src.code_unit_at(st.pos) != q {
    st.pos = st.pos + 1
  }
  if st.pos >= st.len {
    return Err(DashError::InvalidXml("unterminated XMLDecl attribute value"))
  }
  let v = st.src.slice(vstart, st.pos)
  st.pos = st.pos + 1
  Ok(Some(v))
}

fn xp_parse_xmldecl(st : XmlParserState) -> Result[Unit, DashError] {
  // Assumes st.pos is right after "<?xml"
  if st.pos >= st.len || !xml_is_ws(st.src.code_unit_at(st.pos)) {
    return Err(DashError::InvalidXml("expected whitespace after <?xml"))
  }
  let ver = match xp_read_xmldecl_attr(st, "version") {
    Ok(Some(v)) => v
    Ok(None) => return Err(DashError::InvalidXml("XMLDecl missing required version"))
    Err(e) => return Err(e)
  }
  // VersionNum ::= '1.' [0-9]+
  if ver.length() < 3 || ver.code_unit_at(0) != 49 || ver.code_unit_at(1) != 46 {
    return Err(DashError::InvalidXml("unsupported XML version: " + ver))
  }
  let mut vi = 2
  while vi < ver.length() {
    let c = ver.code_unit_at(vi)
    if c < 48 || c > 57 {
      return Err(DashError::InvalidXml("invalid XML version: " + ver))
    }
    vi = vi + 1
  }

  let before_enc = st.pos
  match xp_read_xmldecl_attr(st, "encoding") {
    Err(e) => return Err(e)
    Ok(Some(enc)) => {
      if before_enc >= st.len || !xml_is_ws(st.src.code_unit_at(before_enc)) {
        return Err(DashError::InvalidXml("expected whitespace before encoding in XMLDecl"))
      }
      if !xml_eq_ci_ascii(enc, "utf-8") {
        return Err(DashError::InvalidXml("unsupported XML encoding: " + enc))
      }
    }
    Ok(None) => ()
  }

  let before_sd = st.pos
  match xp_read_xmldecl_attr(st, "standalone") {
    Err(e) => return Err(e)
    Ok(Some(sd)) => {
      if before_sd >= st.len || !xml_is_ws(st.src.code_unit_at(before_sd)) {
        return Err(DashError::InvalidXml("expected whitespace before standalone in XMLDecl"))
      }
      if sd != "yes" && sd != "no" {
        return Err(DashError::InvalidXml("invalid standalone value in XMLDecl: " + sd))
      }
    }
    Ok(None) => ()
  }

  xp_skip_ws(st)
  if !xml_starts_with_at(st.src, st.pos, "?>") {
    return Err(DashError::InvalidXml("expected '?>' to close XMLDecl"))
  }
  st.pos = st.pos + 2
  Ok(())
}

fn xp_skip_pi(st : XmlParserState, allow_xmldecl : Bool) -> Result[Unit, DashError] {
  // Assumes st.pos is right at "<?"
  let pi_start = st.pos
  st.pos = st.pos + 2
  let target = match xp_read_name(st) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if target == "xml" && allow_xmldecl && pi_start == st.bom_end {
    return xp_parse_xmldecl(st)
  }
  if xml_eq_ci_ascii(target, "xml") {
    return Err(DashError::InvalidXml("reserved PI target or misplaced XML declaration"))
  }
  if st.pos < st.len && !xml_is_ws(st.src.code_unit_at(st.pos)) && !xml_starts_with_at(st.src, st.pos, "?>") {
    return Err(DashError::InvalidXml("expected whitespace or '?>' after PI target"))
  }
  while st.pos + 1 < st.len {
    if st.src.code_unit_at(st.pos) == 63 && st.src.code_unit_at(st.pos + 1) == 62 {
      st.pos = st.pos + 2
      return Ok(())
    }
    st.pos = st.pos + 1
  }
  Err(DashError::InvalidXml("unterminated XML processing instruction"))
}

fn xp_read_cdata(st : XmlParserState) -> Result[String, DashError] {
  // Assumes st.pos is right at "<![CDATA["
  st.pos = st.pos + 9
  let start = st.pos
  while st.pos + 2 < st.len {
    if st.src.code_unit_at(st.pos) == 93 &&
    st.src.code_unit_at(st.pos + 1) == 93 &&
    st.src.code_unit_at(st.pos + 2) == 62 {
      let end = st.pos
      st.pos = st.pos + 3
      if end - start > st.limits.max_text_bytes {
        return Err(DashError::LimitExceeded("CDATA exceeds max_text_bytes"))
      }
      return Ok(st.src.slice(start, end))
    }
    st.pos = st.pos + 1
  }
  Err(DashError::InvalidXml("unterminated CDATA section"))
}

struct XmlStartTag {
  name : String
  prefix : String
  local_name : String
  ns : String
  attrs : Array[XmlAttr]
  self_closing : Bool
  ns_mark : Int
}

///| Parse a single start tag `<name attr="val" ...>` (or `<name .../>`) and bind its namespaces.
fn xp_parse_start_tag(st : XmlParserState) -> Result[XmlStartTag, DashError] {
  // Consume '<'
  st.pos = st.pos + 1
  let name = match xp_read_name(st) {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let (elem_prefix, elem_local) = xml_split_qname(name)
  let raw_attrs : Array[(String, String, String, String)] = []
  let mut self_closing = false

  while true {
    let had_ws = st.pos < st.len && xml_is_ws(st.src.code_unit_at(st.pos))
    xp_skip_ws(st)
    if st.pos >= st.len {
      return Err(DashError::InvalidXml("unexpected EOF in start tag <" + name + ">"))
    }
    let c = st.src.code_unit_at(st.pos)
    if c == 62 {
      st.pos = st.pos + 1
      break
    }
    if c == 47 {
      if st.pos + 1 >= st.len || st.src.code_unit_at(st.pos + 1) != 62 {
        return Err(DashError::InvalidXml("expected '>' after '/' in <" + name + "/>"))
      }
      st.pos = st.pos + 2
      self_closing = true
      break
    }
    if !had_ws {
      return Err(DashError::InvalidXml("expected whitespace before attribute in <" + name + ">"))
    }
    if raw_attrs.length() >= st.limits.max_attributes {
      return Err(DashError::LimitExceeded("attribute count exceeds max_attributes"))
    }
    let aname = match xp_read_name(st) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let mut ai = 0
    while ai < raw_attrs.length() {
      let (prev_name, _, _, _) = raw_attrs[ai]
      if prev_name == aname {
        return Err(DashError::InvalidXml("duplicate attribute: " + aname))
      }
      ai = ai + 1
    }
    xp_skip_ws(st)
    if st.pos >= st.len || st.src.code_unit_at(st.pos) != 61 {
      return Err(DashError::InvalidXml("expected '=' after attribute " + aname))
    }
    st.pos = st.pos + 1
    xp_skip_ws(st)
    if st.pos >= st.len {
      return Err(DashError::InvalidXml("unexpected EOF reading attribute value"))
    }
    let quote = st.src.code_unit_at(st.pos)
    if quote != 34 && quote != 39 {
      return Err(DashError::InvalidXml("attribute value must be quoted"))
    }
    st.pos = st.pos + 1
    let val_start = st.pos
    while st.pos < st.len && st.src.code_unit_at(st.pos) != quote {
      if st.src.code_unit_at(st.pos) == 60 {
        return Err(DashError::InvalidXml("'<' not allowed in attribute value"))
      }
      st.pos = st.pos + 1
    }
    if st.pos >= st.len {
      return Err(DashError::InvalidXml("unterminated attribute value"))
    }
    let val_end = st.pos
    st.pos = st.pos + 1
    let decoded = match xml_decode_entities(st.src, val_start, val_end, st.limits.max_text_bytes, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (aprefix, alocal) = xml_split_qname(aname)
    raw_attrs.push((aname, aprefix, alocal, decoded))
  }

  let ns_mark = st.ns_prefixes.length()
  // First pass: bind xmlns declarations
  let mut i = 0
  while i < raw_attrs.length() {
    let (aname, aprefix, alocal, aval) = raw_attrs[i]
    if aname == "xmlns" {
      st.ns_prefixes.push("")
      st.ns_uris.push(aval)
    } else if aprefix == "xmlns" {
      st.ns_prefixes.push(alocal)
      st.ns_uris.push(aval)
    }
    i = i + 1
  }

  let elem_ns = xp_ns_lookup(st, elem_prefix)

  // Second pass: build XmlAttr with resolved namespace URI (unprefixed attributes have ns == "")
  let attrs : Array[XmlAttr] = []
  i = 0
  while i < raw_attrs.length() {
    let (aname, aprefix, alocal, aval) = raw_attrs[i]
    let ans = if aname == "xmlns" || aprefix == "xmlns" {
      "http://www.w3.org/2000/xmlns/"
    } else if aprefix.length() > 0 {
      xp_ns_lookup(st, aprefix)
    } else {
      ""
    }
    // Check duplicate expanded attribute name (same non-empty namespace + local_name)
    if ans.length() > 0 && aname != "xmlns" && aprefix != "xmlns" {
      let mut j = 0
      while j < attrs.length() {
        if attrs[j].ns == ans && attrs[j].local_name == alocal {
          return Err(DashError::InvalidXml("duplicate expanded attribute: " + aname))
        }
        j = j + 1
      }
    }
    attrs.push(XmlAttr::{
      name: aname,
      prefix: aprefix,
      local_name: alocal,
      ns: ans,
      value: aval,
    })
    i = i + 1
  }

  Ok(XmlStartTag::{
    name: name,
    prefix: elem_prefix,
    local_name: elem_local,
    ns: elem_ns,
    attrs: attrs,
    self_closing: self_closing,
    ns_mark: ns_mark,
  })
}

///| Iterative explicit-stack XML element parser (zero recursion; safe at any `max_xml_depth`).
fn xp_parse_root_element(st : XmlParserState) -> Result[XmlElement, DashError] {
  let stack : Array[XmlFrame] = []

  // Push root start tag
  if 1 > st.limits.max_xml_depth {
    return Err(DashError::LimitExceeded("XML nesting depth exceeds max_xml_depth"))
  }
  st.elem_count = st.elem_count + 1
  if st.elem_count > st.limits.max_elements {
    return Err(DashError::LimitExceeded("XML element count exceeds max_elements"))
  }
  let rtag = match xp_parse_start_tag(st) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if rtag.self_closing {
    xp_ns_pop_to(st, rtag.ns_mark)
    return Ok(XmlElement::{
      name: rtag.name,
      prefix: rtag.prefix,
      local_name: rtag.local_name,
      ns: rtag.ns,
      attrs: rtag.attrs,
      text: "",
      children: [],
    })
  }
  stack.push(XmlFrame::{
    name: rtag.name,
    prefix: rtag.prefix,
    local_name: rtag.local_name,
    ns: rtag.ns,
    attrs: rtag.attrs,
    ns_mark: rtag.ns_mark,
    children: [],
    text_sb: StringBuilder::new(),
    text_bytes: 0,
  })

  while stack.length() > 0 {
    if st.pos >= st.len {
      let top = stack[stack.length() - 1]
      return Err(DashError::InvalidXml("unclosed tag <" + top.name + ">"))
    }
    if st.src.code_unit_at(st.pos) == 60 {
      if xml_starts_with_at(st.src, st.pos, "</") {
        st.pos = st.pos + 2
        let close_name = match xp_read_name(st) {
          Ok(cn) => cn
          Err(e) => return Err(e)
        }
        xp_skip_ws(st)
        if st.pos >= st.len || st.src.code_unit_at(st.pos) != 62 {
          return Err(DashError::InvalidXml("expected '>' in closing tag </" + close_name + ">"))
        }
        st.pos = st.pos + 1
        let frame = match stack.pop() {
          Some(f) => f
          None => return Err(DashError::InvalidXml("unexpected closing tag </" + close_name + ">"))
        }
        if close_name != frame.name {
          return Err(DashError::InvalidXml("mismatched closing tag: expected </" + frame.name + ">, got </" + close_name + ">"))
        }
        xp_ns_pop_to(st, frame.ns_mark)
        let el = XmlElement::{
          name: frame.name,
          prefix: frame.prefix,
          local_name: frame.local_name,
          ns: frame.ns,
          attrs: frame.attrs,
          text: frame.text_sb.to_string(),
          children: frame.children,
        }
        if stack.length() == 0 {
          return Ok(el)
        }
        stack[stack.length() - 1].children.push(el)
      } else if xml_starts_with_at(st.src, st.pos, "<!--") {
        match xp_skip_comment(st) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      } else if xml_starts_with_at(st.src, st.pos, "<![CDATA[") {
        let cd = match xp_read_cdata(st) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        let top = stack[stack.length() - 1]
        top.text_bytes = top.text_bytes + cd.length()
        if top.text_bytes > st.limits.max_text_bytes {
          return Err(DashError::LimitExceeded("element text exceeds max_text_bytes"))
        }
        top.text_sb.write_string(cd)
      } else if xml_starts_with_ci_at(st.src, st.pos, "<!DOCTYPE") ||
      xml_starts_with_ci_at(st.src, st.pos, "<!ENTITY") {
        return Err(DashError::SecurityRejected("DOCTYPE/ENTITY declarations are forbidden (XXE/Billion-Laughs protection)"))
      } else if xml_starts_with_at(st.src, st.pos, "<?") {
        match xp_skip_pi(st, false) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      } else if xml_starts_with_at(st.src, st.pos, "<!") {
        return Err(DashError::InvalidXml("unexpected XML declaration inside element"))
      } else {
        let next_depth = stack.length() + 1
        if next_depth > st.limits.max_xml_depth {
          return Err(DashError::LimitExceeded("XML nesting depth exceeds max_xml_depth"))
        }
        st.elem_count = st.elem_count + 1
        if st.elem_count > st.limits.max_elements {
          return Err(DashError::LimitExceeded("XML element count exceeds max_elements"))
        }
        let ctag = match xp_parse_start_tag(st) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if ctag.self_closing {
          xp_ns_pop_to(st, ctag.ns_mark)
          stack[stack.length() - 1].children.push(XmlElement::{
            name: ctag.name,
            prefix: ctag.prefix,
            local_name: ctag.local_name,
            ns: ctag.ns,
            attrs: ctag.attrs,
            text: "",
            children: [],
          })
        } else {
          stack.push(XmlFrame::{
            name: ctag.name,
            prefix: ctag.prefix,
            local_name: ctag.local_name,
            ns: ctag.ns,
            attrs: ctag.attrs,
            ns_mark: ctag.ns_mark,
            children: [],
            text_sb: StringBuilder::new(),
            text_bytes: 0,
          })
        }
      }
    } else {
      let t_start = st.pos
      while st.pos < st.len && st.src.code_unit_at(st.pos) != 60 {
        st.pos = st.pos + 1
      }
      let decoded = match xml_decode_entities(st.src, t_start, st.pos, st.limits.max_text_bytes, false) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let top = stack[stack.length() - 1]
      top.text_bytes = top.text_bytes + decoded.length()
      if top.text_bytes > st.limits.max_text_bytes {
        return Err(DashError::LimitExceeded("element text exceeds max_text_bytes"))
      }
      top.text_sb.write_string(decoded)
    }
  }

  Err(DashError::InvalidXml("empty XML document"))
}

fn parse_xml_document(input : String, limits : DashLimits) -> Result[XmlElement, DashError] {
  match xml_validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if input.length() > limits.max_input_bytes {
    return Err(DashError::LimitExceeded("input exceeds max_input_bytes"))
  }

  let has_cr = match xml_validate_utf8_and_chars(input) {
    Ok(cr) => cr
    Err(e) => return Err(e)
  }
  let src = if has_cr { xml_normalize_eol(input) } else { input }

  let mut start = 0
  // Strip UTF-8 BOM (0xEF 0xBB 0xBF)
  if src.length() >= 3 &&
  src.code_unit_at(0) == 239 &&
  src.code_unit_at(1) == 187 &&
  src.code_unit_at(2) == 191 {
    start = 3
  }

  let st = XmlParserState::{
    src: src,
    len: src.length(),
    bom_end: start,
    pos: start,
    elem_count: 0,
    limits: limits,
    ns_prefixes: [],
    ns_uris: [],
  }

  // Parse prolog (whitespace, XML decl / PIs, comments; reject DOCTYPE / ENTITY)
  let mut root : Option[XmlElement] = None
  let mut first = true
  while st.pos < st.len {
    xp_skip_ws(st)
    if st.pos >= st.len {
      break
    }
    if st.src.code_unit_at(st.pos) != 60 {
      return Err(DashError::InvalidXml("unexpected character data outside root element"))
    }
    if xml_starts_with_at(st.src, st.pos, "<!--") {
      match xp_skip_comment(st) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if xml_starts_with_at(st.src, st.pos, "<?") {
      match xp_skip_pi(st, first) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if xml_starts_with_ci_at(st.src, st.pos, "<!DOCTYPE") ||
    xml_starts_with_ci_at(st.src, st.pos, "<!ENTITY") {
      return Err(DashError::SecurityRejected("DOCTYPE/ENTITY declarations are forbidden (XXE/Billion-Laughs protection)"))
    } else if xml_starts_with_at(st.src, st.pos, "<!") || xml_starts_with_at(st.src, st.pos, "</") {
      return Err(DashError::InvalidXml("invalid markup in XML prolog/epilog"))
    } else {
      match root {
        Some(_) => return Err(DashError::InvalidXml("multiple root elements"))
        None => {
          let el = match xp_parse_root_element(st) {
            Ok(e) => e
            Err(err) => return Err(err)
          }
          root = Some(el)
        }
      }
    }
    first = false
  }

  match root {
    Some(r) => Ok(r)
    None => Err(DashError::InvalidXml("empty XML document"))
  }
}

fn xml_is_dash_elem(el : XmlElement, local : String, dash_ns : String) -> Bool {
  el.local_name == local && (el.ns == dash_ns && (el.prefix.length() == 0 || dash_ns.length() > 0))
}

fn xml_is_cenc_elem(el : XmlElement, local : String) -> Bool {
  el.local_name == local &&
  (el.ns == "urn:mpeg:cenc:2013" || el.prefix == "cenc" || (el.ns.length() == 0 && el.prefix.length() == 0))
}

fn xml_is_mspr_elem(el : XmlElement, local : String) -> Bool {
  el.local_name == local && (el.ns == "urn:microsoft:playready" || el.prefix == "mspr")
}

fn xml_get_attr(el : XmlElement, local : String, dash_ns : String) -> Option[String] {
  let mut i = 0
  while i < el.attrs.length() {
    let a = el.attrs[i]
    if a.local_name == local && (a.prefix.length() == 0 || (dash_ns.length() > 0 && a.ns == dash_ns)) {
      return Some(a.value)
    }
    i = i + 1
  }
  None
}

fn xml_get_cenc_attr(el : XmlElement, local : String) -> Option[String] {
  let mut i = 0
  while i < el.attrs.length() {
    let a = el.attrs[i]
    if a.local_name == local && (a.ns == "urn:mpeg:cenc:2013" || a.prefix.length() == 0 || a.prefix == "cenc") {
      return Some(a.value)
    }
    i = i + 1
  }
  None
}
