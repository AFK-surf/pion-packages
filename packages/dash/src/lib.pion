///| Pure Pion ISO/IEC 23009-1 MPEG-DASH (`.mpd`) parser, SegmentTemplate/SegmentTimeline
///| URL expander, ABR representation selector, and deterministic XML serializer.
///|
///| Zero external dependencies, zero `extern "C"`, zero `World`, zero mutable globals.

///| Parse an MPEG-DASH `.mpd` XML document using default `DashLimits`.
pub fn parse(input : String) -> Result[Mpd, DashError] {
  parse_with_limits(input, DashLimits::default())
}
