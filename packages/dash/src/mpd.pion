///| ISO/IEC 23009-1 MPEG-DASH `.mpd` schema parser from XML DOM into typed `Mpd`.

fn parse_bool_attr(raw : String) -> Result[Bool, DashError] {
  let s = trim_ascii(raw)
  if s == "true" || s == "1" {
    Ok(true)
  } else if s == "false" || s == "0" {
    Ok(false)
  } else {
    Err(DashError::InvalidMpd("invalid boolean attribute: " + raw))
  }
}

fn parse_opt_duration(el : XmlElement, attr : String) -> Result[Option[Int64], DashError] {
  match xml_get_attr(el, attr) {
    None => Ok(None)
    Some(v) => {
      match parse_iso8601_duration_us(v) {
        Ok(us) => Ok(Some(us))
        Err(e) => Err(e)
      }
    }
  }
}

fn parse_opt_nonneg_i64(el : XmlElement, attr : String) -> Result[Option[Int64], DashError] {
  match xml_get_attr(el, attr) {
    None => Ok(None)
    Some(v) => {
      match parse_nonneg_i64_strict(v) {
        Ok(n) => Ok(Some(n))
        Err(e) => Err(e)
      }
    }
  }
}

fn parse_opt_pos_i64(el : XmlElement, attr : String) -> Result[Option[Int64], DashError] {
  match xml_get_attr(el, attr) {
    None => Ok(None)
    Some(v) => {
      match parse_pos_i64_strict(v) {
        Ok(n) => Ok(Some(n))
        Err(e) => Err(e)
      }
    }
  }
}

fn parse_opt_bool(el : XmlElement, attr : String) -> Result[Option[Bool], DashError] {
  match xml_get_attr(el, attr) {
    None => Ok(None)
    Some(v) => {
      match parse_bool_attr(v) {
        Ok(b) => Ok(Some(b))
        Err(e) => Err(e)
      }
    }
  }
}

fn parse_opt_rational(el : XmlElement, attr : String) -> Result[Option[Rational], DashError] {
  match xml_get_attr(el, attr) {
    None => Ok(None)
    Some(v) => {
      match parse_rational(v) {
        Ok(r) => Ok(Some(r))
        Err(e) => Err(e)
      }
    }
  }
}

fn parse_descriptor(el : XmlElement) -> Result[Descriptor, DashError] {
  let scheme = match xml_get_attr(el, "schemeIdUri") {
    Some(s) => s
    None => return Err(DashError::InvalidMpd("<" + el.local_name + "> missing required attribute schemeIdUri"))
  }
  Ok(Descriptor::{
    scheme_id_uri: scheme,
    value: xml_get_attr(el, "value"),
    id: xml_get_attr(el, "id"),
  })
}

fn parse_content_protection(el : XmlElement) -> Result[ContentProtection, DashError] {
  let scheme = match xml_get_attr(el, "schemeIdUri") {
    Some(s) => s
    None => return Err(DashError::InvalidMpd("<ContentProtection> missing required attribute schemeIdUri"))
  }
  let pssh : Array[String] = []
  let mut i = 0
  while i < el.children.length() {
    let ch = el.children[i]
    if ch.local_name == "pssh" {
      pssh.push(trim_ascii(ch.text))
    }
    i = i + 1
  }
  Ok(ContentProtection::{
    scheme_id_uri: scheme,
    value: xml_get_attr(el, "value"),
    default_kid: xml_get_attr(el, "default_KID"),
    pssh: pssh,
  })
}

fn parse_segment_base(el : XmlElement) -> Result[SegmentBase, DashError] {
  let timescale = match parse_opt_pos_i64(el, "timescale") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let pto = match parse_opt_nonneg_i64(el, "presentationTimeOffset") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let index_range_exact = match parse_opt_bool(el, "indexRangeExact") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let mut init_src : Option[String] = None
  let mut init_range : Option[String] = None
  let mut i = 0
  while i < el.children.length() {
    let ch = el.children[i]
    if ch.local_name == "Initialization" {
      init_src = xml_get_attr(ch, "sourceURL")
      init_range = xml_get_attr(ch, "range")
    }
    i = i + 1
  }
  Ok(SegmentBase::{
    timescale: timescale,
    presentation_time_offset: pto,
    index_range: xml_get_attr(el, "indexRange"),
    index_range_exact: index_range_exact,
    initialization_source_url: init_src,
    initialization_range: init_range,
  })
}

fn parse_segment_list(el : XmlElement, limits : DashLimits) -> Result[SegmentList, DashError] {
  let timescale = match parse_opt_pos_i64(el, "timescale") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let duration = match parse_opt_pos_i64(el, "duration") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let start_number = match parse_opt_nonneg_i64(el, "startNumber") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let pto = match parse_opt_nonneg_i64(el, "presentationTimeOffset") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let mut init_src : Option[String] = None
  let mut init_range : Option[String] = None
  let seg_urls : Array[SegmentUrl] = []
  let mut i = 0
  while i < el.children.length() {
    let ch = el.children[i]
    if ch.local_name == "Initialization" {
      init_src = xml_get_attr(ch, "sourceURL")
      init_range = xml_get_attr(ch, "range")
    } else if ch.local_name == "SegmentURL" {
      if seg_urls.length() >= limits.max_segments {
        return Err(DashError::LimitExceeded("SegmentURL count exceeds max_segments"))
      }
      seg_urls.push(SegmentUrl::{
        media: xml_get_attr(ch, "media"),
        media_range: xml_get_attr(ch, "mediaRange"),
        index: xml_get_attr(ch, "index"),
        index_range: xml_get_attr(ch, "indexRange"),
      })
    }
    i = i + 1
  }
  Ok(SegmentList::{
    timescale: timescale,
    duration: duration,
    start_number: start_number,
    presentation_time_offset: pto,
    initialization_source_url: init_src,
    initialization_range: init_range,
    segment_urls: seg_urls,
  })
}

fn parse_segment_template(el : XmlElement, limits : DashLimits) -> Result[SegmentTemplate, DashError] {
  let timescale = match parse_opt_pos_i64(el, "timescale") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let duration = match parse_opt_pos_i64(el, "duration") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let start_number = match parse_opt_nonneg_i64(el, "startNumber") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let pto = match parse_opt_nonneg_i64(el, "presentationTimeOffset") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let timeline : Array[SegmentTimelineEntry] = []
  let mut i = 0
  while i < el.children.length() {
    let ch = el.children[i]
    if ch.local_name == "SegmentTimeline" {
      let mut j = 0
      while j < ch.children.length() {
        let s_el = ch.children[j]
        if s_el.local_name == "S" {
          if timeline.length() >= limits.max_timeline_entries {
            return Err(DashError::LimitExceeded("SegmentTimeline entries exceed max_timeline_entries"))
          }
          let t = match parse_opt_nonneg_i64(s_el, "t") {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          let d = match xml_get_attr(s_el, "d") {
            Some(dv) => {
              match parse_pos_i64_strict(dv) {
                Ok(n) => n
                Err(e) => return Err(e)
              }
            }
            None => return Err(DashError::InvalidMpd("<S> missing required attribute d"))
          }
          let r = match xml_get_attr(s_el, "r") {
            None => 0L
            Some(rv) => {
              match parse_i64_strict(rv) {
                Ok(n) => n
                Err(e) => return Err(e)
              }
            }
          }
          timeline.push(SegmentTimelineEntry::{ t: t, d: d, r: r })
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  Ok(SegmentTemplate::{
    timescale: timescale,
    duration: duration,
    start_number: start_number,
    presentation_time_offset: pto,
    initialization: xml_get_attr(el, "initialization"),
    media: xml_get_attr(el, "media"),
    timeline: timeline,
  })
}

fn parse_representation(el : XmlElement, limits : DashLimits) -> Result[Representation, DashError] {
  let id = match xml_get_attr(el, "id") {
    Some(v) => {
      if v.length() == 0 {
        return Err(DashError::InvalidMpd("<Representation> attribute id must not be empty"))
      }
      v
    }
    None => return Err(DashError::InvalidMpd("<Representation> missing required attribute id"))
  }
  let bandwidth = match xml_get_attr(el, "bandwidth") {
    Some(v) => {
      match parse_pos_i64_strict(v) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
    }
    None => return Err(DashError::InvalidMpd("<Representation> missing required attribute bandwidth"))
  }
  let width = match parse_opt_pos_i64(el, "width") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let height = match parse_opt_pos_i64(el, "height") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let frame_rate = match parse_opt_rational(el, "frameRate") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let start_with_sap = match parse_opt_nonneg_i64(el, "startWithSAP") {
    Ok(v) => v
    Err(e) => return Err(e)
  }

  let base_urls : Array[String] = []
  let content_protections : Array[ContentProtection] = []
  let audio_ch : Array[Descriptor] = []
  let mut seg_base : Option[SegmentBase] = None
  let mut seg_list : Option[SegmentList] = None
  let mut seg_tpl : Option[SegmentTemplate] = None

  let mut i = 0
  while i < el.children.length() {
    let ch = el.children[i]
    if ch.local_name == "BaseURL" {
      base_urls.push(trim_ascii(ch.text))
    } else if ch.local_name == "ContentProtection" {
      match parse_content_protection(ch) {
        Ok(cp) => content_protections.push(cp)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "AudioChannelConfiguration" {
      match parse_descriptor(ch) {
        Ok(d) => audio_ch.push(d)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "SegmentBase" {
      match parse_segment_base(ch) {
        Ok(sb) => seg_base = Some(sb)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "SegmentList" {
      match parse_segment_list(ch, limits) {
        Ok(sl) => seg_list = Some(sl)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "SegmentTemplate" {
      match parse_segment_template(ch, limits) {
        Ok(st) => seg_tpl = Some(st)
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }

  Ok(Representation::{
    id: id,
    bandwidth: bandwidth,
    width: width,
    height: height,
    frame_rate: frame_rate,
    sar: xml_get_attr(el, "sar"),
    codecs: xml_get_attr(el, "codecs"),
    mime_type: xml_get_attr(el, "mimeType"),
    audio_sampling_rate: xml_get_attr(el, "audioSamplingRate"),
    start_with_sap: start_with_sap,
    base_urls: base_urls,
    content_protections: content_protections,
    audio_channel_configurations: audio_ch,
    segment_base: seg_base,
    segment_list: seg_list,
    segment_template: seg_tpl,
  })
}

fn parse_content_type(raw : String) -> ContentType {
  if raw == "video" {
    ContentType::Video
  } else if raw == "audio" {
    ContentType::Audio
  } else if raw == "text" {
    ContentType::Text
  } else if raw == "image" {
    ContentType::Image
  } else {
    ContentType::Other(raw)
  }
}

fn parse_adaptation_set(
  el : XmlElement,
  limits : DashLimits,
  rep_total : Array[Int],
) -> Result[AdaptationSet, DashError] {
  let group = match parse_opt_nonneg_i64(el, "group") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let content_type = match xml_get_attr(el, "contentType") {
    Some(s) => Some(parse_content_type(s))
    None => None
  }
  let seg_align = match parse_opt_bool(el, "segmentAlignment") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let subseg_align = match parse_opt_bool(el, "subsegmentAlignment") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let bs_switch = match parse_opt_bool(el, "bitstreamSwitching") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let min_bw = match parse_opt_nonneg_i64(el, "minBandwidth") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let max_bw = match parse_opt_nonneg_i64(el, "maxBandwidth") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let min_w = match parse_opt_nonneg_i64(el, "minWidth") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let max_w = match parse_opt_nonneg_i64(el, "maxWidth") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let min_h = match parse_opt_nonneg_i64(el, "minHeight") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let max_h = match parse_opt_nonneg_i64(el, "maxHeight") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let frame_rate = match parse_opt_rational(el, "frameRate") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let start_with_sap = match parse_opt_nonneg_i64(el, "startWithSAP") {
    Ok(v) => v
    Err(e) => return Err(e)
  }

  let base_urls : Array[String] = []
  let roles : Array[Descriptor] = []
  let cps : Array[ContentProtection] = []
  let accs : Array[Descriptor] = []
  let audio_ch : Array[Descriptor] = []
  let supp : Array[Descriptor] = []
  let ess : Array[Descriptor] = []
  let mut seg_base : Option[SegmentBase] = None
  let mut seg_list : Option[SegmentList] = None
  let mut seg_tpl : Option[SegmentTemplate] = None
  let reps : Array[Representation] = []

  let mut i = 0
  while i < el.children.length() {
    let ch = el.children[i]
    if ch.local_name == "BaseURL" {
      base_urls.push(trim_ascii(ch.text))
    } else if ch.local_name == "Role" {
      match parse_descriptor(ch) {
        Ok(d) => roles.push(d)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "ContentProtection" {
      match parse_content_protection(ch) {
        Ok(cp) => cps.push(cp)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "Accessibility" {
      match parse_descriptor(ch) {
        Ok(d) => accs.push(d)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "AudioChannelConfiguration" {
      match parse_descriptor(ch) {
        Ok(d) => audio_ch.push(d)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "SupplementalProperty" {
      match parse_descriptor(ch) {
        Ok(d) => supp.push(d)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "EssentialProperty" {
      match parse_descriptor(ch) {
        Ok(d) => ess.push(d)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "SegmentBase" {
      match parse_segment_base(ch) {
        Ok(sb) => seg_base = Some(sb)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "SegmentList" {
      match parse_segment_list(ch, limits) {
        Ok(sl) => seg_list = Some(sl)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "SegmentTemplate" {
      match parse_segment_template(ch, limits) {
        Ok(st) => seg_tpl = Some(st)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "Representation" {
      if rep_total[0] >= limits.max_representations {
        return Err(DashError::LimitExceeded("Representation count exceeds max_representations"))
      }
      rep_total[0] = rep_total[0] + 1
      match parse_representation(ch, limits) {
        Ok(r) => reps.push(r)
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }

  Ok(AdaptationSet::{
    id: xml_get_attr(el, "id"),
    group: group,
    content_type: content_type,
    mime_type: xml_get_attr(el, "mimeType"),
    codecs: xml_get_attr(el, "codecs"),
    lang: xml_get_attr(el, "lang"),
    segment_alignment: seg_align,
    subsegment_alignment: subseg_align,
    bitstream_switching: bs_switch,
    min_bandwidth: min_bw,
    max_bandwidth: max_bw,
    min_width: min_w,
    max_width: max_w,
    min_height: min_h,
    max_height: max_h,
    par: xml_get_attr(el, "par"),
    frame_rate: frame_rate,
    sar: xml_get_attr(el, "sar"),
    audio_sampling_rate: xml_get_attr(el, "audioSamplingRate"),
    start_with_sap: start_with_sap,
    base_urls: base_urls,
    roles: roles,
    content_protections: cps,
    accessibilities: accs,
    audio_channel_configurations: audio_ch,
    supplemental_properties: supp,
    essential_properties: ess,
    segment_base: seg_base,
    segment_list: seg_list,
    segment_template: seg_tpl,
    representations: reps,
  })
}

fn parse_period(
  el : XmlElement,
  limits : DashLimits,
  as_total : Array[Int],
  rep_total : Array[Int],
) -> Result[Period, DashError] {
  let start_us = match parse_opt_duration(el, "start") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let duration_us = match parse_opt_duration(el, "duration") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let bs_switch = match parse_opt_bool(el, "bitstreamSwitching") {
    Ok(v) => v
    Err(e) => return Err(e)
  }

  let base_urls : Array[String] = []
  let mut seg_base : Option[SegmentBase] = None
  let mut seg_list : Option[SegmentList] = None
  let mut seg_tpl : Option[SegmentTemplate] = None
  let asets : Array[AdaptationSet] = []

  let mut i = 0
  while i < el.children.length() {
    let ch = el.children[i]
    if ch.local_name == "BaseURL" {
      base_urls.push(trim_ascii(ch.text))
    } else if ch.local_name == "SegmentBase" {
      match parse_segment_base(ch) {
        Ok(sb) => seg_base = Some(sb)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "SegmentList" {
      match parse_segment_list(ch, limits) {
        Ok(sl) => seg_list = Some(sl)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "SegmentTemplate" {
      match parse_segment_template(ch, limits) {
        Ok(st) => seg_tpl = Some(st)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "AdaptationSet" {
      if as_total[0] >= limits.max_adaptation_sets {
        return Err(DashError::LimitExceeded("AdaptationSet count exceeds max_adaptation_sets"))
      }
      as_total[0] = as_total[0] + 1
      match parse_adaptation_set(ch, limits, rep_total) {
        Ok(a) => asets.push(a)
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }

  Ok(Period::{
    id: xml_get_attr(el, "id"),
    start_us: start_us,
    duration_us: duration_us,
    bitstream_switching: bs_switch,
    base_urls: base_urls,
    segment_base: seg_base,
    segment_list: seg_list,
    segment_template: seg_tpl,
    adaptation_sets: asets,
  })
}

///| Parse an MPEG-DASH `.mpd` XML document with explicit `DashLimits`.
pub fn parse_with_limits(input : String, limits : DashLimits) -> Result[Mpd, DashError] {
  let root = match parse_xml_document(input, limits) {
    Ok(el) => el
    Err(e) => return Err(e)
  }
  if root.local_name != "MPD" {
    return Err(DashError::InvalidMpd("root element must be <MPD>, got <" + root.name + ">"))
  }

  let mpd_type = match xml_get_attr(root, "type") {
    None => MpdType::Static
    Some(t) => {
      if t == "static" {
        MpdType::Static
      } else if t == "dynamic" {
        MpdType::Dynamic
      } else {
        return Err(DashError::InvalidMpd("invalid MPD@type: " + t))
      }
    }
  }
  let profiles = match xml_get_attr(root, "profiles") {
    Some(p) => p
    None => ""
  }

  let mpd_dur = match parse_opt_duration(root, "mediaPresentationDuration") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let min_buf = match parse_opt_duration(root, "minBufferTime") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let min_upd = match parse_opt_duration(root, "minimumUpdatePeriod") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let tsbd = match parse_opt_duration(root, "timeShiftBufferDepth") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let spd = match parse_opt_duration(root, "suggestedPresentationDelay") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let max_seg_dur = match parse_opt_duration(root, "maxSegmentDuration") {
    Ok(v) => v
    Err(e) => return Err(e)
  }

  let avail_str = xml_get_attr(root, "availabilityStartTime")
  let avail_us = match avail_str {
    None => None
    Some(s) => {
      match parse_iso8601_datetime_us(s) {
        Ok(u) => Some(u)
        Err(e) => return Err(e)
      }
    }
  }
  let pub_str = xml_get_attr(root, "publishTime")
  let pub_us = match pub_str {
    None => None
    Some(s) => {
      match parse_iso8601_datetime_us(s) {
        Ok(u) => Some(u)
        Err(e) => return Err(e)
      }
    }
  }

  let base_urls : Array[String] = []
  let locations : Array[String] = []
  let utc_timings : Array[Descriptor] = []
  let periods : Array[Period] = []
  let as_total = [0]
  let rep_total = [0]

  let mut i = 0
  while i < root.children.length() {
    let ch = root.children[i]
    if ch.local_name == "BaseURL" {
      base_urls.push(trim_ascii(ch.text))
    } else if ch.local_name == "Location" {
      locations.push(trim_ascii(ch.text))
    } else if ch.local_name == "UTCTiming" {
      match parse_descriptor(ch) {
        Ok(d) => utc_timings.push(d)
        Err(e) => return Err(e)
      }
    } else if ch.local_name == "Period" {
      if periods.length() >= limits.max_periods {
        return Err(DashError::LimitExceeded("Period count exceeds max_periods"))
      }
      match parse_period(ch, limits, as_total, rep_total) {
        Ok(p) => periods.push(p)
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }

  Ok(Mpd::{
    id: xml_get_attr(root, "id"),
    mpd_type: mpd_type,
    profiles: profiles,
    media_presentation_duration_us: mpd_dur,
    min_buffer_time_us: min_buf,
    minimum_update_period_us: min_upd,
    availability_start_time: avail_str,
    availability_start_time_us: avail_us,
    publish_time: pub_str,
    publish_time_us: pub_us,
    time_shift_buffer_depth_us: tsbd,
    suggested_presentation_delay_us: spd,
    max_segment_duration_us: max_seg_dur,
    base_urls: base_urls,
    locations: locations,
    utc_timings: utc_timings,
    periods: periods,
  })
}
