///| Exact integer ISO-8601 Duration, ISO-8601 DateTime, and Rational parsers/formatters.
///| Zero floating-point formatting (`Double::to_string` never used), checked `Int64` arithmetic.

fn i64_max() -> Int64 {
  9223372036854775807L
}

fn checked_add_i64(a : Int64, b : Int64) -> Option[Int64] {
  if b > 0L && a > i64_max() - b {
    return None
  }
  if b < 0L && a < -9223372036854775807L - 1L - b {
    return None
  }
  Some(a + b)
}

fn checked_mul_i64(a : Int64, b : Int64) -> Option[Int64] {
  if a == 0L || b == 0L {
    return Some(0L)
  }
  if a > 0L && b > 0L {
    if a > i64_max() / b {
      return None
    }
    return Some(a * b)
  }
  None
}

fn is_ascii_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_ascii_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

fn trim_ascii(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n && is_ascii_ws(s.code_unit_at(start)) {
    start = start + 1
  }
  let mut end = n
  while end > start && is_ascii_ws(s.code_unit_at(end - 1)) {
    end = end - 1
  }
  if start == 0 && end == n {
    s
  } else {
    s.slice(start, end)
  }
}

///| Parse a non-negative `Int64` from ASCII digits `[start, end)`.
fn parse_u63_slice(s : String, start : Int, end : Int) -> Option[Int64] {
  if start >= end {
    return None
  }
  let max_div10 = 922337203685477580L
  let mut acc = 0L
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if !is_ascii_digit(c) {
      return None
    }
    let d = (c - 48).to_int64()
    if acc > max_div10 || (acc == max_div10 && d > 7L) {
      return None
    }
    acc = acc * 10L + d
    i = i + 1
  }
  Some(acc)
}

///| Parse a signed `Int64` from ASCII digits (optional leading `-`).
fn parse_i64_strict(raw : String) -> Result[Int64, DashError] {
  let s = trim_ascii(raw)
  let n = s.length()
  if n == 0 {
    return Err(DashError::InvalidNumber("empty integer"))
  }
  let mut neg = false
  let mut i = 0
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if s.code_unit_at(0) == 43 {
    i = 1
  }
  if i >= n {
    return Err(DashError::InvalidNumber("missing digits in integer: " + raw))
  }
  let max_div10 = 922337203685477580L
  let mut acc = 0L
  while i < n {
    let c = s.code_unit_at(i)
    if !is_ascii_digit(c) {
      return Err(DashError::InvalidNumber("invalid integer: " + raw))
    }
    let d = (c - 48).to_int64()
    if neg {
      // Allow down to INT64_MIN (-9223372036854775808)
      if acc > max_div10 || (acc == max_div10 && d > 8L) {
        return Err(DashError::InvalidNumber("integer underflow: " + raw))
      }
      if acc == max_div10 && d == 8L {
        if i + 1 < n {
          return Err(DashError::InvalidNumber("integer underflow: " + raw))
        }
        return Ok(-9223372036854775807L - 1L)
      }
      acc = acc * 10L + d
    } else {
      if acc > max_div10 || (acc == max_div10 && d > 7L) {
        return Err(DashError::InvalidNumber("integer overflow: " + raw))
      }
      acc = acc * 10L + d
    }
    i = i + 1
  }
  if neg {
    Ok(0L - acc)
  } else {
    Ok(acc)
  }
}

fn parse_nonneg_i64_strict(raw : String) -> Result[Int64, DashError] {
  let s = trim_ascii(raw)
  let n = s.length()
  let start = if n > 0 && s.code_unit_at(0) == 43 { 1 } else { 0 }
  match parse_u63_slice(s, start, n) {
    Some(v) => Ok(v)
    None => Err(DashError::InvalidNumber("expected non-negative integer: " + raw))
  }
}

fn parse_pos_i64_strict(raw : String) -> Result[Int64, DashError] {
  match parse_nonneg_i64_strict(raw) {
    Ok(v) => {
      if v <= 0L {
        Err(DashError::InvalidNumber("expected positive integer: " + raw))
      } else {
        Ok(v)
      }
    }
    Err(e) => Err(e)
  }
}

fn parse_pos_u63_no_sign(raw : String) -> Result[Int64, DashError] {
  let s = trim_ascii(raw)
  match parse_u63_slice(s, 0, s.length()) {
    Some(v) => {
      if v <= 0L {
        Err(DashError::InvalidNumber("expected positive integer: " + raw))
      } else {
        Ok(v)
      }
    }
    None => Err(DashError::InvalidNumber("expected positive unsigned integer: " + raw))
  }
}

///| Parse an ISO-8601 duration (`P[nY][nM][nW][nD][T[nH][nM][n[.frac]S]]`) into exact microseconds.
///| Rejects negative durations, empty `P`/`PT`, out-of-order units, and `Int64` overflow.
pub fn parse_iso8601_duration_us(raw : String) -> Result[Int64, DashError] {
  let s = trim_ascii(raw)
  let n = s.length()
  if n < 2 || s.code_unit_at(0) != 80 {
    return Err(DashError::InvalidDuration("duration must start with 'P': " + raw))
  }
  let mut i = 1
  let mut in_time = false
  let mut any_component = false
  // Ordering ranks: Date: Y=1, M=2, W=3, D=4; Time: H=5, M=6, S=7
  let mut last_rank = 0
  let mut total_us = 0L

  while i < n {
    let c = s.code_unit_at(i)
    if c == 84 {
      if in_time {
        return Err(DashError::InvalidDuration("duplicate 'T' in duration: " + raw))
      }
      in_time = true
      i = i + 1
      if i >= n {
        return Err(DashError::InvalidDuration("empty time section in duration: " + raw))
      }
      continue
    }

    // Parse integer part
    let num_start = i
    while i < n && is_ascii_digit(s.code_unit_at(i)) {
      i = i + 1
    }
    if i == num_start {
      return Err(DashError::InvalidDuration("expected digits in duration: " + raw))
    }
    let num_val = match parse_u63_slice(s, num_start, i) {
      Some(v) => v
      None => return Err(DashError::InvalidDuration("duration component overflow: " + raw))
    }

    // Optional fractional part (only '.' per xs:duration, only valid on seconds)
    let mut has_frac = false
    let mut frac_us = 0L
    if i < n && s.code_unit_at(i) == 46 {
      has_frac = true
      i = i + 1
      let frac_start = i
      let mut weight = 100000L
      while i < n && is_ascii_digit(s.code_unit_at(i)) {
        let d = (s.code_unit_at(i) - 48).to_int64()
        if weight > 0L {
          frac_us = frac_us + d * weight
          weight = weight / 10L
        }
        i = i + 1
      }
      if i == frac_start {
        return Err(DashError::InvalidDuration("missing fractional digits in duration: " + raw))
      }
    }

    if i >= n {
      return Err(DashError::InvalidDuration("missing unit designator in duration: " + raw))
    }
    let unit = s.code_unit_at(i)
    i = i + 1

    let mut rank = 0
    let mut mult_us = 0L
    if !in_time {
      if has_frac {
        return Err(DashError::InvalidDuration("fractional date unit not supported: " + raw))
      }
      if unit == 89 {
        // Y (365 days)
        rank = 1
        mult_us = 31536000000000L
      } else if unit == 77 {
        // M (30 days)
        rank = 2
        mult_us = 2592000000000L
      } else if unit == 87 {
        // W (7 days)
        rank = 3
        mult_us = 604800000000L
      } else if unit == 68 {
        // D
        rank = 4
        mult_us = 86400000000L
      } else {
        return Err(DashError::InvalidDuration("invalid date unit in duration: " + raw))
      }
    } else {
      if unit == 72 {
        if has_frac {
          return Err(DashError::InvalidDuration("fractional hours not supported: " + raw))
        }
        rank = 5
        mult_us = 3600000000L
      } else if unit == 77 {
        if has_frac {
          return Err(DashError::InvalidDuration("fractional minutes not supported: " + raw))
        }
        rank = 6
        mult_us = 60000000L
      } else if unit == 83 {
        rank = 7
        mult_us = 1000000L
      } else {
        return Err(DashError::InvalidDuration("invalid time unit in duration: " + raw))
      }
    }

    if rank <= last_rank {
      return Err(DashError::InvalidDuration("out-of-order or duplicate unit in duration: " + raw))
    }
    last_rank = rank
    any_component = true

    let part_us = match checked_mul_i64(num_val, mult_us) {
      Some(v) => v
      None => return Err(DashError::InvalidDuration("duration overflow: " + raw))
    }
    total_us = match checked_add_i64(total_us, part_us) {
      Some(v) => v
      None => return Err(DashError::InvalidDuration("duration overflow: " + raw))
    }
    if has_frac {
      total_us = match checked_add_i64(total_us, frac_us) {
        Some(v) => v
        None => return Err(DashError::InvalidDuration("duration overflow: " + raw))
      }
    }
  }

  if !any_component {
    return Err(DashError::InvalidDuration("empty duration: " + raw))
  }
  Ok(total_us)
}

///| Format exact non-negative microseconds into canonical ISO-8601 duration (`PT...`).
pub fn format_iso8601_duration_us(us : Int64) -> String {
  if us <= 0L {
    return "PT0S"
  }
  let total_secs = us / 1000000L
  let rem_us = us % 1000000L
  let hours = total_secs / 3600L
  let mins = (total_secs % 3600L) / 60L
  let secs = total_secs % 60L

  let sb = StringBuilder::new()
  sb.write_string("PT")
  if hours > 0L {
    sb.write_string(hours.to_string())
    sb.write_string("H")
  }
  if mins > 0L {
    sb.write_string(mins.to_string())
    sb.write_string("M")
  }
  if secs > 0L || rem_us > 0L || (hours == 0L && mins == 0L) {
    sb.write_string(secs.to_string())
    if rem_us > 0L {
      sb.write_string(".")
      // 6-digit zero-padded fractional microseconds with trailing zeros trimmed
      let buf = Bytes::new(6)
      let mut tmp = rem_us
      let mut k = 5
      while k >= 0 {
        buf[k] = (48L + (tmp % 10L)).to_int().to_byte()
        tmp = tmp / 10L
        k = k - 1
      }
      let mut end = 6
      while end > 1 && buf[end - 1].to_int() == 48 {
        end = end - 1
      }
      sb.write_string(buf.to_string().slice(0, end))
    }
    sb.write_string("S")
  }
  sb.to_string()
}

fn is_leap_year(year : Int) -> Bool {
  (year % 4 == 0) && ((year % 100 != 0) || (year % 400 == 0))
}

fn days_in_month(year : Int, month : Int) -> Int {
  if month == 2 {
    if is_leap_year(year) { 29 } else { 28 }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

///| Howard Hinnant civil-to-days since 1970-01-01.
fn days_from_civil_i64(year : Int, month : Int, day : Int) -> Int64 {
  let y = if month <= 2 { year.to_int64() - 1L } else { year.to_int64() }
  let era = if y >= 0L { y / 400L } else { (y - 399L) / 400L }
  let yoe = y - era * 400L
  let m = month.to_int64()
  let d = day.to_int64()
  let mp = if m > 2L { m - 3L } else { m + 9L }
  let doy = (153L * mp + 2L) / 5L + d - 1L
  let doe = yoe * 365L + yoe / 4L - yoe / 100L + doy
  era * 146097L + doe - 719468L
}

fn parse_fixed_digits(s : String, start : Int, count : Int) -> Option[Int] {
  if start + count > s.length() {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < count {
    let c = s.code_unit_at(start + i)
    if !is_ascii_digit(c) {
      return None
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  Some(acc)
}

///| Strictly parse an ISO-8601 / xs:dateTime (`YYYY-MM-DDTHH:MM:SS[.frac][Z|±HH:MM]`) into Unix epoch microseconds.
pub fn parse_iso8601_datetime_us(raw : String) -> Result[Int64, DashError] {
  let s = trim_ascii(raw)
  let n = s.length()
  if n < 19 {
    return Err(DashError::InvalidDateTime("datetime too short: " + raw))
  }
  let year = match parse_fixed_digits(s, 0, 4) {
    Some(v) => v
    None => return Err(DashError::InvalidDateTime("invalid year: " + raw))
  }
  if s.code_unit_at(4) != 45 {
    return Err(DashError::InvalidDateTime("expected '-' after year: " + raw))
  }
  let month = match parse_fixed_digits(s, 5, 2) {
    Some(v) => v
    None => return Err(DashError::InvalidDateTime("invalid month: " + raw))
  }
  if month < 1 || month > 12 {
    return Err(DashError::InvalidDateTime("month out of range: " + raw))
  }
  if s.code_unit_at(7) != 45 {
    return Err(DashError::InvalidDateTime("expected '-' after month: " + raw))
  }
  let day = match parse_fixed_digits(s, 8, 2) {
    Some(v) => v
    None => return Err(DashError::InvalidDateTime("invalid day: " + raw))
  }
  if day < 1 || day > days_in_month(year, month) {
    return Err(DashError::InvalidDateTime("day out of range for calendar month/year: " + raw))
  }
  if s.code_unit_at(10) != 84 {
    return Err(DashError::InvalidDateTime("expected 'T' separator: " + raw))
  }
  let hour = match parse_fixed_digits(s, 11, 2) {
    Some(v) => v
    None => return Err(DashError::InvalidDateTime("invalid hour: " + raw))
  }
  if s.code_unit_at(13) != 58 {
    return Err(DashError::InvalidDateTime("expected ':' after hour: " + raw))
  }
  let minute = match parse_fixed_digits(s, 14, 2) {
    Some(v) => v
    None => return Err(DashError::InvalidDateTime("invalid minute: " + raw))
  }
  if minute < 0 || minute > 59 {
    return Err(DashError::InvalidDateTime("minute out of range: " + raw))
  }
  if s.code_unit_at(16) != 58 {
    return Err(DashError::InvalidDateTime("expected ':' after minute: " + raw))
  }
  let sec = match parse_fixed_digits(s, 17, 2) {
    Some(v) => v
    None => return Err(DashError::InvalidDateTime("invalid second: " + raw))
  }
  if sec < 0 || sec > 59 {
    return Err(DashError::InvalidDateTime("second out of range: " + raw))
  }

  let mut i = 19
  let mut frac_us = 0L
  let mut frac_nonzero = false
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    let frac_start = i
    let mut weight = 100000L
    while i < n && is_ascii_digit(s.code_unit_at(i)) {
      let d = (s.code_unit_at(i) - 48).to_int64()
      if d != 0L {
        frac_nonzero = true
      }
      if weight > 0L {
        frac_us = frac_us + d * weight
        weight = weight / 10L
      }
      i = i + 1
    }
    if i == frac_start {
      return Err(DashError::InvalidDateTime("empty fractional seconds: " + raw))
    }
  }

  if hour < 0 || hour > 24 || (hour == 24 && (minute != 0 || sec != 0 || frac_nonzero)) {
    return Err(DashError::InvalidDateTime("hour out of range: " + raw))
  }

  // Timezone: optional (DASH-IF IOP interprets absent zone as UTC), 'Z', or ±HH:MM (up to ±14:00)
  let mut tz_offset_secs = 0L
  if i < n {
    let tz_ch = s.code_unit_at(i)
    if tz_ch == 90 {
      i = i + 1
    } else if tz_ch == 43 || tz_ch == 45 {
      let sign = if tz_ch == 43 { 1L } else { -1L }
      i = i + 1
      let tzh = match parse_fixed_digits(s, i, 2) {
        Some(v) => v
        None => return Err(DashError::InvalidDateTime("invalid tz hour: " + raw))
      }
      i = i + 2
      if i >= n || s.code_unit_at(i) != 58 {
        return Err(DashError::InvalidDateTime("expected ':' in tz offset: " + raw))
      }
      i = i + 1
      let tzm = match parse_fixed_digits(s, i, 2) {
        Some(v) => v
        None => return Err(DashError::InvalidDateTime("invalid tz minute: " + raw))
      }
      i = i + 2
      if tzh < 0 || tzm < 0 || tzm > 59 || tzh > 14 || (tzh == 14 && tzm != 0) {
        return Err(DashError::InvalidDateTime("tz offset out of range: " + raw))
      }
      tz_offset_secs = sign * (tzh.to_int64() * 3600L + tzm.to_int64() * 60L)
    } else {
      return Err(DashError::InvalidDateTime("invalid timezone: " + raw))
    }
  }
  if i != n {
    return Err(DashError::InvalidDateTime("trailing characters in datetime: " + raw))
  }

  let days = days_from_civil_i64(year, month, day)
  let secs = days * 86400L + hour.to_int64() * 3600L + minute.to_int64() * 60L + sec.to_int64() - tz_offset_secs
  Ok(secs * 1000000L + frac_us)
}

///| Parse a positive rational (`"30"` or `"30000/1001"`).
pub fn parse_rational(raw : String) -> Result[Rational, DashError] {
  let s = trim_ascii(raw)
  let n = s.length()
  if n == 0 {
    return Err(DashError::InvalidNumber("empty rational"))
  }
  let mut slash = -1
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 47 {
      if slash >= 0 {
        return Err(DashError::InvalidNumber("multiple '/' in rational: " + raw))
      }
      slash = i
    }
    i = i + 1
  }
  if slash < 0 {
    let num = match parse_pos_u63_no_sign(s) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    Ok(Rational::new(num, 1L))
  } else {
    let num = match parse_pos_u63_no_sign(s.slice(0, slash)) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let den = match parse_pos_u63_no_sign(s.slice(slash + 1, n)) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    Ok(Rational::new(num, den))
  }
}

///| Format a rational number deterministically (`"30"` when `den == 1`, else `"num/den"`).
pub fn format_rational(r : Rational) -> String {
  if r.den == 1L {
    r.num.to_string()
  } else {
    r.num.to_string() + "/" + r.den.to_string()
  }
}
