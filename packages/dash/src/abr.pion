///| Adaptive Bitrate (ABR) Representation selection for MPEG-DASH playback.

fn codec_matches_prefix(codec : String, pref : String) -> Bool {
  if pref.length() == 0 {
    return true
  }
  if codec.length() < pref.length() {
    return false
  }
  let mut i = 0
  while i < pref.length() {
    let mut a = codec.code_unit_at(i)
    let mut b = pref.code_unit_at(i)
    if a >= 65 && a <= 90 {
      a = a + 32
    }
    if b >= 65 && b <= 90 {
      b = b + 32
    }
    if a != b {
      return false
    }
    i = i + 1
  }
  if codec.length() == pref.length() {
    return true
  }
  let next = codec.code_unit_at(pref.length())
  next == 46 || next == 44 || next == 32
}

fn rep_matches_codecs(aset : AdaptationSet, rep : Representation, preferred_codecs : Array[String]) -> Bool {
  if preferred_codecs.length() == 0 {
    return true
  }
  let codec_str = match rep.codecs {
    Some(c) => c
    None => {
      match aset.codecs {
        Some(c) => c
        None => return false
      }
    }
  }
  // RFC 6381: @codecs is a comma-separated list; match any listed codec.
  let n = codec_str.length()
  let mut pos = 0
  while pos <= n {
    let mut end = pos
    while end < n && codec_str.code_unit_at(end) != 44 {
      end = end + 1
    }
    let mut s = pos
    while s < end && codec_str.code_unit_at(s) == 32 {
      s = s + 1
    }
    let mut e = end
    while e > s && codec_str.code_unit_at(e - 1) == 32 {
      e = e - 1
    }
    let item = codec_str.slice(s, e)
    let mut i = 0
    while i < preferred_codecs.length() {
      if codec_matches_prefix(item, preferred_codecs[i]) {
        return true
      }
      i = i + 1
    }
    pos = end + 1
  }
  false
}

fn pick_best_from_indices(reps : Array[Representation], indices : Array[Int], max_bandwidth : Int64) -> Option[Int] {
  if indices.length() == 0 {
    return None
  }
  // 1. Pick highest bandwidth <= max_bandwidth
  let mut best_fit = -1
  let mut best_fit_bw = -1L
  // 2. Track lowest bandwidth overall as fallback when all exceed max_bandwidth
  let mut lowest = indices[0]
  let mut lowest_bw = reps[indices[0]].bandwidth

  let mut i = 0
  while i < indices.length() {
    let idx = indices[i]
    let bw = reps[idx].bandwidth
    if bw <= max_bandwidth && bw > best_fit_bw {
      best_fit = idx
      best_fit_bw = bw
    }
    if bw < lowest_bw {
      lowest = idx
      lowest_bw = bw
    }
    i = i + 1
  }

  if best_fit >= 0 {
    Some(best_fit)
  } else {
    Some(lowest)
  }
}

///| Select the optimal Representation index in an AdaptationSet given `max_bandwidth`
///| and `preferred_codecs` (e.g. `["av01", "vp9", "avc1"]`).
///| If any representation matches `preferred_codecs`, selection runs over that subset;
///| otherwise falls back to all representations in the AdaptationSet.
///| Picks the highest bandwidth `<= max_bandwidth`, or the lowest bandwidth if all exceed budget.
pub fn select_representation(
  adaptation_set : AdaptationSet,
  max_bandwidth : Int64,
  preferred_codecs : Array[String],
) -> Option[Int] {
  let n = adaptation_set.representations.length()
  if n == 0 {
    return None
  }
  if preferred_codecs.length() > 0 {
    let matched : Array[Int] = []
    let mut i = 0
    while i < n {
      if rep_matches_codecs(adaptation_set, adaptation_set.representations[i], preferred_codecs) {
        matched.push(i)
      }
      i = i + 1
    }
    if matched.length() > 0 {
      return pick_best_from_indices(adaptation_set.representations, matched, max_bandwidth)
    }
  }
  let all : Array[Int] = []
  let mut i = 0
  while i < n {
    all.push(i)
    i = i + 1
  }
  pick_best_from_indices(adaptation_set.representations, all, max_bandwidth)
}
