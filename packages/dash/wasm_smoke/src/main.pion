///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/dash`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "dash"

fn fnv1a_64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

pub fn main(world : World) -> Int {
  // 1. ISO-8601 duration & datetime
  let dur_us = match dash::parse_iso8601_duration_us("PT1H2M3.5S") {
    Ok(v) => v
    Err(_) => return 1
  }
  let dur_fmt = dash::format_iso8601_duration_us(dur_us)
  let dt_us = match dash::parse_iso8601_datetime_us("2024-02-29T12:30:45Z") {
    Ok(v) => v
    Err(_) => return 2
  }

  // 2. Parse full MPD with DRM, SegmentTemplate + SegmentTimeline (r=-1) & ABR
  let xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
  "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:cenc=\"urn:mpeg:cenc:2013\" " +
  "type=\"static\" profiles=\"urn:mpeg:dash:profile:isoff-live:2011\" " +
  "mediaPresentationDuration=\"PT16S\" minBufferTime=\"PT2S\">\n" +
  "  <BaseURL>https://cdn.example.com/stream/</BaseURL>\n" +
  "  <Period id=\"p0\" start=\"PT0S\" duration=\"PT16S\">\n" +
  "    <AdaptationSet id=\"1\" contentType=\"video\" mimeType=\"video/mp4\" segmentAlignment=\"true\">\n" +
  "      <ContentProtection schemeIdUri=\"urn:uuid:edef8ba9-79d6-4ace-a3c8-27dcd51d21ed\" value=\"Widevine\" cenc:default_KID=\"01020304-0506-0708-090a-0b0c0d0e0f10\">\n" +
  "        <cenc:pssh>AAAAW3Bzc2gAAAAA7e+LqXnWSs6jyCfc1R0h7QAAADsIARIQ</cenc:pssh>\n" +
  "      </ContentProtection>\n" +
  "      <SegmentTemplate timescale=\"1000\" startNumber=\"1\" initialization=\"$RepresentationID$/init.mp4\" media=\"$RepresentationID$/chunk_$Number%04d$_$Time$.m4s\">\n" +
  "        <SegmentTimeline>\n" +
  "          <S t=\"0\" d=\"4000\" r=\"-1\"/>\n" +
  "        </SegmentTimeline>\n" +
  "      </SegmentTemplate>\n" +
  "      <Representation id=\"avc720\" bandwidth=\"2500000\" width=\"1280\" height=\"720\" frameRate=\"30000/1001\" codecs=\"avc1.64001f\"/>\n" +
  "      <Representation id=\"av1_1080\" bandwidth=\"3200000\" width=\"1920\" height=\"1080\" frameRate=\"60\" codecs=\"av01.0.08M.08\"/>\n" +
  "    </AdaptationSet>\n" +
  "  </Period>\n" +
  "</MPD>"

  let mpd = match dash::parse(xml) {
    Ok(m) => m
    Err(_) => return 3
  }
  let sel = match dash::select_representation(mpd.periods[0].adaptation_sets[0], 4000000L, ["av01"]) {
    Some(idx) => idx
    None => return 4
  }
  let track = match dash::resolve_segments(mpd, 0, 0, sel, dash::DashLimits::default()) {
    Ok(t) => t
    Err(_) => return 5
  }
  let init_url = match track.initialization_url {
    Some(u) => u
    None => return 6
  }
  if track.segments.length() != 4 {
    return 7
  }
  let formatted = match dash::format_mpd(mpd) {
    Ok(s) => s
    Err(_) => return 8
  }
  // 3. Red-team XXE rejection check
  let xxe_ok = match dash::parse("<!DOCTYPE a [<!ENTITY x \"y\">]><MPD/>") {
    Err(dash::DashError::SecurityRejected(_)) => "xxe_blocked"
    _ => return 9
  }

  let summary = dur_fmt +
  "|" +
  dt_us.to_string() +
  "|" +
  sel.to_string() +
  "|" +
  init_url +
  "|" +
  track.segments[3].url +
  "|" +
  formatted.length().to_string() +
  "|" +
  xxe_ok
  io_println(world, "dash_wasm_smoke:ok")
  io_println(world, "summary=" + summary + " fnv64=" + hex_u64(fnv1a_64_str(summary)))
  0
}
