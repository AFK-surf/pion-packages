///| Pion Native head-to-head benchmark & differential oracle runner for `packages/dash`.
///| Usage: pion_dash_bench <corpus_file> <iters>
///| When <iters> == 0, emits canonical field-by-field summary of every MPD for 1-to-1 diff vs Rust `dash-mpd`.

import "dash"

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn split_manifests(data : String) -> Array[String] {
  let sep = "\n===MPD===\n"
  let slen = sep.length()
  let out : Array[String] = []
  let n = data.length()
  let mut start = 0
  let mut i = 0
  while i + slen <= n {
    let mut matched = true
    let mut k = 0
    while k < slen {
      if data.code_unit_at(i + k) != sep.code_unit_at(k) {
        matched = false
        break
      }
      k = k + 1
    }
    if matched {
      out.push(data.slice(start, i))
      start = i + slen
      i = start
    } else {
      i = i + 1
    }
  }
  if start < n {
    out.push(data.slice(start, n))
  }
  out
}

fn fnv1a_64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

fn opt_s(v : Option[String]) -> String {
  match v {
    Some(s) => s
    None => "-"
  }
}

fn opt_i64(v : Option[Int64]) -> String {
  match v {
    Some(x) => x.to_string()
    None => "-"
  }
}

fn eval_corpus_once(docs : Array[String]) -> String {
  let sb = StringBuilder::new()
  let mut di = 0
  while di < docs.length() {
    match dash::parse(docs[di]) {
      Err(e) => {
        sb.write_string("ERR|")
        sb.write_string(dash::dash_error_to_string(e))
        sb.write_string("\n")
      }
      Ok(m) => {
        sb.write_string("MPD|id=")
        sb.write_string(opt_s(m.id))
        sb.write_string("|type=")
        sb.write_string(dash::mpd_type_to_string(m.mpd_type))
        sb.write_string("|dur=")
        sb.write_string(opt_i64(m.media_presentation_duration_us))
        sb.write_string("|mbt=")
        sb.write_string(opt_i64(m.min_buffer_time_us))
        sb.write_string("|mup=")
        sb.write_string(opt_i64(m.minimum_update_period_us))
        sb.write_string("|tsbd=")
        sb.write_string(opt_i64(m.time_shift_buffer_depth_us))
        sb.write_string("|spd=")
        sb.write_string(opt_i64(m.suggested_presentation_delay_us))
        sb.write_string("|bu=")
        sb.write_string(m.base_urls.length().to_string())
        sb.write_string("|loc=")
        sb.write_string(m.locations.length().to_string())
        sb.write_string("|utc=")
        sb.write_string(m.utc_timings.length().to_string())
        sb.write_string("|periods=")
        sb.write_string(m.periods.length().to_string())
        sb.write_string("\n")

        let mut pi = 0
        while pi < m.periods.length() {
          let p = m.periods[pi]
          sb.write_string("  P|id=")
          sb.write_string(opt_s(p.id))
          sb.write_string("|start=")
          sb.write_string(opt_i64(p.start_us))
          sb.write_string("|dur=")
          sb.write_string(opt_i64(p.duration_us))
          sb.write_string("|as=")
          sb.write_string(p.adaptation_sets.length().to_string())
          sb.write_string("\n")

          let mut ai = 0
          while ai < p.adaptation_sets.length() {
            let a = p.adaptation_sets[ai]
            sb.write_string("    AS|id=")
            sb.write_string(opt_s(a.id))
            sb.write_string("|ct=")
            match a.content_type {
              Some(ct) => sb.write_string(dash::content_type_to_string(ct))
              None => sb.write_string("-")
            }
            sb.write_string("|mime=")
            sb.write_string(opt_s(a.mime_type))
            sb.write_string("|lang=")
            sb.write_string(opt_s(a.lang))
            sb.write_string("|roles=")
            sb.write_string(a.roles.length().to_string())
            sb.write_string("|cp=")
            sb.write_string(a.content_protections.length().to_string())
            let mut pssh_cnt = 0
            let mut ci = 0
            while ci < a.content_protections.length() {
              pssh_cnt = pssh_cnt + a.content_protections[ci].pssh.length()
              ci = ci + 1
            }
            sb.write_string("|pssh=")
            sb.write_string(pssh_cnt.to_string())
            sb.write_string("|reps=")
            sb.write_string(a.representations.length().to_string())
            match a.segment_template {
              Some(st) => {
                sb.write_string("|st_ts=")
                sb.write_string(opt_i64(st.timescale))
                sb.write_string("|st_tl=")
                sb.write_string(st.timeline.length().to_string())
              }
              None => ()
            }
            sb.write_string("\n")

            let mut ri = 0
            while ri < a.representations.length() {
              let r = a.representations[ri]
              sb.write_string("      R|id=")
              sb.write_string(r.id)
              sb.write_string("|bw=")
              sb.write_string(r.bandwidth.to_string())
              sb.write_string("|w=")
              sb.write_string(opt_i64(r.width))
              sb.write_string("|h=")
              sb.write_string(opt_i64(r.height))
              sb.write_string("|fr=")
              match r.frame_rate {
                Some(fr) => sb.write_string(dash::format_rational(fr))
                None => sb.write_string("-")
              }
              sb.write_string("|codecs=")
              sb.write_string(opt_s(r.codecs))
              match r.segment_base {
                Some(sbase) => {
                  sb.write_string("|sb_ir=")
                  sb.write_string(opt_s(sbase.index_range))
                  sb.write_string("|sb_init=")
                  sb.write_string(opt_s(sbase.initialization_range))
                }
                None => ()
              }
              match r.segment_list {
                Some(sl) => {
                  sb.write_string("|sl_urls=")
                  sb.write_string(sl.segment_urls.length().to_string())
                }
                None => ()
              }
              sb.write_string("\n")
              ri = ri + 1
            }
            ai = ai + 1
          }
          pi = pi + 1
        }
      }
    }
    di = di + 1
  }
  sb.to_string()
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_dash_bench <corpus_file> <iters>")
    return 1
  }
  let path = args[1]
  let iters = parse_int(args[2])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }
  let docs = split_manifests(data)
  if iters == 0 {
    io_println(world, eval_corpus_once(docs))
    return 0
  }
  let mut last = ""
  let mut i = 0
  while i < iters {
    last = eval_corpus_once(docs)
    i = i + 1
  }
  io_println(
    world,
    "cases=" +
    docs.length().to_string() +
    " iters=" +
    iters.to_string() +
    " bytes=" +
    last.length().to_string() +
    " fnv64=" +
    hex_u64(fnv1a_64_str(last)),
  )
  0
}
