///| Red-team CLI for `packages/unicode_segment` (native + wasm32, see ../REPORT.md). Public API only.
///|   dump <file>                -> per corpus line `<name>\t<hex>`: `=<name>`, then G / W / U / S / C / I lines
///|   bomb <kind> <units> <api>  -> build an adversarial input in-process, run one API, print `<bytes> <us> <count>`
///|   cursor <kind> <units>      -> walk every grapheme with next_ and prev_grapheme_boundary, print `<bytes> <us> <steps>`
///|   api                        -> SegmentLimits / cursor boundary sweep (negative, 0, exact, exact - 1, Int extremes)

import "unicode_segment"

///|
pub fn split_lines(data : String) -> Array[String] {
  let out : Array[String] = []
  let n = data.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if data.code_unit_at(i) == 10 {
      out.push(data.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(data.slice(start, n))
  }
  out
}

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Raw bytes of a hex string ("-" is the empty string); the result may be ill-formed UTF-8 on purpose.
pub fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < s.length() {
    sb.write_byte(((hexval(s.code_unit_at(i)) << 4) | hexval(s.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut neg = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 45 {
      neg = true
    } else if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    -v
  } else {
    v
  }
}

///| Boundary list `0 b1 b2 ... n` of contiguous spans ("" for no spans).
fn bounds_line(tag : String, spans : Array[unicode_segment::SegmentSpan]) -> String {
  let sb = StringBuilder::new()
  sb.write_string(tag)
  if spans.length() > 0 {
    sb.write_string(" " + spans[0].start.to_string())
  }
  let mut i = 0
  while i < spans.length() {
    sb.write_string(" " + spans[i].end.to_string())
    i = i + 1
  }
  sb.write_string("\n")
  sb.to_string()
}

///| Span list `s-e s-e ...` (unicode_word_bounds is not contiguous).
fn spans_line(tag : String, spans : Array[unicode_segment::SegmentSpan]) -> String {
  let sb = StringBuilder::new()
  sb.write_string(tag)
  let mut i = 0
  while i < spans.length() {
    sb.write_string(" " + spans[i].start.to_string() + "-" + spans[i].end.to_string())
    i = i + 1
  }
  sb.write_string("\n")
  sb.to_string()
}

///|
fn same_spans(a : Array[unicode_segment::SegmentSpan], b : Array[unicode_segment::SegmentSpan]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !a[i].eq(b[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///| Spans must be non-empty, strictly increasing and tile `[0, n]` exactly (empty input: no span).
fn tiles(s : String, spans : Array[unicode_segment::SegmentSpan]) -> Bool {
  let n = s.length()
  if n == 0 {
    return spans.length() == 0
  }
  if spans.length() == 0 || spans[0].start != 0 || spans[spans.length() - 1].end != n {
    return false
  }
  let mut i = 0
  while i < spans.length() {
    if spans[i].end <= spans[i].start || spans[i].is_empty() || spans[i].len() != spans[i].end - spans[i].start {
      return false
    }
    if i + 1 < spans.length() && spans[i].end != spans[i + 1].start {
      return false
    }
    i = i + 1
  }
  true
}

///| Strings must be the byte slices of the spans, and (when `whole`) concatenate back to `s`.
fn strings_match(s : String, spans : Array[unicode_segment::SegmentSpan], strs : Array[String], whole : Bool) -> Bool {
  if spans.length() != strs.length() {
    return false
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < spans.length() {
    let want = s.slice(spans[i].start, spans[i].end)
    if strs[i] != want || unicode_segment::slice_span(s, spans[i]) != want {
      return false
    }
    sb.write_string(strs[i])
    i = i + 1
  }
  !whole || sb.to_string() == s
}

///| Every unicode_word span must be one of the word_bounds spans.
fn subset(sub : Array[unicode_segment::SegmentSpan], all : Array[unicode_segment::SegmentSpan]) -> Bool {
  let mut j = 0
  let mut i = 0
  while i < sub.length() {
    while j < all.length() && all[j].start < sub[i].start {
      j = j + 1
    }
    if j >= all.length() || !all[j].eq(sub[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn is_err_spans(r : Result[Array[unicode_segment::SegmentSpan], unicode_segment::SegmentError]) -> Bool {
  match r {
    Ok(_) => false
    Err(e) => e.eq(unicode_segment::SegmentError::LimitExceeded) && e.to_string() == "LimitExceeded"
  }
}

///|
fn is_err_strs(r : Result[Array[String], unicode_segment::SegmentError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn ok_spans(r : Result[Array[unicode_segment::SegmentSpan], unicode_segment::SegmentError], want : Array[unicode_segment::SegmentSpan]) -> Bool {
  match r {
    Ok(v) => same_spans(v, want)
    Err(_) => false
  }
}

///|
fn ok_strs(r : Result[Array[String], unicode_segment::SegmentError], want : Int) -> Bool {
  match r {
    Ok(v) => v.length() == want
    Err(_) => false
  }
}

///| One API (by index) with limits: Ok(segment count) or -1 for Err.
fn run_limited(api : Int, s : String, lim : unicode_segment::SegmentLimits) -> Int {
  if api == 0 {
    match unicode_segment::grapheme_indices_with_limits(s, lim) {
      Ok(v) => v.length()
      Err(_) => -1
    }
  } else if api == 1 {
    match unicode_segment::graphemes_with_limits(s, lim) {
      Ok(v) => v.length()
      Err(_) => -1
    }
  } else if api == 2 {
    match unicode_segment::grapheme_count_with_limits(s, lim) {
      Ok(v) => v
      Err(_) => -1
    }
  } else if api == 3 {
    match unicode_segment::word_bounds_with_limits(s, lim) {
      Ok(v) => v.length()
      Err(_) => -1
    }
  } else if api == 4 {
    match unicode_segment::words_with_limits(s, lim) {
      Ok(v) => v.length()
      Err(_) => -1
    }
  } else if api == 5 {
    match unicode_segment::unicode_word_bounds_with_limits(s, lim) {
      Ok(v) => v.length()
      Err(_) => -1
    }
  } else if api == 6 {
    match unicode_segment::unicode_words_with_limits(s, lim) {
      Ok(v) => v.length()
      Err(_) => -1
    }
  } else if api == 7 {
    match unicode_segment::sentence_bounds_with_limits(s, lim) {
      Ok(v) => v.length()
      Err(_) => -1
    }
  } else {
    match unicode_segment::sentences_with_limits(s, lim) {
      Ok(v) => v.length()
      Err(_) => -1
    }
  }
}

///|
fn api_name(api : Int) -> String {
  let names = [
    "grapheme_indices", "graphemes", "grapheme_count", "word_bounds", "words", "unicode_word_bounds",
    "unicode_words", "sentence_bounds", "sentences",
  ]
  names[api]
}

///| SegmentLimits contract on one input for all 9 `*_with_limits` APIs:
///| exact (n, k) accepted with k segments; (n, k - 1), (n - 1, k), negatives rejected; extremes accepted.
fn check_limits(s : String, counts : Array[Int]) -> String {
  let n = s.length()
  let big = 2147483647
  let mut bad = ""
  let mut api = 0
  while api < 9 {
    let k = counts[api]
    let nm = api_name(api)
    if run_limited(api, s, unicode_segment::SegmentLimits::new(n, k)) != k {
      bad = bad + " lim_exact:" + nm
    }
    if run_limited(api, s, unicode_segment::SegmentLimits::new(big, big)) != k {
      bad = bad + " lim_max:" + nm
    }
    if run_limited(api, s, unicode_segment::SegmentLimits::default()) != k {
      bad = bad + " lim_default:" + nm
    }
    if k > 0 && run_limited(api, s, unicode_segment::SegmentLimits::new(n, k - 1)) != -1 {
      bad = bad + " lim_seg_minus1:" + nm
    }
    if n > 0 && run_limited(api, s, unicode_segment::SegmentLimits::new(n - 1, big)) != -1 {
      bad = bad + " lim_bytes_minus1:" + nm
    }
    if run_limited(api, s, unicode_segment::SegmentLimits::new(-1, big)) != -1 {
      bad = bad + " lim_neg_bytes:" + nm
    }
    if run_limited(api, s, unicode_segment::SegmentLimits::new(big, -1)) != -1 {
      bad = bad + " lim_neg_segs:" + nm
    }
    if run_limited(api, s, unicode_segment::SegmentLimits::new(-2147483647 - 1, -2147483647 - 1)) != -1 {
      bad = bad + " lim_int_min:" + nm
    }
    api = api + 1
  }
  bad
}

///|
fn opt_eq(got : Option[Int], want : Int) -> Bool {
  match got {
    None => want == -1
    Some(v) => v == want
  }
}

///| Cursor API against the boundary set of grapheme_indices at every byte offset -3..=n+3
///| (including the inner bytes of multi-byte sequences) and at the Int extremes.
fn check_cursor(s : String, g : Array[unicode_segment::SegmentSpan]) -> String {
  let n = s.length()
  let isb : Array[Bool] = []
  let mut p = 0
  while p <= n {
    isb.push(false)
    p = p + 1
  }
  if n > 0 {
    isb[0] = true
  }
  let mut i = 0
  while i < g.length() {
    isb[g[i].end] = true
    i = i + 1
  }
  let mut bad = ""
  p = -3
  while p <= n + 3 {
    let want_is = p >= 0 && p <= n && (isb[p] || p == 0)
    if unicode_segment::is_grapheme_boundary(s, p) != want_is {
      bad = bad + " is@" + p.to_string()
    }
    // next: smallest boundary > p for 0 <= p < n
    let mut want_next = -1
    if p >= 0 && p < n {
      let mut q = p + 1
      while q <= n && !isb[q] {
        q = q + 1
      }
      want_next = q
    }
    if !opt_eq(unicode_segment::next_grapheme_boundary(s, p), want_next) {
      bad = bad + " next@" + p.to_string()
    }
    // prev: largest boundary < p for 0 < p <= n
    let mut want_prev = -1
    if p > 0 && p <= n {
      let mut q = p - 1
      while q > 0 && !isb[q] {
        q = q - 1
      }
      want_prev = q
    }
    if !opt_eq(unicode_segment::prev_grapheme_boundary(s, p), want_prev) {
      bad = bad + " prev@" + p.to_string()
    }
    if bad.length() > 200 {
      return bad
    }
    p = p + 1
  }
  let extremes = [2147483647, -2147483647 - 1, n + 1000000]
  let mut e = 0
  while e < extremes.length() {
    let x = extremes[e]
    if unicode_segment::is_grapheme_boundary(s, x) ||
    !opt_eq(unicode_segment::next_grapheme_boundary(s, x), -1) ||
    !opt_eq(unicode_segment::prev_grapheme_boundary(s, x), -1) {
      bad = bad + " extreme@" + x.to_string()
    }
    e = e + 1
  }
  bad
}

///| Full dump of one input: every segmentation API plus in-process invariants (`I ok` or the failures).
pub fn dump_case(s : String) -> String {
  let g = unicode_segment::grapheme_indices(s)
  let w = unicode_segment::word_bounds(s)
  let u = unicode_segment::unicode_word_bounds(s)
  let se = unicode_segment::sentence_bounds(s)
  let gs = unicode_segment::graphemes(s)
  let ws = unicode_segment::words(s)
  let us = unicode_segment::unicode_words(s)
  let ss = unicode_segment::sentences(s)
  let gc = unicode_segment::grapheme_count(s)
  let mut bad = ""
  if !tiles(s, g) {
    bad = bad + " tile:G"
  }
  if !tiles(s, w) {
    bad = bad + " tile:W"
  }
  if !tiles(s, se) {
    bad = bad + " tile:S"
  }
  if !strings_match(s, g, gs, true) {
    bad = bad + " concat:graphemes"
  }
  if !strings_match(s, w, ws, true) {
    bad = bad + " concat:words"
  }
  if !strings_match(s, se, ss, true) {
    bad = bad + " concat:sentences"
  }
  if !strings_match(s, u, us, false) {
    bad = bad + " slices:unicode_words"
  }
  if !subset(u, w) {
    bad = bad + " subset:U_of_W"
  }
  if gc != g.length() {
    bad = bad + " grapheme_count"
  }
  let lim = unicode_segment::SegmentLimits::default()
  if !ok_spans(unicode_segment::grapheme_indices_with_limits(s, lim), g) ||
  !ok_spans(unicode_segment::word_bounds_with_limits(s, lim), w) ||
  !ok_spans(unicode_segment::unicode_word_bounds_with_limits(s, lim), u) ||
  !ok_spans(unicode_segment::sentence_bounds_with_limits(s, lim), se) ||
  !ok_strs(unicode_segment::graphemes_with_limits(s, lim), g.length()) ||
  !ok_strs(unicode_segment::words_with_limits(s, lim), w.length()) ||
  !ok_strs(unicode_segment::unicode_words_with_limits(s, lim), u.length()) ||
  !ok_strs(unicode_segment::sentences_with_limits(s, lim), se.length()) {
    bad = bad + " with_limits_differs"
  }
  let counts = [g.length(), g.length(), g.length(), w.length(), w.length(), u.length(), u.length(), se.length(), se.length()]
  bad = bad + check_limits(s, counts)
  bad = bad + check_cursor(s, g)
  let sb = StringBuilder::new()
  sb.write_string(bounds_line("G", g))
  sb.write_string(bounds_line("W", w))
  sb.write_string(spans_line("U", u))
  sb.write_string(bounds_line("S", se))
  sb.write_string("C " + gc.to_string() + "\n")
  sb.write_string("I" + (if bad == "" { " ok" } else { bad }) + "\n")
  sb.to_string()
}

///|
pub fn run_dump(text : String) -> String {
  let lines = split_lines(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    let mut t = 0
    while t < l.length() && l.code_unit_at(t) != 9 {
      t = t + 1
    }
    if t < l.length() {
      sb.write_string("=" + l.slice(0, t) + "\n")
      sb.write_string(dump_case(unhex(l.slice(t + 1, l.length()))))
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::with_capacity(s.length() * n + 1)
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///| Adversarial unit for each bomb kind (UAX #29 O(n^2) classics and long-context state machines).
pub fn bomb_unit(kind : String) -> String {
  if kind == "sb_aterm_close_sp" {
    // SB8 lookahead: ATerm Close* Sp* never followed by Lower
    ".)) \u{0020}"
  } else if kind == "sb_aterm_close_extend_sp" {
    ".\u{0301})\u{0301} \u{0301}"
  } else if kind == "sb_sterm_close_sp" {
    "!)) "
  } else if kind == "sb_aterm_numeric_tail" {
    // SB8 must scan past non-stoppers each time: ATerm Sp then digits (never Lower)
    ". 1"
  } else if kind == "sb8_long_scan" {
    // one ATerm Sp followed by a single very long non-stopper run ending in Upper
    "1"
  } else if kind == "wb_aletter_midletter" {
    "a\u{0301}:\u{0301}"
  } else if kind == "wb_numeric_midnum" {
    "1\u{0301},\u{0301}"
  } else if kind == "wb_midletter_extend_run" {
    "a:\u{0301}\u{0301}\u{0301}\u{0301}\u{0301}\u{0301}\u{0301}\u{0301}"
  } else if kind == "wb_hebrew_dq" {
    "\u{05D0}\"\u{0301}"
  } else if kind == "wb_ri" {
    "\u{1F1E6}"
  } else if kind == "gb_incb_linker" {
    "\u{0915}\u{0301}\u{094D}\u{0301}"
  } else if kind == "gb_ep_zwj" {
    "\u{1F468}\u{0301}\u{200D}"
  } else if kind == "gb_ri" {
    "\u{1F1E6}"
  } else if kind == "gb_extend" {
    "\u{0301}"
  } else if kind == "gb_hangul" {
    "\u{AC00}\u{AC01}"
  } else if kind == "ko_prose" {
    // Korean words separated by single spaces, no punctuation (a long chat message / tweet thread)
    "\u{C548}\u{B155}\u{D558}\u{C138}\u{C694} \u{C138}\u{ACC4} \u{BC18}\u{AC11}\u{C2B5}\u{B2C8}\u{B2E4} "
  } else if kind == "hi_prose" {
    // Hindi words separated by single spaces, no danda
    "\u{0928}\u{092E}\u{0938}\u{094D}\u{0924}\u{0947} \u{0926}\u{0941}\u{0928}\u{093F}\u{092F}\u{093E} \u{0906}\u{092A} \u{0915}\u{0948}\u{0938}\u{0947} \u{0939}\u{0948}\u{0902} "
  } else if kind == "en_prose" {
    "The quick brown fox jumps over the lazy dog. "
  } else if kind == "crlf" {
    "\r\n\r\r\n\n"
  } else if kind == "invalid_utf8" {
    "\xF0\x9F\x98\xE2\x82\xC3"
  } else if kind == "mixed" {
    "Dr. U.S.A. e.g. 3.14 \u{05D0}\"\u{05D1} \u{1F468}\u{200D}\u{1F469} \u{1F1FA}\u{1F1F8} \u{0915}\u{094D}\u{0937} \u{AC00}\u{11A8}!? "
  } else {
    "a"
  }
}

///|
pub fn bomb_input(kind : String, units : Int) -> String {
  if kind == "sb8_long_scan" {
    return "a. " + repeat("1", units) + "A"
  }
  repeat(bomb_unit(kind), units)
}

///|
pub fn run_api_once(api : String, s : String) -> Int {
  if api == "graphemes" {
    unicode_segment::grapheme_indices(s).length()
  } else if api == "grapheme_count" {
    unicode_segment::grapheme_count(s)
  } else if api == "words" {
    unicode_segment::word_bounds(s).length()
  } else if api == "unicode_words" {
    unicode_segment::unicode_word_bounds(s).length()
  } else if api == "sentences" {
    unicode_segment::sentence_bounds(s).length()
  } else if api == "is_boundary_mid" {
    // single cursor query in the middle of the input
    if unicode_segment::is_grapheme_boundary(s, s.length() / 2) {
      1
    } else {
      0
    }
  } else if api == "all" {
    unicode_segment::grapheme_indices(s).length() +
    unicode_segment::word_bounds(s).length() +
    unicode_segment::unicode_word_bounds(s).length() +
    unicode_segment::sentence_bounds(s).length()
  } else {
    -1
  }
}

///| Walk every grapheme forwards with next_grapheme_boundary and backwards with prev_grapheme_boundary.
pub fn cursor_walk(s : String) -> Int {
  let mut steps = 0
  let mut cur = 0
  while cur < s.length() {
    match unicode_segment::next_grapheme_boundary(s, cur) {
      Some(nx) => cur = nx
      None => break
    }
    steps = steps + 1
  }
  cur = s.length()
  while cur > 0 {
    match unicode_segment::prev_grapheme_boundary(s, cur) {
      Some(pv) => cur = pv
      None => break
    }
    steps = steps + 1
  }
  steps
}

///| SegmentLimits / cursor sweep that does not depend on any input corpus.
pub fn run_api() -> String {
  let sb = StringBuilder::new()
  let inputs = [
    "", "a", "ab", "Hello, world! Don't stop at 3.14.", "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{1F1E8}\u{1F1F3}",
    "  !!  ", "\u{0915}\u{094D}\u{0937}\u{093F} \u{AC00}\u{11A8}", "\xFF\xC3\x28\xE2\x82",
  ]
  let lims = [
    (0, 0), (0, 1), (1, 0), (1, 1), (-1, 0), (0, -1), (-1, -1), (2147483647, 2147483647), (-2147483647 - 1, 1),
    (1, -2147483647 - 1), (100, 0), (100, 1), (100, 2), (100, 3), (2, 100), (3, 100),
  ]
  let mut i = 0
  while i < inputs.length() {
    let s = inputs[i]
    let mut j = 0
    while j < lims.length() {
      let (b, m) = lims[j]
      let lim = unicode_segment::SegmentLimits::new(b, m)
      sb.write_string("in" + i.to_string() + " n=" + s.length().to_string() + " lim(" + b.to_string() + "," + m.to_string() + ")")
      let mut api = 0
      while api < 9 {
        sb.write_string(" " + run_limited(api, s, lim).to_string())
        api = api + 1
      }
      sb.write_string("\n")
      j = j + 1
    }
    i = i + 1
  }
  let d = unicode_segment::SegmentLimits::default()
  let (a, b, c) = unicode_segment::unicode_version()
  sb.write_string(
    "default " + d.max_input_bytes.to_string() + " " + d.max_segments.to_string() + " unicode " + a.to_string() + "." +
    b.to_string() + "." + c.to_string() + "\n",
  )
  let sp = unicode_segment::SegmentSpan::new(3, 1)
  sb.write_string("span(3,1) len=" + sp.len().to_string() + " empty=" + sp.is_empty().to_string() + " str=" + sp.to_string())
  sb.write_string(" slice=" + unicode_segment::slice_span("abcdef", sp) + "|" + unicode_segment::slice_span("abcdef", unicode_segment::SegmentSpan::new(-5, 99)) + "|" + unicode_segment::slice_span("abcdef", unicode_segment::SegmentSpan::new(4, 2)) + "\n")
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: unicode_segment_audit dump <file> | bomb <kind> <units> <api> | cursor <kind> <units> | api")
    return 2
  }
  let mode = args[1]
  if mode == "dump" && args.length() >= 3 {
    let text = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => {
        io_eprintln(world, "cannot read " + args[2])
        return 2
      }
    }
    io_print(world, run_dump(text))
    return 0
  }
  if mode == "bomb" && args.length() >= 5 {
    let s = bomb_input(args[2], parse_int(args[3]))
    let t0 = clock_monotonic_us()
    let r = run_api_once(args[4], s)
    let t1 = clock_monotonic_us()
    io_println(world, s.length().to_string() + " " + (t1 - t0).to_string() + " " + r.to_string())
    return 0
  }
  if mode == "cursor" && args.length() >= 4 {
    let s = bomb_input(args[2], parse_int(args[3]))
    let t0 = clock_monotonic_us()
    let r = cursor_walk(s)
    let t1 = clock_monotonic_us()
    io_println(world, s.length().to_string() + " " + (t1 - t0).to_string() + " " + r.to_string())
    return 0
  }
  if mode == "api" {
    io_print(world, run_api())
    return 0
  }
  io_println(world, "bad arguments")
  2
}
