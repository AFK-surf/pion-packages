///| RT-unicode-segment control tests for packages/unicode_segment @ aa2d0a146c (feat/pkg-unicode-segment).
///
/// `control_*` tests pin what the README documents and the attacks the package survived (they must keep
/// passing on any fix branch). Timing findings (cursor walk complexity) are measured by run_audit.sh `dos`,
/// README / oracle claims by run_audit.sh `static` and `oracles`; see REPORT.md.

import "unicode_segment"

///|
fn eq_strs(got : Array[String], want : Array[String]) -> Bool {
  if got.length() != want.length() {
    return false
  }
  let mut i = 0
  while i < got.length() {
    if got[i] != want[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn some_is(o : Option[Int], v : Int) -> Bool {
  match o {
    Some(x) => x == v
    None => false
  }
}

///|
fn is_none(o : Option[Int]) -> Bool {
  match o {
    Some(_) => false
    None => true
  }
}

///|
fn bytes_str(bs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bs.length() {
    sb.write_byte(bs[i].to_byte())
    i = i + 1
  }
  sb.to_string()
}

test "control_readme_usage_examples" {
  let spans = unicode_segment::grapheme_indices(
    "a\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}\u{1F1E8}\u{1F1F3}",
  )
  debug_assert(spans.length() == 3, "README: spans.length() == 3")
  debug_assert(some_is(unicode_segment::next_grapheme_boundary("e\u{0301}x", 0), 3), "README: Some(3)")
  debug_assert(some_is(unicode_segment::prev_grapheme_boundary("e\u{0301}x", 3), 0), "README: Some(0)")
  debug_assert(
    eq_strs(unicode_segment::unicode_words("Don't stop, 3.14!"), ["Don't", "stop", "3.14"]),
    "README: unicode_words",
  )
  debug_assert(
    eq_strs(unicode_segment::sentences("Dr. Smith paid $3.14! Next?"), ["Dr. ", "Smith paid $3.14! ", "Next?"]),
    "README sentences example (UAX #29 breaks after 'Dr. ' before an uppercase word)",
  )
  let lim = unicode_segment::SegmentLimits::new(65536, 4096)
  let ok = match unicode_segment::grapheme_indices_with_limits("hello", lim) {
    Ok(g) => g.length() == 5
    Err(unicode_segment::SegmentError::LimitExceeded) => false
  }
  debug_assert(ok, "README: with_limits")
  let (a, b, c) = unicode_segment::unicode_version()
  debug_assert(a == 16 && b == 0 && c == 0, "unicode_version")
}

test "control_gb9c_gb11_gb12" {
  // क्ष one cluster; क्ष + nukta / ZWJ / Extend between; two linkers
  debug_assert(unicode_segment::grapheme_count("\u{0915}\u{094D}\u{0937}") == 1, "GB9c")
  debug_assert(unicode_segment::grapheme_count("\u{0915}\u{093C}\u{094D}\u{0937}") == 1, "GB9c nukta")
  debug_assert(unicode_segment::grapheme_count("\u{0915}\u{094D}\u{200D}\u{0937}") == 1, "GB9c ZWJ is InCB=Extend")
  debug_assert(unicode_segment::grapheme_count("\u{0905}\u{094D}\u{0937}") == 2, "GB9c needs a consonant")
  debug_assert(unicode_segment::grapheme_count("\u{0915}\u{0301}\u{0937}") == 2, "GB9c needs a linker")
  debug_assert(unicode_segment::grapheme_count("\u{1F468}\u{0301}\u{200D}\u{1F469}") == 1, "GB11 EP Extend* ZWJ x EP")
  debug_assert(unicode_segment::grapheme_count("a\u{200D}\u{1F469}") == 2, "GB11 needs EP before ZWJ")
  debug_assert(unicode_segment::grapheme_count("\u{1F1E6}\u{1F1E6}\u{1F1E6}") == 2, "GB12/13 odd RI")
  debug_assert(unicode_segment::grapheme_count("\u{1F1E6}\u{0301}\u{1F1E6}") == 2, "RI Extend RI breaks")
  debug_assert(unicode_segment::grapheme_count(repeat("\u{1F1E6}", 101)) == 51, "101 RI")
}

test "control_words_and_sentences" {
  debug_assert(
    eq_strs(unicode_segment::words("a\u{0301}:\u{0301}b 3,4 \u{05D0}\"\u{05D1}"), [
      "a\u{0301}:\u{0301}b", " ", "3,4", " ", "\u{05D0}\"\u{05D1}",
    ]),
    "WB4 + WB6/7, WB11/12, WB7b/c",
  )
  debug_assert(
    eq_strs(unicode_segment::unicode_words("+-*/ \u{00BD} \u{2167} ___ "), ["\u{00BD}", "\u{2167}"]),
    "unicode_words keeps No / Nl, drops ExtendNumLet-only words like Rust",
  )
  debug_assert(
    eq_strs(unicode_segment::sentences("etc. and more. ( he said. Next."), ["etc. and more. ( he said. ", "Next."]),
    "SB8",
  )
  debug_assert(eq_strs(unicode_segment::sentences("U.S.A. Navy."), ["U.S.A. ", "Navy."]), "SB7 / SB11")
}

test "control_ill_formed_utf8_and_cursor_extremes" {
  let s = bytes_str([0x61, 0xF0, 0x9F, 0x98, 0xCC, 0x81, 0xFF, 0x62])
  // a | F0 | 9F | 98 | CC 81 (combining acute attaches to the U+FFFD of 98) ... each ill-formed byte is U+FFFD
  let g = unicode_segment::grapheme_indices(s)
  debug_assert(g.length() == 6, "ill-formed bytes are single U+FFFD scalars")
  let mut p = -2
  while p <= s.length() + 2 {
    let _ = unicode_segment::is_grapheme_boundary(s, p)
    let _ = unicode_segment::next_grapheme_boundary(s, p)
    let _ = unicode_segment::prev_grapheme_boundary(s, p)
    p = p + 1
  }
  debug_assert(!unicode_segment::is_grapheme_boundary("\u{1F468}", 2), "mid-UTF-8 offset is not a boundary")
  debug_assert(some_is(unicode_segment::next_grapheme_boundary("\u{1F468}x", 1), 4), "next from mid-UTF-8")
  debug_assert(some_is(unicode_segment::prev_grapheme_boundary("\u{1F468}x", 3), 0), "prev from mid-UTF-8")
  debug_assert(is_none(unicode_segment::next_grapheme_boundary("abc", 2147483647)), "next Int max")
  debug_assert(is_none(unicode_segment::prev_grapheme_boundary("abc", -2147483647 - 1)), "prev Int min")
  debug_assert(is_none(unicode_segment::next_grapheme_boundary("", 0)), "next on empty")
  debug_assert(is_none(unicode_segment::prev_grapheme_boundary("", 0)), "prev on empty")
}

test "control_limits_contract" {
  let s = "ab cd. Ef!"
  let n = s.length()
  let bad = match unicode_segment::sentence_bounds_with_limits(s, unicode_segment::SegmentLimits::new(n, 1)) {
    Ok(_) => true
    Err(_) => false
  }
  debug_assert(!bad, "2 sentences > max_segments 1")
  let exact = match unicode_segment::sentence_bounds_with_limits(s, unicode_segment::SegmentLimits::new(n, 2)) {
    Ok(v) => v.length() == 2
    Err(_) => false
  }
  debug_assert(exact, "exact max_segments accepted")
  let neg = match unicode_segment::grapheme_count_with_limits("", unicode_segment::SegmentLimits::new(0, -1)) {
    Ok(_) => false
    Err(_) => true
  }
  debug_assert(neg, "negative limit rejected even on empty input")
  let big = match unicode_segment::word_bounds_with_limits(s, unicode_segment::SegmentLimits::new(2147483647, 2147483647)) {
    Ok(v) => v.length() == 7
    Err(_) => false
  }
  debug_assert(big, "Int max limits accepted")
}
