///| RT-unicode-segment audit: dump the package's own table lookup for every code point (6 hex digits each),
///| then the lookups of out-of-range code points. Built by run_audit.sh against a copy of the package.
import "unicode_segment"

fn hex2(sb : StringBuilder, v : Int) -> Unit {
  let d = "0123456789abcdef"
  sb.write_byte(d.code_unit_at((v >> 4) & 15).to_byte())
  sb.write_byte(d.code_unit_at(v & 15).to_byte())
}

fn put(sb : StringBuilder, cp : Int) -> Unit {
  let (g, w, s) = unicode_segment::audit_lookup(cp)
  hex2(sb, g)
  hex2(sb, w)
  hex2(sb, s)
}

///|
pub fn main(world : World) -> Int {
  let sb = StringBuilder::with_capacity(6684700)
  let mut cp = 0
  while cp < 1114112 {
    put(sb, cp)
    cp = cp + 1
  }
  sb.write_string("\n")
  let extra = [-1, 1114112, 2147483647, -2147483647 - 1]
  let mut i = 0
  while i < extra.length() {
    if i > 0 {
      sb.write_string(" ")
    }
    put(sb, extra[i])
    i = i + 1
  }
  sb.write_string("\n")
  io_print(world, sb.to_string())
  0
}
