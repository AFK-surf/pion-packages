///| Comprehensive Red -> Green unit, UAX #29 rule-coverage, cursor-navigation,
///| invalid UTF-8, SegmentLimits, and 100k O(n) DoS stress test suite for `packages/unicode_segment`.

fn assert_eq_int(got : Int, expected : Int) -> Unit {
  debug_assert(got == expected, "expected " + expected.to_string() + ", got " + got.to_string())
}

fn assert_eq_str(got : String, expected : String) -> Unit {
  debug_assert(got == expected, "expected '" + expected + "', got '" + got + "'")
}

fn assert_eq_bool(got : Bool, expected : Bool) -> Unit {
  debug_assert(got == expected, "expected " + expected.to_string() + ", got " + got.to_string())
}

fn assert_eq_opt_int(got : Option[Int], expected : Option[Int]) -> Unit {
  match expected {
    None => {
      match got {
        None => ()
        Some(v) => debug_assert(false, "expected None, got Some(" + v.to_string() + ")")
      }
    }
    Some(ev) => {
      match got {
        None => debug_assert(false, "expected Some(" + ev.to_string() + "), got None")
        Some(gv) => assert_eq_int(gv, ev)
      }
    }
  }
}

fn assert_eq_str_array(got : Array[String], expected : Array[String]) -> Unit {
  assert_eq_int(got.length(), expected.length())
  let mut i = 0
  while i < expected.length() {
    assert_eq_str(got[i], expected[i])
    i = i + 1
  }
}

fn assert_spans_cover(s : String, spans : Array[SegmentSpan]) -> Unit {
  let n = s.length()
  if n == 0 {
    assert_eq_int(spans.length(), 0)
    return
  }
  debug_assert(spans.length() > 0, "non-empty string must produce >= 1 span")
  assert_eq_int(spans[0].start, 0)
  let mut i = 0
  while i < spans.length() {
    debug_assert(spans[i].end > spans[i].start, "span must be non-empty")
    if i + 1 < spans.length() {
      assert_eq_int(spans[i].end, spans[i + 1].start)
    }
    i = i + 1
  }
  assert_eq_int(spans[spans.length() - 1].end, n)
}

fn repeat_str(chunk : String, count : Int) -> String {
  let sb = StringBuilder::with_capacity(chunk.length() * count)
  let mut i = 0
  while i < count {
    sb.write_string(chunk)
    i = i + 1
  }
  sb.to_string()
}

// =========================================================================
// 1. Extended Grapheme Clusters (UAX #29 §3.1.1, GB1-GB999 incl. GB9c)
// =========================================================================

test "grapheme_empty_and_ascii_crlf" {
  assert_eq_int(grapheme_count(""), 0)
  assert_eq_str_array(graphemes(""), [])
  assert_eq_str_array(graphemes("a\r\nb\nc\rd"), ["a", "\r\n", "b", "\n", "c", "\r", "d"])
  assert_eq_int(grapheme_count("a\r\nb"), 3)
  assert_spans_cover("a\r\nb\nc\rd", grapheme_indices("a\r\nb\nc\rd"))
}

test "grapheme_combining_marks_and_hangul_jamo" {
  // e + combining acute + combining diaeresis
  let s1 = "e\u{0301}\u{0308}a"
  assert_eq_str_array(graphemes(s1), ["e\u{0301}\u{0308}", "a"])
  // Hangul L + V + T -> single grapheme cluster
  let hangul = "\u{1100}\u{1161}\u{11A8}\u{AC00}\u{11A8}"
  assert_eq_str_array(graphemes(hangul), ["\u{1100}\u{1161}\u{11A8}", "\u{AC00}\u{11A8}"])
}

test "grapheme_gb9c_indic_conjunct_break" {
  // Devanagari KA + VIRAMA + SSA (क + ् + ष) -> single cluster under GB9c
  let kssa = "\u{0915}\u{094D}\u{0937}"
  assert_eq_str_array(graphemes(kssa), [kssa])
  assert_eq_int(grapheme_count(kssa), 1)
  // Devanagari KA + NUKTA (InCB=Extend) + VIRAMA (InCB=Linker) + SSA (InCB=Consonant) -> single cluster
  let with_nukta = "\u{0915}\u{093C}\u{094D}\u{0937}"
  assert_eq_str_array(graphemes(with_nukta), [with_nukta])
  // Chained conjuncts: KA + VIRAMA + TA + VIRAMA + RA -> single cluster
  let chained = "\u{0915}\u{094D}\u{0924}\u{094D}\u{0930}"
  assert_eq_str_array(graphemes(chained), [chained])
  // Two consonants without Linker MUST break: KA + SSA -> 2 clusters
  let two_cons = "\u{0915}\u{0937}"
  assert_eq_str_array(graphemes(two_cons), ["\u{0915}", "\u{0937}"])
}

test "grapheme_gb11_emoji_zwj_sequences" {
  // Family emoji: Man + ZWJ + Woman + ZWJ + Girl + ZWJ + Boy
  let family = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}"
  assert_eq_str_array(graphemes(family), [family])
  assert_eq_int(grapheme_count(family), 1)
  // Woman + Medium Skin Tone (Extend) + ZWJ + Rocket
  let astronaut = "\u{1F469}\u{1F3FD}\u{200D}\u{1F680}"
  assert_eq_str_array(graphemes(astronaut), [astronaut])
  // Non-ExtPict 'a' + ZWJ + Man -> breaks before Man (GB11 requires leading ExtPict)
  let non_ep = "a\u{200D}\u{1F468}"
  assert_eq_str_array(graphemes(non_ep), ["a\u{200D}", "\u{1F468}"])
}

test "grapheme_gb12_gb13_regional_indicator_flags" {
  // China flag + US flag -> 2 clusters
  let flags = "\u{1F1E8}\u{1F1F3}\u{1F1FA}\u{1F1F8}"
  assert_eq_str_array(graphemes(flags), ["\u{1F1E8}\u{1F1F3}", "\u{1F1FA}\u{1F1F8}"])
  // 3 RIs -> pair + single
  let three_ri = "\u{1F1E6}\u{1F1E7}\u{1F1E8}"
  assert_eq_str_array(graphemes(three_ri), ["\u{1F1E6}\u{1F1E7}", "\u{1F1E8}"])
  // Leading non-RI + 3 RIs -> 'a' + pair + single
  let lead_ri = "a\u{1F1E6}\u{1F1E7}\u{1F1E8}"
  assert_eq_str_array(graphemes(lead_ri), ["a", "\u{1F1E6}\u{1F1E7}", "\u{1F1E8}"])
}

test "grapheme_cursor_navigation_and_mid_byte_safety" {
  // "a" (1B) + family (25B) + flag CN (8B) + "b" (1B) = 35B
  let family = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}"
  let flag_cn = "\u{1F1E8}\u{1F1F3}"
  let s = "a" + family + flag_cn + "b"
  let b1 = 1
  let b2 = 1 + family.length()
  let b3 = b2 + flag_cn.length()
  let b4 = s.length()

  assert_eq_bool(is_grapheme_boundary(s, 0), true)
  assert_eq_bool(is_grapheme_boundary(s, b1), true)
  assert_eq_bool(is_grapheme_boundary(s, b1 + 2), false)
  assert_eq_bool(is_grapheme_boundary(s, b2), true)
  assert_eq_bool(is_grapheme_boundary(s, b2 + 4), false)
  assert_eq_bool(is_grapheme_boundary(s, b3), true)
  assert_eq_bool(is_grapheme_boundary(s, b4), true)
  assert_eq_bool(is_grapheme_boundary(s, -1), false)
  assert_eq_bool(is_grapheme_boundary(s, b4 + 1), false)

  // Forward stepping
  assert_eq_opt_int(next_grapheme_boundary(s, 0), Some(b1))
  assert_eq_opt_int(next_grapheme_boundary(s, b1), Some(b2))
  assert_eq_opt_int(next_grapheme_boundary(s, b1 + 5), Some(b2))
  assert_eq_opt_int(next_grapheme_boundary(s, b2), Some(b3))
  assert_eq_opt_int(next_grapheme_boundary(s, b3), Some(b4))
  assert_eq_opt_int(next_grapheme_boundary(s, b4), None)

  // Backward stepping (backspace)
  assert_eq_opt_int(prev_grapheme_boundary(s, b4), Some(b3))
  assert_eq_opt_int(prev_grapheme_boundary(s, b3), Some(b2))
  assert_eq_opt_int(prev_grapheme_boundary(s, b2 + 3), Some(b2))
  assert_eq_opt_int(prev_grapheme_boundary(s, b2), Some(b1))
  assert_eq_opt_int(prev_grapheme_boundary(s, b1), Some(0))
  assert_eq_opt_int(prev_grapheme_boundary(s, 0), None)
}

// =========================================================================
// 2. Word Boundaries (UAX #29 §4.1, WB1-WB999)
// =========================================================================

test "word_basic_english_contractions_numbers_and_unicode_words" {
  let s = "Don't stop, 3.14 + 1,000 = ok!"
  assert_eq_str_array(
    words(s),
    ["Don't", " ", "stop", ",", " ", "3.14", " ", "+", " ", "1,000", " ", "=", " ", "ok", "!"],
  )
  assert_eq_str_array(unicode_words(s), ["Don't", "stop", "3.14", "1,000", "ok"])
  assert_spans_cover(s, word_bounds(s))
}

test "word_cjk_katakana_hebrew_and_emoji_zwj" {
  // CJK ideographs break individually; Katakana groups together
  assert_eq_str_array(words("你好カタカナ"), ["你", "好", "カタカナ"])
  assert_eq_str_array(unicode_words("你好，カタカナ！"), ["你", "好", "カタカナ"])
  // WB3c: ZWJ x ExtPict; WB3d: WSegSpace x WSegSpace
  let s = "a  b \u{1F468}\u{200D}\u{1F469}"
  assert_eq_str_array(words(s), ["a", "  ", "b", " ", "\u{1F468}\u{200D}\u{1F469}"])
  // WB7a/WB7b/WB7c: Hebrew_Letter with single/double quote
  let heb = "\u{05D0}' \u{05D0}\"\u{05D1}"
  assert_eq_str_array(words(heb), ["\u{05D0}'", " ", "\u{05D0}\"\u{05D1}"])
}

// =========================================================================
// 3. Sentence Boundaries (UAX #29 §5.1, SB1-SB11 + SB998)
// =========================================================================

test "sentence_basic_quotes_abbreviations_and_numbers" {
  let s = "Hello world. Dr. Smith paid $3.14! He said \"Hi.\" Next?\r\nLast"
  assert_eq_str_array(
    sentences(s),
    ["Hello world. ", "Dr. ", "Smith paid $3.14! ", "He said \"Hi.\" ", "Next?\r\n", "Last"],
  )
  assert_spans_cover(s, sentence_bounds(s))

  // SB7: Upper ATerm Upper (e.g. "U.S.A. is")
  let abbr = "U.S.A. is big. Next."
  assert_eq_str_array(sentences(abbr), ["U.S.A. is big. ", "Next."])

  // SB8: ATerm Close* Sp* ¬(...) Lower (e.g. "e.g. test")
  let sb8 = "See e.g. this. Now."
  assert_eq_str_array(sentences(sb8), ["See e.g. this. ", "Now."])
}

// =========================================================================
// 4. Invalid UTF-8, SegmentLimits, and 100k O(n) DoS Stress
// =========================================================================

test "invalid_utf8_bytes_handled_without_panic" {
  let sb = StringBuilder::new()
  sb.write_byte(0x61.to_byte()) // 'a'
  sb.write_byte(0xFF.to_byte()) // invalid byte
  sb.write_byte(0x80.to_byte()) // stray continuation
  sb.write_byte(0xE2.to_byte()) // truncated 3-byte
  sb.write_byte(0x62.to_byte()) // 'b'
  let bad = sb.to_string()
  let gs = grapheme_indices(bad)
  assert_spans_cover(bad, gs)
  assert_eq_int(gs.length(), 5)
  let ws = word_bounds(bad)
  assert_spans_cover(bad, ws)
  let ss = sentence_bounds(bad)
  assert_spans_cover(bad, ss)
}

test "segment_limits_negative_zero_and_exact_bounds" {
  // Negative limits fail even on empty string
  match grapheme_indices_with_limits("", SegmentLimits::new(-1, 10)) {
    Err(SegmentError::LimitExceeded) => ()
    _ => debug_assert(false, "expected LimitExceeded for negative max_input_bytes")
  }
  match word_bounds_with_limits("", SegmentLimits::new(10, -1)) {
    Err(SegmentError::LimitExceeded) => ()
    _ => debug_assert(false, "expected LimitExceeded for negative max_segments")
  }
  match sentence_bounds_with_limits("", SegmentLimits::new(-1, -1)) {
    Err(SegmentError::LimitExceeded) => ()
    _ => debug_assert(false, "expected LimitExceeded for negative limits")
  }

  // Zero limits: empty string succeeds, non-empty fails
  match grapheme_indices_with_limits("", SegmentLimits::new(0, 0)) {
    Ok(v) => assert_eq_int(v.length(), 0)
    Err(_) => debug_assert(false, "empty string should pass zero limits")
  }
  match grapheme_indices_with_limits("a", SegmentLimits::new(0, 10)) {
    Err(SegmentError::LimitExceeded) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_input_bytes=0 on 'a'")
  }
  match grapheme_indices_with_limits("a", SegmentLimits::new(10, 0)) {
    Err(SegmentError::LimitExceeded) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_segments=0 on 'a'")
  }
  match word_bounds_with_limits("a b", SegmentLimits::new(10, 2)) {
    Err(SegmentError::LimitExceeded) => ()
    _ => debug_assert(false, "expected LimitExceeded when words exceed max_segments=2")
  }
  match sentence_bounds_with_limits("A. B.", SegmentLimits::new(10, 1)) {
    Err(SegmentError::LimitExceeded) => ()
    _ => debug_assert(false, "expected LimitExceeded when sentences exceed max_segments=1")
  }
}

test "dos_linear_time_100k_extend_zwj_ri_aterm_close_sp" {
  // 100k Extend marks on a single base char -> 1 grapheme, 1 word, 1 sentence in O(n)
  let ext_100k = "a" + repeat_str("\u{0301}", 100000)
  assert_eq_int(grapheme_count(ext_100k), 1)
  assert_eq_int(word_bounds(ext_100k).length(), 1)
  assert_eq_int(sentence_bounds(ext_100k).length(), 1)

  // 100k Regional Indicators -> 50,000 grapheme pairs, 50,000 word pairs in O(n)
  let ri_100k = repeat_str("\u{1F1E6}", 100000)
  assert_eq_int(grapheme_count(ri_100k), 50000)
  assert_eq_int(word_bounds(ri_100k).length(), 50000)

  // 100k ATerm + Close + Sp chain (classic UAX #29 SB8/SB9/SB10 backtracking bomb!) -> O(n)
  let sb_bomb = repeat_str(".\") ", 25000) + "a"
  let sb_spans = sentence_bounds(sb_bomb)
  assert_spans_cover(sb_bomb, sb_spans)
  assert_eq_int(sb_spans.length(), 1)
}

test "cursor_linear_time_korean_prose_and_pure_hangul" {
  // Regression for P1-1: walking Korean prose & pure Hangul syllables with next/prev cursor APIs must be O(n).
  let ko_prose = repeat_str("안녕하세요 세계 반갑습니다 ", 800)
  let mut pos = 0
  let mut fwd_steps = 0
  while pos < ko_prose.length() {
    match next_grapheme_boundary(ko_prose, pos) {
      Some(nxt) => {
        pos = nxt
        fwd_steps = fwd_steps + 1
      }
      None => break
    }
  }
  assert_eq_int(fwd_steps, 12000)
  let mut bwd_steps = 0
  while pos > 0 {
    match prev_grapheme_boundary(ko_prose, pos) {
      Some(prv) => {
        pos = prv
        bwd_steps = bwd_steps + 1
      }
      None => break
    }
  }
  assert_eq_int(bwd_steps, 12000)

  let hangul = repeat_str("가각", 4000)
  let mut hpos = 0
  let mut hfwd = 0
  while hpos < hangul.length() {
    match next_grapheme_boundary(hangul, hpos) {
      Some(nxt) => {
        hpos = nxt
        hfwd = hfwd + 1
      }
      None => break
    }
  }
  assert_eq_int(hfwd, 8000)
  let mut hbwd = 0
  while hpos > 0 {
    match prev_grapheme_boundary(hangul, hpos) {
      Some(prv) => {
        hpos = prv
        hbwd = hbwd + 1
      }
      None => break
    }
  }
  assert_eq_int(hbwd, 8000)
}
