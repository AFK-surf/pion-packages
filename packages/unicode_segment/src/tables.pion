fn blob_u24(tbl : String, off : Int) -> Int {
  ((tbl.code_unit_at(off) - 35) << 18) |
  ((tbl.code_unit_at(off + 1) - 35) << 12) |
  ((tbl.code_unit_at(off + 2) - 35) << 6) |
  (tbl.code_unit_at(off + 3) - 35)
}

fn lookup_smp(tbl : String, cp : Int, smp_off : Int, smp_n : Int) -> Int {
  let target = cp - 0x10000
  let mut lo = 0
  let mut hi = smp_n - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let off = smp_off + mid * 9
    let r_lo = blob_u24(tbl, off)
    if target < r_lo {
      hi = mid - 1
    } else {
      let r_hi = blob_u24(tbl, off + 4)
      if target <= r_hi {
        return tbl.code_unit_at(off + 8) - 35
      }
      lo = mid + 1
    }
  }
  0
}

fn lookup_blob(tbl : String, cp : Int, idx_off : Int, data_off : Int, smp_off : Int, smp_n : Int) -> Int {
  if cp < 0 || cp > 0x10FFFF {
    return 0
  }
  if cp < 0x10000 {
    let page = tbl.code_unit_at(idx_off + (cp >> 8)) - 35
    return tbl.code_unit_at(data_off + ((page << 8) | (cp & 255))) - 35
  }
  lookup_smp(tbl, cp, smp_off, smp_n)
}

///| Decode grapheme combo ID into packed `gcb | (extpict << 4) | (incb << 5)`.
fn decode_g_combo(id : Int) -> Int {
  match id {
    0 => 0
    1 => 64
    2 => 16
    3 => 1
    4 => 2
    5 => 3
    6 => 4
    7 => 36
    8 => 100
    9 => 101
    10 => 6
    11 => 7
    12 => 8
    13 => 9
    14 => 10
    15 => 11
    16 => 12
    17 => 13
    _ => 0
  }
}

///| Decode word combo ID into packed `wb | (extpict << 5) | (alnum << 6)`.
fn decode_w_combo(id : Int) -> Int {
  match id {
    0 => 0
    1 => 64
    2 => 32
    3 => 1
    4 => 2
    5 => 3
    6 => 4
    7 => 68
    8 => 5
    9 => 6
    10 => 7
    11 => 8
    12 => 72
    13 => 73
    14 => 10
    15 => 74
    16 => 106
    17 => 11
    18 => 12
    19 => 13
    20 => 14
    21 => 15
    22 => 16
    23 => 80
    24 => 17
    25 => 18
    _ => 0
  }
}

fn lookup_grapheme_packed(cp : Int) -> Int {
  let tbl = table_blob
  decode_g_combo(lookup_blob(tbl, cp, off_g_bmp_idx, off_g_bmp_data, off_g_smp, g_smp_count))
}

fn lookup_word_packed(cp : Int) -> Int {
  let tbl = table_blob
  decode_w_combo(lookup_blob(tbl, cp, off_w_bmp_idx, off_w_bmp_data, off_w_smp, w_smp_count))
}

fn lookup_sentence_prop(cp : Int) -> Int {
  let tbl = table_blob
  lookup_blob(tbl, cp, off_s_bmp_idx, off_s_bmp_data, off_s_smp, s_smp_count)
}
