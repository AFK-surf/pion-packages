fn b64_val(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b - 65
  } else if b >= 97 && b <= 122 {
    b - 97 + 26
  } else if b >= 48 && b <= 57 {
    b - 48 + 52
  } else if b == 45 {
    62
  } else {
    63
  }
}

fn b64_u24(s : String, off : Int) -> Int {
  (b64_val(s.code_unit_at(off)) << 18) |
  (b64_val(s.code_unit_at(off + 1)) << 12) |
  (b64_val(s.code_unit_at(off + 2)) << 6) |
  b64_val(s.code_unit_at(off + 3))
}

fn lookup_table(cp : Int, idx_s : String, data_s : String, smp_s : String, smp_n : Int) -> Int {
  if cp < 0 || cp > 0x10FFFF {
    return 0
  }
  if cp < 0x10000 {
    let page = b64_val(idx_s.code_unit_at(cp >> 8))
    return data_s.code_unit_at((page << 8) | (cp & 255)) - 65
  }
  let target = cp - 0x10000
  let mut lo = 0
  let mut hi = smp_n - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let off = mid * 9
    let r_lo = b64_u24(smp_s, off)
    if target < r_lo {
      hi = mid - 1
    } else {
      let r_hi = b64_u24(smp_s, off + 4)
      if target <= r_hi {
        return smp_s.code_unit_at(off + 8) - 65
      }
      lo = mid + 1
    }
  }
  0
}

