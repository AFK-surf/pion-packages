///| UAX #29 §3.1.1 Extended Grapheme Cluster segmentation (Unicode 16.0.0, GB1–GB999 incl. GB9c).
///| Pure O(n) single-pass DFA, zero `FixedArray`, zero mutable globals.

fn g_is_ctrl(gcb : Int) -> Bool {
  gcb == gcb_control || gcb == gcb_cr || gcb == gcb_lf
}

///| Evaluate UAX #29 GB3–GB999 break decision between `prev_gcb` and `curr` given DFA state.
///| Returns `true` if there IS a grapheme break before `curr`.
fn grapheme_should_break(
  prev_gcb : Int,
  curr_gcb : Int,
  curr_ep : Int,
  curr_incb : Int,
  ri_odd : Bool,
  ep_state : Int,
  incb_state : Int,
) -> Bool {
  // GB3: CR x LF
  if prev_gcb == gcb_cr && curr_gcb == gcb_lf {
    return false
  }
  // GB4: (Control | CR | LF) ÷
  if g_is_ctrl(prev_gcb) {
    return true
  }
  // GB5: ÷ (Control | CR | LF)
  if g_is_ctrl(curr_gcb) {
    return true
  }
  // GB6: L x (L | V | LV | LVT)
  if prev_gcb == gcb_l &&
  (curr_gcb == gcb_l || curr_gcb == gcb_v || curr_gcb == gcb_lv || curr_gcb == gcb_lvt) {
    return false
  }
  // GB7: (LV | V) x (V | T)
  if (prev_gcb == gcb_lv || prev_gcb == gcb_v) && (curr_gcb == gcb_v || curr_gcb == gcb_t) {
    return false
  }
  // GB8: (LVT | T) x T
  if (prev_gcb == gcb_lvt || prev_gcb == gcb_t) && curr_gcb == gcb_t {
    return false
  }
  // GB9: x (Extend | ZWJ)
  if curr_gcb == gcb_extend || curr_gcb == gcb_zwj {
    return false
  }
  // GB9a: x SpacingMark
  if curr_gcb == gcb_spacingmark {
    return false
  }
  // GB9b: Prepend x
  if prev_gcb == gcb_prepend {
    return false
  }
  // GB9c: \p{InCB=Consonant} [\p{InCB=Extend}\p{InCB=Linker}]* \p{InCB=Linker} [\p{InCB=Extend}\p{InCB=Linker}]* x \p{InCB=Consonant}
  if incb_state == 2 && curr_incb == incb_consonant {
    return false
  }
  // GB11: \p{Extended_Pictographic} Extend* ZWJ x \p{Extended_Pictographic}
  if ep_state == 2 && curr_ep == 1 {
    return false
  }
  // GB12 / GB13: (sot | [^RI]) (RI RI)* RI x RI
  if prev_gcb == gcb_regional_indicator && curr_gcb == gcb_regional_indicator && ri_odd {
    return false
  }
  // GB999: Any ÷ Any
  true
}

fn next_ep_state(ep_state : Int, curr_gcb : Int, curr_ep : Int) -> Int {
  if curr_ep == 1 {
    1
  } else if ep_state == 1 && curr_gcb == gcb_extend {
    1
  } else if ep_state == 1 && curr_gcb == gcb_zwj {
    2
  } else {
    0
  }
}

fn next_incb_state(incb_state : Int, curr_incb : Int) -> Int {
  if curr_incb == incb_consonant {
    1
  } else if incb_state >= 1 && curr_incb == incb_linker {
    2
  } else if incb_state >= 1 && curr_incb == incb_extend {
    incb_state
  } else {
    0
  }
}

fn next_ri_odd(prev_gcb : Int, curr_gcb : Int, ri_odd : Bool) -> Bool {
  if curr_gcb != gcb_regional_indicator {
    false
  } else if prev_gcb == gcb_regional_indicator && ri_odd {
    false
  } else {
    true
  }
}

///| Compute Extended Grapheme Cluster byte spans with explicit resource limits.
pub fn grapheme_indices_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  match check_input_limits(s, limits) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let n = s.length()
  let out : Array[SegmentSpan] = Array::new()
  if n == 0 {
    return Ok(out)
  }
  if limits.max_segments == 0 {
    return Err(SegmentError::LimitExceeded)
  }

  let first_dec = utf8_decode_packed(s, 0, n)
  let first_cp = first_dec >> 3
  let first_len = first_dec & 7
  let first_p = lookup_grapheme_packed(first_cp)
  let mut prev_gcb = first_p & 15
  let first_ep = (first_p >> 4) & 1
  let first_incb = (first_p >> 5) & 3
  let mut ri_odd = prev_gcb == gcb_regional_indicator
  let mut ep_state = if first_ep == 1 { 1 } else { 0 }
  let mut incb_state = if first_incb == incb_consonant { 1 } else { 0 }

  let mut seg_start = 0
  let mut pos = first_len
  let mut count = 0

  while pos < n {
    let dec = utf8_decode_packed(s, pos, n)
    let cp = dec >> 3
    let clen = dec & 7
    let packed = lookup_grapheme_packed(cp)
    let curr_gcb = packed & 15
    let curr_ep = (packed >> 4) & 1
    let curr_incb = (packed >> 5) & 3

    if grapheme_should_break(prev_gcb, curr_gcb, curr_ep, curr_incb, ri_odd, ep_state, incb_state) {
      count = count + 1
      if count >= limits.max_segments {
        // Already hit max_segments before emitting the remaining tail segment.
        return Err(SegmentError::LimitExceeded)
      }
      out.push(SegmentSpan::new(seg_start, pos))
      seg_start = pos
    }

    ri_odd = next_ri_odd(prev_gcb, curr_gcb, ri_odd)
    ep_state = next_ep_state(ep_state, curr_gcb, curr_ep)
    incb_state = next_incb_state(incb_state, curr_incb)
    prev_gcb = curr_gcb
    pos = pos + clen
  }

  out.push(SegmentSpan::new(seg_start, n))
  Ok(out)
}

///| Compute Extended Grapheme Cluster byte spans for `s`.
pub fn grapheme_indices(s : String) -> Array[SegmentSpan] {
  let n = s.length()
  let out : Array[SegmentSpan] = Array::new()
  if n == 0 {
    return out
  }

  let first_dec = utf8_decode_packed(s, 0, n)
  let first_cp = first_dec >> 3
  let first_len = first_dec & 7
  let first_p = lookup_grapheme_packed(first_cp)
  let mut prev_gcb = first_p & 15
  let first_ep = (first_p >> 4) & 1
  let first_incb = (first_p >> 5) & 3
  let mut ri_odd = prev_gcb == gcb_regional_indicator
  let mut ep_state = if first_ep == 1 { 1 } else { 0 }
  let mut incb_state = if first_incb == incb_consonant { 1 } else { 0 }

  let mut seg_start = 0
  let mut pos = first_len

  while pos < n {
    let dec = utf8_decode_packed(s, pos, n)
    let cp = dec >> 3
    let clen = dec & 7
    let packed = lookup_grapheme_packed(cp)
    let curr_gcb = packed & 15
    let curr_ep = (packed >> 4) & 1
    let curr_incb = (packed >> 5) & 3

    if grapheme_should_break(prev_gcb, curr_gcb, curr_ep, curr_incb, ri_odd, ep_state, incb_state) {
      out.push(SegmentSpan::new(seg_start, pos))
      seg_start = pos
    }

    ri_odd = next_ri_odd(prev_gcb, curr_gcb, ri_odd)
    ep_state = next_ep_state(ep_state, curr_gcb, curr_ep)
    incb_state = next_incb_state(incb_state, curr_incb)
    prev_gcb = curr_gcb
    pos = pos + clen
  }

  out.push(SegmentSpan::new(seg_start, n))
  out
}

///| Split `s` into Extended Grapheme Cluster strings with explicit resource limits.
pub fn graphemes_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[String], SegmentError] {
  match grapheme_indices_with_limits(s, limits) {
    Ok(spans) => Ok(spans_to_strings(s, spans))
    Err(e) => Err(e)
  }
}

///| Split `s` into Extended Grapheme Cluster strings.
pub fn graphemes(s : String) -> Array[String] {
  spans_to_strings(s, grapheme_indices(s))
}

///| Count Extended Grapheme Clusters in `s` with explicit resource limits (zero span allocation).
pub fn grapheme_count_with_limits(s : String, limits : SegmentLimits) -> Result[Int, SegmentError] {
  match check_input_limits(s, limits) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let n = s.length()
  if n == 0 {
    return Ok(0)
  }
  if limits.max_segments == 0 {
    return Err(SegmentError::LimitExceeded)
  }

  let first_dec = utf8_decode_packed(s, 0, n)
  let first_cp = first_dec >> 3
  let first_len = first_dec & 7
  let first_p = lookup_grapheme_packed(first_cp)
  let mut prev_gcb = first_p & 15
  let first_ep = (first_p >> 4) & 1
  let first_incb = (first_p >> 5) & 3
  let mut ri_odd = prev_gcb == gcb_regional_indicator
  let mut ep_state = if first_ep == 1 { 1 } else { 0 }
  let mut incb_state = if first_incb == incb_consonant { 1 } else { 0 }

  let mut pos = first_len
  let mut count = 1

  while pos < n {
    let dec = utf8_decode_packed(s, pos, n)
    let cp = dec >> 3
    let clen = dec & 7
    let packed = lookup_grapheme_packed(cp)
    let curr_gcb = packed & 15
    let curr_ep = (packed >> 4) & 1
    let curr_incb = (packed >> 5) & 3

    if grapheme_should_break(prev_gcb, curr_gcb, curr_ep, curr_incb, ri_odd, ep_state, incb_state) {
      count = count + 1
      if count > limits.max_segments {
        return Err(SegmentError::LimitExceeded)
      }
    }

    ri_odd = next_ri_odd(prev_gcb, curr_gcb, ri_odd)
    ep_state = next_ep_state(ep_state, curr_gcb, curr_ep)
    incb_state = next_incb_state(incb_state, curr_incb)
    prev_gcb = curr_gcb
    pos = pos + clen
  }

  Ok(count)
}

///| Count Extended Grapheme Clusters in `s` without allocating spans or slices.
pub fn grapheme_count(s : String) -> Int {
  let n = s.length()
  if n == 0 {
    return 0
  }

  let first_dec = utf8_decode_packed(s, 0, n)
  let first_cp = first_dec >> 3
  let first_len = first_dec & 7
  let first_p = lookup_grapheme_packed(first_cp)
  let mut prev_gcb = first_p & 15
  let first_ep = (first_p >> 4) & 1
  let first_incb = (first_p >> 5) & 3
  let mut ri_odd = prev_gcb == gcb_regional_indicator
  let mut ep_state = if first_ep == 1 { 1 } else { 0 }
  let mut incb_state = if first_incb == incb_consonant { 1 } else { 0 }

  let mut pos = first_len
  let mut count = 1

  while pos < n {
    let dec = utf8_decode_packed(s, pos, n)
    let cp = dec >> 3
    let clen = dec & 7
    let packed = lookup_grapheme_packed(cp)
    let curr_gcb = packed & 15
    let curr_ep = (packed >> 4) & 1
    let curr_incb = (packed >> 5) & 3

    if grapheme_should_break(prev_gcb, curr_gcb, curr_ep, curr_incb, ri_odd, ep_state, incb_state) {
      count = count + 1
    }

    ri_odd = next_ri_odd(prev_gcb, curr_gcb, ri_odd)
    ep_state = next_ep_state(ep_state, curr_gcb, curr_ep)
    incb_state = next_incb_state(incb_state, curr_incb)
    prev_gcb = curr_gcb
    pos = pos + clen
  }

  count
}

///| Find a guaranteed grapheme-boundary anchor at or before `offset` by stepping back
///| to the nearest codepoint `X` (preceded by `Y`) where:
///|   1. `X` is not `Extend` / `ZWJ` / `InCB=Linker|Extend` (so fresh DFA state at `X` is exact), and
///|   2. `grapheme_should_break(Y, X, ...)` is unconditionally `true` under the worst-case state
///|      reachable after `Y` (`ri_odd = true`, `ep_state = 2` iff `Y` is `ZWJ`,
///|      `incb_state = 2` iff `Y` is `InCB=Linker|Extend`).
///| Stops in O(1) on ordinary text (including Hangul syllables, Latin, CJK, emoji, Devanagari)
///| and only scans further inside genuinely stateful runs (RI pairs, long Extend/ZWJ/GB9c chains).
fn find_safe_grapheme_anchor(s : String, offset : Int, n : Int) -> Int {
  if offset <= 0 {
    return 0
  }
  let mut cur = if offset > n { n } else { offset }
  // Align `cur` down to the lead byte if it points inside a multi-byte UTF-8 sequence.
  if cur < n {
    let mut back0 = 0
    while cur > 0 && back0 < 3 && (s.code_unit_at(cur) & 0xC0) == 0x80 {
      cur = cur - 1
      back0 = back0 + 1
    }
  }
  if cur <= 0 {
    return 0
  }

  let mut has_x = false
  let mut x_pos = cur
  let mut x_gcb = 0
  let mut x_ep = 0
  let mut x_incb = 0

  if cur < n {
    let x_dec = utf8_decode_packed(s, cur, n)
    let x_clen = x_dec & 7
    let x_b0 = s.code_unit_at(cur)
    // Only treat well-formed UTF-8 scalar values as candidate anchor `X`.
    if x_b0 < 0x80 || x_clen > 1 {
      let xp = lookup_grapheme_packed(x_dec >> 3)
      x_gcb = xp & 15
      x_ep = (xp >> 4) & 1
      x_incb = (xp >> 5) & 3
      has_x = x_gcb != gcb_extend && x_gcb != gcb_zwj && x_incb != incb_linker &&
      x_incb != incb_extend
    }
  }

  while cur > 0 {
    let mut start = cur - 1
    let mut back = 0
    while start > 0 && back < 3 && (s.code_unit_at(start) & 0xC0) == 0x80 {
      start = start - 1
      back = back + 1
    }
    let dec = utf8_decode_packed(s, start, n)
    let cp = dec >> 3
    let clen = dec & 7
    if start + clen != cur {
      // Invalid UTF-8 byte before `cur`; do not anchor across ill-formed bytes.
      has_x = false
      cur = cur - 1
      continue
    }
    let yp = lookup_grapheme_packed(cp)
    let y_gcb = yp & 15
    let y_ep = (yp >> 4) & 1
    let y_incb = (yp >> 5) & 3

    if has_x {
      let max_ep = if y_gcb == gcb_zwj { 2 } else { 0 }
      let max_incb = if y_incb == incb_linker || y_incb == incb_extend { 2 } else { 0 }
      if grapheme_should_break(y_gcb, x_gcb, x_ep, x_incb, true, max_ep, max_incb) {
        return x_pos
      }
    }

    x_pos = start
    x_gcb = y_gcb
    x_ep = y_ep
    x_incb = y_incb
    has_x = y_gcb != gcb_extend && y_gcb != gcb_zwj && y_incb != incb_linker &&
    y_incb != incb_extend
    cur = start
  }
  0
}

///| Return `true` if `byte_offset` is a valid Extended Grapheme Cluster boundary in `s`.
pub fn is_grapheme_boundary(s : String, byte_offset : Int) -> Bool {
  let n = s.length()
  if byte_offset < 0 || byte_offset > n {
    return false
  }
  if byte_offset == 0 || byte_offset == n {
    return true
  }
  let anchor = find_safe_grapheme_anchor(s, byte_offset, n)
  if anchor == byte_offset {
    return true
  }
  let first_dec = utf8_decode_packed(s, anchor, n)
  let first_p = lookup_grapheme_packed(first_dec >> 3)
  let mut prev_gcb = first_p & 15
  let mut ri_odd = prev_gcb == gcb_regional_indicator
  let mut ep_state = if ((first_p >> 4) & 1) == 1 { 1 } else { 0 }
  let mut incb_state = if ((first_p >> 5) & 3) == incb_consonant { 1 } else { 0 }
  let mut pos = anchor + (first_dec & 7)

  while pos < n {
    if pos > byte_offset {
      return false
    }
    let dec = utf8_decode_packed(s, pos, n)
    let packed = lookup_grapheme_packed(dec >> 3)
    let curr_gcb = packed & 15
    let curr_ep = (packed >> 4) & 1
    let curr_incb = (packed >> 5) & 3
    let brk = grapheme_should_break(
      prev_gcb, curr_gcb, curr_ep, curr_incb, ri_odd, ep_state, incb_state,
    )
    if pos == byte_offset {
      return brk
    }
    ri_odd = next_ri_odd(prev_gcb, curr_gcb, ri_odd)
    ep_state = next_ep_state(ep_state, curr_gcb, curr_ep)
    incb_state = next_incb_state(incb_state, curr_incb)
    prev_gcb = curr_gcb
    pos = pos + (dec & 7)
  }
  false
}

///| Return the next Extended Grapheme Cluster boundary strictly greater than `byte_offset`,
///| or `None` if `byte_offset` is at/past the end or negative.
pub fn next_grapheme_boundary(s : String, byte_offset : Int) -> Option[Int] {
  let n = s.length()
  if byte_offset < 0 || byte_offset >= n {
    return None
  }
  let anchor = find_safe_grapheme_anchor(s, byte_offset, n)
  let first_dec = utf8_decode_packed(s, anchor, n)
  let first_p = lookup_grapheme_packed(first_dec >> 3)
  let mut prev_gcb = first_p & 15
  let mut ri_odd = prev_gcb == gcb_regional_indicator
  let mut ep_state = if ((first_p >> 4) & 1) == 1 { 1 } else { 0 }
  let mut incb_state = if ((first_p >> 5) & 3) == incb_consonant { 1 } else { 0 }
  let mut pos = anchor + (first_dec & 7)

  while pos < n {
    let dec = utf8_decode_packed(s, pos, n)
    let packed = lookup_grapheme_packed(dec >> 3)
    let curr_gcb = packed & 15
    let curr_ep = (packed >> 4) & 1
    let curr_incb = (packed >> 5) & 3
    if grapheme_should_break(prev_gcb, curr_gcb, curr_ep, curr_incb, ri_odd, ep_state, incb_state) {
      if pos > byte_offset {
        return Some(pos)
      }
    }
    ri_odd = next_ri_odd(prev_gcb, curr_gcb, ri_odd)
    ep_state = next_ep_state(ep_state, curr_gcb, curr_ep)
    incb_state = next_incb_state(incb_state, curr_incb)
    prev_gcb = curr_gcb
    pos = pos + (dec & 7)
  }
  Some(n)
}

///| Return the previous Extended Grapheme Cluster boundary strictly less than `byte_offset`,
///| or `None` if `byte_offset <= 0` or `byte_offset > s.length()`.
pub fn prev_grapheme_boundary(s : String, byte_offset : Int) -> Option[Int] {
  let n = s.length()
  if byte_offset <= 0 || byte_offset > n {
    return None
  }
  let anchor = find_safe_grapheme_anchor(s, byte_offset - 1, n)
  let first_dec = utf8_decode_packed(s, anchor, n)
  let first_p = lookup_grapheme_packed(first_dec >> 3)
  let mut prev_gcb = first_p & 15
  let mut ri_odd = prev_gcb == gcb_regional_indicator
  let mut ep_state = if ((first_p >> 4) & 1) == 1 { 1 } else { 0 }
  let mut incb_state = if ((first_p >> 5) & 3) == incb_consonant { 1 } else { 0 }
  let mut last_brk = anchor
  let mut pos = anchor + (first_dec & 7)

  while pos < byte_offset && pos < n {
    let dec = utf8_decode_packed(s, pos, n)
    let packed = lookup_grapheme_packed(dec >> 3)
    let curr_gcb = packed & 15
    let curr_ep = (packed >> 4) & 1
    let curr_incb = (packed >> 5) & 3
    if grapheme_should_break(prev_gcb, curr_gcb, curr_ep, curr_incb, ri_odd, ep_state, incb_state) {
      last_brk = pos
    }
    ri_odd = next_ri_odd(prev_gcb, curr_gcb, ri_odd)
    ep_state = next_ep_state(ep_state, curr_gcb, curr_ep)
    incb_state = next_incb_state(incb_state, curr_incb)
    prev_gcb = curr_gcb
    pos = pos + (dec & 7)
  }
  Some(last_brk)
}
