///| Public value types, limits, and error definitions for `packages/unicode_segment`.
///| Pure Pion, zero external dependencies, zero `World`, zero `extern "C"`.

///| Unicode version of the embedded UAX #29 tables (`16.0.0`).
pub fn unicode_version() -> (Int, Int, Int) {
  (16, 0, 0)
}

///| Half-open UTF-8 byte span `[start, end)` into the segmented input string.
pub val struct SegmentSpan {
  pub start : Int
  pub end : Int
}

pub fn SegmentSpan::new(start : Int, end : Int) -> SegmentSpan {
  SegmentSpan::{ start: start, end: end }
}

pub fn SegmentSpan::len(self : SegmentSpan) -> Int {
  self.end - self.start
}

pub fn SegmentSpan::is_empty(self : SegmentSpan) -> Bool {
  self.start >= self.end
}

pub fn SegmentSpan::eq(self : SegmentSpan, other : SegmentSpan) -> Bool {
  self.start == other.start && self.end == other.end
}

pub fn SegmentSpan::to_string(self : SegmentSpan) -> String {
  self.start.to_string() + ".." + self.end.to_string()
}

///| Error returned by `*_with_limits` segmentation APIs when input or output limits are exceeded.
pub enum SegmentError {
  LimitExceeded
}

pub fn SegmentError::to_string(self : SegmentError) -> String {
  match self {
    SegmentError::LimitExceeded => "LimitExceeded"
  }
}

pub fn SegmentError::eq(self : SegmentError, other : SegmentError) -> Bool {
  match self {
    SegmentError::LimitExceeded => {
      match other {
        SegmentError::LimitExceeded => true
      }
    }
  }
}

///| Resource limits protecting against oversized inputs or excessive segment allocations.
///| Any negative limit fails immediately with `Err(SegmentError::LimitExceeded)`; `0` is enforced strictly.
pub val struct SegmentLimits {
  pub max_input_bytes : Int
  pub max_segments : Int
}

pub fn SegmentLimits::new(max_input_bytes : Int, max_segments : Int) -> SegmentLimits {
  SegmentLimits::{ max_input_bytes: max_input_bytes, max_segments: max_segments }
}

pub fn SegmentLimits::default() -> SegmentLimits {
  SegmentLimits::{ max_input_bytes: 16777216, max_segments: 4194304 }
}

///| Validate limits against input byte length before scanning.
fn check_input_limits(s : String, limits : SegmentLimits) -> Result[Unit, SegmentError] {
  if limits.max_input_bytes < 0 || limits.max_segments < 0 {
    return Err(SegmentError::LimitExceeded)
  }
  if s.length() > limits.max_input_bytes {
    return Err(SegmentError::LimitExceeded)
  }
  Ok(())
}
