///| Zero-allocation UTF-8 decoding and safe byte-span slicing helpers.

///| Decode the UTF-8 scalar value at byte offset `pos`.
///| Returns packed `(codepoint << 3) | byte_len`.
///| Invalid, overlong, surrogate, or truncated byte sequences decode as `U+FFFD` consuming 1 byte.
fn utf8_decode_packed(s : String, pos : Int, n : Int) -> Int {
  if pos < 0 || pos >= n {
    return 0
  }
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0 << 3) | 1
  }
  if b0 >= 0xC2 && b0 <= 0xDF {
    if pos + 1 < n {
      let b1 = s.code_unit_at(pos + 1)
      if (b1 & 0xC0) == 0x80 {
        return ((((b0 & 0x1F) << 6) | (b1 & 0x3F)) << 3) | 2
      }
    }
    return (0xFFFD << 3) | 1
  }
  if b0 >= 0xE0 && b0 <= 0xEF {
    if pos + 2 < n {
      let b1 = s.code_unit_at(pos + 1)
      let b2 = s.code_unit_at(pos + 2)
      if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
        if (b0 != 0xE0 || b1 >= 0xA0) && (b0 != 0xED || b1 < 0xA0) {
          let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
          return (cp << 3) | 3
        }
      }
    }
    return (0xFFFD << 3) | 1
  }
  if b0 >= 0xF0 && b0 <= 0xF4 {
    if pos + 3 < n {
      let b1 = s.code_unit_at(pos + 1)
      let b2 = s.code_unit_at(pos + 2)
      let b3 = s.code_unit_at(pos + 3)
      if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
        if (b0 != 0xF0 || b1 >= 0x90) && (b0 != 0xF4 || b1 <= 0x8F) {
          let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
          return (cp << 3) | 4
        }
      }
    }
    return (0xFFFD << 3) | 1
  }
  (0xFFFD << 3) | 1
}

///| Extract the substring for a UTF-8 byte span `[start, end)` clamped to `[0, s.length()]`.
pub fn slice_span(s : String, span : SegmentSpan) -> String {
  let n = s.length()
  let start = if span.start < 0 { 0 } else if span.start > n { n } else { span.start }
  let end = if span.end < start { start } else if span.end > n { n } else { span.end }
  if start == 0 && end == n {
    return s
  }
  if start >= end {
    return ""
  }
  s.slice(start, end)
}

///| Decode a non-ASCII UTF-8 scalar value at `pos` where `b0 = s.code_unit_at(pos) >= 0x80`.
///| Returns packed `(codepoint << 3) | byte_len`. Invalid sequences decode as `(0xFFFD << 3) | 1`.
fn utf8_decode_non_ascii(s : String, pos : Int, n : Int, b0 : Int) -> Int {
  if b0 >= 0xC2 && b0 <= 0xDF {
    if pos + 1 < n {
      let b1 = s.code_unit_at(pos + 1)
      if (b1 & 0xC0) == 0x80 {
        return ((((b0 & 0x1F) << 6) | (b1 & 0x3F)) << 3) | 2
      }
    }
    return (0xFFFD << 3) | 1
  }
  if b0 >= 0xE0 && b0 <= 0xEF {
    if pos + 2 < n {
      let b1 = s.code_unit_at(pos + 1)
      let b2 = s.code_unit_at(pos + 2)
      if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
        if (b0 != 0xE0 || b1 >= 0xA0) && (b0 != 0xED || b1 < 0xA0) {
          let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
          return (cp << 3) | 3
        }
      }
    }
    return (0xFFFD << 3) | 1
  }
  if b0 >= 0xF0 && b0 <= 0xF4 {
    if pos + 3 < n {
      let b1 = s.code_unit_at(pos + 1)
      let b2 = s.code_unit_at(pos + 2)
      let b3 = s.code_unit_at(pos + 3)
      if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
        if (b0 != 0xF0 || b1 >= 0x90) && (b0 != 0xF4 || b1 <= 0x8F) {
          let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
          return (cp << 3) | 4
        }
      }
    }
    return (0xFFFD << 3) | 1
  }
  (0xFFFD << 3) | 1
}

///| Materialize an array of byte spans into string slices.
fn spans_to_strings(s : String, spans : Array[SegmentSpan]) -> Array[String] {
  let n = spans.length()
  let out : Array[String] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    out.push(slice_span(s, spans[i]))
    i = i + 1
  }
  out
}
