///| UAX #29 §5.1 Sentence Boundary segmentation (Unicode 16.0.0, SB1–SB11 + SB998).
///| Strict O(n) single-pass DFA with monotonic memoized SB8 lookahead; zero `FixedArray`, zero mutable globals.

fn sb_is_parasep(sb : Int) -> Bool {
  sb == sb_sep || sb == sb_cr || sb == sb_lf
}

fn sb_is_ignorable(sb : Int) -> Bool {
  sb == sb_extend || sb == sb_format
}

fn sb_is_saterm(sb : Int) -> Bool {
  sb == sb_sterm || sb == sb_aterm
}

///| True if `sb` terminates the SB8 `(¬(OLetter | Upper | Lower | ParaSep | SATerm))*` class.
fn sb8_is_stopper(sb : Int) -> Bool {
  sb == sb_oletter || sb == sb_upper || sb == sb_lower || sb_is_parasep(sb) || sb_is_saterm(sb)
}

///| Sentence DFA states (ignoring Extend | Format per SB5):
///|   0 = Normal
///|   1 = UpperOrLower
///|   2 = ATerm (not preceded by Upper|Lower)
///|   3 = UL_ATerm ((Upper|Lower) ATerm)
///|   4 = ATerm_Close (ATerm Close+)
///|   5 = ATerm_Sp (ATerm Close* Sp+)
///|   6 = STerm
///|   7 = STerm_Close (STerm Close+)
///|   8 = STerm_Sp (STerm Close* Sp+)
fn sb_next_state(st : Int, curr_sb : Int) -> Int {
  if curr_sb == sb_upper || curr_sb == sb_lower {
    1
  } else if curr_sb == sb_aterm {
    if st == 1 {
      3
    } else {
      2
    }
  } else if curr_sb == sb_sterm {
    6
  } else if curr_sb == sb_close {
    if st == 2 || st == 3 || st == 4 {
      4
    } else if st == 6 || st == 7 {
      7
    } else {
      0
    }
  } else if curr_sb == sb_sp {
    if st == 2 || st == 3 || st == 4 || st == 5 {
      5
    } else if st == 6 || st == 7 || st == 8 {
      8
    } else {
      0
    }
  } else {
    0
  }
}

///| Core Sentence Boundary scanner with optional resource limits.
fn sentence_bounds_core(
  s : String,
  check_limits : Bool,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  if check_limits {
    match check_input_limits(s, limits) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  let n = s.length()
  let out : Array[SegmentSpan] = Array::new()
  if n == 0 {
    return Ok(out)
  }
  if check_limits && limits.max_segments == 0 {
    return Err(SegmentError::LimitExceeded)
  }

  let first_dec = utf8_decode_packed(s, 0, n)
  let first_sb = lookup_sentence_prop(first_dec >> 3)
  let mut prev_raw = first_sb
  let mut st = sb_next_state(0, first_sb)

  // Monotonic cache for SB8 lookahead: guarantees strict O(n) total work.
  let mut sb8_scan_end = -1
  let mut sb8_scan_is_lower = false

  let mut seg_start = 0
  let mut pos = first_dec & 7

  while pos < n {
    let dec = utf8_decode_packed(s, pos, n)
    let clen = dec & 7
    let curr_sb = lookup_sentence_prop(dec >> 3)

    let mut brk = false
    let mut is_sb5_ignored = false

    // SB3: CR x LF
    if prev_raw == sb_cr && curr_sb == sb_lf {
      brk = false
    } else if sb_is_parasep(prev_raw) {
      // SB4: ParaSep ÷
      brk = true
    } else if sb_is_ignorable(curr_sb) {
      // SB5: X (Extend | Format)* -> X
      brk = false
      is_sb5_ignored = true
    } else if (st == 2 || st == 3) && curr_sb == sb_numeric {
      // SB6: ATerm x Numeric
      brk = false
    } else if st == 3 && curr_sb == sb_upper {
      // SB7: (Upper | Lower) ATerm x Upper
      brk = false
    } else if st >= 2 && st <= 8 {
      // In SATerm Close* Sp*
      let is_aterm_family = st <= 5
      let is_before_sp = st == 2 || st == 3 || st == 4 || st == 6 || st == 7

      // SB8: ATerm Close* Sp* x (¬(OLetter | Upper | Lower | ParaSep | SATerm))* Lower
      let mut matched_sb8 = false
      if is_aterm_family {
        if curr_sb == sb_lower {
          matched_sb8 = true
        } else if !sb8_is_stopper(curr_sb) {
          if pos < sb8_scan_end {
            matched_sb8 = sb8_scan_is_lower
          } else {
            let mut p = pos + clen
            let mut found_lower = false
            while p < n {
              let pdec = utf8_decode_packed(s, p, n)
              let psb = lookup_sentence_prop(pdec >> 3)
              if sb8_is_stopper(psb) {
                found_lower = psb == sb_lower
                break
              }
              p = p + (pdec & 7)
            }
            sb8_scan_end = p
            sb8_scan_is_lower = found_lower
            matched_sb8 = found_lower
          }
        }
      }

      if matched_sb8 {
        brk = false
      } else if curr_sb == sb_scontinue || sb_is_saterm(curr_sb) {
        // SB8a: SATerm Close* Sp* x (SContinue | SATerm)
        brk = false
      } else if is_before_sp && (curr_sb == sb_close || curr_sb == sb_sp || sb_is_parasep(curr_sb)) {
        // SB9: SATerm Close* x (Close | Sp | ParaSep)
        brk = false
      } else if curr_sb == sb_sp || sb_is_parasep(curr_sb) {
        // SB10: SATerm Close* Sp* x (Sp | ParaSep)
        brk = false
      } else {
        // SB11: SATerm Close* Sp* ParaSep? ÷
        brk = true
      }
    } else {
      // SB998: Any x Any
      brk = false
    }

    if brk {
      if check_limits && out.length() + 1 >= limits.max_segments {
        return Err(SegmentError::LimitExceeded)
      }
      out.push(SegmentSpan::new(seg_start, pos))
      seg_start = pos
      st = sb_next_state(0, curr_sb)
    } else if !is_sb5_ignored {
      st = sb_next_state(st, curr_sb)
    }

    prev_raw = curr_sb
    pos = pos + clen
  }

  out.push(SegmentSpan::new(seg_start, n))
  Ok(out)
}

///| Compute UAX #29 Sentence Boundary byte spans with explicit resource limits.
pub fn sentence_bounds_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  sentence_bounds_core(s, true, limits)
}

///| Compute UAX #29 Sentence Boundary byte spans for `s`.
pub fn sentence_bounds(s : String) -> Array[SegmentSpan] {
  match sentence_bounds_core(s, false, SegmentLimits::default()) {
    Ok(v) => v
    Err(_) => []
  }
}

///| Split `s` into UAX #29 sentences with explicit resource limits.
pub fn sentences_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[String], SegmentError] {
  match sentence_bounds_with_limits(s, limits) {
    Ok(spans) => Ok(spans_to_strings(s, spans))
    Err(e) => Err(e)
  }
}

///| Split `s` into UAX #29 sentences.
pub fn sentences(s : String) -> Array[String] {
  spans_to_strings(s, sentence_bounds(s))
}
