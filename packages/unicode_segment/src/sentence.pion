///| UAX #29 §5.1 Sentence Boundary segmentation (Unicode 16.0.0, SB1–SB11 + SB998).
///| Strict O(n) single-pass DFA with monotonic memoized SB8 lookahead; zero `FixedArray`, zero mutable globals.

fn sb_is_parasep(sb : Int) -> Bool {
  sb == sb_sep || sb == sb_cr || sb == sb_lf
}

fn sb_is_ignorable(sb : Int) -> Bool {
  sb == sb_extend || sb == sb_format
}

fn sb_is_saterm(sb : Int) -> Bool {
  sb == sb_sterm || sb == sb_aterm
}

///| True if `sb` terminates the SB8 `(¬(OLetter | Upper | Lower | ParaSep | SATerm))*` class.
fn sb8_is_stopper(sb : Int) -> Bool {
  sb == sb_oletter || sb == sb_upper || sb == sb_lower || sb_is_parasep(sb) || sb_is_saterm(sb)
}

///| Sentence DFA states (ignoring Extend | Format per SB5):
///|   0 = Normal
///|   1 = UpperOrLower
///|   2 = ATerm (not preceded by Upper|Lower)
///|   3 = UL_ATerm ((Upper|Lower) ATerm)
///|   4 = ATerm_Close (ATerm Close+)
///|   5 = ATerm_Sp (ATerm Close* Sp+)
///|   6 = STerm
///|   7 = STerm_Close (STerm Close+)
///|   8 = STerm_Sp (STerm Close* Sp+)
fn sb_next_state(st : Int, curr_sb : Int) -> Int {
  if curr_sb == sb_upper || curr_sb == sb_lower {
    1
  } else if curr_sb == sb_aterm {
    if st == 1 {
      3
    } else {
      2
    }
  } else if curr_sb == sb_sterm {
    6
  } else if curr_sb == sb_close {
    if st == 2 || st == 3 || st == 4 {
      4
    } else if st == 6 || st == 7 {
      7
    } else {
      0
    }
  } else if curr_sb == sb_sp {
    if st == 2 || st == 3 || st == 4 || st == 5 {
      5
    } else if st == 6 || st == 7 || st == 8 {
      8
    } else {
      0
    }
  } else {
    0
  }
}

///| Fast no-limits Sentence Boundary scanner.
pub fn sentence_bounds(s : String) -> Array[SegmentSpan] {
  let n = s.length()
  if n == 0 {
    return Array::new()
  }

  let est = (n >> 5) + 8
  let cap = if est > 16384 { 16384 } else { est }
  let out : Array[SegmentSpan] = Array::with_capacity(cap)
  let tbl = table_blob

  let b_first = s.code_unit_at(0)
  let mut first_sb = 0
  let mut pos = 1
  if b_first < 128 {
    first_sb = tbl.code_unit_at(off_s_ascii + b_first) - 35
  } else {
    let first_dec = utf8_decode_non_ascii(s, 0, n, b_first)
    let first_cp = first_dec >> 3
    pos = first_dec & 7
    first_sb = if pos == 1 {
      0
    } else if pos <= 3 {
      let page = tbl.code_unit_at(off_s_bmp_idx + (first_cp >> 8)) - 35
      tbl.code_unit_at(off_s_bmp_data + ((page << 8) | (first_cp & 255))) - 35
    } else {
      lookup_smp(tbl, first_cp, off_s_smp, s_smp_count)
    }
  }
  let mut prev_raw = first_sb
  let mut st = sb_next_state(0, first_sb)

  // Monotonic cache for SB8 lookahead: guarantees strict O(n) total work.
  let mut sb8_scan_end = -1
  let mut sb8_scan_is_lower = false

  let mut seg_start = 0

  while pos < n {
    // Tight ASCII inner loop when not after ParaSep or SATerm
    if st <= 1 && !sb_is_parasep(prev_raw) {
      while pos < n {
        let b = s.code_unit_at(pos)
        if b >= 128 || b == 46 || b == 33 || b == 63 || b == 10 || b == 13 {
          break
        }
        if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) {
          st = 1
        } else {
          st = 0
        }
        prev_raw = 0
        pos = pos + 1
      }
      if pos >= n {
        break
      }
    }

    let b0 = s.code_unit_at(pos)
    let mut clen = 1
    let mut curr_sb = 0
    if b0 < 128 {
      curr_sb = tbl.code_unit_at(off_s_ascii + b0) - 35
    } else {
      let dec = utf8_decode_non_ascii(s, pos, n, b0)
      let cp = dec >> 3
      clen = dec & 7
      curr_sb = if clen == 1 {
        0
      } else if clen <= 3 {
        let page = tbl.code_unit_at(off_s_bmp_idx + (cp >> 8)) - 35
        tbl.code_unit_at(off_s_bmp_data + ((page << 8) | (cp & 255))) - 35
      } else {
        lookup_smp(tbl, cp, off_s_smp, s_smp_count)
      }
      if st <= 1 && !sb_is_parasep(prev_raw) &&
      curr_sb != sb_aterm && curr_sb != sb_sterm && !sb_is_parasep(curr_sb) {
        if !sb_is_ignorable(curr_sb) {
          st = if curr_sb == sb_upper || curr_sb == sb_lower { 1 } else { 0 }
        }
        prev_raw = curr_sb
        pos = pos + clen
        continue
      }
    }

    let mut brk = false
    let mut is_sb5_ignored = false

    // SB3: CR x LF
    if prev_raw == sb_cr && curr_sb == sb_lf {
      brk = false
    } else if sb_is_parasep(prev_raw) {
      // SB4: ParaSep ÷
      brk = true
    } else if sb_is_ignorable(curr_sb) {
      // SB5: X (Extend | Format)* -> X
      brk = false
      is_sb5_ignored = true
    } else if (st == 2 || st == 3) && curr_sb == sb_numeric {
      // SB6: ATerm x Numeric
      brk = false
    } else if st == 3 && curr_sb == sb_upper {
      // SB7: (Upper | Lower) ATerm x Upper
      brk = false
    } else if st >= 2 && st <= 8 {
      // In SATerm Close* Sp*
      let is_aterm_family = st <= 5
      let is_before_sp = st == 2 || st == 3 || st == 4 || st == 6 || st == 7

      // SB8: ATerm Close* Sp* x (¬(OLetter | Upper | Lower | ParaSep | SATerm))* Lower
      let mut matched_sb8 = false
      if is_aterm_family {
        if curr_sb == sb_lower {
          matched_sb8 = true
        } else if !sb8_is_stopper(curr_sb) {
          if pos < sb8_scan_end {
            matched_sb8 = sb8_scan_is_lower
          } else {
            let mut p = pos + clen
            let mut found_lower = false
            while p < n {
              let pb = s.code_unit_at(p)
              let mut psb = 0
              let mut pclen = 1
              if pb < 128 {
                psb = tbl.code_unit_at(off_s_ascii + pb) - 35
              } else {
                let pdec = utf8_decode_non_ascii(s, p, n, pb)
                let pcp = pdec >> 3
                pclen = pdec & 7
                psb = if pclen == 1 {
                  0
                } else if pclen <= 3 {
                  let page = tbl.code_unit_at(off_s_bmp_idx + (pcp >> 8)) - 35
                  tbl.code_unit_at(off_s_bmp_data + ((page << 8) | (pcp & 255))) - 35
                } else {
                  lookup_smp(tbl, pcp, off_s_smp, s_smp_count)
                }
              }
              if sb8_is_stopper(psb) {
                found_lower = psb == sb_lower
                break
              }
              p = p + pclen
            }
            sb8_scan_end = p
            sb8_scan_is_lower = found_lower
            matched_sb8 = found_lower
          }
        }
      }

      if matched_sb8 {
        brk = false
      } else if curr_sb == sb_scontinue || sb_is_saterm(curr_sb) {
        // SB8a: SATerm Close* Sp* x (SContinue | SATerm)
        brk = false
      } else if is_before_sp && (curr_sb == sb_close || curr_sb == sb_sp || sb_is_parasep(curr_sb)) {
        // SB9: SATerm Close* x (Close | Sp | ParaSep)
        brk = false
      } else if curr_sb == sb_sp || sb_is_parasep(curr_sb) {
        // SB10: SATerm Close* Sp* x (Sp | ParaSep)
        brk = false
      } else {
        // SB11: SATerm Close* Sp* ParaSep? ÷
        brk = true
      }
    } else {
      // SB998: Any x Any
      brk = false
    }

    if brk {
      out.push(SegmentSpan::{ start: seg_start, end: pos })
      seg_start = pos
      st = sb_next_state(0, curr_sb)
    } else if !is_sb5_ignored {
      st = sb_next_state(st, curr_sb)
    }

    prev_raw = curr_sb
    pos = pos + clen
  }

  out.push(SegmentSpan::{ start: seg_start, end: n })
  out
}

///| Compute UAX #29 Sentence Boundary byte spans with explicit resource limits.
pub fn sentence_bounds_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  match check_input_limits(s, limits) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let n = s.length()
  if n == 0 {
    return Ok(Array::new())
  }
  if limits.max_segments == 0 {
    return Err(SegmentError::LimitExceeded)
  }

  let est = (n >> 5) + 8
  let cap0 = if est < limits.max_segments { est } else { limits.max_segments }
  let cap = if cap0 > 16384 { 16384 } else { cap0 }
  let out : Array[SegmentSpan] = Array::with_capacity(cap)
  let tbl = table_blob
  let max_seg = limits.max_segments

  let b_first = s.code_unit_at(0)
  let mut first_sb = 0
  let mut pos = 1
  if b_first < 128 {
    first_sb = tbl.code_unit_at(off_s_ascii + b_first) - 35
  } else {
    let first_dec = utf8_decode_non_ascii(s, 0, n, b_first)
    let first_cp = first_dec >> 3
    pos = first_dec & 7
    first_sb = if pos == 1 {
      0
    } else if pos <= 3 {
      let page = tbl.code_unit_at(off_s_bmp_idx + (first_cp >> 8)) - 35
      tbl.code_unit_at(off_s_bmp_data + ((page << 8) | (first_cp & 255))) - 35
    } else {
      lookup_smp(tbl, first_cp, off_s_smp, s_smp_count)
    }
  }
  let mut prev_raw = first_sb
  let mut st = sb_next_state(0, first_sb)

  // Monotonic cache for SB8 lookahead: guarantees strict O(n) total work.
  let mut sb8_scan_end = -1
  let mut sb8_scan_is_lower = false

  let mut seg_start = 0

  while pos < n {
    if st <= 1 && !sb_is_parasep(prev_raw) {
      while pos < n {
        let b = s.code_unit_at(pos)
        if b >= 128 || b == 46 || b == 33 || b == 63 || b == 10 || b == 13 {
          break
        }
        if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) {
          st = 1
        } else {
          st = 0
        }
        prev_raw = 0
        pos = pos + 1
      }
      if pos >= n {
        break
      }
    }

    let b0 = s.code_unit_at(pos)
    let mut clen = 1
    let mut curr_sb = 0
    if b0 < 128 {
      curr_sb = tbl.code_unit_at(off_s_ascii + b0) - 35
    } else {
      let dec = utf8_decode_non_ascii(s, pos, n, b0)
      let cp = dec >> 3
      clen = dec & 7
      curr_sb = if clen == 1 {
        0
      } else if clen <= 3 {
        let page = tbl.code_unit_at(off_s_bmp_idx + (cp >> 8)) - 35
        tbl.code_unit_at(off_s_bmp_data + ((page << 8) | (cp & 255))) - 35
      } else {
        lookup_smp(tbl, cp, off_s_smp, s_smp_count)
      }
      if st <= 1 && !sb_is_parasep(prev_raw) &&
      curr_sb != sb_aterm && curr_sb != sb_sterm && !sb_is_parasep(curr_sb) {
        if !sb_is_ignorable(curr_sb) {
          st = if curr_sb == sb_upper || curr_sb == sb_lower { 1 } else { 0 }
        }
        prev_raw = curr_sb
        pos = pos + clen
        continue
      }
    }

    let mut brk = false
    let mut is_sb5_ignored = false

    // SB3: CR x LF
    if prev_raw == sb_cr && curr_sb == sb_lf {
      brk = false
    } else if sb_is_parasep(prev_raw) {
      // SB4: ParaSep ÷
      brk = true
    } else if sb_is_ignorable(curr_sb) {
      // SB5: X (Extend | Format)* -> X
      brk = false
      is_sb5_ignored = true
    } else if (st == 2 || st == 3) && curr_sb == sb_numeric {
      // SB6: ATerm x Numeric
      brk = false
    } else if st == 3 && curr_sb == sb_upper {
      // SB7: (Upper | Lower) ATerm x Upper
      brk = false
    } else if st >= 2 && st <= 8 {
      // In SATerm Close* Sp*
      let is_aterm_family = st <= 5
      let is_before_sp = st == 2 || st == 3 || st == 4 || st == 6 || st == 7

      // SB8: ATerm Close* Sp* x (¬(OLetter | Upper | Lower | ParaSep | SATerm))* Lower
      let mut matched_sb8 = false
      if is_aterm_family {
        if curr_sb == sb_lower {
          matched_sb8 = true
        } else if !sb8_is_stopper(curr_sb) {
          if pos < sb8_scan_end {
            matched_sb8 = sb8_scan_is_lower
          } else {
            let mut p = pos + clen
            let mut found_lower = false
            while p < n {
              let pb = s.code_unit_at(p)
              let mut psb = 0
              let mut pclen = 1
              if pb < 128 {
                psb = tbl.code_unit_at(off_s_ascii + pb) - 35
              } else {
                let pdec = utf8_decode_non_ascii(s, p, n, pb)
                let pcp = pdec >> 3
                pclen = pdec & 7
                psb = if pclen == 1 {
                  0
                } else if pclen <= 3 {
                  let page = tbl.code_unit_at(off_s_bmp_idx + (pcp >> 8)) - 35
                  tbl.code_unit_at(off_s_bmp_data + ((page << 8) | (pcp & 255))) - 35
                } else {
                  lookup_smp(tbl, pcp, off_s_smp, s_smp_count)
                }
              }
              if sb8_is_stopper(psb) {
                found_lower = psb == sb_lower
                break
              }
              p = p + pclen
            }
            sb8_scan_end = p
            sb8_scan_is_lower = found_lower
            matched_sb8 = found_lower
          }
        }
      }

      if matched_sb8 {
        brk = false
      } else if curr_sb == sb_scontinue || sb_is_saterm(curr_sb) {
        // SB8a: SATerm Close* Sp* x (SContinue | SATerm)
        brk = false
      } else if is_before_sp && (curr_sb == sb_close || curr_sb == sb_sp || sb_is_parasep(curr_sb)) {
        // SB9: SATerm Close* x (Close | Sp | ParaSep)
        brk = false
      } else if curr_sb == sb_sp || sb_is_parasep(curr_sb) {
        // SB10: SATerm Close* Sp* x (Sp | ParaSep)
        brk = false
      } else {
        // SB11: SATerm Close* Sp* ParaSep? ÷
        brk = true
      }
    } else {
      // SB998: Any x Any
      brk = false
    }

    if brk {
      if out.length() + 1 >= max_seg {
        return Err(SegmentError::LimitExceeded)
      }
      out.push(SegmentSpan::{ start: seg_start, end: pos })
      seg_start = pos
      st = sb_next_state(0, curr_sb)
    } else if !is_sb5_ignored {
      st = sb_next_state(st, curr_sb)
    }

    prev_raw = curr_sb
    pos = pos + clen
  }

  out.push(SegmentSpan::{ start: seg_start, end: n })
  Ok(out)
}

///| Split `s` into UAX #29 sentences with explicit resource limits.
pub fn sentences_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[String], SegmentError] {
  match sentence_bounds_with_limits(s, limits) {
    Ok(spans) => Ok(spans_to_strings(s, spans))
    Err(e) => Err(e)
  }
}

///| Split `s` into UAX #29 sentences.
pub fn sentences(s : String) -> Array[String] {
  spans_to_strings(s, sentence_bounds(s))
}
