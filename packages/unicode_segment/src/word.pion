///| UAX #29 §4.1 Word Boundary segmentation (Unicode 16.0.0, WB1–WB999).
///| Strict O(n) single-pass with bounded non-overlapping lookahead; zero `FixedArray`, zero mutable globals.

fn wb_is_newline(wb : Int) -> Bool {
  wb == wb_newline || wb == wb_cr || wb == wb_lf
}

fn wb_is_ignorable(wb : Int) -> Bool {
  wb == wb_extend || wb == wb_format || wb == wb_zwj
}

fn wb_is_ahletter(wb : Int) -> Bool {
  wb == wb_aletter || wb == wb_hebrew_letter
}

fn wb_is_midnumletq(wb : Int) -> Bool {
  wb == wb_midnumlet || wb == wb_single_quote
}

///| Peek the next codepoint's WB class after skipping any `(Extend | Format | ZWJ)*` starting at `start`.
///| Returns `-1` at end of string.
///| Because this is only called from non-ignorable mid-punctuation (`MidLetter`/`MidNumLetQ`/`Double_Quote`/`MidNum`),
///| each ignorable byte is scanned at most once across the entire input (strict O(n)).
fn wb_peek_next_non_ignored_tbl(s : String, start : Int, n : Int, tbl : String) -> Int {
  let mut p = start
  while p < n {
    let b0 = s.code_unit_at(p)
    if b0 < 128 {
      let cid = tbl.code_unit_at(off_w_ascii + b0) - 35
      return tbl.code_unit_at(off_w_c2wb + cid) - 35
    }
    let dec = utf8_decode_non_ascii(s, p, n, b0)
    let cp = dec >> 3
    let clen = dec & 7
    let cid = if clen == 1 {
      0
    } else if clen <= 3 {
      let page = tbl.code_unit_at(off_w_bmp_idx + (cp >> 8)) - 35
      tbl.code_unit_at(off_w_bmp_data + ((page << 8) | (cp & 255))) - 35
    } else {
      lookup_smp(tbl, cp, off_w_smp, w_smp_count)
    }
    let wb = tbl.code_unit_at(off_w_c2wb + cid) - 35
    if !wb_is_ignorable(wb) {
      return wb
    }
    p = p + clen
  }
  -1
}

struct WbSlowCtx {
  mut prev_raw : Int
  mut eff_prev : Int
  mut eff_prev2 : Int
  mut ri_odd : Bool
  mut seg_start : Int
  mut seg_has_alnum : Bool
}

///| Outlined cold-path UAX #29 WB3-WB16 step so the fast scanner stays small and register-resident.
fn wb_slow_step(
  ctx : WbSlowCtx,
  s : String,
  n : Int,
  pos : Int,
  clen : Int,
  curr_wb : Int,
  curr_ep : Int,
  curr_alnum : Bool,
  tbl : String,
  alnum_only : Bool,
  out : Array[SegmentSpan],
) -> Unit {
  let prev_raw = ctx.prev_raw
  let eff_prev = ctx.eff_prev
  let eff_prev2 = ctx.eff_prev2
  let ri_odd = ctx.ri_odd

  let mut brk = true
  let mut is_wb4_ignored = false

  // WB3: CR x LF
  if prev_raw == wb_cr && curr_wb == wb_lf {
    brk = false
  } else if wb_is_newline(prev_raw) {
    // WB3a: (Newline | CR | LF) ÷
    brk = true
  } else if wb_is_newline(curr_wb) {
    // WB3b: ÷ (Newline | CR | LF)
    brk = true
  } else if prev_raw == wb_zwj && curr_ep == 1 {
    // WB3c: ZWJ x \p{Extended_Pictographic}
    brk = false
  } else if prev_raw == wb_wsegspace && curr_wb == wb_wsegspace {
    // WB3d: WSegSpace x WSegSpace
    brk = false
  } else if wb_is_ignorable(curr_wb) {
    // WB4: X (Extend | Format | ZWJ)* -> X
    brk = false
    is_wb4_ignored = true
  } else if wb_is_ahletter(eff_prev) && wb_is_ahletter(curr_wb) {
    // WB5: AHLetter x AHLetter
    brk = false
  } else if wb_is_ahletter(eff_prev) &&
  (curr_wb == wb_midletter || wb_is_midnumletq(curr_wb)) &&
  wb_is_ahletter(wb_peek_next_non_ignored_tbl(s, pos + clen, n, tbl)) {
    // WB6: AHLetter x (MidLetter | MidNumLetQ) AHLetter
    brk = false
  } else if wb_is_ahletter(eff_prev2) &&
  (eff_prev == wb_midletter || wb_is_midnumletq(eff_prev)) &&
  wb_is_ahletter(curr_wb) {
    // WB7: AHLetter (MidLetter | MidNumLetQ) x AHLetter
    brk = false
  } else if eff_prev == wb_hebrew_letter && curr_wb == wb_single_quote {
    // WB7a: Hebrew_Letter x Single_Quote
    brk = false
  } else if eff_prev == wb_hebrew_letter &&
  curr_wb == wb_double_quote &&
  wb_peek_next_non_ignored_tbl(s, pos + clen, n, tbl) == wb_hebrew_letter {
    // WB7b: Hebrew_Letter x Double_Quote Hebrew_Letter
    brk = false
  } else if eff_prev2 == wb_hebrew_letter &&
  eff_prev == wb_double_quote &&
  curr_wb == wb_hebrew_letter {
    // WB7c: Hebrew_Letter Double_Quote x Hebrew_Letter
    brk = false
  } else if eff_prev == wb_numeric && curr_wb == wb_numeric {
    // WB8: Numeric x Numeric
    brk = false
  } else if wb_is_ahletter(eff_prev) && curr_wb == wb_numeric {
    // WB9: AHLetter x Numeric
    brk = false
  } else if eff_prev == wb_numeric && wb_is_ahletter(curr_wb) {
    // WB10: Numeric x AHLetter
    brk = false
  } else if eff_prev2 == wb_numeric &&
  (eff_prev == wb_midnum || wb_is_midnumletq(eff_prev)) &&
  curr_wb == wb_numeric {
    // WB11: Numeric (MidNum | MidNumLetQ) x Numeric
    brk = false
  } else if eff_prev == wb_numeric &&
  (curr_wb == wb_midnum || wb_is_midnumletq(curr_wb)) &&
  wb_peek_next_non_ignored_tbl(s, pos + clen, n, tbl) == wb_numeric {
    // WB12: Numeric x (MidNum | MidNumLetQ) Numeric
    brk = false
  } else if eff_prev == wb_katakana && curr_wb == wb_katakana {
    // WB13: Katakana x Katakana
    brk = false
  } else if (wb_is_ahletter(eff_prev) || eff_prev == wb_numeric || eff_prev == wb_katakana ||
    eff_prev == wb_extendnumlet) && curr_wb == wb_extendnumlet {
    // WB13a: (AHLetter | Numeric | Katakana | ExtendNumLet) x ExtendNumLet
    brk = false
  } else if eff_prev == wb_extendnumlet &&
  (wb_is_ahletter(curr_wb) || curr_wb == wb_numeric || curr_wb == wb_katakana) {
    // WB13b: ExtendNumLet x (AHLetter | Numeric | Katakana)
    brk = false
  } else if eff_prev == wb_regional_indicator && curr_wb == wb_regional_indicator && ri_odd {
    // WB15 / WB16: (sot | [^RI]) (RI RI)* RI x RI
    brk = false
  }

  if brk {
    if !alnum_only || ctx.seg_has_alnum {
      out.push(SegmentSpan::{ start: ctx.seg_start, end: pos })
    }
    ctx.seg_start = pos
    ctx.seg_has_alnum = curr_alnum
  } else if curr_alnum {
    ctx.seg_has_alnum = true
  }

  ctx.prev_raw = curr_wb
  if !is_wb4_ignored {
    if curr_wb == wb_regional_indicator {
      if eff_prev == wb_regional_indicator && ri_odd {
        ctx.ri_odd = false
      } else {
        ctx.ri_odd = true
      }
    } else {
      ctx.ri_odd = false
    }
    if wb_is_newline(curr_wb) {
      ctx.eff_prev2 = -1
      ctx.eff_prev = curr_wb
    } else {
      ctx.eff_prev2 = eff_prev
      ctx.eff_prev = curr_wb
    }
  }
}

///| Fast no-limits Word Boundary scanner for `word_bounds` and `unicode_word_bounds`.
fn word_bounds_fast(s : String, alnum_only : Bool) -> Array[SegmentSpan] {
  let n = s.length()
  if n == 0 {
    return Array::new()
  }

  let est = if alnum_only { n >> 2 } else { n >> 1 }
  let cap = if est > 65536 { 65536 } else if est < 16 { 16 } else { est }
  let out : Array[SegmentSpan] = Array::with_capacity(cap)
  let tbl = table_blob

  let b_first = s.code_unit_at(0)
  let mut first_wb = 0
  let mut first_alnum = false
  let mut pos = 1
  if b_first < 128 {
    let cid = tbl.code_unit_at(off_w_ascii + b_first) - 35
    first_wb = tbl.code_unit_at(off_w_c2wb + cid) - 35
    first_alnum = ((tbl.code_unit_at(off_w_c2fl + cid) - 35) & 2) != 0
  } else {
    let first_dec = utf8_decode_non_ascii(s, 0, n, b_first)
    let first_cp = first_dec >> 3
    pos = first_dec & 7
    let cid = if pos == 1 {
      0
    } else if pos <= 3 {
      let page = tbl.code_unit_at(off_w_bmp_idx + (first_cp >> 8)) - 35
      tbl.code_unit_at(off_w_bmp_data + ((page << 8) | (first_cp & 255))) - 35
    } else {
      lookup_smp(tbl, first_cp, off_w_smp, w_smp_count)
    }
    first_wb = tbl.code_unit_at(off_w_c2wb + cid) - 35
    first_alnum = ((tbl.code_unit_at(off_w_c2fl + cid) - 35) & 2) != 0
  }

  let mut prev_raw = first_wb
  let mut eff_prev = first_wb
  let mut eff_prev2 = -1
  let mut ri_odd = first_wb == wb_regional_indicator
  let mut seg_start = 0
  let mut seg_has_alnum = first_alnum

  let ctx = WbSlowCtx::{
    prev_raw: prev_raw,
    eff_prev: eff_prev,
    eff_prev2: eff_prev2,
    ri_odd: ri_odd,
    seg_start: 0,
    seg_has_alnum: first_alnum,
  }

  while pos < n {
    let b0 = s.code_unit_at(pos)
    if b0 < 128 {
      if (b0 >= 97 && b0 <= 122) || (b0 >= 65 && b0 <= 90) || (b0 >= 48 && b0 <= 57) {
        let cwb = if b0 <= 57 { wb_numeric } else { wb_aletter }
        if eff_prev == wb_wsegspace || eff_prev == wb_other || eff_prev == wb_cr ||
        eff_prev == wb_lf || eff_prev == wb_newline {
          if !alnum_only || seg_has_alnum {
            out.push(SegmentSpan::{ start: seg_start, end: pos })
          }
          seg_start = pos
          seg_has_alnum = true
          eff_prev = cwb
          pos = pos + 1
          while pos < n {
            let b = s.code_unit_at(pos)
            if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) {
              eff_prev = wb_aletter
              pos = pos + 1
            } else if b >= 48 && b <= 57 {
              eff_prev = wb_numeric
              pos = pos + 1
            } else if b == 95 {
              eff_prev = wb_extendnumlet
              pos = pos + 1
            } else {
              break
            }
          }
          prev_raw = eff_prev
          eff_prev2 = eff_prev
          ri_odd = false
          continue
        }
        if eff_prev == wb_aletter || eff_prev == wb_numeric || eff_prev == wb_extendnumlet {
          seg_has_alnum = true
          eff_prev = cwb
          pos = pos + 1
          while pos < n {
            let b = s.code_unit_at(pos)
            if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) {
              eff_prev = wb_aletter
              pos = pos + 1
            } else if b >= 48 && b <= 57 {
              eff_prev = wb_numeric
              pos = pos + 1
            } else if b == 95 {
              eff_prev = wb_extendnumlet
              pos = pos + 1
            } else {
              break
            }
          }
          prev_raw = eff_prev
          eff_prev2 = eff_prev
          ri_odd = false
          continue
        }
      } else if b0 == 32 {
        if prev_raw != wb_wsegspace {
          if !alnum_only || seg_has_alnum {
            out.push(SegmentSpan::{ start: seg_start, end: pos })
          }
          seg_start = pos
          seg_has_alnum = false
        }
        pos = pos + 1
        while pos < n && s.code_unit_at(pos) == 32 {
          pos = pos + 1
        }
        prev_raw = wb_wsegspace
        eff_prev2 = wb_wsegspace
        eff_prev = wb_wsegspace
        ri_odd = false
        continue
      } else if b0 == 10 && prev_raw != wb_cr {
        if !alnum_only || seg_has_alnum {
          out.push(SegmentSpan::{ start: seg_start, end: pos })
        }
        seg_start = pos
        seg_has_alnum = false
        prev_raw = wb_lf
        eff_prev2 = -1
        eff_prev = wb_lf
        ri_odd = false
        pos = pos + 1
        continue
      }

      let cid = tbl.code_unit_at(off_w_ascii + b0) - 35
      if cid == w_cid_other {
        if !alnum_only || seg_has_alnum {
          out.push(SegmentSpan::{ start: seg_start, end: pos })
        }
        seg_start = pos
        seg_has_alnum = false
        prev_raw = 0
        eff_prev2 = eff_prev
        eff_prev = 0
        ri_odd = false
        pos = pos + 1
        continue
      }
      let curr_wb = tbl.code_unit_at(off_w_c2wb + cid) - 35
      let curr_alnum = ((tbl.code_unit_at(off_w_c2fl + cid) - 35) & 2) != 0
      ctx.prev_raw = prev_raw
      ctx.eff_prev = eff_prev
      ctx.eff_prev2 = eff_prev2
      ctx.ri_odd = ri_odd
      ctx.seg_start = seg_start
      ctx.seg_has_alnum = seg_has_alnum
      wb_slow_step(ctx, s, n, pos, 1, curr_wb, 0, curr_alnum, tbl, alnum_only, out)
      prev_raw = ctx.prev_raw
      eff_prev = ctx.eff_prev
      eff_prev2 = ctx.eff_prev2
      ri_odd = ctx.ri_odd
      seg_start = ctx.seg_start
      seg_has_alnum = ctx.seg_has_alnum
      pos = pos + 1
      continue
    }

    let dec = utf8_decode_non_ascii(s, pos, n, b0)
    let cp = dec >> 3
    let clen = dec & 7
    let cid = if clen == 1 {
      0
    } else if clen <= 3 {
      let page = tbl.code_unit_at(off_w_bmp_idx + (cp >> 8)) - 35
      tbl.code_unit_at(off_w_bmp_data + ((page << 8) | (cp & 255))) - 35
    } else {
      lookup_smp(tbl, cp, off_w_smp, w_smp_count)
    }
    if cid <= 1 {
      if !alnum_only || seg_has_alnum {
        out.push(SegmentSpan::{ start: seg_start, end: pos })
      }
      seg_start = pos
      seg_has_alnum = cid == 1
      prev_raw = 0
      eff_prev2 = eff_prev
      eff_prev = 0
      ri_odd = false
      pos = pos + clen
      continue
    }
    if cid == w_cid_aletter_alnum {
      if eff_prev == wb_aletter || eff_prev == wb_numeric || eff_prev == wb_extendnumlet {
        seg_has_alnum = true
        prev_raw = wb_aletter
        eff_prev2 = eff_prev
        eff_prev = wb_aletter
        ri_odd = false
        pos = pos + clen
        continue
      }
      if eff_prev == wb_wsegspace || eff_prev == wb_other || eff_prev == wb_cr ||
      eff_prev == wb_lf || eff_prev == wb_newline {
        if !alnum_only || seg_has_alnum {
          out.push(SegmentSpan::{ start: seg_start, end: pos })
        }
        seg_start = pos
        seg_has_alnum = true
        prev_raw = wb_aletter
        eff_prev2 = eff_prev
        eff_prev = wb_aletter
        ri_odd = false
        pos = pos + clen
        continue
      }
    }
    if cid == w_cid_katakana_alnum {
      if eff_prev == wb_katakana || eff_prev == wb_extendnumlet {
        seg_has_alnum = true
        prev_raw = wb_katakana
        eff_prev2 = eff_prev
        eff_prev = wb_katakana
        ri_odd = false
        pos = pos + clen
        continue
      }
      if eff_prev == wb_wsegspace || eff_prev == wb_other || eff_prev == wb_cr ||
      eff_prev == wb_lf || eff_prev == wb_newline {
        if !alnum_only || seg_has_alnum {
          out.push(SegmentSpan::{ start: seg_start, end: pos })
        }
        seg_start = pos
        seg_has_alnum = true
        prev_raw = wb_katakana
        eff_prev2 = eff_prev
        eff_prev = wb_katakana
        ri_odd = false
        pos = pos + clen
        continue
      }
    }

    let curr_wb = tbl.code_unit_at(off_w_c2wb + cid) - 35
    let fl = tbl.code_unit_at(off_w_c2fl + cid) - 35
    let curr_ep = fl & 1
    let curr_alnum = (fl & 2) != 0
    ctx.prev_raw = prev_raw
    ctx.eff_prev = eff_prev
    ctx.eff_prev2 = eff_prev2
    ctx.ri_odd = ri_odd
    ctx.seg_start = seg_start
    ctx.seg_has_alnum = seg_has_alnum
    wb_slow_step(ctx, s, n, pos, clen, curr_wb, curr_ep, curr_alnum, tbl, alnum_only, out)
    prev_raw = ctx.prev_raw
    eff_prev = ctx.eff_prev
    eff_prev2 = ctx.eff_prev2
    ri_odd = ctx.ri_odd
    seg_start = ctx.seg_start
    seg_has_alnum = ctx.seg_has_alnum
    pos = pos + clen
  }

  if !alnum_only || seg_has_alnum {
    out.push(SegmentSpan::{ start: seg_start, end: n })
  }
  out
}

///| Core Word Boundary scanner with explicit resource limits.
fn word_bounds_core(
  s : String,
  alnum_only : Bool,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  match check_input_limits(s, limits) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let n = s.length()
  if n == 0 {
    return Ok(Array::new())
  }

  let est = if alnum_only { n >> 2 } else { n >> 1 }
  let cap0 = if est < limits.max_segments { est } else { limits.max_segments }
  let cap = if cap0 > 65536 { 65536 } else { cap0 }
  let out : Array[SegmentSpan] = Array::with_capacity(cap)
  let tbl = table_blob
  let max_seg = limits.max_segments

  let b_first = s.code_unit_at(0)
  let mut first_wb = 0
  let mut first_alnum = false
  let mut pos = 1
  if b_first < 128 {
    let cid = tbl.code_unit_at(off_w_ascii + b_first) - 35
    first_wb = tbl.code_unit_at(off_w_c2wb + cid) - 35
    first_alnum = ((tbl.code_unit_at(off_w_c2fl + cid) - 35) & 2) != 0
  } else {
    let first_dec = utf8_decode_non_ascii(s, 0, n, b_first)
    let first_cp = first_dec >> 3
    pos = first_dec & 7
    let cid = if pos == 1 {
      0
    } else if pos <= 3 {
      let page = tbl.code_unit_at(off_w_bmp_idx + (first_cp >> 8)) - 35
      tbl.code_unit_at(off_w_bmp_data + ((page << 8) | (first_cp & 255))) - 35
    } else {
      lookup_smp(tbl, first_cp, off_w_smp, w_smp_count)
    }
    first_wb = tbl.code_unit_at(off_w_c2wb + cid) - 35
    first_alnum = ((tbl.code_unit_at(off_w_c2fl + cid) - 35) & 2) != 0
  }

  let mut prev_raw = first_wb
  let mut eff_prev = first_wb
  let mut eff_prev2 = -1
  let mut ri_odd = first_wb == wb_regional_indicator

  let mut seg_start = 0
  let mut seg_has_alnum = first_alnum

  while pos < n {
    if eff_prev == wb_aletter || eff_prev == wb_numeric || eff_prev == wb_extendnumlet {
      let mut advanced = false
      while pos < n {
        let b = s.code_unit_at(pos)
        if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) {
          eff_prev = wb_aletter
          seg_has_alnum = true
          pos = pos + 1
          advanced = true
        } else if b >= 48 && b <= 57 {
          eff_prev = wb_numeric
          seg_has_alnum = true
          pos = pos + 1
          advanced = true
        } else if b == 95 {
          eff_prev = wb_extendnumlet
          pos = pos + 1
          advanced = true
        } else {
          break
        }
      }
      if advanced {
        prev_raw = eff_prev
        eff_prev2 = eff_prev
        ri_odd = false
        if pos >= n {
          break
        }
      }
    } else if prev_raw == wb_wsegspace {
      while pos < n && s.code_unit_at(pos) == 32 {
        eff_prev2 = wb_wsegspace
        eff_prev = wb_wsegspace
        ri_odd = false
        pos = pos + 1
      }
      if pos >= n {
        break
      }
    }

    let b0 = s.code_unit_at(pos)
    let mut clen = 1
    let mut curr_wb = 0
    let mut curr_ep = 0
    let mut curr_alnum = false

    if b0 < 128 {
      let cid = tbl.code_unit_at(off_w_ascii + b0) - 35
      if cid == w_cid_other {
        if !alnum_only || seg_has_alnum {
          if out.length() >= max_seg {
            return Err(SegmentError::LimitExceeded)
          }
          out.push(SegmentSpan::{ start: seg_start, end: pos })
        }
        seg_start = pos
        seg_has_alnum = false
        prev_raw = 0
        eff_prev2 = eff_prev
        eff_prev = 0
        ri_odd = false
        pos = pos + 1
        continue
      }
      curr_wb = tbl.code_unit_at(off_w_c2wb + cid) - 35
      curr_alnum = ((tbl.code_unit_at(off_w_c2fl + cid) - 35) & 2) != 0
    } else {
      let dec = utf8_decode_non_ascii(s, pos, n, b0)
      let cp = dec >> 3
      clen = dec & 7
      let cid = if clen == 1 {
        0
      } else if clen <= 3 {
        let page = tbl.code_unit_at(off_w_bmp_idx + (cp >> 8)) - 35
        tbl.code_unit_at(off_w_bmp_data + ((page << 8) | (cp & 255))) - 35
      } else {
        lookup_smp(tbl, cp, off_w_smp, w_smp_count)
      }
      if cid <= 1 {
        if !alnum_only || seg_has_alnum {
          if out.length() >= max_seg {
            return Err(SegmentError::LimitExceeded)
          }
          out.push(SegmentSpan::{ start: seg_start, end: pos })
        }
        seg_start = pos
        seg_has_alnum = cid == 1
        prev_raw = 0
        eff_prev2 = eff_prev
        eff_prev = 0
        ri_odd = false
        pos = pos + clen
        continue
      }
      curr_wb = tbl.code_unit_at(off_w_c2wb + cid) - 35
      let fl = tbl.code_unit_at(off_w_c2fl + cid) - 35
      curr_ep = fl & 1
      curr_alnum = (fl & 2) != 0
    }

    let mut brk = true
    let mut is_wb4_ignored = false

    // WB3: CR x LF
    if prev_raw == wb_cr && curr_wb == wb_lf {
      brk = false
    } else if wb_is_newline(prev_raw) {
      // WB3a: (Newline | CR | LF) ÷
      brk = true
    } else if wb_is_newline(curr_wb) {
      // WB3b: ÷ (Newline | CR | LF)
      brk = true
    } else if prev_raw == wb_zwj && curr_ep == 1 {
      // WB3c: ZWJ x \p{Extended_Pictographic}
      brk = false
    } else if prev_raw == wb_wsegspace && curr_wb == wb_wsegspace {
      // WB3d: WSegSpace x WSegSpace
      brk = false
    } else if wb_is_ignorable(curr_wb) {
      // WB4: X (Extend | Format | ZWJ)* -> X
      brk = false
      is_wb4_ignored = true
    } else if wb_is_ahletter(eff_prev) && wb_is_ahletter(curr_wb) {
      // WB5: AHLetter x AHLetter
      brk = false
    } else if wb_is_ahletter(eff_prev) &&
    (curr_wb == wb_midletter || wb_is_midnumletq(curr_wb)) &&
    wb_is_ahletter(wb_peek_next_non_ignored_tbl(s, pos + clen, n, tbl)) {
      // WB6: AHLetter x (MidLetter | MidNumLetQ) AHLetter
      brk = false
    } else if wb_is_ahletter(eff_prev2) &&
    (eff_prev == wb_midletter || wb_is_midnumletq(eff_prev)) &&
    wb_is_ahletter(curr_wb) {
      // WB7: AHLetter (MidLetter | MidNumLetQ) x AHLetter
      brk = false
    } else if eff_prev == wb_hebrew_letter && curr_wb == wb_single_quote {
      // WB7a: Hebrew_Letter x Single_Quote
      brk = false
    } else if eff_prev == wb_hebrew_letter &&
    curr_wb == wb_double_quote &&
    wb_peek_next_non_ignored_tbl(s, pos + clen, n, tbl) == wb_hebrew_letter {
      // WB7b: Hebrew_Letter x Double_Quote Hebrew_Letter
      brk = false
    } else if eff_prev2 == wb_hebrew_letter &&
    eff_prev == wb_double_quote &&
    curr_wb == wb_hebrew_letter {
      // WB7c: Hebrew_Letter Double_Quote x Hebrew_Letter
      brk = false
    } else if eff_prev == wb_numeric && curr_wb == wb_numeric {
      // WB8: Numeric x Numeric
      brk = false
    } else if wb_is_ahletter(eff_prev) && curr_wb == wb_numeric {
      // WB9: AHLetter x Numeric
      brk = false
    } else if eff_prev == wb_numeric && wb_is_ahletter(curr_wb) {
      // WB10: Numeric x AHLetter
      brk = false
    } else if eff_prev2 == wb_numeric &&
    (eff_prev == wb_midnum || wb_is_midnumletq(eff_prev)) &&
    curr_wb == wb_numeric {
      // WB11: Numeric (MidNum | MidNumLetQ) x Numeric
      brk = false
    } else if eff_prev == wb_numeric &&
    (curr_wb == wb_midnum || wb_is_midnumletq(curr_wb)) &&
    wb_peek_next_non_ignored_tbl(s, pos + clen, n, tbl) == wb_numeric {
      // WB12: Numeric x (MidNum | MidNumLetQ) Numeric
      brk = false
    } else if eff_prev == wb_katakana && curr_wb == wb_katakana {
      // WB13: Katakana x Katakana
      brk = false
    } else if (wb_is_ahletter(eff_prev) || eff_prev == wb_numeric || eff_prev == wb_katakana ||
      eff_prev == wb_extendnumlet) && curr_wb == wb_extendnumlet {
      // WB13a: (AHLetter | Numeric | Katakana | ExtendNumLet) x ExtendNumLet
      brk = false
    } else if eff_prev == wb_extendnumlet &&
    (wb_is_ahletter(curr_wb) || curr_wb == wb_numeric || curr_wb == wb_katakana) {
      // WB13b: ExtendNumLet x (AHLetter | Numeric | Katakana)
      brk = false
    } else if eff_prev == wb_regional_indicator && curr_wb == wb_regional_indicator && ri_odd {
      // WB15 / WB16: (sot | [^RI]) (RI RI)* RI x RI
      brk = false
    }

    if brk {
      if !alnum_only || seg_has_alnum {
        if out.length() >= max_seg {
          return Err(SegmentError::LimitExceeded)
        }
        out.push(SegmentSpan::{ start: seg_start, end: pos })
      }
      seg_start = pos
      seg_has_alnum = curr_alnum
    } else if curr_alnum {
      seg_has_alnum = true
    }

    prev_raw = curr_wb
    if !is_wb4_ignored {
      if curr_wb == wb_regional_indicator {
        if eff_prev == wb_regional_indicator && ri_odd {
          ri_odd = false
        } else {
          ri_odd = true
        }
      } else {
        ri_odd = false
      }
      if wb_is_newline(curr_wb) {
        eff_prev2 = -1
        eff_prev = curr_wb
      } else {
        eff_prev2 = eff_prev
        eff_prev = curr_wb
      }
    }

    pos = pos + clen
  }

  if !alnum_only || seg_has_alnum {
    if out.length() >= max_seg {
      return Err(SegmentError::LimitExceeded)
    }
    out.push(SegmentSpan::{ start: seg_start, end: n })
  }
  Ok(out)
}

///| Compute UAX #29 Word Boundary byte spans with explicit resource limits.
pub fn word_bounds_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  word_bounds_core(s, false, limits)
}

///| Compute UAX #29 Word Boundary byte spans for `s`.
pub fn word_bounds(s : String) -> Array[SegmentSpan] {
  word_bounds_fast(s, false)
}

///| Split `s` on UAX #29 Word Boundaries with explicit resource limits.
pub fn words_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[String], SegmentError] {
  match word_bounds_with_limits(s, limits) {
    Ok(spans) => Ok(spans_to_strings(s, spans))
    Err(e) => Err(e)
  }
}

///| Split `s` on UAX #29 Word Boundaries (including whitespace and punctuation segments).
pub fn words(s : String) -> Array[String] {
  spans_to_strings(s, word_bounds(s))
}

///| Compute alphanumeric-only Unicode Word byte spans (matching Rust `unicode_words`) with limits.
pub fn unicode_word_bounds_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  word_bounds_core(s, true, limits)
}

///| Compute alphanumeric-only Unicode Word byte spans (matching Rust `unicode_words`).
pub fn unicode_word_bounds(s : String) -> Array[SegmentSpan] {
  word_bounds_fast(s, true)
}

///| Split `s` into alphanumeric-only Unicode Words with explicit resource limits.
pub fn unicode_words_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[String], SegmentError] {
  match unicode_word_bounds_with_limits(s, limits) {
    Ok(spans) => Ok(spans_to_strings(s, spans))
    Err(e) => Err(e)
  }
}

///| Split `s` into alphanumeric-only Unicode Words (filtering out pure whitespace/punctuation).
pub fn unicode_words(s : String) -> Array[String] {
  spans_to_strings(s, unicode_word_bounds(s))
}
