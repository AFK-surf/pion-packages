///| UAX #29 §4.1 Word Boundary segmentation (Unicode 16.0.0, WB1–WB999).
///| Strict O(n) single-pass with bounded non-overlapping lookahead; zero `FixedArray`, zero mutable globals.

fn wb_is_newline(wb : Int) -> Bool {
  wb == wb_newline || wb == wb_cr || wb == wb_lf
}

fn wb_is_ignorable(wb : Int) -> Bool {
  wb == wb_extend || wb == wb_format || wb == wb_zwj
}

fn wb_is_ahletter(wb : Int) -> Bool {
  wb == wb_aletter || wb == wb_hebrew_letter
}

fn wb_is_midnumletq(wb : Int) -> Bool {
  wb == wb_midnumlet || wb == wb_single_quote
}

///| Peek the next codepoint's WB class after skipping any `(Extend | Format | ZWJ)*` starting at `start`.
///| Returns `-1` at end of string.
///| Because this is only called from non-ignorable mid-punctuation (`MidLetter`/`MidNumLetQ`/`Double_Quote`/`MidNum`),
///| each ignorable byte is scanned at most once across the entire input (strict O(n)).
fn wb_peek_next_non_ignored(s : String, start : Int, n : Int) -> Int {
  let mut p = start
  while p < n {
    let dec = utf8_decode_packed(s, p, n)
    let wb = lookup_word_packed(dec >> 3) & 31
    if !wb_is_ignorable(wb) {
      return wb
    }
    p = p + (dec & 7)
  }
  -1
}

///| Core Word Boundary scanner supporting both `word_bounds` and `unicode_word_bounds`,
///| with optional resource limits (`check_limits == false` disables limit checks).
fn word_bounds_core(
  s : String,
  alnum_only : Bool,
  check_limits : Bool,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  if check_limits {
    match check_input_limits(s, limits) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  let n = s.length()
  let out : Array[SegmentSpan] = Array::new()
  if n == 0 {
    return Ok(out)
  }

  let first_dec = utf8_decode_packed(s, 0, n)
  let first_p = lookup_word_packed(first_dec >> 3)
  let first_wb = first_p & 31
  let first_alnum = ((first_p >> 6) & 1) == 1

  let mut prev_raw = first_wb
  let mut eff_prev = first_wb
  let mut eff_prev2 = -1
  let mut ri_odd = first_wb == wb_regional_indicator

  let mut seg_start = 0
  let mut seg_has_alnum = first_alnum
  let mut pos = first_dec & 7

  while pos < n {
    let dec = utf8_decode_packed(s, pos, n)
    let clen = dec & 7
    let packed = lookup_word_packed(dec >> 3)
    let curr_wb = packed & 31
    let curr_ep = (packed >> 5) & 1
    let curr_alnum = ((packed >> 6) & 1) == 1

    let mut brk = true
    let mut is_wb4_ignored = false

    // WB3: CR x LF
    if prev_raw == wb_cr && curr_wb == wb_lf {
      brk = false
    } else if wb_is_newline(prev_raw) {
      // WB3a: (Newline | CR | LF) ÷
      brk = true
    } else if wb_is_newline(curr_wb) {
      // WB3b: ÷ (Newline | CR | LF)
      brk = true
    } else if prev_raw == wb_zwj && curr_ep == 1 {
      // WB3c: ZWJ x \p{Extended_Pictographic}
      brk = false
    } else if prev_raw == wb_wsegspace && curr_wb == wb_wsegspace {
      // WB3d: WSegSpace x WSegSpace
      brk = false
    } else if wb_is_ignorable(curr_wb) {
      // WB4: X (Extend | Format | ZWJ)* -> X
      brk = false
      is_wb4_ignored = true
    } else if wb_is_ahletter(eff_prev) && wb_is_ahletter(curr_wb) {
      // WB5: AHLetter x AHLetter
      brk = false
    } else if wb_is_ahletter(eff_prev) &&
    (curr_wb == wb_midletter || wb_is_midnumletq(curr_wb)) &&
    wb_is_ahletter(wb_peek_next_non_ignored(s, pos + clen, n)) {
      // WB6: AHLetter x (MidLetter | MidNumLetQ) AHLetter
      brk = false
    } else if wb_is_ahletter(eff_prev2) &&
    (eff_prev == wb_midletter || wb_is_midnumletq(eff_prev)) &&
    wb_is_ahletter(curr_wb) {
      // WB7: AHLetter (MidLetter | MidNumLetQ) x AHLetter
      brk = false
    } else if eff_prev == wb_hebrew_letter && curr_wb == wb_single_quote {
      // WB7a: Hebrew_Letter x Single_Quote
      brk = false
    } else if eff_prev == wb_hebrew_letter &&
    curr_wb == wb_double_quote &&
    wb_peek_next_non_ignored(s, pos + clen, n) == wb_hebrew_letter {
      // WB7b: Hebrew_Letter x Double_Quote Hebrew_Letter
      brk = false
    } else if eff_prev2 == wb_hebrew_letter &&
    eff_prev == wb_double_quote &&
    curr_wb == wb_hebrew_letter {
      // WB7c: Hebrew_Letter Double_Quote x Hebrew_Letter
      brk = false
    } else if eff_prev == wb_numeric && curr_wb == wb_numeric {
      // WB8: Numeric x Numeric
      brk = false
    } else if wb_is_ahletter(eff_prev) && curr_wb == wb_numeric {
      // WB9: AHLetter x Numeric
      brk = false
    } else if eff_prev == wb_numeric && wb_is_ahletter(curr_wb) {
      // WB10: Numeric x AHLetter
      brk = false
    } else if eff_prev2 == wb_numeric &&
    (eff_prev == wb_midnum || wb_is_midnumletq(eff_prev)) &&
    curr_wb == wb_numeric {
      // WB11: Numeric (MidNum | MidNumLetQ) x Numeric
      brk = false
    } else if eff_prev == wb_numeric &&
    (curr_wb == wb_midnum || wb_is_midnumletq(curr_wb)) &&
    wb_peek_next_non_ignored(s, pos + clen, n) == wb_numeric {
      // WB12: Numeric x (MidNum | MidNumLetQ) Numeric
      brk = false
    } else if eff_prev == wb_katakana && curr_wb == wb_katakana {
      // WB13: Katakana x Katakana
      brk = false
    } else if (wb_is_ahletter(eff_prev) || eff_prev == wb_numeric || eff_prev == wb_katakana ||
      eff_prev == wb_extendnumlet) && curr_wb == wb_extendnumlet {
      // WB13a: (AHLetter | Numeric | Katakana | ExtendNumLet) x ExtendNumLet
      brk = false
    } else if eff_prev == wb_extendnumlet &&
    (wb_is_ahletter(curr_wb) || curr_wb == wb_numeric || curr_wb == wb_katakana) {
      // WB13b: ExtendNumLet x (AHLetter | Numeric | Katakana)
      brk = false
    } else if eff_prev == wb_regional_indicator && curr_wb == wb_regional_indicator && ri_odd {
      // WB15 / WB16: (sot | [^RI]) (RI RI)* RI x RI
      brk = false
    }

    if brk {
      if !alnum_only || seg_has_alnum {
        if check_limits && out.length() >= limits.max_segments {
          return Err(SegmentError::LimitExceeded)
        }
        out.push(SegmentSpan::new(seg_start, pos))
      }
      seg_start = pos
      seg_has_alnum = curr_alnum
    } else if curr_alnum {
      seg_has_alnum = true
    }

    prev_raw = curr_wb
    if !is_wb4_ignored {
      if curr_wb == wb_regional_indicator {
        if eff_prev == wb_regional_indicator && ri_odd {
          ri_odd = false
        } else {
          ri_odd = true
        }
      } else {
        ri_odd = false
      }
      if wb_is_newline(curr_wb) {
        eff_prev2 = -1
        eff_prev = curr_wb
      } else {
        eff_prev2 = eff_prev
        eff_prev = curr_wb
      }
    }

    pos = pos + clen
  }

  if !alnum_only || seg_has_alnum {
    if check_limits && out.length() >= limits.max_segments {
      return Err(SegmentError::LimitExceeded)
    }
    out.push(SegmentSpan::new(seg_start, n))
  }
  Ok(out)
}

///| Compute UAX #29 Word Boundary byte spans with explicit resource limits.
pub fn word_bounds_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  word_bounds_core(s, false, true, limits)
}

///| Compute UAX #29 Word Boundary byte spans for `s`.
pub fn word_bounds(s : String) -> Array[SegmentSpan] {
  match word_bounds_core(s, false, false, SegmentLimits::default()) {
    Ok(v) => v
    Err(_) => []
  }
}

///| Split `s` on UAX #29 Word Boundaries with explicit resource limits.
pub fn words_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[String], SegmentError] {
  match word_bounds_with_limits(s, limits) {
    Ok(spans) => Ok(spans_to_strings(s, spans))
    Err(e) => Err(e)
  }
}

///| Split `s` on UAX #29 Word Boundaries (including whitespace and punctuation segments).
pub fn words(s : String) -> Array[String] {
  spans_to_strings(s, word_bounds(s))
}

///| Compute alphanumeric-only Unicode Word byte spans (matching Rust `unicode_words`) with limits.
pub fn unicode_word_bounds_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[SegmentSpan], SegmentError] {
  word_bounds_core(s, true, true, limits)
}

///| Compute alphanumeric-only Unicode Word byte spans (matching Rust `unicode_words`).
pub fn unicode_word_bounds(s : String) -> Array[SegmentSpan] {
  match word_bounds_core(s, true, false, SegmentLimits::default()) {
    Ok(v) => v
    Err(_) => []
  }
}

///| Split `s` into alphanumeric-only Unicode Words with explicit resource limits.
pub fn unicode_words_with_limits(
  s : String,
  limits : SegmentLimits,
) -> Result[Array[String], SegmentError] {
  match unicode_word_bounds_with_limits(s, limits) {
    Ok(spans) => Ok(spans_to_strings(s, spans))
    Err(e) => Err(e)
  }
}

///| Split `s` into alphanumeric-only Unicode Words (filtering out pure whitespace/punctuation).
pub fn unicode_words(s : String) -> Array[String] {
  spans_to_strings(s, unicode_word_bounds(s))
}
