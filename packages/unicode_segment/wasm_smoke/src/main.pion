///| Native + Wasm32 four-mode smoke binary for `unicode_segment`.
///| Exercises Grapheme (GB1-GB999 incl. GB9c/GB11/GB12-13), Word (WB1-WB999 + unicode_words),
///| Sentence (SB1-SB11 + SB998), cursor navigation, and SegmentLimits with deterministic stdout.

import "unicode_segment"

fn fnv1a_u64(h0 : UInt64, v : Int) -> UInt64 {
  (h0 ^ v.to_int64().to_uint64()) * 1099511628211UL
}

fn hash_spans(h0 : UInt64, spans : Array[unicode_segment::SegmentSpan]) -> UInt64 {
  let mut h = fnv1a_u64(h0, spans.length())
  let mut i = 0
  while i < spans.length() {
    h = fnv1a_u64(h, spans[i].start)
    h = fnv1a_u64(h, spans[i].end)
    i = i + 1
  }
  h
}

pub fn smoke_report() -> String {
  let samples : Array[String] = [
    "Hello, world! Don't stop at 3.14.",
    "a\r\nb\nc\rd",
    "e\u{0301}\u{0308} \u{1100}\u{1161}\u{11A8}",
    "\u{0915}\u{094D}\u{0937} \u{0915}\u{093C}\u{094D}\u{0937} \u{0915}\u{094D}\u{0924}\u{094D}\u{0930}",
    "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466} \u{1F1E8}\u{1F1F3}\u{1F1FA}\u{1F1F8}",
    "你好世界！カタカナ와 한국어。U.S.A. is big. Dr. Smith said \"Hi.\" Next?",
    "\u{05D0}' \u{05D0}\"\u{05D1} \u{0645}\u{0631}\u{062D}\u{0628}\u{0627} 1,000.50",
  ]

  let mut h : UInt64 = 14695981039346656037UL
  let mut g_total = 0
  let mut w_total = 0
  let mut uw_total = 0
  let mut s_total = 0

  let mut i = 0
  while i < samples.length() {
    let s = samples[i]
    let gs = unicode_segment::grapheme_indices(s)
    let ws = unicode_segment::word_bounds(s)
    let uws = unicode_segment::unicode_word_bounds(s)
    let ss = unicode_segment::sentence_bounds(s)
    g_total = g_total + gs.length()
    w_total = w_total + ws.length()
    uw_total = uw_total + uws.length()
    s_total = s_total + ss.length()
    h = hash_spans(h, gs)
    h = hash_spans(h, ws)
    h = hash_spans(h, uws)
    h = hash_spans(h, ss)

    // Verify next/prev cursor navigation round-trip
    let mut cur = 0
    let mut steps = 0
    while cur < s.length() {
      match unicode_segment::next_grapheme_boundary(s, cur) {
        Some(nxt) => {
          h = fnv1a_u64(h, nxt)
          cur = nxt
          steps = steps + 1
        }
        None => break
      }
    }
    h = fnv1a_u64(h, steps)
    i = i + 1
  }

  // Verify SegmentLimits enforcement
  let lim_ok = match unicode_segment::grapheme_indices_with_limits("abc", unicode_segment::SegmentLimits::new(3, 2)) {
    Err(unicode_segment::SegmentError::LimitExceeded) => 1
    _ => 0
  }
  h = fnv1a_u64(h, lim_ok)

  "unicode_segment_wasm_smoke: OK samples=" + samples.length().to_string() +
  " g=" + g_total.to_string() +
  " w=" + w_total.to_string() +
  " uw=" + uw_total.to_string() +
  " s=" + s_total.to_string() +
  " lim=" + lim_ok.to_string() +
  " fnv64=" + h.to_string()
}

pub fn main(world : World) -> Int {
  io_println(world, smoke_report())
  0
}
