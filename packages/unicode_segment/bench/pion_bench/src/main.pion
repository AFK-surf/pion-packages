import "unicode_segment"

fn fnv1a_u64(h0 : UInt64, v : Int) -> UInt64 {
  (h0 ^ v.to_int64().to_uint64()) * 1099511628211UL
}

fn bytes_to_string(b : Bytes) -> String {
  let n = b.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    sb.write_byte(b[i])
    i = i + 1
  }
  sb.to_string()
}

fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || s.code_unit_at(i) == 10 {
      let mut end = i
      if end > start && s.code_unit_at(end - 1) == 13 {
        end = end - 1
      }
      if i < n || end > start {
        out.push(s.slice(start, end))
      }
      start = i + 1
    }
    i = i + 1
  }
  out
}

fn parse_int(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut v = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    v = v * 10 + (b - 48)
    i = i + 1
  }
  v
}

fn format_spans(spans : Array[unicode_segment::SegmentSpan]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < spans.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(spans[i].start.to_string())
    sb.write_string(":")
    sb.write_string(spans[i].end.to_string())
    i = i + 1
  }
  sb.to_string()
}

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Int {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
    1
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
    2
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
    3
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
    4
  }
}

fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 65 + 10
  } else if b >= 97 && b <= 102 {
    b - 97 + 10
  } else {
    -1
  }
}

///| Verify official Unicode 16.0.0 UCD *BreakTest.txt files (100% of vectors).
fn run_ucd(world : World, mode : String, path : String) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "ERR: failed to read " + path)
      return 1
    }
  }
  let content = bytes_to_string(raw)
  let lines = split_lines(content)
  let mut total = 0
  let mut passed = 0
  let mut failed = 0
  let mut line_no = 0
  while line_no < lines.length() {
    let line = lines[line_no]
    line_no = line_no + 1
    let ln = line.length()
    // Strip comment starting with '#'
    let mut end = ln
    let mut k = 0
    while k < ln {
      if line.code_unit_at(k) == 35 {
        end = k
        break
      }
      k = k + 1
    }
    // Parse tokens: ÷ (0xC3 0xB7), × (0xC3 0x97), or hex codepoint
    let sb = StringBuilder::new()
    let expected_starts : Array[Int] = []
    let mut byte_off = 0
    let mut p = 0
    let mut has_token = false
    let mut has_surrogate = false
    while p < end {
      let b = line.code_unit_at(p)
      if b == 32 || b == 9 {
        p = p + 1
        continue
      }
      if b == 0xC3 && p + 1 < end {
        let b1 = line.code_unit_at(p + 1)
        if b1 == 0xB7 {
          // '÷' break opportunity
          has_token = true
          expected_starts.push(byte_off)
          p = p + 2
          continue
        } else if b1 == 0x97 {
          // '×' no break
          has_token = true
          p = p + 2
          continue
        }
      }
      if hex_val(b) >= 0 {
        has_token = true
        let mut cp = 0
        while p < end {
          let hv = hex_val(line.code_unit_at(p))
          if hv < 0 {
            break
          }
          cp = (cp << 4) | hv
          p = p + 1
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
          has_surrogate = true
        } else {
          byte_off = byte_off + write_utf8_cp(sb, cp)
        }
        continue
      }
      p = p + 1
    }
    if !has_token || has_surrogate {
      continue
    }
    total = total + 1
    let text = sb.to_string()
    let got_spans = if mode == "grapheme" {
      unicode_segment::grapheme_indices(text)
    } else if mode == "word" {
      unicode_segment::word_bounds(text)
    } else {
      unicode_segment::sentence_bounds(text)
    }

    // Build expected spans from expected_starts (which starts with 0 and ends with byte_off)
    let exp_spans : Array[unicode_segment::SegmentSpan] = []
    let mut ei = 0
    while ei + 1 < expected_starts.length() {
      exp_spans.push(unicode_segment::SegmentSpan::new(expected_starts[ei], expected_starts[ei + 1]))
      ei = ei + 1
    }

    let mut ok = got_spans.length() == exp_spans.length()
    if ok {
      let mut j = 0
      while j < got_spans.length() {
        if !got_spans[j].eq(exp_spans[j]) {
          ok = false
          break
        }
        j = j + 1
      }
    }

    // For grapheme mode, also verify cursor navigation APIs on every single official vector!
    if ok && mode == "grapheme" {
      let mut cur = 0
      let mut idx = 0
      while cur < text.length() {
        if !unicode_segment::is_grapheme_boundary(text, cur) {
          ok = false
          break
        }
        match unicode_segment::next_grapheme_boundary(text, cur) {
          Some(nxt) => {
            if idx >= exp_spans.length() || nxt != exp_spans[idx].end {
              ok = false
              break
            }
            cur = nxt
            idx = idx + 1
          }
          None => {
            ok = false
            break
          }
        }
      }
      if ok && idx != exp_spans.length() {
        ok = false
      }
      if ok {
        let mut bcur = text.length()
        let mut bidx = exp_spans.length() - 1
        while bcur > 0 {
          match unicode_segment::prev_grapheme_boundary(text, bcur) {
            Some(prv) => {
              if bidx < 0 || prv != exp_spans[bidx].start {
                ok = false
                break
              }
              bcur = prv
              bidx = bidx - 1
            }
            None => {
              ok = false
              break
            }
          }
        }
      }
    }

    if ok {
      passed = passed + 1
    } else {
      failed = failed + 1
      if failed <= 10 {
        io_println(
          world,
          "FAIL line " +
          line_no.to_string() +
          ": exp=[" +
          format_spans(exp_spans) +
          "] got=[" +
          format_spans(got_spans) +
          "] | " +
          line,
        )
      }
    }
  }
  io_println(
    world,
    "UCD " +
    mode +
    ": passed=" +
    passed.to_string() +
    "/" +
    total.to_string() +
    " failed=" +
    failed.to_string(),
  )
  if failed == 0 { 0 } else { 1 }
}

fn run_diff(world : World, path : String) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "ERR: failed to read " + path)
      return 1
    }
  }
  let content = bytes_to_string(raw)
  let lines = split_lines(content)
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    let g = unicode_segment::grapheme_indices(line)
    let w = unicode_segment::word_bounds(line)
    let uw = unicode_segment::unicode_word_bounds(line)
    let s = unicode_segment::sentence_bounds(line)
    io_println(
      world,
      i.to_string() +
      "\tG=" +
      format_spans(g) +
      "\tW=" +
      format_spans(w) +
      "\tUW=" +
      format_spans(uw) +
      "\tS=" +
      format_spans(s),
    )
    i = i + 1
  }
  0
}

fn run_bench(world : World, path : String, iters : Int) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "ERR: failed to read " + path)
      return 1
    }
  }
  let content = bytes_to_string(raw)
  let mut h : UInt64 = 14695981039346656037UL
  let mut g_total = 0
  let mut w_total = 0
  let mut uw_total = 0
  let mut s_total = 0

  let mut it = 0
  while it < iters {
    let gs = unicode_segment::grapheme_indices(content)
    let mut i = 0
    while i < gs.length() {
      h = fnv1a_u64(h, gs[i].start)
      h = fnv1a_u64(h, gs[i].end)
      i = i + 1
    }
    g_total = g_total + gs.length()

    let ws = unicode_segment::word_bounds(content)
    let mut j = 0
    while j < ws.length() {
      h = fnv1a_u64(h, ws[j].start)
      h = fnv1a_u64(h, ws[j].end)
      j = j + 1
    }
    w_total = w_total + ws.length()

    let uws = unicode_segment::unicode_word_bounds(content)
    let mut k = 0
    while k < uws.length() {
      h = fnv1a_u64(h, uws[k].start)
      h = fnv1a_u64(h, uws[k].end)
      k = k + 1
    }
    uw_total = uw_total + uws.length()

    let ss = unicode_segment::sentence_bounds(content)
    let mut m = 0
    while m < ss.length() {
      h = fnv1a_u64(h, ss[m].start)
      h = fnv1a_u64(h, ss[m].end)
      m = m + 1
    }
    s_total = s_total + ss.length()

    it = it + 1
  }

  io_println(
    world,
    "iters=" +
    iters.to_string() +
    " g=" +
    g_total.to_string() +
    " w=" +
    w_total.to_string() +
    " uw=" +
    uw_total.to_string() +
    " s=" +
    s_total.to_string() +
    " fnv64=" +
    h.to_string(),
  )
  0
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_segment <ucd <grapheme|word|sentence> <file> | diff <file> | bench <file> [iters]>")
    return 2
  }
  let cmd = args[1]
  if cmd == "ucd" {
    if args.length() < 4 {
      io_println(world, "usage: pion_segment ucd <grapheme|word|sentence> <file>")
      return 2
    }
    run_ucd(world, args[2], args[3])
  } else if cmd == "diff" {
    run_diff(world, args[2])
  } else if cmd == "bench" {
    let iters = if args.length() >= 4 { parse_int(args[3], 50) } else { 50 }
    run_bench(world, args[2], iters)
  } else {
    io_println(world, "unknown subcommand: " + cmd)
    2
  }
}
