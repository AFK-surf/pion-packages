///| PromQL lexer, duration, AST parser, and static semantic validation tests
///| ported from Prometheus `promql/parser/parse_test.go`.

fn assert_parse_ok(input : String, expected_type : ValueType, msg : String) -> ParsedExpr {
  match parse_expr(input) {
    Ok(e) => {
      debug_assert(
        value_type_eq(e.root_type(), expected_type),
        msg + " (expected type " + value_type_name(expected_type) + ", got " + value_type_name(e.root_type()) + " for: " + input + ")",
      )
      e
    }
    Err(err) => {
      debug_assert(false, msg + " (unexpected err: " + err.to_string() + ", input: " + input + ")")
      ParsedExpr::{ nodes: [], root: -1, value_type: ValueType::None }
    }
  }
}

fn assert_parse_err(input : String, msg : String) -> Unit {
  match parse_expr(input) {
    Ok(_) => debug_assert(false, msg + " (expected error, got Ok for: " + input + ")")
    Err(e) =>
    debug_assert(
      !e.is_kind(PromqlErrorKind::Unimplemented),
      msg + " (got Unimplemented instead of real error for: " + input + ")",
    )
  }
}

fn assert_parse_err_kind(input : String, kind : PromqlErrorKind, msg : String) -> Unit {
  match parse_expr(input) {
    Ok(_) => debug_assert(false, msg + " (expected error, got Ok for: " + input + ")")
    Err(e) =>
    debug_assert(
      e.is_kind(kind),
      msg + " (expected " + error_kind_as_str(kind) + ", got " + e.to_string() + " for: " + input + ")",
    )
  }
}

///|
test "promql_lexer_numbers_strings_comments" {
  // Decimal, float, scientific, hex, Inf, NaN
  let _ = assert_parse_ok("0", ValueType::Scalar, "zero")
  let _ = assert_parse_ok("42", ValueType::Scalar, "int")
  let _ = assert_parse_ok("3.14159", ValueType::Scalar, "float")
  let _ = assert_parse_ok(".5", ValueType::Scalar, "leading dot float")
  let _ = assert_parse_ok("5.", ValueType::Scalar, "trailing dot float")
  let _ = assert_parse_ok("1e5", ValueType::Scalar, "sci positive")
  let _ = assert_parse_ok("1.5E-3", ValueType::Scalar, "sci negative")
  let _ = assert_parse_ok("0x2a", ValueType::Scalar, "hex lower")
  let _ = assert_parse_ok("0XFF", ValueType::Scalar, "hex upper")
  let _ = assert_parse_ok("Inf", ValueType::Scalar, "Inf")
  let _ = assert_parse_ok("-Inf", ValueType::Scalar, "-Inf")
  let _ = assert_parse_ok("+inf", ValueType::Scalar, "+inf")
  let _ = assert_parse_ok("NaN", ValueType::Scalar, "NaN")
  let _ = assert_parse_ok("nan", ValueType::Scalar, "nan lowercase")

  // Strings: double-quoted, single-quoted, backtick raw
  let _ = assert_parse_ok("\"hello\\nworld\"", ValueType::String, "double quoted")
  let _ = assert_parse_ok("'single\\tquote'", ValueType::String, "single quoted")
  let _ = assert_parse_ok("`raw \\n string`", ValueType::String, "backtick raw")

  // Comments
  let _ = assert_parse_ok("# leading comment\n1 + # inline comment\n2 # trailing", ValueType::Scalar, "comments")

  // Invalid lexes
  assert_parse_err("", "empty input")
  assert_parse_err("   # only comment\n", "only comment")
  assert_parse_err("\"unterminated", "unterminated double string")
  assert_parse_err("`unterminated", "unterminated raw string")
  assert_parse_err("0x", "empty hex")
  assert_parse_err("1e", "empty exponent")
}

///|
test "promql_durations_compound_and_format" {
  match parse_duration_ms("1y2w3d4h5m6s7ms") {
    Ok(ms) => {
      let expected = 31536000000L + 2L * 604800000L + 3L * 86400000L + 4L * 3600000L + 5L * 60000L + 6L * 1000L + 7L
      debug_assert(ms == expected, "compound duration ms mismatch")
      debug_assert(format_duration_ms(ms) == "1y2w3d4h5m6s7ms", "compound duration format")
    }
    Err(e) => debug_assert(false, "compound duration failed: " + e.to_string())
  }
  match parse_duration_ms("5m") {
    Ok(ms) => {
      debug_assert(ms == 300000L, "5m == 300000ms")
      debug_assert(format_duration_ms(ms) == "5m", "format 5m")
    }
    Err(e) => debug_assert(false, "5m failed: " + e.to_string())
  }
  debug_assert(format_duration_ms(0L) == "0s", "format 0s")
  debug_assert(format_duration_ms(90000L) == "1m30s", "format 1m30s")
  debug_assert(format_duration_ms(-300000L) == "-5m", "format -5m")

  // Invalid durations (wrong order, duplicate unit, empty)
  match parse_duration_ms("") {
    Ok(_) => debug_assert(false, "empty duration should fail")
    Err(e) => debug_assert(!e.is_kind(PromqlErrorKind::Unimplemented), "real err for empty duration")
  }
  match parse_duration_ms("5s1m") {
    Ok(_) => debug_assert(false, "ascending duration units should fail")
    Err(e) => debug_assert(!e.is_kind(PromqlErrorKind::Unimplemented), "real err for ascending units")
  }
  match parse_duration_ms("5m5m") {
    Ok(_) => debug_assert(false, "duplicate duration unit should fail")
    Err(e) => debug_assert(!e.is_kind(PromqlErrorKind::Unimplemented), "real err for dup unit")
  }
}

///|
test "promql_selectors_matchers_utf8_and_modifiers" {
  // Basic instant selectors
  let _ = assert_parse_ok("http_requests_total", ValueType::Vector, "bare metric")
  let _ = assert_parse_ok("job:http_requests:rate5m", ValueType::Vector, "metric with colons")
  let _ = assert_parse_ok("http_requests_total{job=\"api\", code!=\"500\", path=~\"/v1/.*\", host!~\"canary.*\"}", ValueType::Vector, "all 4 matcher ops")
  let _ = assert_parse_ok("http_requests_total{job=\"api\",}", ValueType::Vector, "trailing comma in selector")
  let _ = assert_parse_ok("{__name__=~\"http_.*\", env=\"prod\"}", ValueType::Vector, "brace-only selector")

  // UTF-8 quoted metric and label names
  let _ = assert_parse_ok("{\"http.requests.total\", env=\"prod\"}", ValueType::Vector, "utf8 quoted metric name")
  let _ = assert_parse_ok("{\"http.requests\", \"k8s.pod.name\"=~\"web-.*\"}", ValueType::Vector, "utf8 quoted metric and label")

  // Keyword used as label name
  let _ = assert_parse_ok("up{by=\"a\", sum=\"b\", on=\"c\", offset=\"d\"}", ValueType::Vector, "keywords as label names")

  // Matrix selector
  let _ = assert_parse_ok("http_requests_total{job=\"api\"}[5m]", ValueType::Matrix, "matrix selector")
  let _ = assert_parse_ok("http_requests_total[1h30m]", ValueType::Matrix, "compound duration matrix")

  // Subquery
  let _ = assert_parse_ok("rate(http_requests_total[5m])[1h:1m]", ValueType::Matrix, "subquery with step")
  let _ = assert_parse_ok("rate(http_requests_total[5m])[1h:]", ValueType::Matrix, "subquery default step")

  // offset (positive & negative) and @ (timestamp, start(), end())
  let _ = assert_parse_ok("http_requests_total offset 5m", ValueType::Vector, "positive offset")
  let _ = assert_parse_ok("http_requests_total offset -5m", ValueType::Vector, "negative offset")
  let _ = assert_parse_ok("http_requests_total @ 1609746113.123", ValueType::Vector, "@ timestamp")
  let _ = assert_parse_ok("http_requests_total @ start()", ValueType::Vector, "@ start()")
  let _ = assert_parse_ok("http_requests_total @ end()", ValueType::Vector, "@ end()")
  let _ = assert_parse_ok("http_requests_total @ 1000 offset 5m", ValueType::Vector, "@ then offset")
  let _ = assert_parse_ok("http_requests_total offset 5m @ 1000", ValueType::Vector, "offset then @")
  let _ = assert_parse_ok("http_requests_total[5m] offset 1h @ start()", ValueType::Matrix, "matrix offset and @")
  let _ = assert_parse_ok("rate(http_requests_total[5m])[30m:1m] @ end() offset -5m", ValueType::Matrix, "subquery @ and neg offset")

  // parse_metric_selector API
  match parse_metric_selector("http_requests_total{job=\"api\", code!=\"500\"}") {
    Ok(ms) => debug_assert(ms.length() == 3, "metric selector should have 3 matchers including __name__")
    Err(e) => debug_assert(false, "parse_metric_selector failed: " + e.to_string())
  }
}

///|
test "promql_binary_precedence_and_vector_matching" {
  // Arithmetic, power right-assoc, unary precedence
  let _ = assert_parse_ok("1 + 2 * 3 - 4 / 2 % 3", ValueType::Scalar, "arith precedence")
  let _ = assert_parse_ok("2 ^ 3 ^ 2", ValueType::Scalar, "right-assoc power")
  let _ = assert_parse_ok("-2 ^ 2", ValueType::Scalar, "unary minus vs power")
  let _ = assert_parse_ok("2 ^ -3", ValueType::Scalar, "power with negative rhs")
  let _ = assert_parse_ok("a atan2 b", ValueType::Vector, "atan2 binary op")

  // Comparisons and bool modifier
  let _ = assert_parse_ok("1 == bool 1", ValueType::Scalar, "scalar comparison with bool")
  let _ = assert_parse_ok("http_requests_total > 100", ValueType::Vector, "vector > scalar")
  let _ = assert_parse_ok("http_requests_total >= bool 100", ValueType::Vector, "vector >= bool scalar")

  // Vector matching: on, ignoring, group_left, group_right
  let _ = assert_parse_ok("a / on(instance, job) b", ValueType::Vector, "on clause")
  let _ = assert_parse_ok("a + ignoring(code) b", ValueType::Vector, "ignoring clause")
  let _ = assert_parse_ok("a * on(pod) group_left(node, zone) b", ValueType::Vector, "on + group_left with labels")
  let _ = assert_parse_ok("a * on(pod) group_left b", ValueType::Vector, "on + bare group_left")
  let _ = assert_parse_ok("a / ignoring(method) group_right(owner) b", ValueType::Vector, "ignoring + group_right")
  let _ = assert_parse_ok("a == bool on(job) group_left(env) b", ValueType::Vector, "bool + on + group_left")

  // Set operations: and, or, unless
  let _ = assert_parse_ok("a and b or c unless d", ValueType::Vector, "set ops")
  let _ = assert_parse_ok("a and on(job) b", ValueType::Vector, "set op with on")
  let _ = assert_parse_ok("a unless ignoring(instance) b", ValueType::Vector, "unless with ignoring")
}

///|
test "promql_all_14_aggregations" {
  // 8 non-parameterized aggregations (prefix and suffix by/without)
  let _ = assert_parse_ok("sum(http_requests_total)", ValueType::Vector, "sum")
  let _ = assert_parse_ok("sum by (job, instance) (http_requests_total)", ValueType::Vector, "sum prefix by")
  let _ = assert_parse_ok("sum(http_requests_total) by (job, instance)", ValueType::Vector, "sum suffix by")
  let _ = assert_parse_ok("min without (pod) (cpu_usage)", ValueType::Vector, "min prefix without")
  let _ = assert_parse_ok("max(cpu_usage) without (pod)", ValueType::Vector, "max suffix without")
  let _ = assert_parse_ok("avg by (service) (latency_seconds)", ValueType::Vector, "avg")
  let _ = assert_parse_ok("group by (env) (up)", ValueType::Vector, "group")
  let _ = assert_parse_ok("stddev(latency_seconds)", ValueType::Vector, "stddev")
  let _ = assert_parse_ok("stdvar without (instance) (latency_seconds)", ValueType::Vector, "stdvar")
  let _ = assert_parse_ok("count by (job) (up)", ValueType::Vector, "count")

  // 6 parameterized aggregations
  let _ = assert_parse_ok("count_values(\"version\", build_info)", ValueType::Vector, "count_values")
  let _ = assert_parse_ok("topk(5, http_requests_total)", ValueType::Vector, "topk")
  let _ = assert_parse_ok("topk by (job) (3, http_requests_total)", ValueType::Vector, "topk prefix by")
  let _ = assert_parse_ok("bottomk(5, latency_seconds) without (instance)", ValueType::Vector, "bottomk suffix without")
  let _ = assert_parse_ok("quantile(0.95, http_request_duration_seconds)", ValueType::Vector, "quantile")
  let _ = assert_parse_ok("limitk(10, up)", ValueType::Vector, "limitk")
  let _ = assert_parse_ok("limit_ratio(0.1, up)", ValueType::Vector, "limit_ratio")
}

///|
test "promql_functions_and_semantic_validation" {
  // Core functions
  let _ = assert_parse_ok("rate(http_requests_total[5m])", ValueType::Vector, "rate")
  let _ = assert_parse_ok("irate(http_requests_total[5m])", ValueType::Vector, "irate")
  let _ = assert_parse_ok("increase(http_requests_total[1h])", ValueType::Vector, "increase")
  let _ = assert_parse_ok("delta(temperature[10m])", ValueType::Vector, "delta")
  let _ = assert_parse_ok("idelta(temperature[10m])", ValueType::Vector, "idelta")
  let _ = assert_parse_ok("avg_over_time(cpu_usage[5m])", ValueType::Vector, "avg_over_time")
  let _ = assert_parse_ok("sum_over_time(bytes_total[15m])", ValueType::Vector, "sum_over_time")
  let _ = assert_parse_ok("quantile_over_time(0.99, latency[5m])", ValueType::Vector, "quantile_over_time")
  let _ = assert_parse_ok("histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket[5m])))", ValueType::Vector, "histogram_quantile")
  let _ = assert_parse_ok("absent(up{job=\"api\"})", ValueType::Vector, "absent")
  let _ = assert_parse_ok("label_replace(up, \"host\", \"$1\", \"instance\", \"(.*):.*\")", ValueType::Vector, "label_replace")
  let _ = assert_parse_ok("label_join(up, \"dst\", \",\", \"job\", \"instance\")", ValueType::Vector, "label_join")
  let _ = assert_parse_ok("clamp(cpu, 0, 100)", ValueType::Vector, "clamp")
  let _ = assert_parse_ok("round(cpu, 0.1)", ValueType::Vector, "round 2 args")
  let _ = assert_parse_ok("round(cpu)", ValueType::Vector, "round 1 arg")
  let _ = assert_parse_ok("sort(cpu)", ValueType::Vector, "sort")
  let _ = assert_parse_ok("sort_desc(cpu)", ValueType::Vector, "sort_desc")
  let _ = assert_parse_ok("time()", ValueType::Scalar, "time()")
  let _ = assert_parse_ok("vector(1)", ValueType::Vector, "vector(1)")
  let _ = assert_parse_ok("scalar(up)", ValueType::Scalar, "scalar(up)")

  // Semantic validation errors
  assert_parse_err_kind("{job=~\".*\"}", PromqlErrorKind::SemanticError, "empty-matching regex selector rejected")
  assert_parse_err_kind("{job!=\"foo\"}", PromqlErrorKind::SemanticError, "only != matcher rejected")
  assert_parse_err_kind("{}", PromqlErrorKind::SemanticError, "empty braces rejected")
  assert_parse_err_kind("rate(http_requests_total)", PromqlErrorKind::SemanticError, "rate requires range vector")
  assert_parse_err_kind("sum(http_requests_total[5m])", PromqlErrorKind::SemanticError, "sum requires instant vector")
  assert_parse_err_kind("a + bool b", PromqlErrorKind::SemanticError, "bool only on comparison")
  assert_parse_err_kind("a and group_left b", PromqlErrorKind::SemanticError, "group_left disallowed on set op")
  assert_parse_err_kind("a + on(job) group_left(job) b", PromqlErrorKind::SemanticError, "group_left label cannot be in on()")
  assert_parse_err_kind("a + on(job, job) b", PromqlErrorKind::SemanticError, "duplicate label in on()")
  assert_parse_err_kind("sum by (a) (x) without (b)", PromqlErrorKind::SemanticError, "both prefix and suffix grouping")
  assert_parse_err_kind("unknown_func(up)", PromqlErrorKind::SemanticError, "unknown function")
  assert_parse_err_kind("rate(a[5m], 1)", PromqlErrorKind::SemanticError, "wrong arity")
  assert_parse_err_kind("http_requests_total{job=~\"[invalid\"}", PromqlErrorKind::SemanticError, "invalid regex in matcher")
  assert_parse_err_kind("1 and 2", PromqlErrorKind::SemanticError, "set op requires vectors")
  assert_parse_err_kind("a + group_left b", PromqlErrorKind::SyntaxError, "group_left requires preceding on/ignoring")
}
