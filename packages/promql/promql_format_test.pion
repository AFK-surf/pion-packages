///| Canonical formatting (`format_expr`), multi-line prettifier (`prettify_expr`),
///| round-trip stability, and AST inspection (`extract_metric_names`, `inspect_selectors`).

fn must_parse(input : String) -> ParsedExpr {
  match parse_expr(input) {
    Ok(e) => e
    Err(err) => {
      debug_assert(false, "must_parse failed: " + err.to_string() + " for: " + input)
      ParsedExpr::{ nodes: [], root: -1, value_type: ValueType::None }
    }
  }
}

///|
test "promql_format_expr_canonical" {
  let e1 = must_parse("sum(rate(http_requests_total{job=\"api\",code=~\"5..\"}[5m])) by (job, code)")
  debug_assert(
    format_expr(e1) == "sum by (job, code) (rate(http_requests_total{code=~\"5..\",job=\"api\"}[5m]))",
    "canonical agg + rate format: got " + format_expr(e1),
  )

  let e2 = must_parse("histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))")
  debug_assert(
    format_expr(e2) == "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
    "canonical histogram_quantile format: got " + format_expr(e2),
  )

  let e3 = must_parse("a / on(instance) group_left(role) b")
  debug_assert(
    format_expr(e3) == "a / on (instance) group_left (role) b",
    "canonical vector matching format: got " + format_expr(e3),
  )

  let e4 = must_parse("http_requests_total offset 5m @ 1000")
  debug_assert(
    format_expr(e4) == "http_requests_total @ 1000.000 offset 5m",
    "canonical @ and offset format: got " + format_expr(e4),
  )

  // Round-trip: parse -> format -> parse -> format must be identical
  let cases : Array[String] = [
    "up{job=\"prometheus\"}",
    "rate(http_requests_total{env=\"prod\"}[5m])[1h:1m]",
    "topk by (cluster) (5, sum by (cluster, service) (rate(errors_total[5m])))",
    "(a + b) * c ^ 2 ^ 3",
    "a == bool on (job) b",
    "metric @ start() offset -10m",
  ]
  let mut i = 0
  while i < cases.length() {
    let p1 = must_parse(cases[i])
    let s1 = format_expr(p1)
    let p2 = must_parse(s1)
    let s2 = format_expr(p2)
    debug_assert(s1 == s2, "round-trip mismatch: " + s1 + " vs " + s2)
    i = i + 1
  }
}

///|
test "promql_prettify_expr" {
  let e = must_parse("sum by (job) (rate(http_requests_total{job=\"api\"}[5m])) / sum by (job) (rate(http_requests_total[5m]))")
  let pretty = prettify_expr(e)
  debug_assert(pretty.length() > 0, "prettify non-empty")
  // Prettified output must re-parse to the exact same canonical form
  let reparsed = must_parse(pretty)
  debug_assert(
    format_expr(reparsed) == format_expr(e),
    "prettify round-trip mismatch:\npretty:\n" + pretty + "\norig: " + format_expr(e) + "\nreparsed: " + format_expr(reparsed),
  )
}

///|
test "promql_extract_metric_names_and_inspect_selectors" {
  let e = must_parse("sum by (job) (rate(http_errors_total{job=\"api\"}[5m])) / sum by (job) (rate(http_requests_total{job=\"api\",code!=\"404\"}[5m])) + up")
  let names = extract_metric_names(e)
  debug_assert(names.length() == 3, "expected 3 distinct metric names")
  debug_assert(names[0] == "http_errors_total", "metric 0")
  debug_assert(names[1] == "http_requests_total", "metric 1")
  debug_assert(names[2] == "up", "metric 2")

  let sels = inspect_selectors(e)
  debug_assert(sels.length() == 3, "expected 3 selectors")
  debug_assert(sels[0].range_ms == 300000L, "first selector has 5m range")
  debug_assert(sels[1].range_ms == 300000L, "second selector has 5m range")
  debug_assert(sels[2].range_ms == 0L, "third selector is instant")
}
