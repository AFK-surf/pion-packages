///| In-memory time series evaluation (`eval_instant`, `eval_range`) and
///| `PromqlLimits` safety tests.

fn approx_eq(a : Double, b : Double, eps : Double) -> Bool {
  let d = a - b
  let ad = if d < 0.0 { -d } else { d }
  ad <= eps
}

fn eval_scalar_ok(expr_str : String, store : SeriesStore, ts : Int64, expected : Double, msg : String) -> Unit {
  let expr = match parse_expr(expr_str) {
    Ok(e) => e
    Err(err) => {
      debug_assert(false, msg + " (parse err: " + err.to_string() + ")")
      return ()
    }
  }
  match eval_instant(expr, store, ts) {
    Ok(EvalValue::Scalar(v)) =>
    debug_assert(approx_eq(v, expected, 1e-6), msg + " (expected " + expected.to_string() + ", got " + v.to_string() + ")")
    Ok(_) => debug_assert(false, msg + " (expected Scalar)")
    Err(err) => debug_assert(false, msg + " (eval err: " + err.to_string() + ")")
  }
}

fn eval_vector_ok(expr_str : String, store : SeriesStore, ts : Int64, msg : String) -> Array[InstantSample] {
  let expr = match parse_expr(expr_str) {
    Ok(e) => e
    Err(err) => {
      debug_assert(false, msg + " (parse err: " + err.to_string() + ")")
      return []
    }
  }
  match eval_instant(expr, store, ts) {
    Ok(EvalValue::Vector(vs)) => vs
    Ok(_) => {
      debug_assert(false, msg + " (expected Vector)")
      []
    }
    Err(err) => {
      debug_assert(false, msg + " (eval err: " + err.to_string() + ")")
      []
    }
  }
}

///|
test "promql_eval_scalar_arithmetic_and_precedence" {
  let store = SeriesStore::new()
  eval_scalar_ok("1 + 2 * 3", store, 60000L, 7.0, "1 + 2 * 3 == 7")
  eval_scalar_ok("(1 + 2) * 3", store, 60000L, 9.0, "(1 + 2) * 3 == 9")
  eval_scalar_ok("2 ^ 3 ^ 2", store, 60000L, 512.0, "2 ^ 3 ^ 2 == 512")
  eval_scalar_ok("-2 ^ 2", store, 60000L, -4.0, "-2 ^ 2 == -4")
  eval_scalar_ok("2 ^ -3", store, 60000L, 0.125, "2 ^ -3 == 0.125")
  eval_scalar_ok("10 % 3", store, 60000L, 1.0, "10 % 3 == 1")
  eval_scalar_ok("5 > bool 3", store, 60000L, 1.0, "5 > bool 3 == 1")
  eval_scalar_ok("5 < bool 3", store, 60000L, 0.0, "5 < bool 3 == 0")
  eval_scalar_ok("time()", store, 1700000000000L, 1700000000.0, "time() returns eval_ts in seconds")
}

///|
test "promql_eval_selectors_regex_matching_and_set_ops" {
  let store = SeriesStore::new()
  store.add_metric("http_requests_total", [("job", "api"), ("instance", "a1"), ("code", "200")], [(60000L, 100.0)])
  store.add_metric("http_requests_total", [("job", "api"), ("instance", "a2"), ("code", "500")], [(60000L, 20.0)])
  store.add_metric("http_requests_total", [("job", "web"), ("instance", "w1"), ("code", "200")], [(60000L, 50.0)])
  store.add_metric("node_role", [("instance", "a1"), ("role", "primary")], [(60000L, 1.0)])
  store.add_metric("node_role", [("instance", "a2"), ("role", "canary")], [(60000L, 1.0)])

  // Regex matcher =~ and !~
  let v_re = eval_vector_ok("http_requests_total{job=~\"api|web\", code!~\"5..\"}", store, 60000L, "regex filter")
  debug_assert(v_re.length() == 2, "expected 2 matching series, got " + v_re.length().to_string())

  // Comparison filter vs bool
  let v_gt = eval_vector_ok("http_requests_total > 40", store, 60000L, "vector > 40")
  debug_assert(v_gt.length() == 2, "2 series > 40")
  let v_bool = eval_vector_ok("http_requests_total > bool 40", store, 60000L, "vector > bool 40")
  debug_assert(v_bool.length() == 3, "bool preserves all 3 series")

  // N:1 group_left enrichment
  let v_gl = eval_vector_ok("http_requests_total * on(instance) group_left(role) node_role", store, 60000L, "group_left")
  debug_assert(v_gl.length() == 2, "group_left matches a1 and a2")
  let mut found_primary = false
  let mut i = 0
  while i < v_gl.length() {
    match v_gl[i].label("role") {
      Some("primary") => {
        found_primary = true
        debug_assert(approx_eq(v_gl[i].value, 100.0, 1e-6), "primary value == 100")
      }
      _ => ()
    }
    i = i + 1
  }
  debug_assert(found_primary, "group_left attached role=primary")

  // Set operations: and, or, unless
  let v_and = eval_vector_ok("http_requests_total and on(instance) node_role", store, 60000L, "and on(instance)")
  debug_assert(v_and.length() == 2, "and keeps a1, a2")
  let v_unless = eval_vector_ok("http_requests_total unless on(instance) node_role", store, 60000L, "unless on(instance)")
  debug_assert(v_unless.length() == 1, "unless keeps w1")
}

///|
test "promql_eval_aggregations" {
  let store = SeriesStore::new()
  store.add_metric("latency", [("job", "api"), ("inst", "1")], [(60000L, 10.0)])
  store.add_metric("latency", [("job", "api"), ("inst", "2")], [(60000L, 20.0)])
  store.add_metric("latency", [("job", "api"), ("inst", "3")], [(60000L, 30.0)])
  store.add_metric("latency", [("job", "web"), ("inst", "1")], [(60000L, 40.0)])

  let s_sum = eval_vector_ok("sum by (job) (latency)", store, 60000L, "sum by job")
  debug_assert(s_sum.length() == 2, "sum by job -> 2 groups")
  let s_avg = eval_vector_ok("avg(latency)", store, 60000L, "avg all")
  debug_assert(s_avg.length() == 1 && approx_eq(s_avg[0].value, 25.0, 1e-6), "avg == 25")
  let s_min = eval_vector_ok("min(latency)", store, 60000L, "min all")
  debug_assert(s_min.length() == 1 && approx_eq(s_min[0].value, 10.0, 1e-6), "min == 10")
  let s_max = eval_vector_ok("max(latency)", store, 60000L, "max all")
  debug_assert(s_max.length() == 1 && approx_eq(s_max[0].value, 40.0, 1e-6), "max == 40")
  let s_cnt = eval_vector_ok("count(latency)", store, 60000L, "count all")
  debug_assert(s_cnt.length() == 1 && approx_eq(s_cnt[0].value, 4.0, 1e-6), "count == 4")
  let s_topk = eval_vector_ok("topk(2, latency)", store, 60000L, "topk(2)")
  debug_assert(s_topk.length() == 2 && approx_eq(s_topk[0].value, 40.0, 1e-6) && approx_eq(s_topk[1].value, 30.0, 1e-6), "topk values")
  let s_botk = eval_vector_ok("bottomk(2, latency)", store, 60000L, "bottomk(2)")
  debug_assert(s_botk.length() == 2 && approx_eq(s_botk[0].value, 10.0, 1e-6) && approx_eq(s_botk[1].value, 20.0, 1e-6), "bottomk values")
  let s_q = eval_vector_ok("quantile(0.5, latency)", store, 60000L, "quantile 0.5")
  debug_assert(s_q.length() == 1 && approx_eq(s_q[0].value, 25.0, 1e-6), "median == 25")
  let s_var = eval_vector_ok("stdvar(latency)", store, 60000L, "stdvar")
  debug_assert(s_var.length() == 1 && approx_eq(s_var[0].value, 125.0, 1e-6), "stdvar == 125")
  let s_std = eval_vector_ok("stddev(latency)", store, 60000L, "stddev")
  debug_assert(s_std.length() == 1 && approx_eq(s_std[0].value, 11.180339887, 1e-5), "stddev == sqrt(125)")
  let s_cv = eval_vector_ok("count_values(\"val\", latency)", store, 60000L, "count_values")
  debug_assert(s_cv.length() == 4, "count_values -> 4 distinct values")
  let s_grp = eval_vector_ok("group by (job) (latency)", store, 60000L, "group by job")
  debug_assert(s_grp.length() == 2 && approx_eq(s_grp[0].value, 1.0, 1e-6), "group returns 1")
}

///|
test "promql_eval_rate_increase_over_time_and_histogram_quantile" {
  let store = SeriesStore::new()
  // Counter with 1 req/sec (60 per minute) from t=0 to t=300s (step 60s), plus a reset in another series
  store.add_metric(
    "http_requests_total",
    [("job", "api")],
    [
      (0L, 0.0),
      (60000L, 60.0),
      (120000L, 120.0),
      (180000L, 180.0),
      (240000L, 240.0),
      (300000L, 300.0),
    ],
  )
  // Counter with reset between 120s (100) and 180s (20) -> increase is 100 + 20 + 60 = 180 over 180s
  store.add_metric(
    "reset_counter",
    [("job", "api")],
    [
      (0L, 0.0),
      (60000L, 50.0),
      (120000L, 100.0),
      (180000L, 20.0),
      (240000L, 80.0),
    ],
  )
  // Gauge for delta / over_time
  store.add_metric(
    "temp",
    [("room", "a")],
    [
      (60000L, 20.0),
      (120000L, 25.0),
      (180000L, 30.0),
    ],
  )

  let r = eval_vector_ok("rate(http_requests_total[5m])", store, 300000L, "rate 5m")
  debug_assert(r.length() == 1 && approx_eq(r[0].value, 1.0, 1e-4), "rate == 1.0/s")

  let ir = eval_vector_ok("irate(http_requests_total[5m])", store, 300000L, "irate 5m")
  debug_assert(ir.length() == 1 && approx_eq(ir[0].value, 1.0, 1e-4), "irate == 1.0/s")

  let inc = eval_vector_ok("increase(http_requests_total[5m])", store, 300000L, "increase 5m")
  debug_assert(inc.length() == 1 && approx_eq(inc[0].value, 300.0, 1e-2), "increase == 300")

  let rr = eval_vector_ok("rate(reset_counter[4m])", store, 240000L, "rate with counter reset")
  debug_assert(rr.length() == 1 && rr[0].value > 0.7 && rr[0].value < 0.85, "reset rate ~ 0.75/s, got " + rr[0].value.to_string())

  let id = eval_vector_ok("idelta(temp[3m])", store, 180000L, "idelta")
  debug_assert(id.length() == 1 && approx_eq(id[0].value, 5.0, 1e-6), "idelta == 5")

  let aot = eval_vector_ok("avg_over_time(temp[3m])", store, 180000L, "avg_over_time")
  debug_assert(aot.length() == 1 && approx_eq(aot[0].value, 25.0, 1e-6), "avg_over_time == 25")

  let sot = eval_vector_ok("sum_over_time(temp[3m])", store, 180000L, "sum_over_time")
  debug_assert(sot.length() == 1 && approx_eq(sot[0].value, 75.0, 1e-6), "sum_over_time == 75")

  let qot = eval_vector_ok("quantile_over_time(0.5, temp[3m])", store, 180000L, "quantile_over_time")
  debug_assert(qot.length() == 1 && approx_eq(qot[0].value, 25.0, 1e-6), "quantile_over_time == 25")

  // Histogram quantile
  store.add_metric("req_dur_bucket", [("job", "api"), ("le", "0.1")], [(60000L, 10.0)])
  store.add_metric("req_dur_bucket", [("job", "api"), ("le", "0.5")], [(60000L, 50.0)])
  store.add_metric("req_dur_bucket", [("job", "api"), ("le", "1.0")], [(60000L, 90.0)])
  store.add_metric("req_dur_bucket", [("job", "api"), ("le", "+Inf")], [(60000L, 100.0)])
  // At phi=0.5 -> rank=50 -> upper bound of 0.5 bucket => 0.5
  let h50 = eval_vector_ok("histogram_quantile(0.5, req_dur_bucket)", store, 60000L, "histogram_quantile 0.5")
  debug_assert(h50.length() == 1 && approx_eq(h50[0].value, 0.5, 1e-6), "p50 == 0.5, got " + h50[0].value.to_string())
  // At phi=0.7 -> rank=70 -> 0.5 + (70-50)/(90-50)*(1.0-0.5) = 0.75
  let h70 = eval_vector_ok("histogram_quantile(0.7, req_dur_bucket)", store, 60000L, "histogram_quantile 0.7")
  debug_assert(h70.length() == 1 && approx_eq(h70[0].value, 0.75, 1e-6), "p70 == 0.75, got " + h70[0].value.to_string())
}

///|
test "promql_eval_utility_functions_and_range_eval" {
  let store = SeriesStore::new()
  store.add_metric("m", [("job", "api"), ("instance", "host1:8080")], [(60000L, -3.7), (120000L, 4.2)])
  store.add_metric("m", [("job", "web"), ("instance", "host2:9090")], [(60000L, 12.0), (120000L, 15.0)])

  let v_abs = eval_vector_ok("abs(m{job=\"api\"})", store, 60000L, "abs")
  debug_assert(v_abs.length() == 1 && approx_eq(v_abs[0].value, 3.7, 1e-6), "abs(-3.7) == 3.7")

  let v_clamp = eval_vector_ok("clamp(m{job=\"api\"}, 0, 10)", store, 60000L, "clamp")
  debug_assert(v_clamp.length() == 1 && approx_eq(v_clamp[0].value, 0.0, 1e-6), "clamp(-3.7, 0, 10) == 0")

  let v_round = eval_vector_ok("round(m{job=\"api\"}, 0.5)", store, 60000L, "round")
  debug_assert(v_round.length() == 1 && approx_eq(v_round[0].value, -3.5, 1e-6), "round(-3.7, 0.5) == -3.5")

  let v_abs_miss = eval_vector_ok("absent(nonexistent{job=\"x\"})", store, 60000L, "absent missing")
  debug_assert(v_abs_miss.length() == 1 && approx_eq(v_abs_miss[0].value, 1.0, 1e-6), "absent returns 1")
  let v_abs_hit = eval_vector_ok("absent(m{job=\"api\"})", store, 60000L, "absent present")
  debug_assert(v_abs_hit.length() == 0, "absent returns empty when present")

  let v_lr = eval_vector_ok("label_replace(m{job=\"api\"}, \"host\", \"$1\", \"instance\", \"(.*):.*\")", store, 60000L, "label_replace")
  debug_assert(v_lr.length() == 1, "label_replace 1 series")
  match v_lr[0].label("host") {
    Some("host1") => ()
    _ => debug_assert(false, "label_replace should set host=host1")
  }

  let v_lj = eval_vector_ok("label_join(m{job=\"api\"}, \"id\", \"/\", \"job\", \"instance\")", store, 60000L, "label_join")
  debug_assert(v_lj.length() == 1, "label_join 1 series")
  match v_lj[0].label("id") {
    Some("api/host1:8080") => ()
    _ => debug_assert(false, "label_join should set id=api/host1:8080")
  }

  let v_sort = eval_vector_ok("sort_desc(m)", store, 60000L, "sort_desc")
  debug_assert(v_sort.length() == 2 && v_sort[0].value > v_sort[1].value, "sort_desc order")

  // eval_range over [60000, 120000] step 60000
  let expr = match parse_expr("sum(m)") {
    Ok(e) => e
    Err(_) => {
      debug_assert(false, "parse sum(m)")
      return ()
    }
  }
  match eval_range(expr, store, 60000L, 120000L, 60000L) {
    Ok(mat) => {
      debug_assert(mat.series.length() == 1, "eval_range 1 series")
      debug_assert(mat.series[0].samples.length() == 2, "eval_range 2 steps")
      debug_assert(approx_eq(mat.series[0].samples[0].value, 8.3, 1e-6), "step 0 == 8.3")
      debug_assert(approx_eq(mat.series[0].samples[1].value, 19.2, 1e-6), "step 1 == 19.2")
    }
    Err(err) => debug_assert(false, "eval_range err: " + err.to_string())
  }
}

///|
test "promql_limits_depth_tokens_nodes_series_samples" {
  // Deeply nested parens -> LimitExceeded (no stack overflow!)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 200 {
    sb.write_string(")")
    i = i + 1
  }
  let tight_depth = PromqlLimits::new(32, 65536, 65536, 1000, 10000)
  match parse_expr_with_limits(sb.to_string(), tight_depth) {
    Ok(_) => debug_assert(false, "depth bomb should fail")
    Err(e) => debug_assert(e.is_kind(PromqlErrorKind::LimitExceeded), "depth bomb -> LimitExceeded, got " + e.to_string())
  }

  // Token limit
  let tight_tokens = PromqlLimits::new(128, 5, 65536, 1000, 10000)
  match parse_expr_with_limits("1 + 2 + 3 + 4", tight_tokens) {
    Ok(_) => debug_assert(false, "token limit should fail")
    Err(e) => debug_assert(e.is_kind(PromqlErrorKind::LimitExceeded), "token limit -> LimitExceeded")
  }

  // Node limit
  let tight_nodes = PromqlLimits::new(128, 65536, 3, 1000, 10000)
  match parse_expr_with_limits("1 + 2 + 3 + 4", tight_nodes) {
    Ok(_) => debug_assert(false, "node limit should fail")
    Err(e) => debug_assert(e.is_kind(PromqlErrorKind::LimitExceeded), "node limit -> LimitExceeded")
  }

  // Series limit during eval
  let store = SeriesStore::new()
  store.add_metric("m", [("i", "1")], [(60000L, 1.0)])
  store.add_metric("m", [("i", "2")], [(60000L, 2.0)])
  store.add_metric("m", [("i", "3")], [(60000L, 3.0)])
  let expr = match parse_expr("m") {
    Ok(e) => e
    Err(_) => {
      debug_assert(false, "parse m")
      return ()
    }
  }
  let tight_series = PromqlLimits::new(128, 65536, 65536, 2, 10000)
  match eval_instant_with_limits(expr, store, 60000L, tight_series) {
    Ok(_) => debug_assert(false, "series limit should fail")
    Err(e) => debug_assert(e.is_kind(PromqlErrorKind::LimitExceeded), "series limit -> LimitExceeded")
  }
}
