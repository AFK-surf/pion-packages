///| Head-to-head benchmark driver for `packages/promql` vs Go
///| `github.com/prometheus/prometheus/promql/parser`.

import "promql"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn fnv1a_str(h_in : Int64, s : String) -> Int64 {
  let mut h = h_in
  let n = s.length()
  let mut i = 0
  while i < n {
    h = ((h ^ s.code_unit_at(i).to_int64()) * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  h
}

fn fnv1a_i64(h_in : Int64, v : Int64) -> Int64 {
  let mut h = h_in
  h = ((h ^ (v & 0xFFL)) * 16777619L) & 0xFFFFFFFFL
  h = ((h ^ ((v >> 8) & 0xFFL)) * 16777619L) & 0xFFFFFFFFL
  h = ((h ^ ((v >> 16) & 0xFFL)) * 16777619L) & 0xFFFFFFFFL
  h = ((h ^ ((v >> 24) & 0xFFL)) * 16777619L) & 0xFFFFFFFFL
  h
}

///| W1: 20,000 real production alerting / Grafana dashboard PromQL parse + String() hash
fn run_w1(world : World, total_ops : Int) -> Int {
  let queries : Array[String] = [
    "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket{code!~\"5..\",job=~\"api|gateway\"}[5m])))",
    "sum by (service, cluster) (rate(http_requests_total{env=\"prod\",status=~\"5..\"}[5m])) / sum by (service, cluster) (rate(http_requests_total{env=\"prod\"}[5m]))",
    "max_over_time(rate(container_cpu_usage_seconds_total{container!=\"POD\",namespace=\"prod\"}[5m])[1h:1m])",
    "topk by (cluster) (10, sum by (cluster, pod) (container_memory_working_set_bytes{namespace=~\"prod-.*\"}))",
    "rate(node_network_receive_bytes_total{device!~\"lo|veth.*\"}[5m]) * on (instance) group_left (role, zone) node_meta_info",
    "avg without (instance) (rate(grpc_server_handled_total{grpc_code!=\"OK\"}[10m])) > 0.05",
    "sum by (job) (increase(payments_failed_total{region=~\"us-.*|eu-.*\"}[15m])) unless on (job) maintenance_window_active == 1",
    "quantile(0.99, rate(db_query_duration_seconds_sum{db=\"orders\"}[5m]) / rate(db_query_duration_seconds_count{db=\"orders\"}[5m]))",
    "label_replace(sum by (instance) (up{job=\"kube-apiserver\"}), \"host\", \"$1\", \"instance\", \"(.*):.*\")",
    "clamp_min(sum by (tenant) (rate(api_tokens_consumed_total[5m])) - on (tenant) group_left (tier) tenant_quota_limit, 0)",
  ]
  let nq = queries.length()
  let mut checksum : Int64 = 2166136261L
  let mut total_bytes : Int64 = 0L
  let mut i = 0
  while i < total_ops {
    let q = queries[i % nq]
    match promql::parse_expr(q) {
      Ok(expr) => {
        let s = promql::format_expr(expr)
        total_bytes = total_bytes + s.length().to_int64()
        checksum = fnv1a_str(checksum, s)
      }
      Err(e) => {
        io_println(world, "w1 parse error: " + e.to_string())
        return 1
      }
    }
    i = i + 1
  }
  io_println(
    world,
    "w1 ops=" + total_ops.to_string() + " bytes=" + total_bytes.to_string() + " fnv1a=" + checksum.to_string(),
  )
  0
}

///| W2: 50,000 Metric Selector parses + matcher/label extraction
fn run_w2(world : World, total_ops : Int) -> Int {
  let selectors : Array[String] = [
    "http_requests_total{job=\"api\",method=\"GET\",code=~\"2..\",env!=\"dev\"}[5m] offset 1h",
    "container_cpu_usage_seconds_total{namespace=\"prod\",pod=~\"web-[0-9]+\",container!~\"POD|\"}[15m] @ 1700000000",
    "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",cluster=\"tokyo-1\"} offset -5m",
    "grpc_server_handling_seconds_bucket{grpc_service=\"orders.v1.OrderService\",le=\"0.25\"}[10m]",
    "kube_pod_status_phase{namespace=~\"payments|billing\",phase=\"Running\",cluster=\"us-east\"} @ start()",
  ]
  let ns = selectors.length()
  let mut checksum : Int64 = 2166136261L
  let mut total_matchers : Int64 = 0L
  let mut i = 0
  while i < total_ops {
    let sel = selectors[i % ns]
    match promql::parse_expr(sel) {
      Ok(expr) => {
        let infos = promql::inspect_selectors(expr)
        let mut j = 0
        while j < infos.length() {
          let info = infos[j]
          total_matchers = total_matchers + info.matchers.length().to_int64()
          checksum = fnv1a_i64(checksum, info.range_ms)
          checksum = fnv1a_i64(checksum, info.offset_ms)
          let mut k = 0
          while k < info.matchers.length() {
            let m = info.matchers[k]
            checksum = fnv1a_str(checksum, m.name)
            checksum = fnv1a_str(checksum, promql::match_op_str(m.op))
            checksum = fnv1a_str(checksum, m.value)
            k = k + 1
          }
          j = j + 1
        }
      }
      Err(e) => {
        io_println(world, "w2 parse error: " + e.to_string())
        return 1
      }
    }
    i = i + 1
  }
  io_println(
    world,
    "w2 ops=" + total_ops.to_string() + " matchers=" + total_matchers.to_string() + " fnv1a=" + checksum.to_string(),
  )
  0
}

///| W3: In-memory time-series evaluation throughput (sum by (job) rate + histogram_quantile)
fn run_w3(world : World, iters : Int) -> Int {
  let store = promql::SeriesStore::new()
  let jobs : Array[String] = ["api", "web", "worker", "billing"]
  let le_vals : Array[String] = ["0.1", "0.25", "0.5", "1.0", "2.5", "+Inf"]
  let le_weights : Array[Double] = [15.0, 40.0, 70.0, 88.0, 96.0, 100.0]

  // Build 16 counter series (4 jobs x 4 instances) x 11 timestamps (0..600s step 60s)
  let mut j = 0
  while j < jobs.length() {
    let mut inst = 0
    while inst < 4 {
      let smps : Array[(Int64, Double)] = []
      let rate_per_min = ((j + 1) * 60 + inst * 15).to_double()
      let mut t = 0
      while t <= 10 {
        smps.push(((t * 60000).to_int64(), rate_per_min * t.to_double()))
        t = t + 1
      }
      store.add_metric(
        "http_requests_total",
        [("job", jobs[j]), ("instance", "inst-" + inst.to_string())],
        smps,
      )
      inst = inst + 1
    }
    // Build histogram bucket series (6 buckets per job) x 11 timestamps
    let mut b = 0
    while b < le_vals.length() {
      let smps : Array[(Int64, Double)] = []
      let scale = (j + 1).to_double()
      let mut t = 0
      while t <= 10 {
        smps.push(((t * 60000).to_int64(), le_weights[b] * scale * t.to_double()))
        t = t + 1
      }
      store.add_metric(
        "http_request_duration_seconds_bucket",
        [("job", jobs[j]), ("le", le_vals[b])],
        smps,
      )
      b = b + 1
    }
    j = j + 1
  }

  let e_rate = match promql::parse_expr("sum by (job) (rate(http_requests_total[5m]))") {
    Ok(e) => e
    Err(_) => return 1
  }
  let e_hq = match promql::parse_expr("histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket[5m])))") {
    Ok(e) => e
    Err(_) => return 2
  }

  let mut checksum : Int64 = 2166136261L
  let mut total_points : Int64 = 0L
  let mut it = 0
  while it < iters {
    let e_hq_it = match promql::parse_expr("histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket[5m])))") {
      Ok(e) => e
      Err(_) => return 2
    }
    // 1. eval_instant for histogram_quantile at t=600s
    match promql::eval_instant(e_hq_it, store, 600000L) {
      Ok(promql::EvalValue::Vector(vs)) => {
        // Sort by job ascending for deterministic cross-language hash parity
        let mut a = 1
        while a < vs.length() {
          let cur = vs[a]
          let cur_job = match cur.label("job") { Some(s) => s; None => "" }
          let mut b = a - 1
          while b >= 0 {
            let b_job = match vs[b].label("job") { Some(s) => s; None => "" }
            if b_job > cur_job {
              vs[b + 1] = vs[b]
              b = b - 1
            } else {
              break
            }
          }
          vs[b + 1] = cur
          a = a + 1
        }
        let mut k = 0
        while k < vs.length() {
          // Quantize to micro-units (1e6) for exact cross-language integer hash parity
          let q = (vs[k].value * 1000000.0 + 0.5).to_int64()
          checksum = fnv1a_i64(checksum, q)
          total_points = total_points + 1L
          k = k + 1
        }
      }
      _ => return 3
    }
    let e_rate_it = match promql::parse_expr("sum by (job) (rate(http_requests_total[5m]))") {
      Ok(e) => e
      Err(_) => return 1
    }
    // 2. eval_range for sum by (job) rate over [300s, 600s] step 60s (6 steps x 4 jobs = 24 points)
    match promql::eval_range(e_rate_it, store, 300000L, 600000L, 60000L) {
      Ok(mat) => {
        // Sort series by job ascending for deterministic cross-language hash parity
        let ser = mat.series
        let mut a = 1
        while a < ser.length() {
          let cur = ser[a]
          let mut cur_job = ""
          let mut li = 0
          while li < cur.labels.length() {
            if cur.labels[li].name == "job" { cur_job = cur.labels[li].value; break }
            li = li + 1
          }
          let mut b = a - 1
          while b >= 0 {
            let mut b_job = ""
            let mut lj = 0
            while lj < ser[b].labels.length() {
              if ser[b].labels[lj].name == "job" { b_job = ser[b].labels[lj].value; break }
              lj = lj + 1
            }
            if b_job > cur_job {
              ser[b + 1] = ser[b]
              b = b - 1
            } else {
              break
            }
          }
          ser[b + 1] = cur
          a = a + 1
        }
        let mut s = 0
        while s < ser.length() {
          let smps = ser[s].samples
          let mut p = 0
          while p < smps.length() {
            let q = (smps[p].value * 1000000.0 + 0.5).to_int64()
            checksum = fnv1a_i64(checksum, q)
            total_points = total_points + 1L
            p = p + 1
          }
          s = s + 1
        }
      }
      _ => return 4
    }
    it = it + 1
  }
  let _ = e_rate
  let _ = e_hq
  io_println(
    world,
    "w3 iters=" + iters.to_string() + " points=" + total_points.to_string() + " fnv1a=" + checksum.to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_promql <w1|w2|w3> [count]")
    return 1
  }
  let mode = args[1]
  let count = if args.length() >= 3 { parse_int_arg(args[2], 1000) } else { 1000 }
  if mode == "w1" {
    run_w1(world, count)
  } else if mode == "w2" {
    run_w2(world, count)
  } else if mode == "w3" {
    run_w3(world, count)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
