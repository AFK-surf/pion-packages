///| Public types, AST nodes, safety limits, errors, and in-memory time series
///| structures for `packages/promql`.

///| Error kind for PromQL lexing, parsing, validation, and evaluation.
pub enum PromqlErrorKind {
  SyntaxError
  SemanticError
  EvalError
  LimitExceeded
  InvalidLimits
  Unimplemented
}

///| Structured error returned by PromQL operations.
pub val struct PromqlError {
  pub kind : PromqlErrorKind
  pub pos : Int
  pub message : String
}

///| Construct a `PromqlError`.
pub fn PromqlError::new(
  kind : PromqlErrorKind,
  pos : Int,
  message : String,
) -> PromqlError {
  PromqlError::{ kind, pos, message }
}

///| Check whether `self` has the expected error kind.
pub fn PromqlError::is_kind(self : PromqlError, expected : PromqlErrorKind) -> Bool {
  error_kind_code(self.kind) == error_kind_code(expected)
}

///| Format a `PromqlError` as a human-readable string.
pub fn PromqlError::to_string(self : PromqlError) -> String {
  let prefix = error_kind_as_str(self.kind)
  if self.pos >= 0 {
    prefix + " at offset " + self.pos.to_string() + ": " + self.message
  } else {
    prefix + ": " + self.message
  }
}

fn error_kind_code(k : PromqlErrorKind) -> Int {
  match k {
    PromqlErrorKind::SyntaxError => 1
    PromqlErrorKind::SemanticError => 2
    PromqlErrorKind::EvalError => 3
    PromqlErrorKind::LimitExceeded => 4
    PromqlErrorKind::InvalidLimits => 5
    PromqlErrorKind::Unimplemented => 6
  }
}

///| Return a short string name for a `PromqlErrorKind`.
pub fn error_kind_as_str(k : PromqlErrorKind) -> String {
  match k {
    PromqlErrorKind::SyntaxError => "syntax error"
    PromqlErrorKind::SemanticError => "semantic error"
    PromqlErrorKind::EvalError => "eval error"
    PromqlErrorKind::LimitExceeded => "limit exceeded"
    PromqlErrorKind::InvalidLimits => "invalid limits"
    PromqlErrorKind::Unimplemented => "unimplemented"
  }
}

///| Configurable safety limits to prevent stack overflow and memory exhaustion
///| on both Native and Wasm32 targets.
pub val struct PromqlLimits {
  pub max_depth : Int
  pub max_tokens : Int
  pub max_nodes : Int
  pub max_series : Int
  pub max_samples : Int
}

///| Default safety limits.
pub fn PromqlLimits::default() -> PromqlLimits {
  PromqlLimits::{
    max_depth: 128,
    max_tokens: 65536,
    max_nodes: 65536,
    max_series: 10000,
    max_samples: 1000000,
  }
}

///| Construct custom `PromqlLimits`.
pub fn PromqlLimits::new(
  max_depth : Int,
  max_tokens : Int,
  max_nodes : Int,
  max_series : Int,
  max_samples : Int,
) -> PromqlLimits {
  PromqlLimits::{ max_depth, max_tokens, max_nodes, max_series, max_samples }
}

///| Maximum safe recursion depth guaranteed not to overflow Native or Wasm32 stacks.
pub fn max_safe_depth() -> Int {
  256
}

///| Validate that all limits are strictly positive and within safe stack ceilings.
pub fn validate_limits(limits : PromqlLimits) -> Result[Unit, PromqlError] {
  if limits.max_depth <= 0 {
    return Err(PromqlError::new(PromqlErrorKind::InvalidLimits, -1, "max_depth must be positive"))
  }
  if limits.max_depth > max_safe_depth() {
    return Err(
      PromqlError::new(
        PromqlErrorKind::InvalidLimits,
        -1,
        "max_depth exceeds safe ceiling (" + max_safe_depth().to_string() + ")",
      ),
    )
  }
  if limits.max_tokens <= 0 {
    return Err(PromqlError::new(PromqlErrorKind::InvalidLimits, -1, "max_tokens must be positive"))
  }
  if limits.max_nodes <= 0 {
    return Err(PromqlError::new(PromqlErrorKind::InvalidLimits, -1, "max_nodes must be positive"))
  }
  if limits.max_series <= 0 {
    return Err(PromqlError::new(PromqlErrorKind::InvalidLimits, -1, "max_series must be positive"))
  }
  if limits.max_samples <= 0 {
    return Err(PromqlError::new(PromqlErrorKind::InvalidLimits, -1, "max_samples must be positive"))
  }
  Ok(())
}

///| PromQL expression value type.
pub enum ValueType {
  None
  Scalar
  Vector
  Matrix
  String
}

///| Compare two `ValueType` values for equality.
pub fn value_type_eq(a : ValueType, b : ValueType) -> Bool {
  value_type_code(a) == value_type_code(b)
}

fn value_type_code(t : ValueType) -> Int {
  match t {
    ValueType::None => 0
    ValueType::Scalar => 1
    ValueType::Vector => 2
    ValueType::Matrix => 3
    ValueType::String => 4
  }
}

///| Format a `ValueType` as a Prometheus type name.
pub fn value_type_name(t : ValueType) -> String {
  match t {
    ValueType::None => "none"
    ValueType::Scalar => "scalar"
    ValueType::Vector => "instant vector"
    ValueType::Matrix => "range vector"
    ValueType::String => "string"
  }
}

///| Label matcher operator (`=`, `!=`, `=~`, `!~`).
pub enum MatchOp {
  Equal
  NotEqual
  RegexMatch
  RegexNotMatch
}

///| Compare two `MatchOp` values.
pub fn match_op_eq(a : MatchOp, b : MatchOp) -> Bool {
  match_op_code(a) == match_op_code(b)
}

fn match_op_code(op : MatchOp) -> Int {
  match op {
    MatchOp::Equal => 0
    MatchOp::NotEqual => 1
    MatchOp::RegexMatch => 2
    MatchOp::RegexNotMatch => 3
  }
}

///| Format a `MatchOp` as PromQL operator text.
pub fn match_op_str(op : MatchOp) -> String {
  match op {
    MatchOp::Equal => "="
    MatchOp::NotEqual => "!="
    MatchOp::RegexMatch => "=~"
    MatchOp::RegexNotMatch => "!~"
  }
}

///| A single label matcher in a vector selector.
pub val struct LabelMatcher {
  pub op : MatchOp
  pub name : String
  pub value : String
}

///| Construct a `LabelMatcher`.
pub fn LabelMatcher::new(op : MatchOp, name : String, value : String) -> LabelMatcher {
  LabelMatcher::{ op, name, value }
}

///| `@` modifier on a vector selector, matrix selector, or subquery.
pub enum AtModifier {
  None
  Timestamp(Int64)
  Start
  End
}

///| Unary operator (`+` or `-`).
pub enum UnaryOp {
  Plus
  Minus
}

///| Binary operator.
pub enum BinOp {
  Add
  Sub
  Mul
  Div
  Mod
  Pow
  Atan2
  Eql
  Neq
  Lte
  Lss
  Gte
  Gtr
  And
  Or
  Unless
}

///| Format a `BinOp` as its PromQL token string.
pub fn bin_op_str(op : BinOp) -> String {
  match op {
    BinOp::Add => "+"
    BinOp::Sub => "-"
    BinOp::Mul => "*"
    BinOp::Div => "/"
    BinOp::Mod => "%"
    BinOp::Pow => "^"
    BinOp::Atan2 => "atan2"
    BinOp::Eql => "=="
    BinOp::Neq => "!="
    BinOp::Lte => "<="
    BinOp::Lss => "<"
    BinOp::Gte => ">="
    BinOp::Gtr => ">"
    BinOp::And => "and"
    BinOp::Or => "or"
    BinOp::Unless => "unless"
  }
}

///| Check whether a binary operator is a comparison operator.
pub fn bin_op_is_comparison(op : BinOp) -> Bool {
  match op {
    BinOp::Eql => true
    BinOp::Neq => true
    BinOp::Lte => true
    BinOp::Lss => true
    BinOp::Gte => true
    BinOp::Gtr => true
    _ => false
  }
}

///| Check whether a binary operator is a set operator (`and`, `or`, `unless`).
pub fn bin_op_is_set(op : BinOp) -> Bool {
  match op {
    BinOp::And => true
    BinOp::Or => true
    BinOp::Unless => true
    _ => false
  }
}

///| Cardinality of vector matching on a binary expression.
pub enum VectorMatchCardinality {
  OneToOne
  ManyToOne
  OneToMany
  ManyToMany
}

///| Vector matching specification (`on`/`ignoring`, `group_left`/`group_right`).
pub struct VectorMatching {
  pub card : VectorMatchCardinality
  pub matching_labels : Array[String]
  pub on : Bool
  pub has_clause : Bool
  pub include_labels : Array[String]
}

///| Default 1:1 vector matching with no explicit clause.
pub fn VectorMatching::default() -> VectorMatching {
  VectorMatching::{
    card: VectorMatchCardinality::OneToOne,
    matching_labels: [],
    on: false,
    has_clause: false,
    include_labels: [],
  }
}

///| Aggregation operator (all 14 PromQL aggregators).
pub enum AggOp {
  Sum
  Min
  Max
  Avg
  Group
  Stddev
  Stdvar
  Count
  CountValues
  Bottomk
  Topk
  Quantile
  Limitk
  LimitRatio
}

///| Format an `AggOp` as its lowercase PromQL keyword.
pub fn agg_op_str(op : AggOp) -> String {
  match op {
    AggOp::Sum => "sum"
    AggOp::Min => "min"
    AggOp::Max => "max"
    AggOp::Avg => "avg"
    AggOp::Group => "group"
    AggOp::Stddev => "stddev"
    AggOp::Stdvar => "stdvar"
    AggOp::Count => "count"
    AggOp::CountValues => "count_values"
    AggOp::Bottomk => "bottomk"
    AggOp::Topk => "topk"
    AggOp::Quantile => "quantile"
    AggOp::Limitk => "limitk"
    AggOp::LimitRatio => "limit_ratio"
  }
}

///| Check whether an `AggOp` takes a parameter expression as its first argument.
pub fn agg_op_has_param(op : AggOp) -> Bool {
  match op {
    AggOp::CountValues => true
    AggOp::Bottomk => true
    AggOp::Topk => true
    AggOp::Quantile => true
    AggOp::Limitk => true
    AggOp::LimitRatio => true
    _ => false
  }
}

///| Arena-stored AST expression node.
pub enum ExprNode {
  NumberLiteral(Double)
  StringLiteral(String)
  VectorSelector(String, Array[LabelMatcher], Int64, AtModifier)
  MatrixSelector(Int, Int64)
  SubqueryExpr(Int, Int64, Int64, Int64, AtModifier)
  UnaryExpr(UnaryOp, Int)
  BinaryExpr(BinOp, Int, Int, Bool, VectorMatching)
  ParenExpr(Int)
  AggregateExpr(AggOp, Int, Int, Array[String], Bool, Bool)
  Call(String, Array[Int], ValueType)
}

///| Parsed PromQL AST stored in a flat node arena.
pub struct ParsedExpr {
  pub nodes : Array[ExprNode]
  pub root : Int
  pub value_type : ValueType
}

///| Return the number of AST nodes in the parsed expression.
pub fn ParsedExpr::node_count(self : ParsedExpr) -> Int {
  self.nodes.length()
}

///| Return the statically inferred `ValueType` of the root expression.
pub fn ParsedExpr::root_type(self : ParsedExpr) -> ValueType {
  self.value_type
}

///| Summary of a vector or matrix selector discovered by `inspect_selectors`.
pub struct SelectorInfo {
  pub metric_name : String
  pub matchers : Array[LabelMatcher]
  pub range_ms : Int64
  pub offset_ms : Int64
  pub at_mod : AtModifier
}

///| A single label key-value pair on a time series.
pub val struct Label {
  pub name : String
  pub value : String
}

///| Construct a `Label`.
pub fn Label::new(name : String, value : String) -> Label {
  Label::{ name, value }
}

///| A single timestamped float64 sample.
pub val struct Sample {
  pub timestamp_ms : Int64
  pub value : Double
}

///| Construct a `Sample`.
pub fn Sample::new(timestamp_ms : Int64, value : Double) -> Sample {
  Sample::{ timestamp_ms, value }
}

///| A time series with labels and timestamp-ordered samples.
pub struct Series {
  pub labels : Array[Label]
  pub samples : Array[Sample]
}

///| Construct a `Series` from label pairs and samples (labels are sorted by name).
pub fn Series::new(labels : Array[Label], samples : Array[Sample]) -> Series {
  let sorted = sort_labels(labels)
  Series::{ labels: sorted, samples }
}

///| Sort labels ascending by name (insertion sort; series typically have <20 labels).
pub fn sort_labels(labels : Array[Label]) -> Array[Label] {
  let out : Array[Label] = []
  let mut i = 0
  while i < labels.length() {
    out.push(labels[i])
    i = i + 1
  }
  let mut k = 1
  while k < out.length() {
    let cur = out[k]
    let mut j = k - 1
    while j >= 0 && out[j].name > cur.name {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
    k = k + 1
  }
  out
}

///| In-memory time series store for PromQL evaluation.
pub struct SeriesStore {
  pub series : Array[Series]
  pub lookback_delta_ms : Int64
}

///| Create an empty `SeriesStore` with the default 5m (300,000 ms) lookback delta.
pub fn SeriesStore::new() -> SeriesStore {
  SeriesStore::{ series: [], lookback_delta_ms: 300000L }
}

///| Create a `SeriesStore` with a custom lookback delta in milliseconds.
pub fn SeriesStore::with_lookback(lookback_delta_ms : Int64) -> SeriesStore {
  SeriesStore::{ series: [], lookback_delta_ms }
}

///| Add a series to the store (returns a new store sharing the mutated array).
pub fn SeriesStore::add_series(self : SeriesStore, s : Series) -> Unit {
  self.series.push(s)
}

///| Convenience helper to add a metric series from `(name, value)` label pairs
///| and `(timestamp_ms, value)` sample pairs.
pub fn SeriesStore::add_metric(
  self : SeriesStore,
  metric_name : String,
  extra_labels : Array[(String, String)],
  samples : Array[(Int64, Double)],
) -> Unit {
  let labels : Array[Label] = []
  if metric_name.length() > 0 {
    labels.push(Label::new("__name__", metric_name))
  }
  let mut i = 0
  while i < extra_labels.length() {
    let (k, v) = extra_labels[i]
    labels.push(Label::new(k, v))
    i = i + 1
  }
  let s_arr : Array[Sample] = []
  let mut j = 0
  while j < samples.length() {
    let (ts, v) = samples[j]
    s_arr.push(Sample::new(ts, v))
    j = j + 1
  }
  self.series.push(Series::new(labels, s_arr))
}

///| A single evaluated instant vector element.
pub struct InstantSample {
  pub labels : Array[Label]
  pub timestamp_ms : Int64
  pub value : Double
}

///| Construct an `InstantSample`.
pub fn InstantSample::new(
  labels : Array[Label],
  timestamp_ms : Int64,
  value : Double,
) -> InstantSample {
  InstantSample::{ labels, timestamp_ms, value }
}

///| Look up a label value on an `InstantSample`.
pub fn InstantSample::label(self : InstantSample, name : String) -> Option[String] {
  let mut i = 0
  while i < self.labels.length() {
    if self.labels[i].name == name {
      return Some(self.labels[i].value)
    }
    i = i + 1
  }
  None
}

///| A single evaluated range vector / matrix series.
pub struct RangeSeries {
  pub labels : Array[Label]
  pub samples : Array[Sample]
}

///| Result of `eval_instant`.
pub enum EvalValue {
  Scalar(Double)
  Vector(Array[InstantSample])
  Matrix(Array[RangeSeries])
  StringVal(String)
}

///| Result of `eval_range`.
pub struct EvalMatrix {
  pub series : Array[RangeSeries]
}
