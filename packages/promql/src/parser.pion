///| PromQL recursive-descent + Pratt parser and static semantic validator.

import "regex"

struct Parser {
  lexer : Lexer
  mut cur : LexTok
  mut next_tok : LexTok
  mut has_next : Bool
  mut lex_err : Option[PromqlError]
  nodes : Array[ExprNode]
  types : Array[ValueType]
  limits : PromqlLimits
  mut depth : Int
}

fn Parser::new(input : String, limits : PromqlLimits) -> Result[Parser, PromqlError] {
  let lex = Lexer::new(input, limits.max_tokens)
  let first = match lex.next_tok() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  Ok(
    Parser::{
      lexer: lex,
      cur: first,
      next_tok: eof_lex_tok(lex.len),
      has_next: false,
      lex_err: None,
      nodes: [],
      types: [],
      limits,
      depth: 0,
    },
  )
}

fn Parser::peek(self : Parser) -> LexTok {
  self.cur
}

fn Parser::peek_next(self : Parser) -> LexTok {
  if !self.has_next {
    match self.lex_err {
      Some(_) => {
        self.next_tok = eof_lex_tok(self.lexer.len)
        self.has_next = true
      }
      None =>
      match self.lexer.next_tok() {
        Ok(t) => {
          self.next_tok = t
          self.has_next = true
        }
        Err(e) => {
          self.lex_err = Some(e)
          self.next_tok = eof_lex_tok(self.lexer.len)
          self.has_next = true
        }
      }
    }
  }
  self.next_tok
}

fn Parser::advance(self : Parser) -> LexTok {
  let prev = self.cur
  if self.has_next {
    self.cur = self.next_tok
    self.has_next = false
  } else {
    match self.lex_err {
      Some(_) => self.cur = eof_lex_tok(self.lexer.len)
      None =>
      match self.lexer.next_tok() {
        Ok(t) => self.cur = t
        Err(e) => {
          self.lex_err = Some(e)
          self.cur = eof_lex_tok(self.lexer.len)
        }
      }
    }
  }
  prev
}

fn Parser::push_node(self : Parser, node : ExprNode, vt : ValueType, pos : Int) -> Result[Int, PromqlError] {
  if self.nodes.length() >= self.limits.max_nodes {
    return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, pos, "max_nodes exceeded"))
  }
  let id = self.nodes.length()
  self.nodes.push(node)
  self.types.push(vt)
  Ok(id)
}

fn Parser::enter_depth(self : Parser, pos : Int) -> Result[Unit, PromqlError] {
  self.depth = self.depth + 1
  if self.depth > self.limits.max_depth {
    return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, pos, "max_depth exceeded"))
  }
  Ok(())
}

fn Parser::leave_depth(self : Parser) -> Unit {
  if self.depth > 0 {
    self.depth = self.depth - 1
  }
}

fn tok_is_eof(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::Eof => true
    _ => false
  }
}

fn tok_is_lparen(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::LParen => true
    _ => false
  }
}

fn tok_is_rparen(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::RParen => true
    _ => false
  }
}

fn tok_is_lbrace(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::LBrace => true
    _ => false
  }
}

fn tok_is_rbrace(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::RBrace => true
    _ => false
  }
}

fn tok_is_lbracket(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::LBracket => true
    _ => false
  }
}

fn tok_is_rbracket(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::RBracket => true
    _ => false
  }
}

fn tok_is_comma(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::Comma => true
    _ => false
  }
}

fn tok_is_colon(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::Colon => true
    _ => false
  }
}

fn tok_is_at(t : LexTok) -> Bool {
  match t.kind {
    TokenKind::At => true
    _ => false
  }
}

fn eq_ascii_ci(s : String, lower_kw : String) -> Bool {
  let n = lower_kw.length()
  if s.length() != n {
    return false
  }
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    let lb = if b >= 65 && b <= 90 { b + 32 } else { b }
    if lb != lower_kw.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn tok_is_ident_kw(t : LexTok, kw : String) -> Bool {
  match t.kind {
    TokenKind::Ident => eq_ascii_ci(t.text, kw)
    _ => false
  }
}

fn match_agg_op(s : String) -> Option[AggOp] {
  let n = s.length()
  if n < 3 || n > 12 {
    return None
  }
  let c0 = s.code_unit_at(0) | 32
  if c0 == 115 {
    // s: sum, stddev, stdvar
    if n == 3 && eq_ascii_ci(s, "sum") {
      Some(AggOp::Sum)
    } else if n == 6 && eq_ascii_ci(s, "stddev") {
      Some(AggOp::Stddev)
    } else if n == 6 && eq_ascii_ci(s, "stdvar") {
      Some(AggOp::Stdvar)
    } else {
      None
    }
  } else if c0 == 109 {
    // m: min, max
    if n == 3 && eq_ascii_ci(s, "min") {
      Some(AggOp::Min)
    } else if n == 3 && eq_ascii_ci(s, "max") {
      Some(AggOp::Max)
    } else {
      None
    }
  } else if c0 == 97 {
    // a: avg
    if n == 3 && eq_ascii_ci(s, "avg") {
      Some(AggOp::Avg)
    } else {
      None
    }
  } else if c0 == 99 {
    // c: count, count_values
    if n == 5 && eq_ascii_ci(s, "count") {
      Some(AggOp::Count)
    } else if n == 12 && eq_ascii_ci(s, "count_values") {
      Some(AggOp::CountValues)
    } else {
      None
    }
  } else if c0 == 116 {
    // t: topk
    if n == 4 && eq_ascii_ci(s, "topk") {
      Some(AggOp::Topk)
    } else {
      None
    }
  } else if c0 == 113 {
    // q: quantile
    if n == 8 && eq_ascii_ci(s, "quantile") {
      Some(AggOp::Quantile)
    } else {
      None
    }
  } else if c0 == 103 {
    // g: group
    if n == 5 && eq_ascii_ci(s, "group") {
      Some(AggOp::Group)
    } else {
      None
    }
  } else if c0 == 98 {
    // b: bottomk
    if n == 7 && eq_ascii_ci(s, "bottomk") {
      Some(AggOp::Bottomk)
    } else {
      None
    }
  } else if c0 == 108 {
    // l: limitk, limit_ratio
    if n == 6 && eq_ascii_ci(s, "limitk") {
      Some(AggOp::Limitk)
    } else if n == 11 && eq_ascii_ci(s, "limit_ratio") {
      Some(AggOp::LimitRatio)
    } else {
      None
    }
  } else {
    None
  }
}

val struct BinOpInfo {
  valid : Bool
  op : BinOp
  prec : Int
  right_assoc : Bool
}

fn bin_op_none() -> BinOpInfo {
  BinOpInfo::{ valid: false, op: BinOp::Add, prec: 0, right_assoc: false }
}

fn peek_bin_op(t : LexTok) -> BinOpInfo {
  match t.kind {
    TokenKind::Pow => BinOpInfo::{ valid: true, op: BinOp::Pow, prec: 6, right_assoc: true }
    TokenKind::Mul => BinOpInfo::{ valid: true, op: BinOp::Mul, prec: 5, right_assoc: false }
    TokenKind::Div => BinOpInfo::{ valid: true, op: BinOp::Div, prec: 5, right_assoc: false }
    TokenKind::Mod => BinOpInfo::{ valid: true, op: BinOp::Mod, prec: 5, right_assoc: false }
    TokenKind::Plus => BinOpInfo::{ valid: true, op: BinOp::Add, prec: 4, right_assoc: false }
    TokenKind::Minus => BinOpInfo::{ valid: true, op: BinOp::Sub, prec: 4, right_assoc: false }
    TokenKind::Eql => BinOpInfo::{ valid: true, op: BinOp::Eql, prec: 3, right_assoc: false }
    TokenKind::Neq => BinOpInfo::{ valid: true, op: BinOp::Neq, prec: 3, right_assoc: false }
    TokenKind::Lte => BinOpInfo::{ valid: true, op: BinOp::Lte, prec: 3, right_assoc: false }
    TokenKind::Lss => BinOpInfo::{ valid: true, op: BinOp::Lss, prec: 3, right_assoc: false }
    TokenKind::Gte => BinOpInfo::{ valid: true, op: BinOp::Gte, prec: 3, right_assoc: false }
    TokenKind::Gtr => BinOpInfo::{ valid: true, op: BinOp::Gtr, prec: 3, right_assoc: false }
    TokenKind::Ident => {
      let n = t.text.length()
      if n == 2 && eq_ascii_ci(t.text, "or") {
        BinOpInfo::{ valid: true, op: BinOp::Or, prec: 1, right_assoc: false }
      } else if n == 3 && eq_ascii_ci(t.text, "and") {
        BinOpInfo::{ valid: true, op: BinOp::And, prec: 2, right_assoc: false }
      } else if n == 5 && eq_ascii_ci(t.text, "atan2") {
        BinOpInfo::{ valid: true, op: BinOp::Atan2, prec: 5, right_assoc: false }
      } else if n == 6 && eq_ascii_ci(t.text, "unless") {
        BinOpInfo::{ valid: true, op: BinOp::Unless, prec: 2, right_assoc: false }
      } else {
        bin_op_none()
      }
    }
    _ => bin_op_none()
  }
}

fn str_list_contains(xs : Array[String], target : String) -> Bool {
  let mut i = 0
  while i < xs.length() {
    if xs[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

///| Preprocess a PromQL/RE2 regex pattern for compatibility with `packages/regex`:
///| - Enforce RE2 max repeat count of 1000 (`{m,n}` where m > 1000 or n > 1000 or n < m).
///| - Reject nested repetitions (`a**`, `a++`, `a+*`, etc.) while allowing non-greedy (`*?`, `+?`, `??`, `{m,n}?`).
///| - Escape `{` that does not form a valid `{m}`, `{m,}`, or `{m,n}` quantifier (RE2 treats them as literals).
fn preprocess_re2_pattern(pat : String) -> Result[String, String] {
  let n = pat.length()
  let sb = StringBuilder::new()
  let mut i = 0
  let mut in_class = false
  let mut class_start = false
  // prev_quant: 0 = none, 1 = greedy quantifier (*, +, ?, {m,n}), 2 = non-greedy quantifier (*?, etc.)
  let mut prev_quant = 0
  while i < n {
    let b = pat.code_unit_at(i)
    if b == 92 {
      // Backslash escape
      if i + 1 < n && pat.code_unit_at(i + 1) == 81 && !in_class {
        // \Q ... \E literal quote
        sb.write_byte(92.to_byte())
        sb.write_byte(81.to_byte())
        i = i + 2
        while i < n {
          if pat.code_unit_at(i) == 92 && i + 1 < n && pat.code_unit_at(i + 1) == 69 {
            sb.write_byte(92.to_byte())
            sb.write_byte(69.to_byte())
            i = i + 2
            break
          }
          sb.write_byte(pat.code_unit_at(i).to_byte())
          i = i + 1
        }
        prev_quant = 0
        continue
      }
      sb.write_byte(92.to_byte())
      if i + 1 < n {
        sb.write_byte(pat.code_unit_at(i + 1).to_byte())
        i = i + 2
      } else {
        i = i + 1
      }
      prev_quant = 0
      class_start = false
      continue
    }
    if in_class {
      if b == 93 && !class_start {
        in_class = false
      } else if b == 94 && class_start {
        // Leading ^ in [^...] keeps class_start true so `[^]]` works
        sb.write_byte(b.to_byte())
        i = i + 1
        continue
      }
      class_start = false
      sb.write_byte(b.to_byte())
      i = i + 1
      prev_quant = 0
      continue
    }
    if b == 91 {
      // '[' enters character class
      in_class = true
      class_start = true
      sb.write_byte(b.to_byte())
      i = i + 1
      prev_quant = 0
      continue
    }
    if b == 123 {
      // '{': check if valid RE2 quantifier `{m}`, `{m,}`, `{m,n}`
      let mut j = i + 1
      let mut m_val = 0
      let mut m_digits = 0
      while j < n && is_ascii_digit(pat.code_unit_at(j)) {
        if m_val <= 10000 {
          m_val = m_val * 10 + (pat.code_unit_at(j) - 48)
        }
        m_digits = m_digits + 1
        j = j + 1
      }
      let mut is_quant = false
      let mut has_comma = false
      let mut has_n = false
      let mut n_val = 0
      if m_digits > 0 && j < n {
        if pat.code_unit_at(j) == 125 {
          // {m}
          is_quant = true
          j = j + 1
        } else if pat.code_unit_at(j) == 44 {
          has_comma = true
          j = j + 1
          let mut n_digits = 0
          while j < n && is_ascii_digit(pat.code_unit_at(j)) {
            if n_val <= 10000 {
              n_val = n_val * 10 + (pat.code_unit_at(j) - 48)
            }
            n_digits = n_digits + 1
            j = j + 1
          }
          if j < n && pat.code_unit_at(j) == 125 {
            is_quant = true
            has_n = n_digits > 0
            j = j + 1
          }
        }
      }
      if is_quant {
        if prev_quant != 0 {
          return Err("invalid nested repetition operator")
        }
        if m_val > 1000 || (has_n && (n_val > 1000 || n_val < m_val)) {
          return Err("invalid repeat count")
        }
        let _ = has_comma
        sb.write_string(pat.slice(i, j))
        i = j
        prev_quant = 1
      } else {
        // Literal '{' in RE2
        sb.write_string("\\{")
        i = i + 1
        prev_quant = 0
      }
      continue
    }
    if b == 42 || b == 43 || b == 63 {
      // '*', '+', '?'
      if prev_quant == 1 && b == 63 {
        // Non-greedy modifier (*?, +?, ??, {m,n}?)
        sb.write_byte(b.to_byte())
        i = i + 1
        prev_quant = 2
      } else if prev_quant != 0 {
        return Err("invalid nested repetition operator")
      } else {
        sb.write_byte(b.to_byte())
        i = i + 1
        prev_quant = 1
      }
      continue
    }
    sb.write_byte(b.to_byte())
    i = i + 1
    prev_quant = 0
  }
  Ok(sb.to_string())
}

///| Compile a PromQL anchored regex `^(?s:pattern)$` (with RE2 compatibility) to validate syntax and match.
pub fn compile_promql_regex(pattern : String) -> Result[regex::Regex, String] {
  let pre = match preprocess_re2_pattern(pattern) {
    Ok(p) => p
    Err(msg) => return Err(msg)
  }
  match regex::compile("^(?s:" + pre + ")$") {
    Ok(re) => Ok(re)
    Err(_) => Err("invalid regular expression: " + pattern)
  }
}

///| Zero-allocation linear-time validator and empty-match checker for the common safe
///| PromQL/RE2 regex subset: ASCII literals, `.`, simple ASCII character classes `[...]`,
///| single quantifiers `*` / `+` / `?`, and top-level `|` alternations.
///|
///| Returns `0` (valid, does not match `""`), `1` (valid, matches `""`), or `-1` (fallback).
fn fast_regex_matches_empty(pat : String) -> Int {
  let n = pat.length()
  let mut i = 0
  let mut any_branch_empty = false
  let mut branch_empty = true
  while i < n {
    let b = pat.code_unit_at(i)
    if b == 124 {
      if branch_empty {
        any_branch_empty = true
      }
      branch_empty = true
      i = i + 1
      continue
    }
    if b == 91 {
      // '[' simple ASCII character class
      i = i + 1
      if i < n && pat.code_unit_at(i) == 94 {
        i = i + 1
      }
      let mut items = 0
      let mut has_prev = false
      let mut prev_c = 0
      let mut closed = false
      while i < n {
        let cb = pat.code_unit_at(i)
        if cb == 93 && items > 0 {
          closed = true
          i = i + 1
          break
        }
        if cb < 32 || cb >= 127 || cb == 92 || cb == 91 || cb == 93 {
          return -1
        }
        if cb == 45 && has_prev && i + 1 < n && pat.code_unit_at(i + 1) != 93 {
          let next_c = pat.code_unit_at(i + 1)
          if next_c < 32 || next_c >= 127 || next_c == 92 || next_c == 91 || next_c == 45 || prev_c > next_c {
            return -1
          }
          i = i + 2
          has_prev = false
          items = items + 1
        } else {
          if cb == 45 && items == 0 && i + 1 < n && pat.code_unit_at(i + 1) == 45 {
            return -1
          }
          prev_c = cb
          has_prev = true
          items = items + 1
          i = i + 1
        }
      }
      if !closed {
        return -1
      }
    } else if b == 46 {
      i = i + 1
    } else if b < 32 || b >= 127 || b == 92 || b == 40 || b == 41 || b == 123 || b == 125 || b == 93 || b == 94 || b == 36 || b == 42 || b == 43 || b == 63 {
      return -1
    } else {
      i = i + 1
    }
    let mut nullable_atom = false
    if i < n {
      let q = pat.code_unit_at(i)
      if q == 42 || q == 63 {
        nullable_atom = true
        i = i + 1
      } else if q == 43 {
        i = i + 1
      }
      if i < n {
        let q2 = pat.code_unit_at(i)
        if q2 == 42 || q2 == 43 || q2 == 63 || q2 == 123 {
          return -1
        }
      }
    }
    if !nullable_atom {
      branch_empty = false
    }
  }
  if branch_empty {
    any_branch_empty = true
  }
  if any_branch_empty { 1 } else { 0 }
}

fn matcher_matches_empty(m : LabelMatcher) -> Result[Bool, PromqlError] {
  match m.op {
    MatchOp::Equal => Ok(m.value.length() == 0)
    MatchOp::NotEqual => Ok(m.value.length() != 0)
    MatchOp::RegexMatch => {
      let fast = fast_regex_matches_empty(m.value)
      if fast >= 0 {
        return Ok(fast == 1)
      }
      match compile_promql_regex(m.value) {
        Ok(re) => Ok(re.is_match(""))
        Err(msg) => Err(PromqlError::new(PromqlErrorKind::SemanticError, -1, "invalid regex in matcher: " + msg))
      }
    }
    MatchOp::RegexNotMatch => {
      let fast = fast_regex_matches_empty(m.value)
      if fast >= 0 {
        return Ok(fast == 0)
      }
      match compile_promql_regex(m.value) {
        Ok(re) => Ok(!re.is_match(""))
        Err(msg) => Err(PromqlError::new(PromqlErrorKind::SemanticError, -1, "invalid regex in matcher: " + msg))
      }
    }
  }
}

fn validate_matchers(matchers : Array[LabelMatcher], pos : Int) -> Result[Unit, PromqlError] {
  if matchers.length() == 0 {
    return Err(PromqlError::new(PromqlErrorKind::SemanticError, pos, "vector selector must contain at least one non-empty matcher"))
  }
  let mut has_non_empty = false
  let mut i = 0
  while i < matchers.length() {
    match matcher_matches_empty(matchers[i]) {
      Ok(matches_empty) => {
        if !matches_empty {
          has_non_empty = true
        }
      }
      Err(e) => return Err(PromqlError::new(e.kind, pos, e.message))
    }
    i = i + 1
  }
  if !has_non_empty {
    return Err(PromqlError::new(PromqlErrorKind::SemanticError, pos, "vector selector must contain at least one non-empty matcher"))
  }
  Ok(())
}

fn Parser::parse_label_list(self : Parser) -> Result[Array[String], PromqlError] {
  if !tok_is_lparen(self.peek()) {
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected '(' for label list"))
  }
  let _ = self.advance()
  let labels : Array[String] = []
  while !tok_is_rparen(self.peek()) && !tok_is_eof(self.peek()) {
    let t = self.peek()
    let name = match t.kind {
      TokenKind::Ident => {
        let _ = self.advance()
        t.text
      }
      TokenKind::StringLit => {
        let _ = self.advance()
        t.text
      }
      _ => return Err(PromqlError::new(PromqlErrorKind::SyntaxError, t.pos, "expected label name in label list"))
    }
    labels.push(name)
    if tok_is_comma(self.peek()) {
      let _ = self.advance()
    } else {
      break
    }
  }
  if !tok_is_rparen(self.peek()) {
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected ')' after label list"))
  }
  let _ = self.advance()
  Ok(labels)
}

fn Parser::parse_matchers_brace(
  self : Parser,
  metric_name : String,
) -> Result[Array[LabelMatcher], PromqlError] {
  let brace_pos = self.peek().pos
  let _ = self.advance() // consume '{'
  let matchers : Array[LabelMatcher] = []
  while !tok_is_rbrace(self.peek()) && !tok_is_eof(self.peek()) {
    let t = self.peek()
    // UTF-8 quoted metric name at any position inside `{...}` when not followed by a matcher op
    match t.kind {
      TokenKind::StringLit => {
        let next = self.peek_next()
        let is_matcher_op = match next.kind {
          TokenKind::Assign => true
          TokenKind::Neq => true
          TokenKind::EqlRegex => true
          TokenKind::NeqRegex => true
          _ => false
        }
        if !is_matcher_op {
          if metric_name.length() > 0 {
            return Err(PromqlError::new(PromqlErrorKind::SyntaxError, t.pos, "metric name must not be set twice"))
          }
          let _ = self.advance()
          matchers.push(LabelMatcher::new(MatchOp::Equal, "__name__", t.text))
          if tok_is_comma(self.peek()) {
            let _ = self.advance()
          } else {
            break
          }
          continue
        }
      }
      _ => ()
    }
    let label_name = match t.kind {
      TokenKind::Ident => {
        let _ = self.advance()
        t.text
      }
      TokenKind::StringLit => {
        let _ = self.advance()
        t.text
      }
      _ => return Err(PromqlError::new(PromqlErrorKind::SyntaxError, t.pos, "expected label name in selector"))
    }
    let op_tok = self.peek()
    let op = match op_tok.kind {
      TokenKind::Assign => {
        let _ = self.advance()
        MatchOp::Equal
      }
      TokenKind::Neq => {
        let _ = self.advance()
        MatchOp::NotEqual
      }
      TokenKind::EqlRegex => {
        let _ = self.advance()
        MatchOp::RegexMatch
      }
      TokenKind::NeqRegex => {
        let _ = self.advance()
        MatchOp::RegexNotMatch
      }
      _ => return Err(PromqlError::new(PromqlErrorKind::SyntaxError, op_tok.pos, "expected matcher operator (=, !=, =~, !~)"))
    }
    let val_tok = self.peek()
    let val_str = match val_tok.kind {
      TokenKind::StringLit => {
        let _ = self.advance()
        val_tok.text
      }
      _ => return Err(PromqlError::new(PromqlErrorKind::SyntaxError, val_tok.pos, "expected string literal in label matcher"))
    }
    if metric_name.length() > 0 && label_name == "__name__" {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, t.pos, "metric name must not be set twice"))
    }
    matchers.push(LabelMatcher::new(op, label_name, val_str))
    if tok_is_comma(self.peek()) {
      let _ = self.advance()
    } else {
      break
    }
  }
  if !tok_is_rbrace(self.peek()) {
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected '}' to close selector"))
  }
  let _ = self.advance()
  if metric_name.length() > 0 {
    matchers.push(LabelMatcher::new(MatchOp::Equal, "__name__", metric_name))
  }
  match validate_matchers(matchers, brace_pos) {
    Ok(_) => Ok(matchers)
    Err(e) => Err(e)
  }
}

fn round_secs_to_ms(secs : Double, pos : Int, err_msg : String) -> Result[Int64, PromqlError] {
  if secs != secs || secs == 1.0 / 0.0 || secs == -1.0 / 0.0 {
    return Err(PromqlError::new(PromqlErrorKind::SemanticError, pos, err_msg))
  }
  let abs_s = if secs < 0.0 { -secs } else { secs }
  if abs_s > 9223372036.854 {
    return Err(PromqlError::new(PromqlErrorKind::SemanticError, pos, err_msg))
  }
  let ms_f = secs * 1000.0
  let rounded = if ms_f >= 0.0 {
    let t = ms_f.to_int64()
    if ms_f - t.to_double() >= 0.5 { t + 1L } else { t }
  } else {
    let t = ms_f.to_int64()
    if t.to_double() - ms_f >= 0.5 { t - 1L } else { t }
  }
  Ok(rounded)
}

fn round_at_secs_to_ms(secs : Double, pos : Int) -> Result[Int64, PromqlError] {
  if secs != secs || secs == 1.0 / 0.0 || secs == -1.0 / 0.0 {
    return Err(PromqlError::new(PromqlErrorKind::SemanticError, pos, "timestamp out of bounds for @ modifier"))
  }
  let abs_s = if secs < 0.0 { -secs } else { secs }
  // Go promql/parser bounds: math.MinInt64/1000 .. math.MaxInt64/1000
  if abs_s > 9223372036854775.0 {
    return Err(PromqlError::new(PromqlErrorKind::SemanticError, pos, "timestamp out of bounds for @ modifier"))
  }
  let ms_f = secs * 1000.0
  let rounded = if ms_f >= 0.0 {
    let t = ms_f.to_int64()
    if ms_f - t.to_double() >= 0.5 { t + 1L } else { t }
  } else {
    let t = ms_f.to_int64()
    if t.to_double() - ms_f >= 0.5 { t - 1L } else { t }
  }
  Ok(rounded)
}

fn Parser::parse_offset_value(self : Parser) -> Result[Int64, PromqlError] {
  let mut neg = false
  match self.peek().kind {
    TokenKind::Minus => {
      neg = true
      let _ = self.advance()
    }
    TokenKind::Plus => {
      let _ = self.advance()
    }
    _ => ()
  }
  let t = self.peek()
  match t.kind {
    TokenKind::Duration => {
      let _ = self.advance()
      if t.dur_ms <= 0L {
        return Err(PromqlError::new(PromqlErrorKind::SemanticError, t.pos, "duration must be greater than 0"))
      }
      Ok(if neg { -t.dur_ms } else { t.dur_ms })
    }
    TokenKind::Number => {
      let _ = self.advance()
      let secs = if neg { -t.num_val } else { t.num_val }
      round_secs_to_ms(secs, t.pos, "offset duration out of range")
    }
    _ => Err(PromqlError::new(PromqlErrorKind::SyntaxError, t.pos, "expected duration after 'offset'"))
  }
}

fn Parser::parse_at_value(self : Parser) -> Result[AtModifier, PromqlError] {
  let t = self.peek()
  match t.kind {
    TokenKind::Number => {
      let _ = self.advance()
      match round_at_secs_to_ms(t.num_val, t.pos) {
        Ok(ms) => Ok(AtModifier::Timestamp(ms))
        Err(e) => Err(e)
      }
    }
    TokenKind::Minus => {
      let _ = self.advance()
      let nt = self.peek()
      match nt.kind {
        TokenKind::Number => {
          let _ = self.advance()
          match round_at_secs_to_ms(-nt.num_val, nt.pos) {
            Ok(ms) => Ok(AtModifier::Timestamp(ms))
            Err(e) => Err(e)
          }
        }
        _ => Err(PromqlError::new(PromqlErrorKind::SyntaxError, nt.pos, "expected timestamp after '@ -'"))
      }
    }
    TokenKind::Plus => {
      let _ = self.advance()
      let nt = self.peek()
      match nt.kind {
        TokenKind::Number => {
          let _ = self.advance()
          match round_at_secs_to_ms(nt.num_val, nt.pos) {
            Ok(ms) => Ok(AtModifier::Timestamp(ms))
            Err(e) => Err(e)
          }
        }
        _ => Err(PromqlError::new(PromqlErrorKind::SyntaxError, nt.pos, "expected timestamp after '@ +'"))
      }
    }
    TokenKind::Ident => {
      let low = ascii_lower(t.text)
      if low == "start" || low == "end" {
        let _ = self.advance()
        if !tok_is_lparen(self.peek()) {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected '()' after '@ " + low + "'"))
        }
        let _ = self.advance()
        if !tok_is_rparen(self.peek()) {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected ')' after '@ " + low + "('"))
        }
        let _ = self.advance()
        if low == "start" {
          Ok(AtModifier::Start)
        } else {
          Ok(AtModifier::End)
        }
      } else {
        Err(PromqlError::new(PromqlErrorKind::SyntaxError, t.pos, "expected timestamp, start(), or end() after '@'"))
      }
    }
    _ => Err(PromqlError::new(PromqlErrorKind::SyntaxError, t.pos, "expected timestamp, start(), or end() after '@'"))
  }
}

fn at_mod_is_none(m : AtModifier) -> Bool {
  match m {
    AtModifier::None => true
    _ => false
  }
}

val struct OffsetAt {
  offset_ms : Int64
  at_mod : AtModifier
}

fn Parser::parse_offset_and_at(self : Parser) -> Result[OffsetAt, PromqlError] {
  let mut offset_ms = 0L
  let mut has_offset = false
  let mut at_mod = AtModifier::None
  while true {
    if tok_is_ident_kw(self.peek(), "offset") {
      if has_offset {
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "duplicate offset modifier"))
      }
      let _ = self.advance()
      match self.parse_offset_value() {
        Ok(ms) => {
          offset_ms = ms
          has_offset = true
        }
        Err(e) => return Err(e)
      }
    } else if tok_is_at(self.peek()) {
      if !at_mod_is_none(at_mod) {
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "duplicate '@' modifier"))
      }
      let _ = self.advance()
      match self.parse_at_value() {
        Ok(m) => {
          at_mod = m
        }
        Err(e) => return Err(e)
      }
    } else {
      break
    }
  }
  Ok(OffsetAt::{ offset_ms, at_mod })
}

val struct FuncSig {
  valid : Bool
  min_args : Int
  max_args : Int // -1 means variadic
  arg_count : Int
  arg0 : ValueType
  arg1 : ValueType
  arg2 : ValueType
  arg3 : ValueType
  arg4 : ValueType
  ret_type : ValueType
}

fn func_sig_none() -> FuncSig {
  FuncSig::{
    valid: false,
    min_args: 0,
    max_args: 0,
    arg_count: 0,
    arg0: ValueType::None,
    arg1: ValueType::None,
    arg2: ValueType::None,
    arg3: ValueType::None,
    arg4: ValueType::None,
    ret_type: ValueType::None,
  }
}

fn func_sig_1(min_args : Int, max_args : Int, a0 : ValueType, ret_type : ValueType) -> FuncSig {
  FuncSig::{
    valid: true,
    min_args,
    max_args,
    arg_count: 1,
    arg0: a0,
    arg1: a0,
    arg2: a0,
    arg3: a0,
    arg4: a0,
    ret_type,
  }
}

fn func_sig_2(min_args : Int, max_args : Int, a0 : ValueType, a1 : ValueType, ret_type : ValueType) -> FuncSig {
  FuncSig::{
    valid: true,
    min_args,
    max_args,
    arg_count: 2,
    arg0: a0,
    arg1: a1,
    arg2: a1,
    arg3: a1,
    arg4: a1,
    ret_type,
  }
}

fn func_sig_3(
  min_args : Int,
  max_args : Int,
  a0 : ValueType,
  a1 : ValueType,
  a2 : ValueType,
  ret_type : ValueType,
) -> FuncSig {
  FuncSig::{
    valid: true,
    min_args,
    max_args,
    arg_count: 3,
    arg0: a0,
    arg1: a1,
    arg2: a2,
    arg3: a2,
    arg4: a2,
    ret_type,
  }
}

fn func_sig_arg_at(sig : FuncSig, idx : Int) -> ValueType {
  if idx == 0 {
    sig.arg0
  } else if idx == 1 {
    sig.arg1
  } else if idx == 2 {
    sig.arg2
  } else if idx == 3 {
    sig.arg3
  } else {
    sig.arg4
  }
}

fn lookup_func_sig(name : String) -> FuncSig {
  // Range vector -> Instant vector (1 arg: Matrix)
  if name == "rate" || name == "irate" || name == "increase" || name == "delta" || name == "idelta" ||
  name == "changes" || name == "resets" || name == "deriv" ||
  name == "avg_over_time" || name == "sum_over_time" || name == "min_over_time" || name == "max_over_time" ||
  name == "count_over_time" || name == "stddev_over_time" || name == "stdvar_over_time" ||
  name == "last_over_time" || name == "present_over_time" || name == "absent_over_time" || name == "mad_over_time" {
    return func_sig_1(1, 1, ValueType::Matrix, ValueType::Vector)
  }
  if name == "quantile_over_time" {
    return func_sig_2(2, 2, ValueType::Scalar, ValueType::Matrix, ValueType::Vector)
  }
  if name == "predict_linear" {
    return func_sig_2(2, 2, ValueType::Matrix, ValueType::Scalar, ValueType::Vector)
  }
  if name == "double_exponential_smoothing" {
    return func_sig_3(3, 3, ValueType::Matrix, ValueType::Scalar, ValueType::Scalar, ValueType::Vector)
  }
  // Instant vector -> Instant vector (1 arg: Vector)
  if name == "abs" || name == "ceil" || name == "floor" || name == "sqrt" || name == "exp" ||
  name == "ln" || name == "log2" || name == "log10" || name == "sgn" ||
  name == "absent" || name == "sort" || name == "sort_desc" || name == "timestamp" ||
  name == "histogram_count" || name == "histogram_sum" || name == "histogram_avg" ||
  name == "histogram_stddev" || name == "histogram_stdvar" ||
  name == "sin" || name == "cos" || name == "tan" || name == "asin" || name == "acos" || name == "atan" ||
  name == "sinh" || name == "cosh" || name == "tanh" || name == "asinh" || name == "acosh" || name == "atanh" ||
  name == "deg" || name == "rad" {
    return func_sig_1(1, 1, ValueType::Vector, ValueType::Vector)
  }
  if name == "sort_by_label" || name == "sort_by_label_desc" {
    return func_sig_2(2, -1, ValueType::Vector, ValueType::String, ValueType::Vector)
  }
  if name == "info" {
    return func_sig_2(1, 2, ValueType::Vector, ValueType::Vector, ValueType::Vector)
  }
  // Optional 0 or 1 vector arg date/time functions
  if name == "day_of_month" || name == "day_of_week" || name == "day_of_year" || name == "days_in_month" ||
  name == "hour" || name == "minute" || name == "month" || name == "year" {
    return func_sig_1(0, 1, ValueType::Vector, ValueType::Vector)
  }
  if name == "round" {
    return func_sig_2(1, 2, ValueType::Vector, ValueType::Scalar, ValueType::Vector)
  }
  if name == "clamp" {
    return func_sig_3(3, 3, ValueType::Vector, ValueType::Scalar, ValueType::Scalar, ValueType::Vector)
  }
  if name == "clamp_min" || name == "clamp_max" {
    return func_sig_2(2, 2, ValueType::Vector, ValueType::Scalar, ValueType::Vector)
  }
  if name == "histogram_quantile" {
    return func_sig_2(2, 2, ValueType::Scalar, ValueType::Vector, ValueType::Vector)
  }
  if name == "histogram_fraction" {
    return func_sig_3(3, 3, ValueType::Scalar, ValueType::Scalar, ValueType::Vector, ValueType::Vector)
  }
  if name == "label_replace" {
    return FuncSig::{
      valid: true,
      min_args: 5,
      max_args: 5,
      arg_count: 5,
      arg0: ValueType::Vector,
      arg1: ValueType::String,
      arg2: ValueType::String,
      arg3: ValueType::String,
      arg4: ValueType::String,
      ret_type: ValueType::Vector,
    }
  }
  if name == "label_join" {
    return FuncSig::{
      valid: true,
      min_args: 3,
      max_args: -1,
      arg_count: 4,
      arg0: ValueType::Vector,
      arg1: ValueType::String,
      arg2: ValueType::String,
      arg3: ValueType::String,
      arg4: ValueType::String,
      ret_type: ValueType::Vector,
    }
  }
  if name == "time" || name == "pi" {
    return FuncSig::{
      valid: true,
      min_args: 0,
      max_args: 0,
      arg_count: 0,
      arg0: ValueType::None,
      arg1: ValueType::None,
      arg2: ValueType::None,
      arg3: ValueType::None,
      arg4: ValueType::None,
      ret_type: ValueType::Scalar,
    }
  }
  if name == "vector" {
    return func_sig_1(1, 1, ValueType::Scalar, ValueType::Vector)
  }
  if name == "scalar" {
    return func_sig_1(1, 1, ValueType::Vector, ValueType::Scalar)
  }
  func_sig_none()
}

fn Parser::parse_aggregate(self : Parser, op : AggOp, start_pos : Int) -> Result[Int, PromqlError] {
  match self.enter_depth(start_pos) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut grouping : Array[String] = []
  let mut without = false
  let mut has_grouping = false
  if tok_is_ident_kw(self.peek(), "by") {
    let _ = self.advance()
    match self.parse_label_list() {
      Ok(ls) => {
        grouping = ls
        without = false
        has_grouping = true
      }
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
  } else if tok_is_ident_kw(self.peek(), "without") {
    let _ = self.advance()
    match self.parse_label_list() {
      Ok(ls) => {
        grouping = ls
        without = true
        has_grouping = true
      }
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
  }
  if !tok_is_lparen(self.peek()) {
    self.leave_depth()
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected '(' in aggregation expression"))
  }
  let _ = self.advance()
  let mut param_id = -1
  if agg_op_has_param(op) {
    match self.parse_expr_prec(1) {
      Ok(pid) => param_id = pid
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let expected_param_type = match op {
      AggOp::CountValues => ValueType::String
      _ => ValueType::Scalar
    }
    if !value_type_eq(self.types[param_id], expected_param_type) {
      self.leave_depth()
      return Err(
        PromqlError::new(
          PromqlErrorKind::SemanticError,
          start_pos,
          "expected " + value_type_name(expected_param_type) + " parameter for " + agg_op_str(op),
        ),
      )
    }
    if !tok_is_comma(self.peek()) {
      self.leave_depth()
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected ',' after aggregation parameter"))
    }
    let _ = self.advance()
  }
  let expr_id = match self.parse_expr_prec(1) {
    Ok(id) => id
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  if !value_type_eq(self.types[expr_id], ValueType::Vector) {
    self.leave_depth()
    return Err(
      PromqlError::new(
        PromqlErrorKind::SemanticError,
        start_pos,
        "aggregation " + agg_op_str(op) + " expects instant vector, got " + value_type_name(self.types[expr_id]),
      ),
    )
  }
  if !tok_is_rparen(self.peek()) {
    self.leave_depth()
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected ')' after aggregation argument"))
  }
  let _ = self.advance()
  // Optional suffix by/without
  if tok_is_ident_kw(self.peek(), "by") || tok_is_ident_kw(self.peek(), "without") {
    if has_grouping {
      self.leave_depth()
      return Err(PromqlError::new(PromqlErrorKind::SemanticError, self.peek().pos, "cannot specify both prefix and suffix grouping clause"))
    }
    let is_without = tok_is_ident_kw(self.peek(), "without")
    let _ = self.advance()
    match self.parse_label_list() {
      Ok(ls) => {
        grouping = ls
        without = is_without
        has_grouping = true
      }
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
  }
  self.leave_depth()
  self.push_node(
    ExprNode::AggregateExpr(op, expr_id, param_id, grouping, without, has_grouping),
    ValueType::Vector,
    start_pos,
  )
}

fn Parser::parse_call(self : Parser, name : String, start_pos : Int) -> Result[Int, PromqlError] {
  match self.enter_depth(start_pos) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let sig = lookup_func_sig(name)
  if !sig.valid {
    self.leave_depth()
    return Err(PromqlError::new(PromqlErrorKind::SemanticError, start_pos, "unknown function: " + name))
  }
  let _ = self.advance() // consume '('
  let args : Array[Int] = []
  while !tok_is_rparen(self.peek()) && !tok_is_eof(self.peek()) {
    match self.parse_expr_prec(1) {
      Ok(aid) => args.push(aid)
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    if tok_is_comma(self.peek()) {
      let _ = self.advance()
    } else {
      break
    }
  }
  if !tok_is_rparen(self.peek()) {
    self.leave_depth()
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected ')' after function arguments"))
  }
  let _ = self.advance()
  let argc = args.length()
  if argc < sig.min_args || (sig.max_args >= 0 && argc > sig.max_args) {
    self.leave_depth()
    return Err(PromqlError::new(PromqlErrorKind::SemanticError, start_pos, "wrong number of arguments for function " + name))
  }
  let mut i = 0
  while i < argc {
    let expected = if i < sig.arg_count {
      func_sig_arg_at(sig, i)
    } else {
      func_sig_arg_at(sig, sig.arg_count - 1)
    }
    let got = self.types[args[i]]
    if !value_type_eq(got, expected) {
      self.leave_depth()
      return Err(
        PromqlError::new(
          PromqlErrorKind::SemanticError,
          start_pos,
          "argument " + (i + 1).to_string() + " of " + name + " expects " + value_type_name(expected) + ", got " + value_type_name(got),
        ),
      )
    }
    i = i + 1
  }
  self.leave_depth()
  self.push_node(ExprNode::Call(name, args, sig.ret_type), sig.ret_type, start_pos)
}

fn Parser::parse_primary(self : Parser) -> Result[Int, PromqlError] {
  let t = self.peek()
  match t.kind {
    TokenKind::Number => {
      let _ = self.advance()
      self.push_node(ExprNode::NumberLiteral(t.num_val), ValueType::Scalar, t.pos)
    }
    TokenKind::StringLit => {
      let _ = self.advance()
      self.push_node(ExprNode::StringLiteral(t.text), ValueType::String, t.pos)
    }
    TokenKind::LParen => {
      match self.enter_depth(t.pos) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let _ = self.advance()
      let inner = match self.parse_expr_prec(1) {
        Ok(id) => id
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
      if !tok_is_rparen(self.peek()) {
        self.leave_depth()
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected ')'"))
      }
      let _ = self.advance()
      self.leave_depth()
      let vt = self.types[inner]
      self.push_node(ExprNode::ParenExpr(inner), vt, t.pos)
    }
    TokenKind::LBrace => {
      match self.parse_matchers_brace("") {
        Ok(matchers) =>
        self.push_node(ExprNode::VectorSelector("", matchers, 0L, AtModifier::None), ValueType::Vector, t.pos)
        Err(e) => Err(e)
      }
    }
    TokenKind::MetricIdent => {
      let _ = self.advance()
      if tok_is_lbrace(self.peek()) {
        match self.parse_matchers_brace(t.text) {
          Ok(matchers) =>
          self.push_node(ExprNode::VectorSelector(t.text, matchers, 0L, AtModifier::None), ValueType::Vector, t.pos)
          Err(e) => Err(e)
        }
      } else {
        let matchers = [LabelMatcher::new(MatchOp::Equal, "__name__", t.text)]
        self.push_node(ExprNode::VectorSelector(t.text, matchers, 0L, AtModifier::None), ValueType::Vector, t.pos)
      }
    }
    TokenKind::Ident => {
      let tlen = t.text.length()
      if tlen <= 12 {
        // Special float literals Inf / NaN (never valid as bare metric names)
        if tlen == 3 {
          if eq_ascii_ci(t.text, "inf") {
            let _ = self.advance()
            return self.push_node(ExprNode::NumberLiteral(1.0 / 0.0), ValueType::Scalar, t.pos)
          }
          if eq_ascii_ci(t.text, "nan") {
            let _ = self.advance()
            return self.push_node(ExprNode::NumberLiteral(0.0 / 0.0), ValueType::Scalar, t.pos)
          }
        }
        // Reserved binary/modifier keywords cannot be bare metric names
        if (tlen == 2 && eq_ascii_ci(t.text, "on")) ||
        (tlen == 4 && eq_ascii_ci(t.text, "bool")) ||
        (tlen == 5 && eq_ascii_ci(t.text, "atan2")) ||
        (tlen == 8 && eq_ascii_ci(t.text, "ignoring")) ||
        (tlen == 10 && eq_ascii_ci(t.text, "group_left")) ||
        (tlen == 11 && eq_ascii_ci(t.text, "group_right")) {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, t.pos, "unexpected keyword: " + t.text))
        }
        // Aggregation expression if followed by `(`, `by`, or `without`
        match match_agg_op(t.text) {
          Some(agg_op) => {
            let next = self.peek_next()
            if tok_is_lparen(next) || tok_is_ident_kw(next, "by") || tok_is_ident_kw(next, "without") {
              let _ = self.advance()
              return self.parse_aggregate(agg_op, t.pos)
            }
          }
          None => ()
        }
      }
      // Function call if followed by `(`
      if tok_is_lparen(self.peek_next()) {
        let _ = self.advance()
        return self.parse_call(t.text, t.pos)
      }
      // Otherwise VectorSelector
      let _ = self.advance()
      if tok_is_lbrace(self.peek()) {
        match self.parse_matchers_brace(t.text) {
          Ok(matchers) =>
          self.push_node(ExprNode::VectorSelector(t.text, matchers, 0L, AtModifier::None), ValueType::Vector, t.pos)
          Err(e) => Err(e)
        }
      } else {
        let matchers = [LabelMatcher::new(MatchOp::Equal, "__name__", t.text)]
        self.push_node(ExprNode::VectorSelector(t.text, matchers, 0L, AtModifier::None), ValueType::Vector, t.pos)
      }
    }
    _ => Err(PromqlError::new(PromqlErrorKind::SyntaxError, t.pos, "unexpected token: " + t.text))
  }
}

fn Parser::parse_postfix(self : Parser, initial_id : Int) -> Result[Int, PromqlError] {
  let mut id = initial_id
  while true {
    // Bracket suffix: `[5m]` (matrix selector) or `[1h:5m]` / `[1h:]` (subquery)
    if tok_is_lbracket(self.peek()) {
      let bpos = self.peek().pos
      let _ = self.advance()
      let dur_tok = self.peek()
      let range_ms = match dur_tok.kind {
        TokenKind::Duration => {
          let _ = self.advance()
          dur_tok.dur_ms
        }
        TokenKind::Number => {
          let _ = self.advance()
          match round_secs_to_ms(dur_tok.num_val, dur_tok.pos, "range duration out of range") {
            Ok(ms) => ms
            Err(e) => return Err(e)
          }
        }
        _ => return Err(PromqlError::new(PromqlErrorKind::SyntaxError, dur_tok.pos, "expected duration inside '[...]'"))
      }
      if range_ms <= 0L {
        return Err(PromqlError::new(PromqlErrorKind::SemanticError, dur_tok.pos, "range duration must be positive"))
      }
      if tok_is_colon(self.peek()) {
        // Subquery: `[range:step]` or `[range:]`
        let _ = self.advance()
        let mut step_ms = 0L
        if !tok_is_rbracket(self.peek()) {
          let st = self.peek()
          match st.kind {
            TokenKind::Duration => {
              let _ = self.advance()
              step_ms = st.dur_ms
              if step_ms <= 0L {
                return Err(PromqlError::new(PromqlErrorKind::SemanticError, st.pos, "subquery step duration must be positive"))
              }
            }
            TokenKind::Number => {
              let _ = self.advance()
              match round_secs_to_ms(st.num_val, st.pos, "subquery step duration out of range") {
                Ok(ms) => {
                  step_ms = ms
                  if step_ms <= 0L {
                    return Err(PromqlError::new(PromqlErrorKind::SemanticError, st.pos, "subquery step duration must be positive"))
                  }
                }
                Err(e) => return Err(e)
              }
            }
            _ => return Err(PromqlError::new(PromqlErrorKind::SyntaxError, st.pos, "expected step duration or ']' in subquery"))
          }
        }
        if !tok_is_rbracket(self.peek()) {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected ']' to close subquery"))
        }
        let _ = self.advance()
        if !value_type_eq(self.types[id], ValueType::Vector) {
          return Err(PromqlError::new(PromqlErrorKind::SemanticError, bpos, "subquery requires an instant vector expression"))
        }
        match self.push_node(ExprNode::SubqueryExpr(id, range_ms, step_ms, 0L, AtModifier::None), ValueType::Matrix, bpos) {
          Ok(new_id) => id = new_id
          Err(e) => return Err(e)
        }
      } else {
        // Matrix selector: `<VectorSelector>[range]`
        if !tok_is_rbracket(self.peek()) {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, self.peek().pos, "expected ']' to close matrix selector"))
        }
        let _ = self.advance()
        match self.nodes[id] {
          ExprNode::VectorSelector(_, _, off, at_m) => {
            if off != 0L || !at_mod_is_none(at_m) {
              return Err(PromqlError::new(PromqlErrorKind::SyntaxError, bpos, "no offset modifiers allowed before range"))
            }
          }
          _ => return Err(PromqlError::new(PromqlErrorKind::SemanticError, bpos, "matrix selector requires a vector selector"))
        }
        match self.push_node(ExprNode::MatrixSelector(id, range_ms), ValueType::Matrix, bpos) {
          Ok(new_id) => id = new_id
          Err(e) => return Err(e)
        }
      }
      continue
    }
    // `offset` and `@` modifiers
    if tok_is_ident_kw(self.peek(), "offset") || tok_is_at(self.peek()) {
      let mpos = self.peek().pos
      match self.parse_offset_and_at() {
        Ok(oa) =>
        match self.nodes[id] {
          ExprNode::VectorSelector(name, matchers, prev_off, prev_at) => {
            if prev_off != 0L || !at_mod_is_none(prev_at) {
              return Err(PromqlError::new(PromqlErrorKind::SyntaxError, mpos, "duplicate offset/@ modifier"))
            }
            self.nodes[id] = ExprNode::VectorSelector(name, matchers, oa.offset_ms, oa.at_mod)
          }
          ExprNode::MatrixSelector(vs_id, _) =>
          match self.nodes[vs_id] {
            ExprNode::VectorSelector(name, matchers, prev_off, prev_at) => {
              if prev_off != 0L || !at_mod_is_none(prev_at) {
                return Err(PromqlError::new(PromqlErrorKind::SyntaxError, mpos, "duplicate offset/@ modifier"))
              }
              self.nodes[vs_id] = ExprNode::VectorSelector(name, matchers, oa.offset_ms, oa.at_mod)
            }
            _ => return Err(PromqlError::new(PromqlErrorKind::SemanticError, mpos, "offset/@ only valid on selectors and subqueries"))
          }
          ExprNode::SubqueryExpr(inner, range_ms, step_ms, prev_off, prev_at) => {
            if prev_off != 0L || !at_mod_is_none(prev_at) {
              return Err(PromqlError::new(PromqlErrorKind::SyntaxError, mpos, "duplicate offset/@ modifier"))
            }
            self.nodes[id] = ExprNode::SubqueryExpr(inner, range_ms, step_ms, oa.offset_ms, oa.at_mod)
          }
          _ => return Err(PromqlError::new(PromqlErrorKind::SemanticError, mpos, "offset/@ only valid on selectors and subqueries"))
        }
        Err(e) => return Err(e)
      }
      continue
    }
    break
  }
  Ok(id)
}

fn Parser::parse_unary(self : Parser) -> Result[Int, PromqlError] {
  let t = self.peek()
  match t.kind {
    TokenKind::Plus => {
      match self.enter_depth(t.pos) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let _ = self.advance()
      // Power (prec 6) binds tighter than unary +/-
      let operand = match self.parse_expr_prec(6) {
        Ok(id) => id
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
      self.leave_depth()
      let vt = self.types[operand]
      if !value_type_eq(vt, ValueType::Scalar) && !value_type_eq(vt, ValueType::Vector) {
        return Err(PromqlError::new(PromqlErrorKind::SemanticError, t.pos, "unary '+' only valid on scalar or instant vector"))
      }
      // Go promql/parser folds unary `+` directly into a NumberLiteral.
      match self.nodes[operand] {
        ExprNode::NumberLiteral(_) => Ok(operand)
        _ => self.push_node(ExprNode::UnaryExpr(UnaryOp::Plus, operand), vt, t.pos)
      }
    }
    TokenKind::Minus => {
      match self.enter_depth(t.pos) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let _ = self.advance()
      // Power (prec 6) binds tighter than unary +/- (so `-2 ^ 2` == `-(2 ^ 2)`)
      let operand = match self.parse_expr_prec(6) {
        Ok(id) => id
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
      self.leave_depth()
      let vt = self.types[operand]
      if !value_type_eq(vt, ValueType::Scalar) && !value_type_eq(vt, ValueType::Vector) {
        return Err(PromqlError::new(PromqlErrorKind::SemanticError, t.pos, "unary '-' only valid on scalar or instant vector"))
      }
      // Go promql/parser folds unary `-` directly into a NumberLiteral.
      match self.nodes[operand] {
        ExprNode::NumberLiteral(v) => {
          self.nodes[operand] = ExprNode::NumberLiteral(-v)
          Ok(operand)
        }
        _ => self.push_node(ExprNode::UnaryExpr(UnaryOp::Minus, operand), vt, t.pos)
      }
    }
    _ => {
      let p = match self.parse_primary() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      self.parse_postfix(p)
    }
  }
}

fn Parser::parse_bin_modifiers(
  self : Parser,
  op : BinOp,
  op_pos : Int,
) -> Result[(Bool, VectorMatching), PromqlError] {
  let mut return_bool = false
  if tok_is_ident_kw(self.peek(), "bool") {
    if !bin_op_is_comparison(op) {
      return Err(PromqlError::new(PromqlErrorKind::SemanticError, self.peek().pos, "bool modifier can only be used on comparison operators"))
    }
    return_bool = true
    let _ = self.advance()
  }
  let mut on = false
  let mut has_clause = false
  let mut matching_labels : Array[String] = []
  let mut card = VectorMatchCardinality::OneToOne
  let mut include_labels : Array[String] = []

  if tok_is_ident_kw(self.peek(), "on") {
    let _ = self.advance()
    match self.parse_label_list() {
      Ok(ls) => {
        on = true
        has_clause = true
        matching_labels = ls
      }
      Err(e) => return Err(e)
    }
  } else if tok_is_ident_kw(self.peek(), "ignoring") {
    let _ = self.advance()
    match self.parse_label_list() {
      Ok(ls) => {
        on = false
        has_clause = true
        matching_labels = ls
      }
      Err(e) => return Err(e)
    }
  }

  if tok_is_ident_kw(self.peek(), "group_left") || tok_is_ident_kw(self.peek(), "group_right") {
    let gpos = self.peek().pos
    if bin_op_is_set(op) {
      return Err(PromqlError::new(PromqlErrorKind::SemanticError, gpos, "group_left/group_right not allowed on set operators"))
    }
    if !has_clause {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, gpos, "group_left/group_right requires preceding on() or ignoring()"))
    }
    let is_left = tok_is_ident_kw(self.peek(), "group_left")
    let _ = self.advance()
    card = if is_left { VectorMatchCardinality::ManyToOne } else { VectorMatchCardinality::OneToMany }
    if tok_is_lparen(self.peek()) {
      match self.parse_label_list() {
        Ok(ls) => include_labels = ls
        Err(e) => return Err(e)
      }
    }
    // Validate: if `on(...)`, include_labels must not overlap matching_labels
    if on {
      let mut i = 0
      while i < include_labels.length() {
        if str_list_contains(matching_labels, include_labels[i]) {
          return Err(
            PromqlError::new(
              PromqlErrorKind::SemanticError,
              gpos,
              "label '" + include_labels[i] + "' cannot appear in both on() and group_left/group_right()",
            ),
          )
        }
        i = i + 1
      }
    }
  }
  let _ = op_pos
  if bin_op_is_set(op) {
    card = VectorMatchCardinality::ManyToMany
  }
  Ok((return_bool, VectorMatching::{ card, matching_labels, on, has_clause, include_labels }))
}

fn Parser::parse_expr_prec(self : Parser, min_prec : Int) -> Result[Int, PromqlError] {
  let mut lhs = match self.parse_unary() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while true {
    let op_tok = self.peek()
    let info = peek_bin_op(op_tok)
    if !info.valid || info.prec < min_prec {
      break
    }
    let op = info.op
    let _ = self.advance()
    let (return_bool, vm) = match self.parse_bin_modifiers(op, op_tok.pos) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    let next_min = if info.right_assoc { info.prec } else { info.prec + 1 }
    match self.enter_depth(op_tok.pos) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let rhs = match self.parse_expr_prec(next_min) {
      Ok(id) => id
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    let lt = self.types[lhs]
    let rt = self.types[rhs]
    let l_is_s = value_type_eq(lt, ValueType::Scalar)
    let r_is_s = value_type_eq(rt, ValueType::Scalar)
    let l_is_v = value_type_eq(lt, ValueType::Vector)
    let r_is_v = value_type_eq(rt, ValueType::Vector)
    if (!l_is_s && !l_is_v) || (!r_is_s && !r_is_v) {
      return Err(
        PromqlError::new(
          PromqlErrorKind::SemanticError,
          op_tok.pos,
          "binary operator " + bin_op_str(op) + " requires scalar or instant vector operands",
        ),
      )
    }
    if bin_op_is_set(op) && (l_is_s || r_is_s) {
      return Err(
        PromqlError::new(
          PromqlErrorKind::SemanticError,
          op_tok.pos,
          "set operator " + bin_op_str(op) + " only allowed between instant vectors",
        ),
      )
    }
    if bin_op_is_comparison(op) && l_is_s && r_is_s && !return_bool {
      return Err(
        PromqlError::new(
          PromqlErrorKind::SemanticError,
          op_tok.pos,
          "comparisons between scalars must use BOOL modifier",
        ),
      )
    }
    let res_type = if l_is_s && r_is_s { ValueType::Scalar } else { ValueType::Vector }
    match self.push_node(ExprNode::BinaryExpr(op, lhs, rhs, return_bool, vm), res_type, op_tok.pos) {
      Ok(new_id) => lhs = new_id
      Err(e) => return Err(e)
    }
  }
  Ok(lhs)
}

///| Parse a PromQL expression with `limits`.
pub fn parse_expr_impl(input : String, limits : PromqlLimits) -> Result[ParsedExpr, PromqlError] {
  match validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let p = match Parser::new(input, limits) {
    Ok(parser) => parser
    Err(e) => return Err(e)
  }
  if tok_is_eof(p.peek()) {
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, 0, "empty PromQL expression"))
  }
  let root = match p.parse_expr_prec(1) {
    Ok(id) => id
    Err(e) =>
    match p.lex_err {
      Some(le) => return Err(le)
      None => return Err(e)
    }
  }
  match p.lex_err {
    Some(le) => return Err(le)
    None => ()
  }
  if !tok_is_eof(p.peek()) {
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, p.peek().pos, "unexpected trailing token: " + p.peek().text))
  }
  Ok(ParsedExpr::{ nodes: p.nodes, root, value_type: p.types[root] })
}

///| Parse a standalone metric selector into label matchers.
pub fn parse_metric_selector_impl(input : String) -> Result[Array[LabelMatcher], PromqlError] {
  let expr = match parse_expr_impl(input, PromqlLimits::default()) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  match expr.nodes[expr.root] {
    ExprNode::VectorSelector(_, matchers, offset_ms, at_mod) => {
      if offset_ms != 0L || !at_mod_is_none(at_mod) {
        return Err(PromqlError::new(PromqlErrorKind::SemanticError, 0, "metric selector cannot have offset or @ modifier"))
      }
      Ok(matchers)
    }
    _ => Err(PromqlError::new(PromqlErrorKind::SemanticError, 0, "expected metric selector"))
  }
}
