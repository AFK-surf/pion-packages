///| Canonical PromQL formatter (`format_expr`), multi-line prettifier (`prettify_expr`),
///| and AST inspection utilities (`extract_metric_names`, `inspect_selectors`).

fn quote_promql_string(s : String) -> String {
  let sb = StringBuilder::new()
  sb.write_byte(34.to_byte()) // '"'
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 {
      sb.write_string("\\\\")
    } else if b == 34 {
      sb.write_string("\\\"")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte(34.to_byte())
  sb.to_string()
}

fn format_at_ts(ms : Int64) -> String {
  let neg = ms < 0L
  let abs_ms = if neg { -ms } else { ms }
  let secs = abs_ms / 1000L
  let rem = abs_ms % 1000L
  let sb = StringBuilder::new()
  if neg {
    sb.write_string("-")
  }
  sb.write_string(secs.to_string())
  sb.write_string(".")
  if rem < 10L {
    sb.write_string("00")
  } else if rem < 100L {
    sb.write_string("0")
  }
  sb.write_string(rem.to_string())
  sb.to_string()
}

fn format_number_lit(v : Double) -> String {
  if v != v {
    return "NaN"
  }
  if v == 1.0 / 0.0 {
    return "+Inf"
  }
  if v == -1.0 / 0.0 {
    return "-Inf"
  }
  if v == 0.0 {
    return "0"
  }
  // Exact small/medium integer formatting without trailing ".0"
  let iv = v.to_int64()
  if v >= -9007199254740992.0 && v <= 9007199254740992.0 && iv.to_double() == v {
    return iv.to_string()
  }
  let s = v.to_string()
  // Trim trailing ".0" if present (for consistency with Go strconv.FormatFloat 'g')
  let n = s.length()
  if n >= 2 && s.code_unit_at(n - 2) == 46 && s.code_unit_at(n - 1) == 48 {
    s.slice(0, n - 2)
  } else {
    s
  }
}

fn write_at_and_offset(sb : StringBuilder, at_mod : AtModifier, offset_ms : Int64) -> Unit {
  match at_mod {
    AtModifier::None => ()
    AtModifier::Timestamp(ms) => {
      sb.write_string(" @ ")
      sb.write_string(format_at_ts(ms))
    }
    AtModifier::Start => sb.write_string(" @ start()")
    AtModifier::End => sb.write_string(" @ end()")
  }
  if offset_ms != 0L {
    sb.write_string(" offset ")
    sb.write_string(format_duration_ms_impl(offset_ms))
  }
}

fn write_label_list(sb : StringBuilder, labels : Array[String]) -> Unit {
  sb.write_string("(")
  let mut i = 0
  while i < labels.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    if is_valid_label_name(labels[i]) {
      sb.write_string(labels[i])
    } else {
      sb.write_string(quote_promql_string(labels[i]))
    }
    i = i + 1
  }
  sb.write_string(")")
}

fn write_vector_selector_core(sb : StringBuilder, name : String, matchers : Array[LabelMatcher]) -> Unit {
  let has_legacy_name = name.length() > 0 && is_valid_metric_name(name)
  if has_legacy_name {
    sb.write_string(name)
  }
  let mut extra_count = 0
  let mut i = 0
  while i < matchers.length() {
    let m = matchers[i]
    let skip = has_legacy_name && m.name == "__name__" && match_op_eq(m.op, MatchOp::Equal) && m.value == name
    if !skip {
      extra_count = extra_count + 1
    }
    i = i + 1
  }
  if extra_count > 0 || !has_legacy_name {
    sb.write_string("{")
    let mut written = 0
    let mut j = 0
    while j < matchers.length() {
      let m = matchers[j]
      let skip = has_legacy_name && m.name == "__name__" && match_op_eq(m.op, MatchOp::Equal) && m.value == name
      if !skip {
        if written > 0 {
          sb.write_string(",")
        }
        if !has_legacy_name && written == 0 && m.name == "__name__" && match_op_eq(m.op, MatchOp::Equal) && !is_valid_metric_name(m.value) {
          sb.write_string(quote_promql_string(m.value))
        } else {
          if is_valid_label_name(m.name) {
            sb.write_string(m.name)
          } else {
            sb.write_string(quote_promql_string(m.name))
          }
          sb.write_string(match_op_str(m.op))
          sb.write_string(quote_promql_string(m.value))
        }
        written = written + 1
      }
      j = j + 1
    }
    sb.write_string("}")
  }
}

fn write_expr_node(sb : StringBuilder, nodes : Array[ExprNode], id : Int) -> Unit {
  match nodes[id] {
    ExprNode::NumberLiteral(v) => sb.write_string(format_number_lit(v))
    ExprNode::StringLiteral(s) => sb.write_string(quote_promql_string(s))
    ExprNode::VectorSelector(name, matchers, offset_ms, at_mod) => {
      write_vector_selector_core(sb, name, matchers)
      write_at_and_offset(sb, at_mod, offset_ms)
    }
    ExprNode::MatrixSelector(vs_id, range_ms) =>
    match nodes[vs_id] {
      ExprNode::VectorSelector(name, matchers, offset_ms, at_mod) => {
        write_vector_selector_core(sb, name, matchers)
        sb.write_string("[")
        sb.write_string(format_duration_ms_impl(range_ms))
        sb.write_string("]")
        write_at_and_offset(sb, at_mod, offset_ms)
      }
      _ => ()
    }
    ExprNode::SubqueryExpr(inner, range_ms, step_ms, offset_ms, at_mod) => {
      write_expr_node(sb, nodes, inner)
      sb.write_string("[")
      sb.write_string(format_duration_ms_impl(range_ms))
      sb.write_string(":")
      if step_ms > 0L {
        sb.write_string(format_duration_ms_impl(step_ms))
      }
      sb.write_string("]")
      write_at_and_offset(sb, at_mod, offset_ms)
    }
    ExprNode::UnaryExpr(op, inner) => {
      match op {
        UnaryOp::Plus => sb.write_string("+")
        UnaryOp::Minus => sb.write_string("-")
      }
      write_expr_node(sb, nodes, inner)
    }
    ExprNode::BinaryExpr(op, lhs, rhs, return_bool, vm) => {
      write_expr_node(sb, nodes, lhs)
      sb.write_string(" ")
      sb.write_string(bin_op_str(op))
      if return_bool {
        sb.write_string(" bool")
      }
      if vm.has_clause {
        if vm.on {
          sb.write_string(" on ")
        } else {
          sb.write_string(" ignoring ")
        }
        write_label_list(sb, vm.matching_labels)
      }
      match vm.card {
        VectorMatchCardinality::ManyToOne => {
          sb.write_string(" group_left ")
          write_label_list(sb, vm.include_labels)
        }
        VectorMatchCardinality::OneToMany => {
          sb.write_string(" group_right ")
          write_label_list(sb, vm.include_labels)
        }
        _ => ()
      }
      sb.write_string(" ")
      write_expr_node(sb, nodes, rhs)
    }
    ExprNode::ParenExpr(inner) => {
      sb.write_string("(")
      write_expr_node(sb, nodes, inner)
      sb.write_string(")")
    }
    ExprNode::AggregateExpr(op, inner, param_id, grouping, without, has_grouping) => {
      sb.write_string(agg_op_str(op))
      if has_grouping {
        if without {
          sb.write_string(" without ")
        } else {
          sb.write_string(" by ")
        }
        write_label_list(sb, grouping)
        sb.write_string(" ")
      }
      sb.write_string("(")
      if param_id >= 0 {
        write_expr_node(sb, nodes, param_id)
        sb.write_string(", ")
      }
      write_expr_node(sb, nodes, inner)
      sb.write_string(")")
    }
    ExprNode::Call(name, args, _) => {
      sb.write_string(name)
      sb.write_string("(")
      let mut i = 0
      while i < args.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr_node(sb, nodes, args[i])
        i = i + 1
      }
      sb.write_string(")")
    }
  }
}

///| Canonical single-line PromQL formatting (aligned with Go `parser.Expr.String()`).
pub fn format_expr_impl(expr : ParsedExpr) -> String {
  if expr.root < 0 || expr.root >= expr.nodes.length() {
    return ""
  }
  let sb = StringBuilder::new()
  write_expr_node(sb, expr.nodes, expr.root)
  sb.to_string()
}

fn write_indent(sb : StringBuilder, level : Int) -> Unit {
  let mut i = 0
  while i < level {
    sb.write_string("  ")
    i = i + 1
  }
}

fn write_pretty_node(sb : StringBuilder, nodes : Array[ExprNode], id : Int, level : Int) -> Unit {
  match nodes[id] {
    ExprNode::BinaryExpr(op, lhs, rhs, return_bool, vm) => {
      write_pretty_node(sb, nodes, lhs, level)
      sb.write_string("\n")
      write_indent(sb, level)
      sb.write_string(bin_op_str(op))
      if return_bool {
        sb.write_string(" bool")
      }
      if vm.has_clause {
        if vm.on {
          sb.write_string(" on ")
        } else {
          sb.write_string(" ignoring ")
        }
        write_label_list(sb, vm.matching_labels)
      }
      match vm.card {
        VectorMatchCardinality::ManyToOne => {
          sb.write_string(" group_left ")
          write_label_list(sb, vm.include_labels)
        }
        VectorMatchCardinality::OneToMany => {
          sb.write_string(" group_right ")
          write_label_list(sb, vm.include_labels)
        }
        _ => ()
      }
      sb.write_string("\n")
      write_indent(sb, level)
      write_pretty_node(sb, nodes, rhs, level)
    }
    ExprNode::AggregateExpr(op, inner, param_id, grouping, without, has_grouping) => {
      sb.write_string(agg_op_str(op))
      if has_grouping {
        if without {
          sb.write_string(" without ")
        } else {
          sb.write_string(" by ")
        }
        write_label_list(sb, grouping)
        sb.write_string(" ")
      }
      sb.write_string("(\n")
      write_indent(sb, level + 1)
      if param_id >= 0 {
        write_pretty_node(sb, nodes, param_id, level + 1)
        sb.write_string(",\n")
        write_indent(sb, level + 1)
      }
      write_pretty_node(sb, nodes, inner, level + 1)
      sb.write_string("\n")
      write_indent(sb, level)
      sb.write_string(")")
    }
    ExprNode::ParenExpr(inner) => {
      sb.write_string("(\n")
      write_indent(sb, level + 1)
      write_pretty_node(sb, nodes, inner, level + 1)
      sb.write_string("\n")
      write_indent(sb, level)
      sb.write_string(")")
    }
    _ => write_expr_node(sb, nodes, id)
  }
}

///| Multi-line indented PromQL prettifier.
pub fn prettify_expr_impl(expr : ParsedExpr) -> String {
  if expr.root < 0 || expr.root >= expr.nodes.length() {
    return ""
  }
  let sb = StringBuilder::new()
  write_pretty_node(sb, expr.nodes, expr.root, 0)
  sb.to_string()
}

fn sort_unique_strings(xs : Array[String]) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < xs.length() {
    let s = xs[i]
    let mut dup = false
    let mut j = 0
    while j < out.length() {
      if out[j] == s {
        dup = true
        break
      }
      j = j + 1
    }
    if !dup {
      out.push(s)
    }
    i = i + 1
  }
  // Insertion sort ascending
  let mut k = 1
  while k < out.length() {
    let cur = out[k]
    let mut j = k - 1
    while j >= 0 && out[j] > cur {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
    k = k + 1
  }
  out
}

///| Extract all distinct metric names from an expression, sorted ascending.
pub fn extract_metric_names_impl(expr : ParsedExpr) -> Array[String] {
  let names : Array[String] = []
  let mut i = 0
  while i < expr.nodes.length() {
    match expr.nodes[i] {
      ExprNode::VectorSelector(name, _, _, _) => {
        if name.length() > 0 {
          names.push(name)
        }
      }
      _ => ()
    }
    i = i + 1
  }
  sort_unique_strings(names)
}

fn collect_selectors(nodes : Array[ExprNode], id : Int, out : Array[SelectorInfo]) -> Unit {
  if id < 0 || id >= nodes.length() {
    return ()
  }
  match nodes[id] {
    ExprNode::VectorSelector(name, matchers, offset_ms, at_mod) =>
    out.push(SelectorInfo::{ metric_name: name, matchers, range_ms: 0L, offset_ms, at_mod })
    ExprNode::MatrixSelector(vs_id, range_ms) =>
    match nodes[vs_id] {
      ExprNode::VectorSelector(name, matchers, offset_ms, at_mod) =>
      out.push(SelectorInfo::{ metric_name: name, matchers, range_ms, offset_ms, at_mod })
      _ => ()
    }
    ExprNode::SubqueryExpr(inner, _, _, _, _) => collect_selectors(nodes, inner, out)
    ExprNode::UnaryExpr(_, inner) => collect_selectors(nodes, inner, out)
    ExprNode::BinaryExpr(_, lhs, rhs, _, _) => {
      collect_selectors(nodes, lhs, out)
      collect_selectors(nodes, rhs, out)
    }
    ExprNode::ParenExpr(inner) => collect_selectors(nodes, inner, out)
    ExprNode::AggregateExpr(_, inner, param_id, _, _, _) => {
      if param_id >= 0 {
        collect_selectors(nodes, param_id, out)
      }
      collect_selectors(nodes, inner, out)
    }
    ExprNode::Call(_, args, _) => {
      let mut i = 0
      while i < args.length() {
        collect_selectors(nodes, args[i], out)
        i = i + 1
      }
    }
    _ => ()
  }
}

///| Inspect all vector and matrix selectors in AST traversal order.
pub fn inspect_selectors_impl(expr : ParsedExpr) -> Array[SelectorInfo] {
  let out : Array[SelectorInfo] = []
  collect_selectors(expr.nodes, expr.root, out)
  out
}
