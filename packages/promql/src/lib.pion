///| Top-level public API for `packages/promql`.
///|
///| Pure-Pion Prometheus PromQL lexer, AST parser, static semantic validator,
///| canonical formatter / prettifier, selector inspector, and in-memory
///| instant & range time-series evaluator.

///| Parse a PromQL expression with default `PromqlLimits`.
pub fn parse_expr(input : String) -> Result[ParsedExpr, PromqlError] {
  parse_expr_with_limits(input, PromqlLimits::default())
}

///| Parse a PromQL expression with explicit `PromqlLimits`.
pub fn parse_expr_with_limits(
  input : String,
  limits : PromqlLimits,
) -> Result[ParsedExpr, PromqlError] {
  parse_expr_impl(input, limits)
}

///| Parse a PromQL metric selector (e.g. `http_requests_total{job="api"}`) into label matchers.
pub fn parse_metric_selector(input : String) -> Result[Array[LabelMatcher], PromqlError] {
  parse_metric_selector_impl(input)
}

///| Parse a Prometheus compound duration string (e.g. `1y2w3d4h5m6s7ms`) into milliseconds.
pub fn parse_duration_ms(input : String) -> Result[Int64, PromqlError] {
  parse_duration_ms_impl(input)
}

///| Format a duration in milliseconds into Prometheus canonical duration syntax.
pub fn format_duration_ms(ms : Int64) -> String {
  format_duration_ms_impl(ms)
}

///| Format a parsed PromQL expression into canonical single-line PromQL (`parser.Expr.String()`).
pub fn format_expr(expr : ParsedExpr) -> String {
  format_expr_impl(expr)
}

///| Format a parsed PromQL expression with multi-line indentation (`parser.Prettify()`).
pub fn prettify_expr(expr : ParsedExpr) -> String {
  prettify_expr_impl(expr)
}

///| Extract all distinct metric names referenced by selectors in `expr` (sorted ascending).
pub fn extract_metric_names(expr : ParsedExpr) -> Array[String] {
  extract_metric_names_impl(expr)
}

///| Inspect all vector and matrix selectors in `expr`.
pub fn inspect_selectors(expr : ParsedExpr) -> Array[SelectorInfo] {
  inspect_selectors_impl(expr)
}

///| Evaluate a parsed PromQL expression at a single timestamp `eval_ts_ms` with default limits.
pub fn eval_instant(
  expr : ParsedExpr,
  store : SeriesStore,
  eval_ts_ms : Int64,
) -> Result[EvalValue, PromqlError] {
  eval_instant_with_limits(expr, store, eval_ts_ms, PromqlLimits::default())
}

///| Evaluate a parsed PromQL expression at `eval_ts_ms` with explicit `PromqlLimits`.
pub fn eval_instant_with_limits(
  expr : ParsedExpr,
  store : SeriesStore,
  eval_ts_ms : Int64,
  limits : PromqlLimits,
) -> Result[EvalValue, PromqlError] {
  eval_instant_impl(expr, store, eval_ts_ms, limits)
}

///| Evaluate a parsed PromQL expression over `[start_ms, end_ms]` with step `step_ms`.
pub fn eval_range(
  expr : ParsedExpr,
  store : SeriesStore,
  start_ms : Int64,
  end_ms : Int64,
  step_ms : Int64,
) -> Result[EvalMatrix, PromqlError] {
  eval_range_with_limits(expr, store, start_ms, end_ms, step_ms, PromqlLimits::default())
}

///| Evaluate a parsed PromQL expression over `[start_ms, end_ms]` with explicit `PromqlLimits`.
pub fn eval_range_with_limits(
  expr : ParsedExpr,
  store : SeriesStore,
  start_ms : Int64,
  end_ms : Int64,
  step_ms : Int64,
  limits : PromqlLimits,
) -> Result[EvalMatrix, PromqlError] {
  eval_range_impl(expr, store, start_ms, end_ms, step_ms, limits)
}
