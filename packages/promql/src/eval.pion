///| Pure-Pion in-memory PromQL instant and range evaluator.

// ---------------------------------------------------------------------------
// Pure-Pion IEEE 754 math helpers
// ---------------------------------------------------------------------------

fn f64_is_nan(x : Double) -> Bool {
  x != x
}

fn f64_is_inf(x : Double) -> Bool {
  x == 1.0 / 0.0 || x == -1.0 / 0.0
}

fn f64_is_finite(x : Double) -> Bool {
  !f64_is_nan(x) && !f64_is_inf(x)
}

fn f64_abs(x : Double) -> Double {
  if x < 0.0 { -x } else { x }
}

fn f64_trunc(x : Double) -> Double {
  if !f64_is_finite(x) || x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  x.to_int64().to_double()
}

fn f64_floor(x : Double) -> Double {
  if !f64_is_finite(x) || x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let t = x.to_int64().to_double()
  if x < t { t - 1.0 } else { t }
}

fn f64_ceil(x : Double) -> Double {
  if !f64_is_finite(x) || x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let t = x.to_int64().to_double()
  if x > t { t + 1.0 } else { t }
}

fn f64_round(x : Double) -> Double {
  if !f64_is_finite(x) || x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  if x >= 0.0 { f64_floor(x + 0.5) } else { f64_ceil(x - 0.5) }
}

fn f64_mod(a : Double, b : Double) -> Double {
  if f64_is_nan(a) || f64_is_nan(b) || b == 0.0 || f64_is_inf(a) {
    return 0.0 / 0.0
  }
  if f64_is_inf(b) {
    return a
  }
  a - f64_trunc(a / b) * b
}

fn f64_sqrt(x : Double) -> Double {
  if x != x || x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 || x == 1.0 / 0.0 {
    return x
  }
  let mut m = x
  let mut scale = 1.0
  while m >= 2.0 {
    m = m * 0.25
    scale = scale * 2.0
  }
  while m < 0.5 {
    m = m * 4.0
    scale = scale * 0.5
  }
  let mut g = 0.5 * (m + 1.0)
  let mut i = 0
  while i < 8 {
    g = 0.5 * (g + m / g)
    i = i + 1
  }
  g * scale
}

fn f64_ln(x : Double) -> Double {
  if x != x || x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return -1.0 / 0.0
  }
  if x == 1.0 / 0.0 {
    return 1.0 / 0.0
  }
  let ln2 = 0.693147180559945309417232121458176568
  let mut m = x
  let mut k = 0
  while m >= 1.4142135623730951 {
    m = m * 0.5
    k = k + 1
  }
  while m < 0.7071067811865476 {
    m = m * 2.0
    k = k - 1
  }
  let t = (m - 1.0) / (m + 1.0)
  let t2 = t * t
  let mut term = t
  let mut sum = t
  let mut n = 3
  while n <= 31 {
    term = term * t2
    sum = sum + term / n.to_double()
    n = n + 2
  }
  2.0 * sum + k.to_double() * ln2
}

fn f64_exp(x : Double) -> Double {
  if x != x {
    return x
  }
  if x > 709.782712893384 {
    return 1.0 / 0.0
  }
  if x < -745.1332191019412 {
    return 0.0
  }
  let ln2 = 0.693147180559945309417232121458176568
  let kf = f64_floor(x / ln2 + 0.5)
  let k = kf.to_int64().to_int()
  let r = x - kf * ln2
  let mut term = 1.0
  let mut sum = 1.0
  let mut i = 1
  while i <= 25 {
    term = term * r / i.to_double()
    sum = sum + term
    i = i + 1
  }
  let mut res = sum
  if k > 0 {
    let mut rem = k
    while rem > 0 {
      res = res * 2.0
      rem = rem - 1
    }
  } else if k < 0 {
    let mut rem = -k
    while rem > 0 {
      res = res * 0.5
      rem = rem - 1
    }
  }
  res
}

fn f64_pow(x : Double, y : Double) -> Double {
  if y == 0.0 {
    return 1.0
  }
  if x == 1.0 {
    return 1.0
  }
  if x != x || y != y {
    return 0.0 / 0.0
  }
  if f64_is_finite(y) && y == f64_trunc(y) && y >= -1074.0 && y <= 1074.0 {
    let mut exp_i = y.to_int64().to_int()
    let neg_exp = exp_i < 0
    if neg_exp {
      exp_i = -exp_i
    }
    let mut base = x
    let mut acc = 1.0
    while exp_i > 0 {
      if (exp_i & 1) != 0 {
        acc = acc * base
      }
      exp_i = exp_i >> 1
      if exp_i > 0 {
        base = base * base
      }
    }
    return if neg_exp { 1.0 / acc } else { acc }
  }
  if x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return if y > 0.0 { 0.0 } else { 1.0 / 0.0 }
  }
  f64_exp(y * f64_ln(x))
}

fn f64_atan(x : Double) -> Double {
  if x != x {
    return x
  }
  let pi2 = 1.5707963267948966
  if x == 1.0 / 0.0 {
    return pi2
  }
  if x == -1.0 / 0.0 {
    return -pi2
  }
  let neg = x < 0.0
  let ax = if neg { -x } else { x }
  let res = if ax > 1.0 {
    pi2 - f64_atan(1.0 / ax)
  } else if ax > 0.5 {
    let t = (ax - 1.0) / (ax + 1.0)
    0.7853981633974483 + f64_atan(t)
  } else {
    let x2 = ax * ax
    let mut term = ax
    let mut sum = ax
    let mut k = 3
    let mut sign = -1.0
    while k <= 31 {
      term = term * x2
      sum = sum + sign * term / k.to_double()
      sign = -sign
      k = k + 2
    }
    sum
  }
  if neg { -res } else { res }
}

fn f64_atan2(y : Double, x : Double) -> Double {
  if y != y || x != x {
    return 0.0 / 0.0
  }
  let pi = 3.141592653589793
  if x > 0.0 {
    f64_atan(y / x)
  } else if x < 0.0 {
    if y >= 0.0 { f64_atan(y / x) + pi } else { f64_atan(y / x) - pi }
  } else {
    if y > 0.0 { pi * 0.5 } else if y < 0.0 { -pi * 0.5 } else { 0.0 }
  }
}

// ---------------------------------------------------------------------------
// Label & matcher helpers
// ---------------------------------------------------------------------------

fn get_label_val(labels : Array[Label], name : String) -> String {
  let mut i = 0
  while i < labels.length() {
    if labels[i].name == name {
      return labels[i].value
    }
    i = i + 1
  }
  ""
}

fn drop_metric_name(labels : Array[Label]) -> Array[Label] {
  let out : Array[Label] = []
  let mut i = 0
  while i < labels.length() {
    if labels[i].name != "__name__" {
      out.push(labels[i])
    }
    i = i + 1
  }
  out
}

fn set_label(labels : Array[Label], name : String, value : String) -> Array[Label] {
  let out : Array[Label] = []
  let mut found = false
  let mut i = 0
  while i < labels.length() {
    if labels[i].name == name {
      found = true
      if value.length() > 0 {
        out.push(Label::new(name, value))
      }
    } else {
      out.push(labels[i])
    }
    i = i + 1
  }
  if !found && value.length() > 0 {
    out.push(Label::new(name, value))
  }
  sort_labels(out)
}

fn labels_signature(labels : Array[Label]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < labels.length() {
    if i > 0 {
      sb.write_byte(0.to_byte())
    }
    sb.write_string(labels[i].name)
    sb.write_byte(1.to_byte())
    sb.write_string(labels[i].value)
    i = i + 1
  }
  sb.to_string()
}

fn matching_signature(labels : Array[Label], vm : VectorMatching) -> String {
  let picked : Array[Label] = []
  if vm.has_clause {
    if vm.on {
      let mut i = 0
      while i < labels.length() {
        if str_list_contains(vm.matching_labels, labels[i].name) {
          picked.push(labels[i])
        }
        i = i + 1
      }
    } else {
      let mut i = 0
      while i < labels.length() {
        if labels[i].name != "__name__" && !str_list_contains(vm.matching_labels, labels[i].name) {
          picked.push(labels[i])
        }
        i = i + 1
      }
    }
  } else {
    let mut i = 0
    while i < labels.length() {
      if labels[i].name != "__name__" {
        picked.push(labels[i])
      }
      i = i + 1
    }
  }
  labels_signature(picked)
}

fn grouping_labels(labels : Array[Label], grouping : Array[String], without : Bool, has_grouping : Bool) -> Array[Label] {
  let out : Array[Label] = []
  if !has_grouping {
    return out
  }
  if without {
    let mut i = 0
    while i < labels.length() {
      if labels[i].name != "__name__" && !str_list_contains(grouping, labels[i].name) {
        out.push(labels[i])
      }
      i = i + 1
    }
  } else {
    let mut i = 0
    while i < labels.length() {
      if str_list_contains(grouping, labels[i].name) {
        out.push(labels[i])
      }
      i = i + 1
    }
  }
  out
}

struct CompiledMatcher {
  matcher : LabelMatcher
  compiled_re : Option[regex::Regex]
}

fn compile_matchers(matchers : Array[LabelMatcher]) -> Result[Array[CompiledMatcher], PromqlError] {
  let out : Array[CompiledMatcher] = []
  let mut i = 0
  while i < matchers.length() {
    let m = matchers[i]
    let re = match m.op {
      MatchOp::RegexMatch =>
      match compile_promql_regex(m.value) {
        Ok(r) => Some(r)
        Err(msg) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "regex compile error: " + msg))
      }
      MatchOp::RegexNotMatch =>
      match compile_promql_regex(m.value) {
        Ok(r) => Some(r)
        Err(msg) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "regex compile error: " + msg))
      }
      _ => None
    }
    out.push(CompiledMatcher::{ matcher: m, compiled_re: re })
    i = i + 1
  }
  Ok(out)
}

fn series_matches(labels : Array[Label], compiled : Array[CompiledMatcher]) -> Bool {
  let mut i = 0
  while i < compiled.length() {
    let cm = compiled[i]
    let v = get_label_val(labels, cm.matcher.name)
    let ok = match cm.matcher.op {
      MatchOp::Equal => v == cm.matcher.value
      MatchOp::NotEqual => v != cm.matcher.value
      MatchOp::RegexMatch =>
      match cm.compiled_re {
        Some(re) => re.is_match(v)
        None => false
      }
      MatchOp::RegexNotMatch =>
      match cm.compiled_re {
        Some(re) => !re.is_match(v)
        None => true
      }
    }
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

// ---------------------------------------------------------------------------
// Evaluator context
// ---------------------------------------------------------------------------

struct EvalCtx {
  nodes : Array[ExprNode]
  store : SeriesStore
  limits : PromqlLimits
  range_start_ms : Int64
  range_end_ms : Int64
  mut samples_touched : Int
}

fn EvalCtx::resolve_ts(self : EvalCtx, eval_ts_ms : Int64, offset_ms : Int64, at_mod : AtModifier) -> Int64 {
  let base = match at_mod {
    AtModifier::None => eval_ts_ms
    AtModifier::Timestamp(ms) => ms
    AtModifier::Start => self.range_start_ms
    AtModifier::End => self.range_end_ms
  }
  base - offset_ms
}

fn eval_scalar_binop(op : BinOp, a : Double, b : Double, return_bool : Bool) -> (Double, Bool) {
  match op {
    BinOp::Add => (a + b, true)
    BinOp::Sub => (a - b, true)
    BinOp::Mul => (a * b, true)
    BinOp::Div => (a / b, true)
    BinOp::Mod => (f64_mod(a, b), true)
    BinOp::Pow => (f64_pow(a, b), true)
    BinOp::Atan2 => (f64_atan2(a, b), true)
    BinOp::Eql => {
      let c = a == b
      if return_bool { (if c { 1.0 } else { 0.0 }, true) } else { (a, c) }
    }
    BinOp::Neq => {
      let c = a != b
      if return_bool { (if c { 1.0 } else { 0.0 }, true) } else { (a, c) }
    }
    BinOp::Lte => {
      let c = a <= b
      if return_bool { (if c { 1.0 } else { 0.0 }, true) } else { (a, c) }
    }
    BinOp::Lss => {
      let c = a < b
      if return_bool { (if c { 1.0 } else { 0.0 }, true) } else { (a, c) }
    }
    BinOp::Gte => {
      let c = a >= b
      if return_bool { (if c { 1.0 } else { 0.0 }, true) } else { (a, c) }
    }
    BinOp::Gtr => {
      let c = a > b
      if return_bool { (if c { 1.0 } else { 0.0 }, true) } else { (a, c) }
    }
    _ => (0.0 / 0.0, false)
  }
}

fn should_drop_metric_name(op : BinOp, return_bool : Bool) -> Bool {
  if return_bool {
    return true
  }
  !bin_op_is_comparison(op) && !bin_op_is_set(op)
}

fn eval_vector_selector(
  ctx : EvalCtx,
  matchers : Array[LabelMatcher],
  offset_ms : Int64,
  at_mod : AtModifier,
  eval_ts_ms : Int64,
) -> Result[Array[InstantSample], PromqlError] {
  let compiled = match compile_matchers(matchers) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let target_ts = ctx.resolve_ts(eval_ts_ms, offset_ms, at_mod)
  let min_ts = target_ts - ctx.store.lookback_delta_ms
  let out : Array[InstantSample] = []
  let mut i = 0
  while i < ctx.store.series.length() {
    let s = ctx.store.series[i]
    if series_matches(s.labels, compiled) {
      // Find latest sample with min_ts < ts <= target_ts (inclusive on min_ts if exact match)
      let mut best_idx = -1
      let mut j = s.samples.length() - 1
      while j >= 0 {
        let smp = s.samples[j]
        if smp.timestamp_ms <= target_ts {
          if smp.timestamp_ms >= min_ts {
            best_idx = j
          }
          break
        }
        j = j - 1
      }
      if best_idx >= 0 {
        ctx.samples_touched = ctx.samples_touched + 1
        if ctx.samples_touched > ctx.limits.max_samples {
          return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, -1, "max_samples exceeded"))
        }
        if out.length() >= ctx.limits.max_series {
          return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, -1, "max_series exceeded"))
        }
        out.push(InstantSample::new(s.labels, eval_ts_ms, s.samples[best_idx].value))
      }
    }
    i = i + 1
  }
  Ok(out)
}

fn eval_matrix_selector(
  ctx : EvalCtx,
  vs_id : Int,
  range_ms : Int64,
  eval_ts_ms : Int64,
) -> Result[Array[RangeSeries], PromqlError] {
  let (matchers, offset_ms, at_mod) = match ctx.nodes[vs_id] {
    ExprNode::VectorSelector(_, m, off, at_m) => (m, off, at_m)
    _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "invalid matrix selector node"))
  }
  let compiled = match compile_matchers(matchers) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let end_ts = ctx.resolve_ts(eval_ts_ms, offset_ms, at_mod)
  let start_ts = end_ts - range_ms
  let out : Array[RangeSeries] = []
  let mut i = 0
  while i < ctx.store.series.length() {
    let s = ctx.store.series[i]
    if series_matches(s.labels, compiled) {
      let picked : Array[Sample] = []
      let mut j = 0
      while j < s.samples.length() {
        let smp = s.samples[j]
        if smp.timestamp_ms > start_ts && smp.timestamp_ms <= end_ts {
          ctx.samples_touched = ctx.samples_touched + 1
          if ctx.samples_touched > ctx.limits.max_samples {
            return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, -1, "max_samples exceeded"))
          }
          picked.push(smp)
        }
        j = j + 1
      }
      if picked.length() > 0 {
        if out.length() >= ctx.limits.max_series {
          return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, -1, "max_series exceeded"))
        }
        out.push(RangeSeries::{ labels: s.labels, samples: picked })
      }
    }
    i = i + 1
  }
  Ok(out)
}

fn sort_f64_asc(vals : Array[Double]) -> Array[Double] {
  let out : Array[Double] = []
  let mut i = 0
  while i < vals.length() {
    out.push(vals[i])
    i = i + 1
  }
  let mut k = 1
  while k < out.length() {
    let cur = out[k]
    let mut j = k - 1
    while j >= 0 && out[j] > cur {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
    k = k + 1
  }
  out
}

fn compute_quantile(q : Double, raw_vals : Array[Double]) -> Double {
  if raw_vals.length() == 0 || f64_is_nan(q) {
    return 0.0 / 0.0
  }
  if q < 0.0 {
    return -1.0 / 0.0
  }
  if q > 1.0 {
    return 1.0 / 0.0
  }
  let vals = sort_f64_asc(raw_vals)
  let n = vals.length()
  let rank = q * (n - 1).to_double()
  let lo = f64_floor(rank).to_int64().to_int()
  let hi = f64_ceil(rank).to_int64().to_int()
  let lo_c = if lo < 0 { 0 } else if lo >= n { n - 1 } else { lo }
  let hi_c = if hi < 0 { 0 } else if hi >= n { n - 1 } else { hi }
  let frac = rank - lo_c.to_double()
  vals[lo_c] + (vals[hi_c] - vals[lo_c]) * frac
}

fn extrapolated_rate(samples : Array[Sample], range_start_ms : Int64, range_end_ms : Int64, is_counter : Bool, is_rate : Bool) -> Option[Double] {
  let n = samples.length()
  if n < 2 {
    return None
  }
  let first = samples[0]
  let last = samples[n - 1]
  let mut result_val = last.value - first.value
  if is_counter {
    let mut counter_corr = 0.0
    let mut prev = first.value
    let mut i = 1
    while i < n {
      let cur = samples[i].value
      if cur < prev {
        counter_corr = counter_corr + prev
      }
      prev = cur
      i = i + 1
    }
    result_val = result_val + counter_corr
  }
  let duration_to_start = (first.timestamp_ms - range_start_ms).to_double() / 1000.0
  let duration_to_end = (range_end_ms - last.timestamp_ms).to_double() / 1000.0
  let sampled_interval = (last.timestamp_ms - first.timestamp_ms).to_double() / 1000.0
  if sampled_interval <= 0.0 {
    return None
  }
  let avg_interval = sampled_interval / (n - 1).to_double()
  let mut dur_start = duration_to_start
  let mut dur_end = duration_to_end
  if is_counter && result_val > 0.0 && first.value >= 0.0 {
    let duration_to_zero = sampled_interval * (first.value / result_val)
    if duration_to_zero < dur_start {
      dur_start = duration_to_zero
    }
  }
  let extrap_threshold = avg_interval * 1.1
  let mut extrap_interval = sampled_interval
  if dur_start < extrap_threshold {
    extrap_interval = extrap_interval + dur_start
  } else {
    extrap_interval = extrap_interval + avg_interval / 2.0
  }
  if dur_end < extrap_threshold {
    extrap_interval = extrap_interval + dur_end
  } else {
    extrap_interval = extrap_interval + avg_interval / 2.0
  }
  let factor = extrap_interval / sampled_interval
  let mut res = result_val * factor
  if is_rate {
    let range_sec = (range_end_ms - range_start_ms).to_double() / 1000.0
    if range_sec > 0.0 {
      res = res / range_sec
    }
  }
  Some(res)
}

fn eval_histogram_quantile(phi : Double, vec : Array[InstantSample], eval_ts_ms : Int64) -> Array[InstantSample] {
  // Group samples by labels excluding `le` and `__name__`
  let group_keys : Array[String] = []
  let group_labels_arr : Array[Array[Label]] = []
  let group_buckets : Array[Array[(Double, Double)]] = []
  let mut i = 0
  while i < vec.length() {
    let smp = vec[i]
    let le_str = get_label_val(smp.labels, "le")
    if le_str.length() == 0 {
      i = i + 1
      continue
    }
    let le_val = match parse_f64_str(le_str) {
      Ok(v) => v
      Err(_) => {
        i = i + 1
        continue
      }
    }
    let clean_labels : Array[Label] = []
    let mut j = 0
    while j < smp.labels.length() {
      let ln = smp.labels[j].name
      if ln != "le" && ln != "__name__" {
        clean_labels.push(smp.labels[j])
      }
      j = j + 1
    }
    let key = labels_signature(clean_labels)
    let mut gidx = -1
    let mut g = 0
    while g < group_keys.length() {
      if group_keys[g] == key {
        gidx = g
        break
      }
      g = g + 1
    }
    if gidx < 0 {
      gidx = group_keys.length()
      group_keys.push(key)
      group_labels_arr.push(clean_labels)
      group_buckets.push([])
    }
    group_buckets[gidx].push((le_val, smp.value))
    i = i + 1
  }
  let out : Array[InstantSample] = []
  let mut g = 0
  while g < group_keys.length() {
    let buckets = group_buckets[g]
    // Sort buckets ascending by upper bound
    let mut k = 1
    while k < buckets.length() {
      let cur = buckets[k]
      let mut j = k - 1
      while j >= 0 && buckets[j].0 > cur.0 {
        buckets[j + 1] = buckets[j]
        j = j - 1
      }
      buckets[j + 1] = cur
      k = k + 1
    }
    let nb = buckets.length()
    let q_val = if f64_is_nan(phi) {
      0.0 / 0.0
    } else if phi < 0.0 {
      -1.0 / 0.0
    } else if phi > 1.0 {
      1.0 / 0.0
    } else if nb < 2 || !f64_is_inf(buckets[nb - 1].0) {
      0.0 / 0.0
    } else {
      // Ensure monotonicity
      let mut m = 1
      while m < nb {
        if buckets[m].1 < buckets[m - 1].1 {
          buckets[m] = (buckets[m].0, buckets[m - 1].1)
        }
        m = m + 1
      }
      let total = buckets[nb - 1].1
      if total == 0.0 {
        0.0 / 0.0
      } else {
        let rank = phi * total
        let mut b = 0
        while b < nb - 1 && buckets[b].1 < rank {
          b = b + 1
        }
        if b == nb - 1 {
          buckets[nb - 2].0
        } else if b == 0 && buckets[0].0 <= 0.0 {
          buckets[0].0
        } else {
          let bucket_start = if b > 0 { buckets[b - 1].0 } else { 0.0 }
          let bucket_end = buckets[b].0
          let prev_cnt = if b > 0 { buckets[b - 1].1 } else { 0.0 }
          let count = buckets[b].1 - prev_cnt
          let rank_in_bucket = rank - prev_cnt
          if count <= 0.0 {
            bucket_end
          } else {
            bucket_start + (bucket_end - bucket_start) * (rank_in_bucket / count)
          }
        }
      }
    }
    out.push(InstantSample::new(group_labels_arr[g], eval_ts_ms, q_val))
    g = g + 1
  }
  out
}

fn eval_aggregate(
  ctx : EvalCtx,
  op : AggOp,
  inner_id : Int,
  param_id : Int,
  grouping : Array[String],
  without : Bool,
  has_grouping : Bool,
  eval_ts_ms : Int64,
) -> Result[EvalValue, PromqlError] {
  let vec = match eval_node(ctx, inner_id, eval_ts_ms) {
    Ok(EvalValue::Vector(v)) => v
    Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "aggregation expects instant vector"))
    Err(e) => return Err(e)
  }
  let mut param_num = 0.0
  let mut param_str = ""
  if param_id >= 0 {
    match eval_node(ctx, param_id, eval_ts_ms) {
      Ok(EvalValue::Scalar(v)) => param_num = v
      Ok(EvalValue::StringVal(s)) => param_str = s
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "invalid aggregation parameter type"))
      Err(e) => return Err(e)
    }
  }
  // Group samples
  let group_keys : Array[String] = []
  let group_labels_arr : Array[Array[Label]] = []
  let group_samples : Array[Array[InstantSample]] = []
  let mut i = 0
  while i < vec.length() {
    let smp = vec[i]
    let gl = grouping_labels(smp.labels, grouping, without, has_grouping)
    let key = labels_signature(gl)
    let mut gidx = -1
    let mut g = 0
    while g < group_keys.length() {
      if group_keys[g] == key {
        gidx = g
        break
      }
      g = g + 1
    }
    if gidx < 0 {
      gidx = group_keys.length()
      group_keys.push(key)
      group_labels_arr.push(gl)
      group_samples.push([])
    }
    group_samples[gidx].push(smp)
    i = i + 1
  }
  let out : Array[InstantSample] = []
  let mut g = 0
  while g < group_keys.length() {
    let smps = group_samples[g]
    let gl = group_labels_arr[g]
    match op {
      AggOp::Sum => {
        let mut acc = 0.0
        let mut j = 0
        while j < smps.length() {
          acc = acc + smps[j].value
          j = j + 1
        }
        out.push(InstantSample::new(gl, eval_ts_ms, acc))
      }
      AggOp::Avg => {
        let mut acc = 0.0
        let mut j = 0
        while j < smps.length() {
          acc = acc + smps[j].value
          j = j + 1
        }
        out.push(InstantSample::new(gl, eval_ts_ms, acc / smps.length().to_double()))
      }
      AggOp::Min => {
        let mut best = smps[0].value
        let mut j = 1
        while j < smps.length() {
          if smps[j].value < best || f64_is_nan(best) {
            best = smps[j].value
          }
          j = j + 1
        }
        out.push(InstantSample::new(gl, eval_ts_ms, best))
      }
      AggOp::Max => {
        let mut best = smps[0].value
        let mut j = 1
        while j < smps.length() {
          if smps[j].value > best || f64_is_nan(best) {
            best = smps[j].value
          }
          j = j + 1
        }
        out.push(InstantSample::new(gl, eval_ts_ms, best))
      }
      AggOp::Count => out.push(InstantSample::new(gl, eval_ts_ms, smps.length().to_double()))
      AggOp::Group => out.push(InstantSample::new(gl, eval_ts_ms, 1.0))
      AggOp::Stdvar => {
        let mut mean = 0.0
        let mut j = 0
        while j < smps.length() {
          mean = mean + smps[j].value
          j = j + 1
        }
        mean = mean / smps.length().to_double()
        let mut var_sum = 0.0
        j = 0
        while j < smps.length() {
          let d = smps[j].value - mean
          var_sum = var_sum + d * d
          j = j + 1
        }
        out.push(InstantSample::new(gl, eval_ts_ms, var_sum / smps.length().to_double()))
      }
      AggOp::Stddev => {
        let mut mean = 0.0
        let mut j = 0
        while j < smps.length() {
          mean = mean + smps[j].value
          j = j + 1
        }
        mean = mean / smps.length().to_double()
        let mut var_sum = 0.0
        j = 0
        while j < smps.length() {
          let d = smps[j].value - mean
          var_sum = var_sum + d * d
          j = j + 1
        }
        out.push(InstantSample::new(gl, eval_ts_ms, f64_sqrt(var_sum / smps.length().to_double())))
      }
      AggOp::Quantile => {
        let vals : Array[Double] = []
        let mut j = 0
        while j < smps.length() {
          vals.push(smps[j].value)
          j = j + 1
        }
        out.push(InstantSample::new(gl, eval_ts_ms, compute_quantile(param_num, vals)))
      }
      AggOp::Topk => {
        let k = param_num.to_int64().to_int()
        if k > 0 {
          // Sort descending
          let sorted : Array[InstantSample] = []
          let mut j = 0
          while j < smps.length() {
            sorted.push(smps[j])
            j = j + 1
          }
          let mut a = 1
          while a < sorted.length() {
            let cur = sorted[a]
            let mut b = a - 1
            while b >= 0 && sorted[b].value < cur.value {
              sorted[b + 1] = sorted[b]
              b = b - 1
            }
            sorted[b + 1] = cur
            a = a + 1
          }
          let lim = if k < sorted.length() { k } else { sorted.length() }
          j = 0
          while j < lim {
            out.push(sorted[j])
            j = j + 1
          }
        }
      }
      AggOp::Bottomk => {
        let k = param_num.to_int64().to_int()
        if k > 0 {
          let sorted : Array[InstantSample] = []
          let mut j = 0
          while j < smps.length() {
            sorted.push(smps[j])
            j = j + 1
          }
          let mut a = 1
          while a < sorted.length() {
            let cur = sorted[a]
            let mut b = a - 1
            while b >= 0 && sorted[b].value > cur.value {
              sorted[b + 1] = sorted[b]
              b = b - 1
            }
            sorted[b + 1] = cur
            a = a + 1
          }
          let lim = if k < sorted.length() { k } else { sorted.length() }
          j = 0
          while j < lim {
            out.push(sorted[j])
            j = j + 1
          }
        }
      }
      AggOp::CountValues => {
        let val_strs : Array[String] = []
        let val_counts : Array[Int] = []
        let mut j = 0
        while j < smps.length() {
          let vs = format_number_lit(smps[j].value)
          let mut idx = -1
          let mut u = 0
          while u < val_strs.length() {
            if val_strs[u] == vs {
              idx = u
              break
            }
            u = u + 1
          }
          if idx < 0 {
            val_strs.push(vs)
            val_counts.push(1)
          } else {
            val_counts[idx] = val_counts[idx] + 1
          }
          j = j + 1
        }
        j = 0
        while j < val_strs.length() {
          let nl = set_label(gl, param_str, val_strs[j])
          out.push(InstantSample::new(nl, eval_ts_ms, val_counts[j].to_double()))
          j = j + 1
        }
      }
      AggOp::Limitk => {
        let k = param_num.to_int64().to_int()
        let lim = if k < 0 { 0 } else if k < smps.length() { k } else { smps.length() }
        let mut j = 0
        while j < lim {
          out.push(smps[j])
          j = j + 1
        }
      }
      AggOp::LimitRatio => {
        let r = if param_num < 0.0 { 0.0 } else if param_num > 1.0 { 1.0 } else { param_num }
        let lim = f64_floor(r * smps.length().to_double()).to_int64().to_int()
        let mut j = 0
        while j < lim && j < smps.length() {
          out.push(smps[j])
          j = j + 1
        }
      }
    }
    g = g + 1
  }
  Ok(EvalValue::Vector(out))
}

fn eval_call(ctx : EvalCtx, name : String, args : Array[Int], eval_ts_ms : Int64) -> Result[EvalValue, PromqlError] {
  if name == "time" {
    return Ok(EvalValue::Scalar(eval_ts_ms.to_double() / 1000.0))
  }
  if name == "pi" {
    return Ok(EvalValue::Scalar(3.141592653589793))
  }
  if name == "vector" {
    match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Scalar(v)) => return Ok(EvalValue::Vector([InstantSample::new([], eval_ts_ms, v)]))
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "vector() expects scalar"))
      Err(e) => return Err(e)
    }
  }
  if name == "scalar" {
    match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Vector(vs)) => {
        if vs.length() == 1 {
          return Ok(EvalValue::Scalar(vs[0].value))
        }
        return Ok(EvalValue::Scalar(0.0 / 0.0))
      }
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "scalar() expects vector"))
      Err(e) => return Err(e)
    }
  }
  if name == "absent" {
    match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Vector(vs)) => {
        if vs.length() > 0 {
          return Ok(EvalValue::Vector([]))
        }
        // Build labels from equality matchers if arg is VectorSelector
        let labels : Array[Label] = []
        match ctx.nodes[args[0]] {
          ExprNode::VectorSelector(_, matchers, _, _) => {
            let mut i = 0
            while i < matchers.length() {
              let m = matchers[i]
              if match_op_eq(m.op, MatchOp::Equal) && m.name != "__name__" {
                labels.push(Label::new(m.name, m.value))
              }
              i = i + 1
            }
          }
          _ => ()
        }
        return Ok(EvalValue::Vector([InstantSample::new(sort_labels(labels), eval_ts_ms, 1.0)]))
      }
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "absent() expects vector"))
      Err(e) => return Err(e)
    }
  }
  // Range vector functions
  if name == "rate" || name == "irate" || name == "increase" || name == "delta" || name == "idelta" ||
  name == "changes" || name == "resets" ||
  name == "avg_over_time" || name == "sum_over_time" || name == "min_over_time" || name == "max_over_time" ||
  name == "count_over_time" || name == "stddev_over_time" || name == "stdvar_over_time" ||
  name == "last_over_time" || name == "present_over_time" || name == "absent_over_time" {
    let mat_arg = args[0]
    let range_ms = match ctx.nodes[mat_arg] {
      ExprNode::MatrixSelector(_, r) => r
      ExprNode::SubqueryExpr(_, r, _, _, _) => r
      _ => 0L
    }
    let mat = match eval_node(ctx, mat_arg, eval_ts_ms) {
      Ok(EvalValue::Matrix(m)) => m
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, name + " expects range vector"))
      Err(e) => return Err(e)
    }
    if name == "absent_over_time" {
      if mat.length() > 0 {
        return Ok(EvalValue::Vector([]))
      }
      return Ok(EvalValue::Vector([InstantSample::new([], eval_ts_ms, 1.0)]))
    }
    let out : Array[InstantSample] = []
    let mut i = 0
    while i < mat.length() {
      let rs = mat[i]
      let smps = rs.samples
      let n = smps.length()
      if n == 0 {
        i = i + 1
        continue
      }
      let out_labels = drop_metric_name(rs.labels)
      if name == "rate" {
        match extrapolated_rate(smps, eval_ts_ms - range_ms, eval_ts_ms, true, true) {
          Some(v) => out.push(InstantSample::new(out_labels, eval_ts_ms, v))
          None => ()
        }
      } else if name == "increase" {
        match extrapolated_rate(smps, eval_ts_ms - range_ms, eval_ts_ms, true, false) {
          Some(v) => out.push(InstantSample::new(out_labels, eval_ts_ms, v))
          None => ()
        }
      } else if name == "delta" {
        match extrapolated_rate(smps, eval_ts_ms - range_ms, eval_ts_ms, false, false) {
          Some(v) => out.push(InstantSample::new(out_labels, eval_ts_ms, v))
          None => ()
        }
      } else if name == "irate" {
        if n >= 2 {
          let prev = smps[n - 2]
          let last = smps[n - 1]
          let dt = (last.timestamp_ms - prev.timestamp_ms).to_double() / 1000.0
          if dt > 0.0 {
            let diff = if last.value < prev.value { last.value } else { last.value - prev.value }
            out.push(InstantSample::new(out_labels, eval_ts_ms, diff / dt))
          }
        }
      } else if name == "idelta" {
        if n >= 2 {
          out.push(InstantSample::new(out_labels, eval_ts_ms, smps[n - 1].value - smps[n - 2].value))
        }
      } else if name == "changes" {
        let mut cnt = 0
        let mut j = 1
        while j < n {
          if smps[j].value != smps[j - 1].value {
            cnt = cnt + 1
          }
          j = j + 1
        }
        out.push(InstantSample::new(out_labels, eval_ts_ms, cnt.to_double()))
      } else if name == "resets" {
        let mut cnt = 0
        let mut j = 1
        while j < n {
          if smps[j].value < smps[j - 1].value {
            cnt = cnt + 1
          }
          j = j + 1
        }
        out.push(InstantSample::new(out_labels, eval_ts_ms, cnt.to_double()))
      } else if name == "sum_over_time" {
        let mut acc = 0.0
        let mut j = 0
        while j < n {
          acc = acc + smps[j].value
          j = j + 1
        }
        out.push(InstantSample::new(out_labels, eval_ts_ms, acc))
      } else if name == "avg_over_time" {
        let mut acc = 0.0
        let mut j = 0
        while j < n {
          acc = acc + smps[j].value
          j = j + 1
        }
        out.push(InstantSample::new(out_labels, eval_ts_ms, acc / n.to_double()))
      } else if name == "min_over_time" {
        let mut best = smps[0].value
        let mut j = 1
        while j < n {
          if smps[j].value < best { best = smps[j].value }
          j = j + 1
        }
        out.push(InstantSample::new(out_labels, eval_ts_ms, best))
      } else if name == "max_over_time" {
        let mut best = smps[0].value
        let mut j = 1
        while j < n {
          if smps[j].value > best { best = smps[j].value }
          j = j + 1
        }
        out.push(InstantSample::new(out_labels, eval_ts_ms, best))
      } else if name == "count_over_time" {
        out.push(InstantSample::new(out_labels, eval_ts_ms, n.to_double()))
      } else if name == "last_over_time" {
        out.push(InstantSample::new(out_labels, eval_ts_ms, smps[n - 1].value))
      } else if name == "present_over_time" {
        out.push(InstantSample::new(out_labels, eval_ts_ms, 1.0))
      } else if name == "stdvar_over_time" || name == "stddev_over_time" {
        let mut mean = 0.0
        let mut j = 0
        while j < n {
          mean = mean + smps[j].value
          j = j + 1
        }
        mean = mean / n.to_double()
        let mut vsum = 0.0
        j = 0
        while j < n {
          let d = smps[j].value - mean
          vsum = vsum + d * d
          j = j + 1
        }
        let variance = vsum / n.to_double()
        let v = if name == "stddev_over_time" { f64_sqrt(variance) } else { variance }
        out.push(InstantSample::new(out_labels, eval_ts_ms, v))
      }
      i = i + 1
    }
    return Ok(EvalValue::Vector(out))
  }
  if name == "quantile_over_time" {
    let q = match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Scalar(v)) => v
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "quantile_over_time arg 1 expects scalar"))
      Err(e) => return Err(e)
    }
    let mat = match eval_node(ctx, args[1], eval_ts_ms) {
      Ok(EvalValue::Matrix(m)) => m
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "quantile_over_time arg 2 expects matrix"))
      Err(e) => return Err(e)
    }
    let out : Array[InstantSample] = []
    let mut i = 0
    while i < mat.length() {
      let vals : Array[Double] = []
      let mut j = 0
      while j < mat[i].samples.length() {
        vals.push(mat[i].samples[j].value)
        j = j + 1
      }
      out.push(InstantSample::new(drop_metric_name(mat[i].labels), eval_ts_ms, compute_quantile(q, vals)))
      i = i + 1
    }
    return Ok(EvalValue::Vector(out))
  }
  if name == "histogram_quantile" {
    let phi = match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Scalar(v)) => v
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "histogram_quantile arg 1 expects scalar"))
      Err(e) => return Err(e)
    }
    let vec = match eval_node(ctx, args[1], eval_ts_ms) {
      Ok(EvalValue::Vector(v)) => v
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "histogram_quantile arg 2 expects vector"))
      Err(e) => return Err(e)
    }
    return Ok(EvalValue::Vector(eval_histogram_quantile(phi, vec, eval_ts_ms)))
  }
  if name == "label_replace" {
    let vec = match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Vector(v)) => v
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_replace expects vector"))
      Err(e) => return Err(e)
    }
    let dst = match eval_node(ctx, args[1], eval_ts_ms) {
      Ok(EvalValue::StringVal(s)) => s
      _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_replace dst expects string"))
    }
    let repl = match eval_node(ctx, args[2], eval_ts_ms) {
      Ok(EvalValue::StringVal(s)) => s
      _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_replace replacement expects string"))
    }
    let src = match eval_node(ctx, args[3], eval_ts_ms) {
      Ok(EvalValue::StringVal(s)) => s
      _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_replace src expects string"))
    }
    let pat = match eval_node(ctx, args[4], eval_ts_ms) {
      Ok(EvalValue::StringVal(s)) => s
      _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_replace regex expects string"))
    }
    let re = match compile_promql_regex(pat) {
      Ok(r) => r
      Err(msg) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_replace regex error: " + msg))
    }
    let out : Array[InstantSample] = []
    let mut i = 0
    while i < vec.length() {
      let smp = vec[i]
      let src_val = get_label_val(smp.labels, src)
      if re.is_match(src_val) {
        let new_val = re.replace(src_val, repl)
        let nl = set_label(smp.labels, dst, new_val)
        out.push(InstantSample::new(nl, smp.timestamp_ms, smp.value))
      } else {
        out.push(smp)
      }
      i = i + 1
    }
    return Ok(EvalValue::Vector(out))
  }
  if name == "label_join" {
    let vec = match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Vector(v)) => v
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_join expects vector"))
      Err(e) => return Err(e)
    }
    let dst = match eval_node(ctx, args[1], eval_ts_ms) {
      Ok(EvalValue::StringVal(s)) => s
      _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_join dst expects string"))
    }
    let sep = match eval_node(ctx, args[2], eval_ts_ms) {
      Ok(EvalValue::StringVal(s)) => s
      _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_join sep expects string"))
    }
    let srcs : Array[String] = []
    let mut a = 3
    while a < args.length() {
      match eval_node(ctx, args[a], eval_ts_ms) {
        Ok(EvalValue::StringVal(s)) => srcs.push(s)
        _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "label_join src expects string"))
      }
      a = a + 1
    }
    let out : Array[InstantSample] = []
    let mut i = 0
    while i < vec.length() {
      let smp = vec[i]
      let sb = StringBuilder::new()
      let mut s = 0
      while s < srcs.length() {
        if s > 0 {
          sb.write_string(sep)
        }
        sb.write_string(get_label_val(smp.labels, srcs[s]))
        s = s + 1
      }
      let nl = set_label(smp.labels, dst, sb.to_string())
      out.push(InstantSample::new(nl, smp.timestamp_ms, smp.value))
      i = i + 1
    }
    return Ok(EvalValue::Vector(out))
  }
  if name == "sort" || name == "sort_desc" {
    let vec = match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Vector(v)) => v
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, name + " expects vector"))
      Err(e) => return Err(e)
    }
    let out : Array[InstantSample] = []
    let mut i = 0
    while i < vec.length() {
      out.push(vec[i])
      i = i + 1
    }
    let desc = name == "sort_desc"
    let mut k = 1
    while k < out.length() {
      let cur = out[k]
      let mut j = k - 1
      while j >= 0 && (if desc { out[j].value < cur.value } else { out[j].value > cur.value }) {
        out[j + 1] = out[j]
        j = j - 1
      }
      out[j + 1] = cur
      k = k + 1
    }
    return Ok(EvalValue::Vector(out))
  }
  if name == "clamp" || name == "clamp_min" || name == "clamp_max" {
    let vec = match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Vector(v)) => v
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, name + " expects vector"))
      Err(e) => return Err(e)
    }
    let mut lo = -1.0 / 0.0
    let mut hi = 1.0 / 0.0
    if name == "clamp" {
      match eval_node(ctx, args[1], eval_ts_ms) {
        Ok(EvalValue::Scalar(v)) => lo = v
        _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "clamp min expects scalar"))
      }
      match eval_node(ctx, args[2], eval_ts_ms) {
        Ok(EvalValue::Scalar(v)) => hi = v
        _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "clamp max expects scalar"))
      }
      if lo > hi {
        return Ok(EvalValue::Vector([]))
      }
    } else if name == "clamp_min" {
      match eval_node(ctx, args[1], eval_ts_ms) {
        Ok(EvalValue::Scalar(v)) => lo = v
        _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "clamp_min expects scalar"))
      }
    } else {
      match eval_node(ctx, args[1], eval_ts_ms) {
        Ok(EvalValue::Scalar(v)) => hi = v
        _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "clamp_max expects scalar"))
      }
    }
    let out : Array[InstantSample] = []
    let mut i = 0
    while i < vec.length() {
      let mut v = vec[i].value
      if v < lo { v = lo }
      if v > hi { v = hi }
      out.push(InstantSample::new(drop_metric_name(vec[i].labels), vec[i].timestamp_ms, v))
      i = i + 1
    }
    return Ok(EvalValue::Vector(out))
  }
  if name == "round" {
    let vec = match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Vector(v)) => v
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "round expects vector"))
      Err(e) => return Err(e)
    }
    let mut to_nearest = 1.0
    if args.length() == 2 {
      match eval_node(ctx, args[1], eval_ts_ms) {
        Ok(EvalValue::Scalar(v)) => to_nearest = v
        _ => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "round arg 2 expects scalar"))
      }
    }
    let inv = 1.0 / to_nearest
    let out : Array[InstantSample] = []
    let mut i = 0
    while i < vec.length() {
      let v = f64_floor(vec[i].value * inv + 0.5) / inv
      out.push(InstantSample::new(drop_metric_name(vec[i].labels), vec[i].timestamp_ms, v))
      i = i + 1
    }
    return Ok(EvalValue::Vector(out))
  }
  // Single-vector elementwise math functions
  if name == "abs" || name == "ceil" || name == "floor" || name == "sqrt" || name == "exp" ||
  name == "ln" || name == "log2" || name == "log10" || name == "sgn" || name == "timestamp" {
    let vec = match eval_node(ctx, args[0], eval_ts_ms) {
      Ok(EvalValue::Vector(v)) => v
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, name + " expects vector"))
      Err(e) => return Err(e)
    }
    let out : Array[InstantSample] = []
    let mut i = 0
    while i < vec.length() {
      let x = vec[i].value
      let y = if name == "abs" {
        f64_abs(x)
      } else if name == "ceil" {
        f64_ceil(x)
      } else if name == "floor" {
        f64_floor(x)
      } else if name == "sqrt" {
        f64_sqrt(x)
      } else if name == "exp" {
        f64_exp(x)
      } else if name == "ln" {
        f64_ln(x)
      } else if name == "log2" {
        f64_ln(x) / 0.6931471805599453
      } else if name == "log10" {
        f64_ln(x) / 2.302585092994046
      } else if name == "sgn" {
        if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else if x == 0.0 { 0.0 } else { x }
      } else {
        vec[i].timestamp_ms.to_double() / 1000.0
      }
      out.push(InstantSample::new(drop_metric_name(vec[i].labels), vec[i].timestamp_ms, y))
      i = i + 1
    }
    return Ok(EvalValue::Vector(out))
  }
  Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "function not supported in evaluator: " + name))
}

fn eval_binary(
  ctx : EvalCtx,
  op : BinOp,
  lhs_id : Int,
  rhs_id : Int,
  return_bool : Bool,
  vm : VectorMatching,
  eval_ts_ms : Int64,
) -> Result[EvalValue, PromqlError] {
  let lv = match eval_node(ctx, lhs_id, eval_ts_ms) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let rv = match eval_node(ctx, rhs_id, eval_ts_ms) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let drop_name = should_drop_metric_name(op, return_bool)
  match (lv, rv) {
    (EvalValue::Scalar(a), EvalValue::Scalar(b)) => {
      let (res, _) = eval_scalar_binop(op, a, b, return_bool)
      Ok(EvalValue::Scalar(res))
    }
    (EvalValue::Vector(vs), EvalValue::Scalar(b)) => {
      let out : Array[InstantSample] = []
      let mut i = 0
      while i < vs.length() {
        let (res, keep) = eval_scalar_binop(op, vs[i].value, b, return_bool)
        if keep {
          let nl = if drop_name { drop_metric_name(vs[i].labels) } else { vs[i].labels }
          out.push(InstantSample::new(nl, eval_ts_ms, res))
        }
        i = i + 1
      }
      Ok(EvalValue::Vector(out))
    }
    (EvalValue::Scalar(a), EvalValue::Vector(vs)) => {
      let out : Array[InstantSample] = []
      let mut i = 0
      while i < vs.length() {
        let (res, keep) = eval_scalar_binop(op, a, vs[i].value, return_bool)
        if keep {
          let nl = if drop_name { drop_metric_name(vs[i].labels) } else { vs[i].labels }
          out.push(InstantSample::new(nl, eval_ts_ms, res))
        }
        i = i + 1
      }
      Ok(EvalValue::Vector(out))
    }
    (EvalValue::Vector(lvec), EvalValue::Vector(rvec)) => {
      // Set operations: and, or, unless
      if bin_op_is_set(op) {
        let r_sigs : Array[String] = []
        let mut r = 0
        while r < rvec.length() {
          r_sigs.push(matching_signature(rvec[r].labels, vm))
          r = r + 1
        }
        let out : Array[InstantSample] = []
        match op {
          BinOp::And => {
            let mut l = 0
            while l < lvec.length() {
              let sig = matching_signature(lvec[l].labels, vm)
              if str_list_contains(r_sigs, sig) {
                out.push(lvec[l])
              }
              l = l + 1
            }
          }
          BinOp::Unless => {
            let mut l = 0
            while l < lvec.length() {
              let sig = matching_signature(lvec[l].labels, vm)
              if !str_list_contains(r_sigs, sig) {
                out.push(lvec[l])
              }
              l = l + 1
            }
          }
          BinOp::Or => {
            let l_sigs : Array[String] = []
            let mut l = 0
            while l < lvec.length() {
              l_sigs.push(matching_signature(lvec[l].labels, vm))
              out.push(lvec[l])
              l = l + 1
            }
            let mut j = 0
            while j < rvec.length() {
              if !str_list_contains(l_sigs, r_sigs[j]) {
                out.push(rvec[j])
              }
              j = j + 1
            }
          }
          _ => ()
        }
        return Ok(EvalValue::Vector(out))
      }
      // Arithmetic / comparison vector-vector matching (1:1, N:1 group_left, 1:N group_right)
      let out : Array[InstantSample] = []
      match vm.card {
        VectorMatchCardinality::OneToMany => {
          // group_right: each RHS matches at most 1 LHS; result takes RHS labels + include_labels from LHS
          let l_sigs : Array[String] = []
          let mut l = 0
          while l < lvec.length() {
            l_sigs.push(matching_signature(lvec[l].labels, vm))
            l = l + 1
          }
          let mut r = 0
          while r < rvec.length() {
            let rsig = matching_signature(rvec[r].labels, vm)
            let mut matched = -1
            l = 0
            while l < lvec.length() {
              if l_sigs[l] == rsig {
                if matched >= 0 {
                  return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "found duplicate series for the match group on the left hand-side"))
                }
                matched = l
              }
              l = l + 1
            }
            if matched >= 0 {
              let (res, keep) = eval_scalar_binop(op, lvec[matched].value, rvec[r].value, return_bool)
              if keep {
                let mut nl = if drop_name { drop_metric_name(rvec[r].labels) } else { rvec[r].labels }
                let mut k = 0
                while k < vm.include_labels.length() {
                  let inc = vm.include_labels[k]
                  let iv = get_label_val(lvec[matched].labels, inc)
                  if iv.length() > 0 {
                    nl = set_label(nl, inc, iv)
                  }
                  k = k + 1
                }
                out.push(InstantSample::new(nl, eval_ts_ms, res))
              }
            }
            r = r + 1
          }
        }
        _ => {
          // OneToOne or ManyToOne (group_left): each LHS matches at most 1 RHS
          let r_sigs : Array[String] = []
          let mut r = 0
          while r < rvec.length() {
            r_sigs.push(matching_signature(rvec[r].labels, vm))
            r = r + 1
          }
          let mut l = 0
          while l < lvec.length() {
            let lsig = matching_signature(lvec[l].labels, vm)
            let mut matched = -1
            r = 0
            while r < rvec.length() {
              if r_sigs[r] == lsig {
                if matched >= 0 {
                  return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "found duplicate series for the match group on the right hand-side"))
                }
                matched = r
              }
              r = r + 1
            }
            if matched >= 0 {
              let (res, keep) = eval_scalar_binop(op, lvec[l].value, rvec[matched].value, return_bool)
              if keep {
                let mut nl = if drop_name { drop_metric_name(lvec[l].labels) } else { lvec[l].labels }
                let mut k = 0
                while k < vm.include_labels.length() {
                  let inc = vm.include_labels[k]
                  let iv = get_label_val(rvec[matched].labels, inc)
                  if iv.length() > 0 {
                    nl = set_label(nl, inc, iv)
                  }
                  k = k + 1
                }
                out.push(InstantSample::new(nl, eval_ts_ms, res))
              }
            }
            l = l + 1
          }
        }
      }
      Ok(EvalValue::Vector(out))
    }
    _ => Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "invalid operand types for binary expression"))
  }
}

fn eval_node(ctx : EvalCtx, id : Int, eval_ts_ms : Int64) -> Result[EvalValue, PromqlError] {
  match ctx.nodes[id] {
    ExprNode::NumberLiteral(v) => Ok(EvalValue::Scalar(v))
    ExprNode::StringLiteral(s) => Ok(EvalValue::StringVal(s))
    ExprNode::ParenExpr(inner) => eval_node(ctx, inner, eval_ts_ms)
    ExprNode::VectorSelector(_, matchers, offset_ms, at_mod) =>
    match eval_vector_selector(ctx, matchers, offset_ms, at_mod, eval_ts_ms) {
      Ok(vs) => Ok(EvalValue::Vector(vs))
      Err(e) => Err(e)
    }
    ExprNode::MatrixSelector(vs_id, range_ms) =>
    match eval_matrix_selector(ctx, vs_id, range_ms, eval_ts_ms) {
      Ok(ms) => Ok(EvalValue::Matrix(ms))
      Err(e) => Err(e)
    }
    ExprNode::SubqueryExpr(inner, range_ms, step_ms, offset_ms, at_mod) => {
      let end_ts = ctx.resolve_ts(eval_ts_ms, offset_ms, at_mod)
      let start_ts = end_ts - range_ms
      let step = if step_ms > 0L { step_ms } else { 60000L }
      let mut t = ((start_ts / step) + 1L) * step
      if start_ts % step == 0L {
        t = start_ts
      }
      let series_keys : Array[String] = []
      let series_labels : Array[Array[Label]] = []
      let series_samples : Array[Array[Sample]] = []
      while t <= end_ts {
        match eval_node(ctx, inner, t) {
          Ok(EvalValue::Vector(vs)) => {
            let mut i = 0
            while i < vs.length() {
              let key = labels_signature(vs[i].labels)
              let mut sidx = -1
              let mut s = 0
              while s < series_keys.length() {
                if series_keys[s] == key {
                  sidx = s
                  break
                }
                s = s + 1
              }
              if sidx < 0 {
                if series_keys.length() >= ctx.limits.max_series {
                  return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, -1, "max_series exceeded in subquery"))
                }
                sidx = series_keys.length()
                series_keys.push(key)
                series_labels.push(vs[i].labels)
                series_samples.push([])
              }
              series_samples[sidx].push(Sample::new(t, vs[i].value))
              i = i + 1
            }
          }
          Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "subquery inner expr must return vector"))
          Err(e) => return Err(e)
        }
        t = t + step
      }
      let out : Array[RangeSeries] = []
      let mut s = 0
      while s < series_keys.length() {
        out.push(RangeSeries::{ labels: series_labels[s], samples: series_samples[s] })
        s = s + 1
      }
      Ok(EvalValue::Matrix(out))
    }
    ExprNode::UnaryExpr(op, inner) =>
    match eval_node(ctx, inner, eval_ts_ms) {
      Ok(EvalValue::Scalar(v)) =>
      match op {
        UnaryOp::Plus => Ok(EvalValue::Scalar(v))
        UnaryOp::Minus => Ok(EvalValue::Scalar(-v))
      }
      Ok(EvalValue::Vector(vs)) =>
      match op {
        UnaryOp::Plus => Ok(EvalValue::Vector(vs))
        UnaryOp::Minus => {
          let out : Array[InstantSample] = []
          let mut i = 0
          while i < vs.length() {
            out.push(InstantSample::new(drop_metric_name(vs[i].labels), vs[i].timestamp_ms, -vs[i].value))
            i = i + 1
          }
          Ok(EvalValue::Vector(out))
        }
      }
      Ok(_) => Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "unary op expects scalar or vector"))
      Err(e) => Err(e)
    }
    ExprNode::BinaryExpr(op, lhs, rhs, return_bool, vm) =>
    eval_binary(ctx, op, lhs, rhs, return_bool, vm, eval_ts_ms)
    ExprNode::AggregateExpr(op, inner, param_id, grouping, without, has_grouping) =>
    eval_aggregate(ctx, op, inner, param_id, grouping, without, has_grouping, eval_ts_ms)
    ExprNode::Call(name, args, _) => eval_call(ctx, name, args, eval_ts_ms)
  }
}

///| Evaluate a parsed PromQL expression at `eval_ts_ms`.
pub fn eval_instant_impl(
  expr : ParsedExpr,
  store : SeriesStore,
  eval_ts_ms : Int64,
  limits : PromqlLimits,
) -> Result[EvalValue, PromqlError] {
  match validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if expr.root < 0 || expr.root >= expr.nodes.length() {
    return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "invalid parsed expression"))
  }
  let ctx = EvalCtx::{
    nodes: expr.nodes,
    store,
    limits,
    range_start_ms: eval_ts_ms,
    range_end_ms: eval_ts_ms,
    samples_touched: 0,
  }
  eval_node(ctx, expr.root, eval_ts_ms)
}

///| Evaluate a parsed PromQL expression over `[start_ms, end_ms]` with step `step_ms`.
pub fn eval_range_impl(
  expr : ParsedExpr,
  store : SeriesStore,
  start_ms : Int64,
  end_ms : Int64,
  step_ms : Int64,
  limits : PromqlLimits,
) -> Result[EvalMatrix, PromqlError] {
  match validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if step_ms <= 0L {
    return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "step_ms must be positive"))
  }
  if end_ms < start_ms {
    return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "end_ms must be >= start_ms"))
  }
  let ctx = EvalCtx::{
    nodes: expr.nodes,
    store,
    limits,
    range_start_ms: start_ms,
    range_end_ms: end_ms,
    samples_touched: 0,
  }
  let series_keys : Array[String] = []
  let series_labels : Array[Array[Label]] = []
  let series_samples : Array[Array[Sample]] = []
  let mut t = start_ms
  while t <= end_ms {
    match eval_node(ctx, expr.root, t) {
      Ok(EvalValue::Vector(vs)) => {
        let mut i = 0
        while i < vs.length() {
          let key = labels_signature(vs[i].labels)
          let mut sidx = -1
          let mut s = 0
          while s < series_keys.length() {
            if series_keys[s] == key {
              sidx = s
              break
            }
            s = s + 1
          }
          if sidx < 0 {
            if series_keys.length() >= limits.max_series {
              return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, -1, "max_series exceeded in eval_range"))
            }
            sidx = series_keys.length()
            series_keys.push(key)
            series_labels.push(vs[i].labels)
            series_samples.push([])
          }
          series_samples[sidx].push(Sample::new(t, vs[i].value))
          i = i + 1
        }
      }
      Ok(EvalValue::Scalar(v)) => {
        if series_keys.length() == 0 {
          series_keys.push("")
          series_labels.push([])
          series_samples.push([])
        }
        series_samples[0].push(Sample::new(t, v))
      }
      Ok(_) => return Err(PromqlError::new(PromqlErrorKind::EvalError, -1, "eval_range requires scalar or instant vector expression"))
      Err(e) => return Err(e)
    }
    t = t + step_ms
  }
  let out : Array[RangeSeries] = []
  let mut s = 0
  while s < series_keys.length() {
    out.push(RangeSeries::{ labels: series_labels[s], samples: series_samples[s] })
    s = s + 1
  }
  Ok(EvalMatrix::{ series: out })
}
