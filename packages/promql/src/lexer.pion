///| PromQL lexer and Prometheus duration parser/formatter.

///| Token kind produced by the PromQL lexer.
pub enum TokenKind {
  Eof
  Number
  Duration
  StringLit
  Ident
  MetricIdent
  // Arithmetic & power
  Plus
  Minus
  Mul
  Div
  Mod
  Pow
  // Comparison & matchers
  Eql
  Neq
  Lte
  Lss
  Gte
  Gtr
  Assign
  EqlRegex
  NeqRegex
  // Punctuation
  LParen
  RParen
  LBrace
  RBrace
  LBracket
  RBracket
  Comma
  Colon
  At
}

///| A single lexed token.
pub struct Token {
  pub kind : TokenKind
  pub pos : Int
  pub text : String
  pub num_val : Double
  pub dur_ms : Int64
}

fn tok(kind : TokenKind, pos : Int, text : String) -> Token {
  Token::{ kind, pos, text, num_val: 0.0, dur_ms: 0L }
}

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn hex_digit_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn is_ident_start(b : Int) -> Bool {
  is_ascii_alpha(b) || b == 95
}

fn is_ident_cont(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b) || b == 95
}

fn is_metric_start(b : Int) -> Bool {
  is_ident_start(b) || b == 58
}

fn is_metric_cont(b : Int) -> Bool {
  is_ident_cont(b) || b == 58
}

fn is_dur_unit_start(b : Int) -> Bool {
  b == 109 || b == 115 || b == 104 || b == 100 || b == 119 || b == 121
}

///| Lowercase an ASCII string for case-insensitive PromQL keyword matching.
pub fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut needs_change = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      needs_change = true
      break
    }
    i = i + 1
  }
  if !needs_change {
    return s
  }
  let sb = StringBuilder::new()
  let mut j = 0
  while j < n {
    let b = s.code_unit_at(j)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    j = j + 1
  }
  sb.to_string()
}

///| Check whether `s` is a valid legacy PromQL label name (`[a-zA-Z_][a-zA-Z0-9_]*`).
pub fn is_valid_label_name(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  if !is_ident_start(s.code_unit_at(0)) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_ident_cont(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Check whether `s` is a valid legacy PromQL metric name (`[a-zA-Z_:][a-zA-Z0-9_:]*`).
pub fn is_valid_metric_name(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  if !is_metric_start(s.code_unit_at(0)) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_metric_cont(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Maximum Prometheus duration in milliseconds (Go `time.Duration` max is `MaxInt64` ns = 9223372036854 ms).
let max_duration_ms : Int64 = 9223372036854L

///| Parse a Prometheus compound duration slice `input[start..end]` into milliseconds.
fn parse_duration_ms_range(input : String, start : Int, end : Int) -> Result[Int64, PromqlError] {
  if start >= end {
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "empty duration string"))
  }
  let mut i = start
  let mut total_ms : Int64 = 0L
  // Unit rank: y=7, w=6, d=5, h=4, m=3, s=2, ms=1. Must be strictly descending.
  let mut prev_rank = 8
  while i < end {
    if !is_ascii_digit(input.code_unit_at(i)) {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i - start, "expected digit in duration"))
    }
    let mut num : Int64 = 0L
    while i < end && is_ascii_digit(input.code_unit_at(i)) {
      let d = (input.code_unit_at(i) - 48).to_int64()
      if num > (max_duration_ms - d) / 10L {
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i - start, "duration overflow"))
      }
      num = num * 10L + d
      i = i + 1
    }
    if i >= end {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i - start, "missing unit in duration"))
    }
    let u0 = input.code_unit_at(i)
    let mut rank = 0
    let mut mult : Int64 = 0L
    if u0 == 121 {
      // y
      rank = 7
      mult = 31536000000L
      i = i + 1
    } else if u0 == 119 {
      // w
      rank = 6
      mult = 604800000L
      i = i + 1
    } else if u0 == 100 {
      // d
      rank = 5
      mult = 86400000L
      i = i + 1
    } else if u0 == 104 {
      // h
      rank = 4
      mult = 3600000L
      i = i + 1
    } else if u0 == 109 {
      if i + 1 < end && input.code_unit_at(i + 1) == 115 {
        // ms
        rank = 1
        mult = 1L
        i = i + 2
      } else {
        // m
        rank = 3
        mult = 60000L
        i = i + 1
      }
    } else if u0 == 115 {
      // s
      rank = 2
      mult = 1000L
      i = i + 1
    } else {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i - start, "unknown duration unit"))
    }
    if rank >= prev_rank {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i - start, "duration units must be in strictly descending order"))
    }
    prev_rank = rank
    if mult > 0L && num > (max_duration_ms - total_ms) / mult {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i - start, "duration overflow"))
    }
    total_ms = total_ms + num * mult
  }
  Ok(total_ms)
}

///| Parse a Prometheus compound duration string (e.g. `1y2w3d4h5m6s7ms`) into milliseconds.
pub fn parse_duration_ms_impl(input : String) -> Result[Int64, PromqlError] {
  parse_duration_ms_range(input, 0, input.length())
}

///| Write milliseconds in Prometheus canonical duration syntax directly into `sb`.
fn write_duration_ms(sb : StringBuilder, ms : Int64) -> Unit {
  if ms == 0L {
    sb.write_string("0s")
    return ()
  }
  // Fast path for the most common dashboard/alerting durations
  if ms == 60000L {
    sb.write_string("1m")
    return ()
  }
  if ms == 300000L {
    sb.write_string("5m")
    return ()
  }
  if ms == 600000L {
    sb.write_string("10m")
    return ()
  }
  if ms == 900000L {
    sb.write_string("15m")
    return ()
  }
  if ms == 3600000L {
    sb.write_string("1h")
    return ()
  }
  let mut rem = ms
  if rem < 0L {
    sb.write_string("-")
    rem = -rem
  }
  // Go `model.Duration.String()` only uses `y` or `w` when the entire duration is an exact multiple.
  if rem % 31536000000L == 0L {
    sb.write_string((rem / 31536000000L).to_string())
    sb.write_string("y")
    return ()
  }
  if rem % 604800000L == 0L {
    sb.write_string((rem / 604800000L).to_string())
    sb.write_string("w")
    return ()
  }
  let d = rem / 86400000L
  rem = rem % 86400000L
  let h = rem / 3600000L
  rem = rem % 3600000L
  let m = rem / 60000L
  rem = rem % 60000L
  let s = rem / 1000L
  rem = rem % 1000L
  if d > 0L {
    sb.write_string(d.to_string())
    sb.write_string("d")
  }
  if h > 0L {
    sb.write_string(h.to_string())
    sb.write_string("h")
  }
  if m > 0L {
    sb.write_string(m.to_string())
    sb.write_string("m")
  }
  if s > 0L {
    sb.write_string(s.to_string())
    sb.write_string("s")
  }
  if rem > 0L {
    sb.write_string(rem.to_string())
    sb.write_string("ms")
  }
}

///| Format milliseconds into Prometheus canonical duration syntax (matches Go `model.Duration.String()`).
pub fn format_duration_ms_impl(ms : Int64) -> String {
  if ms == 0L {
    return "0s"
  }
  let sb = StringBuilder::new()
  write_duration_ms(sb, ms)
  sb.to_string()
}

fn write_utf8_codepoint(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Zero-allocation value token used by the streaming `Lexer` and `Parser`.
val struct LexTok {
  kind : TokenKind
  pos : Int
  text : String
  num_val : Double
  dur_ms : Int64
}

fn lex_tok(kind : TokenKind, pos : Int, text : String) -> LexTok {
  LexTok::{ kind, pos, text, num_val: 0.0, dur_ms: 0L }
}

fn eof_lex_tok(pos : Int) -> LexTok {
  LexTok::{ kind: TokenKind::Eof, pos, text: "", num_val: 0.0, dur_ms: 0L }
}

///| Streaming zero-boxing PromQL lexer with in-place cursor advancement.
struct Lexer {
  input : String
  len : Int
  mut pos : Int
  mut bracket_depth : Int
  max_tokens : Int
  mut count : Int
}

fn Lexer::new(input : String, max_tokens : Int) -> Lexer {
  Lexer::{ input, len: input.length(), pos: 0, bracket_depth: 0, max_tokens, count: 0 }
}

fn Lexer::lex_quoted_string(self : Lexer, start : Int, quote : Int) -> Result[LexTok, PromqlError] {
  let input = self.input
  let n = self.len
  let mut i = start + 1
  // Fast zero-StringBuilder scan: most label values and strings have no escapes.
  while i < n {
    let b = input.code_unit_at(i)
    if b == quote {
      self.pos = i + 1
      return Ok(lex_tok(TokenKind::StringLit, start, input.slice(start + 1, i)))
    }
    if b == 10 {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "unterminated quoted string"))
    }
    if b == 92 {
      break
    }
    i = i + 1
  }
  if i >= n {
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unterminated string literal"))
  }
  // Slow path: string contains at least one backslash escape.
  let sb = StringBuilder::new()
  if i > start + 1 {
    sb.write_string(input.slice(start + 1, i))
  }
  while i < n {
    let b = input.code_unit_at(i)
    if b == quote {
      self.pos = i + 1
      return Ok(lex_tok(TokenKind::StringLit, start, sb.to_string()))
    }
    if b == 10 {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "unterminated quoted string"))
    }
    if b == 92 {
      i = i + 1
      if i >= n {
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "unterminated escape sequence"))
      }
      let esc = input.code_unit_at(i)
      if esc == 110 {
        sb.write_byte(10.to_byte())
        i = i + 1
      } else if esc == 114 {
        sb.write_byte(13.to_byte())
        i = i + 1
      } else if esc == 116 {
        sb.write_byte(9.to_byte())
        i = i + 1
      } else if esc == 97 {
        sb.write_byte(7.to_byte())
        i = i + 1
      } else if esc == 98 {
        sb.write_byte(8.to_byte())
        i = i + 1
      } else if esc == 102 {
        sb.write_byte(12.to_byte())
        i = i + 1
      } else if esc == 118 {
        sb.write_byte(11.to_byte())
        i = i + 1
      } else if esc == 92 {
        sb.write_byte(92.to_byte())
        i = i + 1
      } else if esc == quote {
        sb.write_byte(quote.to_byte())
        i = i + 1
      } else if esc == 120 {
        // \xHH
        if i + 2 >= n {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid \\x escape"))
        }
        let h1 = hex_digit_val(input.code_unit_at(i + 1))
        let h2 = hex_digit_val(input.code_unit_at(i + 2))
        if h1 < 0 || h2 < 0 {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid hex digit in \\x escape"))
        }
        sb.write_byte(((h1 << 4) | h2).to_byte())
        i = i + 3
      } else if esc == 117 {
        // \uHHHH
        if i + 4 >= n {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid \\u escape"))
        }
        let mut cp = 0
        let mut k = 1
        while k <= 4 {
          let hv = hex_digit_val(input.code_unit_at(i + k))
          if hv < 0 {
            return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i + k, "invalid hex digit in \\u escape"))
          }
          cp = (cp << 4) | hv
          k = k + 1
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "surrogate code point in \\u escape"))
        }
        write_utf8_codepoint(sb, cp)
        i = i + 5
      } else if esc == 85 {
        // \UHHHHHHHH
        if i + 8 >= n {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid \\U escape"))
        }
        let mut cp = 0
        let mut k = 1
        while k <= 8 {
          let hv = hex_digit_val(input.code_unit_at(i + k))
          if hv < 0 {
            return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i + k, "invalid hex digit in \\U escape"))
          }
          cp = (cp << 4) | hv
          k = k + 1
        }
        if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid code point in \\U escape"))
        }
        write_utf8_codepoint(sb, cp)
        i = i + 9
      } else if esc >= 48 && esc <= 55 {
        // \OOO octal
        if i + 2 >= n {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid octal escape"))
        }
        let o0 = esc - 48
        let o1 = input.code_unit_at(i + 1) - 48
        let o2 = input.code_unit_at(i + 2) - 48
        if o1 < 0 || o1 > 7 || o2 < 0 || o2 > 7 {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid octal digit in escape"))
        }
        let v = o0 * 64 + o1 * 8 + o2
        if v > 255 {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "octal escape out of range"))
        }
        sb.write_byte(v.to_byte())
        i = i + 3
      } else {
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "unknown escape sequence"))
      }
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unterminated string literal"))
}

fn Lexer::lex_raw_string(self : Lexer, start : Int) -> Result[LexTok, PromqlError] {
  let input = self.input
  let n = self.len
  let mut i = start + 1
  // Fast path: raw string with no '\r'
  while i < n {
    let b = input.code_unit_at(i)
    if b == 96 {
      self.pos = i + 1
      return Ok(lex_tok(TokenKind::StringLit, start, input.slice(start + 1, i)))
    }
    if b == 13 {
      break
    }
    i = i + 1
  }
  if i >= n {
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unterminated raw string literal"))
  }
  let sb = StringBuilder::new()
  if i > start + 1 {
    sb.write_string(input.slice(start + 1, i))
  }
  while i < n {
    let b = input.code_unit_at(i)
    if b == 96 {
      self.pos = i + 1
      return Ok(lex_tok(TokenKind::StringLit, start, sb.to_string()))
    }
    if b != 13 {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unterminated raw string literal"))
}

fn pow2_pos(k_in : Int) -> Double {
  let mut k = k_in
  let mut acc = 1.0
  let mut base = 2.0
  while k > 0 {
    if (k & 1) != 0 {
      acc = acc * base
    }
    k = k >> 1
    if k > 0 {
      base = base * base
    }
  }
  acc
}

fn pow2_neg(k_in : Int) -> Double {
  let mut k = k_in
  let mut acc = 1.0
  let mut base = 0.5
  while k > 0 {
    if (k & 1) != 0 {
      acc = acc * base
    }
    k = k >> 1
    if k > 0 {
      base = base * base
    }
  }
  acc
}

fn ldexp_f64(v_in : Double, e_in : Int) -> Double {
  let mut v = v_in
  let mut e = e_in
  let p512 = pow2_pos(512)
  let n512 = pow2_neg(512)
  while e > 512 {
    v = v * p512
    e = e - 512
  }
  while e < -512 {
    v = v * n512
    e = e + 512
  }
  if e > 0 {
    v = v * pow2_pos(e)
  } else if e < 0 {
    v = v * pow2_neg(-e)
  }
  v
}

struct BigDec {
  mut d : Array[Int]
  mut dp : Int
  mut trunc : Bool
}

fn bigdec_trim(b : BigDec) -> Unit {
  let mut n = b.d.length()
  while n > 0 && b.d[n - 1] == 0 {
    n = n - 1
  }
  if n < b.d.length() {
    let trimmed : Array[Int] = []
    let mut i = 0
    while i < n {
      trimmed.push(b.d[i])
      i = i + 1
    }
    b.d = trimmed
  }
  if b.d.length() == 0 {
    b.dp = 0
  }
}

fn bigdec_lshift(b : BigDec, k : Int) -> Unit {
  if b.d.length() == 0 || k <= 0 {
    return ()
  }
  let mult = 1 << k
  let n = b.d.length()
  let mut carry = 0
  let mut i = n - 1
  while i >= 0 {
    let v = b.d[i] * mult + carry
    b.d[i] = v % 10
    carry = v / 10
    i = i - 1
  }
  if carry > 0 {
    let pref : Array[Int] = []
    let mut c = carry
    while c > 0 {
      pref.push(c % 10)
      c = c / 10
    }
    let out : Array[Int] = []
    let mut p = pref.length() - 1
    while p >= 0 {
      out.push(pref[p])
      p = p - 1
    }
    let mut j = 0
    while j < n {
      if out.length() < 800 {
        out.push(b.d[j])
      } else if b.d[j] != 0 {
        b.trunc = true
      }
      j = j + 1
    }
    b.dp = b.dp + pref.length()
    b.d = out
  }
  bigdec_trim(b)
}

fn bigdec_rshift(b : BigDec, k : Int) -> Unit {
  if b.d.length() == 0 || k <= 0 {
    return ()
  }
  let mask = (1 << k) - 1
  let out : Array[Int] = []
  let mut rem = 0
  let mut i = 0
  let n = b.d.length()
  let mut started = false
  while i < n {
    rem = rem * 10 + b.d[i]
    let q = rem >> k
    rem = rem & mask
    if started || q != 0 {
      started = true
      if out.length() < 800 {
        out.push(q)
      } else if q != 0 {
        b.trunc = true
      }
    } else {
      b.dp = b.dp - 1
    }
    i = i + 1
  }
  while rem != 0 {
    rem = rem * 10
    let q = rem >> k
    rem = rem & mask
    if started || q != 0 {
      started = true
      if out.length() < 800 {
        out.push(q)
      } else {
        if q != 0 || rem != 0 {
          b.trunc = true
        }
        break
      }
    } else {
      b.dp = b.dp - 1
    }
  }
  b.d = out
  bigdec_trim(b)
}

///| Validate underscore placement in a decimal/float literal (Go syntax).
fn validate_dec_underscores(s : String, start : Int, end : Int) -> Bool {
  let mut i = start
  let mut prev_was_digit = false
  let mut prev_was_under = false
  while i < end {
    let b = s.code_unit_at(i)
    if b == 95 {
      if !prev_was_digit || prev_was_under {
        return false
      }
      prev_was_under = true
      prev_was_digit = false
    } else if is_ascii_digit(b) {
      prev_was_digit = true
      prev_was_under = false
    } else {
      if prev_was_under {
        return false
      }
      prev_was_digit = false
      prev_was_under = false
    }
    i = i + 1
  }
  !prev_was_under
}

fn pow10_exact(e : Int) -> Double {
  if e == 0 {
    1.0
  } else if e == 1 {
    10.0
  } else if e == 2 {
    100.0
  } else if e == 3 {
    1000.0
  } else if e == 4 {
    10000.0
  } else if e == 5 {
    100000.0
  } else if e == 6 {
    1000000.0
  } else if e == 7 {
    10000000.0
  } else if e == 8 {
    100000000.0
  } else if e == 9 {
    1000000000.0
  } else if e == 10 {
    10000000000.0
  } else if e == 11 {
    100000000000.0
  } else if e == 12 {
    1000000000000.0
  } else if e == 13 {
    10000000000000.0
  } else if e == 14 {
    100000000000000.0
  } else {
    1000000000000000.0
  }
}

///| Fast zero-allocation parser for simple decimal/float slices `input[start..end]`,
///| falling back to exact `parse_f64_slow` for scientific notation, underscores, or >15 digits.
fn parse_f64_range(input : String, start : Int, end : Int) -> Result[Double, String] {
  if start >= end {
    return Err("empty number")
  }
  let mut i = start
  let mut neg = false
  let b0 = input.code_unit_at(i)
  if b0 == 45 {
    neg = true
    i = i + 1
  } else if b0 == 43 {
    i = i + 1
  }
  let rem_len = end - i
  if rem_len == 0 {
    return Err("no digits in number")
  }
  // Fast zero-alloc decimal path: <= 18 chars, digits and at most one '.', no exponent or underscore.
  if rem_len <= 18 {
    let mut j = i
    let mut mant : Int64 = 0L
    let mut sig_digits = 0
    let mut total_digits = 0
    let mut frac_digits = 0
    let mut seen_dot = false
    let mut fast_ok = true
    while j < end {
      let b = input.code_unit_at(j)
      if b >= 48 && b <= 57 {
        let dv = b - 48
        total_digits = total_digits + 1
        if sig_digits > 0 || dv != 0 {
          sig_digits = sig_digits + 1
          if sig_digits > 15 {
            fast_ok = false
            break
          }
          mant = mant * 10L + dv.to_int64()
        }
        if seen_dot {
          frac_digits = frac_digits + 1
          if frac_digits > 15 {
            fast_ok = false
            break
          }
        }
      } else if b == 46 && !seen_dot {
        seen_dot = true
      } else {
        fast_ok = false
        break
      }
      j = j + 1
    }
    if fast_ok && total_digits > 0 {
      if mant == 0L {
        return Ok(if neg { -0.0 } else { 0.0 })
      }
      let v = if frac_digits == 0 {
        mant.to_double()
      } else {
        mant.to_double() / pow10_exact(frac_digits)
      }
      return Ok(if neg { -v } else { v })
    }
  }
  parse_f64_slow(input.slice(start, end))
}

///| Parse a PromQL decimal/float string into `Double` with exact IEEE-754 round-to-nearest-even
///| (Clinger fast path + exact decimal-to-binary shift slow path, matching Go `strconv.ParseFloat`).
pub fn parse_f64_str(s : String) -> Result[Double, String] {
  parse_f64_range(s, 0, s.length())
}

fn parse_f64_slow(s : String) -> Result[Double, String] {
  let n = s.length()
  if n == 0 {
    return Err("empty number")
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if s.code_unit_at(0) == 43 {
    i = 1
  }
  let rem = s.slice(i, n)
  let low = ascii_lower(rem)
  if low == "inf" {
    return Ok(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 })
  }
  if low == "nan" {
    return Ok(0.0 / 0.0)
  }
  if !validate_dec_underscores(s, i, n) {
    return Err("invalid underscore in number literal")
  }
  // Extract significant decimal digits and decimal point position.
  let digits : Array[Int] = []
  let mut dp = 0
  let mut trunc = false
  let mut total_digits = 0
  let mut seen_nonzero = false
  // Integer part
  while i < n && (is_ascii_digit(s.code_unit_at(i)) || s.code_unit_at(i) == 95) {
    let b = s.code_unit_at(i)
    if b != 95 {
      total_digits = total_digits + 1
      let dv = b - 48
      if dv != 0 {
        seen_nonzero = true
      }
      if seen_nonzero {
        dp = dp + 1
        if digits.length() < 768 {
          digits.push(dv)
        } else if dv != 0 {
          trunc = true
        }
      }
    }
    i = i + 1
  }
  // Fractional part
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    while i < n && (is_ascii_digit(s.code_unit_at(i)) || s.code_unit_at(i) == 95) {
      let b = s.code_unit_at(i)
      if b != 95 {
        total_digits = total_digits + 1
        let dv = b - 48
        if dv != 0 {
          seen_nonzero = true
        }
        if seen_nonzero {
          if digits.length() < 768 {
            digits.push(dv)
          } else if dv != 0 {
            trunc = true
          }
        } else {
          dp = dp - 1
        }
      }
      i = i + 1
    }
  }
  if total_digits == 0 {
    return Err("no digits in number")
  }
  // Exponent part
  let mut exp_val = 0
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i = i + 1
    let mut exp_neg = false
    if i < n && s.code_unit_at(i) == 45 {
      exp_neg = true
      i = i + 1
    } else if i < n && s.code_unit_at(i) == 43 {
      i = i + 1
    }
    let mut exp_digits = 0
    while i < n && (is_ascii_digit(s.code_unit_at(i)) || s.code_unit_at(i) == 95) {
      let b = s.code_unit_at(i)
      if b != 95 {
        if exp_val < 100000 {
          exp_val = exp_val * 10 + (b - 48)
        }
        exp_digits = exp_digits + 1
      }
      i = i + 1
    }
    if exp_digits == 0 {
      return Err("empty exponent")
    }
    if exp_neg {
      exp_val = -exp_val
    }
  }
  if i != n {
    return Err("trailing characters in number")
  }
  if !seen_nonzero {
    return Ok(if neg { -0.0 } else { 0.0 })
  }
  dp = dp + exp_val
  // Strip trailing zeros from digits
  let bdec = BigDec::{ d: digits, dp, trunc }
  bigdec_trim(bdec)
  if bdec.d.length() == 0 {
    return Ok(if neg { -0.0 } else { 0.0 })
  }
  if bdec.dp > 310 {
    return Err("number literal out of range")
  }
  if bdec.dp < -330 {
    return Ok(if neg { -0.0 } else { 0.0 })
  }
  // Clinger fast path: <= 15 digits, |exp10| <= 22 (exact powers of 10 in IEEE-754 double)
  let nd = bdec.d.length()
  let exp10 = bdec.dp - nd
  if nd <= 15 && !bdec.trunc && exp10 >= -22 && exp10 <= 22 {
    let mut mant_i : Int64 = 0L
    let mut k = 0
    while k < nd {
      mant_i = mant_i * 10L + bdec.d[k].to_int64()
      k = k + 1
    }
    let mut p10 = 1.0
    let abs_e = if exp10 < 0 { -exp10 } else { exp10 }
    let mut e = 0
    while e < abs_e {
      p10 = p10 * 10.0
      e = e + 1
    }
    let v = if exp10 >= 0 { mant_i.to_double() * p10 } else { mant_i.to_double() / p10 }
    return Ok(if neg { -v } else { v })
  }
  // Exact decimal-to-binary shift slow path: normalize so 0.5 <= bdec < 1.0
  let mut exp2 = 0
  while bdec.dp > 0 {
    let mut sh = bdec.dp * 3
    if sh > 20 {
      sh = 20
    }
    if sh < 1 {
      sh = 1
    }
    bigdec_rshift(bdec, sh)
    exp2 = exp2 + sh
  }
  while bdec.dp < 0 || (bdec.dp == 0 && bdec.d.length() > 0 && bdec.d[0] < 5) {
    let sh = if bdec.dp < 0 {
      let s0 = (-bdec.dp) * 3
      if s0 > 20 { 20 } else if s0 < 1 { 1 } else { s0 }
    } else {
      1
    }
    bigdec_lshift(bdec, sh)
    exp2 = exp2 - sh
  }
  // Now 0.5 <= bdec < 1.0 and value = bdec * 2^exp2 = (2 * bdec) * 2^(exp2 - 1)
  let mut unbiased = exp2 - 1
  if unbiased < -1075 {
    return Ok(if neg { -0.0 } else { 0.0 })
  }
  let is_subnormal = unbiased < -1022
  let nbits = if !is_subnormal { 53 } else { 53 + (unbiased + 1022) }
  // Shift left by nbits so integer part is the nbits-bit mantissa
  let mut rem_bits = nbits
  while rem_bits > 0 {
    let sh = if rem_bits > 20 { 20 } else { rem_bits }
    bigdec_lshift(bdec, sh)
    rem_bits = rem_bits - sh
  }
  // Extract integer part (mantissa)
  let mut mant : Int64 = 0L
  let mut idx = 0
  while idx < bdec.dp {
    let dv = if idx < bdec.d.length() { bdec.d[idx] } else { 0 }
    mant = mant * 10L + dv.to_int64()
    idx = idx + 1
  }
  // Determine rounding from fractional part (digits at index >= bdec.dp)
  let first_frac = if bdec.dp >= 0 && bdec.dp < bdec.d.length() { bdec.d[bdec.dp] } else { 0 }
  let mut has_tail = bdec.trunc
  if !has_tail && bdec.dp + 1 < bdec.d.length() {
    let mut t = if bdec.dp + 1 > 0 { bdec.dp + 1 } else { 0 }
    while t < bdec.d.length() {
      if bdec.d[t] != 0 {
        has_tail = true
        break
      }
      t = t + 1
    }
  }
  let round_up = if bdec.dp < 0 {
    false
  } else if first_frac > 5 {
    true
  } else if first_frac == 5 {
    has_tail || (mant & 1L) != 0L
  } else {
    false
  }
  if round_up {
    mant = mant + 1L
  }
  let mut final_scale = 0
  if is_subnormal {
    if mant >= 4503599627370496L {
      // Rounded up from subnormal to smallest normal (2^-1022)
      final_scale = -1074
    } else {
      final_scale = -1074
    }
  } else {
    if mant >= 9007199254740992L {
      mant = mant >> 1
      unbiased = unbiased + 1
    }
    if unbiased > 1023 {
      return Err("number literal out of range")
    }
    final_scale = unbiased - 52
  }
  let v = ldexp_f64(mant.to_double(), final_scale)
  Ok(if neg { -v } else { v })
}

fn Lexer::lex_number_or_duration(self : Lexer, start : Int, b : Int) -> Result[LexTok, PromqlError] {
  let input = self.input
  let n = self.len
  // Hex integer: 0x / 0X (Go `strconv.ParseInt(s, 0, 64)` semantics)
  if b == 48 && start + 1 < n && (input.code_unit_at(start + 1) == 120 || input.code_unit_at(start + 1) == 88) {
    let mut i = start + 2
    let mut hval : Int64 = 0L
    let mut hex_digits = 0
    let mut prev_under = false
    while i < n && (is_hex_digit(input.code_unit_at(i)) || input.code_unit_at(i) == 95) {
      let hb = input.code_unit_at(i)
      if hb == 95 {
        if prev_under {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "invalid underscore in hex literal"))
        }
        prev_under = true
      } else {
        let d = hex_digit_val(hb).to_int64()
        if hval > (9223372036854775807L - d) / 16L {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "hex literal out of int64 range"))
        }
        hval = hval * 16L + d
        hex_digits = hex_digits + 1
        prev_under = false
      }
      i = i + 1
    }
    if hex_digits == 0 || prev_under {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "invalid hexadecimal literal"))
    }
    self.pos = i
    return Ok(LexTok::{ kind: TokenKind::Number, pos: start, text: "", num_val: hval.to_double(), dur_ms: 0L })
  }
  // Scan integer digits first to check if this is a duration (e.g. 5m, 1y2w3d)
  if is_ascii_digit(b) {
    let mut j = start
    while j < n && is_ascii_digit(input.code_unit_at(j)) {
      j = j + 1
    }
    if j < n && is_dur_unit_start(input.code_unit_at(j)) {
      // Scan full compound duration token (alphanumeric)
      let mut k = j
      while k < n && (is_ascii_alpha(input.code_unit_at(k)) || is_ascii_digit(input.code_unit_at(k))) {
        k = k + 1
      }
      match parse_duration_ms_range(input, start, k) {
        Ok(ms) => {
          self.pos = k
          return Ok(LexTok::{ kind: TokenKind::Duration, pos: start, text: "", num_val: 0.0, dur_ms: ms })
        }
        Err(e) => return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, e.message))
      }
    }
  }
  // Decimal / floating-point / octal number
  let mut k = start
  let mut has_dot = false
  let mut has_exp = false
  while k < n && (is_ascii_digit(input.code_unit_at(k)) || input.code_unit_at(k) == 95) {
    k = k + 1
  }
  if k < n && input.code_unit_at(k) == 46 {
    has_dot = true
    k = k + 1
    while k < n && (is_ascii_digit(input.code_unit_at(k)) || input.code_unit_at(k) == 95) {
      k = k + 1
    }
  }
  if k < n && (input.code_unit_at(k) == 101 || input.code_unit_at(k) == 69) {
    has_exp = true
    k = k + 1
    if k < n && (input.code_unit_at(k) == 43 || input.code_unit_at(k) == 45) {
      k = k + 1
    }
    let exp_start = k
    while k < n && (is_ascii_digit(input.code_unit_at(k)) || input.code_unit_at(k) == 95) {
      k = k + 1
    }
    if k == exp_start {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "invalid exponent in number literal"))
    }
  }
  // Check Go octal integer (`0700` -> 448) when leading '0', no dot, no exp, all octal digits
  if !has_dot && !has_exp && b == 48 && k - start > 1 && validate_dec_underscores(input, start, k) {
    let mut all_octal = true
    let mut oval : Int64 = 0L
    let mut oct_overflow = false
    let mut oi = start + 1
    while oi < k {
      let ob = input.code_unit_at(oi)
      if ob != 95 {
        if ob < 48 || ob > 55 {
          all_octal = false
          break
        }
        let d = (ob - 48).to_int64()
        if oval > (9223372036854775807L - d) / 8L {
          oct_overflow = true
          break
        }
        oval = oval * 8L + d
      }
      oi = oi + 1
    }
    if all_octal && !oct_overflow {
      self.pos = k
      return Ok(LexTok::{ kind: TokenKind::Number, pos: start, text: "", num_val: oval.to_double(), dur_ms: 0L })
    }
  }
  match parse_f64_range(input, start, k) {
    Ok(v) => {
      self.pos = k
      Ok(LexTok::{ kind: TokenKind::Number, pos: start, text: "", num_val: v, dur_ms: 0L })
    }
    Err(msg) => Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, msg))
  }
}

fn Lexer::lex_ident(self : Lexer, start : Int, b : Int) -> LexTok {
  let input = self.input
  let n = self.len
  let allow_colon = self.bracket_depth == 0
  let mut has_colon = b == 58
  let mut i = start + 1
  while i < n {
    let c = input.code_unit_at(i)
    if is_ident_cont(c) {
      i = i + 1
    } else if allow_colon && c == 58 {
      has_colon = true
      i = i + 1
    } else {
      break
    }
  }
  self.pos = i
  let text = input.slice(start, i)
  if has_colon {
    lex_tok(TokenKind::MetricIdent, start, text)
  } else {
    lex_tok(TokenKind::Ident, start, text)
  }
}

fn Lexer::lex_punct(self : Lexer, start : Int, b : Int) -> Result[LexTok, PromqlError] {
  let input = self.input
  let n = self.len
  if b == 61 {
    if start + 1 < n {
      let nb = input.code_unit_at(start + 1)
      if nb == 61 {
        self.pos = start + 2
        return Ok(lex_tok(TokenKind::Eql, start, "=="))
      }
      if nb == 126 {
        self.pos = start + 2
        return Ok(lex_tok(TokenKind::EqlRegex, start, "=~"))
      }
    }
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::Assign, start, "="))
  }
  if b == 33 {
    if start + 1 < n {
      let nb = input.code_unit_at(start + 1)
      if nb == 61 {
        self.pos = start + 2
        return Ok(lex_tok(TokenKind::Neq, start, "!="))
      }
      if nb == 126 {
        self.pos = start + 2
        return Ok(lex_tok(TokenKind::NeqRegex, start, "!~"))
      }
    }
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unexpected '!'"))
  }
  if b == 44 {
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::Comma, start, ","))
  }
  if b == 40 {
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::LParen, start, "("))
  }
  if b == 41 {
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::RParen, start, ")"))
  }
  if b == 123 {
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::LBrace, start, "{"))
  }
  if b == 125 {
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::RBrace, start, "}"))
  }
  if b == 91 {
    self.bracket_depth = self.bracket_depth + 1
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::LBracket, start, "["))
  }
  if b == 93 {
    if self.bracket_depth > 0 {
      self.bracket_depth = self.bracket_depth - 1
    }
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::RBracket, start, "]"))
  }
  if b == 60 {
    if start + 1 < n && input.code_unit_at(start + 1) == 61 {
      self.pos = start + 2
      return Ok(lex_tok(TokenKind::Lte, start, "<="))
    }
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::Lss, start, "<"))
  }
  if b == 62 {
    if start + 1 < n && input.code_unit_at(start + 1) == 61 {
      self.pos = start + 2
      return Ok(lex_tok(TokenKind::Gte, start, ">="))
    }
    self.pos = start + 1
    return Ok(lex_tok(TokenKind::Gtr, start, ">"))
  }
  if b == 43 {
    self.pos = start + 1
    Ok(lex_tok(TokenKind::Plus, start, "+"))
  } else if b == 45 {
    self.pos = start + 1
    Ok(lex_tok(TokenKind::Minus, start, "-"))
  } else if b == 42 {
    self.pos = start + 1
    Ok(lex_tok(TokenKind::Mul, start, "*"))
  } else if b == 47 {
    self.pos = start + 1
    Ok(lex_tok(TokenKind::Div, start, "/"))
  } else if b == 37 {
    self.pos = start + 1
    Ok(lex_tok(TokenKind::Mod, start, "%"))
  } else if b == 94 {
    self.pos = start + 1
    Ok(lex_tok(TokenKind::Pow, start, "^"))
  } else if b == 58 {
    self.pos = start + 1
    Ok(lex_tok(TokenKind::Colon, start, ":"))
  } else if b == 64 {
    self.pos = start + 1
    Ok(lex_tok(TokenKind::At, start, "@"))
  } else {
    Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unexpected character in PromQL input"))
  }
}

fn Lexer::next_tok(self : Lexer) -> Result[LexTok, PromqlError] {
  let input = self.input
  let n = self.len
  let mut i = self.pos
  while i < n {
    let b = input.code_unit_at(i)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      i = i + 1
      continue
    }
    if b == 35 {
      while i < n && input.code_unit_at(i) != 10 {
        i = i + 1
      }
      continue
    }
    break
  }
  if i >= n {
    self.pos = n
    return Ok(eof_lex_tok(n))
  }
  if self.count >= self.max_tokens {
    return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, i, "max_tokens exceeded"))
  }
  self.count = self.count + 1
  let b = input.code_unit_at(i)
  if is_ident_start(b) {
    return Ok(self.lex_ident(i, b))
  }
  if b == 34 || b == 39 {
    return self.lex_quoted_string(i, b)
  }
  if is_ascii_digit(b) || (b == 46 && i + 1 < n && is_ascii_digit(input.code_unit_at(i + 1))) {
    return self.lex_number_or_duration(i, b)
  }
  if b == 96 {
    return self.lex_raw_string(i)
  }
  if b == 58 {
    if self.bracket_depth == 0 && i + 1 < n && is_metric_cont(input.code_unit_at(i + 1)) {
      return Ok(self.lex_ident(i, b))
    }
    self.pos = i + 1
    return Ok(lex_tok(TokenKind::Colon, i, ":"))
  }
  self.lex_punct(i, b)
}

///| Tokenize a PromQL input string into tokens, enforcing `max_tokens`.
pub fn tokenize(input : String, max_tokens : Int) -> Result[Array[Token], PromqlError] {
  let tokens : Array[Token] = []
  let lex = Lexer::new(input, max_tokens)
  while true {
    match lex.next_tok() {
      Err(e) => return Err(e)
      Ok(lt) => {
        let text = match lt.kind {
          TokenKind::Number => input.slice(lt.pos, lex.pos)
          TokenKind::Duration => input.slice(lt.pos, lex.pos)
          _ => lt.text
        }
        tokens.push(Token::{ kind: lt.kind, pos: lt.pos, text, num_val: lt.num_val, dur_ms: lt.dur_ms })
        match lt.kind {
          TokenKind::Eof => break
          _ => ()
        }
      }
    }
  }
  Ok(tokens)
}
