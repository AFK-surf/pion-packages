///| PromQL lexer and Prometheus duration parser/formatter.

///| Token kind produced by the PromQL lexer.
pub enum TokenKind {
  Eof
  Number
  Duration
  StringLit
  Ident
  MetricIdent
  // Arithmetic & power
  Plus
  Minus
  Mul
  Div
  Mod
  Pow
  // Comparison & matchers
  Eql
  Neq
  Lte
  Lss
  Gte
  Gtr
  Assign
  EqlRegex
  NeqRegex
  // Punctuation
  LParen
  RParen
  LBrace
  RBrace
  LBracket
  RBracket
  Comma
  Colon
  At
}

///| A single lexed token.
pub struct Token {
  pub kind : TokenKind
  pub pos : Int
  pub text : String
  pub num_val : Double
  pub dur_ms : Int64
}

fn tok(kind : TokenKind, pos : Int, text : String) -> Token {
  Token::{ kind, pos, text, num_val: 0.0, dur_ms: 0L }
}

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn hex_digit_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn is_ident_start(b : Int) -> Bool {
  is_ascii_alpha(b) || b == 95
}

fn is_ident_cont(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b) || b == 95
}

fn is_metric_start(b : Int) -> Bool {
  is_ident_start(b) || b == 58
}

fn is_metric_cont(b : Int) -> Bool {
  is_ident_cont(b) || b == 58
}

fn is_dur_unit_start(b : Int) -> Bool {
  b == 109 || b == 115 || b == 104 || b == 100 || b == 119 || b == 121
}

///| Lowercase an ASCII string for case-insensitive PromQL keyword matching.
pub fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut needs_change = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      needs_change = true
      break
    }
    i = i + 1
  }
  if !needs_change {
    return s
  }
  let sb = StringBuilder::new()
  let mut j = 0
  while j < n {
    let b = s.code_unit_at(j)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    j = j + 1
  }
  sb.to_string()
}

///| Check whether `s` is a valid legacy PromQL label name (`[a-zA-Z_][a-zA-Z0-9_]*`).
pub fn is_valid_label_name(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  if !is_ident_start(s.code_unit_at(0)) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_ident_cont(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Check whether `s` is a valid legacy PromQL metric name (`[a-zA-Z_:][a-zA-Z0-9_:]*`).
pub fn is_valid_metric_name(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  if !is_metric_start(s.code_unit_at(0)) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_metric_cont(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Parse a Prometheus compound duration string (e.g. `1y2w3d4h5m6s7ms`) into milliseconds.
pub fn parse_duration_ms_impl(input : String) -> Result[Int64, PromqlError] {
  let n = input.length()
  if n == 0 {
    return Err(PromqlError::new(PromqlErrorKind::SyntaxError, 0, "empty duration string"))
  }
  let mut i = 0
  let mut total_ms : Int64 = 0L
  // Unit rank: y=7, w=6, d=5, h=4, m=3, s=2, ms=1. Must be strictly descending.
  let mut prev_rank = 8
  while i < n {
    if !is_ascii_digit(input.code_unit_at(i)) {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "expected digit in duration"))
    }
    let mut num : Int64 = 0L
    while i < n && is_ascii_digit(input.code_unit_at(i)) {
      let d = (input.code_unit_at(i) - 48).to_int64()
      if num > (9223372036854775807L - d) / 10L {
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "duration overflow"))
      }
      num = num * 10L + d
      i = i + 1
    }
    if i >= n {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "missing unit in duration"))
    }
    let u0 = input.code_unit_at(i)
    let mut rank = 0
    let mut mult : Int64 = 0L
    if u0 == 121 {
      // y
      rank = 7
      mult = 31536000000L
      i = i + 1
    } else if u0 == 119 {
      // w
      rank = 6
      mult = 604800000L
      i = i + 1
    } else if u0 == 100 {
      // d
      rank = 5
      mult = 86400000L
      i = i + 1
    } else if u0 == 104 {
      // h
      rank = 4
      mult = 3600000L
      i = i + 1
    } else if u0 == 109 {
      if i + 1 < n && input.code_unit_at(i + 1) == 115 {
        // ms
        rank = 1
        mult = 1L
        i = i + 2
      } else {
        // m
        rank = 3
        mult = 60000L
        i = i + 1
      }
    } else if u0 == 115 {
      // s
      rank = 2
      mult = 1000L
      i = i + 1
    } else {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "unknown duration unit"))
    }
    if rank >= prev_rank {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "duration units must be in strictly descending order"))
    }
    prev_rank = rank
    if mult > 0L && num > (9223372036854775807L - total_ms) / mult {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "duration overflow"))
    }
    total_ms = total_ms + num * mult
  }
  Ok(total_ms)
}

///| Format milliseconds into Prometheus canonical duration syntax.
pub fn format_duration_ms_impl(ms : Int64) -> String {
  if ms == 0L {
    return "0s"
  }
  let sb = StringBuilder::new()
  let mut rem = ms
  if rem < 0L {
    sb.write_string("-")
    rem = -rem
  }
  let y = rem / 31536000000L
  rem = rem % 31536000000L
  let w = rem / 604800000L
  rem = rem % 604800000L
  let d = rem / 86400000L
  rem = rem % 86400000L
  let h = rem / 3600000L
  rem = rem % 3600000L
  let m = rem / 60000L
  rem = rem % 60000L
  let s = rem / 1000L
  rem = rem % 1000L
  if y > 0L {
    sb.write_string(y.to_string())
    sb.write_string("y")
  }
  if w > 0L {
    sb.write_string(w.to_string())
    sb.write_string("w")
  }
  if d > 0L {
    sb.write_string(d.to_string())
    sb.write_string("d")
  }
  if h > 0L {
    sb.write_string(h.to_string())
    sb.write_string("h")
  }
  if m > 0L {
    sb.write_string(m.to_string())
    sb.write_string("m")
  }
  if s > 0L {
    sb.write_string(s.to_string())
    sb.write_string("s")
  }
  if rem > 0L {
    sb.write_string(rem.to_string())
    sb.write_string("ms")
  }
  sb.to_string()
}

fn write_utf8_codepoint(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn lex_quoted_string(input : String, start : Int, quote : Int) -> Result[(String, Int), PromqlError] {
  let n = input.length()
  let sb = StringBuilder::new()
  let mut i = start + 1
  while i < n {
    let b = input.code_unit_at(i)
    if b == quote {
      return Ok((sb.to_string(), i + 1))
    }
    if b == 10 {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "unterminated quoted string"))
    }
    if b == 92 {
      i = i + 1
      if i >= n {
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "unterminated escape sequence"))
      }
      let esc = input.code_unit_at(i)
      if esc == 110 {
        sb.write_byte(10.to_byte())
        i = i + 1
      } else if esc == 114 {
        sb.write_byte(13.to_byte())
        i = i + 1
      } else if esc == 116 {
        sb.write_byte(9.to_byte())
        i = i + 1
      } else if esc == 97 {
        sb.write_byte(7.to_byte())
        i = i + 1
      } else if esc == 98 {
        sb.write_byte(8.to_byte())
        i = i + 1
      } else if esc == 102 {
        sb.write_byte(12.to_byte())
        i = i + 1
      } else if esc == 118 {
        sb.write_byte(11.to_byte())
        i = i + 1
      } else if esc == 92 {
        sb.write_byte(92.to_byte())
        i = i + 1
      } else if esc == quote {
        sb.write_byte(quote.to_byte())
        i = i + 1
      } else if esc == 120 {
        // \xHH
        if i + 2 >= n {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid \\x escape"))
        }
        let h1 = hex_digit_val(input.code_unit_at(i + 1))
        let h2 = hex_digit_val(input.code_unit_at(i + 2))
        if h1 < 0 || h2 < 0 {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid hex digit in \\x escape"))
        }
        sb.write_byte(((h1 << 4) | h2).to_byte())
        i = i + 3
      } else if esc == 117 {
        // \uHHHH
        if i + 4 >= n {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid \\u escape"))
        }
        let mut cp = 0
        let mut k = 1
        while k <= 4 {
          let hv = hex_digit_val(input.code_unit_at(i + k))
          if hv < 0 {
            return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i + k, "invalid hex digit in \\u escape"))
          }
          cp = (cp << 4) | hv
          k = k + 1
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "surrogate code point in \\u escape"))
        }
        write_utf8_codepoint(sb, cp)
        i = i + 5
      } else if esc == 85 {
        // \UHHHHHHHH
        if i + 8 >= n {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid \\U escape"))
        }
        let mut cp = 0
        let mut k = 1
        while k <= 8 {
          let hv = hex_digit_val(input.code_unit_at(i + k))
          if hv < 0 {
            return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i + k, "invalid hex digit in \\U escape"))
          }
          cp = (cp << 4) | hv
          k = k + 1
        }
        if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid code point in \\U escape"))
        }
        write_utf8_codepoint(sb, cp)
        i = i + 9
      } else if esc >= 48 && esc <= 55 {
        // \OOO octal
        if i + 2 >= n {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid octal escape"))
        }
        let o0 = esc - 48
        let o1 = input.code_unit_at(i + 1) - 48
        let o2 = input.code_unit_at(i + 2) - 48
        if o1 < 0 || o1 > 7 || o2 < 0 || o2 > 7 {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "invalid octal digit in escape"))
        }
        let v = o0 * 64 + o1 * 8 + o2
        if v > 255 {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "octal escape out of range"))
        }
        sb.write_byte(v.to_byte())
        i = i + 3
      } else {
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, i, "unknown escape sequence"))
      }
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unterminated string literal"))
}

fn lex_raw_string(input : String, start : Int) -> Result[(String, Int), PromqlError] {
  let n = input.length()
  let sb = StringBuilder::new()
  let mut i = start + 1
  while i < n {
    let b = input.code_unit_at(i)
    if b == 96 {
      return Ok((sb.to_string(), i + 1))
    }
    if b != 13 {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unterminated raw string literal"))
}

///| Parse a PromQL decimal/float string into `Double`.
pub fn parse_f64_str(s : String) -> Result[Double, String] {
  let n = s.length()
  if n == 0 {
    return Err("empty number")
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if s.code_unit_at(0) == 43 {
    i = 1
  }
  let rem = s.slice(i, n)
  let low = ascii_lower(rem)
  if low == "inf" {
    return Ok(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 })
  }
  if low == "nan" {
    return Ok(0.0 / 0.0)
  }
  // Parse mantissa and exponent
  let mut int_part = 0.0
  let mut digits = 0
  while i < n && (is_ascii_digit(s.code_unit_at(i)) || s.code_unit_at(i) == 95) {
    let b = s.code_unit_at(i)
    if b != 95 {
      int_part = int_part * 10.0 + (b - 48).to_double()
      digits = digits + 1
    }
    i = i + 1
  }
  let mut frac_part = 0.0
  let mut frac_scale = 1.0
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    while i < n && (is_ascii_digit(s.code_unit_at(i)) || s.code_unit_at(i) == 95) {
      let b = s.code_unit_at(i)
      if b != 95 {
        frac_part = frac_part * 10.0 + (b - 48).to_double()
        frac_scale = frac_scale * 10.0
        digits = digits + 1
      }
      i = i + 1
    }
  }
  if digits == 0 {
    return Err("no digits in number")
  }
  let mut res_val = int_part + frac_part / frac_scale
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i = i + 1
    let mut exp_neg = false
    if i < n && s.code_unit_at(i) == 45 {
      exp_neg = true
      i = i + 1
    } else if i < n && s.code_unit_at(i) == 43 {
      i = i + 1
    }
    let mut exp_digits = 0
    let mut exp_val = 0
    while i < n && (is_ascii_digit(s.code_unit_at(i)) || s.code_unit_at(i) == 95) {
      let b = s.code_unit_at(i)
      if b != 95 {
        if exp_val < 10000 {
          exp_val = exp_val * 10 + (b - 48)
        }
        exp_digits = exp_digits + 1
      }
      i = i + 1
    }
    if exp_digits == 0 {
      return Err("empty exponent")
    }
    // Scale by 10^exp_val using binary exponentiation
    let mut p = 1.0
    let mut base = 10.0
    let mut e = exp_val
    while e > 0 {
      if (e & 1) != 0 {
        p = p * base
      }
      e = e >> 1
      if e > 0 {
        base = base * base
      }
    }
    if exp_neg {
      res_val = res_val / p
    } else {
      res_val = res_val * p
    }
  }
  if i != n {
    return Err("trailing characters in number")
  }
  Ok(if neg { -res_val } else { res_val })
}

///| Tokenize a PromQL input string into tokens, enforcing `max_tokens`.
pub fn tokenize(input : String, max_tokens : Int) -> Result[Array[Token], PromqlError] {
  let tokens : Array[Token] = []
  let n = input.length()
  let mut i = 0
  let mut bracket_depth = 0
  while i < n {
    let b = input.code_unit_at(i)
    // Skip whitespace
    if b == 32 || b == 9 || b == 10 || b == 13 {
      i = i + 1
      continue
    }
    // Skip `#` line comment
    if b == 35 {
      while i < n && input.code_unit_at(i) != 10 {
        i = i + 1
      }
      continue
    }
    if tokens.length() >= max_tokens {
      return Err(PromqlError::new(PromqlErrorKind::LimitExceeded, i, "max_tokens exceeded"))
    }
    let start = i
    // String literals: " ' `
    if b == 34 || b == 39 {
      match lex_quoted_string(input, i, b) {
        Ok((s, next_i)) => {
          tokens.push(tok(TokenKind::StringLit, start, s))
          i = next_i
        }
        Err(e) => return Err(e)
      }
      continue
    }
    if b == 96 {
      match lex_raw_string(input, i) {
        Ok((s, next_i)) => {
          tokens.push(tok(TokenKind::StringLit, start, s))
          i = next_i
        }
        Err(e) => return Err(e)
      }
      continue
    }
    // Numbers and durations: starts with digit, or `.` followed by digit
    if is_ascii_digit(b) || (b == 46 && i + 1 < n && is_ascii_digit(input.code_unit_at(i + 1))) {
      // Hex integer: 0x / 0X
      if b == 48 && i + 1 < n && (input.code_unit_at(i + 1) == 120 || input.code_unit_at(i + 1) == 88) {
        i = i + 2
        let hex_start = i
        let mut hval = 0.0
        while i < n && (is_hex_digit(input.code_unit_at(i)) || input.code_unit_at(i) == 95) {
          let hb = input.code_unit_at(i)
          if hb != 95 {
            hval = hval * 16.0 + hex_digit_val(hb).to_double()
          }
          i = i + 1
        }
        if i == hex_start {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "invalid hexadecimal literal"))
        }
        let raw = input.slice(start, i)
        tokens.push(Token::{ kind: TokenKind::Number, pos: start, text: raw, num_val: hval, dur_ms: 0L })
        continue
      }
      // Scan integer digits first to check if this is a duration (e.g. 5m, 1y2w3d)
      let mut j = i
      if is_ascii_digit(b) {
        while j < n && is_ascii_digit(input.code_unit_at(j)) {
          j = j + 1
        }
        if j < n && is_dur_unit_start(input.code_unit_at(j)) {
          // Scan full compound duration token (alphanumeric)
          let mut k = j
          while k < n && (is_ascii_alpha(input.code_unit_at(k)) || is_ascii_digit(input.code_unit_at(k))) {
            k = k + 1
          }
          let dur_text = input.slice(start, k)
          match parse_duration_ms_impl(dur_text) {
            Ok(ms) => {
              tokens.push(Token::{ kind: TokenKind::Duration, pos: start, text: dur_text, num_val: 0.0, dur_ms: ms })
              i = k
              continue
            }
            Err(e) => return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, e.message))
          }
        }
      }
      // Decimal / floating-point number
      let mut k = i
      while k < n && (is_ascii_digit(input.code_unit_at(k)) || input.code_unit_at(k) == 95) {
        k = k + 1
      }
      if k < n && input.code_unit_at(k) == 46 {
        k = k + 1
        while k < n && (is_ascii_digit(input.code_unit_at(k)) || input.code_unit_at(k) == 95) {
          k = k + 1
        }
      }
      if k < n && (input.code_unit_at(k) == 101 || input.code_unit_at(k) == 69) {
        k = k + 1
        if k < n && (input.code_unit_at(k) == 43 || input.code_unit_at(k) == 45) {
          k = k + 1
        }
        let exp_start = k
        while k < n && (is_ascii_digit(input.code_unit_at(k)) || input.code_unit_at(k) == 95) {
          k = k + 1
        }
        if k == exp_start {
          return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "invalid exponent in number literal"))
        }
      }
      let raw = input.slice(start, k)
      match parse_f64_str(raw) {
        Ok(v) => {
          tokens.push(Token::{ kind: TokenKind::Number, pos: start, text: raw, num_val: v, dur_ms: 0L })
          i = k
        }
        Err(msg) => return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, msg))
      }
      continue
    }
    // Punctuation inside brackets: `:` is always Colon when inside `[...]`
    if b == 58 && bracket_depth > 0 {
      tokens.push(tok(TokenKind::Colon, start, ":"))
      i = i + 1
      continue
    }
    // Identifiers and metric identifiers (may contain `:` when outside brackets)
    if is_ident_start(b) || (b == 58 && i + 1 < n && is_metric_cont(input.code_unit_at(i + 1))) {
      let mut has_colon = b == 58
      i = i + 1
      while i < n && (is_ident_cont(input.code_unit_at(i)) || (bracket_depth == 0 && input.code_unit_at(i) == 58)) {
        if input.code_unit_at(i) == 58 {
          has_colon = true
        }
        i = i + 1
      }
      let text = input.slice(start, i)
      if has_colon {
        tokens.push(tok(TokenKind::MetricIdent, start, text))
      } else {
        tokens.push(tok(TokenKind::Ident, start, text))
      }
      continue
    }
    // Two-char and single-char operators
    if b == 61 {
      // =, ==, =~
      if i + 1 < n && input.code_unit_at(i + 1) == 61 {
        tokens.push(tok(TokenKind::Eql, start, "=="))
        i = i + 2
      } else if i + 1 < n && input.code_unit_at(i + 1) == 126 {
        tokens.push(tok(TokenKind::EqlRegex, start, "=~"))
        i = i + 2
      } else {
        tokens.push(tok(TokenKind::Assign, start, "="))
        i = i + 1
      }
      continue
    }
    if b == 33 {
      // !=, !~
      if i + 1 < n && input.code_unit_at(i + 1) == 61 {
        tokens.push(tok(TokenKind::Neq, start, "!="))
        i = i + 2
      } else if i + 1 < n && input.code_unit_at(i + 1) == 126 {
        tokens.push(tok(TokenKind::NeqRegex, start, "!~"))
        i = i + 2
      } else {
        return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unexpected '!'"))
      }
      continue
    }
    if b == 60 {
      // <=, <
      if i + 1 < n && input.code_unit_at(i + 1) == 61 {
        tokens.push(tok(TokenKind::Lte, start, "<="))
        i = i + 2
      } else {
        tokens.push(tok(TokenKind::Lss, start, "<"))
        i = i + 1
      }
      continue
    }
    if b == 62 {
      // >=, >
      if i + 1 < n && input.code_unit_at(i + 1) == 61 {
        tokens.push(tok(TokenKind::Gte, start, ">="))
        i = i + 2
      } else {
        tokens.push(tok(TokenKind::Gtr, start, ">"))
        i = i + 1
      }
      continue
    }
    if b == 43 {
      tokens.push(tok(TokenKind::Plus, start, "+"))
      i = i + 1
    } else if b == 45 {
      tokens.push(tok(TokenKind::Minus, start, "-"))
      i = i + 1
    } else if b == 42 {
      tokens.push(tok(TokenKind::Mul, start, "*"))
      i = i + 1
    } else if b == 47 {
      tokens.push(tok(TokenKind::Div, start, "/"))
      i = i + 1
    } else if b == 37 {
      tokens.push(tok(TokenKind::Mod, start, "%"))
      i = i + 1
    } else if b == 94 {
      tokens.push(tok(TokenKind::Pow, start, "^"))
      i = i + 1
    } else if b == 40 {
      tokens.push(tok(TokenKind::LParen, start, "("))
      i = i + 1
    } else if b == 41 {
      tokens.push(tok(TokenKind::RParen, start, ")"))
      i = i + 1
    } else if b == 123 {
      tokens.push(tok(TokenKind::LBrace, start, "{"))
      i = i + 1
    } else if b == 125 {
      tokens.push(tok(TokenKind::RBrace, start, "}"))
      i = i + 1
    } else if b == 91 {
      bracket_depth = bracket_depth + 1
      tokens.push(tok(TokenKind::LBracket, start, "["))
      i = i + 1
    } else if b == 93 {
      if bracket_depth > 0 {
        bracket_depth = bracket_depth - 1
      }
      tokens.push(tok(TokenKind::RBracket, start, "]"))
      i = i + 1
    } else if b == 44 {
      tokens.push(tok(TokenKind::Comma, start, ","))
      i = i + 1
    } else if b == 58 {
      tokens.push(tok(TokenKind::Colon, start, ":"))
      i = i + 1
    } else if b == 64 {
      tokens.push(tok(TokenKind::At, start, "@"))
      i = i + 1
    } else {
      return Err(PromqlError::new(PromqlErrorKind::SyntaxError, start, "unexpected character in PromQL input"))
    }
  }
  tokens.push(tok(TokenKind::Eof, n, ""))
  Ok(tokens)
}
