///| Wasm32 + Native smoke entry for `packages/promql`.

import "promql"

///|
pub fn smoke() -> Int {
  // 1. Complex Grafana / alerting PromQL parse + canonical format + round-trip
  let q1 = "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket{job=~\"api|web\",code!~\"5..\"}[5m])))"
  let e1 = match promql::parse_expr(q1) {
    Ok(e) => e
    Err(_) => return -1
  }
  let s1 = promql::format_expr(e1)
  let e1_rt = match promql::parse_expr(s1) {
    Ok(e) => e
    Err(_) => return -2
  }
  if promql::format_expr(e1_rt) != s1 {
    return -3
  }
  let names = promql::extract_metric_names(e1)
  if names.length() != 1 || names[0] != "http_request_duration_seconds_bucket" {
    return -4
  }

  // 2. Compound duration + UTF-8 quoted metric + @ / offset
  match promql::parse_duration_ms("1y2w3d4h5m6s7ms") {
    Ok(ms) => {
      if promql::format_duration_ms(ms) != "1y2w3d4h5m6s7ms" {
        return -5
      }
    }
    Err(_) => return -6
  }
  match promql::parse_expr("{\"http.requests\", env=\"prod\"}[5m] @ start() offset -1m") {
    Ok(_) => ()
    Err(_) => return -7
  }

  // 3. In-memory SeriesStore eval_instant + eval_range
  let store = promql::SeriesStore::new()
  store.add_metric(
    "http_requests_total",
    [("job", "api")],
    [(0L, 0.0), (60000L, 60.0), (120000L, 120.0), (180000L, 180.0), (240000L, 240.0), (300000L, 300.0)],
  )
  store.add_metric("req_bucket", [("job", "api"), ("le", "0.5")], [(300000L, 50.0)])
  store.add_metric("req_bucket", [("job", "api"), ("le", "1.0")], [(300000L, 90.0)])
  store.add_metric("req_bucket", [("job", "api"), ("le", "+Inf")], [(300000L, 100.0)])

  let e_rate = match promql::parse_expr("sum by (job) (rate(http_requests_total[5m]))") {
    Ok(e) => e
    Err(_) => return -8
  }
  match promql::eval_instant(e_rate, store, 300000L) {
    Ok(promql::EvalValue::Vector(vs)) => {
      if vs.length() != 1 || vs[0].value < 0.99 || vs[0].value > 1.01 {
        return -9
      }
    }
    _ => return -10
  }
  let e_hq = match promql::parse_expr("histogram_quantile(0.7, req_bucket)") {
    Ok(e) => e
    Err(_) => return -11
  }
  match promql::eval_instant(e_hq, store, 300000L) {
    Ok(promql::EvalValue::Vector(vs)) => {
      if vs.length() != 1 || vs[0].value < 0.74 || vs[0].value > 0.76 {
        return -12
      }
    }
    _ => return -13
  }

  // 4. Depth bomb guard (0 trap on Wasm32)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 150 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 150 {
    sb.write_string(")")
    i = i + 1
  }
  let tight = promql::PromqlLimits::new(32, 65536, 65536, 1000, 10000)
  match promql::parse_expr_with_limits(sb.to_string(), tight) {
    Ok(_) => return -14
    Err(e) => {
      if !e.is_kind(promql::PromqlErrorKind::LimitExceeded) {
        return -15
      }
    }
  }
  4
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "promql_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "promql_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
