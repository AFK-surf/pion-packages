///| Head-to-head benchmark driver for `packages/hcl` vs Go `github.com/hashicorp/hcl/v2`.

import "hcl"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn fnv1a_str(seed : Int64, s : String) -> Int64 {
  let mut h = seed
  let n = s.length()
  let mut i = 0
  while i < n {
    h = ((h ^ s.code_unit_at(i).to_int64()) * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  h
}

fn build_large_tf_config(num_resources : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 10 {
    sb.write_string("variable \"region_")
    sb.write_string(i.to_string())
    sb.write_string("\" {\n  default = \"us-west-")
    sb.write_string(((i % 2) + 1).to_string())
    sb.write_string("\"\n}\n\n")
    i = i + 1
  }
  sb.write_string("locals {\n  env_tag = \"prod-${var.region_0}\"\n  ports   = [for p in [80, 443, 8080] : p + 1000 if p > 80]\n}\n\n")
  i = 0
  while i < num_resources {
    sb.write_string("resource \"aws_instance\" \"node_")
    sb.write_string(i.to_string())
    sb.write_string("\" {\n")
    sb.write_string("  ami           = \"ami-0c55b159cbfafe1f0\"\n")
    sb.write_string("  instance_type = \"t3.medium\"\n")
    sb.write_string("  subnet_id     = \"subnet-")
    sb.write_string((i % 16).to_string())
    sb.write_string("\"\n")
    sb.write_string("  tags = {\n    Name = \"web-${local.env_tag}-")
    sb.write_string(i.to_string())
    sb.write_string("\"\n    Tier = \"app\"\n  }\n")
    sb.write_string("  user_data = <<-EOF\n")
    sb.write_string("    #!/bin/sh\n")
    sb.write_string("    echo \"node=")
    sb.write_string(i.to_string())
    sb.write_string(" env=${local.env_tag}\"\n")
    sb.write_string("  EOF\n")
    sb.write_string("  root_block_device {\n    volume_size = ")
    sb.write_string((20 + (i % 5) * 10).to_string())
    sb.write_string("\n    encrypted   = true\n  }\n")
    sb.write_string("}\n\n")
    i = i + 1
  }
  i = 0
  while i < 100 {
    sb.write_string("module \"svc_")
    sb.write_string(i.to_string())
    sb.write_string("\" {\n  source = \"./modules/service\"\n  count  = ")
    sb.write_string(((i % 4) + 1).to_string())
    sb.write_string("\n}\n\n")
    i = i + 1
  }
  sb.to_string()
}

fn count_body(body : hcl::Body) -> (Int, Int, Int, Int64) {
  let mut blocks = body.blocks.length()
  let mut labels = 0
  let mut attrs = body.attributes.length()
  let mut h : Int64 = 2166136261L
  let mut i = 0
  while i < body.attributes.length() {
    h = fnv1a_str(h, body.attributes[i].name)
    i = i + 1
  }
  i = 0
  while i < body.blocks.length() {
    let b = body.blocks[i]
    h = fnv1a_str(h, b.block_type)
    labels = labels + b.labels.length()
    let mut j = 0
    while j < b.labels.length() {
      h = fnv1a_str(h, b.labels[j])
      j = j + 1
    }
    let (sb, sl, sa, sh) = count_body(b.body)
    blocks = blocks + sb
    labels = labels + sl
    attrs = attrs + sa
    h = ((h ^ sh) * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  (blocks, labels, attrs, h)
}

fn run_w1(world : World, iters : Int) -> Int {
  let src = build_large_tf_config(1000)
  let mut total_blocks = 0
  let mut total_labels = 0
  let mut total_attrs = 0
  let mut checksum : Int64 = 2166136261L
  let mut i = 0
  while i < iters {
    match hcl::parse(src) {
      Ok(f) => {
        let (bl, lb, at, h) = count_body(f.body)
        total_blocks = total_blocks + bl
        total_labels = total_labels + lb
        total_attrs = total_attrs + at
        checksum = ((checksum ^ h) * 16777619L) & 0xFFFFFFFFL
      }
      Err(e) => {
        io_println(world, "w1 parse error: " + e.to_string())
        return 2
      }
    }
    i = i + 1
  }
  io_println(
    world,
    "w1 iters=" + iters.to_string() + " bytes=" + src.length().to_string() + " blocks=" + total_blocks.to_string() + " labels=" + total_labels.to_string() + " attrs=" + total_attrs.to_string() + " checksum=" + checksum.to_string(),
  )
  0
}

fn run_w2(world : World, iters : Int) -> Int {
  let cfg =
  "service   = \"api-${lower(env)}-${replicas}\"\n" +
  "endpoint  = \"https://${host}:${port}/v1\"\n" +
  "is_prod   = env == \"PROD\" && replicas >= 3 ? true : false\n" +
  "active    = [for s in servers : upper(s.id) if s.active && s.weight > 10]\n" +
  "by_region = {for s in servers : s.region => s.id...}\n" +
  "all_ids   = servers[*].id\n" +
  "joined    = join(\",\", concat([\"seed\"], servers[*].id))\n" +
  "merged    = merge(base_tags, { env = lower(env), total = length(servers) })\n" +
  "summary   = \"%{for i, s in servers ~}${i}:${s.id}%{if i < 3}|%{endif}%{~ endfor}\"\n" +
  "bounds    = [min(10, replicas, 2), max(10, replicas, 2)]\n"

  let ctx = hcl::EvalContext::from_vars([
    ("env", hcl::HclValue::str("PROD")),
    ("replicas", hcl::HclValue::int(4)),
    ("host", hcl::HclValue::str("gateway.internal")),
    ("port", hcl::HclValue::int(8443)),
    (
      "base_tags",
      hcl::HclValue::object([
        ("team", hcl::HclValue::str("infra")),
        ("tier", hcl::HclValue::str("core")),
      ]),
    ),
    (
      "servers",
      hcl::HclValue::tuple([
        hcl::HclValue::object([
          ("id", hcl::HclValue::str("srv-a")),
          ("region", hcl::HclValue::str("us-east")),
          ("weight", hcl::HclValue::int(25)),
          ("active", hcl::HclValue::bool(true)),
        ]),
        hcl::HclValue::object([
          ("id", hcl::HclValue::str("srv-b")),
          ("region", hcl::HclValue::str("us-west")),
          ("weight", hcl::HclValue::int(5)),
          ("active", hcl::HclValue::bool(true)),
        ]),
        hcl::HclValue::object([
          ("id", hcl::HclValue::str("srv-c")),
          ("region", hcl::HclValue::str("us-east")),
          ("weight", hcl::HclValue::int(40)),
          ("active", hcl::HclValue::bool(false)),
        ]),
        hcl::HclValue::object([
          ("id", hcl::HclValue::str("srv-d")),
          ("region", hcl::HclValue::str("eu-west")),
          ("weight", hcl::HclValue::int(50)),
          ("active", hcl::HclValue::bool(true)),
        ]),
      ]),
    ),
  ])

  let mut checksum : Int64 = 2166136261L
  let mut last_json = ""
  let mut i = 0
  while i < iters {
    match hcl::eval_body_to_json(cfg, ctx) {
      Ok(js) => {
        checksum = fnv1a_str(checksum, js)
        last_json = js
      }
      Err(e) => {
        io_println(world, "w2 eval error: " + e.to_string())
        return 2
      }
    }
    i = i + 1
  }
  io_println(world, "w2 iters=" + iters.to_string() + " checksum=" + checksum.to_string())
  io_println(world, last_json)
  0
}

fn run_w3(world : World, iters : Int) -> Int {
  let raw =
  "# Cluster configuration\n" +
  "resource   \"aws_s3_bucket\"   \"logs\"{\n" +
  "bucket=\"my-prod-logs\" # primary bucket\n" +
  "acl =\"private\" // access control\n" +
  "force_destroy=true\n" +
  "\n" +
  "versioning {\n" +
  "enabled=true\n" +
  "}\n" +
  "}\n" +
  "\n" +
  "resource \"aws_instance\" \"web\" {\n" +
  "ami=\"ami-0c55b159\"\n" +
  "instance_type =\"t3.large\"\n" +
  "count=1+2*3\n" +
  "tags = {\n" +
  "Name=\"web-prod\"\n" +
  "Environment=\"production\"\n" +
  "Owner=\"platform-team\"\n" +
  "}\n" +
  "vpc_security_group_ids = [\n" +
  "\"sg-0123456789abcdef0\",\n" +
  "\"sg-fedcba9876543210\",\n" +
  "]\n" +
  "user_data=<<EOF\n" +
  "  #!/bin/sh\n" +
  "  echo hello\n" +
  "EOF\n" +
  "\n" +
  "lifecycle {\n" +
  "create_before_destroy=true\n" +
  "}\n" +
  "}\n" +
  "\n" +
  "locals {\n" +
  "env = \"prod\"\n" +
  "ports = [for p in [80,443,8080]: p+1000 if p!=80]\n" +
  "}\n"

  let mut checksum : Int64 = 2166136261L
  let mut last_fmt = ""
  let mut i = 0
  while i < iters {
    match hcl::format_hcl(raw) {
      Ok(s) => {
        checksum = fnv1a_str(checksum, s)
        last_fmt = s
      }
      Err(e) => {
        io_println(world, "w3 format error: " + e.to_string())
        return 2
      }
    }
    i = i + 1
  }
  io_println(world, "w3 iters=" + iters.to_string() + " bytes=" + last_fmt.length().to_string() + " checksum=" + checksum.to_string())
  io_println(world, last_fmt)
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_hcl <w1|w2|w3> <iters>")
    return 1
  }
  let mode = args[1]
  let iters = parse_int_arg(args[2], 10)
  if mode == "w1" {
    run_w1(world, iters)
  } else if mode == "w2" {
    run_w2(world, iters)
  } else if mode == "w3" {
    run_w3(world, iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
