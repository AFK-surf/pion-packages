///| Mode-stack HCL2 lexer supporting native syntax, comments (`#`, `//`, `/* */`),
///| quoted templates with escapes, heredocs (`<<EOF`, `<<-EOF`), `${...}` interpolations,
///| `%{...}` control directives, and `~` whitespace strip markers.

///| Token kinds emitted by the HCL2 lexer.
pub enum TokKind {
  Eof
  Newline
  Comment(String)
  Ident(String)
  NumberLit(String)
  OQuote
  CQuote
  OHeredoc(String, Bool)
  CHeredoc(String)
  QuotedLit(String)
  StringLit(String)
  TemplateInterp(Bool)
  TemplateControl(Bool)
  TemplateSeqEnd(Bool)
  LBrace
  RBrace
  LBracket
  RBracket
  LParen
  RParen
  Equal
  EqEq
  BangEq
  Lt
  LtEq
  Gt
  GtEq
  FatArrow
  Plus
  Minus
  Star
  Slash
  Percent
  AndAnd
  OrOr
  Bang
  Question
  Colon
  Dot
  Ellipsis
  Comma
}

///| Lexer token with kind, raw source slice, and exact `Span`.
pub struct Token {
  pub kind : TokKind
  pub raw : String
  pub span : Span
}

// Compact internal token tags for zero-allocation streaming parsing.
let TOK_EOF : Int = 0
let TOK_NEWLINE : Int = 1
let TOK_COMMENT : Int = 2
let TOK_IDENT : Int = 3
let TOK_NUMBER : Int = 4
let TOK_OQUOTE : Int = 5
let TOK_CQUOTE : Int = 6
let TOK_OHEREDOC : Int = 7
let TOK_CHEREDOC : Int = 8
let TOK_QUOTED_LIT : Int = 9
let TOK_STRING_LIT : Int = 10
let TOK_TEMPLATE_INTERP : Int = 11
let TOK_TEMPLATE_CONTROL : Int = 12
let TOK_TEMPLATE_SEQ_END : Int = 13
let TOK_LBRACE : Int = 14
let TOK_RBRACE : Int = 15
let TOK_LBRACKET : Int = 16
let TOK_RBRACKET : Int = 17
let TOK_LPAREN : Int = 18
let TOK_RPAREN : Int = 19
let TOK_EQUAL : Int = 20
// Binary operators are contiguous 21..33 for O(1) range checks in Pratt parsing.
let TOK_OROR : Int = 21
let TOK_ANDAND : Int = 22
let TOK_EQEQ : Int = 23
let TOK_BANGEQ : Int = 24
let TOK_LT : Int = 25
let TOK_LTEQ : Int = 26
let TOK_GT : Int = 27
let TOK_GTEQ : Int = 28
let TOK_PLUS : Int = 29
let TOK_MINUS : Int = 30
let TOK_STAR : Int = 31
let TOK_SLASH : Int = 32
let TOK_PERCENT : Int = 33
let TOK_FATARROW : Int = 34
let TOK_BANG : Int = 35
let TOK_QUESTION : Int = 36
let TOK_COLON : Int = 37
let TOK_DOT : Int = 38
let TOK_ELLIPSIS : Int = 39
let TOK_COMMA : Int = 40
let TOK_ERR : Int = 41
let TOK_PLAIN_STRING : Int = 42

let MODE_NORMAL : Int = 0
let MODE_QUOTED : Int = 1
let MODE_HEREDOC : Int = 2
let MODE_TEMPLATE_EXPR : Int = 3

let HCL_CH_IDENT_START : Int = 1
let HCL_CH_IDENT_CONT : Int = 2
let HCL_CH_DIGIT : Int = 4
let HCL_CH_QUOTED_SPEC : Int = 8
let HCL_CH_HEREDOC_SPEC : Int = 16

fn build_hcl_char_lut() -> FixedArray[Int] {
  let lut = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    let mut flags = 0
    if (i >= 65 && i <= 90) || (i >= 97 && i <= 122) || i == 95 || i >= 128 {
      flags = flags | HCL_CH_IDENT_START | HCL_CH_IDENT_CONT
    }
    if i >= 48 && i <= 57 {
      flags = flags | HCL_CH_DIGIT | HCL_CH_IDENT_CONT
    }
    if i == 45 {
      flags = flags | HCL_CH_IDENT_CONT
    }
    if i == 34 || i == 92 || i == 36 || i == 37 || i == 10 || i == 13 {
      flags = flags | HCL_CH_QUOTED_SPEC
    }
    if i == 10 || i == 36 || i == 37 {
      flags = flags | HCL_CH_HEREDOC_SPEC
    }
    lut[i] = flags
    i = i + 1
  }
  lut
}

let hcl_char_lut : FixedArray[Int] = build_hcl_char_lut()

#verify
pub fn is_hcl_ident_start(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128
}

#verify
pub fn is_hcl_ident_cont(b : Int) -> Bool {
  is_hcl_ident_start(b) || (b >= 48 && b <= 57) || b == 45
}

#verify
pub fn is_hcl_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

#verify
pub fn hcl_hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn write_utf8_cp_sb(sb : StringBuilder, cp : Int) -> Unit {
  if cp <= 0x7F {
    sb.write_byte(cp.to_byte())
  } else if cp <= 0x7FF {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn matches_heredoc_end_at(src : String, len : Int, start_off : Int, marker : String) -> Int {
  let mlen = marker.length()
  if mlen == 0 {
    return -1
  }
  let mut idx = start_off
  while idx < len {
    let c = src.code_unit_at(idx)
    if c == 32 || c == 9 {
      idx = idx + 1
    } else {
      break
    }
  }
  if idx + mlen > len {
    return -1
  }
  let mut j = 0
  while j < mlen {
    if src.code_unit_at(idx + j) != marker.code_unit_at(j) {
      return -1
    }
    j = j + 1
  }
  idx = idx + mlen
  while idx < len {
    let c = src.code_unit_at(idx)
    if c == 32 || c == 9 {
      idx = idx + 1
    } else {
      break
    }
  }
  if idx == len || src.code_unit_at(idx) == 10 || src.code_unit_at(idx) == 13 {
    idx
  } else {
    -1
  }
}

struct StreamLexer {
  src : String
  len : Int
  mut offset : Int
  mut line : Int
  mut col : Int
  mode_kind : FixedArray[Int]
  mode_data : FixedArray[Int]
  mode_marker : FixedArray[String]
  mut mode_sp : Int
  mut cur_mode : Int
  mut cur_data : Int
  mut cur_marker : String
  keep_comments : Bool
  fast_strings : Bool
  max_depth : Int
  mut tok_tag : Int
  mut tok_str : String
  mut tok_flag : Bool
  mut tok_sl : Int
  mut tok_sc : Int
  mut tok_so : Int
  mut tok_el : Int
  mut tok_ec : Int
  mut tok_eo : Int
  mut err : Option[HclError]
}

fn StreamLexer::new_with_opts(
  src : String,
  keep_comments : Bool,
  fast_strings : Bool,
  max_depth : Int,
) -> StreamLexer {
  let len = src.length()
  let mut start_off = 0
  if len >= 3 && src.code_unit_at(0) == 0xEF && src.code_unit_at(1) == 0xBB && src.code_unit_at(2) == 0xBF {
    start_off = 3
  }
  let mk = FixedArray::make(176, MODE_NORMAL)
  let md = FixedArray::make(176, 0)
  let mm = FixedArray::make(176, "")
  StreamLexer::{
    src: src,
    len: len,
    offset: start_off,
    line: 1,
    col: 1,
    mode_kind: mk,
    mode_data: md,
    mode_marker: mm,
    mode_sp: 1,
    cur_mode: MODE_NORMAL,
    cur_data: 0,
    cur_marker: "",
    keep_comments: keep_comments,
    fast_strings: fast_strings,
    max_depth: hcl_effective_max_depth(max_depth),
    tok_tag: TOK_EOF,
    tok_str: "",
    tok_flag: false,
    tok_sl: 1,
    tok_sc: 1,
    tok_so: start_off,
    tok_el: 1,
    tok_ec: 1,
    tok_eo: start_off,
    err: None,
  }
}

fn StreamLexer::new(src : String, keep_comments : Bool, max_depth : Int) -> StreamLexer {
  StreamLexer::new_with_opts(src, keep_comments, false, max_depth)
}

fn StreamLexer::new_fast(src : String, max_depth : Int) -> StreamLexer {
  StreamLexer::new_with_opts(src, false, true, max_depth)
}

fn StreamLexer::new_template(src : String, max_depth : Int) -> StreamLexer {
  let mk = FixedArray::make(176, MODE_NORMAL)
  mk[0] = MODE_HEREDOC
  let md = FixedArray::make(176, 0)
  let mm = FixedArray::make(176, "")
  StreamLexer::{
    src: src,
    len: src.length(),
    offset: 0,
    line: 1,
    col: 1,
    mode_kind: mk,
    mode_data: md,
    mode_marker: mm,
    mode_sp: 1,
    cur_mode: MODE_HEREDOC,
    cur_data: 0,
    cur_marker: "",
    keep_comments: false,
    fast_strings: false,
    max_depth: hcl_effective_max_depth(max_depth),
    tok_tag: TOK_EOF,
    tok_str: "",
    tok_flag: false,
    tok_sl: 1,
    tok_sc: 1,
    tok_so: 0,
    tok_el: 1,
    tok_ec: 1,
    tok_eo: 0,
    err: None,
  }
}

fn StreamLexer::fail(
  self : StreamLexer,
  kind : HclErrorKind,
  msg : String,
  sl : Int,
  sc : Int,
  so : Int,
  el : Int,
  ec : Int,
  eo : Int,
) -> Bool {
  self.tok_tag = TOK_ERR
  self.tok_sl = sl
  self.tok_sc = sc
  self.tok_so = so
  self.tok_el = el
  self.tok_ec = ec
  self.tok_eo = eo
  self.err = Some(HclError::new(kind, msg, Span::new(Pos::new(sl, sc, so), Pos::new(el, ec, eo))))
  false
}

fn StreamLexer::push_mode(
  self : StreamLexer,
  kind : Int,
  data : Int,
  marker : String,
  sl : Int,
  sc : Int,
  so : Int,
  el : Int,
  ec : Int,
  eo : Int,
) -> Bool {
  if self.mode_sp > self.max_depth + 4 {
    return self.fail(
      HclErrorKind::LimitExceeded,
      "maximum template/expression nesting depth exceeded",
      sl,
      sc,
      so,
      el,
      ec,
      eo,
    )
  }
  let sp = self.mode_sp
  self.mode_kind[sp] = kind
  self.mode_data[sp] = data
  self.mode_marker[sp] = marker
  self.mode_sp = sp + 1
  self.cur_mode = kind
  self.cur_data = data
  self.cur_marker = marker
  true
}

fn StreamLexer::pop_mode(self : StreamLexer) -> Unit {
  if self.mode_sp > 1 {
    let top = self.mode_sp - 2
    self.mode_sp = self.mode_sp - 1
    self.cur_mode = self.mode_kind[top]
    self.cur_data = self.mode_data[top]
    self.cur_marker = self.mode_marker[top]
  }
}

fn StreamLexer::set_tok(
  self : StreamLexer,
  tag : Int,
  str_val : String,
  flag : Bool,
  sl : Int,
  sc : Int,
  so : Int,
  el : Int,
  ec : Int,
  eo : Int,
) -> Bool {
  self.tok_tag = tag
  self.tok_str = str_val
  self.tok_flag = flag
  self.tok_sl = sl
  self.tok_sc = sc
  self.tok_so = so
  self.tok_el = el
  self.tok_ec = ec
  self.tok_eo = eo
  true
}

fn StreamLexer::scan_normal(self : StreamLexer, in_template_expr : Bool) -> Bool {
  let src = self.src
  let len = self.len
  let lut = hcl_char_lut
  let mut off = self.offset
  let mut line = self.line
  let mut col = self.col

  while true {
    // Skip horizontal whitespace (space, tab)
    while off < len {
      let c = src.code_unit_at(off)
      if c == 32 || c == 9 {
        off = off + 1
        col = col + 1
      } else {
        break
      }
    }
    if off >= len {
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_EOF, "", false, line, col, off, line, col, off)
    }

    let sl = line
    let sc = col
    let so = off
    let b = src.code_unit_at(off)

    // Fast path: Newline (\n)
    if b == 10 {
      off = off + 1
      line = line + 1
      col = 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_NEWLINE, "", false, sl, sc, so, line, col, off)
    }

    // Fast path: Identifier
    if (lut[b] & HCL_CH_IDENT_START) != 0 {
      off = off + 1
      while off < len {
        let c = src.code_unit_at(off)
        if (lut[c] & HCL_CH_IDENT_CONT) != 0 {
          off = off + 1
        } else {
          break
        }
      }
      col = col + (off - so)
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_IDENT, src.slice(so, off), false, sl, sc, so, line, col, off)
    }

    // Fast path: Quoted string open '"' (single-token fast path for plain unescaped strings)
    if b == 34 {
      if self.fast_strings && self.mode_sp <= self.max_depth + 4 {
        let mut p = off + 1
        let mut plain_ok = false
        while p < len {
          let c = src.code_unit_at(p)
          if (lut[c] & HCL_CH_QUOTED_SPEC) == 0 {
            p = p + 1
            continue
          }
          if c == 34 {
            plain_ok = true
            break
          }
          if c == 36 || c == 37 {
            if p + 1 < len {
              let c1 = src.code_unit_at(p + 1)
              if c1 == 123 || (c1 == c && p + 2 < len && src.code_unit_at(p + 2) == 123) {
                break
              }
            }
            p = p + 1
            continue
          }
          break
        }
        if plain_ok {
          let s = src.slice(so + 1, p)
          off = p + 1
          col = col + (off - so)
          self.offset = off
          self.line = line
          self.col = col
          return self.set_tok(TOK_PLAIN_STRING, s, false, sl, sc, so, line, col, off)
        }
      }
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      if !self.push_mode(MODE_QUOTED, 0, "", sl, sc, so, line, col, off) {
        return false
      }
      return self.set_tok(TOK_OQUOTE, "", false, sl, sc, so, line, col, off)
    }

    // Fast path: '=' / '==' / '=>'
    if b == 61 {
      if off + 1 < len {
        let b1 = src.code_unit_at(off + 1)
        if b1 == 61 {
          off = off + 2
          col = col + 2
          self.offset = off
          self.line = line
          self.col = col
          return self.set_tok(TOK_EQEQ, "", false, sl, sc, so, line, col, off)
        }
        if b1 == 62 {
          off = off + 2
          col = col + 2
          self.offset = off
          self.line = line
          self.col = col
          return self.set_tok(TOK_FATARROW, "", false, sl, sc, so, line, col, off)
        }
      }
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_EQUAL, "", false, sl, sc, so, line, col, off)
    }

    // Fast path: '{' and '}'
    if b == 123 {
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      if in_template_expr {
        let top = self.mode_sp - 1
        let next_bd = self.cur_data + 1
        self.mode_data[top] = next_bd
        self.cur_data = next_bd
      }
      return self.set_tok(TOK_LBRACE, "", false, sl, sc, so, line, col, off)
    }
    if b == 125 {
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      if in_template_expr {
        if self.cur_data == 0 {
          self.pop_mode()
          return self.set_tok(TOK_TEMPLATE_SEQ_END, "", false, sl, sc, so, line, col, off)
        } else {
          let top = self.mode_sp - 1
          let next_bd = self.cur_data - 1
          self.mode_data[top] = next_bd
          self.cur_data = next_bd
        }
      }
      return self.set_tok(TOK_RBRACE, "", false, sl, sc, so, line, col, off)
    }

    // Fast path: Number literal
    if (lut[b] & HCL_CH_DIGIT) != 0 {
      off = off + 1
      while off < len && (lut[src.code_unit_at(off)] & HCL_CH_DIGIT) != 0 {
        off = off + 1
      }
      if off + 1 < len && src.code_unit_at(off) == 46 && (lut[src.code_unit_at(off + 1)] & HCL_CH_DIGIT) != 0 {
        off = off + 2
        while off < len && (lut[src.code_unit_at(off)] & HCL_CH_DIGIT) != 0 {
          off = off + 1
        }
      }
      if off < len {
        let ec = src.code_unit_at(off)
        if ec == 101 || ec == 69 {
          off = off + 1
          if off < len {
            let sgn = src.code_unit_at(off)
            if sgn == 43 || sgn == 45 {
              off = off + 1
            }
          }
          if off >= len || (lut[src.code_unit_at(off)] & HCL_CH_DIGIT) == 0 {
            col = col + (off - so)
            self.offset = off
            self.line = line
            self.col = col
            return self.fail(
              HclErrorKind::SyntaxError,
              "invalid exponent in number literal",
              sl,
              sc,
              so,
              line,
              col,
              off,
            )
          }
          while off < len && (lut[src.code_unit_at(off)] & HCL_CH_DIGIT) != 0 {
            off = off + 1
          }
        }
      }
      col = col + (off - so)
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_NUMBER, src.slice(so, off), false, sl, sc, so, line, col, off)
    }

    // Fast path: common single-char punctuation
    if b == 46 {
      if off + 2 < len && src.code_unit_at(off + 1) == 46 && src.code_unit_at(off + 2) == 46 {
        off = off + 3
        col = col + 3
        self.offset = off
        self.line = line
        self.col = col
        return self.set_tok(TOK_ELLIPSIS, "", false, sl, sc, so, line, col, off)
      }
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_DOT, "", false, sl, sc, so, line, col, off)
    }
    if b == 44 {
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_COMMA, "", false, sl, sc, so, line, col, off)
    }
    if b == 91 {
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_LBRACKET, "", false, sl, sc, so, line, col, off)
    }
    if b == 93 {
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_RBRACKET, "", false, sl, sc, so, line, col, off)
    }
    if b == 40 {
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_LPAREN, "", false, sl, sc, so, line, col, off)
    }
    if b == 41 {
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_RPAREN, "", false, sl, sc, so, line, col, off)
    }
    if b == 58 {
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_COLON, "", false, sl, sc, so, line, col, off)
    }

    // Comments: #, //, /* ... */
    if b == 35 || (b == 47 && off + 1 < len && src.code_unit_at(off + 1) == 47) {
      while off < len {
        let c = src.code_unit_at(off)
        if c == 10 || c == 13 {
          break
        }
        off = off + 1
      }
      col = col + (off - so)
      if self.keep_comments {
        self.offset = off
        self.line = line
        self.col = col
        return self.set_tok(TOK_COMMENT, src.slice(so, off), false, sl, sc, so, line, col, off)
      }
      continue
    }
    if b == 47 && off + 1 < len && src.code_unit_at(off + 1) == 42 {
      off = off + 2
      col = col + 2
      let mut closed = false
      while off < len {
        let c = src.code_unit_at(off)
        if c == 42 && off + 1 < len && src.code_unit_at(off + 1) == 47 {
          off = off + 2
          col = col + 2
          closed = true
          break
        }
        off = off + 1
        if c == 10 {
          line = line + 1
          col = 1
        } else {
          col = col + 1
        }
      }
      if !closed {
        self.offset = off
        self.line = line
        self.col = col
        return self.fail(HclErrorKind::SyntaxError, "unterminated block comment", sl, sc, so, line, col, off)
      }
      if self.keep_comments {
        self.offset = off
        self.line = line
        self.col = col
        return self.set_tok(TOK_COMMENT, src.slice(so, off), false, sl, sc, so, line, col, off)
      }
      continue
    }

    // CRLF newline
    if b == 13 && off + 1 < len && src.code_unit_at(off + 1) == 10 {
      off = off + 2
      line = line + 1
      col = 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_NEWLINE, "", false, sl, sc, so, line, col, off)
    }

    // Template sequence end with strip marker: ~}
    if in_template_expr && self.cur_data == 0 && b == 126 && off + 1 < len && src.code_unit_at(off + 1) == 125 {
      off = off + 2
      col = col + 2
      self.offset = off
      self.line = line
      self.col = col
      self.pop_mode()
      return self.set_tok(TOK_TEMPLATE_SEQ_END, "", true, sl, sc, so, line, col, off)
    }

    // '<', '<=', '<<EOF', '<<-EOF'
    if b == 60 {
      if off + 1 < len {
        let b1 = src.code_unit_at(off + 1)
        if b1 == 60 {
          off = off + 2
          col = col + 2
          let mut indented = false
          if off < len && src.code_unit_at(off) == 45 {
            indented = true
            off = off + 1
            col = col + 1
          }
          let m_start = off
          if off >= len || (lut[src.code_unit_at(off)] & HCL_CH_IDENT_START) == 0 {
            self.offset = off
            self.line = line
            self.col = col
            return self.fail(
              HclErrorKind::SyntaxError,
              "expected heredoc marker identifier after <<",
              sl,
              sc,
              so,
              line,
              col,
              off,
            )
          }
          off = off + 1
          while off < len && (lut[src.code_unit_at(off)] & HCL_CH_IDENT_CONT) != 0 {
            off = off + 1
          }
          let marker = src.slice(m_start, off)
          col = col + (off - m_start)
          while off < len {
            let c = src.code_unit_at(off)
            if c == 32 || c == 9 {
              off = off + 1
              col = col + 1
            } else {
              break
            }
          }
          if off < len && src.code_unit_at(off) == 13 {
            off = off + 1
            col = col + 1
          }
          if off >= len || src.code_unit_at(off) != 10 {
            self.offset = off
            self.line = line
            self.col = col
            return self.fail(
              HclErrorKind::SyntaxError,
              "heredoc marker must be followed by a newline",
              sl,
              sc,
              so,
              line,
              col,
              off,
            )
          }
          off = off + 1
          line = line + 1
          col = 1
          self.offset = off
          self.line = line
          self.col = col
          if !self.push_mode(MODE_HEREDOC, if indented { 1 } else { 0 }, marker, sl, sc, so, line, col, off) {
            return false
          }
          return self.set_tok(TOK_OHEREDOC, marker, indented, sl, sc, so, line, col, off)
        }
        if b1 == 61 {
          off = off + 2
          col = col + 2
          self.offset = off
          self.line = line
          self.col = col
          return self.set_tok(TOK_LTEQ, "", false, sl, sc, so, line, col, off)
        }
      }
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_LT, "", false, sl, sc, so, line, col, off)
    }

    // '>', '>='
    if b == 62 {
      if off + 1 < len && src.code_unit_at(off + 1) == 61 {
        off = off + 2
        col = col + 2
        self.offset = off
        self.line = line
        self.col = col
        return self.set_tok(TOK_GTEQ, "", false, sl, sc, so, line, col, off)
      }
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_GT, "", false, sl, sc, so, line, col, off)
    }

    // '!', '!='
    if b == 33 {
      if off + 1 < len && src.code_unit_at(off + 1) == 61 {
        off = off + 2
        col = col + 2
        self.offset = off
        self.line = line
        self.col = col
        return self.set_tok(TOK_BANGEQ, "", false, sl, sc, so, line, col, off)
      }
      off = off + 1
      col = col + 1
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_BANG, "", false, sl, sc, so, line, col, off)
    }

    // '&&', '||'
    if b == 38 && off + 1 < len && src.code_unit_at(off + 1) == 38 {
      off = off + 2
      col = col + 2
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_ANDAND, "", false, sl, sc, so, line, col, off)
    }
    if b == 124 && off + 1 < len && src.code_unit_at(off + 1) == 124 {
      off = off + 2
      col = col + 2
      self.offset = off
      self.line = line
      self.col = col
      return self.set_tok(TOK_OROR, "", false, sl, sc, so, line, col, off)
    }

    // Remaining single-char operators
    off = off + 1
    col = col + 1
    self.offset = off
    self.line = line
    self.col = col
    if b == 43 {
      return self.set_tok(TOK_PLUS, "", false, sl, sc, so, line, col, off)
    }
    if b == 45 {
      return self.set_tok(TOK_MINUS, "", false, sl, sc, so, line, col, off)
    }
    if b == 42 {
      return self.set_tok(TOK_STAR, "", false, sl, sc, so, line, col, off)
    }
    if b == 47 {
      return self.set_tok(TOK_SLASH, "", false, sl, sc, so, line, col, off)
    }
    if b == 37 {
      return self.set_tok(TOK_PERCENT, "", false, sl, sc, so, line, col, off)
    }
    if b == 63 {
      return self.set_tok(TOK_QUESTION, "", false, sl, sc, so, line, col, off)
    }

    return self.fail(HclErrorKind::SyntaxError, "unexpected character in HCL input", sl, sc, so, line, col, off)
  }
  false
}

fn StreamLexer::scan_quoted(self : StreamLexer) -> Bool {
  let src = self.src
  let len = self.len
  let lut = hcl_char_lut
  let mut off = self.offset
  let line = self.line
  let mut col = self.col
  let sl = line
  let sc = col
  let so = off

  if off >= len {
    return self.fail(HclErrorKind::SyntaxError, "unterminated quoted string", sl, sc, so, sl, sc, so)
  }
  let b = src.code_unit_at(off)
  if b == 34 {
    off = off + 1
    col = col + 1
    self.offset = off
    self.col = col
    self.pop_mode()
    return self.set_tok(TOK_CQUOTE, "", false, sl, sc, so, line, col, off)
  }
  if (b == 36 || b == 37) && off + 1 < len && src.code_unit_at(off + 1) == 123 {
    off = off + 2
    col = col + 2
    let mut strip = false
    if off < len && src.code_unit_at(off) == 126 {
      strip = true
      off = off + 1
      col = col + 1
    }
    self.offset = off
    self.col = col
    if !self.push_mode(MODE_TEMPLATE_EXPR, 0, "", sl, sc, so, line, col, off) {
      return false
    }
    let tag = if b == 36 { TOK_TEMPLATE_INTERP } else { TOK_TEMPLATE_CONTROL }
    return self.set_tok(tag, "", strip, sl, sc, so, line, col, off)
  }

  // Fast path: scan unescaped literal chunk directly with LUT
  let mut has_escape = false
  while off < len {
    let c = src.code_unit_at(off)
    if (lut[c] & HCL_CH_QUOTED_SPEC) == 0 {
      off = off + 1
      continue
    }
    if c == 34 {
      break
    }
    if c == 10 || c == 13 {
      col = sc + (off - so)
      self.offset = off
      self.col = col
      return self.fail(
        HclErrorKind::SyntaxError,
        "unterminated quoted string (newline in string literal)",
        sl,
        sc,
        so,
        line,
        col,
        off,
      )
    }
    if c == 92 {
      has_escape = true
      break
    }
    // c is '$' (36) or '%' (37)
    if off + 1 < len {
      let c1 = src.code_unit_at(off + 1)
      if c1 == 123 {
        break
      }
      if c1 == c && off + 2 < len && src.code_unit_at(off + 2) == 123 {
        has_escape = true
        break
      }
    }
    off = off + 1
  }

  if !has_escape {
    col = sc + (off - so)
    self.offset = off
    self.col = col
    return self.set_tok(TOK_QUOTED_LIT, src.slice(so, off), false, sl, sc, so, line, col, off)
  }

  // Slow path: decode escapes into StringBuilder, copying clean runs as slices
  let sb = StringBuilder::with_capacity((off - so) + 16)
  if off > so {
    sb.write_string(src.slice(so, off))
  }
  while off < len {
    let chunk_start = off
    while off < len && (lut[src.code_unit_at(off)] & HCL_CH_QUOTED_SPEC) == 0 {
      off = off + 1
    }
    if off > chunk_start {
      sb.write_string(src.slice(chunk_start, off))
    }
    if off >= len {
      break
    }
    let c = src.code_unit_at(off)
    if c == 34 {
      break
    }
    if c == 10 || c == 13 {
      col = sc + (off - so)
      self.offset = off
      self.col = col
      return self.fail(
        HclErrorKind::SyntaxError,
        "unterminated quoted string (newline in string literal)",
        sl,
        sc,
        so,
        line,
        col,
        off,
      )
    }
    if c == 36 || c == 37 {
      if off + 1 < len {
        let c1 = src.code_unit_at(off + 1)
        if c1 == 123 {
          break
        }
        if c1 == c && off + 2 < len && src.code_unit_at(off + 2) == 123 {
          off = off + 2
          sb.write_byte(c.to_byte())
          continue
        }
      }
      off = off + 1
      sb.write_byte(c.to_byte())
      continue
    }
    // c == '\\' (92)
    let esc_so = off
    let esc_sc = sc + (off - so)
    off = off + 1
    if off >= len {
      col = sc + (off - so)
      self.offset = off
      self.col = col
      return self.fail(
        HclErrorKind::SyntaxError,
        "unknown escape sequence in quoted string",
        sl,
        esc_sc,
        esc_so,
        line,
        col,
        off,
      )
    }
    let e = src.code_unit_at(off)
    off = off + 1
    if e == 110 {
      sb.write_byte((10).to_byte())
    } else if e == 114 {
      sb.write_byte((13).to_byte())
    } else if e == 116 {
      sb.write_byte((9).to_byte())
    } else if e == 34 {
      sb.write_byte((34).to_byte())
    } else if e == 92 {
      sb.write_byte((92).to_byte())
    } else if e == 117 || e == 85 {
      let count = if e == 117 { 4 } else { 8 }
      let mut cp = 0
      let mut k = 0
      while k < count {
        let hb = if off < len {
          let ch = src.code_unit_at(off)
          off = off + 1
          ch
        } else {
          -1
        }
        let h = hcl_hex_val(hb)
        if h < 0 {
          col = sc + (off - so)
          self.offset = off
          self.col = col
          return self.fail(
            HclErrorKind::SyntaxError,
            "invalid unicode escape sequence",
            sl,
            esc_sc,
            esc_so,
            line,
            col,
            off,
          )
        }
        cp = (cp << 4) | h
        k = k + 1
      }
      if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        col = sc + (off - so)
        self.offset = off
        self.col = col
        return self.fail(
          HclErrorKind::SyntaxError,
          "invalid unicode code point in escape",
          sl,
          esc_sc,
          esc_so,
          line,
          col,
          off,
        )
      }
      write_utf8_cp_sb(sb, cp)
    } else {
      col = sc + (off - so)
      self.offset = off
      self.col = col
      return self.fail(
        HclErrorKind::SyntaxError,
        "unknown escape sequence in quoted string",
        sl,
        esc_sc,
        esc_so,
        line,
        col,
        off,
      )
    }
  }
  col = sc + (off - so)
  self.offset = off
  self.col = col
  self.set_tok(TOK_QUOTED_LIT, sb.to_string(), false, sl, sc, so, line, col, off)
}

fn StreamLexer::scan_heredoc(self : StreamLexer) -> Bool {
  let src = self.src
  let len = self.len
  let lut = hcl_char_lut
  let marker = self.cur_marker
  let mut off = self.offset
  let mut line = self.line
  let mut col = self.col
  let sl = line
  let sc = col
  let so = off

  if off >= len {
    if marker.length() == 0 {
      return self.set_tok(TOK_EOF, "", false, sl, sc, so, sl, sc, so)
    }
    return self.fail(
      HclErrorKind::SyntaxError,
      "unterminated heredoc (missing marker " + marker + ")",
      sl,
      sc,
      so,
      sl,
      sc,
      so,
    )
  }

  // Check heredoc closing marker at column 1
  if col == 1 {
    let end_idx = matches_heredoc_end_at(src, len, off, marker)
    if end_idx >= 0 {
      col = col + (end_idx - off)
      off = end_idx
      self.offset = off
      self.line = line
      self.col = col
      self.pop_mode()
      return self.set_tok(TOK_CHEREDOC, marker, false, sl, sc, so, line, col, off)
    }
  }

  let b = src.code_unit_at(off)
  if (b == 36 || b == 37) && off + 1 < len && src.code_unit_at(off + 1) == 123 {
    off = off + 2
    col = col + 2
    let mut strip = false
    if off < len && src.code_unit_at(off) == 126 {
      strip = true
      off = off + 1
      col = col + 1
    }
    self.offset = off
    self.line = line
    self.col = col
    if !self.push_mode(MODE_TEMPLATE_EXPR, 0, "", sl, sc, so, line, col, off) {
      return false
    }
    let tag = if b == 36 { TOK_TEMPLATE_INTERP } else { TOK_TEMPLATE_CONTROL }
    return self.set_tok(tag, "", strip, sl, sc, so, line, col, off)
  }

  // Fast path: scan heredoc text until ${, %{, $${, %%{, or closing marker on a new line
  let mut has_escape = false
  while off < len {
    if col == 1 && off > so && matches_heredoc_end_at(src, len, off, marker) >= 0 {
      break
    }
    let chunk_start = off
    while off < len && (lut[src.code_unit_at(off)] & HCL_CH_HEREDOC_SPEC) == 0 {
      off = off + 1
    }
    col = col + (off - chunk_start)
    if off >= len {
      break
    }
    let c = src.code_unit_at(off)
    if c == 10 {
      off = off + 1
      line = line + 1
      col = 1
      continue
    }
    // c is '$' (36) or '%' (37)
    if off + 1 < len {
      let c1 = src.code_unit_at(off + 1)
      if c1 == 123 {
        break
      }
      if c1 == c && off + 2 < len && src.code_unit_at(off + 2) == 123 {
        has_escape = true
        break
      }
    }
    off = off + 1
    col = col + 1
  }

  if !has_escape {
    self.offset = off
    self.line = line
    self.col = col
    return self.set_tok(TOK_STRING_LIT, src.slice(so, off), false, sl, sc, so, line, col, off)
  }

  // Slow path: decode $${ and %%{ escapes while copying clean slices
  let sb = StringBuilder::with_capacity((off - so) + 32)
  if off > so {
    sb.write_string(src.slice(so, off))
  }
  while off < len {
    if col == 1 && off > so && matches_heredoc_end_at(src, len, off, marker) >= 0 {
      break
    }
    let chunk_start = off
    while off < len && (lut[src.code_unit_at(off)] & HCL_CH_HEREDOC_SPEC) == 0 {
      off = off + 1
    }
    if off > chunk_start {
      sb.write_string(src.slice(chunk_start, off))
      col = col + (off - chunk_start)
    }
    if off >= len {
      break
    }
    let c = src.code_unit_at(off)
    if c == 10 {
      sb.write_byte((10).to_byte())
      off = off + 1
      line = line + 1
      col = 1
      continue
    }
    if off + 1 < len {
      let c1 = src.code_unit_at(off + 1)
      if c1 == 123 {
        break
      }
      if c1 == c && off + 2 < len && src.code_unit_at(off + 2) == 123 {
        off = off + 2
        col = col + 2
        sb.write_byte(c.to_byte())
        continue
      }
    }
    sb.write_byte(c.to_byte())
    off = off + 1
    col = col + 1
  }
  self.offset = off
  self.line = line
  self.col = col
  self.set_tok(TOK_STRING_LIT, sb.to_string(), false, sl, sc, so, line, col, off)
}

fn StreamLexer::next_token(self : StreamLexer) -> Bool {
  let m = self.cur_mode
  if m == MODE_NORMAL {
    self.scan_normal(false)
  } else if m == MODE_QUOTED {
    self.scan_quoted()
  } else if m == MODE_TEMPLATE_EXPR {
    self.scan_normal(true)
  } else {
    self.scan_heredoc()
  }
}

fn StreamLexer::materialize_token(self : StreamLexer) -> Token {
  let tag = self.tok_tag
  let span = Span::new(Pos::new(self.tok_sl, self.tok_sc, self.tok_so), Pos::new(self.tok_el, self.tok_ec, self.tok_eo))
  let kind = if tag == TOK_IDENT {
    TokKind::Ident(self.tok_str)
  } else if tag == TOK_NEWLINE {
    TokKind::Newline
  } else if tag == TOK_OQUOTE {
    TokKind::OQuote
  } else if tag == TOK_CQUOTE {
    TokKind::CQuote
  } else if tag == TOK_QUOTED_LIT {
    TokKind::QuotedLit(self.tok_str)
  } else if tag == TOK_EQUAL {
    TokKind::Equal
  } else if tag == TOK_LBRACE {
    TokKind::LBrace
  } else if tag == TOK_RBRACE {
    TokKind::RBrace
  } else if tag == TOK_NUMBER {
    TokKind::NumberLit(self.tok_str)
  } else if tag == TOK_STRING_LIT {
    TokKind::StringLit(self.tok_str)
  } else if tag == TOK_EOF {
    TokKind::Eof
  } else if tag == TOK_COMMENT {
    TokKind::Comment(self.tok_str)
  } else if tag == TOK_OHEREDOC {
    TokKind::OHeredoc(self.tok_str, self.tok_flag)
  } else if tag == TOK_CHEREDOC {
    TokKind::CHeredoc(self.tok_str)
  } else if tag == TOK_TEMPLATE_INTERP {
    TokKind::TemplateInterp(self.tok_flag)
  } else if tag == TOK_TEMPLATE_CONTROL {
    TokKind::TemplateControl(self.tok_flag)
  } else if tag == TOK_TEMPLATE_SEQ_END {
    TokKind::TemplateSeqEnd(self.tok_flag)
  } else if tag == TOK_LBRACKET {
    TokKind::LBracket
  } else if tag == TOK_RBRACKET {
    TokKind::RBracket
  } else if tag == TOK_LPAREN {
    TokKind::LParen
  } else if tag == TOK_RPAREN {
    TokKind::RParen
  } else if tag == TOK_EQEQ {
    TokKind::EqEq
  } else if tag == TOK_BANGEQ {
    TokKind::BangEq
  } else if tag == TOK_LT {
    TokKind::Lt
  } else if tag == TOK_LTEQ {
    TokKind::LtEq
  } else if tag == TOK_GT {
    TokKind::Gt
  } else if tag == TOK_GTEQ {
    TokKind::GtEq
  } else if tag == TOK_FATARROW {
    TokKind::FatArrow
  } else if tag == TOK_PLUS {
    TokKind::Plus
  } else if tag == TOK_MINUS {
    TokKind::Minus
  } else if tag == TOK_STAR {
    TokKind::Star
  } else if tag == TOK_SLASH {
    TokKind::Slash
  } else if tag == TOK_PERCENT {
    TokKind::Percent
  } else if tag == TOK_ANDAND {
    TokKind::AndAnd
  } else if tag == TOK_OROR {
    TokKind::OrOr
  } else if tag == TOK_BANG {
    TokKind::Bang
  } else if tag == TOK_QUESTION {
    TokKind::Question
  } else if tag == TOK_COLON {
    TokKind::Colon
  } else if tag == TOK_DOT {
    TokKind::Dot
  } else if tag == TOK_ELLIPSIS {
    TokKind::Ellipsis
  } else {
    TokKind::Comma
  }
  let raw = if tag == TOK_IDENT || tag == TOK_NUMBER || tag == TOK_COMMENT {
    self.tok_str
  } else if tag == TOK_EOF {
    ""
  } else {
    self.src.slice(self.tok_so, self.tok_eo)
  }
  Token::{ kind: kind, raw: raw, span: span }
}

///| Lex an entire HCL2 source string into tokens.
pub fn lex_hcl(src : String, keep_comments : Bool, max_depth : Int) -> Result[Array[Token], HclError] {
  let lex = StreamLexer::new(src, keep_comments, max_depth)
  let est = src.length() / 6
  let cap = if est > 16 { est } else { 16 }
  let tokens : Array[Token] = Array::with_capacity(cap)
  while true {
    if !lex.next_token() {
      match lex.err {
        Some(e) => return Err(e)
        None => return Err(HclError::new(HclErrorKind::SyntaxError, "lexer error", Span::zero()))
      }
    }
    let is_eof = lex.tok_tag == TOK_EOF
    tokens.push(lex.materialize_token())
    if is_eof {
      break
    }
  }
  Ok(tokens)
}

///| Lex a standalone unquoted HCL2 template string into tokens.
pub fn lex_template(src : String, max_depth : Int) -> Result[Array[Token], HclError] {
  let lex = StreamLexer::new_template(src, max_depth)
  let tokens : Array[Token] = []
  while true {
    if !lex.next_token() {
      match lex.err {
        Some(e) => return Err(e)
        None => return Err(HclError::new(HclErrorKind::SyntaxError, "lexer error", Span::zero()))
      }
    }
    let is_eof = lex.tok_tag == TOK_EOF
    tokens.push(lex.materialize_token())
    if is_eof {
      break
    }
  }
  Ok(tokens)
}
