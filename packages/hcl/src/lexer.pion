///| Mode-stack HCL2 lexer supporting native syntax, comments (`#`, `//`, `/* */`),
///| quoted templates with escapes, heredocs (`<<EOF`, `<<-EOF`), `${...}` interpolations,
///| `%{...}` control directives, and `~` whitespace strip markers.

///| Token kinds emitted by the HCL2 lexer.
pub enum TokKind {
  Eof
  Newline
  Comment(String)
  Ident(String)
  NumberLit(String)
  OQuote
  CQuote
  OHeredoc(String, Bool)
  CHeredoc(String)
  QuotedLit(String)
  StringLit(String)
  TemplateInterp(Bool)
  TemplateControl(Bool)
  TemplateSeqEnd(Bool)
  LBrace
  RBrace
  LBracket
  RBracket
  LParen
  RParen
  Equal
  EqEq
  BangEq
  Lt
  LtEq
  Gt
  GtEq
  FatArrow
  Plus
  Minus
  Star
  Slash
  Percent
  AndAnd
  OrOr
  Bang
  Question
  Colon
  Dot
  Ellipsis
  Comma
}

///| Lexer token with kind, raw source slice, and exact `Span`.
pub struct Token {
  pub kind : TokKind
  pub raw : String
  pub span : Span
}

enum LexMode {
  Normal
  Quoted
  Heredoc(String, Bool)
  TemplateExpr(Int)
}

struct Lexer {
  src : String
  len : Int
  mut offset : Int
  mut line : Int
  mut col : Int
  modes : Array[LexMode]
  keep_comments : Bool
  max_depth : Int
}

fn Lexer::new(src : String, keep_comments : Bool, max_depth : Int) -> Lexer {
  let len = src.length()
  let mut start_off = 0
  // Skip UTF-8 BOM (EF BB BF) if present at start of input
  if len >= 3 && src.code_unit_at(0) == 0xEF && src.code_unit_at(1) == 0xBB && src.code_unit_at(2) == 0xBF {
    start_off = 3
  }
  Lexer::{
    src: src,
    len: len,
    offset: start_off,
    line: 1,
    col: 1,
    modes: [LexMode::Normal],
    keep_comments: keep_comments,
    max_depth: hcl_effective_max_depth(max_depth),
  }
}

fn Lexer::new_template(src : String, max_depth : Int) -> Lexer {
  Lexer::{
    src: src,
    len: src.length(),
    offset: 0,
    line: 1,
    col: 1,
    modes: [LexMode::Heredoc("", false)],
    keep_comments: false,
    max_depth: hcl_effective_max_depth(max_depth),
  }
}

fn Lexer::pos(self : Lexer) -> Pos {
  Pos::new(self.line, self.col, self.offset)
}

fn Lexer::peek(self : Lexer) -> Int {
  if self.offset < self.len {
    self.src.code_unit_at(self.offset)
  } else {
    -1
  }
}

fn Lexer::peek_at(self : Lexer, delta : Int) -> Int {
  let idx = self.offset + delta
  if idx >= 0 && idx < self.len {
    self.src.code_unit_at(idx)
  } else {
    -1
  }
}

fn Lexer::advance_byte(self : Lexer) -> Int {
  if self.offset >= self.len {
    return -1
  }
  let b = self.src.code_unit_at(self.offset)
  self.offset = self.offset + 1
  if b == 10 {
    self.line = self.line + 1
    self.col = 1
  } else {
    self.col = self.col + 1
  }
  b
}

#verify
pub fn is_hcl_ident_start(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128
}

#verify
pub fn is_hcl_ident_cont(b : Int) -> Bool {
  is_hcl_ident_start(b) || (b >= 48 && b <= 57) || b == 45
}

#verify
pub fn is_hcl_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

#verify
pub fn hcl_hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn push_utf8_cp(out : Array[Byte], cp : Int) -> Unit {
  if cp <= 0x7F {
    out.push(cp.to_byte())
  } else if cp <= 0x7FF {
    out.push((0xC0 | (cp >> 6)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    out.push((0xE0 | (cp >> 12)).to_byte())
    out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  } else {
    out.push((0xF0 | (cp >> 18)).to_byte())
    out.push((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn arr_bytes_to_string(arr : Array[Byte], span : Span) -> Result[String, HclError] {
  let _ = span
  let sb = StringBuilder::new()
  let mut i = 0
  while i < arr.length() {
    sb.write_byte(arr[i])
    i = i + 1
  }
  Ok(sb.to_string())
}

fn Lexer::current_mode(self : Lexer) -> LexMode {
  let n = self.modes.length()
  if n == 0 {
    LexMode::Normal
  } else {
    self.modes[n - 1]
  }
}

fn Lexer::push_mode(self : Lexer, mode : LexMode, span : Span) -> Result[Unit, HclError] {
  if self.modes.length() > self.max_depth + 4 {
    return Err(
      HclError::new(
        HclErrorKind::LimitExceeded,
        "maximum template/expression nesting depth exceeded",
        span,
      ),
    )
  }
  self.modes.push(mode)
  Ok(())
}

fn Lexer::pop_mode(self : Lexer) -> Unit {
  if self.modes.length() > 1 {
    let _ = self.modes.pop()
  }
}

fn Lexer::scan_normal(self : Lexer, in_template_expr : Bool, brace_depth : Int) -> Result[Option[Token], HclError] {
  // Skip horizontal whitespace (space, tab)
  while true {
    let b = self.peek()
    if b == 32 || b == 9 {
      let _ = self.advance_byte()
    } else {
      break
    }
  }
  if self.offset >= self.len {
    let p = self.pos()
    return Ok(Some(Token::{ kind: TokKind::Eof, raw: "", span: Span::new(p, p) }))
  }

  let start = self.pos()
  let b = self.peek()

  // Newline (\n or \r\n; lone \r is a syntax error in HCL2)
  if b == 10 {
    let _ = self.advance_byte()
    let end = self.pos()
    return Ok(Some(Token::{ kind: TokKind::Newline, raw: "\n", span: Span::new(start, end) }))
  }
  if b == 13 && self.peek_at(1) == 10 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    let end = self.pos()
    return Ok(Some(Token::{ kind: TokKind::Newline, raw: "\r\n", span: Span::new(start, end) }))
  }

  // Comments: #, //, /* ... */
  if b == 35 || (b == 47 && self.peek_at(1) == 47) {
    let raw_start = self.offset
    while self.offset < self.len {
      let c = self.peek()
      if c == 10 || c == 13 {
        break
      }
      let _ = self.advance_byte()
    }
    let raw = self.src.slice(raw_start, self.offset)
    let end = self.pos()
    if self.keep_comments {
      return Ok(Some(Token::{ kind: TokKind::Comment(raw), raw: raw, span: Span::new(start, end) }))
    }
    return Ok(None)
  }
  if b == 47 && self.peek_at(1) == 42 {
    let raw_start = self.offset
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    let mut closed = false
    while self.offset < self.len {
      if self.peek() == 42 && self.peek_at(1) == 47 {
        let _ = self.advance_byte()
        let _ = self.advance_byte()
        closed = true
        break
      }
      let _ = self.advance_byte()
    }
    let end = self.pos()
    if !closed {
      return Err(HclError::new(HclErrorKind::SyntaxError, "unterminated block comment", Span::new(start, end)))
    }
    let raw = self.src.slice(raw_start, self.offset)
    if self.keep_comments {
      return Ok(Some(Token::{ kind: TokKind::Comment(raw), raw: raw, span: Span::new(start, end) }))
    }
    return Ok(None)
  }

  // Template sequence end with strip marker: ~}
  if in_template_expr && brace_depth == 0 && b == 126 && self.peek_at(1) == 125 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    let end = self.pos()
    self.pop_mode()
    return Ok(Some(Token::{ kind: TokKind::TemplateSeqEnd(true), raw: "~}", span: Span::new(start, end) }))
  }

  // Quoted string open
  if b == 34 {
    let _ = self.advance_byte()
    let end = self.pos()
    match self.push_mode(LexMode::Quoted, Span::new(start, end)) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(Some(Token::{ kind: TokKind::OQuote, raw: "\"", span: Span::new(start, end) }))
  }

  // Heredoc: <<EOF or <<-EOF
  if b == 60 && self.peek_at(1) == 60 {
    let raw_start = self.offset
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    let mut indented = false
    if self.peek() == 45 {
      indented = true
      let _ = self.advance_byte()
    }
    let m_start = self.offset
    if !is_hcl_ident_start(self.peek()) {
      return Err(
        HclError::new(
          HclErrorKind::SyntaxError,
          "expected heredoc marker identifier after <<",
          Span::new(start, self.pos()),
        ),
      )
    }
    while self.offset < self.len && is_hcl_ident_cont(self.peek()) {
      let _ = self.advance_byte()
    }
    let marker = self.src.slice(m_start, self.offset)
    // Consume trailing horizontal whitespace up to newline
    while self.peek() == 32 || self.peek() == 9 {
      let _ = self.advance_byte()
    }
    if self.peek() == 13 {
      let _ = self.advance_byte()
    }
    if self.peek() != 10 {
      return Err(
        HclError::new(
          HclErrorKind::SyntaxError,
          "heredoc marker must be followed by a newline",
          Span::new(start, self.pos()),
        ),
      )
    }
    let _ = self.advance_byte()
    let raw = self.src.slice(raw_start, self.offset)
    let end = self.pos()
    match self.push_mode(LexMode::Heredoc(marker, indented), Span::new(start, end)) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(Some(Token::{ kind: TokKind::OHeredoc(marker, indented), raw: raw, span: Span::new(start, end) }))
  }

  // Number literal
  if is_hcl_digit(b) {
    let raw_start = self.offset
    while self.offset < self.len && is_hcl_digit(self.peek()) {
      let _ = self.advance_byte()
    }
    if self.peek() == 46 && is_hcl_digit(self.peek_at(1)) {
      let _ = self.advance_byte()
      while self.offset < self.len && is_hcl_digit(self.peek()) {
        let _ = self.advance_byte()
      }
    }
    if self.peek() == 101 || self.peek() == 69 {
      let _ = self.advance_byte()
      if self.peek() == 43 || self.peek() == 45 {
        let _ = self.advance_byte()
      }
      if !is_hcl_digit(self.peek()) {
        return Err(
          HclError::new(
            HclErrorKind::SyntaxError,
            "invalid exponent in number literal",
            Span::new(start, self.pos()),
          ),
        )
      }
      while self.offset < self.len && is_hcl_digit(self.peek()) {
        let _ = self.advance_byte()
      }
    }
    let raw = self.src.slice(raw_start, self.offset)
    let end = self.pos()
    return Ok(Some(Token::{ kind: TokKind::NumberLit(raw), raw: raw, span: Span::new(start, end) }))
  }

  // Identifier
  if is_hcl_ident_start(b) {
    let raw_start = self.offset
    let _ = self.advance_byte()
    while self.offset < self.len && is_hcl_ident_cont(self.peek()) {
      let _ = self.advance_byte()
    }
    let raw = self.src.slice(raw_start, self.offset)
    let end = self.pos()
    return Ok(Some(Token::{ kind: TokKind::Ident(raw), raw: raw, span: Span::new(start, end) }))
  }

  // Multi-char operators
  let b1 = self.peek_at(1)
  if b == 46 && b1 == 46 && self.peek_at(2) == 46 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    return Ok(Some(Token::{ kind: TokKind::Ellipsis, raw: "...", span: Span::new(start, self.pos()) }))
  }
  if b == 61 && b1 == 61 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    return Ok(Some(Token::{ kind: TokKind::EqEq, raw: "==", span: Span::new(start, self.pos()) }))
  }
  if b == 61 && b1 == 62 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    return Ok(Some(Token::{ kind: TokKind::FatArrow, raw: "=>", span: Span::new(start, self.pos()) }))
  }
  if b == 33 && b1 == 61 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    return Ok(Some(Token::{ kind: TokKind::BangEq, raw: "!=", span: Span::new(start, self.pos()) }))
  }
  if b == 60 && b1 == 61 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    return Ok(Some(Token::{ kind: TokKind::LtEq, raw: "<=", span: Span::new(start, self.pos()) }))
  }
  if b == 62 && b1 == 61 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    return Ok(Some(Token::{ kind: TokKind::GtEq, raw: ">=", span: Span::new(start, self.pos()) }))
  }
  if b == 38 && b1 == 38 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    return Ok(Some(Token::{ kind: TokKind::AndAnd, raw: "&&", span: Span::new(start, self.pos()) }))
  }
  if b == 124 && b1 == 124 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    return Ok(Some(Token::{ kind: TokKind::OrOr, raw: "||", span: Span::new(start, self.pos()) }))
  }

  // Single-char punctuation & operators
  let _ = self.advance_byte()
  let end = self.pos()
  let span = Span::new(start, end)
  if b == 123 {
    if in_template_expr {
      let n = self.modes.length()
      self.modes[n - 1] = LexMode::TemplateExpr(brace_depth + 1)
    }
    return Ok(Some(Token::{ kind: TokKind::LBrace, raw: "{", span: span }))
  }
  if b == 125 {
    if in_template_expr {
      if brace_depth == 0 {
        self.pop_mode()
        return Ok(Some(Token::{ kind: TokKind::TemplateSeqEnd(false), raw: "}", span: span }))
      } else {
        let n = self.modes.length()
        self.modes[n - 1] = LexMode::TemplateExpr(brace_depth - 1)
      }
    }
    return Ok(Some(Token::{ kind: TokKind::RBrace, raw: "}", span: span }))
  }
  if b == 91 {
    return Ok(Some(Token::{ kind: TokKind::LBracket, raw: "[", span: span }))
  }
  if b == 93 {
    return Ok(Some(Token::{ kind: TokKind::RBracket, raw: "]", span: span }))
  }
  if b == 40 {
    return Ok(Some(Token::{ kind: TokKind::LParen, raw: "(", span: span }))
  }
  if b == 41 {
    return Ok(Some(Token::{ kind: TokKind::RParen, raw: ")", span: span }))
  }
  if b == 61 {
    return Ok(Some(Token::{ kind: TokKind::Equal, raw: "=", span: span }))
  }
  if b == 60 {
    return Ok(Some(Token::{ kind: TokKind::Lt, raw: "<", span: span }))
  }
  if b == 62 {
    return Ok(Some(Token::{ kind: TokKind::Gt, raw: ">", span: span }))
  }
  if b == 43 {
    return Ok(Some(Token::{ kind: TokKind::Plus, raw: "+", span: span }))
  }
  if b == 45 {
    return Ok(Some(Token::{ kind: TokKind::Minus, raw: "-", span: span }))
  }
  if b == 42 {
    return Ok(Some(Token::{ kind: TokKind::Star, raw: "*", span: span }))
  }
  if b == 47 {
    return Ok(Some(Token::{ kind: TokKind::Slash, raw: "/", span: span }))
  }
  if b == 37 {
    return Ok(Some(Token::{ kind: TokKind::Percent, raw: "%", span: span }))
  }
  if b == 33 {
    return Ok(Some(Token::{ kind: TokKind::Bang, raw: "!", span: span }))
  }
  if b == 63 {
    return Ok(Some(Token::{ kind: TokKind::Question, raw: "?", span: span }))
  }
  if b == 58 {
    return Ok(Some(Token::{ kind: TokKind::Colon, raw: ":", span: span }))
  }
  if b == 46 {
    return Ok(Some(Token::{ kind: TokKind::Dot, raw: ".", span: span }))
  }
  if b == 44 {
    return Ok(Some(Token::{ kind: TokKind::Comma, raw: ",", span: span }))
  }

  Err(HclError::new(HclErrorKind::SyntaxError, "unexpected character in HCL input", span))
}

fn Lexer::scan_quoted(self : Lexer) -> Result[Token, HclError] {
  let start = self.pos()
  if self.offset >= self.len {
    return Err(
      HclError::new(
        HclErrorKind::SyntaxError,
        "unterminated quoted string",
        Span::new(start, start),
      ),
    )
  }
  let b = self.peek()
  if b == 34 {
    let _ = self.advance_byte()
    self.pop_mode()
    return Ok(Token::{ kind: TokKind::CQuote, raw: "\"", span: Span::new(start, self.pos()) })
  }
  // Template interpolation ${ or ${~
  if b == 36 && self.peek_at(1) == 123 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    let mut strip = false
    if self.peek() == 126 {
      strip = true
      let _ = self.advance_byte()
    }
    let end = self.pos()
    match self.push_mode(LexMode::TemplateExpr(0), Span::new(start, end)) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(
      Token::{
        kind: TokKind::TemplateInterp(strip),
        raw: if strip { "${~" } else { "${" },
        span: Span::new(start, end),
      },
    )
  }
  // Template control %{ or %{~
  if b == 37 && self.peek_at(1) == 123 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    let mut strip = false
    if self.peek() == 126 {
      strip = true
      let _ = self.advance_byte()
    }
    let end = self.pos()
    match self.push_mode(LexMode::TemplateExpr(0), Span::new(start, end)) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(
      Token::{
        kind: TokKind::TemplateControl(strip),
        raw: if strip { "%{~" } else { "%{" },
        span: Span::new(start, end),
      },
    )
  }

  // Literal chunk until ", ${, %{, or newline
  let raw_start = self.offset
  let out : Array[Byte] = []
  while self.offset < self.len {
    let c = self.peek()
    if c == 34 {
      break
    }
    if c == 10 || c == 13 {
      return Err(
        HclError::new(
          HclErrorKind::SyntaxError,
          "unterminated quoted string (newline in string literal)",
          Span::new(start, self.pos()),
        ),
      )
    }
    if c == 36 && self.peek_at(1) == 36 && self.peek_at(2) == 123 {
      // $${ -> literal ${
      let _ = self.advance_byte()
      let _ = self.advance_byte()
      out.push((36).to_byte())
      continue
    }
    if c == 37 && self.peek_at(1) == 37 && self.peek_at(2) == 123 {
      // %%{ -> literal %{
      let _ = self.advance_byte()
      let _ = self.advance_byte()
      out.push((37).to_byte())
      continue
    }
    if (c == 36 || c == 37) && self.peek_at(1) == 123 {
      break
    }
    if c == 92 {
      let esc_start = self.pos()
      let _ = self.advance_byte()
      let e = self.advance_byte()
      if e == 110 {
        out.push((10).to_byte())
      } else if e == 114 {
        out.push((13).to_byte())
      } else if e == 116 {
        out.push((9).to_byte())
      } else if e == 34 {
        out.push((34).to_byte())
      } else if e == 92 {
        out.push((92).to_byte())
      } else if e == 117 || e == 85 {
        let count = if e == 117 { 4 } else { 8 }
        let mut cp = 0
        let mut k = 0
        while k < count {
          let h = hcl_hex_val(self.advance_byte())
          if h < 0 {
            return Err(
              HclError::new(
                HclErrorKind::SyntaxError,
                "invalid unicode escape sequence",
                Span::new(esc_start, self.pos()),
              ),
            )
          }
          cp = (cp << 4) | h
          k = k + 1
        }
        if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
          return Err(
            HclError::new(
              HclErrorKind::SyntaxError,
              "invalid unicode code point in escape",
              Span::new(esc_start, self.pos()),
            ),
          )
        }
        push_utf8_cp(out, cp)
      } else {
        return Err(
          HclError::new(
            HclErrorKind::SyntaxError,
            "unknown escape sequence in quoted string",
            Span::new(esc_start, self.pos()),
          ),
        )
      }
    } else {
      let _ = self.advance_byte()
      out.push(c.to_byte())
    }
  }
  let raw = self.src.slice(raw_start, self.offset)
  let end = self.pos()
  let span = Span::new(start, end)
  let decoded = match arr_bytes_to_string(out, span) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(Token::{ kind: TokKind::QuotedLit(decoded), raw: raw, span: span })
}

fn Lexer::matches_heredoc_end(self : Lexer, marker : String, indented : Bool) -> Int {
  // Check if current position (at start of line) matches [spaces/tabs] marker [optional spaces/tabs] (\r?\n | EOF)
  // Note: HCL2 accepts leading spaces/tabs before the closing marker for both `<<EOF` and `<<-EOF`.
  let _ = indented
  if marker.length() == 0 {
    return -1
  }
  let mut idx = self.offset
  while idx < self.len && (self.src.code_unit_at(idx) == 32 || self.src.code_unit_at(idx) == 9) {
    idx = idx + 1
  }
  let mlen = marker.length()
  if idx + mlen > self.len {
    return -1
  }
  let mut j = 0
  while j < mlen {
    if self.src.code_unit_at(idx + j) != marker.code_unit_at(j) {
      return -1
    }
    j = j + 1
  }
  idx = idx + mlen
  while idx < self.len && (self.src.code_unit_at(idx) == 32 || self.src.code_unit_at(idx) == 9) {
    idx = idx + 1
  }
  if idx == self.len || self.src.code_unit_at(idx) == 10 || self.src.code_unit_at(idx) == 13 {
    idx
  } else {
    -1
  }
}

fn Lexer::scan_heredoc(self : Lexer, marker : String, indented : Bool) -> Result[Token, HclError] {
  let start = self.pos()
  if self.offset >= self.len {
    if marker.length() == 0 {
      return Ok(Token::{ kind: TokKind::Eof, raw: "", span: Span::new(start, start) })
    }
    return Err(
      HclError::new(
        HclErrorKind::SyntaxError,
        "unterminated heredoc (missing marker " + marker + ")",
        Span::new(start, start),
      ),
    )
  }
  // Check heredoc closing marker at column 1
  if self.col == 1 {
    let end_idx = self.matches_heredoc_end(marker, indented)
    if end_idx >= 0 {
      let raw_start = self.offset
      while self.offset < end_idx {
        let _ = self.advance_byte()
      }
      let raw = self.src.slice(raw_start, self.offset)
      self.pop_mode()
      return Ok(Token::{ kind: TokKind::CHeredoc(marker), raw: raw, span: Span::new(start, self.pos()) })
    }
  }

  let b = self.peek()
  if b == 36 && self.peek_at(1) == 123 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    let mut strip = false
    if self.peek() == 126 {
      strip = true
      let _ = self.advance_byte()
    }
    let end = self.pos()
    match self.push_mode(LexMode::TemplateExpr(0), Span::new(start, end)) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(
      Token::{
        kind: TokKind::TemplateInterp(strip),
        raw: if strip { "${~" } else { "${" },
        span: Span::new(start, end),
      },
    )
  }
  if b == 37 && self.peek_at(1) == 123 {
    let _ = self.advance_byte()
    let _ = self.advance_byte()
    let mut strip = false
    if self.peek() == 126 {
      strip = true
      let _ = self.advance_byte()
    }
    let end = self.pos()
    match self.push_mode(LexMode::TemplateExpr(0), Span::new(start, end)) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(
      Token::{
        kind: TokKind::TemplateControl(strip),
        raw: if strip { "%{~" } else { "%{" },
        span: Span::new(start, end),
      },
    )
  }

  // Scan raw heredoc text until ${, %{, or closing marker on a new line
  let raw_start = self.offset
  let out : Array[Byte] = []
  while self.offset < self.len {
    if self.col == 1 && self.offset > raw_start && self.matches_heredoc_end(marker, indented) >= 0 {
      break
    }
    let c = self.peek()
    if c == 36 && self.peek_at(1) == 36 && self.peek_at(2) == 123 {
      let _ = self.advance_byte()
      let _ = self.advance_byte()
      out.push((36).to_byte())
      continue
    }
    if c == 37 && self.peek_at(1) == 37 && self.peek_at(2) == 123 {
      let _ = self.advance_byte()
      let _ = self.advance_byte()
      out.push((37).to_byte())
      continue
    }
    if (c == 36 || c == 37) && self.peek_at(1) == 123 {
      break
    }
    let _ = self.advance_byte()
    out.push(c.to_byte())
  }
  let raw = self.src.slice(raw_start, self.offset)
  let end = self.pos()
  let span = Span::new(start, end)
  let decoded = match arr_bytes_to_string(out, span) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(Token::{ kind: TokKind::StringLit(decoded), raw: raw, span: span })
}

///| Lex an entire HCL2 source string into tokens.
pub fn lex_hcl(src : String, keep_comments : Bool, max_depth : Int) -> Result[Array[Token], HclError] {
  let lex = Lexer::new(src, keep_comments, max_depth)
  let tokens : Array[Token] = []
  while true {
    let tok = match lex.current_mode() {
      LexMode::Normal => {
        match lex.scan_normal(false, 0) {
          Ok(Some(t)) => t
          Ok(None) => continue
          Err(e) => return Err(e)
        }
      }
      LexMode::TemplateExpr(bd) => {
        match lex.scan_normal(true, bd) {
          Ok(Some(t)) => t
          Ok(None) => continue
          Err(e) => return Err(e)
        }
      }
      LexMode::Quoted => {
        match lex.scan_quoted() {
          Ok(t) => t
          Err(e) => return Err(e)
        }
      }
      LexMode::Heredoc(marker, indented) => {
        match lex.scan_heredoc(marker, indented) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
      }
    }
    let is_eof = match tok.kind {
      TokKind::Eof => true
      _ => false
    }
    tokens.push(tok)
    if is_eof {
      break
    }
  }
  Ok(tokens)
}

///| Lex a standalone unquoted HCL2 template string into tokens.
pub fn lex_template(src : String, max_depth : Int) -> Result[Array[Token], HclError] {
  let lex = Lexer::new_template(src, max_depth)
  let tokens : Array[Token] = []
  while true {
    let tok = match lex.current_mode() {
      LexMode::Normal => {
        match lex.scan_normal(false, 0) {
          Ok(Some(t)) => t
          Ok(None) => continue
          Err(e) => return Err(e)
        }
      }
      LexMode::TemplateExpr(bd) => {
        match lex.scan_normal(true, bd) {
          Ok(Some(t)) => t
          Ok(None) => continue
          Err(e) => return Err(e)
        }
      }
      LexMode::Quoted => {
        match lex.scan_quoted() {
          Ok(t) => t
          Err(e) => return Err(e)
        }
      }
      LexMode::Heredoc(marker, indented) => {
        match lex.scan_heredoc(marker, indented) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
      }
    }
    let is_eof = match tok.kind {
      TokKind::Eof => true
      _ => false
    }
    tokens.push(tok)
    if is_eof {
      break
    }
  }
  Ok(tokens)
}
