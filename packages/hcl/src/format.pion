///| Canonical HCL2 formatter (`format_hcl`), aligned with `hclwrite.Format` / `terraform fmt`:
///| - 2-space indentation for blocks, multi-line objects, and multi-line tuples
///| - Vertical `=` alignment across contiguous single-line attribute groups
///| - Canonical operator and punctuation spacing
///| - Preserves comments, blank lines, and heredoc bodies verbatim
///| - Strictly idempotent: `format_hcl(format_hcl(s)) == format_hcl(s)`

struct FmtLine {
  tokens : Array[Token]
  is_blank : Bool
  is_heredoc_body : Bool
  heredoc_raw : String
}

fn is_binary_spaced_op(kind : TokKind) -> Bool {
  match kind {
    TokKind::Equal
    | TokKind::EqEq
    | TokKind::BangEq
    | TokKind::Lt
    | TokKind::LtEq
    | TokKind::Gt
    | TokKind::GtEq
    | TokKind::FatArrow
    | TokKind::Plus
    | TokKind::Star
    | TokKind::Slash
    | TokKind::Percent
    | TokKind::AndAnd
    | TokKind::OrOr
    | TokKind::Question => true
    _ => false
  }
}

fn is_value_ending_tok(kind : TokKind) -> Bool {
  match kind {
    TokKind::Ident(_)
    | TokKind::NumberLit(_)
    | TokKind::CQuote
    | TokKind::CHeredoc(_)
    | TokKind::RParen
    | TokKind::RBracket
    | TokKind::RBrace => true
    _ => false
  }
}

fn is_template_inner_tok(kind : TokKind) -> Bool {
  match kind {
    TokKind::QuotedLit(_)
    | TokKind::StringLit(_)
    | TokKind::TemplateInterp(_)
    | TokKind::TemplateControl(_)
    | TokKind::TemplateSeqEnd(_)
    | TokKind::CQuote => true
    _ => false
  }
}

fn split_tokens_into_lines(tokens : Array[Token]) -> Array[FmtLine] {
  let lines : Array[FmtLine] = []
  let mut cur : Array[Token] = []
  let mut i = 0
  let n = tokens.length()
  while i < n {
    let tok = tokens[i]
    match tok.kind {
      TokKind::Eof => {
        if cur.length() > 0 {
          lines.push(FmtLine::{ tokens: cur, is_blank: false, is_heredoc_body: false, heredoc_raw: "" })
        }
        break
      }
      TokKind::OHeredoc(_, _) => {
        // Attach OHeredoc header (without trailing newline) to current line, then collect heredoc body verbatim until CHeredoc
        let hdr = trim_trailing_newline(tok.raw)
        cur.push(Token::{ kind: tok.kind, raw: hdr, span: tok.span })
        lines.push(FmtLine::{ tokens: cur, is_blank: false, is_heredoc_body: false, heredoc_raw: "" })
        cur = []
        i = i + 1
        let hsb = StringBuilder::new()
        while i < n {
          let ht = tokens[i]
          match ht.kind {
            TokKind::CHeredoc(_) => {
              hsb.write_string(ht.raw)
              i = i + 1
              break
            }
            TokKind::Eof => break
            _ => {
              hsb.write_string(ht.raw)
              i = i + 1
            }
          }
        }
        lines.push(
          FmtLine::{
            tokens: [],
            is_blank: false,
            is_heredoc_body: true,
            heredoc_raw: hsb.to_string(),
          },
        )
        // Consume newline right after CHeredoc if present
        if i < n {
          match tokens[i].kind {
            TokKind::Newline => i = i + 1
            _ => ()
          }
        }
        continue
      }
      TokKind::Newline => {
        if cur.length() == 0 {
          lines.push(FmtLine::{ tokens: [], is_blank: true, is_heredoc_body: false, heredoc_raw: "" })
        } else {
          lines.push(FmtLine::{ tokens: cur, is_blank: false, is_heredoc_body: false, heredoc_raw: "" })
          cur = []
        }
        i = i + 1
      }
      _ => {
        cur.push(tok)
        i = i + 1
      }
    }
  }
  lines
}

fn trim_trailing_newline(s : String) -> String {
  let mut end = s.length()
  while end > 0 && (s.code_unit_at(end - 1) == 10 || s.code_unit_at(end - 1) == 13 || s.code_unit_at(end - 1) == 32 || s.code_unit_at(end - 1) == 9) {
    end = end - 1
  }
  s.slice(0, end)
}

fn line_leading_closes(line : FmtLine) -> Int {
  let mut c = 0
  let mut i = 0
  while i < line.tokens.length() {
    match line.tokens[i].kind {
      TokKind::RBrace | TokKind::RBracket | TokKind::RParen => c = c + 1
      _ => break
    }
    i = i + 1
  }
  c
}

fn line_net_indent_delta(line : FmtLine) -> Int {
  let mut delta = 0
  let mut in_template = 0
  let mut i = 0
  while i < line.tokens.length() {
    match line.tokens[i].kind {
      TokKind::OQuote => in_template = in_template + 1
      TokKind::CQuote => {
        if in_template > 0 {
          in_template = in_template - 1
        }
      }
      TokKind::LBrace | TokKind::LBracket | TokKind::LParen => {
        if in_template == 0 {
          delta = delta + 1
        }
      }
      TokKind::RBrace | TokKind::RBracket | TokKind::RParen => {
        if in_template == 0 {
          delta = delta - 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  delta
}

///| Check if a line is an alignable assignment `ident = ...` (at index 0 and 1).
fn line_alignable_lhs_len(line : FmtLine) -> Int {
  if line.is_blank || line.is_heredoc_body || line.tokens.length() < 3 {
    return -1
  }
  match (line.tokens[0].kind, line.tokens[1].kind) {
    (TokKind::Ident(name), TokKind::Equal) => name.length()
    _ => -1
  }
}

fn format_line_tokens(tokens : Array[Token], eq_align_col : Int) -> String {
  let sb = StringBuilder::new()
  let n = tokens.length()
  let mut i = 0
  let mut in_quote = 0
  while i < n {
    let tok = tokens[i]
    // Handle quoted string as an atomic verbatim unit (preserving escapes & interpolations)
    if in_quote > 0 {
      match tok.kind {
        TokKind::CQuote => {
          sb.write_string("\"")
          in_quote = in_quote - 1
          i = i + 1
          continue
        }
        TokKind::QuotedLit(_) => {
          sb.write_string(tok.raw)
          i = i + 1
          continue
        }
        TokKind::TemplateInterp(_) | TokKind::TemplateControl(_) => {
          sb.write_string(tok.raw)
          i = i + 1
          // Emit tokens inside interpolation/control cleanly until TemplateSeqEnd
          let mut depth = 1
          let mut first_in_seq = true
          while i < n && depth > 0 {
            let it = tokens[i]
            match it.kind {
              TokKind::TemplateSeqEnd(_) => {
                depth = depth - 1
                sb.write_string(it.raw)
                i = i + 1
              }
              TokKind::TemplateInterp(_) | TokKind::TemplateControl(_) => {
                depth = depth + 1
                sb.write_string(it.raw)
                i = i + 1
              }
              _ => {
                if !first_in_seq && needs_space_between(tokens[i - 1], it, i - 1 >= 1 && is_value_ending_tok(tokens[i - 2].kind)) {
                  sb.write_byte((32).to_byte())
                }
                sb.write_string(it.raw)
                first_in_seq = false
                i = i + 1
              }
            }
          }
          continue
        }
        _ => {
          sb.write_string(tok.raw)
          i = i + 1
          continue
        }
      }
    }

    if i > 0 {
      // Special vertical alignment for `=` at token index 1
      let aligned_eq = i == 1 && eq_align_col > 0 && (match tok.kind {
        TokKind::Equal => true
        _ => false
      })
      if aligned_eq {
        let lhs_len = tokens[0].raw.length()
        let pad = eq_align_col - lhs_len + 1
        let mut p = 0
        while p < pad {
          sb.write_byte((32).to_byte())
          p = p + 1
        }
      } else {
        let prev = tokens[i - 1]
        let prev_prev_val = i >= 2 && is_value_ending_tok(tokens[i - 2].kind)
        if needs_space_between(prev, tok, prev_prev_val) {
          sb.write_byte((32).to_byte())
        }
      }
    }

    match tok.kind {
      TokKind::OQuote => {
        in_quote = in_quote + 1
        sb.write_string("\"")
      }
      _ => sb.write_string(tok.raw)
    }
    i = i + 1
  }
  sb.to_string()
}

fn needs_space_between(prev : Token, cur : Token, prev_was_after_value : Bool) -> Bool {
  // Never space inside template pieces
  if is_template_inner_tok(cur.kind) {
    return false
  }
  match cur.kind {
    TokKind::Comment(_) => return true
    TokKind::Comma | TokKind::Dot | TokKind::Ellipsis | TokKind::RParen | TokKind::RBracket => return false
    TokKind::LParen => {
      // Space before `(` only after keywords/operators, not after function name or `(`/`[`
      match prev.kind {
        TokKind::Ident(kw) => return kw == "if" || kw == "in" || kw == "for"
        TokKind::LParen | TokKind::LBracket | TokKind::Bang | TokKind::Minus => return false
        _ => return true
      }
    }
    TokKind::LBracket => {
      match prev.kind {
        TokKind::Ident(kw) => return kw == "if" || kw == "in" || kw == "for"
        TokKind::LParen | TokKind::LBracket | TokKind::RParen | TokKind::RBracket | TokKind::RBrace | TokKind::CQuote | TokKind::Bang => return false
        _ => return true
      }
    }
    TokKind::RBrace => {
      match prev.kind {
        TokKind::LBrace => return false
        _ => return true
      }
    }
    TokKind::LBrace => {
      match prev.kind {
        TokKind::LParen | TokKind::LBracket => return false
        _ => return true
      }
    }
    TokKind::Colon => {
      // In ternary / for, space before `:`
      return true
    }
    TokKind::Minus => {
      // Binary minus has space before it; unary minus after value doesn't occur, after `(`/`,`: handled by prev
      if is_value_ending_tok(prev.kind) {
        return true
      }
      match prev.kind {
        TokKind::LParen | TokKind::LBracket => return false
        _ => return true
      }
    }
    _ => ()
  }
  // Check based on `prev`
  match prev.kind {
    TokKind::LParen | TokKind::LBracket | TokKind::Dot | TokKind::Bang => return false
    TokKind::LBrace => return true
    TokKind::Comma | TokKind::Colon => return true
    TokKind::Minus => {
      // Unary minus has no space after it; binary minus (when prev was preceded by a value) has space
      return prev_was_after_value
    }
    _ => ()
  }
  if is_binary_spaced_op(prev.kind) || is_binary_spaced_op(cur.kind) {
    return true
  }
  // Adjacent identifiers / strings / numbers (e.g. `resource "aws_instance" "web"`)
  true
}

///| Format HCL2 source canonically (2-space indent, `=` alignment, operator spacing).
pub fn format_hcl_impl(src : String, limits : HclLimits) -> Result[String, HclError] {
  // Validate syntax and depth limits first
  match parse_file_impl(src, limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let tokens = match lex_hcl(src, true, limits.max_depth) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let lines = split_tokens_into_lines(tokens)
  let n = lines.length()

  // Compute indent level for each line
  let indents : Array[Int] = []
  let mut cur_indent = 0
  let mut i = 0
  while i < n {
    let line = lines[i]
    if line.is_blank || line.is_heredoc_body {
      indents.push(cur_indent)
    } else {
      let lead_close = line_leading_closes(line)
      let line_indent = if cur_indent - lead_close > 0 { cur_indent - lead_close } else { 0 }
      indents.push(line_indent)
      let net = line_net_indent_delta(line)
      cur_indent = cur_indent + net
      if cur_indent < 0 {
        cur_indent = 0
      }
    }
    i = i + 1
  }

  // Compute vertical `=` alignment column for contiguous attribute groups at same indent level
  let align_cols : Array[Int] = []
  i = 0
  while i < n {
    align_cols.push(0)
    i = i + 1
  }
  i = 0
  while i < n {
    let lhs = line_alignable_lhs_len(lines[i])
    if lhs > 0 {
      let grp_indent = indents[i]
      let mut max_lhs = lhs
      let mut j = i + 1
      while j < n {
        if lines[j].is_heredoc_body {
          j = j + 1
          continue
        }
        let next_lhs = line_alignable_lhs_len(lines[j])
        if next_lhs > 0 && indents[j] == grp_indent {
          if next_lhs > max_lhs {
            max_lhs = next_lhs
          }
          j = j + 1
        } else {
          break
        }
      }
      let mut k = i
      while k < j {
        if line_alignable_lhs_len(lines[k]) > 0 {
          align_cols[k] = max_lhs
        }
        k = k + 1
      }
      i = j
    } else {
      i = i + 1
    }
  }

  // Emit formatted lines
  let sb = StringBuilder::new()
  // Trim leading blank lines
  let mut start = 0
  while start < n && lines[start].is_blank {
    start = start + 1
  }
  // Trim trailing blank lines
  let mut end = n
  while end > start && lines[end - 1].is_blank {
    end = end - 1
  }
  let mut prev_blank = false
  i = start
  while i < end {
    let line = lines[i]
    if line.is_blank {
      if !prev_blank {
        sb.write_byte((10).to_byte())
        prev_blank = true
      }
    } else if line.is_heredoc_body {
      sb.write_string(line.heredoc_raw)
      sb.write_byte((10).to_byte())
      prev_blank = false
    } else {
      let ind = indents[i]
      let mut sp = 0
      while sp < ind * 2 {
        sb.write_byte((32).to_byte())
        sp = sp + 1
      }
      sb.write_string(format_line_tokens(line.tokens, align_cols[i]))
      sb.write_byte((10).to_byte())
      prev_blank = false
    }
    i = i + 1
  }
  Ok(sb.to_string())
}
