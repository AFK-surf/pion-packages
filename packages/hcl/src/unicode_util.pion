///| Unicode utilities for HCL2 built-ins (`lower`, `upper`, `trimspace`, grapheme `length`,
///| grapheme/UTF-8-safe `substr`, and UTF-8 codepoint width for `format_hcl`).

///| Decode one UTF-8 code point starting at byte index `i`, returning `(codepoint, next_index)`.
pub fn utf8_decode_at(s : String, i : Int) -> (Int, Int) {
  let n = s.length()
  if i >= n {
    return (0, n)
  }
  let b0 = s.code_unit_at(i)
  if b0 < 0x80 {
    return (b0, i + 1)
  }
  if (b0 & 0xE0) == 0xC0 && i + 1 < n {
    let b1 = s.code_unit_at(i + 1)
    if (b1 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
      return (cp, i + 2)
    }
  }
  if (b0 & 0xF0) == 0xE0 && i + 2 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      return (cp, i + 3)
    }
  }
  if (b0 & 0xF8) == 0xF0 && i + 3 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    let b3 = s.code_unit_at(i + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
      return (cp, i + 4)
    }
  }
  // Invalid UTF-8 byte -> replacement character, advance 1 byte
  (0xFFFD, i + 1)
}

///| Write one Unicode code point as UTF-8 into a `StringBuilder`.
pub fn utf8_write_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp <= 0x7F {
    sb.write_byte(cp.to_byte())
  } else if cp <= 0x7FF {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Unicode `IsSpace` (matches Go `unicode.IsSpace`).
#verify
pub fn is_unicode_space(cp : Int) -> Bool {
  if cp <= 0x20 {
    return cp == 0x20 || cp == 0x09 || cp == 0x0A || cp == 0x0B || cp == 0x0C || cp == 0x0D
  }
  if cp == 0x85 || cp == 0xA0 || cp == 0x1680 || cp == 0x2028 || cp == 0x2029 || cp == 0x202F || cp == 0x205F || cp == 0x3000 {
    return true
  }
  cp >= 0x2000 && cp <= 0x200A
}

///| Unicode simple 1-to-1 lowercase mapping (matches Go `unicode.ToLower`).
#verify
pub fn unicode_cp_to_lower(cp : Int) -> Int {
  if cp >= 65 && cp <= 90 {
    return cp + 32
  }
  if cp < 128 {
    return cp
  }
  // Latin-1 Supplement: À..Ö (0xC0..0xD6) -> à..ö, Ø..Þ (0xD8..0xDE) -> ø..þ
  if (cp >= 0xC0 && cp <= 0xD6) || (cp >= 0xD8 && cp <= 0xDE) {
    return cp + 32
  }
  // Latin Extended-A
  if cp == 0x0130 {
    // İ (LATIN CAPITAL LETTER I WITH DOT ABOVE) -> i (Go unicode.ToLower)
    return 0x0069
  }
  if cp == 0x0178 {
    return 0x00FF
  }
  if (cp >= 0x0100 && cp <= 0x012E && (cp & 1) == 0) ||
  (cp >= 0x0132 && cp <= 0x0136 && (cp & 1) == 0) ||
  (cp >= 0x0139 && cp <= 0x0147 && (cp & 1) == 1) ||
  (cp >= 0x014A && cp <= 0x0176 && (cp & 1) == 0) ||
  (cp >= 0x0179 && cp <= 0x017D && (cp & 1) == 1) {
    return cp + 1
  }
  // Greek uppercase Α..Ρ (0x391..0x3A1), Σ..Ω (0x3A3..0x3AB)
  if (cp >= 0x0391 && cp <= 0x03A1) || (cp >= 0x03A3 && cp <= 0x03AB) {
    return cp + 32
  }
  // Cyrillic uppercase А..Я (0x410..0x42F)
  if cp >= 0x0410 && cp <= 0x042F {
    return cp + 32
  }
  if cp >= 0x0400 && cp <= 0x040F {
    return cp + 80
  }
  // Fullwidth Latin A..Z
  if cp >= 0xFF21 && cp <= 0xFF3A {
    return cp + 32
  }
  cp
}

///| Unicode simple 1-to-1 uppercase mapping (matches Go `unicode.ToUpper`).
#verify
pub fn unicode_cp_to_upper(cp : Int) -> Int {
  if cp >= 97 && cp <= 122 {
    return cp - 32
  }
  if cp < 128 {
    return cp
  }
  // Latin-1 Supplement: à..ö (0xE0..0xF6), ø..þ (0xF8..0xFE), ÿ (0xFF -> 0x178)
  if (cp >= 0xE0 && cp <= 0xF6) || (cp >= 0xF8 && cp <= 0xFE) {
    return cp - 32
  }
  if cp == 0x00FF {
    return 0x0178
  }
  if cp == 0x00B5 {
    return 0x039C
  }
  if cp == 0x0131 {
    return 0x0049
  }
  if (cp >= 0x0101 && cp <= 0x012F && (cp & 1) == 1) ||
  (cp >= 0x0133 && cp <= 0x0137 && (cp & 1) == 1) ||
  (cp >= 0x013A && cp <= 0x0148 && (cp & 1) == 0) ||
  (cp >= 0x014B && cp <= 0x0177 && (cp & 1) == 1) ||
  (cp >= 0x017A && cp <= 0x017E && (cp & 1) == 0) {
    return cp - 1
  }
  // Greek lowercase α..ω
  if cp >= 0x03B1 && cp <= 0x03C1 {
    return cp - 32
  }
  if cp >= 0x03C3 && cp <= 0x03CB {
    return cp - 32
  }
  if cp == 0x03C2 {
    return 0x03A3
  }
  // Cyrillic lowercase а..я
  if cp >= 0x0430 && cp <= 0x044F {
    return cp - 32
  }
  if cp >= 0x0450 && cp <= 0x045F {
    return cp - 80
  }
  // Fullwidth Latin a..z
  if cp >= 0xFF41 && cp <= 0xFF5A {
    return cp - 32
  }
  cp
}

///| Unicode-aware `lower(s)` matching Go `strings.ToLower`.
pub fn unicode_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 128 {
      if b >= 65 && b <= 90 {
        sb.write_byte((b + 32).to_byte())
      } else {
        sb.write_byte(b.to_byte())
      }
      i = i + 1
    } else {
      let (cp, next_i) = utf8_decode_at(s, i)
      utf8_write_cp(sb, unicode_cp_to_lower(cp))
      i = next_i
    }
  }
  sb.to_string()
}

///| Unicode-aware `upper(s)` matching Go `strings.ToUpper`.
pub fn unicode_upper(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 128 {
      if b >= 97 && b <= 122 {
        sb.write_byte((b - 32).to_byte())
      } else {
        sb.write_byte(b.to_byte())
      }
      i = i + 1
    } else {
      let (cp, next_i) = utf8_decode_at(s, i)
      utf8_write_cp(sb, unicode_cp_to_upper(cp))
      i = next_i
    }
  }
  sb.to_string()
}

///| Unicode-aware `trimspace(s)` matching Go `strings.TrimSpace`.
pub fn unicode_trimspace(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n {
    let (cp, next_i) = utf8_decode_at(s, start)
    if is_unicode_space(cp) {
      start = next_i
    } else {
      break
    }
  }
  if start >= n {
    return ""
  }
  // Find last non-space code point end
  let mut last_end = start
  let mut i = start
  while i < n {
    let (cp, next_i) = utf8_decode_at(s, i)
    if !is_unicode_space(cp) {
      last_end = next_i
    }
    i = next_i
  }
  s.slice(start, last_end)
}

fn is_grapheme_extend(cp : Int) -> Bool {
  // Combining Diacritical Marks & common Unicode Extend / SpacingMark ranges
  (cp >= 0x0300 && cp <= 0x036F) ||
  (cp >= 0x0483 && cp <= 0x0489) ||
  (cp >= 0x0591 && cp <= 0x05BD) ||
  (cp >= 0x0610 && cp <= 0x061A) ||
  (cp >= 0x064B && cp <= 0x065F) ||
  (cp >= 0x1AB0 && cp <= 0x1AFF) ||
  (cp >= 0x1DC0 && cp <= 0x1DFF) ||
  (cp >= 0x20D0 && cp <= 0x20FF) ||
  (cp >= 0xFE00 && cp <= 0xFE0F) ||
  (cp >= 0xFE20 && cp <= 0xFE2F) ||
  (cp >= 0x1F3FB && cp <= 0x1F3FF) ||
  (cp >= 0xE0100 && cp <= 0xE01EF) ||
  cp == 0x200C
}

///| Compute starting byte offsets of every extended grapheme cluster in `s` (plus trailing `s.length()`).
pub fn grapheme_boundaries(s : String) -> Array[Int] {
  let n = s.length()
  let out : Array[Int] = []
  let mut i = 0
  let mut prev_cp = -1
  let mut prev_was_zwj = false
  let mut ri_run = 0
  while i < n {
    let (cp, next_i) = utf8_decode_at(s, i)
    let is_ri = cp >= 0x1F1E6 && cp <= 0x1F1FF
    let mut starts_new = true
    if prev_cp >= 0 {
      if prev_cp == 13 && cp == 10 {
        starts_new = false
      } else if cp == 0x200D {
        starts_new = false
      } else if prev_was_zwj {
        starts_new = false
      } else if is_grapheme_extend(cp) {
        starts_new = false
      } else if is_ri && (ri_run % 2) == 1 {
        starts_new = false
      }
    }
    if starts_new {
      out.push(i)
    }
    if is_ri {
      ri_run = ri_run + 1
    } else {
      ri_run = 0
    }
    prev_was_zwj = cp == 0x200D
    prev_cp = cp
    i = next_i
  }
  out.push(n)
  out
}

///| Count extended grapheme clusters in `s` (matches Terraform `length(string)` / `cty` `Strlen`).
pub fn utf8_grapheme_len(s : String) -> Int {
  let n = s.length()
  // Fast path: pure ASCII without CR
  let mut ascii_fast = true
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 0x80 || b == 13 {
      ascii_fast = false
      break
    }
    i = i + 1
  }
  if ascii_fast {
    return n
  }
  let bounds = grapheme_boundaries(s)
  bounds.length() - 1
}

///| Grapheme-cluster-safe, overflow-free `substr(s, offset, length)` matching Go `cty` `stdlib.SubstrFunc`.
pub fn utf8_substr(s : String, off : Int64, len : Int64) -> String {
  let n = s.length()
  if n == 0 {
    return ""
  }
  // Fast path: pure ASCII without CR
  let mut ascii_fast = true
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 0x80 || b == 13 {
      ascii_fast = false
      break
    }
    i = i + 1
  }
  if ascii_fast {
    let count = n.to_int64()
    let start = if off < 0L {
      let x = count + off
      if x < 0L { 0L } else { x }
    } else if off > count {
      count
    } else {
      off
    }
    let end = if len < 0L {
      count
    } else {
      let rem = count - start
      if len >= rem { count } else { start + len }
    }
    return s.slice(start.to_int(), end.to_int())
  }
  let bounds = grapheme_boundaries(s)
  let count = (bounds.length() - 1).to_int64()
  let start = if off < 0L {
    let x = count + off
    if x < 0L { 0L } else { x }
  } else if off > count {
    count
  } else {
    off
  }
  let end = if len < 0L {
    count
  } else {
    let rem = count - start
    if len >= rem { count } else { start + len }
  }
  s.slice(bounds[start.to_int()], bounds[end.to_int()])
}
