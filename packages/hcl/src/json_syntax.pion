///| Strict RFC 8259 JSON parser (with exact `BigDec` numbers, duplicate-key rejection,
///| and Go-compatible lone-surrogate replacement) and streaming output-budgeted JSON serializer.

///| Streamingly encode `HclValue` to canonical JSON (sorted keys), enforcing `max_bytes`
///| incrementally so amplification attacks abort immediately without blowing memory.
pub fn value_to_json_budgeted(
  v : HclValue,
  max_bytes : Int,
  html_escape : Bool,
) -> Result[String, HclError] {
  let sb = StringBuilder::new()
  let written : Array[Int] = [0]
  match write_json_val(v, sb, written, max_bytes, html_escape, 0) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

fn json_charge(written : Array[Int], add : Int, max_bytes : Int) -> Result[Unit, HclError] {
  let next = written[0] + add
  if next > max_bytes || next < written[0] {
    return Err(
      HclError::new(
        HclErrorKind::LimitExceeded,
        "JSON output exceeds max_output_bytes (" + max_bytes.to_string() + ")",
        Span::zero(),
      ),
    )
  }
  written[0] = next
  Ok(())
}

fn write_json_hex4(sb : StringBuilder, v : Int) -> Unit {
  let hex = "0123456789abcdef"
  sb.write_byte(hex.code_unit_at((v >> 12) & 0xF).to_byte())
  sb.write_byte(hex.code_unit_at((v >> 8) & 0xF).to_byte())
  sb.write_byte(hex.code_unit_at((v >> 4) & 0xF).to_byte())
  sb.write_byte(hex.code_unit_at(v & 0xF).to_byte())
}

fn write_json_string(
  s : String,
  sb : StringBuilder,
  written : Array[Int],
  max_bytes : Int,
  html_escape : Bool,
) -> Result[Unit, HclError] {
  match json_charge(written, 2, max_bytes) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      match json_charge(written, 2, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("\\\"")
      i = i + 1
    } else if b == 92 {
      match json_charge(written, 2, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("\\\\")
      i = i + 1
    } else if b == 8 {
      match json_charge(written, 2, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("\\b")
      i = i + 1
    } else if b == 12 {
      match json_charge(written, 2, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("\\f")
      i = i + 1
    } else if b == 10 {
      match json_charge(written, 2, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("\\n")
      i = i + 1
    } else if b == 13 {
      match json_charge(written, 2, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("\\r")
      i = i + 1
    } else if b == 9 {
      match json_charge(written, 2, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("\\t")
      i = i + 1
    } else if b < 0x20 || (html_escape && (b == 60 || b == 62 || b == 38)) {
      match json_charge(written, 6, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("\\u")
      write_json_hex4(sb, b)
      i = i + 1
    } else {
      // Fast run of plain unescaped bytes
      let start = i
      i = i + 1
      while i < n {
        let c = s.code_unit_at(i)
        if c < 0x20 || c == 34 || c == 92 || (html_escape && (c == 60 || c == 62 || c == 38)) {
          break
        }
        i = i + 1
      }
      let run_len = i - start
      match json_charge(written, run_len, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string(s.slice(start, i))
    }
  }
  sb.write_byte((34).to_byte())
  Ok(())
}

fn write_json_val(
  v : HclValue,
  sb : StringBuilder,
  written : Array[Int],
  max_bytes : Int,
  html_escape : Bool,
  depth : Int,
) -> Result[Unit, HclError] {
  if depth > 256 {
    return Err(HclError::new(HclErrorKind::LimitExceeded, "JSON encoding nesting depth exceeded", Span::zero()))
  }
  match v {
    HclValue::Null => {
      match json_charge(written, 4, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("null")
      Ok(())
    }
    HclValue::Bool(b) => {
      let s = if b { "true" } else { "false" }
      match json_charge(written, s.length(), max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string(s)
      Ok(())
    }
    HclValue::Number(d) => {
      let s = hcl_number_to_string(d)
      match json_charge(written, s.length(), max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string(s)
      Ok(())
    }
    HclValue::Decimal(bd) => {
      let s = bd.to_string()
      match json_charge(written, s.length(), max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string(s)
      Ok(())
    }
    HclValue::Str(s) => write_json_string(s, sb, written, max_bytes, html_escape)
    HclValue::Tuple(xs) => {
      match json_charge(written, 2, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_byte((91).to_byte())
      let mut i = 0
      while i < xs.length() {
        if i > 0 {
          match json_charge(written, 1, max_bytes) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          sb.write_byte((44).to_byte())
        }
        match write_json_val(xs[i], sb, written, max_bytes, html_escape, depth + 1) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      sb.write_byte((93).to_byte())
      Ok(())
    }
    HclValue::Object(entries) => {
      let sorted = sort_entries_by_key(entries)
      match json_charge(written, 2, max_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_byte((123).to_byte())
      let mut i = 0
      while i < sorted.length() {
        if i > 0 {
          match json_charge(written, 1, max_bytes) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          sb.write_byte((44).to_byte())
        }
        let (k, item_v) = sorted[i]
        match write_json_string(k, sb, written, max_bytes, html_escape) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match json_charge(written, 1, max_bytes) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        sb.write_byte((58).to_byte())
        match write_json_val(item_v, sb, written, max_bytes, html_escape, depth + 1) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      sb.write_byte((125).to_byte())
      Ok(())
    }
  }
}

// ---------------------------------------------------------------------------
// Strict RFC 8259 JSON parser preserving exact `BigDec` numbers, rejecting
// duplicate keys (when configured), and decoding lone surrogates to U+FFFD
// (matching Go `encoding/json` and `hashicorp/hcl/v2/json`).
// ---------------------------------------------------------------------------

struct StrictJsonParser {
  src : String
  len : Int
  mut pos : Int
  max_depth : Int
  reject_dup_keys : Bool
}

fn StrictJsonParser::skip_ws(self : StrictJsonParser) -> Unit {
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
}

fn StrictJsonParser::parse_hex4(self : StrictJsonParser) -> Option[Int] {
  if self.pos + 4 > self.len {
    return None
  }
  let mut v = 0
  let mut i = 0
  while i < 4 {
    let h = hcl_hex_val(self.src.code_unit_at(self.pos + i))
    if h < 0 {
      return None
    }
    v = (v << 4) | h
    i = i + 1
  }
  self.pos = self.pos + 4
  Some(v)
}

fn StrictJsonParser::parse_string(self : StrictJsonParser) -> Result[String, HclError] {
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 34 {
    return Err(HclError::new(HclErrorKind::SyntaxError, "expected JSON string", Span::zero()))
  }
  self.pos = self.pos + 1
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 34 {
      self.pos = self.pos + 1
      return Ok(sb.to_string())
    }
    if b < 0x20 {
      return Err(HclError::new(HclErrorKind::SyntaxError, "unescaped control char in JSON string", Span::zero()))
    }
    if b == 92 {
      self.pos = self.pos + 1
      if self.pos >= self.len {
        return Err(HclError::new(HclErrorKind::SyntaxError, "unterminated escape in JSON string", Span::zero()))
      }
      let e = self.src.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if e == 34 {
        sb.write_byte((34).to_byte())
      } else if e == 92 {
        sb.write_byte((92).to_byte())
      } else if e == 47 {
        sb.write_byte((47).to_byte())
      } else if e == 98 {
        sb.write_byte((8).to_byte())
      } else if e == 102 {
        sb.write_byte((12).to_byte())
      } else if e == 110 {
        sb.write_byte((10).to_byte())
      } else if e == 114 {
        sb.write_byte((13).to_byte())
      } else if e == 116 {
        sb.write_byte((9).to_byte())
      } else if e == 117 {
        let u1 = match self.parse_hex4() {
          Some(x) => x
          None => return Err(HclError::new(HclErrorKind::SyntaxError, "invalid \\u escape in JSON", Span::zero()))
        }
        if u1 >= 0xD800 && u1 <= 0xDBFF {
          // High surrogate: check for following \uXXXX low surrogate
          if self.pos + 6 <= self.len && self.src.code_unit_at(self.pos) == 92 && self.src.code_unit_at(self.pos + 1) == 117 {
            let saved = self.pos
            self.pos = self.pos + 2
            match self.parse_hex4() {
              Some(u2) => {
                if u2 >= 0xDC00 && u2 <= 0xDFFF {
                  let cp = 0x10000 + ((u1 - 0xD800) << 10) + (u2 - 0xDC00)
                  utf8_write_cp(sb, cp)
                } else {
                  self.pos = saved
                  utf8_write_cp(sb, 0xFFFD)
                }
              }
              None => {
                self.pos = saved
                utf8_write_cp(sb, 0xFFFD)
              }
            }
          } else {
            // Lone high surrogate -> U+FFFD (matches Go encoding/json)
            utf8_write_cp(sb, 0xFFFD)
          }
        } else if u1 >= 0xDC00 && u1 <= 0xDFFF {
          // Lone low surrogate -> U+FFFD
          utf8_write_cp(sb, 0xFFFD)
        } else {
          utf8_write_cp(sb, u1)
        }
      } else {
        return Err(HclError::new(HclErrorKind::SyntaxError, "invalid escape in JSON string", Span::zero()))
      }
    } else {
      let start = self.pos
      self.pos = self.pos + 1
      while self.pos < self.len {
        let c = self.src.code_unit_at(self.pos)
        if c == 34 || c == 92 || c < 0x20 {
          break
        }
        self.pos = self.pos + 1
      }
      sb.write_string(self.src.slice(start, self.pos))
    }
  }
  Err(HclError::new(HclErrorKind::SyntaxError, "unterminated JSON string", Span::zero()))
}

fn StrictJsonParser::parse_number(self : StrictJsonParser) -> Result[HclValue, HclError] {
  let start = self.pos
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 45 {
    self.pos = self.pos + 1
  }
  if self.pos >= self.len {
    return Err(HclError::new(HclErrorKind::SyntaxError, "invalid JSON number", Span::zero()))
  }
  let first = self.src.code_unit_at(self.pos)
  if first == 48 {
    self.pos = self.pos + 1
    // RFC 8259 forbids leading zeros like 01
    if self.pos < self.len && is_hcl_digit(self.src.code_unit_at(self.pos)) {
      return Err(HclError::new(HclErrorKind::SyntaxError, "leading zero in JSON number", Span::zero()))
    }
  } else if first >= 49 && first <= 57 {
    self.pos = self.pos + 1
    while self.pos < self.len && is_hcl_digit(self.src.code_unit_at(self.pos)) {
      self.pos = self.pos + 1
    }
  } else {
    return Err(HclError::new(HclErrorKind::SyntaxError, "invalid JSON number", Span::zero()))
  }
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 46 {
    self.pos = self.pos + 1
    if self.pos >= self.len || !is_hcl_digit(self.src.code_unit_at(self.pos)) {
      return Err(HclError::new(HclErrorKind::SyntaxError, "invalid JSON number fraction", Span::zero()))
    }
    while self.pos < self.len && is_hcl_digit(self.src.code_unit_at(self.pos)) {
      self.pos = self.pos + 1
    }
  }
  if self.pos < self.len && (self.src.code_unit_at(self.pos) == 101 || self.src.code_unit_at(self.pos) == 69) {
    self.pos = self.pos + 1
    if self.pos < self.len && (self.src.code_unit_at(self.pos) == 43 || self.src.code_unit_at(self.pos) == 45) {
      self.pos = self.pos + 1
    }
    if self.pos >= self.len || !is_hcl_digit(self.src.code_unit_at(self.pos)) {
      return Err(HclError::new(HclErrorKind::SyntaxError, "invalid JSON number exponent", Span::zero()))
    }
    while self.pos < self.len && is_hcl_digit(self.src.code_unit_at(self.pos)) {
      self.pos = self.pos + 1
    }
  }
  let raw = self.src.slice(start, self.pos)
  match BigDec::parse(raw) {
    Some(bd) => Ok(HclValue::Decimal(bd))
    None => Err(HclError::new(HclErrorKind::SyntaxError, "invalid JSON number: " + raw, Span::zero()))
  }
}

fn StrictJsonParser::parse_value(self : StrictJsonParser, depth : Int) -> Result[HclValue, HclError] {
  if depth > self.max_depth {
    return Err(HclError::new(HclErrorKind::LimitExceeded, "maximum JSON nesting depth exceeded", Span::zero()))
  }
  self.skip_ws()
  if self.pos >= self.len {
    return Err(HclError::new(HclErrorKind::SyntaxError, "unexpected end of JSON input", Span::zero()))
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 34 {
    match self.parse_string() {
      Ok(s) => Ok(HclValue::Str(s))
      Err(e) => Err(e)
    }
  } else if b == 123 {
    self.pos = self.pos + 1
    self.skip_ws()
    let entries : Array[(String, HclValue)] = []
    if self.pos < self.len && self.src.code_unit_at(self.pos) == 125 {
      self.pos = self.pos + 1
      return Ok(HclValue::Object(entries))
    }
    while true {
      self.skip_ws()
      let key = match self.parse_string() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      self.skip_ws()
      if self.pos >= self.len || self.src.code_unit_at(self.pos) != 58 {
        return Err(HclError::new(HclErrorKind::SyntaxError, "expected `:` in JSON object", Span::zero()))
      }
      self.pos = self.pos + 1
      let jval = match self.parse_value(depth + 1) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let mut found = -1
      let mut j = 0
      while j < entries.length() {
        if entries[j].0 == key {
          found = j
          break
        }
        j = j + 1
      }
      if found >= 0 {
        if self.reject_dup_keys && key != "//" {
          return Err(
            HclError::new(HclErrorKind::DuplicateAttribute, "duplicate JSON key `" + key + "`", Span::zero()),
          )
        }
        entries[found] = (key, jval)
      } else {
        entries.push((key, jval))
      }
      self.skip_ws()
      if self.pos >= self.len {
        return Err(HclError::new(HclErrorKind::SyntaxError, "unterminated JSON object", Span::zero()))
      }
      let sep = self.src.code_unit_at(self.pos)
      if sep == 44 {
        self.pos = self.pos + 1
      } else if sep == 125 {
        self.pos = self.pos + 1
        return Ok(HclValue::Object(entries))
      } else {
        return Err(HclError::new(HclErrorKind::SyntaxError, "expected `,` or `}` in JSON object", Span::zero()))
      }
    }
    Ok(HclValue::Object(entries))
  } else if b == 91 {
    self.pos = self.pos + 1
    self.skip_ws()
    let items : Array[HclValue] = []
    if self.pos < self.len && self.src.code_unit_at(self.pos) == 93 {
      self.pos = self.pos + 1
      return Ok(HclValue::Tuple(items))
    }
    while true {
      let item = match self.parse_value(depth + 1) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      items.push(item)
      self.skip_ws()
      if self.pos >= self.len {
        return Err(HclError::new(HclErrorKind::SyntaxError, "unterminated JSON array", Span::zero()))
      }
      let sep = self.src.code_unit_at(self.pos)
      if sep == 44 {
        self.pos = self.pos + 1
      } else if sep == 93 {
        self.pos = self.pos + 1
        return Ok(HclValue::Tuple(items))
      } else {
        return Err(HclError::new(HclErrorKind::SyntaxError, "expected `,` or `]` in JSON array", Span::zero()))
      }
    }
    Ok(HclValue::Tuple(items))
  } else if b == 116 {
    if self.pos + 4 <= self.len && self.src.slice(self.pos, self.pos + 4) == "true" {
      self.pos = self.pos + 4
      Ok(HclValue::Bool(true))
    } else {
      Err(HclError::new(HclErrorKind::SyntaxError, "invalid JSON token", Span::zero()))
    }
  } else if b == 102 {
    if self.pos + 5 <= self.len && self.src.slice(self.pos, self.pos + 5) == "false" {
      self.pos = self.pos + 5
      Ok(HclValue::Bool(false))
    } else {
      Err(HclError::new(HclErrorKind::SyntaxError, "invalid JSON token", Span::zero()))
    }
  } else if b == 110 {
    if self.pos + 4 <= self.len && self.src.slice(self.pos, self.pos + 4) == "null" {
      self.pos = self.pos + 4
      Ok(HclValue::Null)
    } else {
      Err(HclError::new(HclErrorKind::SyntaxError, "invalid JSON token", Span::zero()))
    }
  } else if b == 45 || is_hcl_digit(b) {
    self.parse_number()
  } else {
    Err(HclError::new(HclErrorKind::SyntaxError, "unexpected character in JSON", Span::zero()))
  }
}

///| Parse strict RFC 8259 JSON into `HclValue` with exact `BigDec` numbers.
pub fn parse_strict_json_value(
  src : String,
  max_depth : Int,
  reject_dup_keys : Bool,
) -> Result[HclValue, HclError] {
  let eff_depth = if max_depth > 256 { 256 } else if max_depth < 1 { 1 } else { max_depth }
  let p = StrictJsonParser::{
    src: src,
    len: src.length(),
    pos: 0,
    max_depth: eff_depth,
    reject_dup_keys: reject_dup_keys,
  }
  let v = match p.parse_value(0) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  p.skip_ws()
  if p.pos != p.len {
    return Err(HclError::new(HclErrorKind::SyntaxError, "unexpected trailing data in JSON", Span::zero()))
  }
  Ok(v)
}
