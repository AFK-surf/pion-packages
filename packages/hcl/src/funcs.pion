    if args.length() < 1 || args.length() > 3 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "range() expects 1 to 3 arguments", span))
    }
    let mut start = BigDec::zero()
    let mut limit = BigDec::zero()
    let mut step = BigDec::one()
    if args.length() == 1 {
      limit = match hcl_to_bigdec(args[0], span) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if args.length() == 2 {
      start = match hcl_to_bigdec(args[0], span) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      limit = match hcl_to_bigdec(args[1], span) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if BigDec::cmp(start, limit) > 0 {
        step = BigDec::one().negate()
      }
    } else {
      start = match hcl_to_bigdec(args[0], span) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      limit = match hcl_to_bigdec(args[1], span) {
