    }
    let s = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Str(s)))
  }
  if name == "tonumber" {
    if args.length() != 1 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "tonumber() expects 1 argument", span))
    }
    match args[0] {
      HclValue::Null => return Ok(Some(HclValue::Null))
      _ => ()
    }
    let bd = match hcl_to_bigdec(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Decimal(bd)))
  }
  if name == "tobool" {
    if args.length() != 1 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "tobool() expects 1 argument", span))
    }
    let b = match hcl_to_bool(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Bool(b)))
  }
  if name == "tolist" {
    if args.length() != 1 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "tolist() expects 1 argument", span))
    }
    match args[0] {
      HclValue::Tuple(xs) => return Ok(Some(HclValue::Tuple(xs)))
      _ => return Err(HclError::new(HclErrorKind::TypeError, "tolist() expects a list/tuple", span))
    }
  }
  if name == "tomap" {
    if args.length() != 1 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "tomap() expects 1 argument", span))
    }
    match args[0] {
      HclValue::Object(entries) => return Ok(Some(HclValue::Object(entries)))
      _ => return Err(HclError::new(HclErrorKind::TypeError, "tomap() expects an object/map", span))
    }
  }
  Ok(None)
}
