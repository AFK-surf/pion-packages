          let mut j = 0
          while j < out.length() {
            if value_eq(xs[i], out[j]) {
              seen = true
              break
            }
            j = j + 1
          }
          if !seen {
            out.push(xs[i])
          }
          i = i + 1
        }
        return Ok(Some(HclValue::Tuple(out)))
      }
      _ => return Err(HclError::new(HclErrorKind::TypeError, "distinct() expects a list", span))
