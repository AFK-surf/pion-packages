    while a < args.length() {
      match args[a] {
        HclValue::Tuple(xs) => {
          let mut i = 0
          while i < xs.length() {
            let part = match hcl_to_string(xs[i], span) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            if !first {
              total_bytes = total_bytes + sep.length()
              if total_bytes > limits.max_output_bytes {
                return Err(
                  HclError::new(HclErrorKind::LimitExceeded, "join() output exceeds max_output_bytes", span),
                )
              }
              sb.write_string(sep)
            }
            total_bytes = total_bytes + part.length()
            if total_bytes > limits.max_output_bytes {
              return Err(
                HclError::new(HclErrorKind::LimitExceeded, "join() output exceeds max_output_bytes", span),
              )
            }
            sb.write_string(part)
            first = false
            i = i + 1
          }
        }
        _ => return Err(HclError::new(HclErrorKind::TypeError, "join() expects list arguments", span))
