      return Err(HclError::new(HclErrorKind::InvalidArgument, "range() step cannot be 0", span))
    }
    let out : Array[HclValue] = []
    let mut cur = start
    let max_items = if limits.max_steps < 100000L { limits.max_steps.to_int() } else { 100000 }
    let step_pos = !step.neg
    while (step_pos && BigDec::cmp(cur, limit) < 0) || (!step_pos && BigDec::cmp(cur, limit) > 0) {
      if out.length() >= max_items {
        return Err(HclError::new(HclErrorKind::LimitExceeded, "range() size exceeds safety limit", span))
      }
      out.push(HclValue::Decimal(cur))
      cur = BigDec::add(cur, step)
