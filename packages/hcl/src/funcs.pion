///| 40+ Terraform/HCL2 built-in functions and deterministic JSON serialization.

import "json5"

///| Convert `HclValue` to canonical `json5::Json5Value` with lexicographically sorted object keys.
pub fn hcl_to_json5_sorted(v : HclValue) -> json5::Json5Value {
  match v {
    HclValue::Null => json5::Json5Value::Null
    HclValue::Bool(b) => json5::Json5Value::Bool(b)
    HclValue::Number(d) => json5::Json5Value::Number(d)
    HclValue::Decimal(bd) => json5::Json5Value::Number(bd.to_double())
    HclValue::Str(s) => json5::Json5Value::Str(s)
    HclValue::Tuple(xs) => {
      let out : Array[json5::Json5Value] = []
      let mut i = 0
      while i < xs.length() {
        out.push(hcl_to_json5_sorted(xs[i]))
        i = i + 1
      }
      json5::Json5Value::Array(out)
    }
    HclValue::Object(entries) => {
      let sorted = sort_entries_by_key(entries)
      let out : Array[(String, json5::Json5Value)] = []
      let mut i = 0
      while i < sorted.length() {
        let (k, item_v) = sorted[i]
        out.push((k, hcl_to_json5_sorted(item_v)))
        i = i + 1
      }
      json5::Json5Value::Object(out)
    }
  }
}

///| Convert `json5::Json5Value` into `HclValue`.
pub fn json5_to_hcl(v : json5::Json5Value) -> HclValue {
  match v {
    json5::Json5Value::Null => HclValue::Null
    json5::Json5Value::Bool(b) => HclValue::Bool(b)
    json5::Json5Value::Number(d) => HclValue::Number(d)
    json5::Json5Value::Str(s) => HclValue::Str(s)
    json5::Json5Value::Array(xs) => {
      let out : Array[HclValue] = []
      let mut i = 0
      while i < xs.length() {
        out.push(json5_to_hcl(xs[i]))
        i = i + 1
      }
      HclValue::Tuple(out)
    }
    json5::Json5Value::Object(entries) => {
      let out : Array[(String, HclValue)] = []
      let mut i = 0
      while i < entries.length() {
        let (k, item_v) = entries[i]
        out.push((k, json5_to_hcl(item_v)))
        i = i + 1
      }
      HclValue::Object(out)
    }
  }
}

///| Deterministic canonical JSON serialization (keys sorted lexicographically).
pub fn value_to_json_impl(v : HclValue) -> Result[String, HclError] {
  value_to_json_budgeted(v, HclLimits::default().max_output_bytes, false)
}

///| Lexicographical string comparison (`a < b`).
pub fn str_lt(a : String, b : String) -> Bool {
  let na = a.length()
  let nb = b.length()
  let m = if na < nb { na } else { nb }
  let mut i = 0
  while i < m {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    if ca != cb {
      return ca < cb
    }
    i = i + 1
  }
  na < nb
}

///| Sort object entries by key (insertion/merge hybrid; fast for typical HCL objects).
pub fn sort_entries_by_key(entries : Array[(String, HclValue)]) -> Array[(String, HclValue)] {
  let n = entries.length()
  let out : Array[(String, HclValue)] = []
  let mut i = 0
  while i < n {
    out.push(entries[i])
    i = i + 1
  }
  if n <= 1 {
    return out
  }
  // Bottom-up merge sort for O(n log n) guaranteed performance
  let buf : Array[(String, HclValue)] = []
  i = 0
  while i < n {
    buf.push(out[i])
    i = i + 1
  }
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + 2 * width < n { left + 2 * width } else { n }
      let mut l = left
      let mut r = mid
      let mut k = left
      while l < mid && r < right {
        if str_lt(out[r].0, out[l].0) {
          buf[k] = out[r]
          r = r + 1
        } else {
          buf[k] = out[l]
          l = l + 1
        }
        k = k + 1
      }
      while l < mid {
        buf[k] = out[l]
        l = l + 1
        k = k + 1
      }
      while r < right {
        buf[k] = out[r]
        r = r + 1
        k = k + 1
      }
      let mut c = left
      while c < right {
        out[c] = buf[c]
        c = c + 1
      }
      left = left + 2 * width
    }
    width = width * 2
  }
  out
}

fn sort_strings(xs : Array[String]) -> Array[String] {
  let n = xs.length()
  let out : Array[String] = []
  let mut i = 0
  while i < n {
    out.push(xs[i])
    i = i + 1
  }
  if n <= 1 {
    return out
  }
  let buf : Array[String] = []
  i = 0
  while i < n {
    buf.push(out[i])
    i = i + 1
  }
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + 2 * width < n { left + 2 * width } else { n }
      let mut l = left
      let mut r = mid
      let mut k = left
      while l < mid && r < right {
        if str_lt(out[r], out[l]) {
          buf[k] = out[r]
          r = r + 1
        } else {
          buf[k] = out[l]
          l = l + 1
        }
        k = k + 1
      }
      while l < mid {
        buf[k] = out[l]
        l = l + 1
        k = k + 1
      }
      while r < right {
        buf[k] = out[r]
        r = r + 1
        k = k + 1
      }
      let mut c = left
      while c < right {
        out[c] = buf[c]
        c = c + 1
      }
      left = left + 2 * width
    }
    width = width * 2
  }
  out
}

///| Format an HCL `Double` as string safely without out-of-range integer traps.
pub fn hcl_number_to_string(d : Double) -> String {
  if d == 0.0 {
    return "0"
  }
  if d >= -9007199254740992.0 && d <= 9007199254740992.0 {
    let i64 = d.to_int64()
    if i64.to_double() == d {
      return i64.to_string()
    }
  }
  BigDec::from_double(d).to_string()
}

///| Coerce an HCL primitive value to string (for templates and string functions).
pub fn hcl_to_string(v : HclValue, span : Span) -> Result[String, HclError] {
  match v {
    HclValue::Str(s) => Ok(s)
    HclValue::Bool(b) => Ok(if b { "true" } else { "false" })
    HclValue::Number(d) => Ok(hcl_number_to_string(d))
    HclValue::Decimal(bd) => Ok(bd.to_string())
    HclValue::Null =>
    Err(HclError::new(HclErrorKind::TypeError, "cannot convert null to string", span))
    _ =>
    Err(
      HclError::new(
        HclErrorKind::TypeError,
        "cannot convert collection/object to string",
        span,
      ),
    )
  }
}

///| Coerce an HCL value to an exact `BigDec`.
pub fn hcl_to_bigdec(v : HclValue, span : Span) -> Result[BigDec, HclError] {
  match v {
    HclValue::Decimal(bd) => Ok(bd)
    HclValue::Number(d) => Ok(BigDec::from_double(d))
    HclValue::Str(s) => {
      match BigDec::parse(s) {
        Some(bd) => Ok(bd)
        None => Err(HclError::new(HclErrorKind::TypeError, "cannot convert string to number: " + s, span))
      }
    }
    _ => Err(HclError::new(HclErrorKind::TypeError, "expected number", span))
  }
}

fn hcl_to_bool(v : HclValue, span : Span) -> Result[Bool, HclError] {
  match v {
    HclValue::Bool(b) => Ok(b)
    HclValue::Str(s) => {
      if s == "true" {
        Ok(true)
      } else if s == "false" {
        Ok(false)
      } else {
        Err(HclError::new(HclErrorKind::TypeError, "cannot convert string to bool", span))
      }
    }
    _ => Err(HclError::new(HclErrorKind::TypeError, "expected bool", span))
  }
}

fn utf8_codepoint_len(s : String) -> Int {
  let n = s.length()
  let mut count = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    // Count non-continuation bytes ((b & 0xC0) != 0x80)
    if (b & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

fn ascii_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn ascii_upper(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 97 && b <= 122 {
      sb.write_byte((b - 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn is_ws_byte(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

fn str_contains_byte(cutset : String, b : Int) -> Bool {
  let mut i = 0
  while i < cutset.length() {
    if cutset.code_unit_at(i) == b {
      return true
    }
    i = i + 1
  }
  false
}

fn str_trim_cutset(s : String, cutset : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n && str_contains_byte(cutset, s.code_unit_at(start)) {
    start = start + 1
  }
  let mut end = n
  while end > start && str_contains_byte(cutset, s.code_unit_at(end - 1)) {
    end = end - 1
  }
  s.slice(start, end)
}

fn str_trimspace(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n && is_ws_byte(s.code_unit_at(start)) {
    start = start + 1
  }
  let mut end = n
  while end > start && is_ws_byte(s.code_unit_at(end - 1)) {
    end = end - 1
  }
  s.slice(start, end)
}

fn str_starts_with(s : String, prefix : String) -> Bool {
  let pn = prefix.length()
  if pn > s.length() {
    return false
  }
  let mut i = 0
  while i < pn {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_ends_with(s : String, suffix : String) -> Bool {
  let sn = suffix.length()
  let n = s.length()
  if sn > n {
    return false
  }
  let off = n - sn
  let mut i = 0
  while i < sn {
    if s.code_unit_at(off + i) != suffix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_split(sep : String, s : String) -> Array[HclValue] {
  let out : Array[HclValue] = []
  let n = s.length()
  let sn = sep.length()
  if sn == 0 {
    let mut i = 0
    while i < n {
      out.push(HclValue::Str(s.slice(i, i + 1)))
      i = i + 1
    }
    return out
  }
  let mut start = 0
  let mut i = 0
  while i + sn <= n {
    let mut matched = true
    let mut j = 0
    while j < sn {
      if s.code_unit_at(i + j) != sep.code_unit_at(j) {
        matched = false
        break
      }
      j = j + 1
    }
    if matched {
      out.push(HclValue::Str(s.slice(start, i)))
      i = i + sn
      start = i
    } else {
      i = i + 1
    }
  }
  out.push(HclValue::Str(s.slice(start, n)))
  out
}

fn str_replace(s : String, old_s : String, new_s : String) -> String {
  let on = old_s.length()
  if on == 0 {
    return s
  }
  let n = s.length()
  let sb = StringBuilder::new()
  let mut start = 0
  let mut i = 0
  while i + on <= n {
    let mut matched = true
    let mut j = 0
    while j < on {
      if s.code_unit_at(i + j) != old_s.code_unit_at(j) {
        matched = false
        break
      }
      j = j + 1
    }
    if matched {
      if i > start {
        sb.write_string(s.slice(start, i))
      }
      sb.write_string(new_s)
      i = i + on
      start = i
    } else {
      i = i + 1
    }
  }
  if start < n {
    sb.write_string(s.slice(start, n))
  }
  sb.to_string()
}

fn fn_format(fmt : String, args : Array[HclValue], max_bytes : Int, span : Span) -> Result[String, HclError] {
  let sb = StringBuilder::new()
  let n = fmt.length()
  let mut i = 0
  let mut arg_idx = 0
  let mut written = 0
  while i < n {
    let b = fmt.code_unit_at(i)
    if b != 37 {
      sb.write_byte(b.to_byte())
      written = written + 1
      if written > max_bytes {
        return Err(HclError::new(HclErrorKind::LimitExceeded, "format() output exceeds limit", span))
      }
      i = i + 1
      continue
    }
    if i + 1 >= n {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "trailing `%` in format string", span))
    }
    let next = fmt.code_unit_at(i + 1)
    if next == 37 {
      sb.write_byte((37).to_byte())
      written = written + 1
      i = i + 2
      continue
    }
    // Parse optional flags (-, 0, +, space), width, and .precision
    let mut j = i + 1
    let mut left_align = false
    let mut zero_pad = false
    while j < n {
      let fc = fmt.code_unit_at(j)
      if fc == 45 {
        left_align = true
        j = j + 1
      } else if fc == 48 {
        zero_pad = true
        j = j + 1
      } else if fc == 43 || fc == 32 {
        j = j + 1
      } else {
        break
      }
    }
    let mut width = 0
    while j < n && is_hcl_digit(fmt.code_unit_at(j)) {
      if width < 100000 {
        width = width * 10 + (fmt.code_unit_at(j) - 48)
      }
      j = j + 1
    }
    let mut has_prec = false
    let mut prec = 0
    if j < n && fmt.code_unit_at(j) == 46 {
      has_prec = true
      j = j + 1
      while j < n && is_hcl_digit(fmt.code_unit_at(j)) {
        if prec < 1000 {
          prec = prec * 10 + (fmt.code_unit_at(j) - 48)
        }
        j = j + 1
      }
    }
    if j >= n {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "incomplete format verb", span))
    }
    let verb = fmt.code_unit_at(j)
    i = j + 1
    if arg_idx >= args.length() {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "not enough arguments for format", span))
    }
    let v = args[arg_idx]
    arg_idx = arg_idx + 1
    let piece = if verb == 115 || verb == 118 {
      // %s or %v
      match hcl_to_string(v, span) {
        Ok(s) => s
        Err(_) => {
          match value_to_json_budgeted(v, max_bytes, false) {
            Ok(js) => js
            Err(e) => return Err(e)
          }
        }
      }
    } else if verb == 100 {
      // %d: requires whole integer (no fractional part)
      let bd = match hcl_to_bigdec(v, span) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      if !bd.is_integer() {
        return Err(HclError::new(HclErrorKind::InvalidArgument, "%d requires an integer value", span))
      }
      bd.to_string()
    } else if verb == 102 {
      // %f
      let bd = match hcl_to_bigdec(v, span) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      if has_prec {
        bd.to_fixed_string(prec)
      } else {
        bd.to_string()
      }
    } else if verb == 116 {
      // %t
      let bv = match hcl_to_bool(v, span) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      if bv { "true" } else { "false" }
    } else if verb == 113 {
      // %q
      let sv = match hcl_to_string(v, span) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      match value_to_json_budgeted(HclValue::Str(sv), max_bytes, false) {
        Ok(js) => js
        Err(_) => "\"" + sv + "\""
      }
    } else {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "unsupported format verb", span))
    }
    let pad_len = if width > piece.length() { width - piece.length() } else { 0 }
    written = written + piece.length() + pad_len
    if written > max_bytes {
      return Err(HclError::new(HclErrorKind::LimitExceeded, "format() output exceeds limit", span))
    }
    if left_align {
      sb.write_string(piece)
      let mut p = 0
      while p < pad_len {
        sb.write_byte((32).to_byte())
        p = p + 1
      }
    } else {
      let pad_ch = if zero_pad { (48).to_byte() } else { (32).to_byte() }
      let mut p = 0
      while p < pad_len {
        sb.write_byte(pad_ch)
        p = p + 1
      }
      sb.write_string(piece)
    }
  }
  Ok(sb.to_string())
}

fn flatten_into(xs : Array[HclValue], out : Array[HclValue], max_depth : Int, depth : Int, span : Span) -> Result[Unit, HclError] {
  if depth > hcl_effective_max_depth(max_depth) {
    return Err(HclError::new(HclErrorKind::LimitExceeded, "flatten depth limit exceeded", span))
  }
  let mut i = 0
  while i < xs.length() {
    match xs[i] {
      HclValue::Tuple(sub) => {
        match flatten_into(sub, out, max_depth, depth + 1, span) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      other => out.push(other)
    }
    i = i + 1
  }
  Ok(())
}

///| Dispatch all standard HCL2 / Terraform built-in functions (except lazy `try`/`can`).
pub fn call_builtin_func(
  name : String,
  args : Array[HclValue],
  limits : HclLimits,
  span : Span,
) -> Result[Option[HclValue], HclError] {
  if name == "lower" {
    if args.length() != 1 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "lower() expects 1 argument", span))
    }
    let s = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Str(unicode_lower(s))))
  }
  if name == "upper" {
    if args.length() != 1 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "upper() expects 1 argument", span))
    }
    let s = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Str(unicode_upper(s))))
  }
  if name == "trim" {
    if args.length() != 2 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "trim() expects 2 arguments", span))
    }
    let s = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let cutset = match hcl_to_string(args[1], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Str(str_trim_cutset(s, cutset))))
  }
  if name == "trimspace" {
    if args.length() != 1 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "trimspace() expects 1 argument", span))
    }
    let s = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Str(unicode_trimspace(s))))
  }
  if name == "trimprefix" {
    if args.length() != 2 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "trimprefix() expects 2 arguments", span))
    }
    let s = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let p = match hcl_to_string(args[1], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let out = if str_starts_with(s, p) { s.slice(p.length(), s.length()) } else { s }
    return Ok(Some(HclValue::Str(out)))
  }
  if name == "trimsuffix" {
    if args.length() != 2 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "trimsuffix() expects 2 arguments", span))
    }
    let s = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let suf = match hcl_to_string(args[1], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let out = if str_ends_with(s, suf) { s.slice(0, s.length() - suf.length()) } else { s }
    return Ok(Some(HclValue::Str(out)))
  }
  if name == "startswith" {
    if args.length() != 2 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "startswith() expects 2 arguments", span))
    }
    let s = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let p = match hcl_to_string(args[1], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Bool(str_starts_with(s, p))))
  }
  if name == "endswith" {
    if args.length() != 2 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "endswith() expects 2 arguments", span))
    }
    let s = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let suf = match hcl_to_string(args[1], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Bool(str_ends_with(s, suf))))
  }
  if name == "split" {
    if args.length() != 2 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "split() expects 2 arguments", span))
    }
    let sep = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let s = match hcl_to_string(args[1], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(HclValue::Tuple(str_split(sep, s))))
  }
  if name == "join" {
    if args.length() < 2 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "join() expects at least 2 arguments", span))
    }
    let sep = match hcl_to_string(args[0], span) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let sb = StringBuilder::new()
