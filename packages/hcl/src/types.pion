///| Core public types, spans, errors, limits, values, and evaluation context for `hcl` (HCL2).

///| 1-based line/column and 0-based byte offset in source text.
pub struct Pos {
  pub line : Int
  pub column : Int
  pub offset : Int
}

///|
pub fn Pos::new(line : Int, column : Int, offset : Int) -> Pos {
  Pos::{ line: line, column: column, offset: offset }
}

///|
pub fn Pos::zero() -> Pos {
  Pos::{ line: 1, column: 1, offset: 0 }
}

///| Half-open source span `[start, end)`.
pub struct Span {
  pub start : Pos
  pub end : Pos
}

///|
pub fn Span::new(start : Pos, end : Pos) -> Span {
  Span::{ start: start, end: end }
}

///|
pub fn Span::zero() -> Span {
  Span::{ start: Pos::zero(), end: Pos::zero() }
}

///| Categorized HCL2 error kinds.
pub enum HclErrorKind {
  SyntaxError
  DuplicateAttribute
  EvalError
  TypeError
  UnknownVariable
  UnknownFunction
  InvalidArgument
  DivisionByZero
  IndexOutOfBounds
  MissingKey
  DuplicateKey
  LimitExceeded
  Unimplemented
}

///|
pub fn error_kind_as_str(kind : HclErrorKind) -> String {
  match kind {
    HclErrorKind::SyntaxError => "SyntaxError"
    HclErrorKind::DuplicateAttribute => "DuplicateAttribute"
    HclErrorKind::EvalError => "EvalError"
    HclErrorKind::TypeError => "TypeError"
    HclErrorKind::UnknownVariable => "UnknownVariable"
    HclErrorKind::UnknownFunction => "UnknownFunction"
    HclErrorKind::InvalidArgument => "InvalidArgument"
    HclErrorKind::DivisionByZero => "DivisionByZero"
    HclErrorKind::IndexOutOfBounds => "IndexOutOfBounds"
    HclErrorKind::MissingKey => "MissingKey"
    HclErrorKind::DuplicateKey => "DuplicateKey"
    HclErrorKind::LimitExceeded => "LimitExceeded"
    HclErrorKind::Unimplemented => "Unimplemented"
  }
}

///|
pub fn error_kind_eq(a : HclErrorKind, b : HclErrorKind) -> Bool {
  error_kind_as_str(a) == error_kind_as_str(b)
}

///| Structured HCL2 diagnostic with kind, message, and source span.
pub struct HclError {
  pub kind : HclErrorKind
  pub message : String
  pub span : Span
}

///|
pub fn HclError::new(kind : HclErrorKind, message : String, span : Span) -> HclError {
  HclError::{ kind: kind, message: message, span: span }
}

///|
pub fn HclError::unimplemented(what : String) -> HclError {
  HclError::{
    kind: HclErrorKind::Unimplemented,
    message: "not implemented: " + what,
    span: Span::zero(),
  }
}

///|
pub fn HclError::is_kind(self : HclError, expected : HclErrorKind) -> Bool {
  error_kind_eq(self.kind, expected)
}

///|
pub fn HclError::to_string(self : HclError) -> String {
  let sb = StringBuilder::new()
  sb.write_string(error_kind_as_str(self.kind))
  sb.write_string(" at ")
  sb.write_string(self.span.start.line.to_string())
  sb.write_string(":")
  sb.write_string(self.span.start.column.to_string())
  sb.write_string(": ")
  sb.write_string(self.message)
  sb.to_string()
}

///| Safety budgets protecting parser, evaluator, and formatter against DoS inputs.
pub struct HclLimits {
  pub max_depth : Int
  pub max_steps : Int64
  pub max_output_bytes : Int
}

///|
pub fn HclLimits::default() -> HclLimits {
  HclLimits::{
    max_depth: 128,
    max_steps: 1000000L,
    max_output_bytes: 16777216,
  }
}

///|
pub fn HclLimits::new(max_depth : Int, max_steps : Int64, max_output_bytes : Int) -> HclLimits {
  HclLimits::{
    max_depth: max_depth,
    max_steps: max_steps,
    max_output_bytes: max_output_bytes,
  }
}

///| Dynamic HCL2 runtime value (cty-compatible model).
pub enum HclValue {
  Null
  Bool(Bool)
  Number(Double)
  Str(String)
  Tuple(Array[HclValue])
  Object(Array[(String, HclValue)])
}

///|
pub fn HclValue::null() -> HclValue {
  HclValue::Null
}

///|
pub fn HclValue::bool(v : Bool) -> HclValue {
  HclValue::Bool(v)
}

///|
pub fn HclValue::int(v : Int) -> HclValue {
  HclValue::Number(v.to_double())
}

///|
pub fn HclValue::number(v : Double) -> HclValue {
  HclValue::Number(v)
}

///|
pub fn HclValue::str(v : String) -> HclValue {
  HclValue::Str(v)
}

///|
pub fn HclValue::tuple(items : Array[HclValue]) -> HclValue {
  HclValue::Tuple(items)
}

///|
pub fn HclValue::object(entries : Array[(String, HclValue)]) -> HclValue {
  HclValue::Object(entries)
}

///| Structural equality on `HclValue` (order-independent for objects).
pub fn value_eq(a : HclValue, b : HclValue) -> Bool {
  match (a, b) {
    (HclValue::Null, HclValue::Null) => true
    (HclValue::Bool(x), HclValue::Bool(y)) => x == y
    (HclValue::Number(x), HclValue::Number(y)) => x == y
    (HclValue::Str(x), HclValue::Str(y)) => x == y
    (HclValue::Tuple(xa), HclValue::Tuple(xb)) => {
      if xa.length() != xb.length() {
        return false
      }
      let mut i = 0
      while i < xa.length() {
        if !value_eq(xa[i], xb[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (HclValue::Object(ea), HclValue::Object(eb)) => {
      if ea.length() != eb.length() {
        return false
      }
      let mut i = 0
      while i < ea.length() {
        let (ka, va) = ea[i]
        let mut found = false
        let mut j = 0
        while j < eb.length() {
          let (kb, vb) = eb[j]
          if ka == kb {
            if !value_eq(va, vb) {
              return false
            }
            found = true
            break
          }
          j = j + 1
        }
        if !found {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

///| Evaluation context carrying variables, custom functions, and safety limits.
pub struct EvalContext {
  pub vars : Array[(String, HclValue)]
  pub custom_funcs : Array[(String, (Array[HclValue]) -> Result[HclValue, HclError])]
  pub limits : HclLimits
}

///|
pub fn EvalContext::empty() -> EvalContext {
  EvalContext::{ vars: [], custom_funcs: [], limits: HclLimits::default() }
}

///|
pub fn EvalContext::from_vars(vars : Array[(String, HclValue)]) -> EvalContext {
  EvalContext::{ vars: vars, custom_funcs: [], limits: HclLimits::default() }
}

///|
pub fn EvalContext::with_var(self : EvalContext, name : String, value : HclValue) -> EvalContext {
  let next : Array[(String, HclValue)] = []
  let mut replaced = false
  let mut i = 0
  while i < self.vars.length() {
    let (k, v) = self.vars[i]
    if k == name {
      next.push((name, value))
      replaced = true
    } else {
      next.push((k, v))
    }
    i = i + 1
  }
  if !replaced {
    next.push((name, value))
  }
  EvalContext::{ vars: next, custom_funcs: self.custom_funcs, limits: self.limits }
}

///|
pub fn EvalContext::with_func(
  self : EvalContext,
  name : String,
  f : (Array[HclValue]) -> Result[HclValue, HclError],
) -> EvalContext {
  let next : Array[(String, (Array[HclValue]) -> Result[HclValue, HclError])] = []
  let mut replaced = false
  let mut i = 0
  while i < self.custom_funcs.length() {
    let (k, existing) = self.custom_funcs[i]
    if k == name {
      next.push((name, f))
      replaced = true
    } else {
      next.push((k, existing))
    }
    i = i + 1
  }
  if !replaced {
    next.push((name, f))
  }
  EvalContext::{ vars: self.vars, custom_funcs: next, limits: self.limits }
}

///|
pub fn EvalContext::with_limits(self : EvalContext, limits : HclLimits) -> EvalContext {
  EvalContext::{ vars: self.vars, custom_funcs: self.custom_funcs, limits: limits }
}
