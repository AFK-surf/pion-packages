///| Public entrypoints for `hcl` (HashiCorp HCL2 parser, evaluator, and formatter).

///| Parse an HCL2 configuration file with default limits.
pub fn parse(src : String) -> Result[File, HclError] {
  parse_with_limits(src, HclLimits::default())
}

///| Parse an HCL2 configuration file with explicit safety limits.
pub fn parse_with_limits(src : String, limits : HclLimits) -> Result[File, HclError] {
  let _ = src
  let _ = limits
  Err(HclError::unimplemented("parse_with_limits"))
}

///| Parse a standalone HCL2 expression with default limits.
pub fn parse_expr(src : String) -> Result[ExprFile, HclError] {
  parse_expr_with_limits(src, HclLimits::default())
}

///| Parse a standalone HCL2 expression with explicit safety limits.
pub fn parse_expr_with_limits(src : String, limits : HclLimits) -> Result[ExprFile, HclError] {
  let _ = src
  let _ = limits
  Err(HclError::unimplemented("parse_expr_with_limits"))
}

///| Parse an HCL2 template string (unquoted template body) with default limits.
pub fn parse_template(src : String) -> Result[ExprFile, HclError] {
  parse_template_with_limits(src, HclLimits::default())
}

///| Parse an HCL2 template string with explicit safety limits.
pub fn parse_template_with_limits(src : String, limits : HclLimits) -> Result[ExprFile, HclError] {
  let _ = src
  let _ = limits
  Err(HclError::unimplemented("parse_template_with_limits"))
}

///| Parse an HCL2 JSON-syntax configuration file (`.tf.json`) with default limits.
pub fn parse_json(src : String) -> Result[File, HclError] {
  parse_json_with_limits(src, HclLimits::default())
}

///| Parse an HCL2 JSON-syntax configuration file with explicit safety limits.
pub fn parse_json_with_limits(src : String, limits : HclLimits) -> Result[File, HclError] {
  let _ = src
  let _ = limits
  Err(HclError::unimplemented("parse_json_with_limits"))
}

///| Evaluate a standalone HCL2 expression against an `EvalContext`.
pub fn eval_expr(src : String, ctx : EvalContext) -> Result[HclValue, HclError] {
  let _ = src
  let _ = ctx
  Err(HclError::unimplemented("eval_expr"))
}

///| Evaluate an HCL2 template string against an `EvalContext`.
pub fn eval_template(src : String, ctx : EvalContext) -> Result[HclValue, HclError] {
  let _ = src
  let _ = ctx
  Err(HclError::unimplemented("eval_template"))
}

///| Evaluate a parsed `File` body to an `HclValue::Object`.
pub fn eval_file(file : File, ctx : EvalContext) -> Result[HclValue, HclError] {
  let _ = file
  let _ = ctx
  Err(HclError::unimplemented("eval_file"))
}

///| Parse and evaluate an HCL2 body source to an `HclValue::Object`.
pub fn eval_body(src : String, ctx : EvalContext) -> Result[HclValue, HclError] {
  let _ = src
  let _ = ctx
  Err(HclError::unimplemented("eval_body"))
}

///| Parse and evaluate an HCL2 body source to a deterministic canonical JSON string.
pub fn eval_body_to_json(src : String, ctx : EvalContext) -> Result[String, HclError] {
  let _ = src
  let _ = ctx
  Err(HclError::unimplemented("eval_body_to_json"))
}

///| Parse and evaluate an HCL2 JSON-syntax body to an `HclValue::Object`.
pub fn eval_json_body(src : String, ctx : EvalContext) -> Result[HclValue, HclError] {
  let _ = src
  let _ = ctx
  Err(HclError::unimplemented("eval_json_body"))
}

///| Parse and evaluate an HCL2 JSON-syntax body to a deterministic canonical JSON string.
pub fn eval_json_body_to_json(src : String, ctx : EvalContext) -> Result[String, HclError] {
  let _ = src
  let _ = ctx
  Err(HclError::unimplemented("eval_json_body_to_json"))
}

///| Serialize an `HclValue` to deterministic canonical JSON (sorted object keys).
pub fn value_to_json(value : HclValue) -> Result[String, HclError] {
  let _ = value
  Err(HclError::unimplemented("value_to_json"))
}

///| Format HCL2 configuration source canonically (aligned with `hclwrite.Format` / `terraform fmt`).
pub fn format_hcl(src : String) -> Result[String, HclError] {
  format_hcl_with_limits(src, HclLimits::default())
}

///| Format HCL2 configuration source with explicit safety limits.
pub fn format_hcl_with_limits(src : String, limits : HclLimits) -> Result[String, HclError] {
  let _ = src
  let _ = limits
  Err(HclError::unimplemented("format_hcl_with_limits"))
}
