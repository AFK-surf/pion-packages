///| HCL2 AST evaluator with `EvalContext`, short-circuit logic, single-interpolation
///| unwrap, `for` comprehensions, splat (`[*]` and `.*`), lazy `try`/`can`, and
///| `HclLimits` depth/steps/output_bytes protection.

struct Evaluator {
  nodes : Array[ExprNode]
  ctx : EvalContext
  locals : Array[(String, HclValue)]
  eff_max_depth : Int
  mut steps : Int64
  mut depth : Int
  mut output_bytes : Int
}

fn Evaluator::new(nodes : Array[ExprNode], ctx : EvalContext) -> Evaluator {
  Evaluator::{
    nodes: nodes,
    ctx: ctx,
    locals: [],
    eff_max_depth: hcl_effective_max_depth(ctx.limits.max_depth),
    steps: 0L,
    depth: 0,
    output_bytes: 0,
  }
}

fn Evaluator::tick(self : Evaluator, span : Span) -> Result[Unit, HclError] {
  self.steps = self.steps + 1L
  if self.steps > self.ctx.limits.max_steps {
    return Err(
      HclError::new(
        HclErrorKind::LimitExceeded,
        "evaluation step budget exceeded (" + self.ctx.limits.max_steps.to_string() + ")",
        span,
      ),
    )
  }
  Ok(())
}

fn Evaluator::charge_output(self : Evaluator, bytes : Int, span : Span) -> Result[Unit, HclError] {
  self.output_bytes = self.output_bytes + bytes
  if self.output_bytes > self.ctx.limits.max_output_bytes {
    return Err(
      HclError::new(
        HclErrorKind::LimitExceeded,
        "output byte budget exceeded (" + self.ctx.limits.max_output_bytes.to_string() + ")",
        span,
      ),
    )
  }
  Ok(())
}

fn Evaluator::enter(self : Evaluator, span : Span) -> Result[Unit, HclError] {
  self.depth = self.depth + 1
  if self.depth > self.eff_max_depth {
    return Err(
      HclError::new(
        HclErrorKind::LimitExceeded,
        "evaluation recursion depth exceeded (" + self.ctx.limits.max_depth.to_string() + ")",
        span,
      ),
    )
  }
  Ok(())
}

fn Evaluator::leave(self : Evaluator) -> Unit {
  if self.depth > 0 {
    self.depth = self.depth - 1
  }
}

fn Evaluator::lookup_var(self : Evaluator, name : String, span : Span) -> Result[HclValue, HclError] {
  // Search locals from top of stack (innermost lexical scope wins)
  let mut i = self.locals.length() - 1
  while i >= 0 {
    if self.locals[i].0 == name {
      return Ok(self.locals[i].1)
    }
    i = i - 1
  }
  // Search context vars
  i = 0
  while i < self.ctx.vars.length() {
    if self.ctx.vars[i].0 == name {
      return Ok(self.ctx.vars[i].1)
    }
    i = i + 1
  }
  Err(HclError::new(HclErrorKind::UnknownVariable, "unknown variable `" + name + "`", span))
}

fn Evaluator::eval_node(self : Evaluator, id : Int) -> Result[HclValue, HclError] {
  let node = self.nodes[id]
  let span = node_span(node)
  match self.tick(span) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.enter(span) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let res = self.eval_node_inner(node)
  self.leave()
  res
}

fn node_span(node : ExprNode) -> Span {
  match node {
    ExprNode::LitNull(sp) => sp
    ExprNode::LitBool(_, sp) => sp
    ExprNode::LitNumber(_, _, sp) => sp
    ExprNode::LitString(_, sp) => sp
    ExprNode::Template(_, _, sp) => sp
    ExprNode::ScopeVar(_, sp) => sp
    ExprNode::Parentheses(_, sp) => sp
    ExprNode::Unary(_, _, sp) => sp
    ExprNode::Binary(_, _, _, sp) => sp
    ExprNode::Conditional(_, _, _, sp) => sp
    ExprNode::TupleCons(_, sp) => sp
    ExprNode::ObjectCons(_, sp) => sp
    ExprNode::FuncCall(_, _, _, sp) => sp
    ExprNode::Traversal(_, _, sp) => sp
    ExprNode::ForTuple(_, _, _, _, _, sp) => sp
    ExprNode::ForObject(_, _, _, _, _, _, _, sp) => sp
  }
}

enum StaticType {
  StDynamic
  StNull
  StBool
  StNumber
  StStr(Option[String])
  StTuple
  StObject
}

fn static_type_of(nodes : Array[ExprNode], id : Int, depth : Int) -> StaticType {
  if depth > 32 {
    return StaticType::StDynamic
  }
  match nodes[id] {
    ExprNode::LitNull(_) => StaticType::StNull
    ExprNode::LitBool(_, _) => StaticType::StBool
    ExprNode::LitNumber(_, _, _) => StaticType::StNumber
    ExprNode::LitString(s, _) => StaticType::StStr(Some(s))
    ExprNode::Template(parts, allow_unwrap, _) => {
      if allow_unwrap && parts.length() == 1 {
        match parts[0] {
          TemplatePart::Interp(eid, _, _, _) => static_type_of(nodes, eid, depth + 1)
          _ => StaticType::StStr(None)
        }
      } else {
        StaticType::StStr(None)
      }
    }
    ExprNode::Parentheses(inner, _) => static_type_of(nodes, inner, depth + 1)
    ExprNode::Unary(op, _, _) => {
      match op {
        UnaryOp::Neg => StaticType::StNumber
        UnaryOp::Not => StaticType::StBool
      }
    }
    ExprNode::Binary(op, _, _, _) => {
      match op {
        BinOp::Or | BinOp::And | BinOp::Eq | BinOp::Ne | BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge =>
        StaticType::StBool
        _ => StaticType::StNumber
      }
    }
    ExprNode::TupleCons(_, _) | ExprNode::ForTuple(_, _, _, _, _, _) => StaticType::StTuple
    ExprNode::ObjectCons(_, _) | ExprNode::ForObject(_, _, _, _, _, _, _, _) => StaticType::StObject
    _ => StaticType::StDynamic
  }
}

fn check_static_bool_compat(st : StaticType, sp : Span) -> Result[Unit, HclError] {
  match st {
    StaticType::StDynamic | StaticType::StBool => Ok(())
    StaticType::StStr(Some(s)) => {
      if s == "true" || s == "false" {
        Ok(())
      } else {
        Err(HclError::new(HclErrorKind::TypeError, "expected bool", sp))
      }
    }
    StaticType::StStr(None) => Ok(())
    _ => Err(HclError::new(HclErrorKind::TypeError, "expected bool", sp))
  }
}

fn unify_cond_result(chosen : HclValue, other_st : StaticType, sp : Span) -> Result[HclValue, HclError] {
  match (chosen, other_st) {
    (_, StaticType::StDynamic) | (_, StaticType::StNull) | (HclValue::Null, _) => Ok(chosen)
    (HclValue::Bool(_), StaticType::StBool) => Ok(chosen)
    (HclValue::Number(_), StaticType::StNumber) | (HclValue::Decimal(_), StaticType::StNumber) => Ok(chosen)
    (HclValue::Str(_), StaticType::StStr(_)) => Ok(chosen)
    (HclValue::Tuple(_), StaticType::StTuple) => Ok(chosen)
    (HclValue::Object(_), StaticType::StObject) => Ok(chosen)
    // Primitive-to-string unification (`t ? 1 : "x"` -> `"1"`, `t ? true : "x"` -> `"true"`)
    (HclValue::Number(_), StaticType::StStr(_))
    | (HclValue::Decimal(_), StaticType::StStr(_))
    | (HclValue::Bool(_), StaticType::StStr(_)) => {
      match hcl_to_string(chosen, sp) {
        Ok(s) => Ok(HclValue::Str(s))
        Err(e) => Err(e)
      }
    }
    (HclValue::Str(_), StaticType::StNumber) | (HclValue::Str(_), StaticType::StBool) => Ok(chosen)
    _ =>
    Err(
      HclError::new(
        HclErrorKind::TypeError,
        "inconsistent conditional result types",
        sp,
      ),
    )
  }
}

fn Evaluator::eval_node_inner(self : Evaluator, node : ExprNode) -> Result[HclValue, HclError] {
  match node {
    ExprNode::LitNull(_) => Ok(HclValue::Null)
    ExprNode::LitBool(b, _) => Ok(HclValue::Bool(b))
    ExprNode::LitNumber(v, _, _) => Ok(v)
    ExprNode::LitString(s, _) => Ok(HclValue::Str(s))
    ExprNode::ScopeVar(name, sp) => self.lookup_var(name, sp)
    ExprNode::Parentheses(inner, _) => self.eval_node(inner)
    ExprNode::Template(parts, allow_unwrap, sp) => self.eval_template_expr(parts, allow_unwrap, sp)
    ExprNode::Unary(op, inner, sp) => {
      let v = match self.eval_node(inner) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      match op {
        UnaryOp::Neg => {
          match v {
            HclValue::Number(d) => Ok(HclValue::Number(-d))
            HclValue::Decimal(bd) => Ok(HclValue::Decimal(bd.negate()))
            _ => {
              match hcl_to_bigdec(v, sp) {
                Ok(bd) => Ok(HclValue::Decimal(bd.negate()))
                Err(e) => Err(e)
              }
            }
          }
        }
        UnaryOp::Not => {
          match hcl_to_bool(v, sp) {
            Ok(b) => Ok(HclValue::Bool(!b))
            Err(e) => Err(e)
          }
        }
      }
    }
    ExprNode::Binary(op, lid, rid, sp) => self.eval_binary(op, lid, rid, sp)
    ExprNode::Conditional(cid, tid, fid, sp) => {
      let cv = match self.eval_node(cid) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      let cond = match hcl_to_bool(cv, sp) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      let chosen_id = if cond { tid } else { fid }
      let other_id = if cond { fid } else { tid }
      let chosen_val = match self.eval_node(chosen_id) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      let other_st = static_type_of(self.nodes, other_id, 0)
      unify_cond_result(chosen_val, other_st, sp)
    }
    ExprNode::TupleCons(ids, _) => {
      let out : Array[HclValue] = []
      let mut i = 0
      while i < ids.length() {
        let v = match self.eval_node(ids[i]) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        out.push(v)
        i = i + 1
      }
      Ok(HclValue::Tuple(out))
    }
    ExprNode::ObjectCons(items, _) => {
      let out : Array[(String, HclValue)] = []
      let mut i = 0
      while i < items.length() {
        let it = items[i]
        let kv = match self.eval_node(it.key_expr) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        let k = match hcl_to_string(kv, it.span) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        let vv = match self.eval_node(it.val_expr) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        let mut found = false
        let mut j = 0
        while j < out.length() {
          if out[j].0 == k {
            out[j] = (k, vv)
            found = true
            break
          }
          j = j + 1
        }
        if !found {
          out.push((k, vv))
        }
        i = i + 1
      }
      Ok(HclValue::Object(out))
    }
    ExprNode::FuncCall(name, arg_ids, expand_final, sp) =>
    self.eval_func_call(name, arg_ids, expand_final, sp)
    ExprNode::Traversal(base_id, steps, _) => {
      let base = match self.eval_node(base_id) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      self.apply_traversal_steps(base, steps, 0)
    }
    ExprNode::ForTuple(kv, vv, col_id, val_id, cond_opt, sp) =>
    self.eval_for_tuple(kv, vv, col_id, val_id, cond_opt, sp)
    ExprNode::ForObject(kv, vv, col_id, key_id, val_id, group, cond_opt, sp) =>
    self.eval_for_object(kv, vv, col_id, key_id, val_id, group, cond_opt, sp)
  }
}

fn Evaluator::eval_binary(
  self : Evaluator,
  op : BinOp,
  lid : Int,
  rid : Int,
  sp : Span,
) -> Result[HclValue, HclError] {
  // Short-circuit logical operators
  match op {
    BinOp::And => {
      let lv = match self.eval_node(lid) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      let lb = match hcl_to_bool(lv, sp) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      if !lb {
        match check_static_bool_compat(static_type_of(self.nodes, rid, 0), sp) {
          Ok(_) => return Ok(HclValue::Bool(false))
          Err(e) => return Err(e)
        }
      }
      let rv = match self.eval_node(rid) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      let rb = match hcl_to_bool(rv, sp) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      return Ok(HclValue::Bool(rb))
    }
    BinOp::Or => {
      let lv = match self.eval_node(lid) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      let lb = match hcl_to_bool(lv, sp) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      if lb {
        match check_static_bool_compat(static_type_of(self.nodes, rid, 0), sp) {
          Ok(_) => return Ok(HclValue::Bool(true))
          Err(e) => return Err(e)
        }
      }
      let rv = match self.eval_node(rid) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      let rb = match hcl_to_bool(rv, sp) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      return Ok(HclValue::Bool(rb))
    }
    _ => ()
  }

  let lv = match self.eval_node(lid) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let rv = match self.eval_node(rid) {
    Ok(x) => x
    Err(e) => return Err(e)
  }

  match op {
    BinOp::Eq => Ok(HclValue::Bool(value_eq(lv, rv)))
    BinOp::Ne => Ok(HclValue::Bool(!value_eq(lv, rv)))
    BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge | BinOp::Add | BinOp::Sub | BinOp::Mul | BinOp::Div | BinOp::Mod => {
      // Fast exact integer Double path for common small integers (keeps W2 fast without precision loss)
      match (lv, rv) {
        (HclValue::Number(a), HclValue::Number(b)) => {
          match op {
            BinOp::Lt => return Ok(HclValue::Bool(a < b))
            BinOp::Le => return Ok(HclValue::Bool(a <= b))
            BinOp::Gt => return Ok(HclValue::Bool(a > b))
            BinOp::Ge => return Ok(HclValue::Bool(a >= b))
            BinOp::Add => {
              if a >= -100000000000000.0 && a <= 100000000000000.0 && b >= -100000000000000.0 && b <= 100000000000000.0 {
                let ia = a.to_int64()
                let ib = b.to_int64()
                if ia.to_double() == a && ib.to_double() == b {
                  return Ok(HclValue::Number((ia + ib).to_double()))
                }
              }
            }
            BinOp::Sub => {
              if a >= -100000000000000.0 && a <= 100000000000000.0 && b >= -100000000000000.0 && b <= 100000000000000.0 {
                let ia = a.to_int64()
                let ib = b.to_int64()
                if ia.to_double() == a && ib.to_double() == b {
                  return Ok(HclValue::Number((ia - ib).to_double()))
                }
              }
            }
            BinOp::Mul => {
              if a >= -10000000.0 && a <= 10000000.0 && b >= -10000000.0 && b <= 10000000.0 {
                let ia = a.to_int64()
                let ib = b.to_int64()
                if ia.to_double() == a && ib.to_double() == b {
                  return Ok(HclValue::Number((ia * ib).to_double()))
                }
              }
            }
            _ => ()
          }
        }
        _ => ()
      }
      let a = match hcl_to_bigdec(lv, sp) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      let b = match hcl_to_bigdec(rv, sp) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      match op {
        BinOp::Lt => Ok(HclValue::Bool(BigDec::cmp(a, b) < 0))
        BinOp::Le => Ok(HclValue::Bool(BigDec::cmp(a, b) <= 0))
        BinOp::Gt => Ok(HclValue::Bool(BigDec::cmp(a, b) > 0))
        BinOp::Ge => Ok(HclValue::Bool(BigDec::cmp(a, b) >= 0))
        BinOp::Add => Ok(HclValue::Decimal(BigDec::add(a, b)))
        BinOp::Sub => Ok(HclValue::Decimal(BigDec::sub(a, b)))
        BinOp::Mul => Ok(HclValue::Decimal(BigDec::mul(a, b)))
        BinOp::Div => {
          match BigDec::div(a, b) {
            Some(q) => Ok(HclValue::Decimal(q))
            None => Err(HclError::new(HclErrorKind::DivisionByZero, "division by zero", sp))
          }
        }
        BinOp::Mod => Ok(HclValue::Decimal(BigDec::rem(a, b)))
        _ => Err(HclError::new(HclErrorKind::EvalError, "unreachable binary op", sp))
      }
    }
    _ => Err(HclError::new(HclErrorKind::EvalError, "unreachable binary op", sp))
  }
}

fn Evaluator::eval_func_call(
  self : Evaluator,
  name : String,
  arg_ids : Array[Int],
  expand_final : Bool,
  sp : Span,
) -> Result[HclValue, HclError] {
  // Special lazy-evaluation functions: try(...) and can(...)
  if name == "try" {
    if arg_ids.length() == 0 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "try() expects at least 1 argument", sp))
    }
    let mut last_err = HclError::new(HclErrorKind::EvalError, "all try() expressions failed", sp)
    let mut i = 0
    while i < arg_ids.length() {
      match self.eval_node(arg_ids[i]) {
        Ok(v) => return Ok(v)
        Err(e) => {
          if e.is_kind(HclErrorKind::LimitExceeded) {
            return Err(e)
          }
          last_err = e
        }
      }
      i = i + 1
    }
    return Err(last_err)
  }
  if name == "can" {
    if arg_ids.length() != 1 {
      return Err(HclError::new(HclErrorKind::InvalidArgument, "can() expects 1 argument", sp))
    }
    match self.eval_node(arg_ids[0]) {
      Ok(_) => return Ok(HclValue::Bool(true))
      Err(e) => {
        if e.is_kind(HclErrorKind::LimitExceeded) {
          return Err(e)
        }
        return Ok(HclValue::Bool(false))
      }
    }
  }

  // Evaluate arguments eagerly (with optional `...` expansion on final argument)
  let args : Array[HclValue] = []
  let mut i = 0
  while i < arg_ids.length() {
    let v = match self.eval_node(arg_ids[i]) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    if expand_final && i + 1 == arg_ids.length() {
      match v {
        HclValue::Tuple(xs) => {
          let mut j = 0
          while j < xs.length() {
            args.push(xs[j])
            j = j + 1
          }
        }
        _ =>
        return Err(
          HclError::new(
            HclErrorKind::TypeError,
            "`...` argument expansion requires a list/tuple value",
            sp,
          ),
        )
      }
    } else {
      args.push(v)
    }
    i = i + 1
  }

  // 1. Check user-registered custom functions first
  i = 0
  while i < self.ctx.custom_funcs.length() {
    if self.ctx.custom_funcs[i].0 == name {
      let f = self.ctx.custom_funcs[i].1
      return f(args)
    }
    i = i + 1
  }

  // 2. Check standard built-in functions
  match call_builtin_func(name, args, self.ctx.limits, sp) {
    Ok(Some(v)) => Ok(v)
    Ok(None) =>
    Err(HclError::new(HclErrorKind::UnknownFunction, "unknown function `" + name + "`", sp))
    Err(e) => Err(e)
  }
}

fn Evaluator::apply_traversal_steps(
  self : Evaluator,
  target : HclValue,
  steps : Array[TraversalStep],
  idx : Int,
) -> Result[HclValue, HclError] {
  let mut cur = target
  let mut i = idx
  while i < steps.length() {
    match steps[i] {
      TraversalStep::GetAttr(attr, sp) => {
        match cur {
          HclValue::Object(entries) => {
            let mut found = false
            let mut j = 0
            while j < entries.length() {
              if entries[j].0 == attr {
                cur = entries[j].1
                found = true
                break
              }
              j = j + 1
            }
            if !found {
              return Err(
                HclError::new(
                  HclErrorKind::MissingKey,
                  "object does not have attribute `" + attr + "`",
                  sp,
                ),
              )
            }
          }
          _ =>
          return Err(
            HclError::new(
              HclErrorKind::TypeError,
              "cannot access attribute `" + attr + "` on non-object",
              sp,
            ),
          )
        }
      }
      TraversalStep::Index(key_id, sp) => {
        let kv = match self.eval_node(key_id) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        match cur {
          HclValue::Tuple(xs) => {
            let bd = match hcl_to_bigdec(kv, sp) {
              Ok(d) => d
              Err(e) => return Err(e)
            }
            if !bd.is_integer() {
              return Err(
                HclError::new(
                  HclErrorKind::InvalidArgument,
                  "tuple index must be a whole number",
                  sp,
                ),
              )
            }
            let n = match bd.to_int_exact() {
              Some(i_val) => i_val
              None =>
              return Err(
                HclError::new(
                  HclErrorKind::IndexOutOfBounds,
                  "index out of bounds",
                  sp,
                ),
              )
            }
            if n < 0 || n >= xs.length() {
              return Err(
                HclError::new(
                  HclErrorKind::IndexOutOfBounds,
                  "index " + n.to_string() + " out of bounds",
                  sp,
                ),
              )
            }
            cur = xs[n]
          }
          HclValue::Object(entries) => {
            let k = match hcl_to_string(kv, sp) {
              Ok(s) => s
              Err(e) => return Err(e)
            }
            let mut found = false
            let mut j = 0
            while j < entries.length() {
              if entries[j].0 == k {
                cur = entries[j].1
                found = true
                break
              }
              j = j + 1
            }
            if !found {
              return Err(
                HclError::new(HclErrorKind::MissingKey, "key `" + k + "` not found in object", sp),
              )
            }
          }
          _ =>
          return Err(
            HclError::new(HclErrorKind::TypeError, "cannot index into non-collection value", sp),
          )
        }
      }
      TraversalStep::AttrSplat(sub_steps, sp) => {
        match cur {
          HclValue::Null => {
            cur = HclValue::Tuple([])
          }
          HclValue::Tuple(xs) => {
            let out : Array[HclValue] = []
            let mut j = 0
            while j < xs.length() {
              match self.tick(sp) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              let elem = match self.apply_traversal_steps(xs[j], sub_steps, 0) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              out.push(elem)
              j = j + 1
            }
            cur = HclValue::Tuple(out)
          }
          other => {
            let elem = match self.apply_traversal_steps(other, sub_steps, 0) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            cur = HclValue::Tuple([elem])
          }
        }
      }
      TraversalStep::FullSplat(sub_steps, sp) => {
        match cur {
          HclValue::Null => {
            cur = HclValue::Tuple([])
          }
          HclValue::Tuple(xs) => {
            let out : Array[HclValue] = []
            let mut j = 0
            while j < xs.length() {
              match self.tick(sp) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              let elem = match self.apply_traversal_steps(xs[j], sub_steps, 0) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              out.push(elem)
              j = j + 1
            }
            cur = HclValue::Tuple(out)
          }
          other => {
            // HCL2 Full Splat wraps non-list non-null value into a 1-element list
            let elem = match self.apply_traversal_steps(other, sub_steps, 0) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            cur = HclValue::Tuple([elem])
          }
        }
      }
    }
    i = i + 1
  }
  Ok(cur)
}

fn Evaluator::iter_pairs(self : Evaluator, coll : HclValue, sp : Span) -> Result[Array[(HclValue, HclValue)], HclError] {
  let _ = self
  match coll {
    HclValue::Tuple(xs) => {
      let pairs : Array[(HclValue, HclValue)] = []
      let mut i = 0
      while i < xs.length() {
        pairs.push((HclValue::int(i), xs[i]))
        i = i + 1
      }
      Ok(pairs)
    }
    HclValue::Object(entries) => {
      let sorted = sort_entries_by_key(entries)
      let pairs : Array[(HclValue, HclValue)] = []
      let mut i = 0
      while i < sorted.length() {
        pairs.push((HclValue::Str(sorted[i].0), sorted[i].1))
        i = i + 1
      }
      Ok(pairs)
    }
    _ => Err(HclError::new(HclErrorKind::TypeError, "cannot iterate over non-collection value", sp))
  }
}

fn Evaluator::eval_for_tuple(
  self : Evaluator,
  key_var : Option[String],
  val_var : String,
  coll_id : Int,
  val_id : Int,
  cond_opt : Option[Int],
  sp : Span,
) -> Result[HclValue, HclError] {
  let coll = match self.eval_node(coll_id) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let pairs = match self.iter_pairs(coll, sp) {
    Ok(ps) => ps
    Err(e) => return Err(e)
  }
  let out : Array[HclValue] = []
  let mut i = 0
  while i < pairs.length() {
    match self.tick(sp) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let (k, v) = pairs[i]
    let saved_len = self.locals.length()
    match key_var {
      Some(kn) => self.locals.push((kn, k))
      None => ()
    }
    self.locals.push((val_var, v))

    let mut include_item = true
    match cond_opt {
      Some(cid) => {
        let cv = match self.eval_node(cid) {
          Ok(x) => x
          Err(e) => {
            while self.locals.length() > saved_len {
              let _ = self.locals.pop()
            }
            return Err(e)
          }
        }
        include_item = match hcl_to_bool(cv, sp) {
          Ok(b) => b
          Err(e) => {
            while self.locals.length() > saved_len {
              let _ = self.locals.pop()
            }
            return Err(e)
          }
        }
      }
      None => ()
    }
    if include_item {
      let item = match self.eval_node(val_id) {
        Ok(x) => x
        Err(e) => {
          while self.locals.length() > saved_len {
            let _ = self.locals.pop()
          }
          return Err(e)
        }
      }
      out.push(item)
    }
    while self.locals.length() > saved_len {
      let _ = self.locals.pop()
    }
    i = i + 1
  }
  Ok(HclValue::Tuple(out))
}

fn Evaluator::eval_for_object(
  self : Evaluator,
  key_var : Option[String],
  val_var : String,
  coll_id : Int,
  key_id : Int,
  val_id : Int,
  group : Bool,
  cond_opt : Option[Int],
  sp : Span,
) -> Result[HclValue, HclError] {
  let coll = match self.eval_node(coll_id) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let pairs = match self.iter_pairs(coll, sp) {
    Ok(ps) => ps
    Err(e) => return Err(e)
  }
  let out : Array[(String, HclValue)] = []
  let mut i = 0
  while i < pairs.length() {
    match self.tick(sp) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let (k, v) = pairs[i]
    let saved_len = self.locals.length()
    match key_var {
      Some(kn) => self.locals.push((kn, k))
      None => ()
    }
    self.locals.push((val_var, v))

    let mut include_item = true
    match cond_opt {
      Some(cid) => {
        let cv = match self.eval_node(cid) {
          Ok(x) => x
          Err(e) => {
            while self.locals.length() > saved_len {
              let _ = self.locals.pop()
            }
            return Err(e)
          }
        }
        include_item = match hcl_to_bool(cv, sp) {
          Ok(b) => b
          Err(e) => {
            while self.locals.length() > saved_len {
              let _ = self.locals.pop()
            }
            return Err(e)
          }
        }
      }
      None => ()
    }
    if include_item {
      let kv = match self.eval_node(key_id) {
        Ok(x) => x
        Err(e) => {
          while self.locals.length() > saved_len {
            let _ = self.locals.pop()
          }
          return Err(e)
        }
      }
      let key_str = match hcl_to_string(kv, sp) {
        Ok(s) => s
        Err(e) => {
          while self.locals.length() > saved_len {
            let _ = self.locals.pop()
          }
          return Err(e)
        }
      }
      let vv = match self.eval_node(val_id) {
        Ok(x) => x
        Err(e) => {
          while self.locals.length() > saved_len {
            let _ = self.locals.pop()
          }
          return Err(e)
        }
      }
      let mut found_idx = -1
      let mut j = 0
      while j < out.length() {
        if out[j].0 == key_str {
          found_idx = j
          break
        }
        j = j + 1
      }
      if found_idx >= 0 {
        if group {
          match out[found_idx].1 {
            HclValue::Tuple(arr) => {
              arr.push(vv)
              out[found_idx] = (key_str, HclValue::Tuple(arr))
            }
            _ => ()
          }
        } else {
          while self.locals.length() > saved_len {
            let _ = self.locals.pop()
          }
          return Err(
            HclError::new(
              HclErrorKind::DuplicateKey,
              "duplicate object key `" + key_str + "` in `for` expression (use `...` to group)",
              sp,
            ),
          )
        }
      } else {
        if group {
          out.push((key_str, HclValue::Tuple([vv])))
        } else {
          out.push((key_str, vv))
        }
      }
    }
    while self.locals.length() > saved_len {
      let _ = self.locals.pop()
    }
    i = i + 1
  }
  Ok(HclValue::Object(out))
}

///| Trim trailing whitespace from ONLY the last line segment of `s` (matching hcl/v2 line-split lexer + TrimRightFunc).
fn trim_right_one_line(s : String) -> String {
  let n = s.length()
  if n == 0 {
    return s
  }
  // Find start of last line token:
  // If `s` ends with `\n`, that `\n` closes the last line token, so search before `n - 1`.
  let search_end = if s.code_unit_at(n - 1) == 10 { n - 1 } else { n }
  let mut line_start = 0
  let mut i = search_end - 1
  while i >= 0 {
    if s.code_unit_at(i) == 10 {
      line_start = i + 1
      break
    }
    i = i - 1
  }
  // Trim trailing Unicode spaces within [line_start, n)
  let mut last_non_ws = line_start
  let mut k = line_start
  while k < n {
    let (cp, next_k) = utf8_decode_at(s, k)
    if !is_unicode_space(cp) {
      last_non_ws = next_k
    }
    k = next_k
  }
  s.slice(0, last_non_ws)
}

///| Trim leading whitespace from ONLY the first line segment of `s` (matching hcl/v2 line-split lexer + TrimLeftFunc).
fn trim_left_one_line(s : String) -> String {
  let n = s.length()
  if n == 0 {
    return s
  }
  // First line token extends up to and including the first `\n` (or end of string)
  let mut line_end = n
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 10 {
      line_end = i + 1
      break
    }
    i = i + 1
  }
  // Trim leading Unicode spaces within [0, line_end)
  let mut start = 0
  while start < line_end {
    let (cp, next_s) = utf8_decode_at(s, start)
    if is_unicode_space(cp) {
      start = next_s
    } else {
      break
    }
  }
  s.slice(start, n)
}

fn Evaluator::eval_template_expr(
  self : Evaluator,
  parts : Array[TemplatePart],
  allow_unwrap : Bool,
  sp : Span,
) -> Result[HclValue, HclError] {
  // HCL2 single-interpolation unwrap rule: `"${expr}"` (including `"${~ expr ~}"`) returns raw typed value
  if allow_unwrap && parts.length() == 1 {
    match parts[0] {
      TemplatePart::Interp(eid, _, _, _) => return self.eval_node(eid)
      _ => ()
    }
  }
  let chunks : Array[String] = []
  let mut trim_next_leading = false
  match self.eval_template_parts_into(parts, chunks, trim_next_leading) {
    Ok(tnl) => trim_next_leading = tnl
    Err(e) => return Err(e)
  }
  let _ = trim_next_leading
  let sb = StringBuilder::new()
  let mut total = 0
  let mut i = 0
  while i < chunks.length() {
    total = total + chunks[i].length()
    if total > self.ctx.limits.max_output_bytes {
      return Err(
        HclError::new(HclErrorKind::LimitExceeded, "template output exceeds max_output_bytes", sp),
      )
    }
    sb.write_string(chunks[i])
    i = i + 1
  }
  let out = sb.to_string()
  match self.charge_output(out.length(), sp) {
    Ok(_) => Ok(HclValue::Str(out))
    Err(e) => Err(e)
  }
}

fn Evaluator::eval_template_parts_into(
  self : Evaluator,
  parts : Array[TemplatePart],
  chunks : Array[String],
  initial_trim_next : Bool,
) -> Result[Bool, HclError] {
  let mut trim_next = initial_trim_next
  let mut last_was_literal = false
  let mut i = 0
  while i < parts.length() {
    match parts[i] {
      TemplatePart::Literal(s, _) => {
        let piece = if trim_next {
          trim_next = false
          trim_left_one_line(s)
        } else {
          s
        }
        chunks.push(piece)
        last_was_literal = true
      }
      TemplatePart::Interp(eid, strip_l, strip_r, sp) => {
        if strip_l && last_was_literal && chunks.length() > 0 {
          let last_idx = chunks.length() - 1
          chunks[last_idx] = trim_right_one_line(chunks[last_idx])
        }
        trim_next = false
        last_was_literal = false
        let v = match self.eval_node(eid) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        let s = match hcl_to_string(v, sp) {
          Ok(str_v) => str_v
          Err(e) => return Err(e)
        }
        if s.length() > 0 {
          chunks.push(s)
        }
        if strip_r {
          trim_next = true
        }
      }
      TemplatePart::If(cid, true_parts, false_parts, if_sl, if_sr, true_end_sl, else_sr, false_end_sl, end_sr, sp) => {
        if if_sl && last_was_literal && chunks.length() > 0 {
          let last_idx = chunks.length() - 1
          chunks[last_idx] = trim_right_one_line(chunks[last_idx])
        }
        trim_next = false
        last_was_literal = false
        let cv = match self.eval_node(cid) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        let cond = match hcl_to_bool(cv, sp) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
        let branch = if cond { true_parts } else { false_parts }
        let branch_lead_trim = if cond { if_sr } else { else_sr }
        let branch_trail_trim = if cond { true_end_sl } else { false_end_sl }
        let branch_ended_lit = match self.eval_template_parts_into(branch, chunks, branch_lead_trim) {
          Ok(ended_lit) => ended_lit
          Err(e) => return Err(e)
        }
        if branch_trail_trim && branch_ended_lit && chunks.length() > 0 {
          let last_idx = chunks.length() - 1
          chunks[last_idx] = trim_right_one_line(chunks[last_idx])
        }
        trim_next = end_sr
      }
      TemplatePart::For(kv, vv, col_id, body_parts, sl, osr, esl, esr, sp) => {
        if sl && last_was_literal && chunks.length() > 0 {
          let last_idx = chunks.length() - 1
          chunks[last_idx] = trim_right_one_line(chunks[last_idx])
        }
        trim_next = false
        last_was_literal = false
        let coll = match self.eval_node(col_id) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        let pairs = match self.iter_pairs(coll, sp) {
          Ok(ps) => ps
          Err(e) => return Err(e)
        }
        let mut p = 0
        while p < pairs.length() {
          match self.tick(sp) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          let (k, v) = pairs[p]
          let saved_len = self.locals.length()
          match kv {
            Some(kn) => self.locals.push((kn, k))
            None => ()
          }
          self.locals.push((vv, v))
          let body_ended_lit = match self.eval_template_parts_into(body_parts, chunks, osr) {
            Ok(ended_lit) => ended_lit
            Err(e) => {
              while self.locals.length() > saved_len {
                let _ = self.locals.pop()
              }
              return Err(e)
            }
          }
          while self.locals.length() > saved_len {
            let _ = self.locals.pop()
          }
          if esl && body_ended_lit && chunks.length() > 0 {
            let last_idx = chunks.length() - 1
            chunks[last_idx] = trim_right_one_line(chunks[last_idx])
          }
          p = p + 1
        }
        trim_next = esr
      }
    }
    i = i + 1
  }
  Ok(last_was_literal)
}

fn eval_body_with_eval(ev : Evaluator, body : Body) -> Result[HclValue, HclError] {
  let entries : Array[(String, HclValue)] = []
  let mut i = 0
  while i < body.attributes.length() {
    let attr = body.attributes[i]
    let v = match ev.eval_node(attr.expr) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    entries.push((attr.name, v))
    i = i + 1
  }
  // Group blocks by block_type (and nest labels)
  i = 0
  while i < body.blocks.length() {
    let blk = body.blocks[i]
    let bval = match eval_body_with_eval(ev, blk.body) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    insert_block_value(entries, blk.block_type, blk.labels, 0, bval)
    i = i + 1
  }
  Ok(HclValue::Object(entries))
}

fn insert_block_value(
  entries : Array[(String, HclValue)],
  key : String,
  labels : Array[String],
  label_idx : Int,
  bval : HclValue,
) -> Unit {
  if label_idx < labels.length() {
    // Nested map for label
    let mut found = -1
    let mut i = 0
    while i < entries.length() {
      if entries[i].0 == key {
        found = i
        break
      }
      i = i + 1
    }
    if found >= 0 {
      match entries[found].1 {
        HclValue::Object(sub) => {
          insert_block_value(sub, labels[label_idx], labels, label_idx + 1, bval)
          entries[found] = (key, HclValue::Object(sub))
        }
        _ => ()
      }
    } else {
      let sub : Array[(String, HclValue)] = []
      insert_block_value(sub, labels[label_idx], labels, label_idx + 1, bval)
      entries.push((key, HclValue::Object(sub)))
    }
  } else {
    // Leaf block list
    let mut found = -1
    let mut i = 0
    while i < entries.length() {
      if entries[i].0 == key {
        found = i
        break
      }
      i = i + 1
    }
    if found >= 0 {
      match entries[found].1 {
        HclValue::Tuple(arr) => {
          arr.push(bval)
          entries[found] = (key, HclValue::Tuple(arr))
        }
        _ => ()
      }
    } else {
      entries.push((key, HclValue::Tuple([bval])))
    }
  }
}

///| Evaluate a parsed `ExprFile` against an `EvalContext`.
pub fn eval_expr_file_impl(ef : ExprFile, ctx : EvalContext) -> Result[HclValue, HclError] {
  let ev = Evaluator::new(ef.nodes, ctx)
  ev.eval_node(ef.root)
}

///| Evaluate a parsed `File` body against an `EvalContext`.
pub fn eval_file_impl(file : File, ctx : EvalContext) -> Result[HclValue, HclError] {
  let ev = Evaluator::new(file.nodes, ctx)
  eval_body_with_eval(ev, file.body)
}
