///| Recursive-descent HCL2 parser producing a flat arena-indexed AST with
///| explicit `HclLimits` depth protection, duplicate attribute rejection,
///| indented heredoc dedenting, and JSON-syntax equivalence (`parse_json`).

import "json5"

struct Parser {
  lex : StreamLexer
  buf_tag : FixedArray[Int]
  buf_str : FixedArray[String]
  buf_flag : FixedArray[Bool]
  buf_sl : FixedArray[Int]
  buf_sc : FixedArray[Int]
  buf_so : FixedArray[Int]
  buf_el : FixedArray[Int]
  buf_ec : FixedArray[Int]
  buf_eo : FixedArray[Int]
  mut head : Int
  mut count : Int
  mut done : Bool
  nodes : Array[ExprNode]
  limits : HclLimits
  eff_max_depth : Int
  mut depth : Int
  mut bracket_depth : Int
}

fn Parser::new_stream(lex : StreamLexer, limits : HclLimits, est_nodes : Int) -> Parser {
  let cap = if est_nodes < 16 {
    16
  } else if est_nodes > 65536 {
    65536
  } else {
    est_nodes
  }
  let p = Parser::{
    lex: lex,
    buf_tag: FixedArray::make(4, TOK_EOF),
    buf_str: FixedArray::make(4, ""),
    buf_flag: FixedArray::make(4, false),
    buf_sl: FixedArray::make(4, 1),
    buf_sc: FixedArray::make(4, 1),
    buf_so: FixedArray::make(4, 0),
    buf_el: FixedArray::make(4, 1),
    buf_ec: FixedArray::make(4, 1),
    buf_eo: FixedArray::make(4, 0),
    head: 0,
    count: 0,
    done: false,
    nodes: Array::with_capacity(cap),
    limits: limits,
    eff_max_depth: hcl_effective_max_depth(limits.max_depth),
    depth: 0,
    bracket_depth: 0,
  }
  p.ensure(1)
  p
}

fn Parser::ensure(self : Parser, needed : Int) -> Unit {
  while self.count < needed && !self.done {
    let slot = (self.head + self.count) & 3
    let ok = self.lex.next_token()
    let tag = if ok { self.lex.tok_tag } else { TOK_ERR }
    self.buf_tag[slot] = tag
    self.buf_str[slot] = self.lex.tok_str
    self.buf_flag[slot] = self.lex.tok_flag
    self.buf_sl[slot] = self.lex.tok_sl
    self.buf_sc[slot] = self.lex.tok_sc
    self.buf_so[slot] = self.lex.tok_so
    self.buf_el[slot] = self.lex.tok_el
    self.buf_ec[slot] = self.lex.tok_ec
    self.buf_eo[slot] = self.lex.tok_eo
    self.count = self.count + 1
    if tag == TOK_EOF || tag == TOK_ERR {
      self.done = true
    }
  }
}

fn Parser::slot_at(self : Parser, delta : Int) -> Int {
  self.ensure(delta + 1)
  let idx = if delta < self.count { delta } else { self.count - 1 }
  (self.head + idx) & 3
}

fn Parser::cur_tag(self : Parser) -> Int {
  if self.count == 0 {
    self.ensure(1)
  }
  self.buf_tag[self.head]
}

fn Parser::peek_tag(self : Parser, delta : Int) -> Int {
  self.buf_tag[self.slot_at(delta)]
}

fn Parser::cur_str(self : Parser) -> String {
  self.buf_str[self.head]
}

fn Parser::cur_flag(self : Parser) -> Bool {
  self.buf_flag[self.head]
}

fn Parser::cur_start_pos(self : Parser) -> Pos {
  let h = self.head
  Pos::new(self.buf_sl[h], self.buf_sc[h], self.buf_so[h])
}

fn Parser::cur_end_pos(self : Parser) -> Pos {
  let h = self.head
  Pos::new(self.buf_el[h], self.buf_ec[h], self.buf_eo[h])
}

fn Parser::cur_span(self : Parser) -> Span {
  let h = self.head
  Span::new(
    Pos::new(self.buf_sl[h], self.buf_sc[h], self.buf_so[h]),
    Pos::new(self.buf_el[h], self.buf_ec[h], self.buf_eo[h]),
  )
}

fn Parser::cur_raw(self : Parser) -> String {
  let h = self.head
  let tag = self.buf_tag[h]
  if tag == TOK_EOF || tag == TOK_ERR {
    ""
  } else {
    self.lex.src.slice(self.buf_so[h], self.buf_eo[h])
  }
}

fn Parser::consume(self : Parser) -> Unit {
  if self.count > 1 {
    self.head = (self.head + 1) & 3
    self.count = self.count - 1
  } else if !self.done {
    self.head = (self.head + 1) & 3
    self.count = 0
    self.ensure(1)
  }
}

fn Parser::take_lex_err(self : Parser) -> HclError {
  match self.lex.err {
    Some(e) => e
    None => HclError::new(HclErrorKind::SyntaxError, "lexer error", self.cur_span())
  }
}

fn Parser::syntax_err(self : Parser, msg : String) -> HclError {
  if self.cur_tag() == TOK_ERR {
    self.take_lex_err()
  } else {
    HclError::new(HclErrorKind::SyntaxError, msg, self.cur_span())
  }
}

fn Parser::skip_newlines(self : Parser) -> Unit {
  while self.cur_tag() == TOK_NEWLINE {
    self.consume()
  }
}

fn Parser::skip_bracket_newlines(self : Parser) -> Unit {
  if self.bracket_depth > 0 {
    while self.cur_tag() == TOK_NEWLINE {
      self.consume()
    }
  }
}

fn Parser::push_node(self : Parser, node : ExprNode) -> Int {
  let id = self.nodes.length()
  self.nodes.push(node)
  id
}

fn Parser::enter(self : Parser) -> Result[Unit, HclError] {
  self.depth = self.depth + 1
  if self.depth > self.eff_max_depth {
    return Err(
      HclError::new(
        HclErrorKind::LimitExceeded,
        "maximum nesting depth exceeded (" + self.limits.max_depth.to_string() + ")",
        self.cur_span(),
      ),
    )
  }
  Ok(())
}

fn Parser::enter_span(self : Parser, span : Span) -> Result[Unit, HclError] {
  self.depth = self.depth + 1
  if self.depth > self.eff_max_depth {
    return Err(
      HclError::new(
        HclErrorKind::LimitExceeded,
        "maximum nesting depth exceeded (" + self.limits.max_depth.to_string() + ")",
        span,
      ),
    )
  }
  Ok(())
}

fn Parser::leave(self : Parser) -> Unit {
  if self.depth > 0 {
    self.depth = self.depth - 1
  }
}

fn parse_hcl_number(raw : String, span : Span) -> Result[HclValue, HclError] {
  // Fast integer path for common decimal integers (1..15 digits, exact in IEEE Double)
  let n = raw.length()
  let mut is_plain_int = n > 0 && n <= 15
  let mut i = 0
  let mut acc : Int64 = 0L
  if is_plain_int {
    while i < n {
      let b = raw.code_unit_at(i)
      if b < 48 || b > 57 {
        is_plain_int = false
        break
      }
      acc = acc * 10L + (b - 48).to_int64()
      i = i + 1
    }
  }
  if is_plain_int {
    return Ok(HclValue::Number(acc.to_double()))
  }
  match BigDec::parse(raw) {
    Some(bd) => Ok(HclValue::Decimal(bd))
    None => Err(HclError::new(HclErrorKind::SyntaxError, "invalid number literal: " + raw, span))
  }
}

fn is_digits_only(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return false
    }
    i = i + 1
  }
  true
}

///| Parse an HCL2 body until `RBrace` (if `stop_at_rbrace`) or `Eof`.
fn Parser::parse_body(self : Parser, stop_at_rbrace : Bool) -> Result[Body, HclError] {
  let start = self.cur_start_pos()
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let attributes : Array[Attribute] = []
  let blocks : Array[Block] = []
  let mut attr_map : Option[Map[String, Bool]] = None

  while true {
    self.skip_newlines()
    let tag = self.cur_tag()
    if tag == TOK_IDENT {
      let name = self.cur_str()
      let name_span = self.cur_span()
      self.consume()
      let next_tag = self.cur_tag()
      if next_tag == TOK_EQUAL {
        // Check duplicate attribute in this body
        let alen = attributes.length()
        if alen < 16 {
          let mut k = 0
          while k < alen {
            if attributes[k].name == name {
              self.leave()
              return Err(
                HclError::new(
                  HclErrorKind::DuplicateAttribute,
                  "duplicate attribute `" + name + "`",
                  name_span,
                ),
              )
            }
            k = k + 1
          }
        } else {
          let m = match attr_map {
            Some(existing) => existing
            None => {
              let nm : Map[String, Bool] = Map::new()
              let mut k = 0
              while k < alen {
                nm.set(attributes[k].name, true)
                k = k + 1
              }
              attr_map = Some(nm)
              nm
            }
          }
          if m.contains(name) {
            self.leave()
            return Err(
              HclError::new(
                HclErrorKind::DuplicateAttribute,
                "duplicate attribute `" + name + "`",
                name_span,
              ),
            )
          }
          m.set(name, true)
        }
        self.consume() // consume '='
        let expr_id = match self.parse_expr() {
          Ok(id) => id
          Err(e) => {
            self.leave()
            return Err(e)
          }
        }
        let end_pos = self.cur_start_pos()
        let after_tag = self.cur_tag()
        if after_tag == TOK_NEWLINE {
          self.consume()
        } else if after_tag != TOK_EOF {
          self.leave()
          return Err(self.syntax_err("expected newline after attribute expression"))
        }
        attributes.push(
          Attribute::{
            name: name,
            expr: expr_id,
            name_span: name_span,
            span: Span::new(name_span.start, end_pos),
          },
        )
      } else {
        // Block: type label* { body }
        let labels : Array[String] = []
        while true {
          let lt = self.cur_tag()
          if lt == TOK_LBRACE {
            break
          } else if lt == TOK_PLAIN_STRING || lt == TOK_IDENT {
            labels.push(self.cur_str())
            self.consume()
          } else if lt == TOK_OQUOTE {
            let lbl_s = match self.parse_simple_string_label() {
              Ok(s) => s
              Err(e) => {
                self.leave()
                return Err(e)
              }
            }
            labels.push(lbl_s)
          } else {
            self.leave()
            return Err(self.syntax_err("expected block label or `{` after block type `" + name + "`"))
          }
        }
        let open_end = self.cur_end_pos()
        self.consume() // consume '{'
        let body_tag = self.cur_tag()
        let block_body = if body_tag == TOK_NEWLINE {
          match self.parse_body(true) {
            Ok(b) => b
            Err(e) => {
              self.leave()
              return Err(e)
            }
          }
        } else if body_tag == TOK_RBRACE {
          Body::{ attributes: [], blocks: [], span: Span::new(open_end, self.cur_start_pos()) }
        } else if body_tag == TOK_IDENT {
          let attr_name = self.cur_str()
          let an_span = self.cur_span()
          self.consume()
          if self.cur_tag() == TOK_EQUAL {
            self.consume()
            let eid = match self.parse_expr() {
              Ok(id) => id
              Err(e) => {
                self.leave()
                return Err(e)
              }
            }
            let attr_end = self.cur_start_pos()
            if self.cur_tag() != TOK_RBRACE {
              self.leave()
              return Err(self.syntax_err("expected `}` closing one-line block"))
            }
            let one_attr = Attribute::{
              name: attr_name,
              expr: eid,
              name_span: an_span,
              span: Span::new(an_span.start, attr_end),
            }
            Body::{ attributes: [one_attr], blocks: [], span: Span::new(open_end, attr_end) }
          } else {
            self.leave()
            return Err(self.syntax_err("one-line block may only contain a single attribute assignment"))
          }
        } else {
          self.leave()
          return Err(self.syntax_err("expected newline or attribute in block body"))
        }
        let close_end = self.cur_end_pos()
        self.consume() // consume '}'
        let post_tag = self.cur_tag()
        if post_tag == TOK_NEWLINE {
          self.consume()
        } else if post_tag != TOK_EOF {
          self.leave()
          return Err(self.syntax_err("expected newline after block closing `}`"))
        }
        blocks.push(
          Block::{
            block_type: name,
            labels: labels,
            body: block_body,
            type_span: name_span,
            span: Span::new(name_span.start, close_end),
          },
        )
      }
    } else if tag == TOK_RBRACE {
      if stop_at_rbrace {
        break
      }
      self.leave()
      return Err(HclError::new(HclErrorKind::SyntaxError, "unexpected `}` at top level", self.cur_span()))
    } else if tag == TOK_EOF {
      if stop_at_rbrace {
        self.leave()
        return Err(
          HclError::new(HclErrorKind::SyntaxError, "unterminated block (expected `}`)", self.cur_span()),
        )
      }
      break
    } else {
      self.leave()
      return Err(self.syntax_err("expected attribute name or block type"))
    }
  }
  self.leave()
  Ok(Body::{ attributes: attributes, blocks: blocks, span: Span::new(start, self.cur_end_pos()) })
}

fn Parser::parse_simple_string_label(self : Parser) -> Result[String, HclError] {
  let open_span = self.cur_span()
  self.consume() // OQuote
  let t0 = self.cur_tag()
  if t0 == TOK_CQUOTE {
    self.consume()
    return Ok("")
  }
  if t0 == TOK_QUOTED_LIT {
    let s0 = self.cur_str()
    self.consume()
    if self.cur_tag() == TOK_CQUOTE {
      self.consume()
      return Ok(s0)
    }
    if self.cur_tag() == TOK_ERR {
      return Err(self.take_lex_err())
    }
    let sb = StringBuilder::with_capacity(s0.length() + 16)
    sb.write_string(s0)
    while true {
      let tk = self.cur_tag()
      if tk == TOK_CQUOTE {
        self.consume()
        return Ok(sb.to_string())
      } else if tk == TOK_QUOTED_LIT {
        sb.write_string(self.cur_str())
        self.consume()
      } else if tk == TOK_ERR {
        return Err(self.take_lex_err())
      } else {
        return Err(
          HclError::new(
            HclErrorKind::SyntaxError,
            "block labels cannot contain template interpolations",
            open_span,
          ),
        )
      }
    }
  }
  if t0 == TOK_ERR {
    return Err(self.take_lex_err())
  }
  Err(
    HclError::new(
      HclErrorKind::SyntaxError,
      "block labels cannot contain template interpolations",
      open_span,
    ),
  )
}

fn tok_binop_prec(tag : Int) -> Int {
  if tag == TOK_OROR {
    1
  } else if tag == TOK_ANDAND {
    2
  } else if tag == TOK_EQEQ || tag == TOK_BANGEQ {
    3
  } else if tag >= TOK_LT && tag <= TOK_GTEQ {
    4
  } else if tag == TOK_PLUS || tag == TOK_MINUS {
    5
  } else {
    6
  }
}

fn tok_to_binop(tag : Int) -> BinOp {
  if tag == TOK_OROR {
    BinOp::Or
  } else if tag == TOK_ANDAND {
    BinOp::And
  } else if tag == TOK_EQEQ {
    BinOp::Eq
  } else if tag == TOK_BANGEQ {
    BinOp::Ne
  } else if tag == TOK_LT {
    BinOp::Lt
  } else if tag == TOK_LTEQ {
    BinOp::Le
  } else if tag == TOK_GT {
    BinOp::Gt
  } else if tag == TOK_GTEQ {
    BinOp::Ge
  } else if tag == TOK_PLUS {
    BinOp::Add
  } else if tag == TOK_MINUS {
    BinOp::Sub
  } else if tag == TOK_STAR {
    BinOp::Mul
  } else if tag == TOK_SLASH {
    BinOp::Div
  } else {
    BinOp::Mod
  }
}

fn Parser::parse_expr(self : Parser) -> Result[Int, HclError] {
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let res = self.parse_conditional()
  self.leave()
  res
}

fn Parser::parse_conditional(self : Parser) -> Result[Int, HclError] {
  let cond = match self.parse_binop(1) {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  self.skip_bracket_newlines()
  if self.cur_tag() == TOK_QUESTION {
    let q_span = self.cur_span()
    self.consume()
    self.skip_newlines()
    let true_expr = match self.parse_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    self.skip_newlines()
    if self.cur_tag() != TOK_COLON {
      return Err(self.syntax_err("expected `:` in conditional expression"))
    }
    self.consume()
    self.skip_newlines()
    let false_expr = match self.parse_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    Ok(self.push_node(ExprNode::Conditional(cond, true_expr, false_expr, q_span)))
  } else {
    Ok(cond)
  }
}

fn Parser::parse_binop(self : Parser, min_prec : Int) -> Result[Int, HclError] {
  let mut left = match self.parse_unary() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while true {
    self.skip_bracket_newlines()
    let tag = self.cur_tag()
    if tag < TOK_OROR || tag > TOK_PERCENT {
      break
    }
    let prec = tok_binop_prec(tag)
    if prec < min_prec {
      break
    }
    let op = tok_to_binop(tag)
    let op_span = self.cur_span()
    self.consume()
    self.skip_bracket_newlines()
    let mut right = match self.parse_unary() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    while true {
      self.skip_bracket_newlines()
      let ntag = self.cur_tag()
      if ntag < TOK_OROR || ntag > TOK_PERCENT {
        break
      }
      let next_prec = tok_binop_prec(ntag)
      if next_prec > prec {
        let nop = tok_to_binop(ntag)
        let nop_span = self.cur_span()
        self.consume()
        self.skip_bracket_newlines()
        let rr = match self.parse_binop(next_prec + 1) {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        right = self.push_node(ExprNode::Binary(nop, right, rr, nop_span))
      } else {
        break
      }
    }
    left = self.push_node(ExprNode::Binary(op, left, right, op_span))
  }
  Ok(left)
}

fn Parser::parse_unary(self : Parser) -> Result[Int, HclError] {
  let tag = self.cur_tag()
  if tag == TOK_MINUS {
    let span = self.cur_span()
    self.consume()
    match self.enter_span(span) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let inner = match self.parse_unary() {
      Ok(id) => id
      Err(e) => {
        self.leave()
        return Err(e)
      }
    }
    self.leave()
    Ok(self.push_node(ExprNode::Unary(UnaryOp::Neg, inner, span)))
  } else if tag == TOK_BANG {
    let span = self.cur_span()
    self.consume()
    match self.enter_span(span) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let inner = match self.parse_unary() {
      Ok(id) => id
      Err(e) => {
        self.leave()
        return Err(e)
      }
    }
    self.leave()
    Ok(self.push_node(ExprNode::Unary(UnaryOp::Not, inner, span)))
  } else {
    self.parse_postfix()
  }
}

fn Parser::parse_legacy_index_node(self : Parser, num : String, sp : Span) -> Result[Int, HclError] {
  if !is_digits_only(num) {
    return Err(
      HclError::new(
        HclErrorKind::SyntaxError,
        "legacy index traversal requires a non-negative integer, got `" + num + "`",
        sp,
      ),
    )
  }
  let idx_val = match parse_hcl_number(num, sp) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok(self.push_node(ExprNode::LitNumber(idx_val, num, sp)))
}

fn Parser::parse_splat_substeps(self : Parser, full : Bool) -> Result[Array[TraversalStep], HclError] {
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let sub : Array[TraversalStep] = []
  while true {
    let tag = self.cur_tag()
    if tag == TOK_DOT {
      let dot_start = self.cur_start_pos()
      self.consume()
      let nt = self.cur_tag()
      if nt == TOK_IDENT {
        let a = self.cur_str()
        let sp = self.cur_span()
        self.consume()
        sub.push(TraversalStep::GetAttr(a, sp))
      } else if nt == TOK_NUMBER {
        let num = self.cur_str()
        let sp = self.cur_span()
        self.consume()
        let idx_n = match self.parse_legacy_index_node(num, sp) {
          Ok(id) => id
          Err(e) => {
            self.leave()
            return Err(e)
          }
        }
        sub.push(TraversalStep::Index(idx_n, sp))
      } else if nt == TOK_STAR {
        let s_end = self.cur_end_pos()
        self.consume()
        let nested = match self.parse_splat_substeps(false) {
          Ok(ns) => ns
          Err(e) => {
            self.leave()
            return Err(e)
          }
        }
        sub.push(TraversalStep::AttrSplat(nested, Span::new(dot_start, s_end)))
      } else {
        self.leave()
        return Err(self.syntax_err("expected attribute name after `.` in splat"))
      }
    } else if tag == TOK_LBRACKET {
      if !full {
        break
      }
      if self.peek_tag(1) == TOK_STAR && self.peek_tag(2) == TOK_RBRACKET {
        let nlb_start = self.cur_start_pos()
        self.consume() // [
        self.consume() // *
        let nrb_end = self.cur_end_pos()
        self.consume() // ]
        let nested = match self.parse_splat_substeps(true) {
          Ok(ns) => ns
          Err(e) => {
            self.leave()
            return Err(e)
          }
        }
        sub.push(TraversalStep::FullSplat(nested, Span::new(nlb_start, nrb_end)))
        break
      }
      let idx_lb_start = self.cur_start_pos()
      self.consume()
      self.bracket_depth = self.bracket_depth + 1
      self.skip_newlines()
      let idx_expr = match self.parse_expr() {
        Ok(id) => id
        Err(e) => {
          self.bracket_depth = self.bracket_depth - 1
          self.leave()
          return Err(e)
        }
      }
      self.skip_newlines()
      self.bracket_depth = self.bracket_depth - 1
      if self.cur_tag() == TOK_RBRACKET {
        let idx_rb_end = self.cur_end_pos()
        self.consume()
        sub.push(TraversalStep::Index(idx_expr, Span::new(idx_lb_start, idx_rb_end)))
      } else {
        self.leave()
        return Err(self.syntax_err("expected `]` after index expression"))
      }
    } else {
      break
    }
  }
  self.leave()
  Ok(sub)
}

fn Parser::parse_postfix(self : Parser) -> Result[Int, HclError] {
  let base = match self.parse_primary() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let tag0 = self.cur_tag()
  if tag0 != TOK_DOT && tag0 != TOK_LBRACKET {
    return Ok(base)
  }
  let steps : Array[TraversalStep] = []
  let start = self.cur_start_pos()
  while true {
    let tag = self.cur_tag()
    if tag == TOK_DOT {
      let dot_start = self.cur_start_pos()
      self.consume()
      let nt = self.cur_tag()
      if nt == TOK_IDENT {
        let attr = self.cur_str()
        let sp = self.cur_span()
        self.consume()
        steps.push(TraversalStep::GetAttr(attr, sp))
      } else if nt == TOK_NUMBER {
        let num = self.cur_str()
        let sp = self.cur_span()
        self.consume()
        let idx_node = match self.parse_legacy_index_node(num, sp) {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        steps.push(TraversalStep::Index(idx_node, sp))
      } else if nt == TOK_STAR {
        let s_end = self.cur_end_pos()
        self.consume()
        let sub = match self.parse_splat_substeps(false) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        steps.push(TraversalStep::AttrSplat(sub, Span::new(dot_start, s_end)))
      } else {
        return Err(self.syntax_err("expected attribute name, index, or `*` after `.`"))
      }
    } else if tag == TOK_LBRACKET {
      if self.peek_tag(1) == TOK_STAR && self.peek_tag(2) == TOK_RBRACKET {
        let lb_start = self.cur_start_pos()
        self.consume() // [
        self.consume() // *
        let rb_end = self.cur_end_pos()
        self.consume() // ]
        let sub = match self.parse_splat_substeps(true) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        steps.push(TraversalStep::FullSplat(sub, Span::new(lb_start, rb_end)))
      } else {
        let lb_start = self.cur_start_pos()
        self.consume()
        self.bracket_depth = self.bracket_depth + 1
        self.skip_newlines()
        let idx_expr = match self.parse_expr() {
          Ok(id) => id
          Err(e) => {
            self.bracket_depth = self.bracket_depth - 1
            return Err(e)
          }
        }
        self.skip_newlines()
        self.bracket_depth = self.bracket_depth - 1
        if self.cur_tag() == TOK_RBRACKET {
          let rb_end = self.cur_end_pos()
          self.consume()
          steps.push(TraversalStep::Index(idx_expr, Span::new(lb_start, rb_end)))
        } else {
          return Err(self.syntax_err("expected `]` after index expression"))
        }
      }
    } else {
      break
    }
  }
  Ok(self.push_node(ExprNode::Traversal(base, steps, Span::new(start, self.cur_end_pos()))))
}

fn Parser::parse_primary(self : Parser) -> Result[Int, HclError] {
  let tag = self.cur_tag()
  if tag == TOK_PLAIN_STRING {
    let s = self.cur_str()
    let sp = self.cur_span()
    self.consume()
    return Ok(self.push_node(ExprNode::LitString(s, sp)))
  }
  if tag == TOK_OQUOTE {
    return self.parse_quoted_template()
  }
  if tag == TOK_IDENT {
    let name = self.cur_str()
    let sp = self.cur_span()
    self.consume()
    if name == "true" {
      return Ok(self.push_node(ExprNode::LitBool(true, sp)))
    }
    if name == "false" {
      return Ok(self.push_node(ExprNode::LitBool(false, sp)))
    }
    if name == "null" {
      return Ok(self.push_node(ExprNode::LitNull(sp)))
    }
    if self.cur_tag() == TOK_LPAREN {
      return self.parse_func_call(name, sp)
    }
    return Ok(self.push_node(ExprNode::ScopeVar(name, sp)))
  }
  if tag == TOK_NUMBER {
    let raw = self.cur_str()
    let sp = self.cur_span()
    self.consume()
    let nv = match parse_hcl_number(raw, sp) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(self.push_node(ExprNode::LitNumber(nv, raw, sp)))
  }
  if tag == TOK_LBRACE {
    return self.parse_object_or_for_object()
  }
  if tag == TOK_OHEREDOC {
    let marker = self.cur_str()
    let indented = self.cur_flag()
    return self.parse_heredoc_template(marker, indented)
  }
  if tag == TOK_LBRACKET {
    return self.parse_tuple_or_for_tuple()
  }
  if tag == TOK_LPAREN {
    let lp_start = self.cur_start_pos()
    self.consume()
    self.bracket_depth = self.bracket_depth + 1
    self.skip_newlines()
    let inner = match self.parse_expr() {
      Ok(id) => id
      Err(e) => {
        self.bracket_depth = self.bracket_depth - 1
        return Err(e)
      }
    }
    self.skip_newlines()
    self.bracket_depth = self.bracket_depth - 1
    if self.cur_tag() == TOK_RPAREN {
      let rp_end = self.cur_end_pos()
      self.consume()
      return Ok(self.push_node(ExprNode::Parentheses(inner, Span::new(lp_start, rp_end))))
    }
    return Err(self.syntax_err("expected closing `)`"))
  }
  if tag == TOK_ERR {
    return Err(self.take_lex_err())
  }
  Err(
    HclError::new(
      HclErrorKind::SyntaxError,
      "unexpected token `" + self.cur_raw() + "` in expression",
      self.cur_span(),
    ),
  )
}

fn Parser::parse_func_call(self : Parser, name : String, name_span : Span) -> Result[Int, HclError] {
  self.consume() // '('
  self.bracket_depth = self.bracket_depth + 1
  let args : Array[Int] = []
  let mut expand_final = false
  self.skip_newlines()
  if self.cur_tag() == TOK_RPAREN {
    let rp_end = self.cur_end_pos()
    self.consume()
    self.bracket_depth = self.bracket_depth - 1
    return Ok(self.push_node(ExprNode::FuncCall(name, args, false, Span::new(name_span.start, rp_end))))
  }
  while true {
    self.skip_newlines()
    let arg = match self.parse_expr() {
      Ok(id) => id
      Err(e) => {
        self.bracket_depth = self.bracket_depth - 1
        return Err(e)
      }
    }
    args.push(arg)
    self.skip_newlines()
    if self.cur_tag() == TOK_ELLIPSIS {
      self.consume()
      expand_final = true
      self.skip_newlines()
    }
    let sep = self.cur_tag()
    if sep == TOK_COMMA {
      self.consume()
      self.skip_newlines()
      if self.cur_tag() == TOK_RPAREN {
        let rp_end = self.cur_end_pos()
        self.consume()
        self.bracket_depth = self.bracket_depth - 1
        return Ok(
          self.push_node(ExprNode::FuncCall(name, args, expand_final, Span::new(name_span.start, rp_end))),
        )
      }
      if expand_final {
        self.bracket_depth = self.bracket_depth - 1
        return Err(self.syntax_err("`...` expansion is only allowed on the final function argument"))
      }
    } else if sep == TOK_RPAREN {
      let rp_end = self.cur_end_pos()
      self.consume()
      self.bracket_depth = self.bracket_depth - 1
      return Ok(
        self.push_node(ExprNode::FuncCall(name, args, expand_final, Span::new(name_span.start, rp_end))),
      )
    } else {
      self.bracket_depth = self.bracket_depth - 1
      return Err(self.syntax_err("expected `,` or `)` in function call arguments"))
    }
  }
  self.bracket_depth = self.bracket_depth - 1
  Err(HclError::new(HclErrorKind::SyntaxError, "unterminated function call", name_span))
}

fn Parser::parse_tuple_or_for_tuple(self : Parser) -> Result[Int, HclError] {
  let lb_span = self.cur_span()
  self.consume() // '['
  self.bracket_depth = self.bracket_depth + 1
  self.skip_newlines()
  if self.cur_tag() == TOK_IDENT && self.cur_str() == "for" {
    let res = self.parse_for_tuple(lb_span)
    self.bracket_depth = self.bracket_depth - 1
    return res
  }
  let items : Array[Int] = []
  while true {
    self.skip_newlines()
    if self.cur_tag() == TOK_RBRACKET {
      let rb_end = self.cur_end_pos()
      self.consume()
      self.bracket_depth = self.bracket_depth - 1
      return Ok(self.push_node(ExprNode::TupleCons(items, Span::new(lb_span.start, rb_end))))
    }
    let item = match self.parse_expr() {
      Ok(id) => id
      Err(e) => {
        self.bracket_depth = self.bracket_depth - 1
        return Err(e)
      }
    }
    items.push(item)
    self.skip_newlines()
    let sep = self.cur_tag()
    if sep == TOK_COMMA {
      self.consume()
    } else if sep != TOK_RBRACKET {
      self.bracket_depth = self.bracket_depth - 1
      return Err(self.syntax_err("expected `,` or `]` in tuple literal"))
    }
  }
  self.bracket_depth = self.bracket_depth - 1
  Err(HclError::new(HclErrorKind::SyntaxError, "unterminated tuple literal", lb_span))
}

fn Parser::parse_for_intro(self : Parser) -> Result[(Option[String], String, Int), HclError] {
  self.consume() // 'for'
  self.skip_newlines()
  if self.cur_tag() != TOK_IDENT {
    return Err(self.syntax_err("expected loop variable name after `for`"))
  }
  let first = self.cur_str()
  self.consume()
  self.skip_newlines()
  let mut key_var : Option[String] = None
  let mut val_var = first
  if self.cur_tag() == TOK_COMMA {
    self.consume()
    self.skip_newlines()
    if self.cur_tag() != TOK_IDENT {
      return Err(self.syntax_err("expected value variable name after `,` in `for`"))
    }
    key_var = Some(first)
    val_var = self.cur_str()
    self.consume()
  }
  self.skip_newlines()
  if self.cur_tag() != TOK_IDENT || self.cur_str() != "in" {
    return Err(self.syntax_err("expected `in` in `for` expression"))
  }
  self.consume()
  self.skip_newlines()
  let coll = match self.parse_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  Ok((key_var, val_var, coll))
}

fn Parser::parse_for_tuple(self : Parser, start_span : Span) -> Result[Int, HclError] {
  let (key_var, val_var, coll) = match self.parse_for_intro() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  self.skip_newlines()
  if self.cur_tag() != TOK_COLON {
    return Err(self.syntax_err("expected `:` in `for` expression"))
  }
  self.consume()
  self.skip_newlines()
  let val_expr = match self.parse_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  self.skip_newlines()
  let mut cond_expr : Option[Int] = None
  if self.cur_tag() == TOK_IDENT && self.cur_str() == "if" {
    self.consume()
    self.skip_newlines()
    let c = match self.parse_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    cond_expr = Some(c)
    self.skip_newlines()
  }
  if self.cur_tag() == TOK_RBRACKET {
    let rb_end = self.cur_end_pos()
    self.consume()
    Ok(
      self.push_node(
        ExprNode::ForTuple(key_var, val_var, coll, val_expr, cond_expr, Span::new(start_span.start, rb_end)),
      ),
    )
  } else {
    Err(self.syntax_err("expected `]` closing `for` expression"))
  }
}

fn Parser::parse_object_or_for_object(self : Parser) -> Result[Int, HclError] {
  let lb_span = self.cur_span()
  self.consume() // '{'
  self.skip_newlines()
  // Check for `{for ...}` (not `{ for = 1 }`!)
  if self.cur_tag() == TOK_IDENT && self.cur_str() == "for" {
    let t1 = self.peek_tag(1)
    if t1 != TOK_EQUAL && t1 != TOK_COLON {
      return self.parse_for_object(lb_span)
    }
  }
  let items : Array[ObjectItem] = []
  while true {
    self.skip_newlines()
    if self.cur_tag() == TOK_RBRACE {
      let rb_end = self.cur_end_pos()
      self.consume()
      return Ok(self.push_node(ExprNode::ObjectCons(items, Span::new(lb_span.start, rb_end))))
    }
    let item_start = self.cur_start_pos()
    let mut force_eval_key = false
    let key_expr = if self.cur_tag() == TOK_IDENT {
      let t1 = self.peek_tag(1)
      if t1 == TOK_EQUAL || t1 == TOK_COLON {
        let k = self.cur_str()
        let ksp = self.cur_span()
        self.consume()
        self.push_node(ExprNode::LitString(k, ksp))
      } else {
        if t1 == TOK_DOT || t1 == TOK_LBRACKET {
          return Err(
            HclError::new(
              HclErrorKind::SyntaxError,
              "object key traversal must be wrapped in parentheses `(...)`",
              self.cur_span(),
            ),
          )
        }
        force_eval_key = true
        match self.parse_expr() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
      }
    } else {
      force_eval_key = true
      match self.parse_expr() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
    }
    let eq_tag = self.cur_tag()
    if eq_tag == TOK_EQUAL || eq_tag == TOK_COLON {
      self.consume()
    } else {
      return Err(self.syntax_err("expected `=` or `:` after object key"))
    }
    self.skip_newlines()
    let val_expr = match self.parse_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    let item_end = self.cur_start_pos()
    items.push(
      ObjectItem::{
        key_expr: key_expr,
        val_expr: val_expr,
        force_eval_key: force_eval_key,
        span: Span::new(item_start, item_end),
      },
    )
    let sep = self.cur_tag()
    if sep == TOK_COMMA || sep == TOK_NEWLINE {
      self.consume()
    } else if sep != TOK_RBRACE {
      return Err(self.syntax_err("expected `,`, newline, or `}` after object item"))
    }
  }
  Err(HclError::new(HclErrorKind::SyntaxError, "unterminated object literal", lb_span))
}

fn Parser::parse_for_object(self : Parser, start_span : Span) -> Result[Int, HclError] {
  let (key_var, val_var, coll) = match self.parse_for_intro() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  self.skip_newlines()
  if self.cur_tag() != TOK_COLON {
    return Err(self.syntax_err("expected `:` in object `for` expression"))
  }
  self.consume()
  self.skip_newlines()
  let key_expr = match self.parse_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  self.skip_newlines()
  if self.cur_tag() != TOK_FATARROW {
    return Err(self.syntax_err("expected `=>` in object `for` expression"))
  }
  self.consume()
  self.skip_newlines()
  let val_expr = match self.parse_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let mut group = false
  if self.cur_tag() == TOK_ELLIPSIS {
    self.consume()
    group = true
  }
  self.skip_newlines()
  let mut cond_expr : Option[Int] = None
  if self.cur_tag() == TOK_IDENT && self.cur_str() == "if" {
    self.consume()
    self.skip_newlines()
    let c = match self.parse_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    cond_expr = Some(c)
    self.skip_newlines()
  }
  if self.cur_tag() == TOK_RBRACE {
    let rb_end = self.cur_end_pos()
    self.consume()
    Ok(
      self.push_node(
        ExprNode::ForObject(
          key_var,
          val_var,
          coll,
          key_expr,
          val_expr,
          group,
          cond_expr,
          Span::new(start_span.start, rb_end),
        ),
      ),
    )
  } else {
    Err(self.syntax_err("expected `}` closing object `for` expression"))
  }
}

// Template parsing (`"..."`, `<<EOF`, `<<-EOF`, and standalone templates)

fn Parser::parse_quoted_template(self : Parser) -> Result[Int, HclError] {
  let open_start = self.cur_start_pos()
  self.consume() // OQuote
  // Fast path: empty string `""` or plain string `"..."` with no interpolations/directives
  let t0 = self.cur_tag()
  if t0 == TOK_CQUOTE {
    let close_end = self.cur_end_pos()
    self.consume()
    return Ok(self.push_node(ExprNode::LitString("", Span::new(open_start, close_end))))
  }
  if t0 == TOK_QUOTED_LIT && self.peek_tag(1) == TOK_CQUOTE {
    let s = self.cur_str()
    self.consume()
    let close_end = self.cur_end_pos()
    self.consume()
    return Ok(self.push_node(ExprNode::LitString(s, Span::new(open_start, close_end))))
  }
  let parts = match self.parse_template_parts(true, false, "") {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  if self.cur_tag() == TOK_CQUOTE {
    let close_end = self.cur_end_pos()
    self.consume()
    if parts.length() == 0 {
      return Ok(self.push_node(ExprNode::LitString("", Span::new(open_start, close_end))))
    }
    if parts.length() == 1 {
      match parts[0] {
        TemplatePart::Literal(s, _) =>
        return Ok(self.push_node(ExprNode::LitString(s, Span::new(open_start, close_end))))
        _ => ()
      }
    }
    Ok(self.push_node(ExprNode::Template(parts, true, Span::new(open_start, close_end))))
  } else {
    Err(self.syntax_err("expected closing `\"` for template string"))
  }
}

fn Parser::parse_heredoc_template(self : Parser, marker : String, indented : Bool) -> Result[Int, HclError] {
  let open_start = self.cur_start_pos()
  self.consume() // OHeredoc
  let raw_parts = match self.parse_template_parts(false, true, marker) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  if self.cur_tag() == TOK_CHEREDOC {
    let close_end = self.cur_end_pos()
    self.consume()
    let parts = if indented { dedent_heredoc_parts(raw_parts) } else { raw_parts }
    if parts.length() == 0 {
      return Ok(self.push_node(ExprNode::LitString("", Span::new(open_start, close_end))))
    }
    if parts.length() == 1 {
      match parts[0] {
        TemplatePart::Literal(s, _) =>
        return Ok(self.push_node(ExprNode::LitString(s, Span::new(open_start, close_end))))
        _ => ()
      }
    }
    Ok(self.push_node(ExprNode::Template(parts, false, Span::new(open_start, close_end))))
  } else {
    Err(self.syntax_err("unterminated heredoc `" + marker + "`"))
  }
}

///| Strip minimum common leading whitespace from non-empty lines in an indented heredoc (`<<-EOF`).
fn dedent_heredoc_parts(parts : Array[TemplatePart]) -> Array[TemplatePart] {
  // Pass 1: find minimum leading whitespace (spaces/tabs) on non-empty lines across top-level literals
  let mut min_indent = -1
  let mut at_line_start = true
  let mut i = 0
  let plen = parts.length()
  while i < plen {
    match parts[i] {
      TemplatePart::Literal(s, _) => {
        let n = s.length()
        let mut j = 0
        while j < n {
          if at_line_start {
            let mut ws = 0
            while j + ws < n {
              let c = s.code_unit_at(j + ws)
              if c == 32 || c == 9 {
                ws = ws + 1
              } else {
                break
              }
            }
            if j + ws < n {
              let ch = s.code_unit_at(j + ws)
              if ch == 10 {
                j = j + ws + 1
                at_line_start = true
                continue
              }
              if ch == 13 && j + ws + 1 < n && s.code_unit_at(j + ws + 1) == 10 {
                j = j + ws + 2
                at_line_start = true
                continue
              }
            }
            if j + ws < n || i + 1 < plen {
              if min_indent < 0 || ws < min_indent {
                min_indent = ws
                if min_indent == 0 {
                  return parts
                }
              }
            }
            j = j + ws
            at_line_start = false
          } else {
            while j < n {
              if s.code_unit_at(j) == 10 {
                j = j + 1
                at_line_start = true
                break
              }
              j = j + 1
            }
          }
        }
      }
      _ => {
        if at_line_start {
          return parts
        }
      }
    }
    i = i + 1
  }
  if min_indent <= 0 {
    return parts
  }
  // Pass 2: strip min_indent leading spaces/tabs from non-whitespace-only lines using line-slice copies
  let out : Array[TemplatePart] = Array::with_capacity(plen)
  at_line_start = true
  i = 0
  while i < plen {
    match parts[i] {
      TemplatePart::Literal(s, span) => {
        let n = s.length()
        let sb = StringBuilder::with_capacity(n)
        let mut j = 0
        while j < n {
          if at_line_start {
            let mut ws = 0
            while j + ws < n {
              let c = s.code_unit_at(j + ws)
              if c == 32 || c == 9 {
                ws = ws + 1
              } else {
                break
              }
            }
            let is_ws_only_line = j + ws < n && (s.code_unit_at(j + ws) == 10 || (s.code_unit_at(j + ws) == 13 && j + ws + 1 < n && s.code_unit_at(j + ws + 1) == 10))
            if !is_ws_only_line {
              let skip = if ws < min_indent { ws } else { min_indent }
              j = j + skip
            }
            at_line_start = false
          }
          let line_start = j
          while j < n {
            if s.code_unit_at(j) == 10 {
              j = j + 1
              at_line_start = true
              break
            }
            j = j + 1
          }
          if j > line_start {
            sb.write_string(s.slice(line_start, j))
          }
        }
        out.push(TemplatePart::Literal(sb.to_string(), span))
      }
      other => {
        at_line_start = false
        out.push(other)
      }
    }
    i = i + 1
  }
  out
}

fn Parser::is_template_control_kw(self : Parser, kw1 : String, kw2 : String) -> Bool {
  if self.cur_tag() != TOK_TEMPLATE_CONTROL {
    return false
  }
  let s1 = self.slot_at(1)
  if self.buf_tag[s1] == TOK_IDENT {
    let s = self.buf_str[s1]
    s == kw1 || (kw2.length() > 0 && s == kw2)
  } else {
    false
  }
}

fn Parser::parse_template_parts(
  self : Parser,
  stop_cquote : Bool,
  stop_cheredoc : Bool,
  stop_kw : String,
) -> Result[Array[TemplatePart], HclError] {
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let parts : Array[TemplatePart] = []
  while true {
    let tag = self.cur_tag()
    if tag == TOK_EOF {
      break
    } else if tag == TOK_CQUOTE {
      if stop_cquote {
        break
      }
      self.leave()
      return Err(HclError::new(HclErrorKind::SyntaxError, "unexpected quote in template", self.cur_span()))
    } else if tag == TOK_CHEREDOC {
      if stop_cheredoc {
        break
      }
      self.leave()
      return Err(HclError::new(HclErrorKind::SyntaxError, "unexpected heredoc end", self.cur_span()))
    } else if tag == TOK_QUOTED_LIT || tag == TOK_STRING_LIT {
      let s = self.cur_str()
      let sp = self.cur_span()
      self.consume()
      parts.push(TemplatePart::Literal(s, sp))
    } else if tag == TOK_TEMPLATE_INTERP {
      let strip_left = self.cur_flag()
      let open_start = self.cur_start_pos()
      self.consume()
      self.skip_newlines()
      let expr_id = match self.parse_expr() {
        Ok(id) => id
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
      self.skip_newlines()
      if self.cur_tag() == TOK_TEMPLATE_SEQ_END {
        let strip_right = self.cur_flag()
        let close_end = self.cur_end_pos()
        self.consume()
        parts.push(TemplatePart::Interp(expr_id, strip_left, strip_right, Span::new(open_start, close_end)))
      } else {
        self.leave()
        return Err(self.syntax_err("expected `}` closing template interpolation"))
      }
    } else if tag == TOK_TEMPLATE_CONTROL {
      if stop_kw == "endif" && self.is_template_control_kw("else", "endif") {
        break
      }
      if stop_kw == "endif_only" && self.is_template_control_kw("endif", "") {
        break
      }
      if stop_kw == "endfor" && self.is_template_control_kw("endfor", "") {
        break
      }
      let strip_left = self.cur_flag()
      let open_start = self.cur_start_pos()
      self.consume() // %{
      if self.cur_tag() == TOK_IDENT {
        let kw = self.cur_str()
        if kw == "if" {
          self.consume()
          let cond = match self.parse_expr() {
            Ok(id) => id
            Err(e) => {
              self.leave()
              return Err(e)
            }
          }
          let open_strip_right = if self.cur_tag() == TOK_TEMPLATE_SEQ_END {
            let sr = self.cur_flag()
            self.consume()
            sr
          } else {
            self.leave()
            return Err(self.syntax_err("expected `}` after `%{if ...`"))
          }
          let true_parts = match self.parse_template_parts(stop_cquote, stop_cheredoc, "endif") {
            Ok(p) => p
            Err(e) => {
              self.leave()
              return Err(e)
            }
          }
          let mut false_parts : Array[TemplatePart] = []
          let mut has_else = false
          let mut else_strip_left = false
          let mut else_strip_right = false
          if self.is_template_control_kw("else", "") {
            has_else = true
            else_strip_left = self.cur_flag()
            self.consume() // %{
            self.consume() // else
            else_strip_right = if self.cur_tag() == TOK_TEMPLATE_SEQ_END {
              let sr = self.cur_flag()
              self.consume()
              sr
            } else {
              self.leave()
              return Err(self.syntax_err("expected `}` after `%{else`"))
            }
            false_parts = match self.parse_template_parts(stop_cquote, stop_cheredoc, "endif_only") {
              Ok(p) => p
              Err(e) => {
                self.leave()
                return Err(e)
              }
            }
          }
          if !self.is_template_control_kw("endif", "") {
            self.leave()
            return Err(self.syntax_err("expected `%{endif}` closing `%{if}`"))
          }
          let end_strip_left = self.cur_flag()
          self.consume() // %{
          self.consume() // endif
          let (end_strip_right, close_end) = if self.cur_tag() == TOK_TEMPLATE_SEQ_END {
            let sr = self.cur_flag()
            let ce = self.cur_end_pos()
            self.consume()
            (sr, ce)
          } else {
            self.leave()
            return Err(self.syntax_err("expected `}` after `%{endif`"))
          }
          let true_end_strip_left = if has_else { else_strip_left } else { end_strip_left }
          parts.push(
            TemplatePart::If(
              cond,
              true_parts,
              false_parts,
              strip_left,
              open_strip_right,
              true_end_strip_left,
              else_strip_right,
              end_strip_left,
              end_strip_right,
              Span::new(open_start, close_end),
            ),
          )
        } else if kw == "for" {
          let (kvar, vvar, coll) = match self.parse_for_intro() {
            Ok(v) => v
            Err(e) => {
              self.leave()
              return Err(e)
            }
          }
          let open_strip_right = if self.cur_tag() == TOK_TEMPLATE_SEQ_END {
            let sr = self.cur_flag()
            self.consume()
            sr
          } else {
            self.leave()
            return Err(self.syntax_err("expected `}` after `%{for ...`"))
          }
          let body_parts = match self.parse_template_parts(stop_cquote, stop_cheredoc, "endfor") {
            Ok(p) => p
            Err(e) => {
              self.leave()
              return Err(e)
            }
          }
          if !self.is_template_control_kw("endfor", "") {
            self.leave()
            return Err(self.syntax_err("expected `%{endfor}` closing `%{for}`"))
          }
          let end_strip_left = self.cur_flag()
          self.consume() // %{
          self.consume() // endfor
          let (end_strip_right, close_end) = if self.cur_tag() == TOK_TEMPLATE_SEQ_END {
            let sr = self.cur_flag()
            let ce = self.cur_end_pos()
            self.consume()
            (sr, ce)
          } else {
            self.leave()
            return Err(self.syntax_err("expected `}` after `%{endfor`"))
          }
          parts.push(
            TemplatePart::For(
              kvar,
              vvar,
              coll,
              body_parts,
              strip_left,
              open_strip_right,
              end_strip_left,
              end_strip_right,
              Span::new(open_start, close_end),
            ),
          )
        } else {
          self.leave()
          return Err(
            HclError::new(
              HclErrorKind::SyntaxError,
              "unexpected template directive `" + kw + "`",
              self.cur_span(),
            ),
          )
        }
      } else {
        self.leave()
        return Err(self.syntax_err("expected template directive keyword (`if`, `for`, `else`, `endif`, `endfor`)"))
      }
    } else {
      self.leave()
      return Err(self.syntax_err("unexpected token in template"))
    }
  }
  self.leave()
  Ok(parts)
}

///| Parse an HCL2 configuration file into an AST `File`.
pub fn parse_file_impl(src : String, limits : HclLimits) -> Result[File, HclError] {
  let lex = StreamLexer::new_fast(src, limits.max_depth)
  let p = Parser::new_stream(lex, limits, src.length() / 24)
  let body = match p.parse_body(false) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  Ok(File::{ body: body, nodes: p.nodes })
}

///| Parse a standalone HCL2 expression into an `ExprFile`.
pub fn parse_expr_impl(src : String, limits : HclLimits) -> Result[ExprFile, HclError] {
  let lex = StreamLexer::new_fast(src, limits.max_depth)
  let p = Parser::new_stream(lex, limits, 16)
  p.skip_newlines()
  let root = match p.parse_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  p.skip_newlines()
  let tag = p.cur_tag()
  if tag == TOK_EOF {
    Ok(ExprFile::{ root: root, nodes: p.nodes })
  } else if tag == TOK_ERR {
    Err(p.take_lex_err())
  } else {
    Err(
      HclError::new(
        HclErrorKind::SyntaxError,
        "unexpected trailing token `" + p.cur_raw() + "` after expression",
        p.cur_span(),
      ),
    )
  }
}

///| Parse a standalone unquoted HCL2 template into an `ExprFile`.
pub fn parse_template_impl(src : String, limits : HclLimits) -> Result[ExprFile, HclError] {
  let lex = StreamLexer::new_template(src, limits.max_depth)
  let p = Parser::new_stream(lex, limits, 16)
  let parts = match p.parse_template_parts(false, false, "") {
    Ok(ps) => ps
    Err(e) => return Err(e)
  }
  let root = if parts.length() == 0 {
    p.push_node(ExprNode::LitString("", Span::zero()))
  } else if parts.length() == 1 {
    match parts[0] {
      TemplatePart::Literal(s, sp) => p.push_node(ExprNode::LitString(s, sp))
      _ => p.push_node(ExprNode::Template(parts, true, Span::zero()))
    }
  } else {
    p.push_node(ExprNode::Template(parts, true, Span::zero()))
  }
  Ok(ExprFile::{ root: root, nodes: p.nodes })
}

fn string_has_template_seq(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i + 1 < n {
    let b = s.code_unit_at(i)
    let b1 = s.code_unit_at(i + 1)
    if (b == 36 || b == 37) && (b1 == 123 || b1 == b) {
      return true
    }
    i = i + 1
  }
  false
}

fn convert_json_string_to_expr(
  s : String,
  nodes : Array[ExprNode],
  limits : HclLimits,
) -> Result[Int, HclError] {
  if string_has_template_seq(s) {
    let tmpl = match parse_template_impl(s, limits) {
      Ok(ef) => ef
      Err(e) => return Err(e)
    }
    let base = nodes.length()
    let mut i = 0
    while i < tmpl.nodes.length() {
      nodes.push(remap_expr_node(tmpl.nodes[i], base))
      i = i + 1
    }
    Ok(base + tmpl.root)
  } else {
    let id = nodes.length()
    nodes.push(ExprNode::LitString(s, Span::zero()))
    Ok(id)
  }
}

fn convert_json_value_to_expr(
  v : HclValue,
  nodes : Array[ExprNode],
  limits : HclLimits,
  depth : Int,
) -> Result[Int, HclError] {
  let eff_depth = hcl_effective_max_depth(limits.max_depth)
  if depth > eff_depth {
    return Err(
      HclError::new(HclErrorKind::LimitExceeded, "maximum JSON nesting depth exceeded", Span::zero()),
    )
  }
  match v {
    HclValue::Null => {
      let id = nodes.length()
      nodes.push(ExprNode::LitNull(Span::zero()))
      Ok(id)
    }
    HclValue::Bool(b) => {
      let id = nodes.length()
      nodes.push(ExprNode::LitBool(b, Span::zero()))
      Ok(id)
    }
    HclValue::Number(_) | HclValue::Decimal(_) => {
      let id = nodes.length()
      nodes.push(ExprNode::LitNumber(v, "", Span::zero()))
      Ok(id)
    }
    HclValue::Str(s) => convert_json_string_to_expr(s, nodes, limits)
    HclValue::Tuple(items) => {
      let ids : Array[Int] = []
      let mut i = 0
      while i < items.length() {
        let cid = match convert_json_value_to_expr(items[i], nodes, limits, depth + 1) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        ids.push(cid)
        i = i + 1
      }
      let id = nodes.length()
      nodes.push(ExprNode::TupleCons(ids, Span::zero()))
      Ok(id)
    }
    HclValue::Object(entries) => {
      let obj_items : Array[ObjectItem] = []
      let mut i = 0
      while i < entries.length() {
        let (k, ev_item) = entries[i]
        let kid = match convert_json_string_to_expr(k, nodes, limits) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        let vid = match convert_json_value_to_expr(ev_item, nodes, limits, depth + 1) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        obj_items.push(
          ObjectItem::{
            key_expr: kid,
            val_expr: vid,
            force_eval_key: true,
            span: Span::zero(),
          },
        )
        i = i + 1
      }
      let id = nodes.length()
      nodes.push(ExprNode::ObjectCons(obj_items, Span::zero()))
      Ok(id)
    }
  }
}

fn remap_traversal_steps(steps : Array[TraversalStep], offset : Int) -> Array[TraversalStep] {
  let out : Array[TraversalStep] = []
  let mut i = 0
  while i < steps.length() {
    let s = match steps[i] {
      TraversalStep::GetAttr(a, sp) => TraversalStep::GetAttr(a, sp)
      TraversalStep::Index(e, sp) => TraversalStep::Index(e + offset, sp)
      TraversalStep::AttrSplat(sub, sp) => TraversalStep::AttrSplat(remap_traversal_steps(sub, offset), sp)
      TraversalStep::FullSplat(sub, sp) => TraversalStep::FullSplat(remap_traversal_steps(sub, offset), sp)
    }
    out.push(s)
    i = i + 1
  }
  out
}

fn remap_template_parts(parts : Array[TemplatePart], offset : Int) -> Array[TemplatePart] {
  let out : Array[TemplatePart] = []
  let mut i = 0
  while i < parts.length() {
    let p = match parts[i] {
      TemplatePart::Literal(s, sp) => TemplatePart::Literal(s, sp)
      TemplatePart::Interp(e, sl, sr, sp) => TemplatePart::Interp(e + offset, sl, sr, sp)
      TemplatePart::If(c, tp, fp, sl, osr, tesl, esr, esl, ensr, sp) =>
      TemplatePart::If(
        c + offset,
        remap_template_parts(tp, offset),
        remap_template_parts(fp, offset),
        sl,
        osr,
        tesl,
        esr,
        esl,
        ensr,
        sp,
      )
      TemplatePart::For(kv, vv, col, bp, sl, osr, esl, esr, sp) =>
      TemplatePart::For(
        kv,
        vv,
        col + offset,
        remap_template_parts(bp, offset),
        sl,
        osr,
        esl,
        esr,
        sp,
      )
    }
    out.push(p)
    i = i + 1
  }
  out
}

fn remap_expr_node(node : ExprNode, offset : Int) -> ExprNode {
  if offset == 0 {
    return node
  }
  match node {
    ExprNode::LitNull(sp) => ExprNode::LitNull(sp)
    ExprNode::LitBool(b, sp) => ExprNode::LitBool(b, sp)
    ExprNode::LitNumber(d, r, sp) => ExprNode::LitNumber(d, r, sp)
    ExprNode::LitString(s, sp) => ExprNode::LitString(s, sp)
    ExprNode::Template(ps, unwrap, sp) => ExprNode::Template(remap_template_parts(ps, offset), unwrap, sp)
    ExprNode::ScopeVar(n, sp) => ExprNode::ScopeVar(n, sp)
    ExprNode::Parentheses(e, sp) => ExprNode::Parentheses(e + offset, sp)
    ExprNode::Unary(op, e, sp) => ExprNode::Unary(op, e + offset, sp)
    ExprNode::Binary(op, l, r, sp) => ExprNode::Binary(op, l + offset, r + offset, sp)
    ExprNode::Conditional(c, t, f, sp) => ExprNode::Conditional(c + offset, t + offset, f + offset, sp)
    ExprNode::TupleCons(xs, sp) => {
      let out : Array[Int] = []
      let mut i = 0
      while i < xs.length() {
        out.push(xs[i] + offset)
        i = i + 1
      }
      ExprNode::TupleCons(out, sp)
    }
    ExprNode::ObjectCons(items, sp) => {
      let out : Array[ObjectItem] = []
      let mut i = 0
      while i < items.length() {
        let it = items[i]
        out.push(
          ObjectItem::{
            key_expr: it.key_expr + offset,
            val_expr: it.val_expr + offset,
            force_eval_key: it.force_eval_key,
            span: it.span,
          },
        )
        i = i + 1
      }
      ExprNode::ObjectCons(out, sp)
    }
    ExprNode::FuncCall(n, args, exp, sp) => {
      let out : Array[Int] = []
      let mut i = 0
      while i < args.length() {
        out.push(args[i] + offset)
        i = i + 1
      }
      ExprNode::FuncCall(n, out, exp, sp)
    }
    ExprNode::Traversal(base, steps, sp) =>
    ExprNode::Traversal(base + offset, remap_traversal_steps(steps, offset), sp)
    ExprNode::ForTuple(kv, vv, col, ve, ce, sp) => {
      let ce2 = match ce {
        Some(c) => Some(c + offset)
        None => None
      }
      ExprNode::ForTuple(kv, vv, col + offset, ve + offset, ce2, sp)
    }
    ExprNode::ForObject(kv, vv, col, ke, ve, grp, ce, sp) => {
      let ce2 = match ce {
        Some(c) => Some(c + offset)
        None => None
      }
      ExprNode::ForObject(kv, vv, col + offset, ke + offset, ve + offset, grp, ce2, sp)
    }
  }
}

///| Parse an HCL2 JSON-syntax configuration file (`.tf.json`) into an AST `File`.
pub fn parse_json_file_impl(src : String, limits : HclLimits) -> Result[File, HclError] {
  let root = match parse_strict_json_value(src, limits.max_depth, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match root {
    HclValue::Object(entries) => {
      let nodes : Array[ExprNode] = []
      let attributes : Array[Attribute] = []
      let mut i = 0
      while i < entries.length() {
        let (k, v) = entries[i]
        // Skip HCL JSON comment properties ("//")
        if k == "//" {
          i = i + 1
          continue
        }
        let eid = match convert_json_value_to_expr(v, nodes, limits, 1) {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        attributes.push(
          Attribute::{
            name: k,
            expr: eid,
            name_span: Span::zero(),
            span: Span::zero(),
          },
        )
        i = i + 1
      }
      Ok(File::{ body: Body::{ attributes: attributes, blocks: [], span: Span::zero() }, nodes: nodes })
    }
    _ =>
    Err(
      HclError::new(
        HclErrorKind::SyntaxError,
        "HCL JSON configuration root must be a JSON object",
        Span::zero(),
      ),
    )
  }
}
