///| Flat arena-indexed AST for HashiCorp HCL2 (`hclsyntax`).

///| Unary operators.
pub enum UnaryOp {
  Neg
  Not
}

///| Binary operators.
pub enum BinOp {
  Or
  And
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
  Add
  Sub
  Mul
  Div
  Mod
}

///| Postfix traversal step on an expression.
pub enum TraversalStep {
  GetAttr(String, Span)
  Index(Int, Span)
  AttrSplat(Array[TraversalStep], Span)
  FullSplat(Array[TraversalStep], Span)
}

///| Single key-value entry in an object constructor `{ k = v }`.
pub struct ObjectItem {
  pub key_expr : Int
  pub val_expr : Int
  pub force_eval_key : Bool
  pub span : Span
}

///| Part of a template string or heredoc.
pub enum TemplatePart {
  Literal(String, Span)
  Interp(Int, Bool, Bool, Span)
  If(Int, Array[TemplatePart], Array[TemplatePart], Bool, Bool, Bool, Bool, Bool, Bool, Span)
  For(Option[String], String, Int, Array[TemplatePart], Bool, Bool, Bool, Bool, Span)
}

///| Arena-allocated HCL2 expression node. Child references are `Int` indices into `nodes`.
pub enum ExprNode {
  LitNull(Span)
  LitBool(Bool, Span)
  LitNumber(HclValue, String, Span)
  LitString(String, Span)
  Template(Array[TemplatePart], Bool, Span)
  ScopeVar(String, Span)
  Parentheses(Int, Span)
  Unary(UnaryOp, Int, Span)
  Binary(BinOp, Int, Int, Span)
  Conditional(Int, Int, Int, Span)
  TupleCons(Array[Int], Span)
  ObjectCons(Array[ObjectItem], Span)
  FuncCall(String, Array[Int], Bool, Span)
  Traversal(Int, Array[TraversalStep], Span)
  ForTuple(Option[String], String, Int, Int, Option[Int], Span)
  ForObject(Option[String], String, Int, Int, Int, Bool, Option[Int], Span)
}

///| Single attribute assignment `name = expr` inside a `Body`.
pub struct Attribute {
  pub name : String
  pub expr : Int
  pub name_span : Span
  pub span : Span
}

///| Nested block `type "label1" label2 { ... }` inside a `Body`.
pub struct Block {
  pub block_type : String
  pub labels : Array[String]
  pub body : Body
  pub type_span : Span
  pub span : Span
}

///| HCL2 body containing attributes and nested blocks.
pub struct Body {
  pub attributes : Array[Attribute]
  pub blocks : Array[Block]
  pub span : Span
}

///| Parsed HCL2 configuration file (body + flat expression arena).
pub struct File {
  pub body : Body
  pub nodes : Array[ExprNode]
}

///| Parsed standalone HCL2 expression or template.
pub struct ExprFile {
  pub root : Int
  pub nodes : Array[ExprNode]
}
