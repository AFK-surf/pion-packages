///| Exact arbitrary-precision decimal arithmetic (`BigDec`) for HCL2 / `go-cty` number semantics.
///|
///| Canonical representation:
///| - Value is `(-1)^neg * mantissa * 10^exp`
///| - `limbs` stores `mantissa` in base `10^9` (`0..999_999_999`), little-endian (`limbs[0]` is LSB).
///| - Zero is uniquely `{ neg: false, limbs: [], exp: 0 }`.
///| - Any non-zero value has `limbs.length() > 0`, `limbs[last] > 0`, and `limbs[0] % 10 != 0`
///|   (all trailing base-10 zeros are folded into `exp`).

let bigdec_base : Int64 = 1000000000L
let bigdec_base_int : Int = 1000000000
let bigdec_max_prec_digits : Int = 160
let bigdec_max_exp : Int = 100000

///| Arbitrary-precision decimal value.
pub struct BigDec {
  pub neg : Bool
  pub limbs : Array[Int]
  pub exp : Int
}

///|
pub fn BigDec::zero() -> BigDec {
  BigDec::{ neg: false, limbs: [], exp: 0 }
}

///|
pub fn BigDec::one() -> BigDec {
  BigDec::{ neg: false, limbs: [1], exp: 0 }
}

///|
pub fn BigDec::is_zero(self : BigDec) -> Bool {
  self.limbs.length() == 0
}

///|
pub fn BigDec::is_integer(self : BigDec) -> Bool {
  self.limbs.length() == 0 || self.exp >= 0
}

///|
pub fn BigDec::negate(self : BigDec) -> BigDec {
  if self.limbs.length() == 0 {
    self
  } else {
    BigDec::{ neg: !self.neg, limbs: self.limbs, exp: self.exp }
  }
}

///|
pub fn BigDec::abs(self : BigDec) -> BigDec {
  if !self.neg {
    self
  } else {
    BigDec::{ neg: false, limbs: self.limbs, exp: self.exp }
  }
}

fn bigdec_strip_leading_zero_limbs(limbs : Array[Int]) -> Unit {
  while limbs.length() > 0 && limbs[limbs.length() - 1] == 0 {
    let _ = limbs.pop()
  }
}

fn bigdec_div_small_mut(limbs : Array[Int], d : Int64) -> Int64 {
  let mut rem : Int64 = 0L
  let mut i = limbs.length() - 1
  while i >= 0 {
    let cur = rem * bigdec_base + limbs[i].to_int64()
    limbs[i] = (cur / d).to_int()
    rem = cur % d
    i = i - 1
  }
  bigdec_strip_leading_zero_limbs(limbs)
  rem
}

fn bigdec_mul_small_mut(limbs : Array[Int], m : Int64) -> Unit {
  let mut carry : Int64 = 0L
  let mut i = 0
  while i < limbs.length() {
    let cur = limbs[i].to_int64() * m + carry
    limbs[i] = (cur % bigdec_base).to_int()
    carry = cur / bigdec_base
    i = i + 1
  }
  while carry > 0L {
    limbs.push((carry % bigdec_base).to_int())
    carry = carry / bigdec_base
  }
}

fn bigdec_add_small_mut(limbs : Array[Int], a : Int64) -> Unit {
  let mut carry = a
  let mut i = 0
  while carry > 0L && i < limbs.length() {
    let cur = limbs[i].to_int64() + carry
    limbs[i] = (cur % bigdec_base).to_int()
    carry = cur / bigdec_base
    i = i + 1
  }
  while carry > 0L {
    limbs.push((carry % bigdec_base).to_int())
    carry = carry / bigdec_base
  }
}

fn bigdec_pow10_int64(k : Int) -> Int64 {
  let mut r : Int64 = 1L
  let mut i = 0
  while i < k {
    r = r * 10L
    i = i + 1
  }
  r
}

fn bigdec_mul_pow10(limbs : Array[Int], shift : Int) -> Array[Int] {
  if shift <= 0 || limbs.length() == 0 {
    let cp : Array[Int] = []
    let mut i = 0
    while i < limbs.length() {
      cp.push(limbs[i])
      i = i + 1
    }
    return cp
  }
  let whole_limbs = shift / 9
  let rem_digits = shift % 9
  let out : Array[Int] = []
  let mut i = 0
  while i < whole_limbs {
    out.push(0)
    i = i + 1
  }
  let mult = bigdec_pow10_int64(rem_digits)
  let mut carry : Int64 = 0L
  i = 0
  while i < limbs.length() {
    let cur = limbs[i].to_int64() * mult + carry
    out.push((cur % bigdec_base).to_int())
    carry = cur / bigdec_base
    i = i + 1
  }
  while carry > 0L {
    out.push((carry % bigdec_base).to_int())
    carry = carry / bigdec_base
  }
  out
}

fn bigdec_normalize(neg : Bool, limbs : Array[Int], exp : Int) -> BigDec {
  bigdec_strip_leading_zero_limbs(limbs)
  if limbs.length() == 0 {
    return BigDec::zero()
  }
  // Remove trailing zero limbs (each = 10^9)
  let mut tz_limbs = 0
  while tz_limbs < limbs.length() && limbs[tz_limbs] == 0 {
    tz_limbs = tz_limbs + 1
  }
  let mut cur = limbs
  let mut e = exp
  if tz_limbs > 0 {
    let trimmed : Array[Int] = []
    let mut i = tz_limbs
    while i < limbs.length() {
      trimmed.push(limbs[i])
      i = i + 1
    }
    cur = trimmed
    e = e + tz_limbs * 9
  }
  // Remove remaining trailing base-10 zeros from lowest limb
  let mut tz = 0
  let mut low = cur[0]
  while low > 0 && low % 10 == 0 {
    low = low / 10
    tz = tz + 1
  }
  if tz > 0 {
    let _ = bigdec_div_small_mut(cur, bigdec_pow10_int64(tz))
    e = e + tz
  }
  BigDec::{ neg: neg, limbs: cur, exp: e }
}

fn bigdec_digit_count_int(v : Int) -> Int {
  if v >= 100000000 {
    9
  } else if v >= 10000000 {
    8
  } else if v >= 1000000 {
    7
  } else if v >= 100000 {
    6
  } else if v >= 10000 {
    5
  } else if v >= 1000 {
    4
  } else if v >= 100 {
    3
  } else if v >= 10 {
    2
  } else {
    1
  }
}

fn bigdec_total_digits(limbs : Array[Int]) -> Int {
  let n = limbs.length()
  if n == 0 {
    return 0
  }
  (n - 1) * 9 + bigdec_digit_count_int(limbs[n - 1])
}

///| Construct `BigDec` from `Int64`.
pub fn BigDec::from_int64(v : Int64) -> BigDec {
  if v == 0L {
    return BigDec::zero()
  }
  let neg = v < 0L
  // Handle Int64::MIN (-9223372036854775808) without signed overflow
  if v == -9223372036854775807L - 1L {
    // 9223372036854775808 = 9 * 10^18 + 223372036 * 10^9 + 854775808
    return BigDec::{ neg: true, limbs: [854775808, 223372036, 9], exp: 0 }
  }
  let mut u = if neg { -v } else { v }
  let limbs : Array[Int] = []
  while u > 0L {
    limbs.push((u % bigdec_base).to_int())
    u = u / bigdec_base
  }
  bigdec_normalize(neg, limbs, 0)
}

///| Construct `BigDec` from `Int`.
pub fn BigDec::from_int(v : Int) -> BigDec {
  BigDec::from_int64(v.to_int64())
}

///| Construct `BigDec` from a `Double` without risking out-of-range integer traps.
pub fn BigDec::from_double(d : Double) -> BigDec {
  if d == 0.0 {
    return BigDec::zero()
  }
  if d >= -9007199254740992.0 && d <= 9007199254740992.0 {
    let i64 = d.to_int64()
    if i64.to_double() == d {
      return BigDec::from_int64(i64)
    }
  }
  let s = match json5::to_json_string(json5::Json5Value::Number(d)) {
    Ok(v) => v
    Err(_) => d.to_string()
  }
  match BigDec::parse(s) {
    Some(bd) => bd
    None => BigDec::zero()
  }
}

///| Parse a decimal number string (optional sign, integer/fraction, optional `e`/`E` exponent).
pub fn BigDec::parse(raw : String) -> Option[BigDec] {
  let n = raw.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if raw.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  } else if raw.code_unit_at(i) == 43 {
    i = i + 1
  }
  if i >= n {
    return None
  }
  // Must start with digit
  let first = raw.code_unit_at(i)
  if first < 48 || first > 57 {
    return None
  }
  let dig_bytes : Array[Int] = []
  while i < n {
    let b = raw.code_unit_at(i)
    if b >= 48 && b <= 57 {
      dig_bytes.push(b - 48)
      i = i + 1
    } else {
      break
    }
  }
  let mut frac_digits = 0
  if i < n && raw.code_unit_at(i) == 46 {
    i = i + 1
    if i >= n || raw.code_unit_at(i) < 48 || raw.code_unit_at(i) > 57 {
      return None
    }
    while i < n {
      let b = raw.code_unit_at(i)
      if b >= 48 && b <= 57 {
        dig_bytes.push(b - 48)
        frac_digits = frac_digits + 1
        i = i + 1
      } else {
        break
      }
    }
  }
  let mut exp_val = 0
  if i < n && (raw.code_unit_at(i) == 101 || raw.code_unit_at(i) == 69) {
    i = i + 1
    let mut exp_neg = false
    if i < n && raw.code_unit_at(i) == 45 {
      exp_neg = true
      i = i + 1
    } else if i < n && raw.code_unit_at(i) == 43 {
      i = i + 1
    }
    if i >= n || raw.code_unit_at(i) < 48 || raw.code_unit_at(i) > 57 {
      return None
    }
    let mut eacc : Int64 = 0L
    while i < n {
      let b = raw.code_unit_at(i)
      if b >= 48 && b <= 57 {
        if eacc < 10000000L {
          eacc = eacc * 10L + (b - 48).to_int64()
        }
        i = i + 1
      } else {
        break
      }
    }
    if eacc > bigdec_max_exp.to_int64() {
      return None
    }
    exp_val = if exp_neg { -eacc.to_int() } else { eacc.to_int() }
  }
  if i != n {
    return None
  }
  // Strip leading zeros from dig_bytes
  let mut start = 0
  while start < dig_bytes.length() && dig_bytes[start] == 0 {
    start = start + 1
  }
  if start == dig_bytes.length() {
    return Some(BigDec::zero())
  }
  let mut end = dig_bytes.length()
  let mut tz = 0
  while end > start && dig_bytes[end - 1] == 0 {
    end = end - 1
    tz = tz + 1
  }
  // Pack significant decimal digits [start..end) into base-10^9 limbs (little-endian)
  let limbs : Array[Int] = []
  let mut pos = end
  while pos > start {
    let chunk_start = if pos - 9 > start { pos - 9 } else { start }
    let mut acc_limb = 0
    let mut k = chunk_start
    while k < pos {
      acc_limb = acc_limb * 10 + dig_bytes[k]
      k = k + 1
    }
    limbs.push(acc_limb)
    pos = chunk_start
  }
  let final_exp = exp_val - frac_digits + tz
  Some(bigdec_normalize(neg, limbs, final_exp))
}

fn bigdec_limbs_cmp(a : Array[Int], b : Array[Int]) -> Int {
  let na = a.length()
  let nb = b.length()
  if na != nb {
    return if na < nb { -1 } else { 1 }
  }
  let mut i = na - 1
  while i >= 0 {
    if a[i] != b[i] {
      return if a[i] < b[i] { -1 } else { 1 }
    }
    i = i - 1
  }
  0
}

fn bigdec_limbs_add(a : Array[Int], b : Array[Int]) -> Array[Int] {
  let na = a.length()
  let nb = b.length()
  let n = if na > nb { na } else { nb }
  let out : Array[Int] = []
  let mut carry : Int64 = 0L
  let mut i = 0
  while i < n {
    let va = if i < na { a[i].to_int64() } else { 0L }
    let vb = if i < nb { b[i].to_int64() } else { 0L }
    let s = va + vb + carry
    if s >= bigdec_base {
      out.push((s - bigdec_base).to_int())
      carry = 1L
    } else {
      out.push(s.to_int())
      carry = 0L
    }
    i = i + 1
  }
  if carry > 0L {
    out.push(carry.to_int())
  }
  out
}

///| Requires `a >= b`!
fn bigdec_limbs_sub(a : Array[Int], b : Array[Int]) -> Array[Int] {
  let na = a.length()
  let nb = b.length()
  let out : Array[Int] = []
  let mut borrow : Int64 = 0L
  let mut i = 0
  while i < na {
    let va = a[i].to_int64()
    let vb = if i < nb { b[i].to_int64() } else { 0L }
    let mut d = va - vb - borrow
    if d < 0L {
      d = d + bigdec_base
      borrow = 1L
    } else {
      borrow = 0L
    }
    out.push(d.to_int())
    i = i + 1
  }
  bigdec_strip_leading_zero_limbs(out)
  out
}

fn bigdec_limbs_mul(a : Array[Int], b : Array[Int]) -> Array[Int] {
  let na = a.length()
  let nb = b.length()
  if na == 0 || nb == 0 {
    return []
  }
  let out : Array[Int] = []
  let mut i = 0
  while i < na + nb {
    out.push(0)
    i = i + 1
  }
  i = 0
  while i < na {
    let ai = a[i].to_int64()
    let mut carry : Int64 = 0L
    let mut j = 0
    while j < nb {
      let cur = out[i + j].to_int64() + ai * b[j].to_int64() + carry
      out[i + j] = (cur % bigdec_base).to_int()
      carry = cur / bigdec_base
      j = j + 1
    }
    let mut k = i + nb
    while carry > 0L {
      let cur = out[k].to_int64() + carry
      out[k] = (cur % bigdec_base).to_int()
      carry = cur / bigdec_base
      k = k + 1
    }
    i = i + 1
  }
  bigdec_strip_leading_zero_limbs(out)
  out
}

///| Convert limbs to decimal digit string (MSB first, no leading zeros).
fn bigdec_limbs_to_digits(limbs : Array[Int]) -> String {
  let n = limbs.length()
  if n == 0 {
    return "0"
  }
  let sb = StringBuilder::new()
  sb.write_string(limbs[n - 1].to_string())
  let mut i = n - 2
  while i >= 0 {
    let v = limbs[i]
    let mut div = 100000000
    while div > 0 {
      let d = (v / div) % 10
      sb.write_byte((48 + d).to_byte())
      div = div / 10
    }
    i = i - 1
  }
  sb.to_string()
}

///| Compare absolute values of two normalized `BigDec`s (-1, 0, 1).
fn bigdec_cmp_abs(a : BigDec, b : BigDec) -> Int {
  if a.is_zero() && b.is_zero() {
    return 0
  }
  if a.is_zero() {
    return -1
  }
  if b.is_zero() {
    return 1
  }
  let ord_a = bigdec_total_digits(a.limbs) + a.exp
  let ord_b = bigdec_total_digits(b.limbs) + b.exp
  if ord_a != ord_b {
    return if ord_a < ord_b { -1 } else { 1 }
  }
  // Same order of magnitude: compare decimal digits lexicographically (with trailing virtual zeros)
  let sa = bigdec_limbs_to_digits(a.limbs)
  let sb = bigdec_limbs_to_digits(b.limbs)
  let na = sa.length()
  let nb = sb.length()
  let m = if na > nb { na } else { nb }
  let mut i = 0
  while i < m {
    let ca = if i < na { sa.code_unit_at(i) } else { 48 }
    let cb = if i < nb { sb.code_unit_at(i) } else { 48 }
    if ca != cb {
      return if ca < cb { -1 } else { 1 }
    }
    i = i + 1
  }
  0
}

///| Signed comparison (-1, 0, 1).
pub fn BigDec::cmp(a : BigDec, b : BigDec) -> Int {
  if a.is_zero() && b.is_zero() {
    return 0
  }
  if a.neg != b.neg {
    return if a.neg { -1 } else { 1 }
  }
  let c = bigdec_cmp_abs(a, b)
  if a.neg { -c } else { c }
}

///| Exact equality.
pub fn BigDec::eq(a : BigDec, b : BigDec) -> Bool {
  BigDec::cmp(a, b) == 0
}

///| Truncate/round a `BigDec` to at most `max_digits` significant digits (round half-up).
fn bigdec_round_sig(bd : BigDec, max_digits : Int) -> BigDec {
  if bd.is_zero() {
    return bd
  }
  let td = bigdec_total_digits(bd.limbs)
  if td <= max_digits {
    return bd
  }
  let drop = td - max_digits
  let s = bigdec_limbs_to_digits(bd.limbs)
  let keep = max_digits
  let round_up = s.code_unit_at(keep) >= 53 // >= '5'
  let digs : Array[Int] = []
  let mut i = 0
  while i < keep {
    digs.push(s.code_unit_at(i) - 48)
    i = i + 1
  }
  if round_up {
    let mut carry = 1
    let mut k = keep - 1
    while k >= 0 && carry > 0 {
      let v = digs[k] + carry
      if v >= 10 {
        digs[k] = 0
        carry = 1
      } else {
        digs[k] = v
        carry = 0
      }
      k = k - 1
    }
    if carry > 0 {
      let next : Array[Int] = [1]
      let mut j = 0
      while j < digs.length() {
        next.push(digs[j])
        j = j + 1
      }
      let limbs : Array[Int] = []
      let mut pos = next.length()
      while pos > 0 {
        let cs = if pos - 9 > 0 { pos - 9 } else { 0 }
        let mut acc_limb = 0
        let mut m = cs
        while m < pos {
          acc_limb = acc_limb * 10 + next[m]
          m = m + 1
        }
        limbs.push(acc_limb)
        pos = cs
      }
      return bigdec_normalize(bd.neg, limbs, bd.exp + drop)
    }
  }
  let limbs : Array[Int] = []
  let mut pos = digs.length()
  while pos > 0 {
    let cs = if pos - 9 > 0 { pos - 9 } else { 0 }
    let mut acc_limb = 0
    let mut m = cs
    while m < pos {
      acc_limb = acc_limb * 10 + digs[m]
      m = m + 1
    }
    limbs.push(acc_limb)
    pos = cs
  }
  bigdec_normalize(bd.neg, limbs, bd.exp + drop)
}

///| Addition `a + b`.
pub fn BigDec::add(a : BigDec, b : BigDec) -> BigDec {
  if a.is_zero() {
    return b
  }
  if b.is_zero() {
    return a
  }
  // Guard against extreme exponent gaps (e.g. 1e300 + 1)
  let ord_a = bigdec_total_digits(a.limbs) + a.exp
  let ord_b = bigdec_total_digits(b.limbs) + b.exp
  if ord_a - ord_b > bigdec_max_prec_digits + 8 {
    return a
  }
  if ord_b - ord_a > bigdec_max_prec_digits + 8 {
    return b
  }
  let min_exp = if a.exp < b.exp { a.exp } else { b.exp }
  let la = bigdec_mul_pow10(a.limbs, a.exp - min_exp)
  let lb = bigdec_mul_pow10(b.limbs, b.exp - min_exp)
  if a.neg == b.neg {
    bigdec_normalize(a.neg, bigdec_limbs_add(la, lb), min_exp)
  } else {
    let c = bigdec_limbs_cmp(la, lb)
    if c == 0 {
      BigDec::zero()
    } else if c > 0 {
      bigdec_normalize(a.neg, bigdec_limbs_sub(la, lb), min_exp)
    } else {
      bigdec_normalize(b.neg, bigdec_limbs_sub(lb, la), min_exp)
    }
  }
}

///| Subtraction `a - b`.
pub fn BigDec::sub(a : BigDec, b : BigDec) -> BigDec {
  BigDec::add(a, b.negate())
}

///| Multiplication `a * b`.
pub fn BigDec::mul(a : BigDec, b : BigDec) -> BigDec {
  if a.is_zero() || b.is_zero() {
    return BigDec::zero()
  }
  let prod = bigdec_limbs_mul(a.limbs, b.limbs)
  let res = bigdec_normalize(a.neg != b.neg, prod, a.exp + b.exp)
  bigdec_round_sig(res, bigdec_max_prec_digits)
}

///| Integer division of positive limb arrays `u / v` returning `(quotient, remainder)`.
fn bigdec_limbs_divmod(u : Array[Int], v : Array[Int]) -> (Array[Int], Array[Int]) {
  let c = bigdec_limbs_cmp(u, v)
  if c < 0 {
    let rem_cp : Array[Int] = []
    let mut i = 0
    while i < u.length() {
      rem_cp.push(u[i])
      i = i + 1
    }
    return ([], rem_cp)
  }
  if c == 0 {
    return ([1], [])
  }
  // Fast path: single-limb divisor
  if v.length() == 1 {
    let d = v[0].to_int64()
    let q : Array[Int] = []
    let mut i = 0
    while i < u.length() {
      q.push(u[i])
      i = i + 1
    }
    let r = bigdec_div_small_mut(q, d)
    let rem : Array[Int] = if r > 0L { [r.to_int()] } else { [] }
    return (q, rem)
  }
  // Long division by binary search on each base-10^9 quotient limb
  let un = u.length()
  let vn = v.length()
  let q_len = un - vn + 1
  let q : Array[Int] = []
  let mut i = 0
  while i < q_len {
    q.push(0)
    i = i + 1
  }
  let mut rem : Array[Int] = []
  // Load top vn - 1 limbs into rem
  i = un - 1
  while i >= 0 {
    // rem = rem * BASE + u[i]
    if rem.length() > 0 || u[i] > 0 {
      let next_rem : Array[Int] = [u[i]]
      let mut k = 0
      while k < rem.length() {
        next_rem.push(rem[k])
        k = k + 1
      }
      rem = next_rem
    }
    if i < q_len {
      if bigdec_limbs_cmp(rem, v) >= 0 {
        // Binary search digit in [1, BASE - 1]
        let mut lo = 1
        let mut hi = bigdec_base_int - 1
        let mut best = 1
        while lo <= hi {
          let mid = lo + (hi - lo) / 2
          let prod = bigdec_limbs_mul(v, [mid])
          let cmp = bigdec_limbs_cmp(prod, rem)
          if cmp <= 0 {
            best = mid
            lo = mid + 1
          } else {
            hi = mid - 1
          }
        }
        q[i] = best
        let prod = bigdec_limbs_mul(v, [best])
        rem = bigdec_limbs_sub(rem, prod)
      }
    }
    i = i - 1
  }
  bigdec_strip_leading_zero_limbs(q)
  bigdec_strip_leading_zero_limbs(rem)
  (q, rem)
}

///| Division `a / b` (up to `bigdec_max_prec_digits` significant digits).
pub fn BigDec::div(a : BigDec, b : BigDec) -> Option[BigDec] {
  if b.is_zero() {
    return None
  }
  if a.is_zero() {
    return Some(BigDec::zero())
  }
  // Scale numerator so quotient has at least bigdec_max_prec_digits + 2 digits
  let da = bigdec_total_digits(a.limbs)
  let db = bigdec_total_digits(b.limbs)
  let target = bigdec_max_prec_digits + 2
  let shift = target + db - da
  let shift_clamped = if shift > 0 { shift } else { 0 }
  let num = bigdec_mul_pow10(a.limbs, shift_clamped)
  let (q, rem) = bigdec_limbs_divmod(num, b.limbs)
  let res_exp = a.exp - b.exp - shift_clamped
  let res = bigdec_normalize(a.neg != b.neg, q, res_exp)
  if rem.length() == 0 {
    Some(res)
  } else {
    Some(bigdec_round_sig(res, bigdec_max_prec_digits))
  }
}

///| Truncate toward zero to an integer `BigDec`.
pub fn BigDec::trunc(self : BigDec) -> BigDec {
  if self.is_zero() || self.exp >= 0 {
    return self
  }
  let drop = -self.exp
  let td = bigdec_total_digits(self.limbs)
  if drop >= td {
    return BigDec::zero()
  }
  let s = bigdec_limbs_to_digits(self.limbs)
  let keep = td - drop
  let int_str = s.slice(0, keep)
  match BigDec::parse(if self.neg { "-" + int_str } else { int_str }) {
    Some(bd) => bd
    None => BigDec::zero()
  }
}

///| Floor (largest integer <= self).
pub fn BigDec::floor(self : BigDec) -> BigDec {
  if self.is_zero() || self.exp >= 0 {
    return self
  }
  let t = self.trunc()
  if self.neg {
    BigDec::sub(t, BigDec::one())
  } else {
    t
  }
}

///| Ceil (smallest integer >= self).
pub fn BigDec::ceil(self : BigDec) -> BigDec {
  if self.is_zero() || self.exp >= 0 {
    return self
  }
  let t = self.trunc()
  if self.neg {
    t
  } else {
    BigDec::add(t, BigDec::one())
  }
}

///| Compute `(base^exp) % m` for non-negative `exp` and `m > 0` (`m <= 2^31` or careful overflow).
fn bigdec_pow10_mod(exp : Int, m : Int64) -> Int64 {
  if m == 1L {
    return 0L
  }
  let mut res : Int64 = 1L
  let mut base : Int64 = 10L % m
  let mut e = exp
  while e > 0 {
    if (e & 1) == 1 {
      res = (res * base) % m
    }
    base = (base * base) % m
    e = e >> 1
  }
  res
}

///| Compute `(|self| % m)` when `self` is an integer and `0 < m <= 2_000_000_000`.
fn bigdec_int_mod_small(self : BigDec, m : Int64) -> Int64 {
  if self.is_zero() || m == 1L {
    return 0L
  }
  let mut rem : Int64 = 0L
  let base_mod = bigdec_base % m
  let mut i = self.limbs.length() - 1
  while i >= 0 {
    rem = (rem * base_mod + self.limbs[i].to_int64()) % m
    i = i - 1
  }
  if self.exp > 0 {
    rem = (rem * bigdec_pow10_mod(self.exp, m)) % m
  }
  rem
}

///| Truncated remainder `a % b` matching Go `go-cty` (`b == 0` returns `a`; `-7 % 3 == -1`, `7 % -3 == 1`).
pub fn BigDec::rem(a : BigDec, b : BigDec) -> BigDec {
  if b.is_zero() {
    return a
  }
  if a.is_zero() {
    return BigDec::zero()
  }
  // Fast exact integer modulo when both are integers and |b| fits in Int32 (handles 1e300 % 7 cleanly!)
  if a.is_integer() && b.is_integer() {
    match b.abs().to_int_exact() {
      Some(bi) => {
        if bi > 0 {
          let r = bigdec_int_mod_small(a, bi.to_int64())
          if r == 0L {
            return BigDec::zero()
          }
          let res = BigDec::from_int64(r)
          return if a.neg { res.negate() } else { res }
        }
      }
      None => ()
    }
  }
  // General case: q = trunc(a / b), rem = a - q * b
  // Guard huge exponent difference where exact integer quotient would be huge
  let ord_a = bigdec_total_digits(a.limbs) + a.exp
  let ord_b = bigdec_total_digits(b.limbs) + b.exp
  if ord_a - ord_b > bigdec_max_prec_digits {
    // Beyond precision, remainder is 0
    return BigDec::zero()
  }
  let min_exp = if a.exp < b.exp { a.exp } else { b.exp }
  let la = bigdec_mul_pow10(a.limbs, a.exp - min_exp)
  let lb = bigdec_mul_pow10(b.limbs, b.exp - min_exp)
  let (_, rem_limbs) = bigdec_limbs_divmod(la, lb)
  bigdec_normalize(a.neg, rem_limbs, min_exp)
}

///| Convert to exact `Int64` if `self` is an integer in `[Int64::MIN, Int64::MAX]`.
pub fn BigDec::to_int64_exact(self : BigDec) -> Option[Int64] {
  if !self.is_integer() {
    return None
  }
  if self.is_zero() {
    return Some(0L)
  }
  let td = bigdec_total_digits(self.limbs) + self.exp
  if td > 19 {
    return None
  }
  let s = self.to_string()
  // Parse digits safely
  let n = s.length()
  let mut i = if self.neg { 1 } else { 0 }
  let mut acc : Int64 = 0L
  // Max positive: 9223372036854775807, max negative abs: 9223372036854775808
  let limit_div10 : Int64 = 922337203685477580L
  let limit_last : Int64 = if self.neg { 8L } else { 7L }
  while i < n {
    let d = (s.code_unit_at(i) - 48).to_int64()
    if acc > limit_div10 || (acc == limit_div10 && d > limit_last) {
      return None
    }
    acc = acc * 10L + d
    i = i + 1
  }
  if self.neg {
    if acc == limit_div10 * 10L + 8L {
      Some(-9223372036854775807L - 1L)
    } else {
      Some(-acc)
    }
  } else {
    Some(acc)
  }
}

///| Convert to exact `Int` (32-bit signed) if `self` is an integer in `[-2147483648, 2147483647]`.
pub fn BigDec::to_int_exact(self : BigDec) -> Option[Int] {
  match self.to_int64_exact() {
    Some(v) => {
      if v >= -2147483648L && v <= 2147483647L {
        Some(v.to_int())
      } else {
        None
      }
    }
    None => None
  }
}

///| Format as canonical decimal string (fixed notation for `|exp| <= 500`, scientific otherwise).
pub fn BigDec::to_string(self : BigDec) -> String {
  if self.is_zero() {
    return "0"
  }
  let digs = bigdec_limbs_to_digits(self.limbs)
  let dlen = digs.length()
  let sb = StringBuilder::new()
  if self.neg {
    sb.write_byte((45).to_byte())
  }
  if self.exp >= 0 {
    if self.exp <= 500 {
      sb.write_string(digs)
      let mut z = 0
      while z < self.exp {
        sb.write_byte((48).to_byte())
        z = z + 1
      }
      return sb.to_string()
    }
    // Scientific notation for huge positive exponent
    let sci_exp = self.exp + dlen - 1
    sb.write_byte(digs.code_unit_at(0).to_byte())
    if dlen > 1 {
      sb.write_byte((46).to_byte())
      sb.write_string(digs.slice(1, dlen))
    }
    sb.write_string("e+")
    sb.write_string(sci_exp.to_string())
    return sb.to_string()
  }
  // self.exp < 0
  let point_pos = dlen + self.exp
  if point_pos > 0 {
    sb.write_string(digs.slice(0, point_pos))
    sb.write_byte((46).to_byte())
    sb.write_string(digs.slice(point_pos, dlen))
    return sb.to_string()
  }
  let leading_zeros = -point_pos
  if leading_zeros <= 500 {
    sb.write_string("0.")
    let mut z = 0
    while z < leading_zeros {
      sb.write_byte((48).to_byte())
      z = z + 1
    }
    sb.write_string(digs)
    return sb.to_string()
  }
  // Scientific notation for tiny negative exponent
  let sci_exp = self.exp + dlen - 1
  sb.write_byte(digs.code_unit_at(0).to_byte())
  if dlen > 1 {
    sb.write_byte((46).to_byte())
    sb.write_string(digs.slice(1, dlen))
  }
  sb.write_byte((101).to_byte())
  sb.write_string(sci_exp.to_string())
  sb.to_string()
}

///| Format with fixed number of fractional digits `prec` (for `format("%.2f", x)`), half-up rounding.
pub fn BigDec::to_fixed_string(self : BigDec, prec : Int) -> String {
  let p = if prec < 0 { 0 } else if prec > 100 { 100 } else { prec }
  if self.is_zero() {
    if p == 0 {
      return "0"
    }
    let sb = StringBuilder::new()
    sb.write_string("0.")
    let mut k = 0
    while k < p {
      sb.write_byte((48).to_byte())
      k = k + 1
    }
    return sb.to_string()
  }
  // Guard huge exponents so we don't allocate huge strings
  if self.exp > 500 || self.exp < -500 {
    return self.to_string()
  }
  let digs = bigdec_limbs_to_digits(self.limbs)
  let dlen = digs.length()
  // Target scale is -p: need to shift decimal point so last digit is at 10^(-p)
  let diff = self.exp + p // if diff >= 0, append diff zeros; if diff < 0, round off -diff digits
  let res_digs : Array[Int] = []
  if diff >= 0 {
    let mut i = 0
    while i < dlen {
      res_digs.push(digs.code_unit_at(i) - 48)
      i = i + 1
    }
    let mut z = 0
    while z < diff {
      res_digs.push(0)
      z = z + 1
    }
  } else {
    let drop = -diff
    if drop > dlen {
      res_digs.push(0)
    } else {
      let keep = dlen - drop
      let mut i = 0
      while i < keep {
        res_digs.push(digs.code_unit_at(i) - 48)
        i = i + 1
      }
      let round_digit = if keep < dlen { digs.code_unit_at(keep) - 48 } else { 0 }
      if round_digit >= 5 {
        let mut carry = 1
        let mut k = res_digs.length() - 1
        while k >= 0 && carry > 0 {
          let v = res_digs[k] + carry
          if v >= 10 {
            res_digs[k] = 0
            carry = 1
          } else {
            res_digs[k] = v
            carry = 0
          }
          k = k - 1
        }
        if carry > 0 {
          let next : Array[Int] = [1]
          let mut j = 0
          while j < res_digs.length() {
            next.push(res_digs[j])
            j = j + 1
          }
          // Replace res_digs
          while res_digs.length() > 0 {
            let _ = res_digs.pop()
          }
          j = 0
          while j < next.length() {
            res_digs.push(next[j])
            j = j + 1
          }
        }
      }
    }
  }
  // Pad left with zeros so we have at least p + 1 digits
  let pad_left = if res_digs.length() <= p { p + 1 - res_digs.length() } else { 0 }
  let all_digs : Array[Int] = []
  let mut k = 0
  while k < pad_left {
    all_digs.push(0)
    k = k + 1
  }
  k = 0
  while k < res_digs.length() {
    all_digs.push(res_digs[k])
    k = k + 1
  }
  // Check if all zeros (avoid "-0.00")
  let mut all_zero = true
  k = 0
  while k < all_digs.length() {
    if all_digs[k] != 0 {
      all_zero = false
      break
    }
    k = k + 1
  }
  let sb = StringBuilder::new()
  if self.neg && !all_zero {
    sb.write_byte((45).to_byte())
  }
  let int_len = all_digs.length() - p
  k = 0
  while k < int_len {
    sb.write_byte((48 + all_digs[k]).to_byte())
    k = k + 1
  }
  if p > 0 {
    sb.write_byte((46).to_byte())
    while k < all_digs.length() {
      sb.write_byte((48 + all_digs[k]).to_byte())
      k = k + 1
    }
  }
  sb.to_string()
}

///| Convert `BigDec` to `Double` (best-effort, for interop).
pub fn BigDec::to_double(self : BigDec) -> Double {
  if self.is_zero() {
    return 0.0
  }
  match json5::parse_with_options(self.to_string(), json5::ParseOptions::strict_json()) {
    Ok(json5::Json5Value::Number(d)) => d
    _ => 0.0
  }
}
