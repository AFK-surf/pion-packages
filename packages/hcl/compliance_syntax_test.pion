///| HCL2 syntax compliance tests: bodies, attributes, nested blocks + labels,
///| one-line blocks, duplicate attribute rejection, comments (`#`, `//`, `/* */`),
///| literals & escapes, heredocs (`<<EOF`, `<<-EOF`), JSON syntax equivalence,
///| and exact line/column `Span` diagnostics.

fn assert_parse_ok(src : String, msg : String) -> File {
  match parse(src) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, msg + " (unexpected err: " + e.to_string() + ")")
      File::{
        body: Body::{ attributes: [], blocks: [], span: Span::zero() },
        nodes: [],
      }
    }
  }
}

fn assert_parse_err_kind(src : String, expected : HclErrorKind, msg : String) -> HclError {
  match parse(src) {
    Ok(_) => {
      debug_assert(false, msg + " (expected error, got Ok)")
      HclError::new(HclErrorKind::SyntaxError, "", Span::zero())
    }
    Err(e) => {
      debug_assert(
        e.is_kind(expected),
        msg + " (expected " + error_kind_as_str(expected) + ", got " + e.to_string() + ")",
      )
      e
    }
  }
}

///|
test "hcl_syntax_body_attributes_and_blocks" {
  let src =
  "# leading hash comment\n" +
  "// leading slash comment\n" +
  "/* inline\n" +
  "   block comment */\n" +
  "region = \"us-west-2\"\n" +
  "replicas = 3\n" +
  "enabled = true\n" +
  "resource \"aws_instance\" \"web\" {\n" +
  "  ami           = \"ami-123456\"\n" +
  "  instance_type = \"t3.micro\"\n" +
  "  network_interface {\n" +
  "    device_index = 0\n" +
  "  }\n" +
  "}\n" +
  "block_ident_label foo \"bar\" { key = \"val\" }\n"
  let f = assert_parse_ok(src, "basic body with comments, attrs, nested & one-line blocks")
  debug_assert(f.body.attributes.length() == 3, "expected 3 top-level attributes")
  debug_assert(f.body.attributes[0].name == "region", "first attr name")
  debug_assert(f.body.attributes[1].name == "replicas", "second attr name")
  debug_assert(f.body.attributes[2].name == "enabled", "third attr name")
  debug_assert(f.body.blocks.length() == 2, "expected 2 top-level blocks")
  let b0 = f.body.blocks[0]
  debug_assert(b0.block_type == "resource", "block 0 type")
  debug_assert(b0.labels.length() == 2, "block 0 labels count")
  debug_assert(b0.labels[0] == "aws_instance", "block 0 label 0")
  debug_assert(b0.labels[1] == "web", "block 0 label 1")
  debug_assert(b0.body.attributes.length() == 2, "block 0 attr count")
  debug_assert(b0.body.blocks.length() == 1, "block 0 nested block count")
  debug_assert(b0.body.blocks[0].block_type == "network_interface", "nested block type")
  let b1 = f.body.blocks[1]
  debug_assert(b1.block_type == "block_ident_label", "one-line block type")
  debug_assert(b1.labels.length() == 2, "one-line block labels")
  debug_assert(b1.labels[0] == "foo" && b1.labels[1] == "bar", "one-line block label values")
  debug_assert(b1.body.attributes.length() == 1, "one-line block attr count")
  debug_assert(b1.body.attributes[0].name == "key", "one-line block attr name")
}

///|
test "hcl_syntax_duplicate_attribute_rejected_with_span" {
  let src = "a = 1\nb = 2\na = 3\n"
  let err = assert_parse_err_kind(
    src,
    HclErrorKind::DuplicateAttribute,
    "duplicate attribute in same body must fail",
  )
  debug_assert(err.span.start.line == 3, "duplicate attr error should be on line 3")
  debug_assert(err.span.start.column == 1, "duplicate attr error should be on col 1")
}

///|
test "hcl_syntax_error_span_accuracy" {
  let src = "a = 1\nb = (\n"
  let err = assert_parse_err_kind(src, HclErrorKind::SyntaxError, "unclosed paren syntax error")
  debug_assert(err.span.start.line >= 2, "error line should be >= 2")
}

///|
test "hcl_syntax_literals_and_escapes" {
  let ctx = EvalContext::empty()
  let check_str = fn(expr : String, expected : String, msg : String) -> Unit {
    match eval_expr(expr, ctx) {
      Ok(v) => debug_assert(value_eq(v, HclValue::str(expected)), msg)
      Err(e) => debug_assert(false, msg + " err: " + e.to_string())
    }
  }
  check_str("\"hello\\nworld\\r\\t\\\"\\\\\"", "hello\nworld\r\t\"\\", "basic escapes")
  check_str("\"\\u0041\\u4e2d\"", "A中", "unicode \\uXXXX escapes")
  check_str("\"\\U0001F600\"", "😀", "unicode \\UXXXXXXXX escape")
  check_str("\"$${not_interp} %%{not_dir}\"", "${not_interp} %{not_dir}", "escaped $$ and %%")

  // Numbers: int, float, scientific notation
  match eval_expr("[0, 42, 3.14, 1e3, 2.5e-1, 1E+2, true, false, null]", ctx) {
    Ok(v) =>
    debug_assert(
      value_eq(
        v,
        HclValue::tuple([
          HclValue::number(0.0),
          HclValue::number(42.0),
          HclValue::number(3.14),
          HclValue::number(1000.0),
          HclValue::number(0.25),
          HclValue::number(100.0),
          HclValue::bool(true),
          HclValue::bool(false),
          HclValue::null(),
        ]),
      ),
      "numeric, bool, null literals",
    )
    Err(e) => debug_assert(false, "numeric literals err: " + e.to_string())
  }
}

///|
test "hcl_syntax_heredoc_normal_and_indented" {
  let ctx = EvalContext::from_vars([("name", HclValue::str("world"))])
  let src =
  "plain = <<EOF\n" +
  "  line1\n" +
  "    line2\n" +
  "EOF\n" +
  "indented = <<-EOT\n" +
  "    hello ${name}\n" +
  "      indented\n" +
  "\n" +
  "    tail\n" +
  "  EOT\n"
  match eval_body(src, ctx) {
    Ok(v) => {
      let expected = HclValue::object([
        ("plain", HclValue::str("  line1\n    line2\n")),
        ("indented", HclValue::str("hello world\n  indented\n\ntail\n")),
      ])
      debug_assert(value_eq(v, expected), "heredoc and indented heredoc values")
    }
    Err(e) => debug_assert(false, "heredoc eval err: " + e.to_string())
  }
}

///|
test "hcl_syntax_json_equivalence" {
  let ctx = EvalContext::from_vars([
    ("env", HclValue::str("prod")),
    ("port", HclValue::int(8080)),
  ])
  let hcl_src =
  "service = \"api-${env}\"\n" +
  "port = port\n" +
  "enabled = true\n" +
  "tags = [\"web\", \"${env}\"]\n"
  let json_src =
  "{\n" +
  "  \"service\": \"api-${env}\",\n" +
  "  \"port\": \"${port}\",\n" +
  "  \"enabled\": true,\n" +
  "  \"tags\": [\"web\", \"${env}\"]\n" +
  "}\n"
  let j1 = match eval_body_to_json(hcl_src, ctx) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "hcl eval_body_to_json err: " + e.to_string())
      ""
    }
  }
  let j2 = match eval_json_body_to_json(json_src, ctx) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "json eval_json_body_to_json err: " + e.to_string())
      ""
    }
  }
  debug_assert(j1 == j2, "HCL native and JSON syntax must evaluate to identical JSON: " + j1 + " vs " + j2)
}
