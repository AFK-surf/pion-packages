///| HCL2 canonical formatter (`format_hcl`) and DoS safety limit (`HclLimits`) compliance tests.

///|
test "hcl_format_alignment_indentation_and_idempotency" {
  let raw =
  "resource   \"aws_s3_bucket\"   \"logs\"{\n" +
  "bucket=\"my-logs\"\n" +
  "acl =\"private\"\n" +
  "force_destroy=true\n" +
  "\n" +
  "versioning {\n" +
  "enabled=true\n" +
  "}\n" +
  "}\n"
  let expected =
  "resource \"aws_s3_bucket\" \"logs\" {\n" +
  "  bucket        = \"my-logs\"\n" +
  "  acl           = \"private\"\n" +
  "  force_destroy = true\n" +
  "\n" +
  "  versioning {\n" +
  "    enabled = true\n" +
  "  }\n" +
  "}\n"
  let formatted = match format_hcl(raw) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "format_hcl failed: " + e.to_string())
      ""
    }
  }
  debug_assert(formatted == expected, "canonical format mismatch:\nGOT:\n" + formatted + "\nEXP:\n" + expected)
  let second = match format_hcl(formatted) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "second format_hcl failed: " + e.to_string())
      ""
    }
  }
  debug_assert(second == formatted, "format_hcl must be strictly idempotent")
}

///|
test "hcl_format_preserves_comments_and_heredoc" {
  let raw =
  "# top comment\n" +
  "a=1+2*3\n" +
  "long_key=<<EOF\n" +
  "  untouched   spacing\n" +
  "EOF\n"
  let expected =
  "# top comment\n" +
  "a        = 1 + 2 * 3\n" +
  "long_key = <<EOF\n" +
  "  untouched   spacing\n" +
  "EOF\n"
  let formatted = match format_hcl(raw) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "format_hcl heredoc failed: " + e.to_string())
      ""
    }
  }
  debug_assert(formatted == expected, "heredoc/comment format mismatch:\nGOT:\n" + formatted + "\nEXP:\n" + expected)
  match format_hcl(formatted) {
    Ok(s2) => debug_assert(s2 == formatted, "heredoc format must be idempotent")
    Err(e) => debug_assert(false, "second heredoc format failed: " + e.to_string())
  }
}

///|
test "hcl_limits_deep_nesting_dos_protection" {
  // Deeply nested parentheses expression
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 100 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 100 {
    sb.write_string(")")
    i = i + 1
  }
  let tight = HclLimits::new(32, 10000L, 4096)
  match parse_expr_with_limits(sb.to_string(), tight) {
    Ok(_) => debug_assert(false, "deep parens should fail with LimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(HclErrorKind::LimitExceeded),
      "expected LimitExceeded for deep parens, got " + e.to_string(),
    )
  }

  // Deeply nested blocks
  let sb2 = StringBuilder::new()
  i = 0
  while i < 60 {
    sb2.write_string("b {\n")
    i = i + 1
  }
  sb2.write_string("x = 1\n")
  i = 0
  while i < 60 {
    sb2.write_string("}\n")
    i = i + 1
  }
  match parse_with_limits(sb2.to_string(), tight) {
    Ok(_) => debug_assert(false, "deep blocks should fail with LimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(HclErrorKind::LimitExceeded),
      "expected LimitExceeded for deep blocks, got " + e.to_string(),
    )
  }
}

///|
test "hcl_limits_eval_steps_and_output_bytes_dos_protection" {
  // Step budget bomb via nested for comprehensions
  let step_ctx = EvalContext::empty().with_limits(HclLimits::new(64, 50L, 4096))
  match eval_expr("[for a in range(20) : [for b in range(20) : a + b]]", step_ctx) {
    Ok(_) => debug_assert(false, "nested for should fail with LimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(HclErrorKind::LimitExceeded),
      "expected LimitExceeded for step bomb, got " + e.to_string(),
    )
  }

  // Output bytes bomb via template/join expansion
  let out_ctx = EvalContext::empty().with_limits(HclLimits::new(64, 100000L, 64))
  match eval_expr("join(\"\", [for i in range(50) : \"0123456789\"])", out_ctx) {
    Ok(_) => debug_assert(false, "large output should fail with LimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(HclErrorKind::LimitExceeded),
      "expected LimitExceeded for output bytes bomb, got " + e.to_string(),
    )
  }
}
