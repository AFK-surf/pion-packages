///| Additional HCL2 edge-case tests: nested templates, object `for` iteration,
///| legacy numeric traversal, multi-label block JSON evaluation, extra built-ins,
///| standalone `eval_template`, and CRLF/complex formatting idempotency.

///|
test "hcl_extra_nested_templates_and_standalone" {
  let ctx = EvalContext::from_vars([
    ("env", HclValue::str("staging")),
    ("id", HclValue::int(7)),
  ])
  match eval_expr("\"svc-${\"${env}-${id}\"}\"", ctx) {
    Ok(v) => debug_assert(value_eq(v, HclValue::str("svc-staging-7")), "nested template interp")
    Err(e) => debug_assert(false, "nested template err: " + e.to_string())
  }
  match eval_template("env=${env}, id=${id}", ctx) {
    Ok(v) => debug_assert(value_eq(v, HclValue::str("env=staging, id=7")), "standalone eval_template")
    Err(e) => debug_assert(false, "eval_template err: " + e.to_string())
  }
}

///|
test "hcl_extra_object_for_and_legacy_numeric_traversal" {
  let ctx = EvalContext::from_vars([
    ("cfg", HclValue::object([("z", HclValue::int(2)), ("a", HclValue::int(1))])),
    ("arr", HclValue::tuple([HclValue::str("zero"), HclValue::str("one")])),
  ])
  match eval_expr("[for k, v in cfg : \"${k}=${v}\"]", ctx) {
    Ok(v) =>
    debug_assert(
      value_eq(v, HclValue::tuple([HclValue::str("a=1"), HclValue::str("z=2")])),
      "object for iterates in deterministic sorted key order",
    )
    Err(e) => debug_assert(false, "object for err: " + e.to_string())
  }
  match eval_expr("arr.1", ctx) {
    Ok(v) => debug_assert(value_eq(v, HclValue::str("one")), "legacy numeric traversal arr.1")
    Err(e) => debug_assert(false, "legacy numeric traversal err: " + e.to_string())
  }
}

///|
test "hcl_extra_multilabel_blocks_to_json" {
  let ctx = EvalContext::from_vars([("region", HclValue::str("ap-northeast-1"))])
  let src =
  "resource \"aws_instance\" \"web\" {\n" +
  "  region = region\n" +
  "  count  = 2\n" +
  "}\n" +
  "resource \"aws_instance\" \"api\" {\n" +
  "  region = region\n" +
  "  count  = 4\n" +
  "}\n"
  match eval_body_to_json(src, ctx) {
    Ok(js) => {
      let expected =
      "{\"resource\":{\"aws_instance\":{\"api\":[{\"count\":4,\"region\":\"ap-northeast-1\"}],\"web\":[{\"count\":2,\"region\":\"ap-northeast-1\"}]}}}"
      debug_assert(js == expected, "eval_body_to_json mismatch:\nGOT: " + js + "\nEXP: " + expected)
    }
    Err(e) => debug_assert(false, "eval_body_to_json err: " + e.to_string())
  }
}

///|
test "hcl_extra_more_builtins" {
  let ctx = EvalContext::empty()
  let check = fn(expr : String, expected : HclValue, msg : String) -> Unit {
    match eval_expr(expr, ctx) {
      Ok(v) => debug_assert(value_eq(v, expected), msg)
      Err(e) => debug_assert(false, msg + " err: " + e.to_string())
    }
  }
  check("trimprefix(\"pre_val\", \"pre_\")", HclValue::str("val"), "trimprefix")
  check("trimsuffix(\"val_suf\", \"_suf\")", HclValue::str("val"), "trimsuffix")
  check("startswith(\"terraform\", \"terra\")", HclValue::bool(true), "startswith")
  check("endswith(\"terraform\", \"form\")", HclValue::bool(true), "endswith")
  check("substr(\"abcdef\", 2, 3)", HclValue::str("cde"), "substr")
  check("compact([\"a\", \"\", null, \"b\"])", HclValue::tuple([HclValue::str("a"), HclValue::str("b")]), "compact")
  check("reverse([1, 2, 3])", HclValue::tuple([HclValue::int(3), HclValue::int(2), HclValue::int(1)]), "reverse")
  check("sort([\"c\", \"a\", \"b\"])", HclValue::tuple([HclValue::str("a"), HclValue::str("b"), HclValue::str("c")]), "sort")
  check("element([\"x\", \"y\"], 3)", HclValue::str("y"), "element wrap-around")
  check("index([\"x\", \"y\", \"z\"], \"y\")", HclValue::int(1), "index")
  check("slice([10, 20, 30, 40], 1, 3)", HclValue::tuple([HclValue::int(20), HclValue::int(30)]), "slice")
  check("coalescelist([], [1, 2], [3])", HclValue::tuple([HclValue::int(1), HclValue::int(2)]), "coalescelist")
  check("tostring(123)", HclValue::str("123"), "tostring")
  check("tonumber(\"42.5\")", HclValue::number(42.5), "tonumber")
  check("tobool(\"true\")", HclValue::bool(true), "tobool")
  check("tolist([1, 2])", HclValue::tuple([HclValue::int(1), HclValue::int(2)]), "tolist")
  check("tomap({ a = 1 })", HclValue::object([("a", HclValue::int(1))]), "tomap")
}

///|
test "hcl_extra_format_crlf_and_complex_idempotency" {
  let raw =
  "variable \"env\" {\r\n" +
  "default=\"prod\"\r\n" +
  "type=string\r\n" +
  "}\r\n\r\n\r\n" +
  "locals {\r\n" +
  "tags={\r\n" +
  "env=var.env\r\n" +
  "managed_by=\"terraform\"\r\n" +
  "}\r\n" +
  "}\r\n"
  let f1 = match format_hcl(raw) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "format_hcl crlf failed: " + e.to_string())
      ""
    }
  }
  let f2 = match format_hcl(f1) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "format_hcl second pass failed: " + e.to_string())
      ""
    }
  }
  debug_assert(f1 == f2, "complex CRLF format must be idempotent")
}
