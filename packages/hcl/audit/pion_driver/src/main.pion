///| Pion driver for the packages/hcl red-team audit (same case format and output as ../go_oracle).
///|
///|   hcl_audit_driver cases <cases.tsv>          differential cases (`id<TAB>mode<TAB>hex(input)`)
///|   hcl_audit_driver probe <kind> <n> [depth]   one DoS probe under default limits (or raised max_depth)

import "hcl"

fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

fn from_hex(buf : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_val(buf[start + 2 * i].to_int())
    let lo = hex_val(buf[start + 2 * i + 1].to_int())
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

fn slice_str(buf : Bytes, start : Int, end : Int) -> String {
  let n = end - start
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = buf[start + i]
    i = i + 1
  }
  out.to_string()
}

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///| Fixed evaluation context; mirrors `stdCtx` in ../go_oracle/main.go exactly.
fn std_ctx() -> hcl::EvalContext {
  hcl::EvalContext::from_vars([
    ("s", hcl::HclValue::str("hello")),
    ("n", hcl::HclValue::int(4)),
    ("f", hcl::HclValue::number(1.5)),
    ("t", hcl::HclValue::bool(true)),
    ("nul", hcl::HclValue::null()),
    ("l", hcl::HclValue::tuple([hcl::HclValue::str("a"), hcl::HclValue::str("b"), hcl::HclValue::str("c")])),
    ("e", hcl::HclValue::tuple([])),
    (
      "o",
      hcl::HclValue::object([
        ("a", hcl::HclValue::int(1)),
        ("b", hcl::HclValue::str("x")),
        ("c", hcl::HclValue::tuple([hcl::HclValue::int(1), hcl::HclValue::int(2)])),
      ]),
    ),
    (
      "objs",
      hcl::HclValue::tuple([
        hcl::HclValue::object([("id", hcl::HclValue::str("x")), ("v", hcl::HclValue::int(1))]),
        hcl::HclValue::object([("id", hcl::HclValue::str("y")), ("v", hcl::HclValue::int(2))]),
      ]),
    ),
    (
      "nested",
      hcl::HclValue::tuple([
        hcl::HclValue::tuple([hcl::HclValue::int(1), hcl::HclValue::int(2)]),
        hcl::HclValue::tuple([hcl::HclValue::int(3)]),
      ]),
    ),
  ])
}

fn value_result(r : Result[hcl::HclValue, hcl::HclError]) -> String {
  match r {
    Ok(v) =>
    match hcl::value_to_json(v) {
      Ok(js) => "OK\t" + js
      Err(_) => "ERR\t-"
    }
    Err(_) => "ERR\t-"
  }
}

fn string_result(r : Result[String, hcl::HclError]) -> String {
  match r {
    Ok(js) => "OK\t" + js
    Err(_) => "ERR\t-"
  }
}

fn run_case(mode : String, src : String) -> String {
  let ctx = std_ctx()
  if mode == "expr" {
    value_result(hcl::eval_expr(src, ctx))
  } else if mode == "tmpl" {
    value_result(hcl::eval_template(src, ctx))
  } else if mode == "body" {
    string_result(hcl::eval_body_to_json(src, ctx))
  } else if mode == "json" {
    string_result(hcl::eval_json_body_to_json(src, ctx))
  } else if mode == "fmt" {
    match hcl::format_hcl(src) {
      Ok(out) => value_result(Ok(hcl::HclValue::str(out)))
      Err(_) => "ERR\t-"
    }
  } else if mode == "fmt2" {
    match hcl::format_hcl(src) {
      Ok(once) =>
      match hcl::format_hcl(once) {
        Ok(twice) => if twice == once { "OK\ttrue" } else { "OK\tfalse" }
        Err(_) => "ERR\t-"
      }
      Err(_) => "ERR\t-"
    }
  } else {
    "ERR\t-"
  }
}

fn run_cases(world : World, path : String) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "error: cannot read " + path)
      return 2
    }
  }
  let n = buf.length()
  let sb = StringBuilder::new()
  let mut pos = 0
  while pos < n {
    let mut nl = pos
    while nl < n && buf[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl > pos && buf[pos].to_int() != 35 {
      let mut t1 = pos
      while t1 < nl && buf[t1].to_int() != 9 {
        t1 = t1 + 1
      }
      let mut t2 = t1 + 1
      while t2 < nl && buf[t2].to_int() != 9 {
        t2 = t2 + 1
      }
      let id = slice_str(buf, pos, t1)
      let mode = slice_str(buf, t1 + 1, t2)
      let src = from_hex(buf, t2 + 1, nl).to_string()
      sb.write_string(id)
      sb.write_string("\t")
      sb.write_string(run_case(mode, src))
      sb.write_string("\n")
    }
    pos = nl + 1
  }
  io_print(world, sb.to_string())
  0
}

fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///| DoS probe inputs; every probe must come back as a clean `Err` (or bounded `Ok`), never a crash.
fn probe_src(kind : String, n : Int) -> (String, String) {
  if kind == "tuple" {
    ("expr", repeat("[", n) + "1" + repeat("]", n))
  } else if kind == "paren" {
    ("expr", repeat("(", n) + "1" + repeat(")", n))
  } else if kind == "object" {
    ("expr", repeat("{a=", n) + "1" + repeat("}", n))
  } else if kind == "unary" {
    ("expr", repeat("-", n) + "1")
  } else if kind == "not" {
    ("expr", repeat("!", n) + "true")
  } else if kind == "binop" {
    ("expr", "1" + repeat("+1", n))
  } else if kind == "cond" {
    ("expr", repeat("true ? ", n) + "1" + repeat(" : 0", n))
  } else if kind == "cond_tail" {
    ("expr", repeat("false ? 0 : ", n) + "1")
  } else if kind == "funcall" {
    ("expr", repeat("abs(", n) + "1" + repeat(")", n))
  } else if kind == "attr_chain" {
    ("expr", "o" + repeat(".x", n))
  } else if kind == "template" {
    ("expr", repeat("\"${", n) + "1" + repeat("}\"", n))
  } else if kind == "for" {
    ("expr", repeat("[for x in [1] : ", n) + "1" + repeat("]", n))
  } else if kind == "tmpl_if" {
    ("tmpl", repeat("%{if true}", n) + "x" + repeat("%{endif}", n))
  } else if kind == "block" {
    ("body", repeat("a {\n", n) + repeat("}\n", n))
  } else if kind == "heredoc_unclosed" {
    ("body", "a = <<EOF\n" + repeat("line\n", n))
  } else if kind == "comment_unclosed" {
    ("body", "/*" + repeat("x", n))
  } else if kind == "long_ident" {
    ("body", repeat("a", n) + " = 1\n")
  } else if kind == "amp_body" {
    // ~120-byte input: n references to one 1 MB string -> n MB of eval_body_to_json output
    ("body", "a = [for b in [join(\"\", [for i in range(100000) : \"xxxxxxxxxx\"])] : [for i in range(" + n.to_string() + ") : b]][0]\n")
  } else if kind == "amp_jsonencode" {
    ("expr", "length(jsonencode([for b in [join(\"\", [for i in range(100000) : \"xxxxxxxxxx\"])] : [for i in range(" + n.to_string() + ") : b]][0]))")
  } else if kind == "amp_template" {
    ("expr", "length(\"%{for x in [for b in [join(\"\", [for i in range(100000) : \"xxxxxxxxxx\"])] : [for i in range(" + n.to_string() + ") : b]][0]}${x}%{endfor}\")")
  } else if kind == "for_product" {
    ("expr", "length(flatten([for a in range(" + n.to_string() + ") : [for b in range(" + n.to_string() + ") : [for c in range(" + n.to_string() + ") : 1]]]))")
  } else if kind == "range_huge" {
    ("expr", "length(range(" + n.to_string() + "))")
  } else if kind == "fmt_tuple" {
    ("fmt", "a = " + repeat("[", n) + repeat("]", n) + "\n")
  } else if kind == "fmt_align" {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < n {
      sb.write_string("k")
      sb.write_string(i.to_string())
      sb.write_string("=1\n")
      i = i + 1
    }
    ("fmt", sb.to_string())
  } else if kind == "fmt_block" {
    ("fmt", repeat("a {\n", n) + repeat("}\n", n))
  } else if kind == "json_array" {
    ("json", "{\"a\":" + repeat("[", n) + repeat("]", n) + "}")
  } else {
    ("none", "")
  }
}

fn probe_eval(mode : String, src : String, ctx : hcl::EvalContext) -> Result[String, hcl::HclError] {
  if mode == "expr" {
    match hcl::eval_expr(src, ctx) {
      Ok(v) => hcl::value_to_json(v)
      Err(e) => Err(e)
    }
  } else if mode == "tmpl" {
    match hcl::eval_template(src, ctx) {
      Ok(v) => hcl::value_to_json(v)
      Err(e) => Err(e)
    }
  } else if mode == "body" {
    hcl::eval_body_to_json(src, ctx)
  } else if mode == "json" {
    hcl::eval_json_body_to_json(src, ctx)
  } else {
    hcl::format_hcl_with_limits(src, ctx.limits)
  }
}

///| `max_depth` 0 keeps `HclLimits::default()`; otherwise only `max_depth` is raised.
fn run_probe(world : World, kind : String, n : Int, max_depth : Int) -> Int {
  let (mode, src) = probe_src(kind, n)
  let d = hcl::HclLimits::default()
  let limits = if max_depth > 0 {
    hcl::HclLimits::new(max_depth, d.max_steps, d.max_output_bytes)
  } else {
    d
  }
  let ctx = std_ctx().with_limits(limits)
  let detail = match probe_eval(mode, src, ctx) {
    Ok(out) => "OK out_bytes=" + out.length().to_string()
    Err(e) => "ERR " + hcl::error_kind_as_str(e.kind)
  }
  io_println(world, "probe " + kind + " n=" + n.to_string() + " in_bytes=" + src.length().to_string() + " -> " + detail)
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 3 && args[1] == "cases" {
    run_cases(world, args[2])
  } else if args.length() >= 4 && args[1] == "probe" {
    let depth = if args.length() >= 5 { parse_int(args[4]) } else { 0 }
    run_probe(world, args[2], parse_int(args[3]), depth)
  } else {
    io_eprintln(world, "usage: hcl_audit_driver cases <file> | probe <kind> <n> [max_depth]")
    2
  }
}
