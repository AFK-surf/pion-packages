///| HCL2 expression evaluation compliance tests: operator precedence, short-circuit,
///| templates & whitespace chomping, single-interpolation unwrap, `for` comprehensions,
///| splat (`[*]` and `.*`), ternary, function calls with `...` expansion, 30+ built-ins,
///| custom functions, and deterministic `eval_body_to_json`.

fn assert_eval_ok(expr : String, ctx : EvalContext, expected : HclValue, msg : String) -> Unit {
  match eval_expr(expr, ctx) {
    Ok(got) =>
    debug_assert(
      value_eq(got, expected),
      msg + " (expr: " + expr + ")",
    )
    Err(e) =>
    debug_assert(false, msg + " (unexpected err: " + e.to_string() + ", expr: " + expr + ")")
  }
}

fn assert_eval_err_kind(
  expr : String,
  ctx : EvalContext,
  expected : HclErrorKind,
  msg : String,
) -> Unit {
  match eval_expr(expr, ctx) {
    Ok(_) => debug_assert(false, msg + " (expected error, got Ok for: " + expr + ")")
    Err(e) =>
    debug_assert(
      e.is_kind(expected),
      msg + " (expected " + error_kind_as_str(expected) + ", got " + e.to_string() + ")",
    )
  }
}

///|
test "hcl_eval_precedence_and_short_circuit" {
  let ctx = EvalContext::empty()
  assert_eval_ok("1 + 2 * 3", ctx, HclValue::int(7), "mul binds tighter than add")
  assert_eval_ok("(1 + 2) * 3", ctx, HclValue::int(9), "parens override precedence")
  assert_eval_ok("10 - 3 - 2", ctx, HclValue::int(5), "left-associative subtraction")
  assert_eval_ok("10 % 3", ctx, HclValue::int(1), "modulo")
  assert_eval_ok("-5 + 2", ctx, HclValue::int(-3), "unary minus")
  assert_eval_ok("!false && true", ctx, HclValue::bool(true), "unary not + and")
  assert_eval_ok("1 + 2 == 3 && 4 > 2", ctx, HclValue::bool(true), "arith < cmp < logic")
  assert_eval_ok("true || false && false", ctx, HclValue::bool(true), "and binds tighter than or")
  assert_eval_ok("1 == 2 ? 10 : 20", ctx, HclValue::int(20), "ternary false branch")
  assert_eval_ok("1 < 2 ? 10 : 20", ctx, HclValue::int(10), "ternary true branch")

  // Short-circuiting: division by zero in unevaluated branch must not error
  assert_eval_ok("false && (1 / 0 == 0)", ctx, HclValue::bool(false), "&& short-circuits")
  assert_eval_ok("true || (1 / 0 == 0)", ctx, HclValue::bool(true), "|| short-circuits")
  assert_eval_ok("true ? 42 : (1 / 0)", ctx, HclValue::int(42), "ternary short-circuits false")
  assert_eval_ok("false ? (1 / 0) : 99", ctx, HclValue::int(99), "ternary short-circuits true")
  assert_eval_err_kind("1 / 0", ctx, HclErrorKind::DivisionByZero, "direct div by zero errors")
}

///|
test "hcl_eval_templates_unwrap_directives_and_strip" {
  let ctx = EvalContext::from_vars([
    ("name", HclValue::str("alice")),
    ("count", HclValue::int(5)),
    ("flag", HclValue::bool(true)),
    ("items", HclValue::tuple([HclValue::str("a"), HclValue::str("b"), HclValue::str("c")])),
    (
      "var",
      HclValue::object([
        ("env", HclValue::str("prod")),
        ("port", HclValue::int(443)),
      ]),
    ),
  ])

  // Basic interpolation
  assert_eval_ok("\"hello ${name}!\"", ctx, HclValue::str("hello alice!"), "basic interp")
  assert_eval_ok("\"${var.env}:${var.port}\"", ctx, HclValue::str("prod:443"), "multi interp")

  // Single-interpolation unwrap rule: "${expr}" preserves type!
  assert_eval_ok("\"${count}\"", ctx, HclValue::int(5), "single interp unwraps number")
  assert_eval_ok("\"${flag}\"", ctx, HclValue::bool(true), "single interp unwraps bool")
  assert_eval_ok(
    "\"${items}\"",
    ctx,
    HclValue::tuple([HclValue::str("a"), HclValue::str("b"), HclValue::str("c")]),
    "single interp unwraps tuple",
  )
  // Per HCL2 spec (hashicorp/hcl/v2), strip markers on a sole interpolation still unwrap to raw typed value
  assert_eval_ok("\"${~count~}\"", ctx, HclValue::int(5), "strip marker preserves unwrap")

  // %{if} / %{else} / %{endif}
  assert_eval_ok(
    "\"%{if flag}yes%{else}no%{endif}\"",
    ctx,
    HclValue::str("yes"),
    "template if true",
  )
  assert_eval_ok(
    "\"%{if !flag}yes%{else}no%{endif}\"",
    ctx,
    HclValue::str("no"),
    "template if false",
  )

  // %{for} with whitespace chomping ~
  assert_eval_ok(
    "\"[ %{for i, v in items ~}${i}=${v}%{if i < 2}, %{endif}%{~ endfor} ]\"",
    ctx,
    HclValue::str("[ 0=a, 1=b, 2=c ]"),
    "template for + nested if + strip markers",
  )
  assert_eval_ok(
    "\"  hello  ${~ name ~}  !  \"",
    ctx,
    HclValue::str("  helloalice!  "),
    "interp ~ strips adjacent spaces",
  )
}

///|
test "hcl_eval_for_comprehensions_and_objects" {
  let ctx = EvalContext::from_vars([
    (
      "nums",
      HclValue::tuple([
        HclValue::int(1),
        HclValue::int(2),
        HclValue::int(3),
        HclValue::int(4),
      ]),
    ),
    (
      "users",
      HclValue::tuple([
        HclValue::object([("name", HclValue::str("ann")), ("role", HclValue::str("dev"))]),
        HclValue::object([("name", HclValue::str("bob")), ("role", HclValue::str("ops"))]),
        HclValue::object([("name", HclValue::str("cat")), ("role", HclValue::str("dev"))]),
      ]),
    ),
    ("dyn_key", HclValue::str("computed")),
  ])

  // Tuple for comprehension with if filter
  assert_eval_ok(
    "[for n in nums : n * 10 if n % 2 == 0]",
    ctx,
    HclValue::tuple([HclValue::int(20), HclValue::int(40)]),
    "for tuple with if filter",
  )

  // Object for comprehension with grouping `...`
  assert_eval_ok(
    "{for u in users : u.role => u.name...}",
    ctx,
    HclValue::object([
      ("dev", HclValue::tuple([HclValue::str("ann"), HclValue::str("cat")])),
      ("ops", HclValue::tuple([HclValue::str("bob")])),
    ]),
    "for object with ellipsis grouping",
  )

  // Duplicate key without grouping must error
  assert_eval_err_kind(
    "{for u in users : u.role => u.name}",
    ctx,
    HclErrorKind::DuplicateKey,
    "for object duplicate key without ... must fail",
  )

  // Object constructor with parenthesized dynamic key
  assert_eval_ok(
    "{ a = 1, (dyn_key) = 2 }",
    ctx,
    HclValue::object([("a", HclValue::int(1)), ("computed", HclValue::int(2))]),
    "object constructor with dynamic (expr) key",
  )
}

///|
test "hcl_eval_splat_full_and_attr_only" {
  let ctx = EvalContext::from_vars([
    (
      "list",
      HclValue::tuple([
        HclValue::object([
          ("id", HclValue::str("i-1")),
          ("tags", HclValue::object([("env", HclValue::str("prod"))])),
        ]),
        HclValue::object([
          ("id", HclValue::str("i-2")),
          ("tags", HclValue::object([("env", HclValue::str("dev"))])),
        ]),
      ]),
    ),
    ("single", HclValue::object([("id", HclValue::str("i-solo"))])),
    ("nothing", HclValue::null()),
  ])

  assert_eval_ok(
    "list[*].id",
    ctx,
    HclValue::tuple([HclValue::str("i-1"), HclValue::str("i-2")]),
    "full splat attr access",
  )
  assert_eval_ok(
    "list[*].tags[\"env\"]",
    ctx,
    HclValue::tuple([HclValue::str("prod"), HclValue::str("dev")]),
    "full splat chained attr + index",
  )
  assert_eval_ok(
    "list.*.id",
    ctx,
    HclValue::tuple([HclValue::str("i-1"), HclValue::str("i-2")]),
    "legacy attr-only splat",
  )
  assert_eval_ok(
    "single[*].id",
    ctx,
    HclValue::tuple([HclValue::str("i-solo")]),
    "full splat wraps non-list scalar/object",
  )
  assert_eval_ok("nothing[*].id", ctx, HclValue::tuple([]), "full splat on null yields []")
}

///|
test "hcl_eval_builtin_functions_and_expansion" {
  let ctx = EvalContext::from_vars([
    ("extra", HclValue::tuple([HclValue::tuple([HclValue::int(3), HclValue::int(4)])])),
    ("m", HclValue::object([("a", HclValue::int(1)), ("b", HclValue::int(2))])),
  ])

  // String functions
  assert_eval_ok("lower(\"HeLLo\")", ctx, HclValue::str("hello"), "lower")
  assert_eval_ok("upper(\"HeLLo\")", ctx, HclValue::str("HELLO"), "upper")
  assert_eval_ok("trim(\"?!hello!?\", \"?!\")", ctx, HclValue::str("hello"), "trim")
  assert_eval_ok("trimspace(\"  hi\\t\\n \")", ctx, HclValue::str("hi"), "trimspace")
  assert_eval_ok(
    "split(\",\", \"a,b,c\")",
    ctx,
    HclValue::tuple([HclValue::str("a"), HclValue::str("b"), HclValue::str("c")]),
    "split",
  )
  assert_eval_ok("join(\"-\", [\"a\", \"b\", \"c\"])", ctx, HclValue::str("a-b-c"), "join")
  assert_eval_ok("replace(\"foo-bar-foo\", \"foo\", \"baz\")", ctx, HclValue::str("baz-bar-baz"), "replace")
  assert_eval_ok("format(\"%s:%d\", \"host\", 80)", ctx, HclValue::str("host:80"), "format")

  // Collection functions + ... expansion
  assert_eval_ok("length([1, 2, 3])", ctx, HclValue::int(3), "length list")
  assert_eval_ok("length(\"héllo\")", ctx, HclValue::int(5), "length unicode string")
  assert_eval_ok("length(m)", ctx, HclValue::int(2), "length object")
  assert_eval_ok(
    "concat([1, 2], extra...)",
    ctx,
    HclValue::tuple([HclValue::int(1), HclValue::int(2), HclValue::int(3), HclValue::int(4)]),
    "concat with ... expansion",
  )
  assert_eval_ok(
    "flatten([[1, [2]], [3]])",
    ctx,
    HclValue::tuple([HclValue::int(1), HclValue::int(2), HclValue::int(3)]),
    "flatten",
  )
  assert_eval_ok(
    "distinct([1, 2, 1, 3, 2])",
    ctx,
    HclValue::tuple([HclValue::int(1), HclValue::int(2), HclValue::int(3)]),
    "distinct",
  )
  assert_eval_ok(
    "merge({ a = 1, b = 2 }, { b = 20, c = 3 })",
    ctx,
    HclValue::object([("a", HclValue::int(1)), ("b", HclValue::int(20)), ("c", HclValue::int(3))]),
    "merge",
  )
  assert_eval_ok(
    "keys(m)",
    ctx,
    HclValue::tuple([HclValue::str("a"), HclValue::str("b")]),
    "keys sorted",
  )
  assert_eval_ok(
    "values(m)",
    ctx,
    HclValue::tuple([HclValue::int(1), HclValue::int(2)]),
    "values in sorted key order",
  )
  assert_eval_ok("lookup(m, \"b\", 99)", ctx, HclValue::int(2), "lookup hit")
  assert_eval_ok("lookup(m, \"missing\", 99)", ctx, HclValue::int(99), "lookup default")
  assert_eval_ok("coalesce(null, \"\", \"ok\", \"later\")", ctx, HclValue::str("ok"), "coalesce")
  assert_eval_ok("try(m.missing, 1 / 0, \"fallback\")", ctx, HclValue::str("fallback"), "try")
  assert_eval_ok("can(m.a)", ctx, HclValue::bool(true), "can true")
  assert_eval_ok("can(m.missing)", ctx, HclValue::bool(false), "can false")

  // Numeric & generator functions
  assert_eval_ok("min(5, 2, 9)", ctx, HclValue::int(2), "min")
  assert_eval_ok("max(5, 2, 9)", ctx, HclValue::int(9), "max")
  assert_eval_ok("abs(-42)", ctx, HclValue::int(42), "abs")
  assert_eval_ok("ceil(2.1)", ctx, HclValue::int(3), "ceil")
  assert_eval_ok("floor(2.9)", ctx, HclValue::int(2), "floor")
  assert_eval_ok(
    "range(1, 6, 2)",
    ctx,
    HclValue::tuple([HclValue::int(1), HclValue::int(3), HclValue::int(5)]),
    "range",
  )
  assert_eval_ok(
    "zipmap([\"x\", \"y\"], [10, 20])",
    ctx,
    HclValue::object([("x", HclValue::int(10)), ("y", HclValue::int(20))]),
    "zipmap",
  )
  assert_eval_ok("contains([\"a\", \"b\"], \"b\")", ctx, HclValue::bool(true), "contains true")
  assert_eval_ok("contains([\"a\", \"b\"], \"z\")", ctx, HclValue::bool(false), "contains false")

  // JSON encode / decode roundtrip
  assert_eval_ok("jsonencode({ b = 2, a = 1 })", ctx, HclValue::str("{\"a\":1,\"b\":2}"), "jsonencode deterministic")
  assert_eval_ok(
    "jsondecode(\"{\\\"x\\\":[1,true]}\")",
    ctx,
    HclValue::object([("x", HclValue::tuple([HclValue::int(1), HclValue::bool(true)]))]),
    "jsondecode",
  )

  // Custom function registration
  let custom_ctx = ctx.with_func(
    "double_it",
    fn(args : Array[HclValue]) -> Result[HclValue, HclError] {
      if args.length() != 1 {
        return Err(HclError::new(HclErrorKind::InvalidArgument, "expected 1 arg", Span::zero()))
      }
      match args[0] {
        HclValue::Number(n) => Ok(HclValue::number(n * 2.0))
        _ => Err(HclError::new(HclErrorKind::TypeError, "expected number", Span::zero()))
      }
    },
  )
  assert_eval_ok("double_it(21)", custom_ctx, HclValue::int(42), "custom user function")
}
