///| Wasm32 + Native smoke entry for `packages/hcl`.

import "hcl"

///|
pub fn smoke() -> Int {
  // 1. Parse + evaluate Terraform-like HCL body with heredoc, templates, for, splat, and builtins
  let ctx = hcl::EvalContext::from_vars([
    ("env", hcl::HclValue::str("prod")),
    ("replicas", hcl::HclValue::int(3)),
    (
      "nodes",
      hcl::HclValue::tuple([
        hcl::HclValue::object([("id", hcl::HclValue::str("n1")), ("weight", hcl::HclValue::int(10))]),
        hcl::HclValue::object([("id", hcl::HclValue::str("n2")), ("weight", hcl::HclValue::int(20))]),
      ]),
    ),
  ])
  let src =
  "service = \"api-${env}\"\n" +
  "count = \"${replicas}\"\n" +
  "ids = nodes[*].id\n" +
  "heavy = [for n in nodes : upper(n.id) if n.weight >= 15]\n" +
  "banner = <<-EOF\n" +
  "    env=${env}\n" +
  "    %{for n in nodes ~}${n.id},%{endfor}\n" +
  "  EOF\n"
  let js = match hcl::eval_body_to_json(src, ctx) {
    Ok(s) => s
    Err(_) => return -1
  }
  let expected_js =
  "{\"banner\":\"env=prod\\nn1,n2,\\n\",\"count\":3,\"heavy\":[\"N2\"],\"ids\":[\"n1\",\"n2\"],\"service\":\"api-prod\"}"
  if js != expected_js {
    return -2
  }

  // 2. JSON syntax equivalence
  let json_src = "{\"service\":\"api-${env}\",\"count\":\"${replicas}\"}"
  match hcl::eval_json_body_to_json(json_src, ctx) {
    Ok(j2) => {
      if j2 != "{\"count\":3,\"service\":\"api-prod\"}" {
        return -3
      }
    }
    Err(_) => return -4
  }

  // 3. Canonical format_hcl + idempotency
  let raw_fmt = "resource \"aws_s3_bucket\" \"b\"{\nbucket=\"logs\"\nacl=\"private\"\n}\n"
  let expected_fmt =
  "resource \"aws_s3_bucket\" \"b\" {\n" +
  "  bucket = \"logs\"\n" +
  "  acl    = \"private\"\n" +
  "}\n"
  let f1 = match hcl::format_hcl(raw_fmt) {
    Ok(s) => s
    Err(_) => return -5
  }
  if f1 != expected_fmt {
    return -6
  }
  match hcl::format_hcl(f1) {
    Ok(f2) => {
      if f2 != f1 {
        return -7
      }
    }
    Err(_) => return -8
  }

  // 4. DoS safety limits (depth + steps + output_bytes, 0 trap on Wasm32)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 80 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 80 {
    sb.write_string(")")
    i = i + 1
  }
  match hcl::parse_expr_with_limits(sb.to_string(), hcl::HclLimits::new(32, 10000L, 4096)) {
    Ok(_) => return -9
    Err(e) => {
      if !e.is_kind(hcl::HclErrorKind::LimitExceeded) {
        return -10
      }
    }
  }
  let tight_ctx = hcl::EvalContext::empty().with_limits(hcl::HclLimits::new(64, 40L, 4096))
  match hcl::eval_expr("[for a in range(15) : [for b in range(15) : a + b]]", tight_ctx) {
    Ok(_) => return -11
    Err(e) => {
      if !e.is_kind(hcl::HclErrorKind::LimitExceeded) {
        return -12
      }
    }
  }
  4
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "hcl_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "hcl_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
