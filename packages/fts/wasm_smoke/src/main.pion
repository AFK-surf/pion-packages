///| Cross-target smoke entry for the `fts` package.
///| Its stdout must be byte-identical on Native and wasm32, debug and release.

import "fts"

///|
fn join_arr(xs : Array[String], sep : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(xs[i])
    i = i + 1
  }
  sb.to_string()
}

///|
fn format_hits(hits : Array[fts::Hit]) -> String {
  let sb = StringBuilder::new()
  sb.write_string("n=")
  sb.write_string(hits.length().to_string())
  let mut i = 0
  while i < hits.length() {
    let h = hits[i]
    let q = (h.score * 1000000.0 + 0.5).to_int64()
    sb.write_string(" ")
    sb.write_string(h.doc_id.to_string())
    sb.write_string(":")
    sb.write_string(q.to_string())
    sb.write_string(":")
    sb.write_string(h.order_key.to_string())
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let samples = [
    "Hello World 中文全文检索",
    "GroupSurface HTTPServer nc_follow #1234 a1b2c3d4e5f60718",
    "Café ÜBER Ωμέγα ΔΕΛΤΑ Привет Ёлка",
    "日本語ひらがなカタカナと한국어テスト",
  ]
  let mut i = 0
  while i < samples.length() {
    io_println(world, "tok[" + i.to_string() + "]=" + join_arr(fts::tokenize(samples[i]), "|"))
    io_println(world, "fts5[" + i.to_string() + "]=" + fts::fts5_index_text(samples[i]))
    i = i + 1
  }

  let queries = [
    "hello world",
    "全文检索",
    "中",
    "surface",
    "nc_follow",
    "#1234",
    "a1b2c3d4e",
    "tok* \"quick brown\" NOT legacy",
    "\"quick brown\"",
  ]
  i = 0
  while i < queries.length() {
    io_println(world, "match[" + i.to_string() + "]=" + fts::fts5_match_expr(queries[i]))
    i = i + 1
  }

  let idx = fts::Index::new()
  idx.upsert(1L, "hello world 中文全文检索", order_key=10L, tags=[("lang", "zh")])
  idx.upsert(2L, "hello pion nc_follow GroupSurface #1234", order_key=20L, tags=[("lang", "en")])
  idx.upsert(3L, "quick brown fox jumps over lazy dog", order_key=30L, tags=[("lang", "en")])
  idx.upsert(4L, "brown quick fox without lazy", order_key=40L, tags=[("lang", "en")])
  idx.upsert(5L, "hello hello world tokenizer tokenizing commit a1b2c3d4e5f60718", order_key=50L, tags=[("lang", "en")])
  idx.upsert(6L, "日本語と한국어と中文の混在テスト", order_key=60L, tags=[("lang", "ja")])

  let search_qs = [
    "hello",
    "hello world",
    "中",
    "全文检索",
    "surface",
    "#1234",
    "a1b2c3d4e",
    "\"quick brown\"",
    "token*",
    "fox NOT lazy",
    "日本語",
    "한국어",
  ]
  i = 0
  while i < search_qs.length() {
    let hits = idx.search(search_qs[i], limit=10)
    io_println(world, "q[" + search_qs[i] + "] -> " + format_hits(hits))
    i = i + 1
  }

  let flt = idx.search("", limit=10, filters=[("lang", "en")])
  io_println(world, "filter[lang=en] -> " + format_hits(flt))

  let removed = idx.remove(4L)
  io_println(world, "removed4=" + removed.to_string() + " len=" + idx.len().to_string())
  io_println(world, "after_remove -> " + format_hits(idx.search("fox", limit=10)))

  let sn1 = fts::snippet("The quick brown fox jumps over the lazy dog.", "fox dog", max_chars=40)
  let sn2 = fts::snippet("这是一个测试纯Pion全文检索引擎多字节UTF8截断安全性的中文长段落🚀结束。", "全文检索", max_chars=20)
  io_println(world, "sn1=" + sn1.text + " hl=" + sn1.highlights.length().to_string())
  io_println(world, "sn2=" + sn2.text + " hl=" + sn2.highlights.length().to_string())
  if sn2.highlights.length() > 0 {
    let (lo, hi) = sn2.highlights[0]
    io_println(world, "sn2_hl0=" + sn2.text.slice(lo, hi))
  }

  // Red-team regressions (audit/REDTEAM_AUDIT.md): FTS5 fold, CJK marks, snippet overflow, BM25 NaN.
  io_println(world, "rt1=" + join_arr(fts::tokenize("Café ÜBER Ÿ ſ İ ς naïve"), "|"))
  io_println(world, "rt2=" + join_arr(fts::tokenize("ア・イ゛カー"), "|"))
  let sn3 = fts::snippet("a a a a a a a a a a a a a a a a a a a a target zz", "target", max_chars=2147483647)
  io_println(world, "rt3=" + sn3.text + " hl=" + sn3.highlights.length().to_string())
  let sn4 = fts::snippet("这是纯Pion全文检索引擎", "\"全文检索\" pr12", max_chars=40)
  if sn4.highlights.length() > 0 {
    let (lo4, hi4) = sn4.highlights[0]
    io_println(world, "rt4=" + sn4.text.slice(lo4, hi4))
  }
  let inf = 1.0e308 * 10.0
  let rt5 = fts::Index::with_bm25(inf, inf - inf)
  rt5.upsert(1L, "alpha beta alpha")
  rt5.upsert(2L, "alpha")
  rt5.upsert(3L, "gamma")
  io_println(world, "rt5 -> " + format_hits(rt5.search("alpha")))
  0
}
