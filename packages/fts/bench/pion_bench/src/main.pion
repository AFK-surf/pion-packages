///| Head-to-head benchmark for `packages/fts` (Pion Native) vs SQLite FTS5.
///| Usage:
///|   fts_bench prepare <num_docs> <raw_tsv> <fts5_tsv> <q_raw> <q_fts5>
///|   fts_bench run <raw_tsv> <q_raw> [query_reps]

import "fts"

///|
fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 10 {
      if i > start {
        out.push(s.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(s.slice(start, n))
  }
  out
}

///|
fn find_tab(s : String) -> Int {
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == 9 {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn parse_i64(s : String) -> Int64 {
  let mut v : Int64 = 0L
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      v = v * 10L + (b - 48).to_int64()
    }
    i = i + 1
  }
  v
}

///|
fn next_rng(seed : Int64) -> Int64 {
  (seed * 6364136223846793005L + 1442695040888963407L) & 0x7FFFFFFFFFFFFFFFL
}

///|
fn pick(arr : Array[String], rng : Int64) -> String {
  let n = arr.length().to_int64()
  let idx = ((rng >> 16) % n).to_int()
  arr[idx]
}

///|
fn bench_queries() -> Array[String] {
  [
    "search engine",
    "inverted index",
    "全文检索",
    "倒排索引",
    "中",
    "日本語",
    "한국어",
    "surface",
    "nc_follow",
    "http",
    "#1042",
    "a1b2c3d4",
    "\"quick brown\"",
    "\"inverted index\"",
    "token*",
    "optim*",
    "search NOT legacy",
    "index NOT deprecated",
    "rust pion",
    "unicode utf8",
    "性能 基准",
    "コード 検索",
    "검색 엔진",
    "parser",
    "bm25",
    "sqlite",
    "cache",
    "async",
    "memory",
    "query",
  ]
}

///|
fn prepare_corpus(
  world : World,
  num_docs : Int,
  raw_path : String,
  fts5_path : String,
  q_raw_path : String,
  q_fts5_path : String,
) -> Int {
  let en_words = [
    "search", "engine", "inverted", "index", "query", "ranking", "bm25", "sqlite",
    "tokenizer", "tokenizing", "tokens", "optimizer", "optimized", "parser", "unicode",
    "utf8", "memory", "cache", "async", "runtime", "quick", "brown", "fox", "rust",
    "pion", "wasm", "native", "legacy", "deprecated", "latency", "throughput", "benchmark",
  ]
  let zh_phrases = [
    "全文检索引擎", "倒排索引结构", "中文分词算法", "性能优化基准", "跨平台编译",
    "内存占用分析", "零拷贝解码", "确定性排序", "高并发查询", "多语种混合语料",
  ]
  let jp_phrases = [
    "日本語の全文検索", "高速なコード検索", "形態素とバイグラム", "メモリ効率テスト",
    "マルチプラットフォーム対応",
  ]
  let kr_phrases = [
    "한국어 검색 엔진", "역색인 성능 측정", "다국어 토크나이저", "메모리 안전성 검증",
  ]
  let code_syms = [
    "GroupSurface", "HTTPServer", "parseUTF8String", "nc_follow", "get_user_id",
    "IndexBuilder", "QueryPlanner", "bm25_scorer", "token_stream", "SnippetView",
  ]
  let shas = [
    "a1b2c3d4e5f60718", "9f8e7d6c5b4a3210", "deadbeef01234567", "1234567890abcdef",
    "f0e1d2c3b4a59687",
  ]

  let raw_sb = StringBuilder::new()
  let fts5_sb = StringBuilder::new()
  let mut rng : Int64 = 0x123456789ABCDEF1L
  let mut i = 1
  while i <= num_docs {
    let doc_sb = StringBuilder::new()
    rng = next_rng(rng)
    doc_sb.write_string(pick(en_words, rng))
    doc_sb.write_string(" ")
    rng = next_rng(rng)
    doc_sb.write_string(pick(en_words, rng))
    doc_sb.write_string(" ")
    rng = next_rng(rng)
    doc_sb.write_string(pick(en_words, rng))
    doc_sb.write_string(" ")
    rng = next_rng(rng)
    doc_sb.write_string(pick(code_syms, rng))
    doc_sb.write_string(" ")
    if i % 3 == 0 {
      rng = next_rng(rng)
      doc_sb.write_string(pick(zh_phrases, rng))
      doc_sb.write_string(" ")
    }
    if i % 7 == 0 {
      rng = next_rng(rng)
      doc_sb.write_string(pick(jp_phrases, rng))
      doc_sb.write_string(" ")
    }
    if i % 11 == 0 {
      rng = next_rng(rng)
      doc_sb.write_string(pick(kr_phrases, rng))
      doc_sb.write_string(" ")
    }
    if i % 13 == 0 {
      doc_sb.write_string("quick brown ")
    }
    if i % 17 == 0 {
      doc_sb.write_string("inverted index ")
    }
    if i % 19 == 0 {
      doc_sb.write_string("#")
      doc_sb.write_string((1000 + (i % 100)).to_string())
      doc_sb.write_string(" ")
    }
    if i % 23 == 0 {
      rng = next_rng(rng)
      doc_sb.write_string(pick(shas, rng))
      doc_sb.write_string(" ")
    }
    rng = next_rng(rng)
    doc_sb.write_string(pick(en_words, rng))

    let raw_doc = doc_sb.to_string()
    let fts5_doc = fts::fts5_index_text(raw_doc)

    raw_sb.write_string(i.to_string())
    raw_sb.write_byte(9.to_byte())
    raw_sb.write_string(raw_doc)
    raw_sb.write_byte(10.to_byte())

    fts5_sb.write_string(i.to_string())
    fts5_sb.write_byte(9.to_byte())
    fts5_sb.write_string(fts5_doc)
    fts5_sb.write_byte(10.to_byte())
    i = i + 1
  }

  let qs = bench_queries()
  let qr_sb = StringBuilder::new()
  let qf_sb = StringBuilder::new()
  let mut qi = 0
  while qi < qs.length() {
    qr_sb.write_string(qs[qi])
    qr_sb.write_byte(10.to_byte())
    qf_sb.write_string(fts::fts5_match_expr(qs[qi]))
    qf_sb.write_byte(10.to_byte())
    qi = qi + 1
  }

  let _ = fs_write_bytes(world, raw_path, raw_sb.to_string().to_bytes())
  let _ = fs_write_bytes(world, fts5_path, fts5_sb.to_string().to_bytes())
  let _ = fs_write_bytes(world, q_raw_path, qr_sb.to_string().to_bytes())
  let _ = fs_write_bytes(world, q_fts5_path, qf_sb.to_string().to_bytes())
  0
}

///|
fn run_bench(world : World, raw_path : String, q_path : String, reps : Int) -> Int {
  let raw = match fs_read(world, raw_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let q_raw = match fs_read(world, q_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let doc_lines = split_lines(raw)
  let queries = split_lines(q_raw)

  let idx = fts::Index::new()
  let mut i = 0
  while i < doc_lines.length() {
    let line = doc_lines[i]
    let tab = find_tab(line)
    if tab > 0 {
      let id = parse_i64(line.slice(0, tab))
      let text = line.slice(tab + 1, line.length())
      idx.upsert(id, text)
    }
    i = i + 1
  }

  let out = StringBuilder::new()
  let mut total_hits : Int64 = 0L
  let mut r = 0
  while r < reps {
    let mut qi = 0
    while qi < queries.length() {
      let hits = idx.search(queries[qi], limit=20)
      total_hits = total_hits + hits.length().to_int64()
      if r == 0 {
        out.write_string("q")
        out.write_string(qi.to_string())
        out.write_string(":")
        out.write_string(hits.length().to_string())
        let mut hi = 0
        while hi < hits.length() {
          out.write_string(if hi == 0 { " " } else { "," })
          out.write_string(hits[hi].doc_id.to_string())
          hi = hi + 1
        }
        out.write_byte(10.to_byte())
      }
      qi = qi + 1
    }
    r = r + 1
  }
  out.write_string("total_hits=")
  out.write_string(total_hits.to_string())
  out.write_string(" docs=")
  out.write_string(idx.len().to_string())
  out.write_string(" reps=")
  out.write_string(reps.to_string())
  io_println(world, out.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: fts_bench prepare|run ...")
    return 2
  }
  let cmd = args[1]
  if cmd == "prepare" && args.length() >= 7 {
    let n = args[2].to_int().unwrap_or(10000)
    prepare_corpus(world, n, args[3], args[4], args[5], args[6])
  } else if cmd == "run" && args.length() >= 4 {
    let reps = if args.length() >= 5 { args[4].to_int().unwrap_or(1) } else { 1 }
    run_bench(world, args[2], args[3], reps)
  } else {
    io_println(world, "invalid arguments")
    2
  }
}
