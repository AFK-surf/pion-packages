///| Unit tests for `packages/fts` UTF-8-safe snippet extraction and highlight spans.

///| Verify every byte in `s` is valid UTF-8 (no truncated multi-byte sequences).
fn is_valid_utf8(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///|
test "snippet_ascii_highlights_and_windowing" {
  let doc = "The quick brown fox jumps over the lazy dog in a sunny meadow."
  let sn = snippet(doc, "fox dog", max_chars=80)
  debug_assert(is_valid_utf8(sn.text), "valid UTF-8")
  debug_assert(sn.highlights.length() == 2, "2 highlight ranges")
  let (s0, e0) = sn.highlights[0]
  let (s1, e1) = sn.highlights[1]
  debug_assert(sn.text.slice(s0, e0) == "fox", "first highlight is fox")
  debug_assert(sn.text.slice(s1, e1) == "dog", "second highlight is dog")

  // Long text with match far in the middle gets leading/trailing ellipsis
  let long_doc = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa target_word bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  let sn2 = snippet(long_doc, "target_word", max_chars=30)
  debug_assert(is_valid_utf8(sn2.text), "windowed snippet valid UTF-8")
  debug_assert(sn2.text.starts_with("…"), "leading ellipsis")
  debug_assert(sn2.text.ends_with("…"), "trailing ellipsis")
  debug_assert(sn2.highlights.length() == 1, "1 highlight in window")
  let (hs, he) = sn2.highlights[0]
  debug_assert(sn2.text.slice(hs, he) == "target_word", "windowed highlight exact")
}

///|
test "snippet_cjk_utf8_safety_never_splits_multibyte" {
  let cjk = "这是一个用于测试纯Pion全文检索引擎多字节UTF8截断安全性的中文长段落，包含日本語と한국어和🚀表情符号。"
  let mut max_c = 1
  while max_c <= 25 {
    let sn = snippet(cjk, "全文检索", max_chars=max_c)
    debug_assert(is_valid_utf8(sn.text), "never splits UTF-8 at max_chars=" + max_c.to_string())
    let mut i = 0
    while i < sn.highlights.length() {
      let (lo, hi) = sn.highlights[i]
      debug_assert(lo >= 0 && lo < hi && hi <= sn.text.length(), "highlight bounds valid")
      debug_assert(is_valid_utf8(sn.text.slice(lo, hi)), "highlight slice valid UTF-8")
      i = i + 1
    }
    max_c = max_c + 1
  }

  let full_sn = snippet(cjk, "全文检索", max_chars=40)
  debug_assert(full_sn.highlights.length() >= 1, "CJK query highlighted")
  let (lo, hi) = full_sn.highlights[0]
  debug_assert(full_sn.text.slice(lo, hi) == "全文检索", "CJK highlight exact substring")
}

///|
test "snippet_not_prefix_phrase_and_edge_cases" {
  let doc = "Rust and Pion build fast tokenizers without legacy baggage."
  // NOT terms must not be highlighted
  let sn = snippet(doc, "token* NOT legacy", max_chars=120)
  debug_assert(sn.highlights.length() == 1, "only positive prefix term highlighted")
  let (lo, hi) = sn.highlights[0]
  debug_assert(sn.text.slice(lo, hi) == "token", "prefix match highlighted")

  // Edge cases: empty text, empty query, zero/negative max_chars
  let s_empty = snippet("", "hello")
  debug_assert(s_empty.text == "" && s_empty.highlights.length() == 0, "empty text")
  let s_zero = snippet(doc, "Pion", max_chars=0)
  debug_assert(s_zero.text == "" && s_zero.highlights.length() == 0, "max_chars=0")
  let s_neg = snippet(doc, "Pion", max_chars=-10)
  debug_assert(s_neg.text == "" && s_neg.highlights.length() == 0, "max_chars<0")
  let s_noq = snippet("line1\nline2\tline3", "")
  debug_assert(s_noq.text == "line1 line2 line3", "newlines flattened to spaces")
  debug_assert(s_noq.highlights.length() == 0, "empty query -> no highlights")
}
