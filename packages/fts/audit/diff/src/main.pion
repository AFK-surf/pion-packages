///| Red-team differential harness for `packages/fts` against SQLite FTS5 (driven by `audit/difftest.py`).
///| All inputs are hex-encoded so arbitrary (including malformed UTF-8) bytes survive the file round trip.
///| Usage:
///|   fts_audit_diff run <docs_hex_tsv> <queries_hex> <out_prefix>
///|   fts_audit_diff snip <pairs_hex_tsv> <out_path>

import "fts"

///|
fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 10 {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(s.slice(start, n))
  }
  out
}

///|
fn find_tab(s : String) -> Int {
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == 9 {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

///|
fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < s.length() {
    sb.write_byte(((hex_val(s.code_unit_at(i)) << 4) | hex_val(s.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
fn write_hex(sb : StringBuilder, s : String) -> Unit {
  let digits = "0123456789abcdef"
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    sb.write_byte(digits.code_unit_at(b >> 4).to_byte())
    sb.write_byte(digits.code_unit_at(b & 15).to_byte())
    i = i + 1
  }
}

///|
fn parse_i64(s : String) -> Int64 {
  let mut v : Int64 = 0L
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      v = v * 10L + (b - 48).to_int64()
    }
    i = i + 1
  }
  v
}

///|
fn run_diff(world : World, docs_path : String, q_path : String, out_prefix : String) -> Int {
  let docs_raw = match fs_read(world, docs_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let q_raw = match fs_read(world, q_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let idx = fts::Index::new()
  let index_sb = StringBuilder::new()
  let doc_lines = split_lines(docs_raw)
  let mut i = 0
  while i < doc_lines.length() {
    let line = doc_lines[i]
    let tab = find_tab(line)
    if tab > 0 {
      let id = parse_i64(line.slice(0, tab))
      let text = unhex(line.slice(tab + 1, line.length()))
      idx.upsert(id, text)
      index_sb.write_string(id.to_string())
      index_sb.write_byte(9.to_byte())
      write_hex(index_sb, fts::fts5_index_text(text))
      index_sb.write_byte(10.to_byte())
    }
    i = i + 1
  }
  let expr_sb = StringBuilder::new()
  let res_sb = StringBuilder::new()
  let qs = split_lines(q_raw)
  i = 0
  while i < qs.length() {
    let q = unhex(qs[i])
    write_hex(expr_sb, fts::fts5_match_expr(q))
    expr_sb.write_byte(10.to_byte())
    let hits = idx.search(q, limit=100000)
    res_sb.write_string(hits.length().to_string())
    let mut h = 0
    while h < hits.length() {
      res_sb.write_byte(32.to_byte())
      res_sb.write_string(hits[h].doc_id.to_string())
      res_sb.write_byte(58.to_byte())
      res_sb.write_string((hits[h].score * 1.0e12 + 0.5).to_int64().to_string())
      h = h + 1
    }
    res_sb.write_byte(10.to_byte())
    i = i + 1
  }
  let _ = fs_write_bytes(world, out_prefix + ".index", index_sb.to_string().to_bytes())
  let _ = fs_write_bytes(world, out_prefix + ".expr", expr_sb.to_string().to_bytes())
  let _ = fs_write_bytes(world, out_prefix + ".hits", res_sb.to_string().to_bytes())
  0
}

///|
fn run_snip(world : World, pairs_path : String, out_path : String) -> Int {
  let raw = match fs_read(world, pairs_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let out = StringBuilder::new()
  let lines = split_lines(raw)
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    let t1 = find_tab(line)
    let rest = line.slice(t1 + 1, line.length())
    let t2 = find_tab(rest)
    let text = unhex(line.slice(0, t1))
    let q = unhex(rest.slice(0, t2))
    let max_chars = rest.slice(t2 + 1, rest.length()).to_int().unwrap_or(120)
    let sn = fts::snippet(text, q, max_chars~)
    write_hex(out, sn.text)
    let mut h = 0
    while h < sn.highlights.length() {
      let (lo, hi) = sn.highlights[h]
      out.write_byte(32.to_byte())
      out.write_string(lo.to_string())
      out.write_byte(58.to_byte())
      out.write_string(hi.to_string())
      h = h + 1
    }
    out.write_byte(10.to_byte())
    i = i + 1
  }
  let _ = fs_write_bytes(world, out_path, out.to_string().to_bytes())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 5 && args[1] == "run" {
    run_diff(world, args[2], args[3], args[4])
  } else if args.length() >= 4 && args[1] == "snip" {
    run_snip(world, args[2], args[3])
  } else {
    io_println(world, "usage: fts_audit_diff run <docs> <queries> <out_prefix> | snip <pairs> <out>")
    2
  }
}
