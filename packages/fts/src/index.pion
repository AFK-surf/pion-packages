///| Pure-Pion in-memory inverted index with Okapi BM25 ranking (SQLite FTS5 parity).

///| A single search hit returned by `Index::search`.
pub struct Hit {
  doc_id : Int64
  score : Double
  order_key : Int64
}

///| Compact sorted posting list: each `Int64` packs `(doc_slot << 32) | (tf & 0xFFFFFFFF)`.
///| Kept strictly sorted by `doc_slot` ascending for O(1) append and galloping intersection.
struct PostingList {
  entries : Array[Int64]
}

///|
fn pack_posting(slot : Int, tf : Int) -> Int64 {
  (slot.to_int64() << 32) | (tf.to_int64() & 0xFFFFFFFFL)
}

///|
fn PostingList::add_occurrence(self : PostingList, slot : Int) -> Unit {
  let entries = self.entries
  let n = entries.length()
  if n == 0 {
    entries.push(pack_posting(slot, 1))
    return
  }
  let last = entries[n - 1]
  let last_slot = (last >> 32).to_int()
  if slot > last_slot {
    entries.push(pack_posting(slot, 1))
    return
  }
  if slot == last_slot {
    entries[n - 1] = last + 1L
    return
  }
  // Slow path: recycled slot < last_slot; binary search for sorted insertion point.
  let target = slot.to_int64() << 32
  let mut lo = 0
  let mut hi = n
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    if entries[mid] < target {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < n && (entries[lo] >> 32).to_int() == slot {
    entries[lo] = entries[lo] + 1L
  } else {
    entries.push(0L)
    let mut k = n
    while k > lo {
      entries[k] = entries[k - 1]
      k = k - 1
    }
    entries[lo] = pack_posting(slot, 1)
  }
}

///|
fn PostingList::remove_slot(self : PostingList, slot : Int) -> Unit {
  let entries = self.entries
  let n = entries.length()
  if n == 0 {
    return
  }
  let target = slot.to_int64() << 32
  let mut lo = 0
  let mut hi = n
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    if entries[mid] < target {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < n && (entries[lo] >> 32).to_int() == slot {
    let mut k = lo
    while k + 1 < n {
      entries[k] = entries[k + 1]
      k = k + 1
    }
    let _ = entries.pop()
  }
}

///| Galloping search from `start_pos` for the first entry with `slot >= target_slot`.
fn posting_find_from(entries : Array[Int64], target_slot : Int, start_pos : Int) -> Int {
  let n = entries.length()
  let mut lo = start_pos
  if lo >= n {
    return n
  }
  let target = target_slot.to_int64() << 32
  if entries[lo] >= target {
    return lo
  }
  let mut step = 1
  let mut hi = lo + step
  while hi < n && entries[hi] < target {
    lo = hi
    step = step << 1
    hi = lo + step
  }
  if hi > n {
    hi = n
  }
  lo = lo + 1
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    if entries[mid] < target {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  lo
}

///| Merge two sorted `PostingList` entry arrays, summing `tf` for identical slots.
fn merge_two_postings(a : Array[Int64], b : Array[Int64]) -> Array[Int64] {
  let na = a.length()
  let nb = b.length()
  let out : Array[Int64] = []
  let mut ia = 0
  let mut ib = 0
  while ia < na && ib < nb {
    let ea = a[ia]
    let eb = b[ib]
    let sa = ea >> 32
    let sb = eb >> 32
    if sa < sb {
      out.push(ea)
      ia = ia + 1
    } else if sb < sa {
      out.push(eb)
      ib = ib + 1
    } else {
      let tf = (ea & 0xFFFFFFFFL) + (eb & 0xFFFFFFFFL)
      out.push((sa << 32) | (tf & 0xFFFFFFFFL))
      ia = ia + 1
      ib = ib + 1
    }
  }
  while ia < na {
    out.push(a[ia])
    ia = ia + 1
  }
  while ib < nb {
    out.push(b[ib])
    ib = ib + 1
  }
  out
}

///| Pure-Pion in-memory full-text inverted index.
pub struct Index {
  k1 : Double
  b : Double
  postings : Map[String, PostingList]
  doc_id_to_slot : Map[Int64, Int]
  doc_ids : Array[Int64]
  doc_order_keys : Array[Int64]
  doc_lens : Array[Int]
  doc_texts : Array[String]
  doc_tags : Array[Array[(String, String)]]
  free_slots : Array[Int]
  empty_tags : Array[(String, String)]
  vocab_terms : Array[String]
  vocab_lists : Array[PostingList]
  mut vocab_dirty : Bool
  scratch_toks : Array[String]
  scratch_sb : StringBuilder
  scratch_offs : Array[Int]
  scratch_word : Array[Int]
  mut doc_count : Int
  mut total_tokens : Int64
}

///| Create a new index with standard Okapi BM25 parameters (`k1 = 1.2`, `b = 0.75`).
pub fn Index::new() -> Index {
  Index::{
    k1: 1.2,
    b: 0.75,
    postings: Map::new(),
    doc_id_to_slot: Map::new(),
    doc_ids: [],
    doc_order_keys: [],
    doc_lens: [],
    doc_texts: [],
    doc_tags: [],
    free_slots: [],
    empty_tags: [],
    vocab_terms: [],
    vocab_lists: [],
    vocab_dirty: false,
    scratch_toks: [],
    scratch_sb: StringBuilder::new(),
    scratch_offs: [],
    scratch_word: [],
    doc_count: 0,
    total_tokens: 0L,
  }
}

///| Create a new index with custom Okapi BM25 parameters (sanitized to valid ranges).
pub fn Index::with_bm25(k1 : Double, b : Double) -> Index {
  Index::{
    k1: sanitize_k1(k1),
    b: sanitize_b(b),
    postings: Map::new(),
    doc_id_to_slot: Map::new(),
    doc_ids: [],
    doc_order_keys: [],
    doc_lens: [],
    doc_texts: [],
    doc_tags: [],
    free_slots: [],
    empty_tags: [],
    vocab_terms: [],
    vocab_lists: [],
    vocab_dirty: false,
    scratch_toks: [],
    scratch_sb: StringBuilder::new(),
    scratch_offs: [],
    scratch_word: [],
    doc_count: 0,
    total_tokens: 0L,
  }
}

///| Clamp BM25 `k1` to `[0, 100]`; `NaN` falls back to the FTS5 default `1.2`.
fn sanitize_k1(k1 : Double) -> Double {
  if k1 >= 0.0 && k1 <= 100.0 {
    k1
  } else if k1 < 0.0 {
    0.0
  } else if k1 > 100.0 {
    100.0
  } else {
    1.2
  }
}

///| Clamp BM25 `b` to `[0, 1]`; `NaN` falls back to the FTS5 default `0.75`.
fn sanitize_b(b : Double) -> Double {
  if b >= 0.0 && b <= 1.0 {
    b
  } else if b < 0.0 {
    0.0
  } else if b > 1.0 {
    1.0
  } else {
    0.75
  }
}

///| Remove a document by `doc_id`. Returns `true` if it existed.
pub fn Index::remove(self : Index, doc_id : Int64) -> Bool {
  let slot = match self.doc_id_to_slot.get(doc_id) {
    Some(s) => s
    None => return false
  }
  self.scratch_toks.clear()
  tokenize_into(
    self.doc_texts[slot],
    self.scratch_toks,
    self.scratch_sb,
    self.scratch_offs,
    self.scratch_word,
  )
  let mut i = 0
  let n = self.scratch_toks.length()
  while i < n {
    let t = self.scratch_toks[i]
    match self.postings.get(t) {
      Some(pl) => {
        pl.remove_slot(slot)
        if pl.entries.length() == 0 {
          self.postings.remove(t)
          self.vocab_dirty = true
        }
      }
      None => ()
    }
    i = i + 1
  }
  let old_len = self.doc_lens[slot]
  self.doc_lens[slot] = -1
  self.doc_texts[slot] = ""
  self.doc_tags[slot] = self.empty_tags
  self.doc_id_to_slot.remove(doc_id)
  self.free_slots.push(slot)
  self.doc_count = self.doc_count - 1
  self.total_tokens = self.total_tokens - old_len.to_int64()
  if self.total_tokens < 0L {
    self.total_tokens = 0L
  }
  true
}

///| Insert or replace a document by `doc_id`.
pub fn Index::upsert(
  self : Index,
  doc_id : Int64,
  text : String,
  order_key~ : Int64 = 0L,
  tags~ : Array[(String, String)] = [],
) -> Unit {
  if self.doc_id_to_slot.contains(doc_id) {
    let _ = self.remove(doc_id)
  }
  let slot = match self.free_slots.pop() {
    Some(s) => s
    None => {
      let s = self.doc_ids.length()
      self.doc_ids.push(doc_id)
      self.doc_order_keys.push(order_key)
      self.doc_lens.push(0)
      self.doc_texts.push(text)
      self.doc_tags.push(self.empty_tags)
      s
    }
  }
  self.scratch_toks.clear()
  tokenize_into(text, self.scratch_toks, self.scratch_sb, self.scratch_offs, self.scratch_word)
  let doc_len = self.scratch_toks.length()
  let mut i = 0
  while i < doc_len {
    let t = self.scratch_toks[i]
    match self.postings.get(t) {
      Some(pl) => pl.add_occurrence(slot)
      None => {
        let pl = PostingList::{ entries: [pack_posting(slot, 1)] }
        self.postings.set(t, pl)
        self.vocab_dirty = true
      }
    }
    i = i + 1
  }
  let stored_tags = if tags.length() == 0 {
    self.empty_tags
  } else {
    let copied : Array[(String, String)] = []
    i = 0
    while i < tags.length() {
      copied.push(tags[i])
      i = i + 1
    }
    copied
  }
  self.doc_ids[slot] = doc_id
  self.doc_order_keys[slot] = order_key
  self.doc_lens[slot] = doc_len
  self.doc_texts[slot] = text
  self.doc_tags[slot] = stored_tags
  self.doc_id_to_slot.set(doc_id, slot)
  self.doc_count = self.doc_count + 1
  self.total_tokens = self.total_tokens + doc_len.to_int64()
}

///| Number of indexed documents.
pub fn Index::len(self : Index) -> Int {
  self.doc_count
}

///| Compute positive Okapi BM25 score matching `-fts5_bm25()` (`k1 = 1.2`, `b = 0.75` default).
pub fn bm25_score(
  tf : Array[Int],
  df : Array[Int],
  doc_len : Int,
  doc_count : Int,
  total_tokens : Int64,
  k1~ : Double = 1.2,
  b~ : Double = 0.75,
) -> Double {
  if doc_count <= 0 || total_tokens <= 0L || tf.length() == 0 || df.length() == 0 {
    return 0.0
  }
  let n_rows = doc_count.to_double()
  let avgdl = total_tokens.to_double() / n_rows
  if avgdl <= 0.0 {
    return 0.0
  }
  let k1 = sanitize_k1(k1)
  let b = sanitize_b(b)
  let d = if doc_len > 0 { doc_len.to_double() } else { 0.0 }
  let n = if tf.length() < df.length() { tf.length() } else { df.length() }
  let mut score = 0.0
  let mut i = 0
  while i < n {
    let f = tf[i].to_double()
    if f > 0.0 {
      let n_hit = df[i].to_double()
      let num = n_rows - n_hit + 0.5
      let den = n_hit + 0.5
      let mut idf = if num > 0.0 && den > 0.0 {
        math_ln(num / den)
      } else {
        1.0e-6
      }
      if idf <= 0.0 {
        idf = 1.0e-6
      }
      let denom = f + k1 * (1.0 - b + b * d / avgdl)
      if denom > 0.0 {
        score = score + idf * (f * (k1 + 1.0) / denom)
      }
    }
    i = i + 1
  }
  score
}

///|
fn matches_filters(doc_tags : Array[(String, String)], filters : Array[(String, String)]) -> Bool {
  let flen = filters.length()
  if flen == 0 {
    return true
  }
  let dlen = doc_tags.length()
  if dlen == 0 {
    return false
  }
  let mut fi = 0
  while fi < flen {
    let (fk, fv) = filters[fi]
    let mut found = false
    let mut di = 0
    while di < dlen {
      let (dk, dv) = doc_tags[di]
      if dk == fk && dv == fv {
        found = true
        break
      }
      di = di + 1
    }
    if !found {
      return false
    }
    fi = fi + 1
  }
  true
}

///| Count exact consecutive occurrences of `phrase` in `tokens`.
fn count_phrase_in_tokens(tokens : Array[String], phrase : Array[String]) -> Int {
  let plen = phrase.length()
  let tlen = tokens.length()
  if plen == 0 || tlen < plen {
    return 0
  }
  let first = phrase[0]
  let mut count = 0
  let mut i = 0
  let last_start = tlen - plen
  while i <= last_start {
    if tokens[i] == first {
      let mut ok = true
      let mut j = 1
      while j < plen {
        if tokens[i + j] != phrase[j] {
          ok = false
          break
        }
        j = j + 1
      }
      if ok {
        count = count + 1
      }
    }
    i = i + 1
  }
  count
}

///| Deterministic hit tie-breaker: `order_key` desc, then `doc_id` asc.
#verify
pub fn hit_tiebreak_cmp(ok1 : Int64, id1 : Int64, ok2 : Int64, id2 : Int64) -> Int {
  if ok1 > ok2 {
    -1
  } else if ok1 < ok2 {
    1
  } else if id1 < id2 {
    -1
  } else if id1 > id2 {
    1
  } else {
    0
  }
}

///| Compare two hits: returns `< 0` if `a` ranks ahead of `b`.
///| Order: `score` desc, then `order_key` desc, then `doc_id` asc.
fn hit_cmp(a : Hit, b : Hit) -> Int {
  if a.score > b.score {
    return -1
  }
  if a.score < b.score {
    return 1
  }
  hit_tiebreak_cmp(a.order_key, a.doc_id, b.order_key, b.doc_id)
}

///| Maintain a bounded top-`limit` heap whose root (`heap[0]`) is the worst hit in the top-`limit`.
fn topk_push(
  heap : Array[Hit],
  limit : Int,
  doc_id : Int64,
  score : Double,
  order_key : Int64,
) -> Unit {
  let n = heap.length()
  if n < limit {
    let h = Hit::{ doc_id, score, order_key }
    heap.push(h)
    let mut cur = n
    while cur > 0 {
      let parent = (cur - 1) >> 1
      if hit_cmp(heap[parent], heap[cur]) < 0 {
        let tmp = heap[parent]
        heap[parent] = heap[cur]
        heap[cur] = tmp
        cur = parent
      } else {
        break
      }
    }
    return
  }
  // Heap is full: check if new candidate ranks strictly ahead of worst (heap[0]).
  let worst = heap[0]
  if score < worst.score {
    return
  }
  if score == worst.score && hit_tiebreak_cmp(order_key, doc_id, worst.order_key, worst.doc_id) >= 0 {
    return
  }
  heap[0] = Hit::{ doc_id, score, order_key }
  let mut root = 0
  while true {
    let left = (root << 1) + 1
    if left >= n {
      break
    }
    let mut swap_idx = root
    if hit_cmp(heap[swap_idx], heap[left]) < 0 {
      swap_idx = left
    }
    let right = left + 1
    if right < n && hit_cmp(heap[swap_idx], heap[right]) < 0 {
      swap_idx = right
    }
    if swap_idx == root {
      break
    }
    let tmp = heap[root]
    heap[root] = heap[swap_idx]
    heap[swap_idx] = tmp
    root = swap_idx
  }
}

///| Extract sorted results from a top-k max-heap (worst at root) in-place.
fn finish_topk_heap(heap : Array[Hit]) -> Unit {
  let n = heap.length()
  if n <= 1 {
    return
  }
  let mut end = n - 1
  while end > 0 {
    let tmp = heap[end]
    heap[end] = heap[0]
    heap[0] = tmp
    let mut root = 0
    while true {
      let left = (root << 1) + 1
      if left >= end {
        break
      }
      let mut swap_idx = root
      if hit_cmp(heap[swap_idx], heap[left]) < 0 {
        swap_idx = left
      }
      let right = left + 1
      if right < end && hit_cmp(heap[swap_idx], heap[right]) < 0 {
        swap_idx = right
      }
      if swap_idx == root {
        break
      }
      let t2 = heap[root]
      heap[root] = heap[swap_idx]
      heap[swap_idx] = t2
      root = swap_idx
    }
    end = end - 1
  }
}

///| Lexicographic byte comparison of two strings (`< 0`, `0`, `> 0`).
fn str_cmp(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let lim = if na < nb { na } else { nb }
  let mut i = 0
  while i < lim {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    if ca != cb {
      return ca - cb
    }
    i = i + 1
  }
  na - nb
}

///| In-place heapsort of parallel `(terms, lists)` by `terms` ascending.
fn sort_vocab(terms : Array[String], lists : Array[PostingList]) -> Unit {
  let n = terms.length()
  if n <= 1 {
    return
  }
  let mut start = n / 2 - 1
  while start >= 0 {
    let mut root = start
    while true {
      let left = (root << 1) + 1
      if left >= n {
        break
      }
      let mut swap_idx = root
      if str_cmp(terms[swap_idx], terms[left]) < 0 {
        swap_idx = left
      }
      let right = left + 1
      if right < n && str_cmp(terms[swap_idx], terms[right]) < 0 {
        swap_idx = right
      }
      if swap_idx == root {
        break
      }
      let tt = terms[root]
      terms[root] = terms[swap_idx]
      terms[swap_idx] = tt
      let tl = lists[root]
      lists[root] = lists[swap_idx]
      lists[swap_idx] = tl
      root = swap_idx
    }
    start = start - 1
  }
  let mut end = n - 1
  while end > 0 {
    let tt = terms[end]
    terms[end] = terms[0]
    terms[0] = tt
    let tl = lists[end]
    lists[end] = lists[0]
    lists[0] = tl
    let mut root = 0
    while true {
      let left = (root << 1) + 1
      if left >= end {
        break
      }
      let mut swap_idx = root
      if str_cmp(terms[swap_idx], terms[left]) < 0 {
        swap_idx = left
      }
      let right = left + 1
      if right < end && str_cmp(terms[swap_idx], terms[right]) < 0 {
        swap_idx = right
      }
      if swap_idx == root {
        break
      }
      let t2 = terms[root]
      terms[root] = terms[swap_idx]
      terms[swap_idx] = t2
      let l2 = lists[root]
      lists[root] = lists[swap_idx]
      lists[swap_idx] = l2
      root = swap_idx
    }
    end = end - 1
  }
}

///| Ensure sorted vocabulary cache is up to date for O(log V) prefix queries.
fn Index::ensure_sorted_vocab(self : Index) -> Unit {
  if !self.vocab_dirty {
    return
  }
  self.vocab_terms.clear()
  self.vocab_lists.clear()
  let keys = self.postings.keys()
  let mut i = 0
  while i < keys.length() {
    let k = keys[i]
    match self.postings.get(k) {
      Some(pl) => {
        self.vocab_terms.push(k)
        self.vocab_lists.push(pl)
      }
      None => ()
    }
    i = i + 1
  }
  sort_vocab(self.vocab_terms, self.vocab_lists)
  self.vocab_dirty = false
}

///| Check whether `slot` is excluded by any sorted `neg_lists`, advancing `neg_cursors`.
fn is_excluded_sorted(
  slot : Int,
  neg_lists : Array[PostingList],
  neg_cursors : Array[Int],
) -> Bool {
  let nlen = neg_lists.length()
  let mut i = 0
  while i < nlen {
    let entries = neg_lists[i].entries
    let pos = posting_find_from(entries, slot, neg_cursors[i])
    neg_cursors[i] = pos
    if pos < entries.length() && (entries[pos] >> 32).to_int() == slot {
      return true
    }
    i = i + 1
  }
  false
}

///| Search the index with BM25 ranking, optional tag filters, and deterministic tie-breaking.
pub fn Index::search(
  self : Index,
  query : String,
  limit~ : Int = 50,
  filters~ : Array[(String, String)] = [],
) -> Array[Hit] {
  let rows = self.doc_count
  if limit <= 0 || rows == 0 {
    return []
  }
  let qterms = tokenize_query(query)
  // With several phrases, each candidate document is re-tokenized at most once per search
  // (RT-6: 64 phrases used to re-tokenize every candidate 64 times).
  let mut phrase_count = 0
  let mut pq = 0
  while pq < qterms.length() {
    match qterms[pq] {
      QueryTerm::Phrase(_) => phrase_count = phrase_count + 1
      _ => ()
    }
    pq = pq + 1
  }
  let cache_phrase_tokens = phrase_count > 1
  let phrase_tokens : Map[Int, Array[String]] = Map::new()
  let pos_lists : Array[PostingList] = []
  let neg_lists : Array[PostingList] = []
  let mut has_pos_clause = false
  let mut qi = 0
  while qi < qterms.length() {
    match qterms[qi] {
      QueryTerm::Exact(t) => {
        has_pos_clause = true
        match self.postings.get(t) {
          Some(p) => pos_lists.push(p)
          None => return []
        }
      }
      QueryTerm::Prefix(pref) => {
        has_pos_clause = true
        self.ensure_sorted_vocab()
        let vterms = self.vocab_terms
        let vlists = self.vocab_lists
        let vn = vterms.length()
        let mut lo = 0
        let mut hi = vn
        while lo < hi {
          let mid = lo + ((hi - lo) >> 1)
          if str_cmp(vterms[mid], pref) < 0 {
            lo = mid + 1
          } else {
            hi = mid
          }
        }
        let mut end = lo
        while end < vn && vterms[end].starts_with(pref) {
          end = end + 1
        }
        if end == lo {
          return []
        }
        if end == lo + 1 {
          pos_lists.push(vlists[lo])
        } else {
          let mut merged = merge_two_postings(vlists[lo].entries, vlists[lo + 1].entries)
          let mut vi = lo + 2
          while vi < end {
            merged = merge_two_postings(merged, vlists[vi].entries)
            vi = vi + 1
          }
          pos_lists.push(PostingList::{ entries: merged })
        }
      }
      QueryTerm::Phrase(pts) => {
        has_pos_clause = true
        let sub_lists : Array[PostingList] = []
        let mut pi = 0
        while pi < pts.length() {
          match self.postings.get(pts[pi]) {
            Some(p) => sub_lists.push(p)
            None => return []
          }
          pi = pi + 1
        }
        let slen = sub_lists.length()
        if slen == 0 {
          return []
        }
        let mut smallest_sub_idx = 0
        let mut smallest_sub_len = sub_lists[0].entries.length()
        pi = 1
        while pi < slen {
          let cur_len = sub_lists[pi].entries.length()
          if cur_len < smallest_sub_len {
            smallest_sub_len = cur_len
            smallest_sub_idx = pi
          }
          pi = pi + 1
        }
        let sub_cursors : Array[Int] = []
        pi = 0
        while pi < slen {
          sub_cursors.push(0)
          pi = pi + 1
        }
        let phrase_entries : Array[Int64] = []
        let base_entries = sub_lists[smallest_sub_idx].entries
        let mut ci = 0
        while ci < smallest_sub_len {
          let slot = (base_entries[ci] >> 32).to_int()
          let mut in_all = true
          pi = 0
          while pi < slen {
            if pi != smallest_sub_idx {
              let pe = sub_lists[pi].entries
              let pos = posting_find_from(pe, slot, sub_cursors[pi])
              sub_cursors[pi] = pos
              if pos >= pe.length() || (pe[pos] >> 32).to_int() != slot {
                in_all = false
                break
              }
            }
            pi = pi + 1
          }
          if in_all {
            let cnt = if !cache_phrase_tokens {
              self.scratch_toks.clear()
              tokenize_into(
                self.doc_texts[slot],
                self.scratch_toks,
                self.scratch_sb,
                self.scratch_offs,
                self.scratch_word,
              )
              count_phrase_in_tokens(self.scratch_toks, pts)
            } else {
              let toks = match phrase_tokens.get(slot) {
                Some(t) => t
                None => {
                  let t = tokenize(self.doc_texts[slot])
                  phrase_tokens.set(slot, t)
                  t
                }
              }
              count_phrase_in_tokens(toks, pts)
            }
            if cnt > 0 {
              phrase_entries.push(pack_posting(slot, cnt))
            }
          }
          ci = ci + 1
        }
        if phrase_entries.length() == 0 {
          return []
        }
        pos_lists.push(PostingList::{ entries: phrase_entries })
      }
      QueryTerm::Not(t) =>
      match self.postings.get(t) {
        Some(p) => neg_lists.push(p)
        None => ()
      }
    }
    qi = qi + 1
  }

  let heap : Array[Hit] = []
  let has_filters = filters.length() > 0
  let nneg = neg_lists.length()
  let neg_cursors : Array[Int] = []
  let mut ni = 0
  while ni < nneg {
    neg_cursors.push(0)
    ni = ni + 1
  }

  if !has_pos_clause {
    if !has_filters {
      return []
    }
    let total_slots = self.doc_lens.length()
    let mut slot = 0
    while slot < total_slots {
      if self.doc_lens[slot] >= 0 {
        if nneg == 0 || !is_excluded_sorted(slot, neg_lists, neg_cursors) {
          if matches_filters(self.doc_tags[slot], filters) {
            topk_push(heap, limit, self.doc_ids[slot], 0.0, self.doc_order_keys[slot])
          }
        }
      }
      slot = slot + 1
    }
  } else {
    if self.total_tokens <= 0L {
      return []
    }
    let npos = pos_lists.length()
    let n_rows = rows.to_double()
    let avgdl = self.total_tokens.to_double() / n_rows
    let k1 = self.k1
    let b = self.b
    let k1_plus_1 = k1 + 1.0
    let one_minus_b = 1.0 - b
    let b_over_avgdl = b / avgdl

    if npos == 1 {
      let entries = pos_lists[0].entries
      let n_ent = entries.length()
      let n_hit = n_ent.to_double()
      let num = n_rows - n_hit + 0.5
      let den = n_hit + 0.5
      let mut idf = if num > 0.0 && den > 0.0 {
        math_ln(num / den)
      } else {
        1.0e-6
      }
      if idf <= 0.0 {
        idf = 1.0e-6
      }
      let doc_lens = self.doc_lens
      let doc_ids = self.doc_ids
      let doc_order_keys = self.doc_order_keys
      let doc_tags = self.doc_tags
      let mut ci = 0
      while ci < n_ent {
        let ent = entries[ci]
        let slot = (ent >> 32).to_int()
        if nneg == 0 || !is_excluded_sorted(slot, neg_lists, neg_cursors) {
          if !has_filters || matches_filters(doc_tags[slot], filters) {
            let f = (ent & 0xFFFFFFFFL).to_int().to_double()
            let k1_norm = k1 * (one_minus_b + b_over_avgdl * doc_lens[slot].to_double())
            let denom = f + k1_norm
            let score = if f > 0.0 && denom > 0.0 {
              idf * (f * k1_plus_1 / denom)
            } else {
              0.0
            }
            if heap.length() < limit || score >= heap[0].score {
              topk_push(heap, limit, doc_ids[slot], score, doc_order_keys[slot])
            }
          }
        }
        ci = ci + 1
      }
    } else {
      let mut smallest_idx = 0
      let mut smallest_len = pos_lists[0].entries.length()
      let mut li = 1
      while li < npos {
        let cur_len = pos_lists[li].entries.length()
        if cur_len < smallest_len {
          smallest_len = cur_len
          smallest_idx = li
        }
        li = li + 1
      }
      let idfs : Array[Double] = []
      let pos_cursors : Array[Int] = []
      let tfs : Array[Int] = []
      li = 0
      while li < npos {
        let n_hit = pos_lists[li].entries.length().to_double()
        let num = n_rows - n_hit + 0.5
        let den = n_hit + 0.5
        let mut idf = if num > 0.0 && den > 0.0 {
          math_ln(num / den)
        } else {
          1.0e-6
        }
        if idf <= 0.0 {
          idf = 1.0e-6
        }
        idfs.push(idf)
        pos_cursors.push(0)
        tfs.push(0)
        li = li + 1
      }

      let base_entries = pos_lists[smallest_idx].entries
      let doc_lens = self.doc_lens
      let doc_ids = self.doc_ids
      let doc_order_keys = self.doc_order_keys
      let doc_tags = self.doc_tags
      let mut ci = 0
      while ci < smallest_len {
        let ent = base_entries[ci]
        let slot = (ent >> 32).to_int()
        let mut ok = nneg == 0 || !is_excluded_sorted(slot, neg_lists, neg_cursors)
        if ok {
          tfs[smallest_idx] = (ent & 0xFFFFFFFFL).to_int()
          li = 0
          while li < npos {
            if li != smallest_idx {
              let pe = pos_lists[li].entries
              let pos = posting_find_from(pe, slot, pos_cursors[li])
              pos_cursors[li] = pos
              if pos >= pe.length() || (pe[pos] >> 32).to_int() != slot {
                ok = false
                break
              }
              tfs[li] = (pe[pos] & 0xFFFFFFFFL).to_int()
            }
            li = li + 1
          }
        }
        if ok && (!has_filters || matches_filters(doc_tags[slot], filters)) {
          let k1_norm = k1 * (one_minus_b + b_over_avgdl * doc_lens[slot].to_double())
          let mut score = 0.0
          li = 0
          while li < npos {
            let f = tfs[li].to_double()
            if f > 0.0 {
              let denom = f + k1_norm
              if denom > 0.0 {
                score = score + idfs[li] * (f * k1_plus_1 / denom)
              }
            }
            li = li + 1
          }
          if heap.length() < limit || score >= heap[0].score {
            topk_push(heap, limit, doc_ids[slot], score, doc_order_keys[slot])
          }
        }
        ci = ci + 1
      }
    }
  }

  finish_topk_heap(heap)
  heap
}
