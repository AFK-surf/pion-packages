///| Pure-Pion in-memory inverted index with Okapi BM25 ranking (SQLite FTS5 parity).

///| A single search hit returned by `Index::search`.
pub struct Hit {
  doc_id : Int64
  score : Double
  order_key : Int64
}

///| Internal indexed document record.
struct DocEntry {
  text : String
  order_key : Int64
  tags : Array[(String, String)]
  doc_len : Int
  terms : Array[String]
}

///| Pure-Pion in-memory full-text inverted index.
pub struct Index {
  k1 : Double
  b : Double
  postings : Map[String, Map[Int64, Int]]
  docs : Map[Int64, DocEntry]
  mut total_tokens : Int64
}

///| Create a new index with standard Okapi BM25 parameters (`k1 = 1.2`, `b = 0.75`).
pub fn Index::new() -> Index {
  Index::{
    k1: 1.2,
    b: 0.75,
    postings: Map::new(),
    docs: Map::new(),
    total_tokens: 0L,
  }
}

///| Create a new index with custom Okapi BM25 parameters (sanitized to valid ranges).
pub fn Index::with_bm25(k1 : Double, b : Double) -> Index {
  let clean_k1 = if k1 >= 0.0 && k1 <= 100.0 {
    k1
  } else if k1 < 0.0 {
    0.0
  } else {
    1.2
  }
  let clean_b = if b >= 0.0 && b <= 1.0 {
    b
  } else if b < 0.0 {
    0.0
  } else if b > 1.0 {
    1.0
  } else {
    0.75
  }
  Index::{
    k1: clean_k1,
    b: clean_b,
    postings: Map::new(),
    docs: Map::new(),
    total_tokens: 0L,
  }
}

///| Remove a document by `doc_id`. Returns `true` if it existed.
pub fn Index::remove(self : Index, doc_id : Int64) -> Bool {
  let entry = match self.docs.get(doc_id) {
    Some(e) => e
    None => return false
  }
  let mut i = 0
  while i < entry.terms.length() {
    let t = entry.terms[i]
    match self.postings.get(t) {
      Some(p) => {
        p.remove(doc_id)
        if p.length() == 0 {
          self.postings.remove(t)
        }
      }
      None => ()
    }
    i = i + 1
  }
  self.docs.remove(doc_id)
  self.total_tokens = self.total_tokens - entry.doc_len.to_int64()
  if self.total_tokens < 0L {
    self.total_tokens = 0L
  }
  true
}

///| Insert or replace a document by `doc_id`.
pub fn Index::upsert(
  self : Index,
  doc_id : Int64,
  text : String,
  order_key~ : Int64 = 0L,
  tags~ : Array[(String, String)] = [],
) -> Unit {
  if self.docs.contains(doc_id) {
    let _ = self.remove(doc_id)
  }
  let tokens = tokenize(text)
  let doc_len = tokens.length()
  let local_tf : Map[String, Int] = Map::new()
  let mut i = 0
  while i < doc_len {
    let t = tokens[i]
    match local_tf.get(t) {
      Some(v) => local_tf.set(t, v + 1)
      None => local_tf.set(t, 1)
    }
    i = i + 1
  }
  let unique_terms = local_tf.keys()
  i = 0
  while i < unique_terms.length() {
    let t = unique_terms[i]
    let tf = match local_tf.get(t) {
      Some(v) => v
      None => 0
    }
    match self.postings.get(t) {
      Some(p) => p.set(doc_id, tf)
      None => {
        let p : Map[Int64, Int] = Map::new()
        p.set(doc_id, tf)
        self.postings.set(t, p)
      }
    }
    i = i + 1
  }
  let copied_tags : Array[(String, String)] = []
  i = 0
  while i < tags.length() {
    copied_tags.push(tags[i])
    i = i + 1
  }
  self.docs.set(
    doc_id,
    DocEntry::{ text, order_key, tags: copied_tags, doc_len, terms: unique_terms },
  )
  self.total_tokens = self.total_tokens + doc_len.to_int64()
}

///| Number of indexed documents.
pub fn Index::len(self : Index) -> Int {
  self.docs.length()
}

///| Compute positive Okapi BM25 score matching `-fts5_bm25()` (`k1 = 1.2`, `b = 0.75` default).
pub fn bm25_score(
  tf : Array[Int],
  df : Array[Int],
  doc_len : Int,
  doc_count : Int,
  total_tokens : Int64,
  k1~ : Double = 1.2,
  b~ : Double = 0.75,
) -> Double {
  if doc_count <= 0 || total_tokens <= 0L || tf.length() == 0 || df.length() == 0 {
    return 0.0
  }
  let n_rows = doc_count.to_double()
  let avgdl = total_tokens.to_double() / n_rows
  if avgdl <= 0.0 {
    return 0.0
  }
  let d = doc_len.to_double()
  let n = if tf.length() < df.length() { tf.length() } else { df.length() }
  let mut score = 0.0
  let mut i = 0
  while i < n {
    let f = tf[i].to_double()
    if f > 0.0 {
      let n_hit = df[i].to_double()
      let num = n_rows - n_hit + 0.5
      let den = n_hit + 0.5
      let mut idf = if num > 0.0 && den > 0.0 {
        math_ln(num / den)
      } else {
        1.0e-6
      }
      if idf <= 0.0 {
        idf = 1.0e-6
      }
      let denom = f + k1 * (1.0 - b + b * d / avgdl)
      if denom > 0.0 {
        score = score + idf * (f * (k1 + 1.0) / denom)
      }
    }
    i = i + 1
  }
  score
}

///|
fn matches_filters(doc_tags : Array[(String, String)], filters : Array[(String, String)]) -> Bool {
  let flen = filters.length()
  if flen == 0 {
    return true
  }
  let dlen = doc_tags.length()
  if dlen == 0 {
    return false
  }
  let mut fi = 0
  while fi < flen {
    let (fk, fv) = filters[fi]
    let mut found = false
    let mut di = 0
    while di < dlen {
      let (dk, dv) = doc_tags[di]
      if dk == fk && dv == fv {
        found = true
        break
      }
      di = di + 1
    }
    if !found {
      return false
    }
    fi = fi + 1
  }
  true
}

///| Count exact consecutive occurrences of `phrase` in `tokens`.
fn count_phrase_in_tokens(tokens : Array[String], phrase : Array[String]) -> Int {
  let plen = phrase.length()
  let tlen = tokens.length()
  if plen == 0 || tlen < plen {
    return 0
  }
  let first = phrase[0]
  let mut count = 0
  let mut i = 0
  let last_start = tlen - plen
  while i <= last_start {
    if tokens[i] == first {
      let mut ok = true
      let mut j = 1
      while j < plen {
        if tokens[i + j] != phrase[j] {
          ok = false
          break
        }
        j = j + 1
      }
      if ok {
        count = count + 1
      }
    }
    i = i + 1
  }
  count
}

///| Compare two hits: returns `< 0` if `a` ranks ahead of `b`.
///| Order: `score` desc, then `order_key` desc, then `doc_id` asc.
fn hit_cmp(a : Hit, b : Hit) -> Int {
  if a.score > b.score {
    return -1
  }
  if a.score < b.score {
    return 1
  }
  if a.order_key > b.order_key {
    return -1
  }
  if a.order_key < b.order_key {
    return 1
  }
  if a.doc_id < b.doc_id {
    return -1
  }
  if a.doc_id > b.doc_id {
    return 1
  }
  0
}

///| In-place O(n log n) heapsort for `Array[Hit]`.
fn sort_hits(hits : Array[Hit]) -> Unit {
  let n = hits.length()
  if n <= 1 {
    return
  }
  // Build max-heap (largest = worst hit at root)
  let mut start = n / 2 - 1
  while start >= 0 {
    let mut root = start
    while true {
      let left = root * 2 + 1
      if left >= n {
        break
      }
      let mut swap_idx = root
      if hit_cmp(hits[swap_idx], hits[left]) < 0 {
        swap_idx = left
      }
      let right = left + 1
      if right < n && hit_cmp(hits[swap_idx], hits[right]) < 0 {
        swap_idx = right
      }
      if swap_idx == root {
        break
      }
      let tmp = hits[root]
      hits[root] = hits[swap_idx]
      hits[swap_idx] = tmp
      root = swap_idx
    }
    start = start - 1
  }
  // Extract elements from heap
  let mut end = n - 1
  while end > 0 {
    let tmp = hits[end]
    hits[end] = hits[0]
    hits[0] = tmp
    let mut root = 0
    while true {
      let left = root * 2 + 1
      if left >= end {
        break
      }
      let mut swap_idx = root
      if hit_cmp(hits[swap_idx], hits[left]) < 0 {
        swap_idx = left
      }
      let right = left + 1
      if right < end && hit_cmp(hits[swap_idx], hits[right]) < 0 {
        swap_idx = right
      }
      if swap_idx == root {
        break
      }
      let t2 = hits[root]
      hits[root] = hits[swap_idx]
      hits[swap_idx] = t2
      root = swap_idx
    }
    end = end - 1
  }
}

///|
fn is_excluded(doc_id : Int64, neg_lists : Array[Map[Int64, Int]]) -> Bool {
  let mut i = 0
  while i < neg_lists.length() {
    if neg_lists[i].contains(doc_id) {
      return true
    }
    i = i + 1
  }
  false
}

///| Search the index with BM25 ranking, optional tag filters, and deterministic tie-breaking.
pub fn Index::search(
  self : Index,
  query : String,
  limit~ : Int = 50,
  filters~ : Array[(String, String)] = [],
) -> Array[Hit] {
  let rows = self.docs.length()
  if limit <= 0 || rows == 0 {
    return []
  }
  let qterms = tokenize_query(query)
  let pos_lists : Array[Map[Int64, Int]] = []
  let neg_lists : Array[Map[Int64, Int]] = []
  let mut has_pos_clause = false
  let mut qi = 0
  while qi < qterms.length() {
    match qterms[qi] {
      QueryTerm::Exact(t) => {
        has_pos_clause = true
        match self.postings.get(t) {
          Some(p) => pos_lists.push(p)
          None => return []
        }
      }
      QueryTerm::Prefix(pref) => {
        has_pos_clause = true
        let merged : Map[Int64, Int] = Map::new()
        let vocab = self.postings.keys()
        let mut vi = 0
        while vi < vocab.length() {
          let term = vocab[vi]
          if term.starts_with(pref) {
            match self.postings.get(term) {
              Some(p) => {
                let ids = p.keys()
                let mut di = 0
                while di < ids.length() {
                  let did = ids[di]
                  let add_tf = match p.get(did) {
                    Some(v) => v
                    None => 0
                  }
                  let cur = match merged.get(did) {
                    Some(v) => v
                    None => 0
                  }
                  merged.set(did, cur + add_tf)
                  di = di + 1
                }
              }
              None => ()
            }
          }
          vi = vi + 1
        }
        if merged.length() == 0 {
          return []
        }
        pos_lists.push(merged)
      }
      QueryTerm::Phrase(pts) => {
        has_pos_clause = true
        let sub_lists : Array[Map[Int64, Int]] = []
        let mut pi = 0
        while pi < pts.length() {
          match self.postings.get(pts[pi]) {
            Some(p) => sub_lists.push(p)
            None => return []
          }
          pi = pi + 1
        }
        if sub_lists.length() == 0 {
          return []
        }
        let mut smallest_sub = sub_lists[0]
        pi = 1
        while pi < sub_lists.length() {
          if sub_lists[pi].length() < smallest_sub.length() {
            smallest_sub = sub_lists[pi]
          }
          pi = pi + 1
        }
        let phrase_post : Map[Int64, Int] = Map::new()
        let cands = smallest_sub.keys()
        let mut ci = 0
        while ci < cands.length() {
          let did = cands[ci]
          let mut in_all = true
          pi = 0
          while pi < sub_lists.length() {
            if !sub_lists[pi].contains(did) {
              in_all = false
              break
            }
            pi = pi + 1
          }
          if in_all {
            match self.docs.get(did) {
              Some(entry) => {
                let cnt = count_phrase_in_tokens(tokenize(entry.text), pts)
                if cnt > 0 {
                  phrase_post.set(did, cnt)
                }
              }
              None => ()
            }
          }
          ci = ci + 1
        }
        if phrase_post.length() == 0 {
          return []
        }
        pos_lists.push(phrase_post)
      }
      QueryTerm::Not(t) =>
      match self.postings.get(t) {
        Some(p) => neg_lists.push(p)
        None => ()
      }
    }
    qi = qi + 1
  }

  let hits : Array[Hit] = []
  if !has_pos_clause {
    if filters.length() == 0 {
      return []
    }
    let all_ids = self.docs.keys()
    let mut i = 0
    while i < all_ids.length() {
      let did = all_ids[i]
      if !is_excluded(did, neg_lists) {
        match self.docs.get(did) {
          Some(entry) =>
          if matches_filters(entry.tags, filters) {
            hits.push(Hit::{ doc_id: did, score: 0.0, order_key: entry.order_key })
          }
          None => ()
        }
      }
      i = i + 1
    }
  } else {
    if self.total_tokens <= 0L {
      return []
    }
    let mut smallest = pos_lists[0]
    let mut li = 1
    while li < pos_lists.length() {
      if pos_lists[li].length() < smallest.length() {
        smallest = pos_lists[li]
      }
      li = li + 1
    }
    // Precompute IDF once per positive clause
    let n_rows = rows.to_double()
    let avgdl = self.total_tokens.to_double() / n_rows
    let idfs : Array[Double] = []
    li = 0
    while li < pos_lists.length() {
      let n_hit = pos_lists[li].length().to_double()
      let num = n_rows - n_hit + 0.5
      let den = n_hit + 0.5
      let mut idf = if num > 0.0 && den > 0.0 {
        math_ln(num / den)
      } else {
        1.0e-6
      }
      if idf <= 0.0 {
        idf = 1.0e-6
      }
      idfs.push(idf)
      li = li + 1
    }
    let k1 = self.k1
    let b = self.b
    let k1_plus_1 = k1 + 1.0
    let one_minus_b = 1.0 - b
    let b_over_avgdl = b / avgdl

    let cand_ids = smallest.keys()
    let mut ci = 0
    while ci < cand_ids.length() {
      let did = cand_ids[ci]
      let mut ok = !is_excluded(did, neg_lists)
      if ok {
        li = 0
        while li < pos_lists.length() {
          if !pos_lists[li].contains(did) {
            ok = false
            break
          }
          li = li + 1
        }
      }
      if ok {
        match self.docs.get(did) {
          Some(entry) =>
          if matches_filters(entry.tags, filters) {
            let k1_norm = k1 * (one_minus_b + b_over_avgdl * entry.doc_len.to_double())
            let mut score = 0.0
            li = 0
            while li < pos_lists.length() {
              let f = match pos_lists[li].get(did) {
                Some(v) => v.to_double()
                None => 0.0
              }
              if f > 0.0 {
                let denom = f + k1_norm
                if denom > 0.0 {
                  score = score + idfs[li] * (f * k1_plus_1 / denom)
                }
              }
              li = li + 1
            }
            hits.push(Hit::{ doc_id: did, score, order_key: entry.order_key })
          }
          None => ()
        }
      }
      ci = ci + 1
    }
  }

  sort_hits(hits)
  if hits.length() > limit {
    let trimmed : Array[Hit] = []
    let mut i = 0
    while i < limit {
      trimmed.push(hits[i])
      i = i + 1
    }
    return trimmed
  }
  hits
}
