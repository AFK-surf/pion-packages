///| UTF-8-safe snippet extraction and highlight span calculation.

///| Extracted snippet text with sorted, non-overlapping UTF-8 byte highlight ranges.
pub struct Snippet {
  text : String
  highlights : Array[(Int, Int)]
}

///|
fn find_cp_subseq(hay : Array[Int], needle : Array[Int], from : Int, limit : Int) -> Int {
  let nlen = needle.length()
  if nlen == 0 || from + nlen > limit {
    return -1
  }
  let first = needle[0]
  let last_start = limit - nlen
  let mut i = from
  while i <= last_start {
    if hay[i] == first {
      let mut ok = true
      let mut j = 1
      while j < nlen {
        if hay[i + j] != needle[j] {
          ok = false
          break
        }
        j = j + 1
      }
      if ok {
        return i
      }
    }
    i = i + 1
  }
  -1
}

///|
fn push_needle_str(needles : Array[Array[Int]], s : String) -> Unit {
  let raw = utf8_codepoints(s)
  if raw.length() == 0 {
    return
  }
  let folded : Array[Int] = []
  let mut i = 0
  while i < raw.length() {
    folded.push(fold_cp(raw[i]))
    i = i + 1
  }
  needles.push(folded)
}

///|
fn is_all_cjk(cps : Array[Int]) -> Bool {
  if cps.length() == 0 {
    return false
  }
  let mut i = 0
  while i < cps.length() {
    if !is_cjk_cp(cps[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///| Rebuild the text a phrase stands for: overlapping CJK bigrams (`全文`, `文检`, `检索`) chain
///| back into `全文检索` and adjacent CJK parts join without a space (RT-4); other parts are
///| space-separated.
fn phrase_display(pts : Array[String]) -> String {
  let sb = StringBuilder::new()
  let mut prev : Array[Int] = []
  let mut j = 0
  while j < pts.length() {
    let part = if pts[j].starts_with("u_") && pts[j].length() > 2 {
      pts[j].slice(2, pts[j].length())
    } else {
      pts[j]
    }
    let cur = utf8_codepoints(part)
    if j == 0 {
      sb.write_string(part)
    } else if is_all_cjk(prev) && is_all_cjk(cur) {
      if prev.length() == 2 && cur.length() == 2 && prev[1] == cur[0] {
        write_cp(sb, cur[1])
      } else {
        sb.write_string(part)
      }
    } else {
      sb.write_byte(32.to_byte())
      sb.write_string(part)
    }
    prev = cur
    j = j + 1
  }
  sb.to_string()
}

///|
fn extract_snippet_needles(query : String) -> Array[Array[Int]] {
  let needles : Array[Array[Int]] = []
  let terms = tokenize_query(query)
  let mut i = 0
  while i < terms.length() {
    match terms[i] {
      QueryTerm::Exact(t) =>
      if t.starts_with("u_") && t.length() > 2 {
        push_needle_str(needles, t.slice(2, t.length()))
      } else if t.starts_with("pr") && t.length() > 2 && is_digit_cp(t.code_unit_at(2)) {
        push_needle_str(needles, "#" + t.slice(2, t.length()))
        push_needle_str(needles, t.slice(2, t.length()))
        // A literal word such as `pr12` or `PR2x` folds to the same token (RT-4).
        push_needle_str(needles, t)
      } else {
        push_needle_str(needles, t)
      }
      QueryTerm::Prefix(p) => push_needle_str(needles, p)
      QueryTerm::Phrase(pts) => push_needle_str(needles, phrase_display(pts))
      QueryTerm::Not(_) => ()
    }
    i = i + 1
  }
  needles
}

///| Normalize control whitespace (`\n`, `\r`, `\t`) to ASCII space (`32`) for single-line snippets.
#verify
pub fn snippet_normalize_ws(c : Int) -> Int {
  if c == 10 || c == 13 || c == 9 { 32 } else { c }
}

///| Leading context codepoints before the first match (`16` when `max_chars > 32`, else `max_chars / 4`).
#verify
pub fn snippet_context_before(max_chars : Int) -> Int {
  if max_chars > 32 { 16 } else { max_chars / 4 }
}

///| Overflow-safe snippet window end (RT-3): `min(win_start + max_chars, total_cps)` without `Int` overflow.
#verify
pub fn snippet_win_end(win_start : Int, total_cps : Int, max_chars : Int) -> Int {
  if max_chars < total_cps - win_start {
    win_start + max_chars
  } else {
    total_cps
  }
}

///| Strict lexicographic ordering on `(start, end)` highlight byte ranges.
#verify
pub fn snippet_range_gt(a0 : Int, a1 : Int, b0 : Int, b1 : Int) -> Bool {
  a0 > b0 || (a0 == b0 && a1 > b1)
}

///| Extract a UTF-8-safe snippet of at most `max_chars` Unicode codepoints around the first
///| query match, returning the trimmed text and UTF-8 byte highlight ranges `(start, end)`.
pub fn snippet(text : String, query : String, max_chars~ : Int = 120) -> Snippet {
  if text.length() == 0 || max_chars <= 0 {
    return Snippet::{ text: "", highlights: [] }
  }
  let raw_cps = utf8_codepoints(text)
  let total_cps = raw_cps.length()
  if total_cps == 0 {
    return Snippet::{ text: "", highlights: [] }
  }
  let flat : Array[Int] = []
  let lower : Array[Int] = []
  let mut i = 0
  while i < total_cps {
    let c = snippet_normalize_ws(raw_cps[i])
    flat.push(c)
    lower.push(fold_cp(c))
    i = i + 1
  }

  let needles = extract_snippet_needles(query)
  let mut first = -1
  i = 0
  while i < needles.length() {
    let at = find_cp_subseq(lower, needles[i], 0, total_cps)
    if at >= 0 && (first < 0 || at < first) {
      first = at
    }
    i = i + 1
  }

  let context_before = snippet_context_before(max_chars)
  let mut win_start = if first < 0 || first <= context_before {
    0
  } else {
    first - context_before
  }
  // `max_chars < total_cps - win_start`, not `win_start + max_chars < total_cps`: the sum
  // overflows `Int` for huge `max_chars` and used to yield an empty snippet (RT-3).
  let mut win_end = snippet_win_end(win_start, total_cps, max_chars)
  if win_end == total_cps && win_start > 0 && win_end - win_start < max_chars {
    win_start = if total_cps > max_chars { total_cps - max_chars } else { 0 }
  }
  if win_end < win_start {
    win_end = win_start
  }

  let sb = StringBuilder::new()
  let mut cur_bytes = 0
  if win_start > 0 {
    sb.write_string("…")
    cur_bytes = 3
  }
  let cp_byte_off : Array[Int] = []
  i = win_start
  while i < win_end {
    cp_byte_off.push(cur_bytes)
    let cp = flat[i]
    write_cp(sb, cp)
    cur_bytes = cur_bytes + cp_utf8_len(cp)
    i = i + 1
  }
  cp_byte_off.push(cur_bytes)
  if win_end < total_cps {
    sb.write_string("…")
  }

  let ranges : Array[(Int, Int)] = []
  i = 0
  while i < needles.length() {
    let m = needles[i]
    let mlen = m.length()
    let mut at = find_cp_subseq(lower, m, win_start, win_end)
    while at >= 0 && at + mlen <= win_end {
      let b_start = cp_byte_off[at - win_start]
      let b_end = cp_byte_off[at + mlen - win_start]
      if b_start < b_end {
        ranges.push((b_start, b_end))
      }
      at = find_cp_subseq(lower, m, at + 1, win_end)
    }
    i = i + 1
  }

  // Sort byte ranges by start ascending, then end ascending
  let mut si = 1
  while si < ranges.length() {
    let cur = ranges[si]
    let mut sj = si - 1
    while sj >= 0 && snippet_range_gt(ranges[sj].0, ranges[sj].1, cur.0, cur.1) {
      ranges[sj + 1] = ranges[sj]
      sj = sj - 1
    }
    ranges[sj + 1] = cur
    si = si + 1
  }

  // Merge overlapping or adjacent byte ranges
  let merged : Array[(Int, Int)] = []
  i = 0
  while i < ranges.length() {
    let r = ranges[i]
    if merged.length() > 0 {
      let last = merged[merged.length() - 1]
      if r.0 <= last.1 {
        if r.1 > last.1 {
          merged[merged.length() - 1] = (last.0, r.1)
        }
      } else {
        merged.push(r)
      }
    } else {
      merged.push(r)
    }
    i = i + 1
  }

  Snippet::{ text: sb.to_string(), highlights: merged }
}
