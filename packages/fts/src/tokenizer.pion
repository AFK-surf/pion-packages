///| Multilingual and code-aware tokenizer for full-text search and SQLite FTS5 parity.

///| A parsed term in a full-text search query.
pub enum QueryTerm {
  Exact(String)
  Prefix(String)
  Phrase(Array[String])
  Not(String)
}

///| Maximum number of terms parsed from a single query string to prevent pathological blowup.
let max_query_terms : Int = 64

///| Return true if `v` is an indexable CJK/Kana/Hangul codepoint (excluding RT-2 separator marks).
#verify
pub fn is_cjk_cp(v : Int) -> Bool {
  // Kana voicing marks (Mn/Sk), the double hyphen and the middle dot are not FTS5 token characters:
  // indexing them would emit `u_<mark>` tokens that SQLite strips to `u_` (RT-2).
  if (v >= 0x3099 && v <= 0x309C) || v == 0x30A0 || v == 0x30FB {
    return false
  }
  (v >= 0x3400 && v <= 0x4DBF) ||
  (v >= 0x4E00 && v <= 0x9FFF) ||
  (v >= 0xF900 && v <= 0xFAFF) ||
  (v >= 0x20000 && v <= 0x2FFFF) ||
  (v >= 0x3040 && v <= 0x30FF) ||
  (v >= 0x31F0 && v <= 0x31FF) ||
  (v >= 0xAC00 && v <= 0xD7AF) ||
  (v >= 0x1100 && v <= 0x11FF)
}

///| Return true if `c` is an ASCII identifier codepoint `[A-Za-z0-9_]`.
#verify
pub fn is_ascii_word_cp(c : Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
}

///| Return true if `c` is an ASCII uppercase letter `'A'..'Z'`.
pub fn is_upper_cp(c : Int) -> Bool {
  c >= 65 && c <= 90
}

///| Return true if `c` is an ASCII lowercase letter `'a'..'z'`.
pub fn is_lower_cp(c : Int) -> Bool {
  c >= 97 && c <= 122
}

///| Return true if `c` is an ASCII decimal digit `'0'..'9'`.
pub fn is_digit_cp(c : Int) -> Bool {
  c >= 48 && c <= 57
}

///| Return true if CamelCase tokenization should split before `cur` given `before` and `after_lower`.
pub fn camel_should_split(before : Int, cur : Int, after_lower : Bool) -> Bool {
  is_upper_cp(cur) &&
  (is_lower_cp(before) || is_digit_cp(before) || (is_upper_cp(before) && after_lower))
}

///|
fn is_word_cp(c : Int) -> Bool {
  if c < 0x80 {
    is_ascii_word_cp(c)
  } else {
    match fold_unicode_letter(c) {
      Some(_) => true
      None => false
    }
  }
}

///|
fn is_all_underscore(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) != 95 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn is_hash_word(word : String) -> Bool {
  let n = word.length()
  if n < 7 {
    return false
  }
  let mut has_digit = false
  let mut i = 0
  while i < n {
    let b = word.code_unit_at(i)
    if b >= 48 && b <= 57 {
      has_digit = true
    } else if b < 97 || b > 102 {
      return false
    }
    i = i + 1
  }
  has_digit
}

///| Decode one UTF-8 scalar value starting at `s[i]`, packed as `(cp << 3) | byte_len`.
///| Zero heap allocation (fits in positive 32-bit `Int` since `0x10FFFF << 3 = 0x87FFF8`).
fn decode_cp_at(s : String, i : Int, n : Int) -> Int {
  let b0 = s.code_unit_at(i)
  if b0 < 0x80 {
    return (b0 << 3) | 1
  }
  if b0 >= 0xC2 && b0 <= 0xDF && i + 1 < n {
    let b1 = s.code_unit_at(i + 1)
    if (b1 & 0xC0) == 0x80 {
      return ((((b0 & 0x1F) << 6) | (b1 & 0x3F)) << 3) | 2
    }
  } else if b0 >= 0xE0 && b0 <= 0xEF && i + 2 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    let valid_cont = (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80
    let overlong = b0 == 0xE0 && b1 < 0xA0
    let surrogate = b0 == 0xED && b1 >= 0xA0
    if valid_cont && !overlong && !surrogate {
      return ((((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)) << 3) | 3
    }
  } else if b0 >= 0xF0 && b0 <= 0xF4 && i + 3 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    let b3 = s.code_unit_at(i + 3)
    let valid_cont = (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80
    let overlong = b0 == 0xF0 && b1 < 0x90
    let too_high = b0 == 0xF4 && b1 > 0x8F
    if valid_cont && !overlong && !too_high {
      let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
      return (cp << 3) | 4
    }
  }
  (0xFFFD << 3) | 1
}

///| Lowercase ASCII slice `text[from..to]` using reusable `sb` if it contains uppercase bytes.
fn emit_ascii_part(
  text : String,
  from : Int,
  to : Int,
  has_upper : Bool,
  sb : StringBuilder,
  out : Array[String],
) -> Unit {
  if !has_upper {
    out.push(text.slice(from, to))
    return
  }
  sb.reset()
  let mut k = from
  while k < to {
    let b = text.code_unit_at(k)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    k = k + 1
  }
  out.push(sb.to_string())
}

///| Emit hash prefix slices (6/7/8/10) for a verified hash token.
fn emit_hash_prefixes(whole : String, out : Array[String]) -> Unit {
  let wlen = whole.length()
  if 6 < wlen {
    out.push(whole.slice(0, 6))
  }
  if 7 < wlen {
    out.push(whole.slice(0, 7))
  }
  if 8 < wlen {
    out.push(whole.slice(0, 8))
  }
  if 10 < wlen {
    out.push(whole.slice(0, 10))
  }
}

///| Emit normalized tokens for a pure-ASCII word `text[start..end]` containing uppercase or `_`.
fn emit_ascii_word_complex(
  text : String,
  start : Int,
  end : Int,
  has_upper : Bool,
  is_hex : Bool,
  has_digit : Bool,
  sb : StringBuilder,
  out : Array[String],
) -> Unit {
  let whole = if !has_upper {
    text.slice(start, end)
  } else {
    sb.reset()
    let mut k = start
    while k < end {
      let b = text.code_unit_at(k)
      if b >= 65 && b <= 90 {
        sb.write_byte((b + 32).to_byte())
      } else {
        sb.write_byte(b.to_byte())
      }
      k = k + 1
    }
    sb.to_string()
  }
  out.push(whole)

  // Split CamelCase / snake_case parts without allocating an intermediate Array[String].
  let mut part_count = 0
  let mut p0_start = 0
  let mut p0_end = 0
  let mut p0_upper = false
  let mut cur_start = -1
  let mut cur_upper = false
  let mut k = start
  while k < end {
    let c = text.code_unit_at(k)
    if c == 95 {
      if cur_start >= 0 {
        if part_count == 0 {
          p0_start = cur_start
          p0_end = k
          p0_upper = cur_upper
        } else {
          if part_count == 1 {
            emit_ascii_part(text, p0_start, p0_end, p0_upper, sb, out)
          }
          emit_ascii_part(text, cur_start, k, cur_upper, sb, out)
        }
        part_count = part_count + 1
        cur_start = -1
        cur_upper = false
      }
      k = k + 1
      continue
    }
    if cur_start >= 0 && k > start {
      let before = text.code_unit_at(k - 1)
      let after_lower = k + 1 < end && is_lower_cp(text.code_unit_at(k + 1))
      if camel_should_split(before, c, after_lower) {
        if part_count == 0 {
          p0_start = cur_start
          p0_end = k
          p0_upper = cur_upper
        } else {
          if part_count == 1 {
            emit_ascii_part(text, p0_start, p0_end, p0_upper, sb, out)
          }
          emit_ascii_part(text, cur_start, k, cur_upper, sb, out)
        }
        part_count = part_count + 1
        cur_start = k
        cur_upper = is_upper_cp(c)
        k = k + 1
        continue
      }
    }
    if cur_start < 0 {
      cur_start = k
      cur_upper = is_upper_cp(c)
    } else if is_upper_cp(c) {
      cur_upper = true
    }
    k = k + 1
  }
  if cur_start >= 0 && part_count > 0 {
    if part_count == 1 {
      emit_ascii_part(text, p0_start, p0_end, p0_upper, sb, out)
    }
    emit_ascii_part(text, cur_start, end, cur_upper, sb, out)
  }

  if is_hex && has_digit && end - start >= 7 {
    emit_hash_prefixes(whole, out)
  }
}

///|
fn lower_word_cps(word : Array[Int], sb : StringBuilder) -> String {
  sb.reset()
  let mut i = 0
  let n = word.length()
  while i < n {
    write_cp(sb, fold_cp(word[i]))
    i = i + 1
  }
  sb.to_string()
}

///|
fn emit_word_tokens(word : Array[Int], sb : StringBuilder, out : Array[String]) -> Unit {
  let whole = lower_word_cps(word, sb)
  if whole.length() == 0 || is_all_underscore(whole) {
    return
  }
  out.push(whole)

  // Split CamelCase / snake_case parts reusing `sb`, emitting only if >= 2 parts.
  let n = word.length()
  let mut part_count = 0
  let mut p0_start = 0
  let mut p0_end = 0
  let mut cur_start = -1
  let mut i = 0
  while i < n {
    let c = word[i]
    if c == 95 {
      if cur_start >= 0 {
        if part_count == 0 {
          p0_start = cur_start
          p0_end = i
        } else {
          if part_count == 1 {
            sb.reset()
            let mut m = p0_start
            while m < p0_end {
              write_cp(sb, fold_cp(word[m]))
              m = m + 1
            }
            out.push(sb.to_string())
          }
          sb.reset()
          let mut m = cur_start
          while m < i {
            write_cp(sb, fold_cp(word[m]))
            m = m + 1
          }
          out.push(sb.to_string())
        }
        part_count = part_count + 1
        cur_start = -1
      }
      i = i + 1
      continue
    }
    if cur_start >= 0 && i > 0 {
      let before = word[i - 1]
      let after_lower = i + 1 < n && is_lower_cp(word[i + 1])
      if camel_should_split(before, c, after_lower) {
        if part_count == 0 {
          p0_start = cur_start
          p0_end = i
        } else {
          if part_count == 1 {
            sb.reset()
            let mut m = p0_start
            while m < p0_end {
              write_cp(sb, fold_cp(word[m]))
              m = m + 1
            }
            out.push(sb.to_string())
          }
          sb.reset()
          let mut m = cur_start
          while m < i {
            write_cp(sb, fold_cp(word[m]))
            m = m + 1
          }
          out.push(sb.to_string())
        }
        part_count = part_count + 1
        cur_start = i
        i = i + 1
        continue
      }
    }
    if cur_start < 0 {
      cur_start = i
    }
    i = i + 1
  }
  if cur_start >= 0 && part_count > 0 {
    if part_count == 1 {
      sb.reset()
      let mut m = p0_start
      while m < p0_end {
        write_cp(sb, fold_cp(word[m]))
        m = m + 1
      }
      out.push(sb.to_string())
    }
    sb.reset()
    let mut m = cur_start
    while m < n {
      write_cp(sb, fold_cp(word[m]))
      m = m + 1
    }
    out.push(sb.to_string())
  }

  if is_hash_word(whole) {
    emit_hash_prefixes(whole, out)
  }
}

///| Emit CJK bigrams and `u_` unigrams directly from UTF-8 byte offsets in `text`.
fn emit_cjk_doc_offsets(
  text : String,
  offs : Array[Int],
  sb : StringBuilder,
  out : Array[String],
) -> Unit {
  let count = offs.length() - 1
  let mut j = 0
  while j + 1 < count {
    out.push(text.slice(offs[j], offs[j + 2]))
    j = j + 1
  }
  j = 0
  while j < count {
    sb.reset()
    sb.write_byte(117.to_byte()) // 'u'
    sb.write_byte(95.to_byte()) // '_'
    let mut b = offs[j]
    let b_end = offs[j + 1]
    while b < b_end {
      sb.write_byte(text.code_unit_at(b).to_byte())
      b = b + 1
    }
    out.push(sb.to_string())
    j = j + 1
  }
}

///| Tokenize document text into reusable `out` buffer using caller-owned scratch buffers.
fn tokenize_into(
  text : String,
  out : Array[String],
  sb : StringBuilder,
  cjk_offs : Array[Int],
  word_buf : Array[Int],
) -> Unit {
  let n = text.length()
  let mut i = 0
  while i < n {
    let b0 = text.code_unit_at(i)
    // Fast path for ASCII bytes
    if b0 < 0x80 {
      if b0 == 35 && i + 1 < n && is_digit_cp(text.code_unit_at(i + 1)) {
        let start = i + 1
        let mut j = start
        while j < n && is_digit_cp(text.code_unit_at(j)) {
          j = j + 1
        }
        let digits = text.slice(start, j)
        sb.reset()
        sb.write_byte(112.to_byte()) // 'p'
        sb.write_byte(114.to_byte()) // 'r'
        sb.write_string(digits)
        out.push(sb.to_string())
        out.push(digits)
        i = j
      } else if is_ascii_word_cp(b0) {
        let start = i
        let mut pure_ascii = true
        let mut has_upper = false
        let mut has_under = false
        let mut has_non_under = false
        let mut is_hex = true
        let mut has_digit = false
        let mut j = i
        while j < n {
          let bj = text.code_unit_at(j)
          if bj >= 97 && bj <= 122 {
            has_non_under = true
            if bj > 102 {
              is_hex = false
            }
            j = j + 1
          } else if bj >= 48 && bj <= 57 {
            has_non_under = true
            has_digit = true
            j = j + 1
          } else if bj >= 65 && bj <= 90 {
            has_non_under = true
            has_upper = true
            if bj > 70 {
              is_hex = false
            }
            j = j + 1
          } else if bj == 95 {
            has_under = true
            is_hex = false
            j = j + 1
          } else if bj >= 0x80 {
            let packed = decode_cp_at(text, j, n)
            if is_word_cp(packed >> 3) {
              pure_ascii = false
            }
            break
          } else {
            break
          }
        }
        if pure_ascii {
          if !has_upper && !has_under {
            let w = text.slice(start, j)
            out.push(w)
            if is_hex && has_digit && j - start >= 7 {
              emit_hash_prefixes(w, out)
            }
          } else if has_non_under {
            emit_ascii_word_complex(text, start, j, has_upper, is_hex, has_digit, sb, out)
          }
          i = j
        } else {
          word_buf.clear()
          while i < n {
            let packed = decode_cp_at(text, i, n)
            let cp = packed >> 3
            if is_word_cp(cp) {
              word_buf.push(cp)
              i = i + (packed & 7)
            } else {
              break
            }
          }
          emit_word_tokens(word_buf, sb, out)
        }
      } else {
        i = i + 1
      }
    } else {
      let packed = decode_cp_at(text, i, n)
      let cp = packed >> 3
      let ni = i + (packed & 7)
      if is_cjk_cp(cp) {
        cjk_offs.clear()
        cjk_offs.push(i)
        cjk_offs.push(ni)
        i = ni
        while i < n {
          let p2 = decode_cp_at(text, i, n)
          if is_cjk_cp(p2 >> 3) {
            i = i + (p2 & 7)
            cjk_offs.push(i)
          } else {
            break
          }
        }
        emit_cjk_doc_offsets(text, cjk_offs, sb, out)
      } else if is_word_cp(cp) {
        word_buf.clear()
        word_buf.push(cp)
        i = ni
        while i < n {
          let p2 = decode_cp_at(text, i, n)
          let cp2 = p2 >> 3
          if is_word_cp(cp2) {
            word_buf.push(cp2)
            i = i + (p2 & 7)
          } else {
            break
          }
        }
        emit_word_tokens(word_buf, sb, out)
      } else {
        i = ni
      }
    }
  }
}

///| Tokenize document text into normalized search tokens (CJK bigrams + `u_` unigrams,
///| Unicode case-folded words, CamelCase/snake_case parts, `#123` refs, hex SHA prefixes).
pub fn tokenize(text : String) -> Array[String] {
  let out : Array[String] = []
  let sb = StringBuilder::new()
  let cjk_offs : Array[Int] = []
  let word_buf : Array[Int] = []
  tokenize_into(text, out, sb, cjk_offs, word_buf)
  out
}

///| Extract normalized query tokens from a free-text chunk (preserving order).
fn extract_query_terms(text : String, sb : StringBuilder) -> Array[String] {
  let out : Array[String] = []
  let n = text.length()
  let mut i = 0
  while i < n {
    let b0 = text.code_unit_at(i)
    if b0 < 0x80 {
      if b0 == 35 && i + 1 < n && is_digit_cp(text.code_unit_at(i + 1)) {
        let start = i + 1
        let mut j = start
        while j < n && is_digit_cp(text.code_unit_at(j)) {
          j = j + 1
        }
        sb.reset()
        sb.write_byte(112.to_byte()) // 'p'
        sb.write_byte(114.to_byte()) // 'r'
        let mut k = start
        while k < j {
          sb.write_byte(text.code_unit_at(k).to_byte())
          k = k + 1
        }
        out.push(sb.to_string())
        i = j
      } else if is_ascii_word_cp(b0) {
        let start = i
        let mut pure_ascii = true
        let mut has_upper = false
        let mut has_non_under = false
        let mut j = i
        while j < n {
          let bj = text.code_unit_at(j)
          if bj >= 97 && bj <= 122 {
            has_non_under = true
            j = j + 1
          } else if bj >= 48 && bj <= 57 {
            has_non_under = true
            j = j + 1
          } else if bj >= 65 && bj <= 90 {
            has_non_under = true
            has_upper = true
            j = j + 1
          } else if bj == 95 {
            j = j + 1
          } else if bj >= 0x80 {
            let p2 = decode_cp_at(text, j, n)
            if is_word_cp(p2 >> 3) {
              pure_ascii = false
            }
            break
          } else {
            break
          }
        }
        let whole = if pure_ascii {
          i = j
          if !has_non_under {
            ""
          } else if !has_upper {
            text.slice(start, j)
          } else {
            sb.reset()
            let mut k = start
            while k < j {
              let bk = text.code_unit_at(k)
              if bk >= 65 && bk <= 90 {
                sb.write_byte((bk + 32).to_byte())
              } else {
                sb.write_byte(bk.to_byte())
              }
              k = k + 1
            }
            sb.to_string()
          }
        } else {
          let word : Array[Int] = []
          while i < n {
            let p2 = decode_cp_at(text, i, n)
            let cp2 = p2 >> 3
            if is_word_cp(cp2) {
              word.push(cp2)
              i = i + (p2 & 7)
            } else {
              break
            }
          }
          let w = lower_word_cps(word, sb)
          if is_all_underscore(w) { "" } else { w }
        }
        if whole.length() > 0 {
          let wlen = whole.length()
          let is_std_prefix = wlen == 6 || wlen == 7 || wlen == 8 || wlen == 10
          if is_hash_word(whole) && !is_std_prefix && wlen < 40 {
            let best = if wlen >= 10 {
              10
            } else if wlen >= 8 {
              8
            } else if wlen >= 7 {
              7
            } else {
              6
            }
            out.push(whole.slice(0, best))
          } else {
            out.push(whole)
          }
        }
      } else {
        i = i + 1
      }
    } else {
      let packed = decode_cp_at(text, i, n)
      let cp = packed >> 3
      let ni = i + (packed & 7)
      if is_cjk_cp(cp) {
        let offs : Array[Int] = [i, ni]
        i = ni
        while i < n {
          let p2 = decode_cp_at(text, i, n)
          if is_cjk_cp(p2 >> 3) {
            i = i + (p2 & 7)
            offs.push(i)
          } else {
            break
          }
        }
        let count = offs.length() - 1
        if count == 1 {
          sb.reset()
          sb.write_byte(117.to_byte()) // 'u'
          sb.write_byte(95.to_byte()) // '_'
          let mut b = offs[0]
          let b_end = offs[1]
          while b < b_end {
            sb.write_byte(text.code_unit_at(b).to_byte())
            b = b + 1
          }
          out.push(sb.to_string())
        } else {
          let mut j = 0
          while j + 1 < count {
            out.push(text.slice(offs[j], offs[j + 2]))
            j = j + 1
          }
        }
      } else if is_word_cp(cp) {
        let word : Array[Int] = [cp]
        i = ni
        while i < n {
          let p2 = decode_cp_at(text, i, n)
          let cp2 = p2 >> 3
          if is_word_cp(cp2) {
            word.push(cp2)
            i = i + (p2 & 7)
          } else {
            break
          }
        }
        let whole = lower_word_cps(word, sb)
        if whole.length() > 0 && !is_all_underscore(whole) {
          let wlen = whole.length()
          let is_std_prefix = wlen == 6 || wlen == 7 || wlen == 8 || wlen == 10
          if is_hash_word(whole) && !is_std_prefix && wlen < 40 {
            let best = if wlen >= 10 {
              10
            } else if wlen >= 8 {
              8
            } else if wlen >= 7 {
              7
            } else {
              6
            }
            out.push(whole.slice(0, best))
          } else {
            out.push(whole)
          }
        }
      } else {
        i = ni
      }
    }
  }
  out
}

///| Split a query string into lexical chunks, tracking whether each chunk was quoted.
fn lex_query_chunks(query : String, sb : StringBuilder) -> Array[(String, Bool)] {
  let out : Array[(String, Bool)] = []
  let n = query.length()
  let mut i = 0
  while i < n {
    let packed = decode_cp_at(query, i, n)
    let c = packed >> 3
    let ni = i + (packed & 7)
    if c == 32 || c == 9 || c == 10 || c == 13 || c == 0x3000 {
      i = ni
    } else if c == 34 {
      i = ni
      let start = i
      let mut clean = true
      while i < n {
        let p2 = decode_cp_at(query, i, n)
        let cc = p2 >> 3
        let step = p2 & 7
        if cc == 34 {
          break
        }
        if cc == 0xFFFD && step == 1 {
          clean = false
        }
        i = i + step
      }
      let end = i
      if i < n && query.code_unit_at(i) == 34 {
        i = i + 1
      }
      if end > start {
        if clean {
          out.push((query.slice(start, end), true))
        } else {
          sb.reset()
          let mut k = start
          while k < end {
            let p2 = decode_cp_at(query, k, end)
            write_cp(sb, p2 >> 3)
            k = k + (p2 & 7)
          }
          let s = sb.to_string()
          if s.length() > 0 {
            out.push((s, true))
          }
        }
      }
    } else {
      let start = i
      let mut clean = !(c == 0xFFFD && (packed & 7) == 1)
      i = ni
      while i < n {
        let p2 = decode_cp_at(query, i, n)
        let cc = p2 >> 3
        let step = p2 & 7
        if cc == 32 || cc == 9 || cc == 10 || cc == 13 || cc == 0x3000 || cc == 34 {
          break
        }
        if cc == 0xFFFD && step == 1 {
          clean = false
        }
        i = i + step
      }
      let end = i
      if end > start {
        if clean {
          out.push((query.slice(start, end), false))
        } else {
          sb.reset()
          let mut k = start
          while k < end {
            let p2 = decode_cp_at(query, k, end)
            write_cp(sb, p2 >> 3)
            k = k + (p2 & 7)
          }
          let s = sb.to_string()
          if s.length() > 0 {
            out.push((s, false))
          }
        }
      }
    }
  }
  out
}

///|
fn has_exact_term(terms : Array[QueryTerm], target : String) -> Bool {
  let mut i = 0
  while i < terms.length() {
    match terms[i] {
      QueryTerm::Exact(s) => if s == target { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

///|
fn has_not_term(terms : Array[QueryTerm], target : String) -> Bool {
  let mut i = 0
  while i < terms.length() {
    match terms[i] {
      QueryTerm::Not(s) => if s == target { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

///| Parse a user query string into structured `QueryTerm` items supporting exact terms,
///| prefix terms (`foo*`), quoted phrases (`"foo bar"`), and `NOT` exclusions.
pub fn tokenize_query(query : String) -> Array[QueryTerm] {
  let out : Array[QueryTerm] = []
  let sb = StringBuilder::new()
  let chunks = lex_query_chunks(query, sb)
  let n = chunks.length()
  let mut i = 0
  while i < n && out.length() < max_query_terms {
    let (chunk, is_quoted) = chunks[i]
    if !is_quoted && chunk == "NOT" && i + 1 < n {
      i = i + 1
      let (next_chunk, _) = chunks[i]
      let negs = extract_query_terms(next_chunk, sb)
      let mut j = 0
      while j < negs.length() && out.length() < max_query_terms {
        if !has_not_term(out, negs[j]) {
          out.push(QueryTerm::Not(negs[j]))
        }
        j = j + 1
      }
    } else if is_quoted {
      let pts = extract_query_terms(chunk, sb)
      if pts.length() >= 2 {
        out.push(QueryTerm::Phrase(pts))
      } else if pts.length() == 1 {
        if !has_exact_term(out, pts[0]) {
          out.push(QueryTerm::Exact(pts[0]))
        }
      }
    } else if chunk.ends_with("*") && chunk.length() > 1 {
      let stem_raw = chunk.slice(0, chunk.length() - 1)
      let pts = extract_query_terms(stem_raw, sb)
      let mut j = 0
      while j < pts.length() && out.length() < max_query_terms {
        if j + 1 == pts.length() {
          out.push(QueryTerm::Prefix(pts[j]))
        } else if !has_exact_term(out, pts[j]) {
          out.push(QueryTerm::Exact(pts[j]))
        }
        j = j + 1
      }
    } else {
      let pts = extract_query_terms(chunk, sb)
      let mut j = 0
      while j < pts.length() && out.length() < max_query_terms {
        if !has_exact_term(out, pts[j]) {
          out.push(QueryTerm::Exact(pts[j]))
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  out
}

///| Produce a normalized space-separated token string suitable for indexing in SQLite FTS5
///| (`tokenize="unicode61 tokenchars '_'"`), guaranteeing 100% same-source tokenization.
pub fn fts5_index_text(text : String) -> String {
  let toks = tokenize(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < toks.length() {
    if i > 0 {
      sb.write_byte(32.to_byte())
    }
    sb.write_string(toks[i])
    i = i + 1
  }
  sb.to_string()
}

///|
fn write_fts5_quoted(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte(34.to_byte())
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_byte(34.to_byte())
      sb.write_byte(34.to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte(34.to_byte())
}

///| Format a user query string as an SQLite FTS5 `MATCH` expression.
pub fn fts5_match_expr(query : String) -> String {
  let terms = tokenize_query(query)
  let pos = StringBuilder::new()
  let mut pos_count = 0
  let negs : Array[String] = []
  let mut i = 0
  while i < terms.length() {
    match terms[i] {
      QueryTerm::Exact(t) => {
        if pos_count > 0 {
          pos.write_string(" AND ")
        }
        write_fts5_quoted(pos, t)
        pos_count = pos_count + 1
      }
      QueryTerm::Prefix(p) => {
        if pos_count > 0 {
          pos.write_string(" AND ")
        }
        write_fts5_quoted(pos, p)
        pos.write_byte(42.to_byte())
        pos_count = pos_count + 1
      }
      QueryTerm::Phrase(ts) => {
        if ts.length() > 0 {
          if pos_count > 0 {
            pos.write_string(" AND ")
          }
          pos.write_byte(34.to_byte())
          let mut j = 0
          while j < ts.length() {
            if j > 0 {
              pos.write_byte(32.to_byte())
            }
            pos.write_string(ts[j])
            j = j + 1
          }
          pos.write_byte(34.to_byte())
          pos_count = pos_count + 1
        }
      }
      QueryTerm::Not(t) => negs.push(t)
    }
    i = i + 1
  }
  if pos_count == 0 {
    return ""
  }
  let mut j = 0
  while j < negs.length() {
    pos.write_string(" NOT ")
    write_fts5_quoted(pos, negs[j])
    j = j + 1
  }
  pos.to_string()
}
