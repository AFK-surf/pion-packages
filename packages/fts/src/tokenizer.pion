///| Multilingual and code-aware tokenizer for full-text search and SQLite FTS5 parity.

///| A parsed term in a full-text search query.
pub enum QueryTerm {
  Exact(String)
  Prefix(String)
  Phrase(Array[String])
  Not(String)
}

///| Maximum number of terms parsed from a single query string to prevent pathological blowup.
let max_query_terms : Int = 64

///| Return true if `v` is an indexable CJK/Kana/Hangul codepoint (excluding RT-2 separator marks).
#verify
pub fn is_cjk_cp(v : Int) -> Bool {
  // Kana voicing marks (Mn/Sk), the double hyphen and the middle dot are not FTS5 token characters:
  // indexing them would emit `u_<mark>` tokens that SQLite strips to `u_` (RT-2).
  if (v >= 0x3099 && v <= 0x309C) || v == 0x30A0 || v == 0x30FB {
    return false
  }
  (v >= 0x3400 && v <= 0x4DBF) ||
  (v >= 0x4E00 && v <= 0x9FFF) ||
  (v >= 0xF900 && v <= 0xFAFF) ||
  (v >= 0x20000 && v <= 0x2FFFF) ||
  (v >= 0x3040 && v <= 0x30FF) ||
  (v >= 0x31F0 && v <= 0x31FF) ||
  (v >= 0xAC00 && v <= 0xD7AF) ||
  (v >= 0x1100 && v <= 0x11FF)
}

///| Return true if `c` is an ASCII identifier codepoint `[A-Za-z0-9_]`.
#verify
pub fn is_ascii_word_cp(c : Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
}

///| Return true if `c` is an ASCII uppercase letter `'A'..'Z'`.
pub fn is_upper_cp(c : Int) -> Bool {
  c >= 65 && c <= 90
}

///| Return true if `c` is an ASCII lowercase letter `'a'..'z'`.
pub fn is_lower_cp(c : Int) -> Bool {
  c >= 97 && c <= 122
}

///| Return true if `c` is an ASCII decimal digit `'0'..'9'`.
pub fn is_digit_cp(c : Int) -> Bool {
  c >= 48 && c <= 57
}

///| Return true if CamelCase tokenization should split before `cur` given `before` and `after_lower`.
pub fn camel_should_split(before : Int, cur : Int, after_lower : Bool) -> Bool {
  is_upper_cp(cur) &&
  (is_lower_cp(before) || is_digit_cp(before) || (is_upper_cp(before) && after_lower))
}

///|
fn is_word_cp(c : Int) -> Bool {
  if c < 0x80 {
    is_ascii_word_cp(c)
  } else {
    match fold_unicode_letter(c) {
      Some(_) => true
      None => false
    }
  }
}

///|
fn is_all_underscore(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) != 95 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn is_hash_word(word : String) -> Bool {
  let n = word.length()
  if n < 7 {
    return false
  }
  let mut has_digit = false
  let mut i = 0
  while i < n {
    let b = word.code_unit_at(i)
    if b >= 48 && b <= 57 {
      has_digit = true
    } else if b < 97 || b > 102 {
      return false
    }
    i = i + 1
  }
  has_digit
}

///|
fn lower_word_cps(word : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  let n = word.length()
  while i < n {
    write_cp(sb, fold_cp(word[i]))
    i = i + 1
  }
  sb.to_string()
}

///|
fn word_parts_cps(word : Array[Int]) -> Array[String] {
  let parts : Array[String] = []
  let mut cur = StringBuilder::new()
  let mut has_cur = false
  let n = word.length()
  let mut i = 0
  while i < n {
    let c = word[i]
    if c == 95 {
      if has_cur {
        parts.push(cur.to_string())
        cur = StringBuilder::new()
        has_cur = false
      }
      i = i + 1
      continue
    }
    if i > 0 {
      let before = word[i - 1]
      let after_lower = i + 1 < n && is_lower_cp(word[i + 1])
      if camel_should_split(before, c, after_lower) {
        if has_cur {
          parts.push(cur.to_string())
          cur = StringBuilder::new()
          has_cur = false
        }
      }
    }
    write_cp(cur, fold_cp(c))
    has_cur = true
    i = i + 1
  }
  if has_cur {
    parts.push(cur.to_string())
  }
  parts
}

///|
fn emit_word_tokens(word : Array[Int], out : Array[String]) -> Unit {
  let whole = lower_word_cps(word)
  if whole.length() == 0 || is_all_underscore(whole) {
    return
  }
  out.push(whole)
  let parts = word_parts_cps(word)
  if parts.length() > 1 {
    let mut k = 0
    while k < parts.length() {
      out.push(parts[k])
      k = k + 1
    }
  }
  if is_hash_word(whole) {
    let wlen = whole.length()
    if 6 < wlen {
      out.push(whole.slice(0, 6))
    }
    if 7 < wlen {
      out.push(whole.slice(0, 7))
    }
    if 8 < wlen {
      out.push(whole.slice(0, 8))
    }
    if 10 < wlen {
      out.push(whole.slice(0, 10))
    }
  }
}

///|
fn emit_cjk_doc_tokens(run : Array[Int], out : Array[String]) -> Unit {
  let n = run.length()
  let mut j = 0
  while j + 1 < n {
    out.push(cps_to_string(run, j, j + 2))
    j = j + 1
  }
  j = 0
  while j < n {
    out.push("u_" + cp_to_string(run[j]))
    j = j + 1
  }
}

///| Decode one UTF-8 scalar value starting at `s[i]`, writing `(cp, next_i)`.
fn next_cp_at(s : String, i : Int, n : Int) -> (Int, Int) {
  let b0 = s.code_unit_at(i)
  if b0 < 0x80 {
    return (b0, i + 1)
  }
  if b0 >= 0xC2 && b0 <= 0xDF && i + 1 < n {
    let b1 = s.code_unit_at(i + 1)
    if (b1 & 0xC0) == 0x80 {
      return (((b0 & 0x1F) << 6) | (b1 & 0x3F), i + 2)
    }
  } else if b0 >= 0xE0 && b0 <= 0xEF && i + 2 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    let valid_cont = (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80
    let overlong = b0 == 0xE0 && b1 < 0xA0
    let surrogate = b0 == 0xED && b1 >= 0xA0
    if valid_cont && !overlong && !surrogate {
      return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), i + 3)
    }
  } else if b0 >= 0xF0 && b0 <= 0xF4 && i + 3 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    let b3 = s.code_unit_at(i + 3)
    let valid_cont = (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80
    let overlong = b0 == 0xF0 && b1 < 0x90
    let too_high = b0 == 0xF4 && b1 > 0x8F
    if valid_cont && !overlong && !too_high {
      return (
        ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F),
        i + 4,
      )
    }
  }
  (0xFFFD, i + 1)
}

///| Tokenize document text into normalized search tokens (CJK bigrams + `u_` unigrams,
///| Unicode case-folded words, CamelCase/snake_case parts, `#123` refs, hex SHA prefixes).
pub fn tokenize(text : String) -> Array[String] {
  let out : Array[String] = []
  let n = text.length()
  let mut i = 0
  while i < n {
    let b0 = text.code_unit_at(i)
    // Fast path for ASCII bytes
    if b0 < 0x80 {
      if b0 == 35 && i + 1 < n && is_digit_cp(text.code_unit_at(i + 1)) {
        let start = i + 1
        let mut j = start
        while j < n && is_digit_cp(text.code_unit_at(j)) {
          j = j + 1
        }
        let digits = text.slice(start, j)
        out.push("pr" + digits)
        out.push(digits)
        i = j
      } else if is_ascii_word_cp(b0) {
        // Fast scan: check if purely ASCII lowercase without underscore/upper/hash
        let start = i
        let mut pure_simple_ascii = true
        let mut has_upper = false
        let mut has_under = false
        let mut j = i
        while j < n {
          let bj = text.code_unit_at(j)
          if bj >= 97 && bj <= 122 {
            j = j + 1
          } else if bj >= 48 && bj <= 57 {
            j = j + 1
          } else if bj >= 65 && bj <= 90 {
            has_upper = true
            j = j + 1
          } else if bj == 95 {
            has_under = true
            j = j + 1
          } else if bj >= 0x80 {
            let (cp2, _) = next_cp_at(text, j, n)
            if is_word_cp(cp2) {
              pure_simple_ascii = false
              break
            } else {
              break
            }
          } else {
            break
          }
        }
        if pure_simple_ascii && !has_upper && !has_under {
          let w = text.slice(start, j)
          out.push(w)
          if is_hash_word(w) {
            let wlen = w.length()
            if 6 < wlen {
              out.push(w.slice(0, 6))
            }
            if 7 < wlen {
              out.push(w.slice(0, 7))
            }
            if 8 < wlen {
              out.push(w.slice(0, 8))
            }
            if 10 < wlen {
              out.push(w.slice(0, 10))
            }
          }
          i = j
        } else {
          let word : Array[Int] = []
          while i < n {
            let (cp, ni) = next_cp_at(text, i, n)
            if is_word_cp(cp) {
              word.push(cp)
              i = ni
            } else {
              break
            }
          }
          emit_word_tokens(word, out)
        }
      } else {
        i = i + 1
      }
    } else {
      let (cp, ni) = next_cp_at(text, i, n)
      if is_cjk_cp(cp) {
        let run : Array[Int] = [cp]
        i = ni
        while i < n {
          let (cp2, ni2) = next_cp_at(text, i, n)
          if is_cjk_cp(cp2) {
            run.push(cp2)
            i = ni2
          } else {
            break
          }
        }
        emit_cjk_doc_tokens(run, out)
      } else if is_word_cp(cp) {
        let word : Array[Int] = [cp]
        i = ni
        while i < n {
          let (cp2, ni2) = next_cp_at(text, i, n)
          if is_word_cp(cp2) {
            word.push(cp2)
            i = ni2
          } else {
            break
          }
        }
        emit_word_tokens(word, out)
      } else {
        i = ni
      }
    }
  }
  out
}

///| Extract normalized query tokens from a free-text chunk (preserving order).
fn extract_query_terms(text : String) -> Array[String] {
  let out : Array[String] = []
  let n = text.length()
  let mut i = 0
  while i < n {
    let (cp, ni) = next_cp_at(text, i, n)
    if is_cjk_cp(cp) {
      let run : Array[Int] = [cp]
      i = ni
      while i < n {
        let (cp2, ni2) = next_cp_at(text, i, n)
        if is_cjk_cp(cp2) {
          run.push(cp2)
          i = ni2
        } else {
          break
        }
      }
      if run.length() == 1 {
        out.push("u_" + cp_to_string(run[0]))
      } else {
        let mut j = 0
        while j + 1 < run.length() {
          out.push(cps_to_string(run, j, j + 2))
          j = j + 1
        }
      }
    } else if cp == 35 && ni < n && is_digit_cp(text.code_unit_at(ni)) {
      let start = ni
      let mut j = start
      while j < n && is_digit_cp(text.code_unit_at(j)) {
        j = j + 1
      }
      out.push("pr" + text.slice(start, j))
      i = j
    } else if is_word_cp(cp) {
      let word : Array[Int] = [cp]
      i = ni
      while i < n {
        let (cp2, ni2) = next_cp_at(text, i, n)
        if is_word_cp(cp2) {
          word.push(cp2)
          i = ni2
        } else {
          break
        }
      }
      let whole = lower_word_cps(word)
      if whole.length() > 0 && !is_all_underscore(whole) {
        let wlen = whole.length()
        let is_std_prefix = wlen == 6 || wlen == 7 || wlen == 8 || wlen == 10
        if is_hash_word(whole) && !is_std_prefix && wlen < 40 {
          let best = if wlen >= 10 {
            10
          } else if wlen >= 8 {
            8
          } else if wlen >= 7 {
            7
          } else {
            6
          }
          out.push(whole.slice(0, best))
        } else {
          out.push(whole)
        }
      }
    } else {
      i = ni
    }
  }
  out
}

///| Split a query string into lexical chunks, tracking whether each chunk was quoted.
fn lex_query_chunks(query : String) -> Array[(String, Bool)] {
  let out : Array[(String, Bool)] = []
  let cps = utf8_codepoints(query)
  let n = cps.length()
  let mut i = 0
  while i < n {
    let c = cps[i]
    if c == 32 || c == 9 || c == 10 || c == 13 || c == 0x3000 {
      i = i + 1
    } else if c == 34 {
      i = i + 1
      let sb = StringBuilder::new()
      while i < n && cps[i] != 34 {
        write_cp(sb, cps[i])
        i = i + 1
      }
      if i < n && cps[i] == 34 {
        i = i + 1
      }
      let s = sb.to_string()
      if s.length() > 0 {
        out.push((s, true))
      }
    } else {
      let sb = StringBuilder::new()
      while i < n {
        let cc = cps[i]
        if cc == 32 || cc == 9 || cc == 10 || cc == 13 || cc == 0x3000 || cc == 34 {
          break
        }
        write_cp(sb, cc)
        i = i + 1
      }
      let s = sb.to_string()
      if s.length() > 0 {
        out.push((s, false))
      }
    }
  }
  out
}

///|
fn has_exact_term(terms : Array[QueryTerm], target : String) -> Bool {
  let mut i = 0
  while i < terms.length() {
    match terms[i] {
      QueryTerm::Exact(s) => if s == target { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

///|
fn has_not_term(terms : Array[QueryTerm], target : String) -> Bool {
  let mut i = 0
  while i < terms.length() {
    match terms[i] {
      QueryTerm::Not(s) => if s == target { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

///| Parse a user query string into structured `QueryTerm` items supporting exact terms,
///| prefix terms (`foo*`), quoted phrases (`"foo bar"`), and `NOT` exclusions.
pub fn tokenize_query(query : String) -> Array[QueryTerm] {
  let out : Array[QueryTerm] = []
  let chunks = lex_query_chunks(query)
  let n = chunks.length()
  let mut i = 0
  while i < n && out.length() < max_query_terms {
    let (chunk, is_quoted) = chunks[i]
    if !is_quoted && chunk == "NOT" && i + 1 < n {
      i = i + 1
      let (next_chunk, _) = chunks[i]
      let negs = extract_query_terms(next_chunk)
      let mut j = 0
      while j < negs.length() && out.length() < max_query_terms {
        if !has_not_term(out, negs[j]) {
          out.push(QueryTerm::Not(negs[j]))
        }
        j = j + 1
      }
    } else if is_quoted {
      let pts = extract_query_terms(chunk)
      if pts.length() >= 2 {
        out.push(QueryTerm::Phrase(pts))
      } else if pts.length() == 1 {
        if !has_exact_term(out, pts[0]) {
          out.push(QueryTerm::Exact(pts[0]))
        }
      }
    } else if chunk.ends_with("*") && chunk.length() > 1 {
      let stem_raw = chunk.slice(0, chunk.length() - 1)
      let pts = extract_query_terms(stem_raw)
      let mut j = 0
      while j < pts.length() && out.length() < max_query_terms {
        if j + 1 == pts.length() {
          out.push(QueryTerm::Prefix(pts[j]))
        } else if !has_exact_term(out, pts[j]) {
          out.push(QueryTerm::Exact(pts[j]))
        }
        j = j + 1
      }
    } else {
      let pts = extract_query_terms(chunk)
      let mut j = 0
      while j < pts.length() && out.length() < max_query_terms {
        if !has_exact_term(out, pts[j]) {
          out.push(QueryTerm::Exact(pts[j]))
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  out
}

///| Produce a normalized space-separated token string suitable for indexing in SQLite FTS5
///| (`tokenize="unicode61 tokenchars '_'"`), guaranteeing 100% same-source tokenization.
pub fn fts5_index_text(text : String) -> String {
  let toks = tokenize(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < toks.length() {
    if i > 0 {
      sb.write_byte(32.to_byte())
    }
    sb.write_string(toks[i])
    i = i + 1
  }
  sb.to_string()
}

///|
fn write_fts5_quoted(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte(34.to_byte())
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_byte(34.to_byte())
      sb.write_byte(34.to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte(34.to_byte())
}

///| Format a user query string as an SQLite FTS5 `MATCH` expression.
pub fn fts5_match_expr(query : String) -> String {
  let terms = tokenize_query(query)
  let pos = StringBuilder::new()
  let mut pos_count = 0
  let negs : Array[String] = []
  let mut i = 0
  while i < terms.length() {
    match terms[i] {
      QueryTerm::Exact(t) => {
        if pos_count > 0 {
          pos.write_string(" AND ")
        }
        write_fts5_quoted(pos, t)
        pos_count = pos_count + 1
      }
      QueryTerm::Prefix(p) => {
        if pos_count > 0 {
          pos.write_string(" AND ")
        }
        write_fts5_quoted(pos, p)
        pos.write_byte(42.to_byte())
        pos_count = pos_count + 1
      }
      QueryTerm::Phrase(ts) => {
        if ts.length() > 0 {
          if pos_count > 0 {
            pos.write_string(" AND ")
          }
          pos.write_byte(34.to_byte())
          let mut j = 0
          while j < ts.length() {
            if j > 0 {
              pos.write_byte(32.to_byte())
            }
            pos.write_string(ts[j])
            j = j + 1
          }
          pos.write_byte(34.to_byte())
          pos_count = pos_count + 1
        }
      }
      QueryTerm::Not(t) => negs.push(t)
    }
    i = i + 1
  }
  if pos_count == 0 {
    return ""
  }
  let mut j = 0
  while j < negs.length() {
    pos.write_string(" NOT ")
    write_fts5_quoted(pos, negs[j])
    j = j + 1
  }
  pos.to_string()
}
