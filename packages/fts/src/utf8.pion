///| Pure-Pion UTF-8 codec, Unicode case-folding, and IEEE-754 `ln(x)` helpers
///| (zero `World`, Native + Wasm32 portable).

///| Decode a UTF-8 string into Unicode scalar values, replacing any malformed
///| byte sequence with U+FFFD without panicking.
fn utf8_codepoints(s : String) -> Array[Int] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      out.push(b0)
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF && i + 1 < n {
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) == 0x80 {
        out.push(((b0 & 0x1F) << 6) | (b1 & 0x3F))
        i = i + 2
      } else {
        out.push(0xFFFD)
        i = i + 1
      }
    } else if b0 >= 0xE0 && b0 <= 0xEF && i + 2 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let valid_cont = (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80
      let overlong = b0 == 0xE0 && b1 < 0xA0
      let surrogate = b0 == 0xED && b1 >= 0xA0
      if valid_cont && !overlong && !surrogate {
        out.push(((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
        i = i + 3
      } else {
        out.push(0xFFFD)
        i = i + 1
      }
    } else if b0 >= 0xF0 && b0 <= 0xF4 && i + 3 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      let valid_cont = (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80
      let overlong = b0 == 0xF0 && b1 < 0x90
      let too_high = b0 == 0xF4 && b1 > 0x8F
      if valid_cont && !overlong && !too_high {
        out.push(
          ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F),
        )
        i = i + 4
      } else {
        out.push(0xFFFD)
        i = i + 1
      }
    } else {
      out.push(0xFFFD)
      i = i + 1
    }
  }
  out
}

///| Sanitize a codepoint to a valid Unicode scalar value, replacing invalid/surrogate values with U+FFFD.
#verify
pub fn sanitize_scalar(cp : Int) -> Int {
  if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    0xFFFD
  } else {
    cp
  }
}

///| Number of UTF-8 bytes required to encode Unicode scalar value `cp`.
#verify
pub fn cp_utf8_len(cp : Int) -> Int {
  let v = sanitize_scalar(cp)
  if v < 0x80 {
    1
  } else if v < 0x800 {
    2
  } else if v < 0x10000 {
    3
  } else {
    4
  }
}

///| Encode a single Unicode scalar value into UTF-8 bytes on `sb`.
fn write_cp(sb : StringBuilder, cp : Int) -> Unit {
  let v = sanitize_scalar(cp)
  if v < 0x80 {
    sb.write_byte(v.to_byte())
  } else if v < 0x800 {
    sb.write_byte((0xC0 | (v >> 6)).to_byte())
    sb.write_byte((0x80 | (v & 0x3F)).to_byte())
  } else if v < 0x10000 {
    sb.write_byte((0xE0 | (v >> 12)).to_byte())
    sb.write_byte((0x80 | ((v >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (v & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (v >> 18)).to_byte())
    sb.write_byte((0x80 | ((v >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((v >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (v & 0x3F)).to_byte())
  }
}

///| Encode a slice of codepoints `cps[from..to]` as a UTF-8 `String`.
fn cps_to_string(cps : Array[Int], from : Int, to : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = from
  let limit = if to < cps.length() { to } else { cps.length() }
  while i < limit {
    write_cp(sb, cps[i])
    i = i + 1
  }
  sb.to_string()
}

///| Encode a single codepoint as a UTF-8 `String`.
fn cp_to_string(cp : Int) -> String {
  let sb = StringBuilder::new()
  write_cp(sb, cp)
  sb.to_string()
}

///| SQLite FTS5 `unicode61` (default `remove_diacritics 1`) fold of U+00C0..U+017F, generated from
///| SQLite 3.54.0 itself: lowercase plus single-diacritic removal (`É` -> `e`, `Ÿ` -> `y`, `ſ` -> `s`,
///| `İ` -> `i`). Index text must already be in this form, otherwise FTS5 would merge tokens that the
///| in-memory index keeps apart (see `audit/REDTEAM_AUDIT.md`, RT-1).
let latin_fold_table : Array[Int] = [
  0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0xE6, 0x63,
  0x65, 0x65, 0x65, 0x65, 0x69, 0x69, 0x69, 0x69,
  0xF0, 0x6E, 0x6F, 0x6F, 0x6F, 0x6F, 0x6F, 0xD7,
  0xF8, 0x75, 0x75, 0x75, 0x75, 0x79, 0xFE, 0xDF,
  0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0xE6, 0x63,
  0x65, 0x65, 0x65, 0x65, 0x69, 0x69, 0x69, 0x69,
  0xF0, 0x6E, 0x6F, 0x6F, 0x6F, 0x6F, 0x6F, 0xF7,
  0xF8, 0x75, 0x75, 0x75, 0x75, 0x79, 0xFE, 0x79,
  0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x63, 0x63,
  0x63, 0x63, 0x63, 0x63, 0x63, 0x63, 0x64, 0x64,
  0x111, 0x111, 0x65, 0x65, 0x65, 0x65, 0x65, 0x65,
  0x65, 0x65, 0x65, 0x65, 0x67, 0x67, 0x67, 0x67,
  0x67, 0x67, 0x67, 0x67, 0x68, 0x68, 0x127, 0x127,
  0x69, 0x69, 0x69, 0x69, 0x69, 0x69, 0x69, 0x69,
  0x69, 0x131, 0x133, 0x133, 0x6A, 0x6A, 0x6B, 0x6B,
  0x138, 0x6C, 0x6C, 0x6C, 0x6C, 0x6C, 0x6C, 0x140,
  0x140, 0x142, 0x142, 0x6E, 0x6E, 0x6E, 0x6E, 0x6E,
  0x6E, 0x149, 0x14B, 0x14B, 0x6F, 0x6F, 0x6F, 0x6F,
  0x6F, 0x6F, 0x153, 0x153, 0x72, 0x72, 0x72, 0x72,
  0x72, 0x72, 0x73, 0x73, 0x73, 0x73, 0x73, 0x73,
  0x73, 0x73, 0x74, 0x74, 0x74, 0x74, 0x167, 0x167,
  0x75, 0x75, 0x75, 0x75, 0x75, 0x75, 0x75, 0x75,
  0x75, 0x75, 0x75, 0x75, 0x77, 0x77, 0x79, 0x79,
  0x79, 0x7A, 0x7A, 0x7A, 0x7A, 0x7A, 0x7A, 0x73
]

///| Fold a Greek or Cyrillic letter per SQLite FTS5 `unicode61`, returning `-1` if outside range.
#verify
pub fn fold_greek_cyrillic(v : Int) -> Int {
  if v == 0x386 {
    0x3AC
  } else if v >= 0x388 && v <= 0x38A {
    v + 0x25
  } else if v == 0x38C {
    0x3CC
  } else if v >= 0x38E && v <= 0x38F {
    v + 0x3F
  } else if v >= 0x391 && v <= 0x3A9 && v != 0x3A2 {
    v + 0x20
  } else if v == 0x3C2 {
    0x3C3
  } else if v >= 0x3AC && v <= 0x3CE {
    v
  } else if v >= 0x410 && v <= 0x42F {
    v + 0x20
  } else if v >= 0x400 && v <= 0x40F {
    v + 0x50
  } else if v >= 0x430 && v <= 0x45F {
    v
  } else {
    -1
  }
}

///| Fold an ASCII uppercase letter `'A'..'Z'` to lowercase `'a'..'z'`.
#verify
pub fn fold_ascii_cp(c : Int) -> Int {
  if c >= 65 && c <= 90 { c + 32 } else { c }
}

///| Fold a non-ASCII Latin, Greek, or Cyrillic letter exactly as SQLite FTS5 `unicode61` does,
///| or `None` if it is not a letter this tokenizer indexes.
fn fold_unicode_letter(v : Int) -> Option[Int] {
  if v >= 0xC0 && v <= 0x17F {
    if v == 0xD7 || v == 0xF7 {
      None
    } else {
      Some(latin_fold_table[v - 0xC0])
    }
  } else {
    let f = fold_greek_cyrillic(v)
    if f >= 0 { Some(f) } else { None }
  }
}

///| Fold any Unicode codepoint (ASCII + Latin/Greek/Cyrillic) to lowercase.
fn fold_cp(c : Int) -> Int {
  if c < 0x80 {
    fold_ascii_cp(c)
  } else {
    match fold_unicode_letter(c) {
      Some(l) => l
      None => c
    }
  }
}

///| Pure-Pion IEEE-754 natural logarithm `ln(x)` for `x > 0.0` (full double precision).
fn math_ln(x : Double) -> Double {
  if x <= 0.0 {
    return -1.0e300
  }
  let ln2 = 0.693147180559945309417232121458176568
  let mut m = x
  let mut k = 0
  while m >= 1.4142135623730951 {
    m = m * 0.5
    k = k + 1
  }
  while m < 0.7071067811865476 {
    m = m * 2.0
    k = k - 1
  }
  let y = (m - 1.0) / (m + 1.0)
  let y2 = y * y
  let mut term = y
  let mut sum = y
  let mut denom = 3.0
  let mut i = 0
  while i < 20 {
    term = term * y2
    let add = term / denom
    sum = sum + add
    if add < 1.0e-17 && add > -1.0e-17 {
      break
    }
    denom = denom + 2.0
    i = i + 1
  }
  k.to_double() * ln2 + 2.0 * sum
}
