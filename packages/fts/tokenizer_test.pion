///| Unit tests for `packages/fts` tokenizer, query parser, and SQLite FTS5 adapters.

///|
fn has_str(arr : Array[String], target : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn arr_eq_str(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn qt_eq(a : QueryTerm, b : QueryTerm) -> Bool {
  match a {
    QueryTerm::Exact(sa) =>
    match b {
      QueryTerm::Exact(sb) => sa == sb
      _ => false
    }
    QueryTerm::Prefix(sa) =>
    match b {
      QueryTerm::Prefix(sb) => sa == sb
      _ => false
    }
    QueryTerm::Phrase(pa) =>
    match b {
      QueryTerm::Phrase(pb) => arr_eq_str(pa, pb)
      _ => false
    }
    QueryTerm::Not(sa) =>
    match b {
      QueryTerm::Not(sb) => sa == sb
      _ => false
    }
  }
}

///|
fn qt_arr_eq(a : Array[QueryTerm], b : Array[QueryTerm]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !qt_eq(a[i], b[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "tokenize_cjk_bigrams_and_unigrams" {
  let zh = tokenize("全文检索")
  debug_assert(
    arr_eq_str(zh, ["全文", "文检", "检索", "u_全", "u_文", "u_检", "u_索"]),
    "Chinese 4-char bigrams + unigrams",
  )

  let single = tokenize("中")
  debug_assert(arr_eq_str(single, ["u_中"]), "single CJK char emits unigram")

  let jp = tokenize("ひらがなカタカナ")
  debug_assert(has_str(jp, "ひら"), "Hiragana bigram")
  debug_assert(has_str(jp, "なカ"), "Kana boundary bigram")
  debug_assert(has_str(jp, "タカ"), "Katakana bigram")
  debug_assert(has_str(jp, "u_ひ"), "Hiragana unigram")

  let kr = tokenize("한국어")
  debug_assert(
    arr_eq_str(kr, ["한국", "국어", "u_한", "u_국", "u_어"]),
    "Korean Hangul bigrams + unigrams",
  )
}

///|
test "tokenize_unicode_case_folding" {
  // Latin-1 Supplement, Latin Extended-A, Greek, Cyrillic
  let latin = tokenize("Café ÜBER Ñoño")
  debug_assert(has_str(latin, "café"), "Latin-1 lowercase")
  debug_assert(has_str(latin, "über"), "Latin-1 uppercase U-umlaut folded")
  debug_assert(has_str(latin, "ñoño"), "Latin-1 N-tilde folded")

  let greek = tokenize("Ωμέγα ΔΕΛΤΑ")
  debug_assert(has_str(greek, "ωμέγα") || has_str(greek, "ω"), "Greek omega folded")
  debug_assert(has_str(greek, "δελτα"), "Greek DELTA folded")

  let cyr = tokenize("Привет МИР Ёлка")
  debug_assert(has_str(cyr, "привет"), "Cyrillic Privet folded")
  debug_assert(has_str(cyr, "мир"), "Cyrillic MIR folded")
  debug_assert(has_str(cyr, "ёлка"), "Cyrillic Yo folded")
}

///|
test "tokenize_code_identifiers_pr_and_sha" {
  let camel = tokenize("GroupSurface HTTPServer parseUTF8String")
  debug_assert(has_str(camel, "groupsurface"), "CamelCase whole word")
  debug_assert(has_str(camel, "group"), "CamelCase part group")
  debug_assert(has_str(camel, "surface"), "CamelCase part surface")
  debug_assert(has_str(camel, "httpserver"), "acronym whole word")
  debug_assert(has_str(camel, "http"), "acronym split http")
  debug_assert(has_str(camel, "server"), "acronym split server")
  debug_assert(has_str(camel, "parse"), "parseUTF8String -> parse")
  debug_assert(has_str(camel, "utf8"), "parseUTF8String -> utf8")
  debug_assert(has_str(camel, "string"), "parseUTF8String -> string")

  let snake = tokenize("nc_follow get_user_id ___")
  debug_assert(has_str(snake, "nc_follow"), "snake_case whole word")
  debug_assert(has_str(snake, "nc"), "snake_case part nc")
  debug_assert(has_str(snake, "follow"), "snake_case part follow")
  debug_assert(has_str(snake, "get_user_id"), "snake_case 3-part whole")
  debug_assert(has_str(snake, "user"), "snake_case part user")
  debug_assert(!has_str(snake, "___"), "all-underscore skipped")

  let pr = tokenize("Fixed in #1234 and #42")
  debug_assert(has_str(pr, "pr1234"), "#1234 -> pr1234")
  debug_assert(has_str(pr, "1234"), "#1234 -> 1234")
  debug_assert(has_str(pr, "pr42"), "#42 -> pr42")

  let sha = tokenize("commit a1b2c3d4e5f60718 abcdefg")
  debug_assert(has_str(sha, "a1b2c3d4e5f60718"), "full hex SHA")
  debug_assert(has_str(sha, "a1b2c3"), "6-char SHA prefix")
  debug_assert(has_str(sha, "a1b2c3d"), "7-char SHA prefix")
  debug_assert(has_str(sha, "a1b2c3d4"), "8-char SHA prefix")
  debug_assert(has_str(sha, "a1b2c3d4e5"), "10-char SHA prefix")
  // Pure alpha word without digits must NOT emit SHA prefixes
  debug_assert(!has_str(sha, "abcdef"), "non-SHA pure alpha has no hash prefix")
}

///|
test "tokenize_query_operators_and_fts5_parity" {
  let q1 = tokenize_query("hello world")
  debug_assert(
    qt_arr_eq(q1, [QueryTerm::Exact("hello"), QueryTerm::Exact("world")]),
    "exact terms",
  )

  let q2 = tokenize_query("tok* \"full text\" NOT legacy")
  debug_assert(
    qt_arr_eq(
      q2,
      [
        QueryTerm::Prefix("tok"),
        QueryTerm::Phrase(["full", "text"]),
        QueryTerm::Not("legacy"),
      ],
    ),
    "prefix + phrase + NOT",
  )

  let q3 = tokenize_query("中 全文 #1234 a1b2c3d4e")
  debug_assert(
    qt_arr_eq(
      q3,
      [
        QueryTerm::Exact("u_中"),
        QueryTerm::Exact("全文"),
        QueryTerm::Exact("pr1234"),
        QueryTerm::Exact("a1b2c3d4"),
      ],
    ),
    "CJK single + bigram + #PR + 9-char SHA prefix query",
  )

  let idx_txt = fts5_index_text("Hello 中文 nc_follow")
  debug_assert(
    idx_txt == "hello 中文 u_中 u_文 nc_follow nc follow",
    "fts5_index_text exact format",
  )

  let m1 = fts5_match_expr("hello world")
  debug_assert(m1 == "\"hello\" AND \"world\"", "fts5_match_expr exact AND")

  let m2 = fts5_match_expr("tok* \"full text\" NOT legacy")
  debug_assert(
    m2 == "\"tok\"* AND \"full text\" NOT \"legacy\"",
    "fts5_match_expr prefix + phrase + NOT",
  )

  debug_assert(fts5_match_expr("") == "", "empty query -> empty MATCH")
  debug_assert(fts5_match_expr("NOT onlyneg") == "", "negation-only -> empty MATCH")
}

///|
test "tokenize_malformed_utf8_and_boundaries" {
  debug_assert(tokenize("").length() == 0, "empty doc")
  debug_assert(tokenize("   \t\r\n  ").length() == 0, "whitespace doc")
  debug_assert(tokenize_query("").length() == 0, "empty query")
  debug_assert(tokenize_query("\"unclosed phrase").length() > 0, "unclosed quote safe")

  // Malformed UTF-8 bytes: lone continuation, truncated 3-byte, invalid 0xFF
  let bad = Bytes::new(8)
  bad[0] = 0x80.to_byte()
  bad[1] = 0xE4.to_byte()
  bad[2] = 0xB8.to_byte()
  bad[3] = 0x61.to_byte() // 'a'
  bad[4] = 0x62.to_byte() // 'b'
  bad[5] = 0x63.to_byte() // 'c'
  bad[6] = 0xFF.to_byte()
  bad[7] = 0xFE.to_byte()
  let bad_s = bad.to_string()
  let toks = tokenize(bad_s)
  debug_assert(has_str(toks, "abc"), "malformed UTF-8 recovers valid ASCII word")
}
