///| Unit tests for `packages/fts` inverted index, BM25 parity with SQLite FTS5,
///| incremental upsert/remove, filters, operators, and defensive edge cases.

///|
fn abs_f64(x : Double) -> Double {
  if x < 0.0 { -x } else { x }
}

///|
test "index_bm25_exact_sqlite_fts5_parity" {
  // Exact 4-document corpus verified against SQLite 3.54.0 FTS5:
  //   doc 1: "hello world 中文" -> tokens: hello world 中文 u_中 u_文 (len 5)
  //   doc 2: "hello pion nc_follow" -> tokens: hello pion nc_follow nc follow (len 5)
  //   doc 3: "world rust go" -> tokens: world rust go (len 3)
  //   doc 4: "hello hello world" -> tokens: hello hello world (len 3)
  // SQLite 3.54.0 FTS5 bm25() values (negated to positive):
  //   "hello": doc4 = 1.4789915966386554e-06, doc1 = 9.072164948453609e-07, doc2 = 9.072164948453609e-07
  //   "u_中" (query "中"): doc1 = 0.7686825949904529
  //   "nc_follow": doc2 = 0.7686825949904529
  //   "hello world": doc4 = 2.5929156472715667e-06, doc1 = 1.8144329896907218e-06
  let idx = Index::new()
  idx.upsert(1L, "hello world 中文")
  idx.upsert(2L, "hello pion nc_follow")
  idx.upsert(3L, "world rust go")
  idx.upsert(4L, "hello hello world")
  debug_assert(idx.len() == 4, "4 docs indexed")

  let h_hello = idx.search("hello")
  debug_assert(h_hello.length() == 3, "hello matches 3 docs")
  debug_assert(h_hello[0].doc_id == 4L, "doc4 ranks first for hello")
  debug_assert(h_hello[1].doc_id == 1L, "doc1 ranks second (doc_id tiebreak)")
  debug_assert(h_hello[2].doc_id == 2L, "doc2 ranks third")
  debug_assert(
    abs_f64(h_hello[0].score - 1.4789915966386554e-06) < 1.0e-12,
    "doc4 BM25 matches SQLite FTS5",
  )
  debug_assert(
    abs_f64(h_hello[1].score - 9.072164948453609e-07) < 1.0e-12,
    "doc1 BM25 matches SQLite FTS5",
  )

  let h_cjk = idx.search("中")
  debug_assert(h_cjk.length() == 1 && h_cjk[0].doc_id == 1L, "single CJK matches doc1")
  debug_assert(
    abs_f64(h_cjk[0].score - 0.7686825949904529) < 1.0e-12,
    "u_中 BM25 matches SQLite FTS5",
  )

  let h_both = idx.search("hello world")
  debug_assert(h_both.length() == 2, "hello world matches 2 docs")
  debug_assert(h_both[0].doc_id == 4L && h_both[1].doc_id == 1L, "hello world order")
  debug_assert(
    abs_f64(h_both[0].score - 2.5929156472715667e-06) < 1.0e-12,
    "hello world doc4 BM25 matches SQLite FTS5",
  )
  debug_assert(
    abs_f64(h_both[1].score - 1.8144329896907218e-06) < 1.0e-12,
    "hello world doc1 BM25 matches SQLite FTS5",
  )
}

///|
test "index_phrase_prefix_not_and_filters" {
  let idx = Index::new()
  idx.upsert(10L, "quick brown fox jumps over lazy dog", order_key=100L, tags=[("lang", "en"), ("cat", "story")])
  idx.upsert(11L, "brown quick fox runs fast", order_key=200L, tags=[("lang", "en"), ("cat", "story")])
  idx.upsert(12L, "tokenizer tokenizing tokens in Pion", order_key=150L, tags=[("lang", "en"), ("cat", "code")])
  idx.upsert(13L, "全文检索支持中文和代码 GroupSurface #99", order_key=300L, tags=[("lang", "zh"), ("cat", "code")])

  // Phrase must match consecutive tokens only
  let ph = idx.search("\"quick brown\"")
  debug_assert(ph.length() == 1 && ph[0].doc_id == 10L, "phrase matches only adjacent order")

  // Prefix search
  let pref = idx.search("token*")
  debug_assert(pref.length() == 1 && pref[0].doc_id == 12L, "prefix matches tokenizer/tokenizing/tokens")

  // NOT exclusion
  let neg = idx.search("fox NOT lazy")
  debug_assert(neg.length() == 1 && neg[0].doc_id == 11L, "NOT excludes doc 10")

  // Structured tag filters (AND across filters)
  let flt = idx.search("surface", filters=[("lang", "zh"), ("cat", "code")])
  debug_assert(flt.length() == 1 && flt[0].doc_id == 13L, "CamelCase + multi-tag filter")

  let flt_miss = idx.search("surface", filters=[("lang", "en")])
  debug_assert(flt_miss.length() == 0, "tag filter excludes non-matching doc")

  // Empty query with filters returns filtered docs sorted by order_key desc
  let flt_only = idx.search("", filters=[("cat", "code")])
  debug_assert(flt_only.length() == 2, "filter-only matches 2 code docs")
  debug_assert(flt_only[0].doc_id == 13L && flt_only[1].doc_id == 12L, "filter-only sorted by order_key desc")
}

///|
test "index_upsert_remove_and_tie_breaking" {
  let idx = Index::new()
  idx.upsert(1L, "alpha beta", order_key=10L)
  idx.upsert(2L, "alpha beta", order_key=50L)
  idx.upsert(3L, "alpha beta", order_key=50L)

  // Same BM25 score -> higher order_key first, then smaller doc_id first
  let h1 = idx.search("alpha")
  debug_assert(h1.length() == 3, "3 hits")
  debug_assert(h1[0].doc_id == 2L, "doc 2 first (order_key 50, smaller id)")
  debug_assert(h1[1].doc_id == 3L, "doc 3 second (order_key 50, larger id)")
  debug_assert(h1[2].doc_id == 1L, "doc 1 third (order_key 10)")

  // Upsert replaces old tokens
  idx.upsert(2L, "gamma delta", order_key=99L)
  debug_assert(idx.len() == 3, "len unchanged on upsert")
  let h_alpha = idx.search("alpha")
  debug_assert(h_alpha.length() == 2, "doc 2 no longer matches alpha")
  let h_gamma = idx.search("gamma")
  debug_assert(h_gamma.length() == 1 && h_gamma[0].doc_id == 2L, "doc 2 now matches gamma")

  // Remove existing vs non-existing
  debug_assert(idx.remove(2L), "remove existing returns true")
  debug_assert(!idx.remove(2L), "remove again returns false")
  debug_assert(!idx.remove(999L), "remove unknown returns false")
  debug_assert(idx.len() == 2, "len decremented to 2")
  debug_assert(idx.search("gamma").length() == 0, "removed doc gone from postings")

  // Remove all docs -> IDF / avgdl div-by-zero protection
  debug_assert(idx.remove(1L), "remove 1")
  debug_assert(idx.remove(3L), "remove 3")
  debug_assert(idx.len() == 0, "index empty")
  debug_assert(idx.search("alpha").length() == 0, "search on emptied index safe")
}

///|
test "index_edge_cases_and_safety" {
  let idx = Index::with_bm25(-1.0, 2.5) // invalid params sanitized, no panic
  idx.upsert(1L, "") // empty document
  idx.upsert(2L, "   ") // whitespace-only document
  idx.upsert(3L, "valid content here")
  debug_assert(idx.len() == 3, "empty docs still tracked")
  debug_assert(idx.search("valid", limit=0).length() == 0, "limit 0 -> empty")
  debug_assert(idx.search("valid", limit=-5).length() == 0, "negative limit -> empty")
  debug_assert(idx.search("valid", limit=1).length() == 1, "limit 1 -> 1 hit")
  debug_assert(idx.search("").length() == 0, "empty query with no filters -> empty")

  // Very long query with many terms must not panic or hang
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    sb.write_string("term")
    sb.write_string(i.to_string())
    sb.write_string(" ")
    i = i + 1
  }
  let res = idx.search(sb.to_string())
  debug_assert(res.length() == 0, "huge query handled safely")

  // bm25_score safety with zero rows / zero tokens
  debug_assert(bm25_score([1], [1], 5, 0, 0L) == 0.0, "bm25_score zero rows safe")
  debug_assert(bm25_score([1], [1], 0, 1, 0L) == 0.0, "bm25_score zero total_tokens safe")
}
