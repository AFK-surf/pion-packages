///| Red-team regression and adversarial tests for `packages/fts` (see `audit/REDTEAM_AUDIT.md`).
///| SQLite-side expectations were produced with SQLite 3.54.0 FTS5 (`unicode61 tokenchars '_'`)
///| through `audit/difftest.py`.

///|
fn rt_bytes(bs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bs.length() {
    sb.write_byte(bs[i].to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn rt_has(xs : Array[String], s : String) -> Bool {
  let mut i = 0
  while i < xs.length() {
    if xs[i] == s {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn rt_join(xs : Array[String]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string("|")
    }
    sb.write_string(xs[i])
    i = i + 1
  }
  sb.to_string()
}

///| Strict UTF-8 validation (rejects overlong, surrogate and > U+10FFFF forms).
fn rt_valid_utf8(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      i = i + 1
      continue
    }
    let (len, lo, hi) = if b0 >= 0xC2 && b0 <= 0xDF {
      (2, 0x80, 0xBF)
    } else if b0 == 0xE0 {
      (3, 0xA0, 0xBF)
    } else if b0 == 0xED {
      (3, 0x80, 0x9F)
    } else if b0 >= 0xE1 && b0 <= 0xEF {
      (3, 0x80, 0xBF)
    } else if b0 == 0xF0 {
      (4, 0x90, 0xBF)
    } else if b0 == 0xF4 {
      (4, 0x80, 0x8F)
    } else if b0 >= 0xF1 && b0 <= 0xF3 {
      (4, 0x80, 0xBF)
    } else {
      return false
    }
    if i + len > n {
      return false
    }
    let b1 = s.code_unit_at(i + 1)
    if b1 < lo || b1 > hi {
      return false
    }
    let mut k = 2
    while k < len {
      let bk = s.code_unit_at(i + k)
      if (bk & 0xC0) != 0x80 {
        return false
      }
      k = k + 1
    }
    i = i + len
  }
  true
}

///| Check every invariant `snippet` promises: valid UTF-8, sorted disjoint non-empty
///| highlight ranges on character boundaries, and at most `max_chars` codepoints of body.
fn rt_check_snippet(sn : Snippet, max_chars : Int) -> Bool {
  if !rt_valid_utf8(sn.text) {
    return false
  }
  let mut last = -1
  let mut i = 0
  while i < sn.highlights.length() {
    let (lo, hi) = sn.highlights[i]
    if lo < 0 || lo >= hi || hi > sn.text.length() || lo <= last {
      return false
    }
    if !rt_valid_utf8(sn.text.slice(lo, hi)) {
      return false
    }
    last = hi
    i = i + 1
  }
  let body = utf8_codepoints(sn.text)
  let mut cnt = 0
  i = 0
  while i < body.length() {
    if body[i] != 0x2026 {
      cnt = cnt + 1
    }
    i = i + 1
  }
  max_chars <= 0 || cnt <= max_chars
}

///|
fn rt_is_finite(x : Double) -> Bool {
  x == x && x < 1.0e308 && x > -1.0e308
}

///| Validate that `expr` follows the only grammar `fts5_match_expr` may emit:
///| `"tok"`, `"tok tok"` or `"tok"*` clauses joined by ` AND ` / ` NOT `, with `""` escaping.
///| Anything else (bare words, `:` column filters, `^`, `(`, `NEAR`, control bytes) is injection.
fn rt_expr_is_safe(expr : String) -> Bool {
  let n = expr.length()
  if n == 0 {
    return true
  }
  let mut i = 0
  let mut first = true
  while i < n {
    if !first {
      if i + 5 <= n && (expr.slice(i, i + 5) == " AND " || expr.slice(i, i + 5) == " NOT ") {
        i = i + 5
      } else {
        return false
      }
    }
    first = false
    if i >= n || expr.code_unit_at(i) != 34 {
      return false
    }
    i = i + 1
    let mut closed = false
    let mut empty = true
    while i < n {
      let b = expr.code_unit_at(i)
      if b < 0x20 || b == 0x7F {
        return false
      }
      if b == 34 {
        if i + 1 < n && expr.code_unit_at(i + 1) == 34 {
          i = i + 2
          empty = false
          continue
        }
        closed = true
        i = i + 1
        break
      }
      empty = false
      i = i + 1
    }
    if !closed || empty {
      return false
    }
    if i < n && expr.code_unit_at(i) == 42 {
      i = i + 1
    }
  }
  true
}

///|
test "rt1_fold_matches_sqlite_unicode61_remove_diacritics" {
  // Before the fix these tokens were left as `café`, `ÿ`, `ı`, `ς`, which SQLite FTS5 then folded
  // to `cafe`, `y`, `i`, `σ`: the in-memory index and FTS5 returned different documents.
  debug_assert(rt_join(tokenize("Café CAFÉ cafe naïve")) == "cafe|cafe|cafe|naive", "diacritics")
  debug_assert(rt_join(tokenize("Ÿ ÿ ſ İ ı ς Σ")) == "y|y|s|i|ı|σ|σ", "special folds")
  debug_assert(rt_join(tokenize("Æ Ø Þ Đ Ħ Ŀ Ł Œ Ŧ ĸ ŉ ß")) == "æ|ø|þ|đ|ħ|ŀ|ł|œ|ŧ|ĸ|ŉ|ß", "kept letters")
  debug_assert(rt_join(tokenize("Ёлка ΆΈΉ")) == "ёлка|άέή", "Greek/Cyrillic unchanged")
  let idx = Index::new()
  idx.upsert(1L, "Café au lait")
  idx.upsert(2L, "cafe racer")
  idx.upsert(3L, "Ÿpsilon")
  let h = idx.search("CAFÉ")
  debug_assert(h.length() == 2 && h[0].doc_id == 2L && h[1].doc_id == 1L, "café == cafe")
  debug_assert(idx.search("ypsilon").length() == 1, "Ÿ folds to y")
  debug_assert(fts5_match_expr("Naïve CAFÉ") == "\"naive\" AND \"cafe\"", "query folded too")
  // Highlighting follows the same fold.
  let sn = snippet("Un Café noir", "cafe")
  debug_assert(sn.highlights.length() == 1, "café highlighted for cafe")
  let (lo, hi) = sn.highlights[0]
  debug_assert(sn.text.slice(lo, hi) == "Café", "original text highlighted")
}

///|
test "rt2_cjk_marks_and_punctuation_are_separators" {
  // U+30FB / U+30A0 / U+3099..U+309C are not FTS5 token characters: `u_・` became `u_` in SQLite.
  debug_assert(rt_join(tokenize("ア・イ")) == "u_ア|u_イ", "katakana middle dot separates")
  debug_assert(tokenize("・゠゙゚゛゜").length() == 0, "marks alone produce no token")
  debug_assert(rt_join(tokenize("カー")) == "カー|u_カ|u_ー", "prolonged sound mark stays a letter")
  debug_assert(fts5_match_expr("・") == "", "mark-only query is empty")
  debug_assert(fts5_match_expr("ア・イ") == "\"u_ア\" AND \"u_イ\"", "query side split")
}

///|
test "rt3_snippet_huge_max_chars_does_not_overflow" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 40 {
    sb.write_string("a ")
    i = i + 1
  }
  sb.write_string("target zz")
  let text = sb.to_string()
  let limits = [2147483647, 2147483646, 2147483600, 1073741824]
  i = 0
  while i < limits.length() {
    let sn = snippet(text, "target", max_chars=limits[i])
    debug_assert(rt_check_snippet(sn, limits[i]), "invariants at " + limits[i].to_string())
    debug_assert(sn.text == text, "whole text kept at " + limits[i].to_string())
    debug_assert(sn.highlights.length() == 1, "target highlighted at " + limits[i].to_string())
    i = i + 1
  }
}

///|
test "rt4_snippet_phrase_and_pr_needles" {
  let doc = "这是纯Pion全文检索引擎，支持中文。"
  let sn = snippet(doc, "\"全文检索\"")
  debug_assert(sn.highlights.length() == 1, "CJK phrase highlighted")
  let (lo, hi) = sn.highlights[0]
  debug_assert(sn.text.slice(lo, hi) == "全文检索", "CJK phrase exact span")

  let sn2 = snippet("the quick brown fox", "\"quick brown\"")
  let (lo2, hi2) = sn2.highlights[0]
  debug_assert(sn2.text.slice(lo2, hi2) == "quick brown", "ASCII phrase span")

  let sn3 = snippet("merged pr12 and PR2x today", "pr12 PR2x")
  debug_assert(sn3.highlights.length() == 2, "two literal words")
  let (a0, a1) = sn3.highlights[0]
  let (b0, b1) = sn3.highlights[1]
  debug_assert(sn3.text.slice(a0, a1) == "pr12", "literal pr12 fully highlighted")
  debug_assert(sn3.text.slice(b0, b1) == "PR2x", "literal PR2x fully highlighted")

  let sn4 = snippet("see #1234 for details", "#1234")
  let (c0, c1) = sn4.highlights[0]
  debug_assert(sn4.text.slice(c0, c1) == "#1234", "#ref still highlighted")
}

///|
test "rt5_bm25_parameters_never_produce_nan_or_inf" {
  let inf = 1.0e308 * 10.0
  let nan = inf - inf
  let params = [
    (nan, nan),
    (inf, inf),
    (-inf, -inf),
    (-1.0, 2.0),
    (1.0e300, -1.0e300),
    (0.0, 0.0),
    (100.0, 1.0),
  ]
  let mut i = 0
  while i < params.length() {
    let (k1, b) = params[i]
    let s = bm25_score([3, 1], [1, 2], 7, 4, 20L, k1~, b~)
    debug_assert(rt_is_finite(s) && s >= 0.0, "bm25_score finite #" + i.to_string())
    let idx = Index::with_bm25(k1, b)
    idx.upsert(1L, "alpha beta alpha")
    idx.upsert(2L, "alpha")
    idx.upsert(3L, "gamma")
    let hits = idx.search("alpha")
    debug_assert(hits.length() == 2, "two hits #" + i.to_string())
    let mut j = 0
    while j < hits.length() {
      debug_assert(rt_is_finite(hits[j].score), "search score finite #" + i.to_string())
      j = j + 1
    }
    i = i + 1
  }
  // Out-of-range k1 is clamped, not reset: k1 = 150 behaves exactly like k1 = 100.
  let a = Index::with_bm25(150.0, 0.5)
  let b = Index::with_bm25(100.0, 0.5)
  a.upsert(1L, "x x y")
  b.upsert(1L, "x x y")
  a.upsert(2L, "z")
  b.upsert(2L, "z")
  debug_assert(a.search("x")[0].score == b.search("x")[0].score, "k1 clamped to 100")
  // Hostile direct inputs to `bm25_score`.
  debug_assert(rt_is_finite(bm25_score([5], [9], -10, 2, 4L)), "negative doc_len, df > rows")
  debug_assert(rt_is_finite(bm25_score([-3, 2], [-1, 0], 3, 1, 1L)), "negative tf/df")
  debug_assert(bm25_score([], [], 3, 1, 1L) == 0.0, "no terms")
}

///|
fn rt_next(seed : Int64) -> Int64 {
  (seed * 6364136223846793005L + 1442695040888963407L) & 0x7FFFFFFFFFFFFFFFL
}

///|
fn rt_same_hits(a : Array[Hit], b : Array[Hit]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    let d = a[i].score - b[i].score
    if a[i].doc_id != b[i].doc_id || a[i].order_key != b[i].order_key {
      return false
    }
    if d > 1.0e-12 || d < -1.0e-12 || !rt_is_finite(a[i].score) {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "rt_index_churn_equals_fresh_rebuild" {
  // 600 random upserts (text / tags / empty text) and removes (including unknown ids) on a
  // live index must leave it indistinguishable from an index built from the final state alone:
  // no stale postings, no drifted `total_tokens`, no negative `df`.
  let words = [
    "alpha", "beta", "GammaRay", "nc_follow", "中文检索", "#42", "deadbeef1234", "Café", "", "alpha alpha",
  ]
  let live = Index::new()
  let final_text : Map[Int64, String] = Map::new()
  let final_tags : Map[Int64, Array[(String, String)]] = Map::new()
  let mut seed = 7L
  let mut step = 0
  while step < 600 {
    seed = rt_next(seed)
    let id = ((seed >> 20) % 12L).to_int64()
    let op = ((seed >> 8) % 5L).to_int()
    if op == 0 {
      let _ = live.remove(id)
      final_text.remove(id)
      final_tags.remove(id)
    } else {
      let sb = StringBuilder::new()
      let nw = ((seed >> 30) % 6L).to_int()
      let mut w = 0
      while w < nw {
        seed = rt_next(seed)
        sb.write_string(words[((seed >> 16) % 10L).to_int()])
        sb.write_string(" ")
        w = w + 1
      }
      let tags = if op == 1 { [("k", "a"), ("k", "b")] } else { [("k", "a")] }
      live.upsert(id, sb.to_string(), tags~)
      final_text.set(id, sb.to_string())
      final_tags.set(id, tags)
    }
    step = step + 1
  }
  let fresh = Index::new()
  let ids = final_text.keys()
  let mut i = 0
  while i < ids.length() {
    let t = match final_text.get(ids[i]) {
      Some(v) => v
      None => ""
    }
    let tg = match final_tags.get(ids[i]) {
      Some(v) => v
      None => []
    }
    fresh.upsert(ids[i], t, tags=tg)
    i = i + 1
  }
  debug_assert(live.len() == fresh.len(), "same doc count")
  debug_assert(live.total_tokens == fresh.total_tokens, "same total_tokens")
  debug_assert(live.postings.length() == fresh.postings.length(), "no stale vocabulary")
  let qs = [
    "alpha", "beta", "gamma", "ray", "nc_follow", "中文", "检索", "#42", "deadbeef", "cafe", "al*",
    "\"alpha alpha\"", "alpha NOT beta", "NOT alpha", "gam*",
  ]
  i = 0
  while i < qs.length() {
    debug_assert(rt_same_hits(live.search(qs[i]), fresh.search(qs[i])), "same hits for " + qs[i])
    debug_assert(
      rt_same_hits(
        live.search(qs[i], filters=[("k", "b")]),
        fresh.search(qs[i], filters=[("k", "b")]),
      ),
      "same filtered hits for " + qs[i],
    )
    i = i + 1
  }
  // Remove everything: index is empty and safe to query.
  i = 0
  while i < 12 {
    let _ = live.remove(i.to_int64())
    i = i + 1
  }
  debug_assert(live.len() == 0 && live.total_tokens == 0L, "emptied")
  debug_assert(live.postings.length() == 0, "no postings left")
  debug_assert(live.search("alpha").length() == 0, "empty search")
  debug_assert(live.search("NOT alpha", filters=[("k", "a")]).length() == 0, "empty filter")
}

///|
test "rt_upsert_replace_text_and_tags" {
  let idx = Index::new()
  idx.upsert(1L, "secret alpha", tags=[("acl", "private")])
  idx.upsert(1L, "public beta", tags=[("acl", "public")])
  debug_assert(idx.search("secret").length() == 0, "old text gone")
  debug_assert(idx.search("beta", filters=[("acl", "private")]).length() == 0, "old tag gone")
  debug_assert(idx.search("beta", filters=[("acl", "public")]).length() == 1, "new tag")
  idx.upsert(1L, "")
  debug_assert(idx.len() == 1 && idx.total_tokens == 0L, "empty replacement keeps doc")
  debug_assert(idx.search("beta").length() == 0, "no stale term")
  debug_assert(idx.postings.length() == 0, "no stale posting")
  debug_assert(!idx.remove(2L), "unknown id")
  debug_assert(idx.remove(1L) && !idx.remove(1L), "double remove")
}

///|
test "rt_tag_filters_never_leak" {
  let idx = Index::new()
  idx.upsert(1L, "doc", tags=[("team", "a"), ("team", "b")])
  idx.upsert(2L, "doc", tags=[("team", "a")])
  idx.upsert(3L, "doc", tags=[("", "")])
  idx.upsert(4L, "doc")
  debug_assert(idx.search("doc", filters=[("team", "b")]).length() == 1, "multi-valued tag")
  let both = idx.search("doc", filters=[("team", "a"), ("team", "b")])
  debug_assert(both.length() == 1 && both[0].doc_id == 1L, "filters are AND")
  let empty = idx.search("doc", filters=[("", "")])
  debug_assert(empty.length() == 1 && empty[0].doc_id == 3L, "empty key/value exact")
  debug_assert(idx.search("doc", filters=[("team", "c")]).length() == 0, "no match no leak")
  debug_assert(idx.search("doc", filters=[("Team", "a")]).length() == 0, "case-sensitive key")
  debug_assert(idx.search("doc", filters=[("team", "a ")]).length() == 0, "no trimming")
  // NOT-only / empty query: filter browse, still filtered and still excluding.
  let neg = idx.search("NOT doc", filters=[("team", "a")])
  debug_assert(neg.length() == 0, "NOT excludes inside filter browse")
  debug_assert(idx.search("NOT nothing").length() == 0, "NOT-only without filters is empty")
  let browse = idx.search("NOT nothing", filters=[("team", "a")])
  debug_assert(browse.length() == 2, "NOT-only + filter lists filtered docs")
}

///|
test "rt_limits_phrases_and_query_blowup" {
  let idx = Index::new()
  idx.upsert(1L, "quick brown fox")
  idx.upsert(2L, "brown quick fox")
  idx.upsert(3L, "foo foo foo")
  idx.upsert(4L, "中文 foo")
  debug_assert(idx.search("fox", limit=2147483647).length() == 2, "huge limit")
  debug_assert(idx.search("fox", limit=-2147483647).length() == 0, "very negative limit")
  let p = idx.search("\"quick brown\"")
  debug_assert(p.length() == 1 && p[0].doc_id == 1L, "phrase order respected")
  debug_assert(idx.search("\"fox quick\"").length() == 0, "no cross-doc phrase")
  debug_assert(idx.search("\"foo foo foo foo\"").length() == 0, "phrase longer than run")
  debug_assert(idx.search("\"foo foo\"").length() == 1, "repeated-word phrase")
  debug_assert(idx.search("\"文 foo\"").length() == 1, "CJK unigram then ASCII phrase")
  debug_assert(idx.search("\"中 foo\"").length() == 0, "non-adjacent CJK char")
  // 2,000-word query, 1,000 phrases, 1,000 prefixes: capped and bounded.
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 1000 {
    sb.write_string("\"quick brown\" q")
    sb.write_string(i.to_string())
    sb.write_string("* ")
    i = i + 1
  }
  let big = sb.to_string()
  debug_assert(tokenize_query(big).length() <= 64, "query terms capped at 64")
  debug_assert(idx.search(big).length() == 0, "blowup query safe")
  debug_assert(rt_expr_is_safe(fts5_match_expr(big)), "blowup expr well-formed")
  // Deep prefix: a single-letter prefix over the whole vocabulary.
  let pf = idx.search("f*")
  debug_assert(pf.length() == 4, "prefix over vocab")
}

///|
test "rt_fts5_match_expr_injection_corpus" {
  let attacks = [
    "\"", "\"\"", "\"\"\"", "'", "''", "(", ")", "(foo", "foo)", "*", "**", "foo**", "*foo", "^foo",
    "foo^", "NEAR(a b)", "NEAR", "a NEAR b", "AND", "OR", "NOT", "NOT NOT", "NOT NOT NOT foo",
    "foo NOT", "foo AND", "OR foo", "a OR b", "col:foo", "body:foo", "{body}:foo", "- foo", "-foo",
    "+foo", ":", "::", "a:b:c", "foo\"bar", "\"foo bar", "\"unclosed NOT", "foo* bar*", "\\",
    "\\\"", "%", "_", "__", "___*", "#", "#*", "#1*", "x\u{0}y", "\u{1}\u{2}\u{7f}", "\t\n\r",
    "，。！？", "・", "🚀", "🚀*", "\u{3000}foo\u{3000}", "NOT \"a b\"", "\"NOT\"", "\"AND\" \"OR\"",
    "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0", "deadbeef1*",
  ]
  let mut i = 0
  while i < attacks.length() {
    let e = fts5_match_expr(attacks[i])
    debug_assert(rt_expr_is_safe(e), "well-formed MATCH for attack #" + i.to_string() + ": " + e)
    i = i + 1
  }
  // Malformed UTF-8 queries are also safe.
  let bad = [
    rt_bytes([0xC0, 0xAF]),
    rt_bytes([0xE0, 0x80, 0xAF]),
    rt_bytes([0xED, 0xA0, 0x80, 0x61]),
    rt_bytes([0xF4, 0x90, 0x80, 0x80]),
    rt_bytes([0xF8, 0x88, 0x80, 0x80, 0x80]),
    rt_bytes([0x22, 0xE4, 0xB8, 0x22, 0x2A]),
    rt_bytes([0x66, 0x6F, 0x6F, 0xFF, 0x2A]),
  ]
  i = 0
  while i < bad.length() {
    debug_assert(rt_expr_is_safe(fts5_match_expr(bad[i])), "malformed query #" + i.to_string())
    i = i + 1
  }
  debug_assert(fts5_match_expr("col:foo") == "\"col\" AND \"foo\"", "no column filter")
  debug_assert(fts5_match_expr("NEAR(a b)") == "\"near\" AND \"a\" AND \"b\"", "NEAR is a word")
  debug_assert(fts5_match_expr("foo OR bar") == "\"foo\" AND \"or\" AND \"bar\"", "OR is a word")
  debug_assert(fts5_match_expr("NOT NOT foo") == "\"foo\" NOT \"not\"", "NOT NOT")
}

///|
test "rt_malformed_utf8_snippets_and_tokens" {
  let pieces = [
    rt_bytes([0xC0, 0xAF]),
    rt_bytes([0xC1, 0xBF]),
    rt_bytes([0xE0, 0x80, 0xAF]),
    rt_bytes([0xED, 0xA0, 0x80]),
    rt_bytes([0xED, 0xBF, 0xBF]),
    rt_bytes([0xF4, 0x90, 0x80, 0x80]),
    rt_bytes([0xF5, 0x80, 0x80, 0x80]),
    rt_bytes([0xE4, 0xB8]),
    rt_bytes([0xF0, 0x9F, 0x9A]),
    rt_bytes([0x80]),
    rt_bytes([0xFF]),
    "🚀",
    "中文",
    "检索",
    "Ünïcödé",
    "target",
    " ",
  ]
  let mut seed = 99L
  let mut round = 0
  while round < 300 {
    let sb = StringBuilder::new()
    let mut k = 0
    seed = rt_next(seed)
    let len = ((seed >> 24) % 40L).to_int()
    while k < len {
      seed = rt_next(seed)
      sb.write_string(pieces[((seed >> 16) % 17L).to_int()])
      k = k + 1
    }
    let text = sb.to_string()
    let toks = tokenize(text)
    let mut t = 0
    while t < toks.length() {
      debug_assert(rt_valid_utf8(toks[t]) && toks[t].length() > 0, "token valid UTF-8")
      t = t + 1
    }
    debug_assert(rt_valid_utf8(fts5_index_text(text)), "index text valid UTF-8")
    let mc = ((seed >> 40) % 30L).to_int() + 1
    let qs = ["target", "中文检索", "unicode", "\"检索 target\"", "ta*", "🚀"]
    let mut q = 0
    while q < qs.length() {
      debug_assert(rt_check_snippet(snippet(text, qs[q], max_chars=mc), mc), "snippet invariants")
      q = q + 1
    }
    round = round + 1
  }
  debug_assert(rt_join(tokenize(rt_bytes([0xED, 0xA0, 0x80, 0x61]))) == "a", "surrogate dropped")
  debug_assert(rt_join(tokenize(rt_bytes([0xC0, 0xC1, 0x62]))) == "b", "overlong dropped")
  debug_assert(rt_join(tokenize(rt_bytes([0xF4, 0x90, 0x80, 0x80, 0x63]))) == "c", "> U+10FFFF dropped")
}
