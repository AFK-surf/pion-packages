///|
test "invalid__encoding__bad_utf8_in_string_literal" {
  assert_toml_invalid_bytes("invalid/encoding/bad-utf8-in-string-literal.toml", [35, 32, 84, 104, 101, 32, 102, 111, 108, 108, 111, 119, 105, 110, 103, 32, 108, 105, 110, 101, 32, 99, 111, 110, 116, 97, 105, 110, 115, 32, 97, 110, 32, 105, 110, 118, 97, 108, 105, 100, 32, 85, 84, 70, 45, 56, 32, 115, 101, 113, 117, 101, 110, 99, 101, 46, 10, 98, 97, 100, 32, 61, 32, 39, 195, 39, 10])
