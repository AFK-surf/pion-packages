///| Official toml-test v1.0.0 invalid compliance suite (1..169 of 509).

///|
test "invalid__array__double_comma_01" {
  assert_toml_invalid("invalid/array/double-comma-01.toml", "double-comma-01 = [1,,2]\n")
}

///|
test "invalid__array__double_comma_02" {
  assert_toml_invalid("invalid/array/double-comma-02.toml", "double-comma-02 = [1,2,,]\n")
}

///|
test "invalid__array__extend_defined_aot" {
  assert_toml_invalid("invalid/array/extend-defined-aot.toml", "[[tab.arr]]\n[tab]\narr.val1=1\n")
}

///|
test "invalid__array__extending_table" {
  assert_toml_invalid("invalid/array/extending-table.toml", "a = [{ b = 1 }]\n\n# Cannot extend tables within static arrays\n# https://github.com/toml-lang/toml/issues/908\n[a.c]\nfoo = 1\n")
}

///|
test "invalid__array__missing_separator_01" {
  assert_toml_invalid("invalid/array/missing-separator-01.toml", "arrr = [true false]\n")
}

///|
test "invalid__array__missing_separator_02" {
  assert_toml_invalid("invalid/array/missing-separator-02.toml", "wrong = [ 1 2 3 ]\n")
}

///|
test "invalid__array__no_close_01" {
  assert_toml_invalid("invalid/array/no-close-01.toml", "no-close-01 = [ 1, 2, 3\n")
}

///|
test "invalid__array__no_close_02" {
  assert_toml_invalid("invalid/array/no-close-02.toml", "no-close-02 = [1,\n")
}

///|
test "invalid__array__no_close_03" {
  assert_toml_invalid("invalid/array/no-close-03.toml", "no-close-03 = [42 #]\n")
}

///|
test "invalid__array__no_close_04" {
  assert_toml_invalid("invalid/array/no-close-04.toml", "no-close-04 = [{ key = 42\n")
}

///|
test "invalid__array__no_close_05" {
  assert_toml_invalid("invalid/array/no-close-05.toml", "no-close-05 = [{ key = 42}\n")
}

///|
test "invalid__array__no_close_06" {
  assert_toml_invalid("invalid/array/no-close-06.toml", "no-close-06 = [{ key = 42 #}]\n")
}

///|
test "invalid__array__no_close_07" {
  assert_toml_invalid("invalid/array/no-close-07.toml", "no-close-07 = [{ key = 42} #]\n")
}

///|
test "invalid__array__no_close_08" {
  assert_toml_invalid("invalid/array/no-close-08.toml", "no-close-08 = [\n")
}

///|
test "invalid__array__no_close_table_01" {
  assert_toml_invalid("invalid/array/no-close-table-01.toml", "no-close-table-01 = [{ key = 42\n")
}

///|
test "invalid__array__no_close_table_02" {
  assert_toml_invalid("invalid/array/no-close-table-02.toml", "no-close-table-02 = [{ key = 42 #\n")
}

///|
test "invalid__array__no_close_table_03" {
  assert_toml_invalid("invalid/array/no-close-table-03.toml", "no-close-table-03 = [1,{a=1]\n")
}

///|
test "invalid__array__no_close_table_04" {
  assert_toml_invalid("invalid/array/no-close-table-04.toml", "no-close-table-04 = [1,{2]\n")
}

///|
test "invalid__array__no_comma_01" {
  assert_toml_invalid("invalid/array/no-comma-01.toml", "no-comma-01 = [true false]\n")
}

///|
test "invalid__array__no_comma_02" {
  assert_toml_invalid("invalid/array/no-comma-02.toml", "no-comma-02 = [ 1 2 3 ]\n")
}

///|
test "invalid__array__no_comma_03" {
  assert_toml_invalid("invalid/array/no-comma-03.toml", "no-comma-03 = [ 1 #,]\n")
}

///|
test "invalid__array__only_comma_01" {
  assert_toml_invalid("invalid/array/only-comma-01.toml", "only-comma-01 = [,]\n")
}

///|
test "invalid__array__only_comma_02" {
  assert_toml_invalid("invalid/array/only-comma-02.toml", "only-comma-02 = [,,]\n")
}

///|
test "invalid__array__tables_01" {
  assert_toml_invalid("invalid/array/tables-01.toml", "# INVALID TOML DOC\nfruit = []\n\n[[fruit]] # Not allowed\n")
}

///|
test "invalid__array__tables_02" {
  assert_toml_invalid("invalid/array/tables-02.toml", "# INVALID TOML DOC\n[[fruit]]\n  name = \"apple\"\n\n  [[fruit.variety]]\n    name = \"red delicious\"\n\n  # This table conflicts with the previous table\n  [fruit.variety]\n    name = \"granny smith\"\n")
}

///|
test "invalid__array__text_after_array_entries" {
  assert_toml_invalid("invalid/array/text-after-array-entries.toml", "array = [\n  \"Is there life after an array separator?\", No\n  \"Entry\"\n]\n")
}

///|
test "invalid__array__text_before_array_separator" {
  assert_toml_invalid("invalid/array/text-before-array-separator.toml", "array = [\n  \"Is there life before an array separator?\" No,\n  \"Entry\"\n]\n")
}

///|
test "invalid__array__text_in_array" {
  assert_toml_invalid("invalid/array/text-in-array.toml", "array = [\n  \"Entry 1\",\n  I don't belong,\n  \"Entry 2\",\n]\n")
}

