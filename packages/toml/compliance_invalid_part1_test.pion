}

///|
test "invalid__encoding__bad_utf8_in_array" {
  assert_toml_invalid_bytes("invalid/encoding/bad-utf8-in-array.toml", [35, 32, 104, 116, 116, 112, 115, 58, 47, 47, 103, 105, 116, 104, 117, 98, 46, 99, 111, 109, 47, 109, 97, 114, 122, 101, 114, 47, 116, 111, 109, 108, 112, 108, 117, 115, 112, 108, 117, 115, 47, 105, 115, 115, 117, 101, 115, 47, 49, 48, 48, 10, 102, 108, 32, 61, 91, 32, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 54, 128, 134, 0, 0, 0, 45, 54, 194, 159, 32, 0])
}

