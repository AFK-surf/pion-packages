///|
test "invalid__datetime__only_T" {
  assert_toml_invalid("invalid/datetime/only-T.toml", "foo = T\n")
}

///|
test "invalid__datetime__only_TZ" {
  assert_toml_invalid("invalid/datetime/only-TZ.toml", "foo = TZ\n")
}

///|
test "invalid__datetime__only_Tdot" {
  assert_toml_invalid("invalid/datetime/only-Tdot.toml", "foo = T.\n")
}

///|
test "invalid__datetime__second_over" {
  assert_toml_invalid("invalid/datetime/second-over.toml", "# time-second     = 2DIGIT  ; 00-58, 00-59, 00-60 based on leap second\n#                           ; rules\nd = 2006-01-01T00:00:61-00:00\n")
}

///|
test "invalid__datetime__second_trailing_dot" {
  assert_toml_invalid("invalid/datetime/second-trailing-dot.toml", "foo = 1997-09-09T09:09:09.\n")
}

///|
test "invalid__datetime__second_trailing_dotz" {
  assert_toml_invalid("invalid/datetime/second-trailing-dotz.toml", "foo = 2016-09-09T09:09:09.Z\n")
}

///|
test "invalid__datetime__time_no_leads" {
  assert_toml_invalid("invalid/datetime/time-no-leads.toml", "# Leading 0 is always required.\nd = 2023-10-01T1:32:00Z\n")
}

///|
test "invalid__datetime__trailing_x" {
  assert_toml_invalid("invalid/datetime/trailing-x.toml", "sign=2020-01-01x\n")
}

///|
test "invalid__datetime__y10k_date" {
  assert_toml_invalid("invalid/datetime/y10k-date.toml", "# Maximum RFC3399 year is 9999.\nd = 10000-01-01\n")
}

///|
test "invalid__datetime__y10k_datetime" {
  assert_toml_invalid("invalid/datetime/y10k-datetime.toml", "# Maximum RFC3399 year is 9999.\nd = 10000-01-01 00:00:00z\n")
}

///|
test "invalid__encoding__bad_codepoint" {
  assert_toml_invalid_bytes("invalid/encoding/bad-codepoint.toml", [35, 32, 73, 110, 118, 97, 108, 105, 100, 32, 99, 111, 100, 101, 112, 111, 105, 110, 116, 32, 85, 43, 68, 56, 48, 48, 32, 58, 32, 237, 160, 128, 10])
}

