///|
test "invalid__encoding__bom_not_at_start_01" {
  assert_toml_invalid("invalid/encoding/bom-not-at-start-01.toml", "# Contains UTF-8 BOM between = and 1\na=﻿1\n")
}

///|
test "invalid__encoding__bom_not_at_start_02" {
  assert_toml_invalid("invalid/encoding/bom-not-at-start-02.toml", "﻿﻿# Contains two UTF-8 BOMS at the start\na=1\n")
}

///|
test "invalid__encoding__bom_not_at_start_03" {
  assert_toml_invalid("invalid/encoding/bom-not-at-start-03.toml", "﻿﻿a=1\n# Contains two UTF-8 BOMS at the start\n")
}

///|
test "invalid__encoding__ideographic_space" {
  assert_toml_invalid("invalid/encoding/ideographic-space.toml", "# First on next line is U+3000 IDEOGRAPHIC SPACE\n　foo = \"bar\"\n")
}

///|
test "invalid__encoding__utf16_bom" {
  assert_toml_invalid_bytes("invalid/encoding/utf16-bom.toml", [254, 255, 0, 35, 0, 32, 0, 85, 0, 84, 0, 70, 0, 45, 0, 49, 0, 54, 0, 32, 0, 119, 0, 105, 0, 116, 0, 104, 0, 32, 0, 66, 0, 79, 0, 77, 0, 10])
}

///|
test "invalid__encoding__utf16_comment" {
  assert_toml_invalid("invalid/encoding/utf16-comment.toml", str_from_bytes([0, 35, 0, 32, 0, 85, 0, 84, 0, 70, 0, 45, 0, 49, 0, 54, 0, 32, 0, 119, 0, 105, 0, 116, 0, 104, 0, 111, 0, 117, 0, 116, 0, 32, 0, 66, 0, 79, 0, 77, 0, 10]))
}

///|
test "invalid__encoding__utf16_key" {
  assert_toml_invalid("invalid/encoding/utf16-key.toml", str_from_bytes([0, 107, 0, 32, 0, 61, 0, 32, 0, 34, 0, 118, 0, 34, 0, 10]))
}

///|
test "invalid__float__arabic_zero_01" {
  assert_toml_invalid("invalid/float/arabic-zero-01.toml", "arabic-zero-01 = 1.٠\n")
}

///|
test "invalid__float__arabic_zero_02" {
  assert_toml_invalid("invalid/float/arabic-zero-02.toml", "arabic-zero-02 = ٠\n")
}

///|
test "invalid__float__arabic_zero_03" {
  assert_toml_invalid("invalid/float/arabic-zero-03.toml", "arabic-zero-03 = 1e٠\n")
}

///|
test "invalid__float__arabic_zero_04" {
  assert_toml_invalid("invalid/float/arabic-zero-04.toml", "arabic-zero-04 = +٠\n")
}

///|
test "invalid__float__double_dot_01" {
  assert_toml_invalid("invalid/float/double-dot-01.toml", "double-dot-01 = 0..1\n")
}

///|
test "invalid__float__double_dot_02" {
  assert_toml_invalid("invalid/float/double-dot-02.toml", "double-dot-02 = 0.1.2\n")
}

///|
test "invalid__float__exp_dot_01" {
  assert_toml_invalid("invalid/float/exp-dot-01.toml", "exp-dot-01 = 1e2.3\n")
}

///|
test "invalid__float__exp_dot_02" {
  assert_toml_invalid("invalid/float/exp-dot-02.toml", "exp-dot-02 = 1.e2\n")
}

///|
test "invalid__float__exp_dot_03" {
  assert_toml_invalid("invalid/float/exp-dot-03.toml", "exp-dot-03 = 3.e+20\n")
}

///|
test "invalid__float__exp_double_e_01" {
  assert_toml_invalid("invalid/float/exp-double-e-01.toml", "exp-double-e-01 = 1ee2\n")
}

///|
test "invalid__float__exp_double_e_02" {
  assert_toml_invalid("invalid/float/exp-double-e-02.toml", "exp-double-e-02 = 1e2e3\n")
}

///|
test "invalid__float__exp_double_sign_01" {
  assert_toml_invalid("invalid/float/exp-double-sign-01.toml", "exp-double-sign-01 = 1e++23\n")
}

///|
test "invalid__float__exp_double_sign_02" {
  assert_toml_invalid("invalid/float/exp-double-sign-02.toml", "exp-double-sign-02 = 1e--23\n")
}

///|
test "invalid__float__exp_double_us" {
  assert_toml_invalid("invalid/float/exp-double-us.toml", "exp-double-us = 1e__23\n")
}

///|
test "invalid__float__exp_leading_us" {
  assert_toml_invalid("invalid/float/exp-leading-us.toml", "exp-leading-us = 1e_23\n")
}

///|
test "invalid__float__exp_trailing_us" {
  assert_toml_invalid("invalid/float/exp-trailing-us.toml", "exp-trailing-us = 1e23_\n")
}

///|
test "invalid__float__exp_trailing_us_01" {
  assert_toml_invalid("invalid/float/exp-trailing-us-01.toml", "exp-trailing-us-01 = 1_e2\n")
}

///|
test "invalid__float__exp_trailing_us_02" {
  assert_toml_invalid("invalid/float/exp-trailing-us-02.toml", "exp-trailing-us-02 = 1.2_e2\n")
}

