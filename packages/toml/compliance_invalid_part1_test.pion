///|
test "invalid__datetime__day_zero" {
  assert_toml_invalid("invalid/datetime/day-zero.toml", "foo = 1997-09-00T09:09:09.09Z\n")
}

///|
test "invalid__datetime__feb_29" {
  assert_toml_invalid("invalid/datetime/feb-29.toml", "\"not a leap year\" = 2100-02-29T15:15:15Z\n")
}

///|
test "invalid__datetime__feb_30" {
  assert_toml_invalid("invalid/datetime/feb-30.toml", "\"only 28 or 29 days in february\" = 1988-02-30T15:15:15Z\n")
}

///|
test "invalid__datetime__hour_over" {
  assert_toml_invalid("invalid/datetime/hour-over.toml", "# time-hour       = 2DIGIT  ; 00-23\nd = 2006-01-01T24:00:00-00:00\n")
}

///|
test "invalid__datetime__leading_zero_date" {
  assert_toml_invalid("invalid/datetime/leading-zero-date.toml", "# No leading zero on year allowed.\nd = 02026-05-07\n")
}

///|
test "invalid__datetime__leading_zero_datetime" {
  assert_toml_invalid("invalid/datetime/leading-zero-datetime.toml", "# No leading zero on year allowed.\nd = 02026-05-07T14:15:16Z\n")
}

///|
test "invalid__datetime__mday_over" {
  assert_toml_invalid("invalid/datetime/mday-over.toml", "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-32T00:00:00-00:00\n")
}

///|
test "invalid__datetime__mday_under" {
  assert_toml_invalid("invalid/datetime/mday-under.toml", "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-00T00:00:00-00:00\n")
}

///|
test "invalid__datetime__minute_over" {
  assert_toml_invalid("invalid/datetime/minute-over.toml", "# time-minute     = 2DIGIT  ; 00-59\nd = 2006-01-01T00:60:00-00:00\n")
}

///|
test "invalid__datetime__month_over" {
  assert_toml_invalid("invalid/datetime/month-over.toml", "# date-month      = 2DIGIT  ; 01-12\nd = 2006-13-01T00:00:00-00:00\n")
}

///|
test "invalid__datetime__month_under" {
  assert_toml_invalid("invalid/datetime/month-under.toml", "# date-month      = 2DIGIT  ; 01-12\nd = 2007-00-01T00:00:00-00:00\n")
}

///|
test "invalid__datetime__no_date_time_sep" {
  assert_toml_invalid("invalid/datetime/no-date-time-sep.toml", "foo = 1997-09-0909:09:09\n")
}

///|
test "invalid__datetime__no_leads" {
  assert_toml_invalid("invalid/datetime/no-leads.toml", "# Month \"7\" instead of \"07\"; the leading zero is required.\nno-leads = 1987-7-05T17:45:00Z\n")
}

///|
test "invalid__datetime__no_leads_month" {
  assert_toml_invalid("invalid/datetime/no-leads-month.toml", "# Month \"7\" instead of \"07\"; the leading zero is required.\nno-leads = 1987-7-05T17:45:00Z\n")
}

///|
test "invalid__datetime__no_leads_with_milli" {
  assert_toml_invalid("invalid/datetime/no-leads-with-milli.toml", "# Day \"5\" instead of \"05\"; the leading zero is required.\nwith-milli = 1987-07-5T17:45:00.12Z\n")
}

///|
test "invalid__datetime__no_mins" {
  assert_toml_invalid("invalid/datetime/no-mins.toml", "# No seconds nor minutes in time.\nno-mins = 1987-07-05T17Z\n")
}

///|
test "invalid__datetime__no_secs" {
  assert_toml_invalid("invalid/datetime/no-secs.toml", "# No seconds in time.\nno-secs = 1987-07-05T17:45Z\n")
}

///|
test "invalid__datetime__no_t" {
  assert_toml_invalid("invalid/datetime/no-t.toml", "# No \"t\" or \"T\" between the date and time.\nno-t = 1987-07-0517:45:00Z\n")
}

