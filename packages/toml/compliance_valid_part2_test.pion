///| Official toml-test v1.0.0 valid compliance suite (105..208 of 208).

///|
test "valid__key__special_word" {
  assert_toml_valid("valid/key/special-word.toml", "false = false\ntrue = 1\ninf = 100000000\nnan = \"ceci n'est pas un nombre\"\n\n", "{\"false\":{\"type\":\"bool\",\"value\":\"false\"},\"inf\":{\"type\":\"integer\",\"value\":\"100000000\"},\"nan\":{\"type\":\"string\",\"value\":\"ceci n'est pas un nombre\"},\"true\":{\"type\":\"integer\",\"value\":\"1\"}}")
}

///|
test "valid__key__start" {
  assert_toml_valid("valid/key/start.toml", "# Table and keys can start with any character; there is no requirement for it to\n# start with a letter.\n\n[-key]\n-key = 1\n\n[_key]\n_key = 2\n\n[1key]\n1key = 3\n\n[-]\n- = 4\n\n[_]\n_ = 5\n\n[1] \n1 = 6\n\n[---] \n--- = 7\n\n[___]\n___ = 8\n\n[111]\n111 = 9\n\n[inline]\n--- = {--- = 10, ___ = 11, 111 = 12}\n", "{\"-\":{\"-\":{\"type\":\"integer\",\"value\":\"4\"}},\"---\":{\"---\":{\"type\":\"integer\",\"value\":\"7\"}},\"-key\":{\"-key\":{\"type\":\"integer\",\"value\":\"1\"}},\"1\":{\"1\":{\"type\":\"integer\",\"value\":\"6\"}},\"111\":{\"111\":{\"type\":\"integer\",\"value\":\"9\"}},\"1key\":{\"1key\":{\"type\":\"integer\",\"value\":\"3\"}},\"_\":{\"_\":{\"type\":\"integer\",\"value\":\"5\"}},\"___\":{\"___\":{\"type\":\"integer\",\"value\":\"8\"}},\"_key\":{\"_key\":{\"type\":\"integer\",\"value\":\"2\"}},\"inline\":{\"---\":{\"---\":{\"type\":\"integer\",\"value\":\"10\"},\"111\":{\"type\":\"integer\",\"value\":\"12\"},\"___\":{\"type\":\"integer\",\"value\":\"11\"}}}}")
}

///|
test "valid__key__zero" {
  assert_toml_valid("valid/key/zero.toml", "0=0\n", "{\"0\":{\"type\":\"integer\",\"value\":\"0\"}}")
}

///|
test "valid__multibyte" {
  assert_toml_valid("valid/multibyte.toml", "# Test multibyte throughout\n\n# Tèƨƭ ƒïℓè ƒôř TÓM£\n# Óñℓ¥ ƭλïƨ ôñè ƭřïèƨ ƭô è₥úℓáƭè á TÓM£ ƒïℓè ωřïƭƭèñ β¥ á úƨèř ôƒ ƭλè ƙïñδ ôƒ ƥářƨèř ωřïƭèřƨ ƥřôβáβℓ¥ λáƭè\n\n['𝐭𝐛𝐥']\nstring = \"𝓼𝓽𝓻𝓲𝓷𝓰 - #\"          # \" 𝓼𝓽𝓻𝓲𝓷𝓰\n\t['𝐭𝐛𝐥'.sub]\n\t'𝕒𝕣𝕣𝕒𝕪' = [ \"] \", \" # \"]      # ] 𝓪𝓻𝓻𝓪𝔂\n\t'𝕒𝕣𝕣𝕒𝕪𝟚' = [ \"Tèƨƭ #11 ]ƥřôƲèδ ƭλáƭ\", \"Éжƥèřï₥èñƭ #9 ωáƨ á ƨúççèƨƨ\" ]\n\t# Ýôú δïδñ'ƭ ƭλïñƙ ïƭ'δ áƨ èáƨ¥ áƨ çλúçƙïñϱ ôúƭ ƭλè ℓáƨƭ #, δïδ ¥ôú?\n\tanother_test_string = \"§á₥è ƭλïñϱ, βúƭ ωïƭλ á ƨƭřïñϱ #\"\n\tescapes = \" Âñδ ωλèñ \\\"'ƨ ářè ïñ ƭλè ƨƭřïñϱ, áℓôñϱ ωïƭλ # \\\"\"   # \"áñδ çô₥₥èñƭƨ ářè ƭλèřè ƭôô\"\n\t# Tλïñϱƨ ωïℓℓ ϱèƭ λářδèř\n\t\t['𝐭𝐛𝐥'.sub.\"βïƭ#\"]\n\t\t\"ωλáƭ?\" = \"Ýôú δôñ'ƭ ƭλïñƙ ƨô₥è úƨèř ωôñ'ƭ δô ƭλáƭ?\"\n\t\tmulti_line_array = [\n\t\t\t\"]\",\n\t\t\t# ] Óλ ¥èƨ Ì δïδ\n\t\t\t]\n", "{\"𝐭𝐛𝐥\":{\"string\":{\"type\":\"string\",\"value\":\"𝓼𝓽𝓻𝓲𝓷𝓰 - #\"},\"sub\":{\"another_test_string\":{\"type\":\"string\",\"value\":\"§á₥è ƭλïñϱ, βúƭ ωïƭλ á ƨƭřïñϱ #\"},\"escapes\":{\"type\":\"string\",\"value\":\" Âñδ ωλèñ \\\"'ƨ ářè ïñ ƭλè ƨƭřïñϱ, áℓôñϱ ωïƭλ # \\\"\"},\"βïƭ#\":{\"multi_line_array\":[{\"type\":\"string\",\"value\":\"]\"}],\"ωλáƭ?\":{\"type\":\"string\",\"value\":\"Ýôú δôñ'ƭ ƭλïñƙ ƨô₥è úƨèř ωôñ'ƭ δô ƭλáƭ?\"}},\"𝕒𝕣𝕣𝕒𝕪\":[{\"type\":\"string\",\"value\":\"] \"},{\"type\":\"string\",\"value\":\" # \"}],\"𝕒𝕣𝕣𝕒𝕪𝟚\":[{\"type\":\"string\",\"value\":\"Tèƨƭ #11 ]ƥřôƲèδ ƭλáƭ\"},{\"type\":\"string\",\"value\":\"Éжƥèřï₥èñƭ #9 ωáƨ á ƨúççèƨƨ\"}]}}}")
}

///|
test "valid__newline_crlf" {
  assert_toml_valid("valid/newline-crlf.toml", "os = \"DOS\"\r\nnewline = \"crlf\"\r\n", "{\"newline\":{\"type\":\"string\",\"value\":\"crlf\"},\"os\":{\"type\":\"string\",\"value\":\"DOS\"}}")
}

///|
test "valid__newline_lf" {
  assert_toml_valid("valid/newline-lf.toml", "os = \"unix\"\nnewline = \"lf\"\n", "{\"newline\":{\"type\":\"string\",\"value\":\"lf\"},\"os\":{\"type\":\"string\",\"value\":\"unix\"}}")
}

///|
test "valid__spec_1_0_0__array_0" {
  assert_toml_valid("valid/spec-1.0.0/array-0.toml", "integers = [ 1, 2, 3 ]\ncolors = [ \"red\", \"yellow\", \"green\" ]\nnested_arrays_of_ints = [ [ 1, 2 ], [3, 4, 5] ]\nnested_mixed_array = [ [ 1, 2 ], [\"a\", \"b\", \"c\"] ]\nstring_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''' ]\n\n# Mixed-type arrays are allowed\nnumbers = [ 0.1, 0.2, 0.5, 1, 2, 5 ]\ncontributors = [\n  \"Foo Bar <foo@example.com>\",\n  { name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" }\n]\n", "{\"colors\":[{\"type\":\"string\",\"value\":\"red\"},{\"type\":\"string\",\"value\":\"yellow\"},{\"type\":\"string\",\"value\":\"green\"}],\"contributors\":[{\"type\":\"string\",\"value\":\"Foo Bar <foo@example.com>\"},{\"email\":{\"type\":\"string\",\"value\":\"bazqux@example.com\"},\"name\":{\"type\":\"string\",\"value\":\"Baz Qux\"},\"url\":{\"type\":\"string\",\"value\":\"https://example.com/bazqux\"}}],\"integers\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"},{\"type\":\"integer\",\"value\":\"3\"}],\"nested_arrays_of_ints\":[[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}],[{\"type\":\"integer\",\"value\":\"3\"},{\"type\":\"integer\",\"value\":\"4\"},{\"type\":\"integer\",\"value\":\"5\"}]],\"nested_mixed_array\":[[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}],[{\"type\":\"string\",\"value\":\"a\"},{\"type\":\"string\",\"value\":\"b\"},{\"type\":\"string\",\"value\":\"c\"}]],\"numbers\":[{\"type\":\"float\",\"value\":\"0.1\"},{\"type\":\"float\",\"value\":\"0.2\"},{\"type\":\"float\",\"value\":\"0.5\"},{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"},{\"type\":\"integer\",\"value\":\"5\"}],\"string_array\":[{\"type\":\"string\",\"value\":\"all\"},{\"type\":\"string\",\"value\":\"strings\"},{\"type\":\"string\",\"value\":\"are the same\"},{\"type\":\"string\",\"value\":\"type\"}]}")
}

///|
test "valid__spec_1_0_0__array_1" {
  assert_toml_valid("valid/spec-1.0.0/array-1.toml", "integers2 = [\n  1, 2, 3\n]\n\nintegers3 = [\n  1,\n  2, # this is ok\n]\n", "{\"integers2\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"},{\"type\":\"integer\",\"value\":\"3\"}],\"integers3\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}]}")
}

///|
test "valid__spec_1_0_0__array_of_tables_0" {
  assert_toml_valid("valid/spec-1.0.0/array-of-tables-0.toml", "[[products]]\nname = \"Hammer\"\nsku = 738594937\n\n[[products]]  # empty table within the array\n\n[[products]]\nname = \"Nail\"\nsku = 284758393\n\ncolor = \"gray\"\n", "{\"products\":[{\"name\":{\"type\":\"string\",\"value\":\"Hammer\"},\"sku\":{\"type\":\"integer\",\"value\":\"738594937\"}},{},{\"color\":{\"type\":\"string\",\"value\":\"gray\"},\"name\":{\"type\":\"string\",\"value\":\"Nail\"},\"sku\":{\"type\":\"integer\",\"value\":\"284758393\"}}]}")
}

///|
test "valid__spec_1_0_0__array_of_tables_1" {
  assert_toml_valid("valid/spec-1.0.0/array-of-tables-1.toml", "[[fruits]]\nname = \"apple\"\n\n[fruits.physical]  # subtable\ncolor = \"red\"\nshape = \"round\"\n\n[[fruits.varieties]]  # nested array of tables\nname = \"red delicious\"\n\n[[fruits.varieties]]\nname = \"granny smith\"\n\n\n[[fruits]]\nname = \"banana\"\n\n[[fruits.varieties]]\nname = \"plantain\"\n", "{\"fruits\":[{\"name\":{\"type\":\"string\",\"value\":\"apple\"},\"physical\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"shape\":{\"type\":\"string\",\"value\":\"round\"}},\"varieties\":[{\"name\":{\"type\":\"string\",\"value\":\"red delicious\"}},{\"name\":{\"type\":\"string\",\"value\":\"granny smith\"}}]},{\"name\":{\"type\":\"string\",\"value\":\"banana\"},\"varieties\":[{\"name\":{\"type\":\"string\",\"value\":\"plantain\"}}]}]}")
}

///|
test "valid__spec_1_0_0__array_of_tables_2" {
  assert_toml_valid("valid/spec-1.0.0/array-of-tables-2.toml", "points = [ { x = 1, y = 2, z = 3 },\n           { x = 7, y = 8, z = 9 },\n           { x = 2, y = 4, z = 8 } ]\n", "{\"points\":[{\"x\":{\"type\":\"integer\",\"value\":\"1\"},\"y\":{\"type\":\"integer\",\"value\":\"2\"},\"z\":{\"type\":\"integer\",\"value\":\"3\"}},{\"x\":{\"type\":\"integer\",\"value\":\"7\"},\"y\":{\"type\":\"integer\",\"value\":\"8\"},\"z\":{\"type\":\"integer\",\"value\":\"9\"}},{\"x\":{\"type\":\"integer\",\"value\":\"2\"},\"y\":{\"type\":\"integer\",\"value\":\"4\"},\"z\":{\"type\":\"integer\",\"value\":\"8\"}}]}")
}

///|
test "valid__spec_1_0_0__boolean_0" {
  assert_toml_valid("valid/spec-1.0.0/boolean-0.toml", "bool1 = true\nbool2 = false\n", "{\"bool1\":{\"type\":\"bool\",\"value\":\"true\"},\"bool2\":{\"type\":\"bool\",\"value\":\"false\"}}")
}

///|
test "valid__spec_1_0_0__comment_0" {
  assert_toml_valid("valid/spec-1.0.0/comment-0.toml", "# This is a full-line comment\nkey = \"value\"  # This is a comment at the end of a line\nanother = \"# This is not a comment\"\n", "{\"another\":{\"type\":\"string\",\"value\":\"# This is not a comment\"},\"key\":{\"type\":\"string\",\"value\":\"value\"}}")
}

///|
test "valid__spec_1_0_0__float_0" {
  assert_toml_valid("valid/spec-1.0.0/float-0.toml", "# fractional\nflt1 = +1.0\nflt2 = 3.1415\nflt3 = -0.01\n\n# exponent\nflt4 = 5e+22\nflt5 = 1e06\nflt6 = -2E-2\n\n# both\nflt7 = 6.626e-34\n", "{\"flt1\":{\"type\":\"float\",\"value\":\"1\"},\"flt2\":{\"type\":\"float\",\"value\":\"3.1415\"},\"flt3\":{\"type\":\"float\",\"value\":\"-0.01\"},\"flt4\":{\"type\":\"float\",\"value\":\"5e+22\"},\"flt5\":{\"type\":\"float\",\"value\":\"1e+06\"},\"flt6\":{\"type\":\"float\",\"value\":\"-0.02\"},\"flt7\":{\"type\":\"float\",\"value\":\"6.626e-34\"}}")
}

///|
test "valid__spec_1_0_0__float_1" {
  assert_toml_valid("valid/spec-1.0.0/float-1.toml", "flt8 = 224_617.445_991_228\n", "{\"flt8\":{\"type\":\"float\",\"value\":\"224617.445991228\"}}")
}

///|
test "valid__spec_1_0_0__float_2" {
  assert_toml_valid("valid/spec-1.0.0/float-2.toml", "# infinity\nsf1 = inf  # positive infinity\nsf2 = +inf # positive infinity\nsf3 = -inf # negative infinity\n\n# not a number\nsf4 = nan  # actual sNaN/qNaN encoding is implementation-specific\nsf5 = +nan # same as `nan`\nsf6 = -nan # valid, actual encoding is implementation-specific\n", "{\"sf1\":{\"type\":\"float\",\"value\":\"inf\"},\"sf2\":{\"type\":\"float\",\"value\":\"inf\"},\"sf3\":{\"type\":\"float\",\"value\":\"-inf\"},\"sf4\":{\"type\":\"float\",\"value\":\"nan\"},\"sf5\":{\"type\":\"float\",\"value\":\"nan\"},\"sf6\":{\"type\":\"float\",\"value\":\"nan\"}}")
}

///|
test "valid__spec_1_0_0__inline_table_0" {
  assert_toml_valid("valid/spec-1.0.0/inline-table-0.toml", "name = { first = \"Tom\", last = \"Preston-Werner\" }\npoint = { x = 1, y = 2 }\nanimal = { type.name = \"pug\" }\n", "{\"animal\":{\"type\":{\"name\":{\"type\":\"string\",\"value\":\"pug\"}}},\"name\":{\"first\":{\"type\":\"string\",\"value\":\"Tom\"},\"last\":{\"type\":\"string\",\"value\":\"Preston-Werner\"}},\"point\":{\"x\":{\"type\":\"integer\",\"value\":\"1\"},\"y\":{\"type\":\"integer\",\"value\":\"2\"}}}")
}

///|
test "valid__spec_1_0_0__inline_table_1" {
  assert_toml_valid("valid/spec-1.0.0/inline-table-1.toml", "[name]\nfirst = \"Tom\"\nlast = \"Preston-Werner\"\n\n[point]\nx = 1\ny = 2\n\n[animal]\ntype.name = \"pug\"\n", "{\"animal\":{\"type\":{\"name\":{\"type\":\"string\",\"value\":\"pug\"}}},\"name\":{\"first\":{\"type\":\"string\",\"value\":\"Tom\"},\"last\":{\"type\":\"string\",\"value\":\"Preston-Werner\"}},\"point\":{\"x\":{\"type\":\"integer\",\"value\":\"1\"},\"y\":{\"type\":\"integer\",\"value\":\"2\"}}}")
}

///|
test "valid__spec_1_0_0__inline_table_2" {
  assert_toml_valid("valid/spec-1.0.0/inline-table-2.toml", "[product]\ntype = { name = \"Nail\" }\n# type.edible = false  # INVALID\n", "{\"product\":{\"type\":{\"name\":{\"type\":\"string\",\"value\":\"Nail\"}}}}")
}

///|
test "valid__spec_1_0_0__inline_table_3" {
  assert_toml_valid("valid/spec-1.0.0/inline-table-3.toml", "[product]\ntype.name = \"Nail\"\n# type = { edible = false }  # INVALID\n", "{\"product\":{\"type\":{\"name\":{\"type\":\"string\",\"value\":\"Nail\"}}}}")
}

///|
test "valid__spec_1_0_0__integer_0" {
  assert_toml_valid("valid/spec-1.0.0/integer-0.toml", "int1 = +99\nint2 = 42\nint3 = 0\nint4 = -17\n", "{\"int1\":{\"type\":\"integer\",\"value\":\"99\"},\"int2\":{\"type\":\"integer\",\"value\":\"42\"},\"int3\":{\"type\":\"integer\",\"value\":\"0\"},\"int4\":{\"type\":\"integer\",\"value\":\"-17\"}}")
}

///|
test "valid__spec_1_0_0__integer_1" {
  assert_toml_valid("valid/spec-1.0.0/integer-1.toml", "int5 = 1_000\nint6 = 5_349_221\nint7 = 53_49_221  # Indian number system grouping\nint8 = 1_2_3_4_5  # VALID but discouraged\n", "{\"int5\":{\"type\":\"integer\",\"value\":\"1000\"},\"int6\":{\"type\":\"integer\",\"value\":\"5349221\"},\"int7\":{\"type\":\"integer\",\"value\":\"5349221\"},\"int8\":{\"type\":\"integer\",\"value\":\"12345\"}}")
}

///|
test "valid__spec_1_0_0__integer_2" {
  assert_toml_valid("valid/spec-1.0.0/integer-2.toml", "# hexadecimal with prefix `0x`\nhex1 = 0xDEADBEEF\nhex2 = 0xdeadbeef\nhex3 = 0xdead_beef\n\n# octal with prefix `0o`\noct1 = 0o01234567\noct2 = 0o755 # useful for Unix file permissions\n\n# binary with prefix `0b`\nbin1 = 0b11010110\n", "{\"bin1\":{\"type\":\"integer\",\"value\":\"214\"},\"hex1\":{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex2\":{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex3\":{\"type\":\"integer\",\"value\":\"3735928559\"},\"oct1\":{\"type\":\"integer\",\"value\":\"342391\"},\"oct2\":{\"type\":\"integer\",\"value\":\"493\"}}")
}

///|
test "valid__spec_1_0_0__key_value_pair_0" {
  assert_toml_valid("valid/spec-1.0.0/key-value-pair-0.toml", "key = \"value\"\n", "{\"key\":{\"type\":\"string\",\"value\":\"value\"}}")
}

///|
test "valid__spec_1_0_0__keys_0" {
  assert_toml_valid("valid/spec-1.0.0/keys-0.toml", "key = \"value\"\nbare_key = \"value\"\nbare-key = \"value\"\n1234 = \"value\"\n", "{\"1234\":{\"type\":\"string\",\"value\":\"value\"},\"bare-key\":{\"type\":\"string\",\"value\":\"value\"},\"bare_key\":{\"type\":\"string\",\"value\":\"value\"},\"key\":{\"type\":\"string\",\"value\":\"value\"}}")
}

///|
test "valid__spec_1_0_0__keys_1" {
  assert_toml_valid("valid/spec-1.0.0/keys-1.toml", "\"127.0.0.1\" = \"value\"\n\"character encoding\" = \"value\"\n\"ʎǝʞ\" = \"value\"\n'key2' = \"value\"\n'quoted \"value\"' = \"value\"\n", "{\"127.0.0.1\":{\"type\":\"string\",\"value\":\"value\"},\"character encoding\":{\"type\":\"string\",\"value\":\"value\"},\"key2\":{\"type\":\"string\",\"value\":\"value\"},\"quoted \\\"value\\\"\":{\"type\":\"string\",\"value\":\"value\"},\"ʎǝʞ\":{\"type\":\"string\",\"value\":\"value\"}}")
}

///|
test "valid__spec_1_0_0__keys_3" {
  assert_toml_valid("valid/spec-1.0.0/keys-3.toml", "name = \"Orange\"\nphysical.color = \"orange\"\nphysical.shape = \"round\"\nsite.\"google.com\" = true\n", "{\"name\":{\"type\":\"string\",\"value\":\"Orange\"},\"physical\":{\"color\":{\"type\":\"string\",\"value\":\"orange\"},\"shape\":{\"type\":\"string\",\"value\":\"round\"}},\"site\":{\"google.com\":{\"type\":\"bool\",\"value\":\"true\"}}}")
}

///|
test "valid__spec_1_0_0__keys_4" {
  assert_toml_valid("valid/spec-1.0.0/keys-4.toml", "fruit.name = \"banana\"     # this is best practice\nfruit. color = \"yellow\"    # same as fruit.color\nfruit . flavor = \"banana\"   # same as fruit.flavor\n", "{\"fruit\":{\"color\":{\"type\":\"string\",\"value\":\"yellow\"},\"flavor\":{\"type\":\"string\",\"value\":\"banana\"},\"name\":{\"type\":\"string\",\"value\":\"banana\"}}}")
}

///|
test "valid__spec_1_0_0__keys_5" {
  assert_toml_valid("valid/spec-1.0.0/keys-5.toml", "# VALID BUT DISCOURAGED\n\napple.type = \"fruit\"\norange.type = \"fruit\"\n\napple.skin = \"thin\"\norange.skin = \"thick\"\n\napple.color = \"red\"\norange.color = \"orange\"\n", "{\"apple\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"skin\":{\"type\":\"string\",\"value\":\"thin\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}},\"orange\":{\"color\":{\"type\":\"string\",\"value\":\"orange\"},\"skin\":{\"type\":\"string\",\"value\":\"thick\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}}}")
}

///|
test "valid__spec_1_0_0__keys_6" {
  assert_toml_valid("valid/spec-1.0.0/keys-6.toml", "# RECOMMENDED\n\napple.type = \"fruit\"\napple.skin = \"thin\"\napple.color = \"red\"\n\norange.type = \"fruit\"\norange.skin = \"thick\"\norange.color = \"orange\"\n", "{\"apple\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"skin\":{\"type\":\"string\",\"value\":\"thin\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}},\"orange\":{\"color\":{\"type\":\"string\",\"value\":\"orange\"},\"skin\":{\"type\":\"string\",\"value\":\"thick\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}}}")
}

///|
test "valid__spec_1_0_0__keys_7" {
  assert_toml_valid("valid/spec-1.0.0/keys-7.toml", "3.14159 = \"pi\"\n", "{\"3\":{\"14159\":{\"type\":\"string\",\"value\":\"pi\"}}}")
}

///|
test "valid__spec_1_0_0__local_date_0" {
  assert_toml_valid("valid/spec-1.0.0/local-date-0.toml", "ld1 = 1979-05-27\n", "{\"ld1\":{\"type\":\"date-local\",\"value\":\"1979-05-27\"}}")
}

///|
test "valid__spec_1_0_0__local_date_time_0" {
  assert_toml_valid("valid/spec-1.0.0/local-date-time-0.toml", "ldt1 = 1979-05-27T07:32:00\nldt2 = 1979-05-27T00:32:00.999\n", "{\"ldt1\":{\"type\":\"datetime-local\",\"value\":\"1979-05-27T07:32:00\"},\"ldt2\":{\"type\":\"datetime-local\",\"value\":\"1979-05-27T00:32:00.999\"}}")
}

///|
test "valid__spec_1_0_0__local_time_0" {
  assert_toml_valid("valid/spec-1.0.0/local-time-0.toml", "lt1 = 07:32:00\nlt2 = 00:32:00.999\n", "{\"lt1\":{\"type\":\"time-local\",\"value\":\"07:32:00\"},\"lt2\":{\"type\":\"time-local\",\"value\":\"00:32:00.999\"}}")
}

///|
test "valid__spec_1_0_0__offset_date_time_0" {
  assert_toml_valid("valid/spec-1.0.0/offset-date-time-0.toml", "odt1 = 1979-05-27T07:32:00Z\nodt2 = 1979-05-27T00:32:00-07:00\nodt3 = 1979-05-27T00:32:00.999-07:00\n", "{\"odt1\":{\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00Z\"},\"odt2\":{\"type\":\"datetime\",\"value\":\"1979-05-27T00:32:00-07:00\"},\"odt3\":{\"type\":\"datetime\",\"value\":\"1979-05-27T00:32:00.999-07:00\"}}")
}

///|
test "valid__spec_1_0_0__offset_date_time_1" {
  assert_toml_valid("valid/spec-1.0.0/offset-date-time-1.toml", "odt4 = 1979-05-27 07:32:00Z\n", "{\"odt4\":{\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00Z\"}}")
}

///|
test "valid__spec_1_0_0__string_0" {
  assert_toml_valid("valid/spec-1.0.0/string-0.toml", "str = \"I'm a string. \\\"You can quote me\\\". Name\\tJos\\u00E9\\nLocation\\tSF.\"\n", "{\"str\":{\"type\":\"string\",\"value\":\"I'm a string. \\\"You can quote me\\\". Name\\tJosé\\nLocation\\tSF.\"}}")
}

///|
test "valid__spec_1_0_0__string_1" {
  assert_toml_valid("valid/spec-1.0.0/string-1.toml", "str1 = \"\"\"\nRoses are red\nViolets are blue\"\"\"\n", "{\"str1\":{\"type\":\"string\",\"value\":\"Roses are red\\nViolets are blue\"}}")
}

///|
test "valid__spec_1_0_0__string_2" {
  assert_toml_valid("valid/spec-1.0.0/string-2.toml", "# On a Unix system, the above multi-line string will most likely be the same as:\nstr2 = \"Roses are red\\nViolets are blue\"\n\n# On a Windows system, it will most likely be equivalent to:\nstr3 = \"Roses are red\\r\\nViolets are blue\"\n", "{\"str2\":{\"type\":\"string\",\"value\":\"Roses are red\\nViolets are blue\"},\"str3\":{\"type\":\"string\",\"value\":\"Roses are red\\r\\nViolets are blue\"}}")
}

///|
test "valid__spec_1_0_0__string_3" {
  assert_toml_valid("valid/spec-1.0.0/string-3.toml", "# The following strings are byte-for-byte equivalent:\nstr1 = \"The quick brown fox jumps over the lazy dog.\"\n\nstr2 = \"\"\"\nThe quick brown \\\n\n\n  fox jumps over \\\n    the lazy dog.\"\"\"\n\nstr3 = \"\"\"\\\n       The quick brown \\\n       fox jumps over \\\n       the lazy dog.\\\n       \"\"\"\n", "{\"str1\":{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"str2\":{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"str3\":{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"}}")
}

///|
test "valid__spec_1_0_0__string_4" {
  assert_toml_valid("valid/spec-1.0.0/string-4.toml", "str4 = \"\"\"Here are two quotation marks: \"\". Simple enough.\"\"\"\n# str5 = \"\"\"Here are three quotation marks: \"\"\".\"\"\"  # INVALID\nstr5 = \"\"\"Here are three quotation marks: \"\"\\\".\"\"\"\nstr6 = \"\"\"Here are fifteen quotation marks: \"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\".\"\"\"\n\n# \"This,\" she said, \"is just a pointless statement.\"\nstr7 = \"\"\"\"This,\" she said, \"is just a pointless statement.\"\"\"\"\n", "{\"str4\":{\"type\":\"string\",\"value\":\"Here are two quotation marks: \\\"\\\". Simple enough.\"},\"str5\":{\"type\":\"string\",\"value\":\"Here are three quotation marks: \\\"\\\"\\\".\"},\"str6\":{\"type\":\"string\",\"value\":\"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\".\"},\"str7\":{\"type\":\"string\",\"value\":\"\\\"This,\\\" she said, \\\"is just a pointless statement.\\\"\"}}")
}

///|
test "valid__spec_1_0_0__string_5" {
  assert_toml_valid("valid/spec-1.0.0/string-5.toml", "# What you see is what you get.\nwinpath  = 'C:\\Users\\nodejs\\templates'\nwinpath2 = '\\\\ServerX\\admin$\\system32\\'\nquoted   = 'Tom \"Dubs\" Preston-Werner'\nregex    = '<\\i\\c*\\s*>'\n", "{\"quoted\":{\"type\":\"string\",\"value\":\"Tom \\\"Dubs\\\" Preston-Werner\"},\"regex\":{\"type\":\"string\",\"value\":\"<\\\\i\\\\c*\\\\s*>\"},\"winpath\":{\"type\":\"string\",\"value\":\"C:\\\\Users\\\\nodejs\\\\templates\"},\"winpath2\":{\"type\":\"string\",\"value\":\"\\\\\\\\ServerX\\\\admin$\\\\system32\\\\\"}}")
}

///|
test "valid__spec_1_0_0__string_6" {
  assert_toml_valid("valid/spec-1.0.0/string-6.toml", "regex2 = '''I [dw]on't need \\d{2} apples'''\nlines  = '''\nThe first newline is\ntrimmed in raw strings.\n   All other whitespace\n   is preserved.\n'''\n", "{\"lines\":{\"type\":\"string\",\"value\":\"The first newline is\\ntrimmed in raw strings.\\n   All other whitespace\\n   is preserved.\\n\"},\"regex2\":{\"type\":\"string\",\"value\":\"I [dw]on't need \\\\d{2} apples\"}}")
}

///|
test "valid__spec_1_0_0__string_7" {
  assert_toml_valid("valid/spec-1.0.0/string-7.toml", "quot15 = '''Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\"'''\n\n# apos15 = '''Here are fifteen apostrophes: ''''''''''''''''''  # INVALID\napos15 = \"Here are fifteen apostrophes: '''''''''''''''\"\n\n# 'That,' she said, 'is still pointless.'\nstr = ''''That,' she said, 'is still pointless.''''\n", "{\"apos15\":{\"type\":\"string\",\"value\":\"Here are fifteen apostrophes: '''''''''''''''\"},\"quot15\":{\"type\":\"string\",\"value\":\"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\"},\"str\":{\"type\":\"string\",\"value\":\"'That,' she said, 'is still pointless.'\"}}")
}

///|
test "valid__spec_1_0_0__table_0" {
  assert_toml_valid("valid/spec-1.0.0/table-0.toml", "[table]\n", "{\"table\":{}}")
}

///|
test "valid__spec_1_0_0__table_1" {
  assert_toml_valid("valid/spec-1.0.0/table-1.toml", "[table-1]\nkey1 = \"some string\"\nkey2 = 123\n\n[table-2]\nkey1 = \"another string\"\nkey2 = 456\n", "{\"table-1\":{\"key1\":{\"type\":\"string\",\"value\":\"some string\"},\"key2\":{\"type\":\"integer\",\"value\":\"123\"}},\"table-2\":{\"key1\":{\"type\":\"string\",\"value\":\"another string\"},\"key2\":{\"type\":\"integer\",\"value\":\"456\"}}}")
}

///|
test "valid__spec_1_0_0__table_2" {
  assert_toml_valid("valid/spec-1.0.0/table-2.toml", "[dog.\"tater.man\"]\ntype.name = \"pug\"\n", "{\"dog\":{\"tater.man\":{\"type\":{\"name\":{\"type\":\"string\",\"value\":\"pug\"}}}}}")
}

///|
test "valid__spec_1_0_0__table_3" {
  assert_toml_valid("valid/spec-1.0.0/table-3.toml", "[a.b.c]            # this is best practice\n[ d.e.f ]          # same as [d.e.f]\n[ g .  h  . i ]    # same as [g.h.i]\n[ j . \"ʞ\" . 'l' ]  # same as [j.\"ʞ\".'l']\n", "{\"a\":{\"b\":{\"c\":{}}},\"d\":{\"e\":{\"f\":{}}},\"g\":{\"h\":{\"i\":{}}},\"j\":{\"ʞ\":{\"l\":{}}}}")
}

///|
test "valid__spec_1_0_0__table_4" {
  assert_toml_valid("valid/spec-1.0.0/table-4.toml", "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\n\n[x] # defining a super-table afterward is ok\n", "{\"x\":{\"y\":{\"z\":{\"w\":{}}}}}")
}

///|
test "valid__spec_1_0_0__table_5" {
  assert_toml_valid("valid/spec-1.0.0/table-5.toml", "# VALID BUT DISCOURAGED\n[fruit.apple]\n[animal]\n[fruit.orange]\n", "{\"animal\":{},\"fruit\":{\"apple\":{},\"orange\":{}}}")
}

///|
test "valid__spec_1_0_0__table_6" {
  assert_toml_valid("valid/spec-1.0.0/table-6.toml", "# RECOMMENDED\n[fruit.apple]\n[fruit.orange]\n[animal]\n", "{\"animal\":{},\"fruit\":{\"apple\":{},\"orange\":{}}}")
}

///|
test "valid__spec_1_0_0__table_7" {
  assert_toml_valid("valid/spec-1.0.0/table-7.toml", "# Top-level table begins.\nname = \"Fido\"\nbreed = \"pug\"\n\n# Top-level table ends.\n[owner]\nname = \"Regina Dogman\"\nmember_since = 1999-08-04\n", "{\"breed\":{\"type\":\"string\",\"value\":\"pug\"},\"name\":{\"type\":\"string\",\"value\":\"Fido\"},\"owner\":{\"member_since\":{\"type\":\"date-local\",\"value\":\"1999-08-04\"},\"name\":{\"type\":\"string\",\"value\":\"Regina Dogman\"}}}")
}

///|
test "valid__spec_1_0_0__table_8" {
  assert_toml_valid("valid/spec-1.0.0/table-8.toml", "fruit.apple.color = \"red\"\n# Defines a table named fruit\n# Defines a table named fruit.apple\n\nfruit.apple.taste.sweet = true\n# Defines a table named fruit.apple.taste\n# fruit and fruit.apple were already created\n", "{\"fruit\":{\"apple\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"taste\":{\"sweet\":{\"type\":\"bool\",\"value\":\"true\"}}}}}")
}

///|
test "valid__spec_1_0_0__table_9" {
  assert_toml_valid("valid/spec-1.0.0/table-9.toml", "[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n# [fruit.apple]  # INVALID\n# [fruit.apple.taste]  # INVALID\n\n[fruit.apple.texture]  # you can add sub-tables\nsmooth = true\n", "{\"fruit\":{\"apple\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"taste\":{\"sweet\":{\"type\":\"bool\",\"value\":\"true\"}},\"texture\":{\"smooth\":{\"type\":\"bool\",\"value\":\"true\"}}}}}")
}

///|
test "valid__spec_example_1" {
  assert_toml_valid("valid/spec-example-1.toml", "# This is a TOML document. Boom.\n\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Lance Uppercut\"\ndob = 1979-05-27T07:32:00-08:00 # First class dates? Why not?\n\n[database]\nserver = \"192.168.1.1\"\nports = [ 8001, 8001, 8002 ]\nconnection_max = 5000\nenabled = true\n\n[servers]\n\n  # You can indent as you please. Tabs or spaces. TOML don't care.\n  [servers.alpha]\n  ip = \"10.0.0.1\"\n  dc = \"eqdc10\"\n\n  [servers.beta]\n  ip = \"10.0.0.2\"\n  dc = \"eqdc10\"\n\n[clients]\ndata = [ [\"gamma\", \"delta\"], [1, 2] ]\n\n# Line breaks are OK when inside arrays\nhosts = [\n  \"alpha\",\n  \"omega\"\n]\n", "{\"title\":{\"type\":\"string\",\"value\":\"TOML Example\"},\"clients\":{\"data\":[[{\"type\":\"string\",\"value\":\"gamma\"},{\"type\":\"string\",\"value\":\"delta\"}],[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}]],\"hosts\":[{\"type\":\"string\",\"value\":\"alpha\"},{\"type\":\"string\",\"value\":\"omega\"}]},\"database\":{\"connection_max\":{\"type\":\"integer\",\"value\":\"5000\"},\"enabled\":{\"type\":\"bool\",\"value\":\"true\"},\"server\":{\"type\":\"string\",\"value\":\"192.168.1.1\"},\"ports\":[{\"type\":\"integer\",\"value\":\"8001\"},{\"type\":\"integer\",\"value\":\"8001\"},{\"type\":\"integer\",\"value\":\"8002\"}]},\"owner\":{\"dob\":{\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00-08:00\"},\"name\":{\"type\":\"string\",\"value\":\"Lance Uppercut\"}},\"servers\":{\"alpha\":{\"dc\":{\"type\":\"string\",\"value\":\"eqdc10\"},\"ip\":{\"type\":\"string\",\"value\":\"10.0.0.1\"}},\"beta\":{\"dc\":{\"type\":\"string\",\"value\":\"eqdc10\"},\"ip\":{\"type\":\"string\",\"value\":\"10.0.0.2\"}}}}")
}

///|
test "valid__spec_example_1_compact" {
  assert_toml_valid("valid/spec-example-1-compact.toml", "#Useless spaces eliminated.\ntitle=\"TOML Example\"\n[owner]\nname=\"Lance Uppercut\"\ndob=1979-05-27T07:32:00-08:00#First class dates\n[database]\nserver=\"192.168.1.1\"\nports=[8001,8001,8002]\nconnection_max=5000\nenabled=true\n[servers]\n[servers.alpha]\nip=\"10.0.0.1\"\ndc=\"eqdc10\"\n[servers.beta]\nip=\"10.0.0.2\"\ndc=\"eqdc10\"\n[clients]\ndata=[[\"gamma\",\"delta\"],[1,2]]\nhosts=[\n\"alpha\",\n\"omega\"\n]\n", "{\"title\":{\"type\":\"string\",\"value\":\"TOML Example\"},\"clients\":{\"data\":[[{\"type\":\"string\",\"value\":\"gamma\"},{\"type\":\"string\",\"value\":\"delta\"}],[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}]],\"hosts\":[{\"type\":\"string\",\"value\":\"alpha\"},{\"type\":\"string\",\"value\":\"omega\"}]},\"database\":{\"connection_max\":{\"type\":\"integer\",\"value\":\"5000\"},\"enabled\":{\"type\":\"bool\",\"value\":\"true\"},\"server\":{\"type\":\"string\",\"value\":\"192.168.1.1\"},\"ports\":[{\"type\":\"integer\",\"value\":\"8001\"},{\"type\":\"integer\",\"value\":\"8001\"},{\"type\":\"integer\",\"value\":\"8002\"}]},\"owner\":{\"dob\":{\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00-08:00\"},\"name\":{\"type\":\"string\",\"value\":\"Lance Uppercut\"}},\"servers\":{\"alpha\":{\"dc\":{\"type\":\"string\",\"value\":\"eqdc10\"},\"ip\":{\"type\":\"string\",\"value\":\"10.0.0.1\"}},\"beta\":{\"dc\":{\"type\":\"string\",\"value\":\"eqdc10\"},\"ip\":{\"type\":\"string\",\"value\":\"10.0.0.2\"}}}}")
}

///|
test "valid__string__basic_escape_01" {
  assert_toml_valid("valid/string/basic-escape-01.toml", "# Escape \"\ntest = \"\\\"one\\\"\"\n", "{\"test\":{\"type\":\"string\",\"value\":\"\\\"one\\\"\"}}")
}

///|
test "valid__string__basic_escape_02" {
  assert_toml_valid("valid/string/basic-escape-02.toml", "# Escape \\ and then \"\ntest = \"\\\\\\\"one\"\n", "{\"test\":{\"type\":\"string\",\"value\":\"\\\\\\\"one\"}}")
}

///|
test "valid__string__basic_escape_03" {
  assert_toml_valid("valid/string/basic-escape-03.toml", "# Escape \\ four times and then \"\ntest = \"\\\\\\\\\\\\\\\\\\\"one\"\n", "{\"test\":{\"type\":\"string\",\"value\":\"\\\\\\\\\\\\\\\\\\\"one\"}}")
}

///|
test "valid__string__empty" {
  assert_toml_valid("valid/string/empty.toml", "answer = \"\"\n", "{\"answer\":{\"type\":\"string\",\"value\":\"\"}}")
}

///|
test "valid__string__ends_in_whitespace_escape" {
  assert_toml_valid("valid/string/ends-in-whitespace-escape.toml", "beee = \"\"\"\nheeee\ngeeee\\  \n\n\n      \"\"\"\n", "{\"beee\":{\"type\":\"string\",\"value\":\"heeee\\ngeeee\"}}")
}

///|
test "valid__string__escape_tricky" {
  assert_toml_valid("valid/string/escape-tricky.toml", "end_esc = \"String does not end here\\\" but ends here\\\\\"\nlit_end_esc = 'String ends here\\'\n\nmultiline_unicode = \"\"\"\n\\u00a0\"\"\"\n\nmultiline_not_unicode = \"\"\"\n\\\\u0041\"\"\"\n\nmultiline_end_esc = \"\"\"When will it end? \\\"\"\"...\"\"\\\" should be here\\\"\"\"\"\n\nlit_multiline_not_unicode = '''\n\\u007f'''\n\nlit_multiline_end = '''There is no escape\\'''\n", "{\"end_esc\":{\"type\":\"string\",\"value\":\"String does not end here\\\" but ends here\\\\\"},\"lit_end_esc\":{\"type\":\"string\",\"value\":\"String ends here\\\\\"},\"lit_multiline_end\":{\"type\":\"string\",\"value\":\"There is no escape\\\\\"},\"lit_multiline_not_unicode\":{\"type\":\"string\",\"value\":\"\\\\u007f\"},\"multiline_end_esc\":{\"type\":\"string\",\"value\":\"When will it end? \\\"\\\"\\\"...\\\"\\\"\\\" should be here\\\"\"},\"multiline_not_unicode\":{\"type\":\"string\",\"value\":\"\\\\u0041\"},\"multiline_unicode\":{\"type\":\"string\",\"value\":\" \"}}")
}

///|
test "valid__string__escaped_escape" {
  assert_toml_valid("valid/string/escaped-escape.toml", "answer = \"\\\\x64\"\n", "{\"answer\":{\"type\":\"string\",\"value\":\"\\\\x64\"}}")
}

///|
test "valid__string__escapes" {
  assert_toml_valid("valid/string/escapes.toml", "backspace     = \"|\\b.\"\ntab           = \"|\\t.\"\nnewline       = \"|\\n.\"\nformfeed      = \"|\\f.\"\ncarriage      = \"|\\r.\"\nquote         = \"|\\\".\"\nbackslash     = \"|\\\\.\"\ndelete        = \"|\\u007F.\"\nunitseparator = \"|\\u001F.\"\n\n# \\u is escaped, so should NOT be interperted as a \\u escape.\nnotunicode1   = \"|\\\\u.\"\nnotunicode2   = \"|\\u005Cu.\"\nnotunicode3   = \"|\\\\u0075.\"\nnotunicode4   = \"|\\\\\\u0075.\"\n", str_from_bytes([123, 34, 98, 97, 99, 107, 115, 108, 97, 115, 104, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 92, 46, 34, 125, 44, 34, 98, 97, 99, 107, 115, 112, 97, 99, 101, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 98, 46, 34, 125, 44, 34, 99, 97, 114, 114, 105, 97, 103, 101, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 114, 46, 34, 125, 44, 34, 100, 101, 108, 101, 116, 101, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 127, 46, 34, 125, 44, 34, 102, 111, 114, 109, 102, 101, 101, 100, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 102, 46, 34, 125, 44, 34, 110, 101, 119, 108, 105, 110, 101, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 110, 46, 34, 125, 44, 34, 110, 111, 116, 117, 110, 105, 99, 111, 100, 101, 49, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 92, 117, 46, 34, 125, 44, 34, 110, 111, 116, 117, 110, 105, 99, 111, 100, 101, 50, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 92, 117, 46, 34, 125, 44, 34, 110, 111, 116, 117, 110, 105, 99, 111, 100, 101, 51, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 92, 117, 48, 48, 55, 53, 46, 34, 125, 44, 34, 110, 111, 116, 117, 110, 105, 99, 111, 100, 101, 52, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 92, 117, 46, 34, 125, 44, 34, 113, 117, 111, 116, 101, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 34, 46, 34, 125, 44, 34, 116, 97, 98, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 116, 46, 34, 125, 44, 34, 117, 110, 105, 116, 115, 101, 112, 97, 114, 97, 116, 111, 114, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 124, 92, 117, 48, 48, 49, 102, 46, 34, 125, 125]))
}

///|
test "valid__string__multibyte" {
  assert_toml_valid("valid/string/multibyte.toml", "# Test each multibyte length: 2, 3, and 4 bytes:\n# ɑ € 𐫱\n\nbasic    = \"ɑ € 𐫱 ɑ€𐫱\"\nraw      = 'ɑ € 𐫱 ɑ€𐫱'\nml-basic = \"\"\"ɑ € 𐫱 ɑ€𐫱\"\"\"\nml-raw   = '''ɑ € 𐫱 ɑ€𐫱'''\n", "{\"basic\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-basic\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-raw\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"raw\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"}}")
}

///|
test "valid__string__multibyte_escape" {
  assert_toml_valid("valid/string/multibyte-escape.toml", "# Test each multibyte length: 2, 3, and 4 bytes:\n# ɑ € 𐫱\n\nbasic-1    = \"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\nml-basic-1 = \"\"\"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\"\"\n\n# Again, but only using \\U\nbasic-2    = \"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\nml-basic-2 = \"\"\"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\"\"\n", "{\"basic-1\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-basic-1\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"basic-2\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-basic-2\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"}}")
}

///|
test "valid__string__multiline" {
  assert_toml_valid("valid/string/multiline.toml", "# NOTE: this file includes some literal tab characters.\n\nequivalent_one = \"The quick brown fox jumps over the lazy dog.\"\nequivalent_two = \"\"\"\nThe quick brown \\\n\n\n  fox jumps over \\\n    the lazy dog.\"\"\"\n\nequivalent_three = \"\"\"\\\n       The quick brown \\\n       fox jumps over \\\n       the lazy dog.\\\n       \"\"\"\n\nwhitespace-after-bs = \"\"\"\\\n       The quick brown \\\n       fox jumps over \\   \n       the lazy dog.\\\t\n       \"\"\"\n\nno-space = \"\"\"a\\\n    b\"\"\"\n\n# Has tab character.\nkeep-ws-before = \"\"\"a   \t\\\n   b\"\"\"\n\nescape-bs-1 = \"\"\"a \\\\\nb\"\"\"\n\nescape-bs-2 = \"\"\"a \\\\\\\nb\"\"\"\n\nescape-bs-3 = \"\"\"a \\\\\\\\\n  b\"\"\"\n", "{\"equivalent_one\":{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"equivalent_three\":{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"equivalent_two\":{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"escape-bs-1\":{\"type\":\"string\",\"value\":\"a \\\\\\nb\"},\"escape-bs-2\":{\"type\":\"string\",\"value\":\"a \\\\b\"},\"escape-bs-3\":{\"type\":\"string\",\"value\":\"a \\\\\\\\\\n  b\"},\"keep-ws-before\":{\"type\":\"string\",\"value\":\"a   \\tb\"},\"no-space\":{\"type\":\"string\",\"value\":\"ab\"},\"whitespace-after-bs\":{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"}}")
}

///|
test "valid__string__multiline_empty" {
  assert_toml_valid("valid/string/multiline-empty.toml", "empty-1 = \"\"\"\"\"\"\n\n# A newline immediately following the opening delimiter will be trimmed.\nempty-2 = \"\"\"\n\"\"\"\n\n# \\ at the end of line trims newlines as well; note that last \\ is followed by\n# two spaces, which are ignored.\nempty-3 = \"\"\"\\\n    \"\"\"\nempty-4 = \"\"\"\\\n   \\\n   \\  \n   \"\"\"\n\n", "{\"empty-1\":{\"type\":\"string\",\"value\":\"\"},\"empty-2\":{\"type\":\"string\",\"value\":\"\"},\"empty-3\":{\"type\":\"string\",\"value\":\"\"},\"empty-4\":{\"type\":\"string\",\"value\":\"\"}}")
}

///|
test "valid__string__multiline_escaped_crlf" {
  assert_toml_valid("valid/string/multiline-escaped-crlf.toml", "# The following line should be an unescaped backslash followed by a Windows\r\n# newline sequence (\"\\r\\n\")\r\n0=\"\"\"\\\r\n\"\"\"\r\n", "{\"0\":{\"type\":\"string\",\"value\":\"\"}}")
}

///|
test "valid__string__multiline_quotes" {
  assert_toml_valid("valid/string/multiline-quotes.toml", "# Make sure that quotes inside multiline strings are allowed, including right\n# after the opening '''/\"\"\" and before the closing '''/\"\"\"\n\nlit_one = ''''one quote''''\nlit_two = '''''two quotes'''''\nlit_one_space = ''' 'one quote' '''\nlit_two_space = ''' ''two quotes'' '''\n\none = \"\"\"\"one quote\"\"\"\"\ntwo = \"\"\"\"\"two quotes\"\"\"\"\"\none_space = \"\"\" \"one quote\" \"\"\"\ntwo_space = \"\"\" \"\"two quotes\"\" \"\"\"\n\nmismatch1 = \"\"\"aaa'''bbb\"\"\"\nmismatch2 = '''aaa\"\"\"bbb'''\n\n# Three opening \"\"\", then one escaped \", then two \"\" (allowed), and then three\n# closing \"\"\"\nescaped = \"\"\"lol\\\"\"\"\"\"\"\n\nfive-quotes = \"\"\"\nClosing with five quotes\n\"\"\"\"\"\nfour-quotes = \"\"\"\nClosing with four quotes\n\"\"\"\"\n", "{\"escaped\":{\"type\":\"string\",\"value\":\"lol\\\"\\\"\\\"\"},\"five-quotes\":{\"type\":\"string\",\"value\":\"Closing with five quotes\\n\\\"\\\"\"},\"four-quotes\":{\"type\":\"string\",\"value\":\"Closing with four quotes\\n\\\"\"},\"lit_one\":{\"type\":\"string\",\"value\":\"'one quote'\"},\"lit_one_space\":{\"type\":\"string\",\"value\":\" 'one quote' \"},\"lit_two\":{\"type\":\"string\",\"value\":\"''two quotes''\"},\"lit_two_space\":{\"type\":\"string\",\"value\":\" ''two quotes'' \"},\"mismatch1\":{\"type\":\"string\",\"value\":\"aaa'''bbb\"},\"mismatch2\":{\"type\":\"string\",\"value\":\"aaa\\\"\\\"\\\"bbb\"},\"one\":{\"type\":\"string\",\"value\":\"\\\"one quote\\\"\"},\"one_space\":{\"type\":\"string\",\"value\":\" \\\"one quote\\\" \"},\"two\":{\"type\":\"string\",\"value\":\"\\\"\\\"two quotes\\\"\\\"\"},\"two_space\":{\"type\":\"string\",\"value\":\" \\\"\\\"two quotes\\\"\\\" \"}}")
}

///|
test "valid__string__nl" {
  assert_toml_valid("valid/string/nl.toml", "nl_mid = \"val\\nue\"\nnl_end = \"\"\"value\\n\"\"\"\n\nlit_nl_end = '''value\\n'''\nlit_nl_mid = 'val\\nue'\nlit_nl_uni = 'val\\ue'\n", "{\"lit_nl_end\":{\"type\":\"string\",\"value\":\"value\\\\n\"},\"lit_nl_mid\":{\"type\":\"string\",\"value\":\"val\\\\nue\"},\"lit_nl_uni\":{\"type\":\"string\",\"value\":\"val\\\\ue\"},\"nl_end\":{\"type\":\"string\",\"value\":\"value\\n\"},\"nl_mid\":{\"type\":\"string\",\"value\":\"val\\nue\"}}")
}

///|
test "valid__string__quoted_unicode" {
  assert_toml_valid("valid/string/quoted-unicode.toml", "\nescaped_string = \"\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\"\nnot_escaped_string = '\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff'\n\nbasic_string = \"~  ÿ ퟿  ￿ 𐀀 􏿿\"\nliteral_string = '~  ÿ ퟿  ￿ 𐀀 􏿿'\n", str_from_bytes([123, 34, 98, 97, 115, 105, 99, 95, 115, 116, 114, 105, 110, 103, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 126, 32, 194, 128, 32, 195, 191, 32, 237, 159, 191, 32, 238, 128, 128, 32, 239, 191, 191, 32, 240, 144, 128, 128, 32, 244, 143, 191, 191, 34, 125, 44, 34, 101, 115, 99, 97, 112, 101, 100, 95, 115, 116, 114, 105, 110, 103, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 92, 117, 48, 48, 48, 48, 32, 92, 98, 32, 92, 102, 32, 65, 32, 127, 32, 194, 128, 32, 195, 191, 32, 237, 159, 191, 32, 238, 128, 128, 32, 239, 191, 191, 32, 240, 144, 128, 128, 32, 244, 143, 191, 191, 34, 125, 44, 34, 108, 105, 116, 101, 114, 97, 108, 95, 115, 116, 114, 105, 110, 103, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 126, 32, 194, 128, 32, 195, 191, 32, 237, 159, 191, 32, 238, 128, 128, 32, 239, 191, 191, 32, 240, 144, 128, 128, 32, 244, 143, 191, 191, 34, 125, 44, 34, 110, 111, 116, 95, 101, 115, 99, 97, 112, 101, 100, 95, 115, 116, 114, 105, 110, 103, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 92, 92, 117, 48, 48, 48, 48, 32, 92, 92, 117, 48, 48, 48, 56, 32, 92, 92, 117, 48, 48, 48, 99, 32, 92, 92, 85, 48, 48, 48, 48, 48, 48, 52, 49, 32, 92, 92, 117, 48, 48, 55, 102, 32, 92, 92, 117, 48, 48, 56, 48, 32, 92, 92, 117, 48, 48, 102, 102, 32, 92, 92, 117, 100, 55, 102, 102, 32, 92, 92, 117, 101, 48, 48, 48, 32, 92, 92, 117, 102, 102, 102, 102, 32, 92, 92, 85, 48, 48, 48, 49, 48, 48, 48, 48, 32, 92, 92, 85, 48, 48, 49, 48, 102, 102, 102, 102, 34, 125, 125]))
}

///|
test "valid__string__raw" {
  assert_toml_valid("valid/string/raw.toml", "backspace = 'This string has a \\b backspace character.'\ntab = 'This string has a \\t tab character.'\nunescaped_tab = 'This string has an \t unescaped tab character.'\nnewline = 'This string has a \\n new line character.'\nformfeed = 'This string has a \\f form feed character.'\ncarriage = 'This string has a \\r carriage return character.'\nslash = 'This string has a \\/ slash character.'\nbackslash = 'This string has a \\\\ backslash character.'\n", "{\"backslash\":{\"type\":\"string\",\"value\":\"This string has a \\\\\\\\ backslash character.\"},\"backspace\":{\"type\":\"string\",\"value\":\"This string has a \\\\b backspace character.\"},\"carriage\":{\"type\":\"string\",\"value\":\"This string has a \\\\r carriage return character.\"},\"formfeed\":{\"type\":\"string\",\"value\":\"This string has a \\\\f form feed character.\"},\"newline\":{\"type\":\"string\",\"value\":\"This string has a \\\\n new line character.\"},\"slash\":{\"type\":\"string\",\"value\":\"This string has a \\\\/ slash character.\"},\"tab\":{\"type\":\"string\",\"value\":\"This string has a \\\\t tab character.\"},\"unescaped_tab\":{\"type\":\"string\",\"value\":\"This string has an \\t unescaped tab character.\"}}")
}

///|
test "valid__string__raw_empty" {
  assert_toml_valid("valid/string/raw-empty.toml", "empty = ''\n", "{\"empty\":{\"type\":\"string\",\"value\":\"\"}}")
}

///|
test "valid__string__raw_multiline" {
  assert_toml_valid("valid/string/raw-multiline.toml", "# Single ' should be allowed.\noneline = '''This string has a ' quote character.'''\n\n# A newline immediately following the opening delimiter will be trimmed.\nfirstnl = '''\nThis string has a ' quote character.'''\n\n# All other whitespace and newline characters remain intact.\nmultiline = '''\nThis string\nhas ' a quote character\nand more than\none newline\nin it.'''\n\n# Tab character in literal string does not need to be escaped\nmultiline_with_tab = '''First line\n\t Followed by a tab'''\n\nthis-str-has-apostrophes='''' there's one already\n'' two more\n'''''\n", "{\"firstnl\":{\"type\":\"string\",\"value\":\"This string has a ' quote character.\"},\"multiline\":{\"type\":\"string\",\"value\":\"This string\\nhas ' a quote character\\nand more than\\none newline\\nin it.\"},\"multiline_with_tab\":{\"type\":\"string\",\"value\":\"First line\\n\\t Followed by a tab\"},\"oneline\":{\"type\":\"string\",\"value\":\"This string has a ' quote character.\"},\"this-str-has-apostrophes\":{\"type\":\"string\",\"value\":\"' there's one already\\n'' two more\\n''\"}}")
}

///|
test "valid__string__simple" {
  assert_toml_valid("valid/string/simple.toml", "answer = \"You are not drinking enough whisky.\"\n", "{\"answer\":{\"type\":\"string\",\"value\":\"You are not drinking enough whisky.\"}}")
}

///|
test "valid__string__start_mb" {
  assert_toml_valid("valid/string/start-mb.toml", "# Start first line with a multibyte character.\n#\n# https://github.com/marzer/tomlplusplus/issues/190\ns1 = \"§\"\ns2 = '§'\ns3 = \"\"\"\\\n§\"\"\"\ns4 = \"\"\"\n§\"\"\"\ns5 = \"\"\"§\"\"\"\ns6 = '''\n§'''\ns7 = '''§'''\n", "{\"s1\":{\"type\":\"string\",\"value\":\"§\"},\"s2\":{\"type\":\"string\",\"value\":\"§\"},\"s3\":{\"type\":\"string\",\"value\":\"§\"},\"s4\":{\"type\":\"string\",\"value\":\"§\"},\"s5\":{\"type\":\"string\",\"value\":\"§\"},\"s6\":{\"type\":\"string\",\"value\":\"§\"},\"s7\":{\"type\":\"string\",\"value\":\"§\"}}")
}

///|
test "valid__string__unicode_escape" {
  assert_toml_valid("valid/string/unicode-escape.toml", "delta-1 = \"\\u03B4\"\ndelta-2 = \"\\U000003B4\"\na       = \"\\u0061\"\nb       = \"\\u0062\"\nc       = \"\\U00000063\"\nnull-1  = \"\\u0000\"\nnull-2  = \"\\U00000000\"\n\nml-delta-1 = \"\"\"\\u03B4\"\"\"\nml-delta-2 = \"\"\"\\U000003B4\"\"\"\nml-a       = \"\"\"\\u0061\"\"\"\nml-b       = \"\"\"\\u0062\"\"\"\nml-c       = \"\"\"\\U00000063\"\"\"\nml-null-1  = \"\"\"\\u0000\"\"\"\nml-null-2  = \"\"\"\\U00000000\"\"\"\n", "{\"a\":{\"type\":\"string\",\"value\":\"a\"},\"b\":{\"type\":\"string\",\"value\":\"b\"},\"c\":{\"type\":\"string\",\"value\":\"c\"},\"delta-1\":{\"type\":\"string\",\"value\":\"δ\"},\"delta-2\":{\"type\":\"string\",\"value\":\"δ\"},\"ml-a\":{\"type\":\"string\",\"value\":\"a\"},\"ml-b\":{\"type\":\"string\",\"value\":\"b\"},\"ml-c\":{\"type\":\"string\",\"value\":\"c\"},\"ml-delta-1\":{\"type\":\"string\",\"value\":\"δ\"},\"ml-delta-2\":{\"type\":\"string\",\"value\":\"δ\"},\"ml-null-1\":{\"type\":\"string\",\"value\":\"\\u0000\"},\"ml-null-2\":{\"type\":\"string\",\"value\":\"\\u0000\"},\"null-1\":{\"type\":\"string\",\"value\":\"\\u0000\"},\"null-2\":{\"type\":\"string\",\"value\":\"\\u0000\"}}")
}

///|
test "valid__string__with_pound" {
  assert_toml_valid("valid/string/with-pound.toml", "pound = \"We see no # comments here.\"\npoundcomment = \"But there are # some comments here.\" # Did I # mess you up?\n", "{\"pound\":{\"type\":\"string\",\"value\":\"We see no # comments here.\"},\"poundcomment\":{\"type\":\"string\",\"value\":\"But there are # some comments here.\"}}")
}

///|
test "valid__table__array_empty" {
  assert_toml_valid("valid/table/array-empty.toml", "[[a]]\n", "{\"a\":[{}]}")
}

///|
test "valid__table__array_empty_name" {
  assert_toml_valid("valid/table/array-empty-name.toml", "# Silly thing to do, but valid.\n\n[['']]\na = 1\n[['']]\na = 2\n", "{\"\":[{\"a\":{\"type\":\"integer\",\"value\":\"1\"}},{\"a\":{\"type\":\"integer\",\"value\":\"2\"}}]}")
}

///|
test "valid__table__array_implicit" {
  assert_toml_valid("valid/table/array-implicit.toml", "[[albums.songs]]\nname = \"Glory Days\"\n", "{\"albums\":{\"songs\":[{\"name\":{\"type\":\"string\",\"value\":\"Glory Days\"}}]}}")
}

///|
test "valid__table__array_implicit_and_explicit_after" {
  assert_toml_valid("valid/table/array-implicit-and-explicit-after.toml", "[[a.b]]\nx = 1\n\n[a]\ny = 2\n", "{\"a\":{\"b\":[{\"x\":{\"type\":\"integer\",\"value\":\"1\"}}],\"y\":{\"type\":\"integer\",\"value\":\"2\"}}}")
}

///|
test "valid__table__array_many" {
  assert_toml_valid("valid/table/array-many.toml", "[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n\n[[people]]\nfirst_name = \"Eric\"\nlast_name = \"Clapton\"\n\n[[people]]\nfirst_name = \"Bob\"\nlast_name = \"Seger\"\n", "{\"people\":[{\"first_name\":{\"type\":\"string\",\"value\":\"Bruce\"},\"last_name\":{\"type\":\"string\",\"value\":\"Springsteen\"}},{\"first_name\":{\"type\":\"string\",\"value\":\"Eric\"},\"last_name\":{\"type\":\"string\",\"value\":\"Clapton\"}},{\"first_name\":{\"type\":\"string\",\"value\":\"Bob\"},\"last_name\":{\"type\":\"string\",\"value\":\"Seger\"}}]}")
}

///|
test "valid__table__array_nest" {
  assert_toml_valid("valid/table/array-nest.toml", "[[albums]]\nname = \"Born to Run\"\n\n  [[albums.songs]]\n  name = \"Jungleland\"\n\n  [[albums.songs]]\n  name = \"Meeting Across the River\"\n\n[[albums]]\nname = \"Born in the USA\"\n  \n  [[albums.songs]]\n  name = \"Glory Days\"\n\n  [[albums.songs]]\n  name = \"Dancing in the Dark\"\n", "{\"albums\":[{\"name\":{\"type\":\"string\",\"value\":\"Born to Run\"},\"songs\":[{\"name\":{\"type\":\"string\",\"value\":\"Jungleland\"}},{\"name\":{\"type\":\"string\",\"value\":\"Meeting Across the River\"}}]},{\"name\":{\"type\":\"string\",\"value\":\"Born in the USA\"},\"songs\":[{\"name\":{\"type\":\"string\",\"value\":\"Glory Days\"}},{\"name\":{\"type\":\"string\",\"value\":\"Dancing in the Dark\"}}]}]}")
}

///|
test "valid__table__array_one" {
  assert_toml_valid("valid/table/array-one.toml", "[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n", "{\"people\":[{\"first_name\":{\"type\":\"string\",\"value\":\"Bruce\"},\"last_name\":{\"type\":\"string\",\"value\":\"Springsteen\"}}]}")
}

///|
test "valid__table__array_table_array" {
  assert_toml_valid("valid/table/array-table-array.toml", "[[a]]\n    [[a.b]]\n        [a.b.c]\n            d = \"val0\"\n    [[a.b]]\n        [a.b.c]\n            d = \"val1\"\n", "{\"a\":[{\"b\":[{\"c\":{\"d\":{\"type\":\"string\",\"value\":\"val0\"}}},{\"c\":{\"d\":{\"type\":\"string\",\"value\":\"val1\"}}}]}]}")
}

///|
test "valid__table__array_within_dotted" {
  assert_toml_valid("valid/table/array-within-dotted.toml", "[fruit]\napple.color = \"red\"\n\n[[fruit.apple.seeds]]\nsize = 2\n", "{\"fruit\":{\"apple\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"seeds\":[{\"size\":{\"type\":\"integer\",\"value\":\"2\"}}]}}}")
}

///|
test "valid__table__empty" {
  assert_toml_valid("valid/table/empty.toml", "[a]\n", "{\"a\":{}}")
}

///|
test "valid__table__empty_name" {
  assert_toml_valid("valid/table/empty-name.toml", "['']\nx = 1\n\n[\"\".a]\nx = 2\n\n[a.'']\nx = 3\n", "{\"\":{\"x\":{\"type\":\"integer\",\"value\":\"1\"},\"a\":{\"x\":{\"type\":\"integer\",\"value\":\"2\"}}},\"a\":{\"\":{\"x\":{\"type\":\"integer\",\"value\":\"3\"}}}}")
}

///|
test "valid__table__keyword" {
  assert_toml_valid("valid/table/keyword.toml", "[true]\n\n[false]\n\n[inf]\n\n[nan]\n\n\n", "{\"false\":{},\"inf\":{},\"nan\":{},\"true\":{}}")
}

///|
test "valid__table__keyword_with_values" {
  assert_toml_valid("valid/table/keyword-with-values.toml", "[true]\nk = 1\n\n[false]\nk = 2\n\n[inf]\nk = 3\n\n[nan]\nk = 4\n", "{\"false\":{\"k\":{\"type\":\"integer\",\"value\":\"2\"}},\"inf\":{\"k\":{\"type\":\"integer\",\"value\":\"3\"}},\"nan\":{\"k\":{\"type\":\"integer\",\"value\":\"4\"}},\"true\":{\"k\":{\"type\":\"integer\",\"value\":\"1\"}}}")
}

///|
test "valid__table__names" {
  assert_toml_valid("valid/table/names.toml", "[a.b.c]\n[a.\"b.c\"]\n[a.'d.e']\n[a.' x ']\n[ d.e.f ]\n[ g . h . i ]\n[ j . \"ʞ\" . 'l' ]\n\n[x.1.2]\n", "{\"a\":{\" x \":{},\"b.c\":{},\"d.e\":{},\"b\":{\"c\":{}}},\"d\":{\"e\":{\"f\":{}}},\"g\":{\"h\":{\"i\":{}}},\"j\":{\"ʞ\":{\"l\":{}}},\"x\":{\"1\":{\"2\":{}}}}")
}

///|
test "valid__table__names_with_values" {
  assert_toml_valid("valid/table/names-with-values.toml", "[a.b.c]\nkey = 1\n\n[a.\"b.c\"]\nkey = 2\n\n[a.'d.e']\nkey = 3\n\n[a.' x ']\nkey = 4\n\n[ d.e.f ]\nkey = 5\n\n[ g . h . i ]\nkey = 6\n\n[ j . \"ʞ\" . 'l' ]\nkey = 7\n\n[x.1.2]\nkey = 8\n", "{\"a\":{\" x \":{\"key\":{\"type\":\"integer\",\"value\":\"4\"}},\"b\":{\"c\":{\"key\":{\"type\":\"integer\",\"value\":\"1\"}}},\"b.c\":{\"key\":{\"type\":\"integer\",\"value\":\"2\"}},\"d.e\":{\"key\":{\"type\":\"integer\",\"value\":\"3\"}}},\"d\":{\"e\":{\"f\":{\"key\":{\"type\":\"integer\",\"value\":\"5\"}}}},\"g\":{\"h\":{\"i\":{\"key\":{\"type\":\"integer\",\"value\":\"6\"}}}},\"j\":{\"ʞ\":{\"l\":{\"key\":{\"type\":\"integer\",\"value\":\"7\"}}}},\"x\":{\"1\":{\"2\":{\"key\":{\"type\":\"integer\",\"value\":\"8\"}}}}}")
}

///|
test "valid__table__no_eol_01" {
  assert_toml_valid("valid/table/no-eol-01.toml", "# No newline at end of file.\n[table]", "{\"table\":{}}")
}

///|
test "valid__table__no_eol_02" {
  assert_toml_valid("valid/table/no-eol-02.toml", "# No newline at end of file.\n[table]\na=1", "{\"table\":{\"a\":{\"type\":\"integer\",\"value\":\"1\"}}}")
}

///|
test "valid__table__sub" {
  assert_toml_valid("valid/table/sub.toml", "[a]\nkey = 1\n\n# a.extend is a key inside the \"a\" table.\n[a.extend]\nkey = 2\n\n[a.extend.more]\nkey = 3\n", "{\"a\":{\"key\":{\"type\":\"integer\",\"value\":\"1\"},\"extend\":{\"key\":{\"type\":\"integer\",\"value\":\"2\"},\"more\":{\"key\":{\"type\":\"integer\",\"value\":\"3\"}}}}}")
}

///|
test "valid__table__sub_empty" {
  assert_toml_valid("valid/table/sub-empty.toml", "[a]\n[a.b]\n", "{\"a\":{\"b\":{}}}")
}

///|
test "valid__table__whitespace" {
  assert_toml_valid("valid/table/whitespace.toml", "[\"valid key\"]\n", "{\"valid key\":{}}")
}

///|
test "valid__table__with_literal_string" {
  assert_toml_valid("valid/table/with-literal-string.toml", "['a']\n[a.'\"b\"']\n[a.'\"b\"'.c]\nanswer = 42 \n", "{\"a\":{\"\\\"b\\\"\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}")
}

///|
test "valid__table__with_pound" {
  assert_toml_valid("valid/table/with-pound.toml", "[\"key#group\"]\nanswer = 42\n", "{\"key#group\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}")
}

///|
test "valid__table__with_single_quotes" {
  assert_toml_valid("valid/table/with-single-quotes.toml", "['a']\n[a.'b']\n[a.'b'.c]\nanswer = 42 \n", "{\"a\":{\"b\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}")
}

///|
test "valid__table__without_super" {
  assert_toml_valid("valid/table/without-super.toml", "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\n[x] # defining a super-table afterwards is ok\n", "{\"x\":{\"y\":{\"z\":{\"w\":{}}}}}")
}

///|
test "valid__table__without_super_with_values" {
  assert_toml_valid("valid/table/without-super-with-values.toml", "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\na = 1\nb = 2\n[x] # defining a super-table afterwards is ok\nc = 3\nd = 4\n", "{\"x\":{\"c\":{\"type\":\"integer\",\"value\":\"3\"},\"d\":{\"type\":\"integer\",\"value\":\"4\"},\"y\":{\"z\":{\"w\":{\"a\":{\"type\":\"integer\",\"value\":\"1\"},\"b\":{\"type\":\"integer\",\"value\":\"2\"}}}}}}")
}
