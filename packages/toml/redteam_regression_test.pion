///| Regression tests for red-team P0/P1/P2 fixes:
///| - F1: bit-exact IEEE-754 float formatting (Ryu) for stringify & to_toml_test_json
///| - F2: float overflow rejection (1e400, -1.5e309)
///| - F3: stringify validation (duplicate keys, invalid/injected datetimes)
///| - F4: leading UTF-8 BOM support
///| - F5: accurate error line & character column reporting
///| - F7: canonical datetime normalization
///| - F8/F9: recursion depth guard & linear-time inline table sealing
///| - F10/F11: seeded hash index & O(1) toml::get on wide tables

fn rt_assert_float(lit : String) -> Unit {
  let src = "x = " + lit + "\n"
  match parse(src) {
    Ok(root) => {
      let v1 = match get(root, "x") {
        Some(v) =>
        match as_float(v) {
          Some(f) => f
          None => {
            debug_assert(false, "not a float: " + lit)
            return
          }
        }
        None => {
          debug_assert(false, "missing x: " + lit)
          return
        }
      }
      match stringify(root) {
        Ok(out) =>
        match parse(out) {
          Ok(root2) =>
          match get(root2, "x") {
            Some(v2) =>
            match as_float(v2) {
              Some(f2) =>
              debug_assert(
                f2.reinterpret_as_uint64() == v1.reinterpret_as_uint64(),
                "float bits changed: " + lit + " -> " + out,
              )
              None => debug_assert(false, "not a float after roundtrip: " + out)
            }
            None => debug_assert(false, "missing x after roundtrip: " + out)
          }
          Err(e) => debug_assert(false, "re-parse failed: " + e.message + " on " + out)
        }
        Err(e) => debug_assert(false, "stringify failed: " + e.message)
      }
    }
    Err(e) => debug_assert(false, "parse failed for " + lit + ": " + e.message)
  }
}

///|
test "rt_f1_bit_exact_floats" {
  rt_assert_float("0.0")
  rt_assert_float("-0.0")
  rt_assert_float("1.0")
  rt_assert_float("-1.0")
  rt_assert_float("0.8311652289356479")
  rt_assert_float("0.7985979778608974")
  rt_assert_float("0.6533258370806696")
  rt_assert_float("0.8481777226837237")
  rt_assert_float("1.7976931348623157e308")
  rt_assert_float("-1.7976931348623157e308")
  rt_assert_float("2.2250738585072014e-308")
  rt_assert_float("5e-324")
  rt_assert_float("-5e-324")
  rt_assert_float("2.225073858507201e-308")
  rt_assert_float("-1.989032661366619e+244")
  rt_assert_float("3.980498358697587e-249")
  rt_assert_float("9007199254740992.0")
  rt_assert_float("9007199254740991.0")
  rt_assert_float("1e-5")
  rt_assert_float("1e15")
  rt_assert_float("1e16")
}

///|
test "rt_f2_float_overflow_rejected" {
  match parse("a = 1e400\n") {
    Ok(_) => debug_assert(false, "1e400 should fail")
    Err(_) => ()
  }
  match parse("a = -1.5e309\n") {
    Ok(_) => debug_assert(false, "-1.5e309 should fail")
    Err(_) => ()
  }
  match parse("a = 1.7976931348623159e308\n") {
    Ok(_) => debug_assert(false, "slightly above DBL_MAX should fail")
    Err(_) => ()
  }
}

///|
test "rt_f3_stringify_validation" {
  match stringify(TomlValue::Table([("d", TomlValue::LocalDate("not a date"))])) {
    Ok(_) => debug_assert(false, "invalid LocalDate must fail")
    Err(_) => ()
  }
  match stringify(TomlValue::Table([("d", TomlValue::OffsetDateTime(""))])) {
    Ok(_) => debug_assert(false, "empty OffsetDateTime must fail")
    Err(_) => ()
  }
  match stringify(TomlValue::Table([("d", TomlValue::LocalTime("07:32:00\nadmin = true"))])) {
    Ok(_) => debug_assert(false, "injected LocalTime must fail")
    Err(_) => ()
  }
  match stringify(TomlValue::Table([("a", TomlValue::Int(1L)), ("a", TomlValue::Int(2L))])) {
    Ok(_) => debug_assert(false, "duplicate keys must fail")
    Err(_) => ()
  }
}

///|
test "rt_f4_utf8_bom" {
  let body = "k = 42\n"
  let b = Bytes::new(3 + body.length())
  b[0] = (0xEF).to_byte()
  b[1] = (0xBB).to_byte()
  b[2] = (0xBF).to_byte()
  let mut i = 0
  while i < body.length() {
    b[3 + i] = body.code_unit_at(i).to_byte()
    i = i + 1
  }
  match parse_bytes(b) {
    Ok(root) =>
    match get(root, "k") {
      Some(TomlValue::Int(v)) => debug_assert(v == 42L, "wrong value after BOM")
      _ => debug_assert(false, "wrong value after BOM")
    }
    Err(e) => debug_assert(false, "BOM rejected: " + e.message)
  }
}

///|
test "rt_f5_error_positions" {
  match parse("a = 1\na = 2\n") {
    Err(e) => debug_assert(e.line == 2 && e.col == 1, "dup key pos")
    Ok(_) => debug_assert(false, "expected err")
  }
  match parse("[a]\n[a]\nx = 1\n") {
    Err(e) => debug_assert(e.line == 2, "dup table line")
    Ok(_) => debug_assert(false, "expected err")
  }
  match parse("a = [1,\n  2\n") {
    Err(e) => debug_assert(e.line == 2, "unclosed array line")
    Ok(_) => debug_assert(false, "expected err")
  }
  match parse("a = \"é\" x\n") {
    Err(e) => debug_assert(e.col == 9, "utf8 char col")
    Ok(_) => debug_assert(false, "expected err")
  }
}

///|
test "rt_f8_recursion_limits" {
  let sb = StringBuilder::new()
  sb.write_string("a = ")
  let mut i = 0
  while i < 200 {
    sb.write_byte((91).to_byte())
    i = i + 1
  }
  i = 0
  while i < 200 {
    sb.write_byte((93).to_byte())
    i = i + 1
  }
  sb.write_byte((10).to_byte())
  match parse(sb.to_string()) {
    Ok(_) => debug_assert(false, "deep array should hit recursion limit")
    Err(_) => ()
  }
}

///|
test "rt_f11_wide_table_get" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 500 {
    sb.write_string("key_")
    sb.write_string(i.to_string())
    sb.write_string(" = ")
    sb.write_string(i.to_string())
    sb.write_byte((10).to_byte())
    i = i + 1
  }
  match parse(sb.to_string()) {
    Ok(root) => {
      let mut j = 0
      while j < 500 {
        let k = "key_" + j.to_string()
        match get(root, k) {
          Some(TomlValue::Int(v)) => debug_assert(v == j.to_int64(), "wrong val")
          _ => debug_assert(false, "missing key " + k)
        }
        j = j + 1
      }
      match get(root, "nonexistent") {
        None => ()
        Some(_) => debug_assert(false, "unexpected hit")
      }
    }
    Err(e) => debug_assert(false, "parse wide table failed: " + e.message)
  }
}
