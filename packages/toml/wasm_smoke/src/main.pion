///| Wasm32 smoke entry for the `toml` package.

import "toml"

///|
pub fn smoke() -> Int {
  let doc = "name = \"pion\"\nversion = 1\npi = 3.14\nok = true\n[meta]\ntags = [\"toml\", \"wasm\"]\n"
  let parsed = match toml::parse(doc) {
    Ok(v) => v
    Err(_) => return 1
  }
  let encoded = match toml::stringify(parsed) {
    Ok(s) => s
    Err(_) => return 2
  }
  let json = toml::to_toml_test_json(parsed)
  encoded.length() + json.length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
