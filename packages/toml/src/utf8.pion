///| Strict UTF-8 validation and UTF-8 encoding helpers for TOML v1.0.0.

///| Encode a valid Unicode scalar value (0..=0x10FFFF, excluding surrogates) as UTF-8.
fn write_utf8(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Compute (line, col) 1-based position at byte offset `off` in `s`,
///| starting from `start_off` (0 normally, or 3 when a leading UTF-8 BOM was skipped).
///| Columns count Unicode scalar values (non-continuation UTF-8 bytes).
fn line_col_at_from(s : String, start_off : Int, off : Int) -> (Int, Int) {
  let n = s.length()
  let limit = if off < n { off } else { n }
  let mut line = 1
  let mut col = 1
  let mut i = if start_off < limit { start_off } else { limit }
  while i < limit {
    let b = s.code_unit_at(i)
    if b == 10 {
      line = line + 1
      col = 1
    } else if (b & 0xC0) != 0x80 {
      col = col + 1
    }
    i = i + 1
  }
  (line, col)
}

///| Compute (line, col) 1-based position at byte offset `off` in `s`.
fn line_col_at(s : String, off : Int) -> (Int, Int) {
  line_col_at_from(s, 0, off)
}

///| Validate a UTF-8 byte sequence in a `String`. Rejects overlong sequences,
///| UTF-16 surrogates (U+D800..U+DFFF), code points > U+10FFFF, and truncated sequences.
fn validate_utf8_str(s : String) -> Result[Unit, TomlError] {
  let n = s.length()
  let mut i = 0
  while i < n {
    // 8-byte unrolled ASCII fast path
    while i + 8 <= n {
      let acc = s.code_unit_at(i) |
      s.code_unit_at(i + 1) |
      s.code_unit_at(i + 2) |
      s.code_unit_at(i + 3) |
      s.code_unit_at(i + 4) |
      s.code_unit_at(i + 5) |
      s.code_unit_at(i + 6) |
      s.code_unit_at(i + 7)
      if acc >= 0x80 {
        break
      }
      i = i + 8
    }
    if i >= n {
      break
    }
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "truncated 2-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "truncated 3-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "overlong 3-byte UTF-8 sequence"))
      }
      if b0 == 0xED && b1 >= 0xA0 {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "UTF-16 surrogate code point in UTF-8"))
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "truncated 4-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xF0 && b1 < 0x90 {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "overlong 4-byte UTF-8 sequence"))
      }
      if b0 == 0xF4 && b1 > 0x8F {
        let (ln, cl) = line_col_at(s, i)
        return Err(TomlError::new(ln, cl, i, "UTF-8 code point above U+10FFFF"))
      }
      i = i + 4
    } else {
      let (ln, cl) = line_col_at(s, i)
      return Err(TomlError::new(ln, cl, i, "invalid UTF-8 lead byte"))
    }
  }
  Ok(())
}

fn line_col_bytes(bs : Bytes, off : Int) -> (Int, Int) {
  let n = bs.length()
  let limit = if off < n { off } else { n }
  let mut line = 1
  let mut col = 1
  let mut i = 0
  while i < limit {
    let b = bs[i].to_int()
    if b == 10 {
      line = line + 1
      col = 1
    } else if (b & 0xC0) != 0x80 {
      col = col + 1
    }
    i = i + 1
  }
  (line, col)
}

///| Validate raw `Bytes` as strict UTF-8 and convert to a `String`.
fn validate_utf8_bytes(bs : Bytes) -> Result[String, TomlError] {
  let n = bs.length()
  let mut i = 0
  while i < n {
    while i + 8 <= n {
      let acc = bs[i].to_int() |
      bs[i + 1].to_int() |
      bs[i + 2].to_int() |
      bs[i + 3].to_int() |
      bs[i + 4].to_int() |
      bs[i + 5].to_int() |
      bs[i + 6].to_int() |
      bs[i + 7].to_int()
      if acc >= 0x80 {
        break
      }
      i = i + 8
    }
    if i >= n {
      break
    }
    let b0 = bs[i].to_int()
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "truncated 2-byte UTF-8 sequence"))
      }
      let b1 = bs[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "truncated 3-byte UTF-8 sequence"))
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "overlong 3-byte UTF-8 sequence"))
      }
      if b0 == 0xED && b1 >= 0xA0 {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "UTF-16 surrogate code point in UTF-8"))
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "truncated 4-byte UTF-8 sequence"))
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      let b3 = bs[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xF0 && b1 < 0x90 {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "overlong 4-byte UTF-8 sequence"))
      }
      if b0 == 0xF4 && b1 > 0x8F {
        let (ln, cl) = line_col_bytes(bs, i)
        return Err(TomlError::new(ln, cl, i, "UTF-8 code point above U+10FFFF"))
      }
      i = i + 4
    } else {
      let (ln, cl) = line_col_bytes(bs, i)
      return Err(TomlError::new(ln, cl, i, "invalid UTF-8 lead byte"))
    }
  }
  let sb = StringBuilder::with_capacity(n)
  let mut j = 0
  while j < n {
    sb.write_byte(bs[j])
    j = j + 1
  }
  Ok(sb.to_string())
}
