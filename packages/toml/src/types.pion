///| Core types and value accessors for the `toml` package (TOML v1.0.0).

///| Error returned when parsing or serializing TOML fails.
pub struct TomlError {
  pub line : Int
  pub col : Int
  pub offset : Int
  pub message : String
}

///| Construct a `TomlError`.
pub fn TomlError::new(
  line : Int,
  col : Int,
  offset : Int,
  message : String,
) -> TomlError {
  TomlError::{ line: line, col: col, offset: offset, message: message }
}

///| Immutable TOML v1.0.0 value tree.
///| Tables preserve key insertion order for deterministic serialization.
pub enum TomlValue {
  Str(String)
  Int(Int64)
  Float(Double)
  Bool(Bool)
  OffsetDateTime(String)
  LocalDateTime(String)
  LocalDate(String)
  LocalTime(String)
  Array(Array[TomlValue])
  Table(Array[(String, TomlValue)])
}

///| Look up a key in a `TomlValue::Table`.
pub fn get(value : TomlValue, key : String) -> Option[TomlValue] {
  match value {
    TomlValue::Table(entries) => {
      let mut i = 0
      let n = entries.length()
      while i < n {
        let (k, v) = entries[i]
        if k == key {
          return Some(v)
        }
        i = i + 1
      }
      None
    }
    _ => None
  }
}

///| Look up an element by index in a `TomlValue::Array`.
pub fn get_index(value : TomlValue, index : Int) -> Option[TomlValue] {
  match value {
    TomlValue::Array(items) => {
      if index >= 0 && index < items.length() {
        Some(items[index])
      } else {
        None
      }
    }
    _ => None
  }
}

///| Extract a `String` if this value is `TomlValue::Str`.
pub fn as_str(value : TomlValue) -> Option[String] {
  match value {
    TomlValue::Str(s) => Some(s)
    _ => None
  }
}

///| Extract an `Int64` if this value is `TomlValue::Int`.
pub fn as_int(value : TomlValue) -> Option[Int64] {
  match value {
    TomlValue::Int(v) => Some(v)
    _ => None
  }
}

///| Extract a `Double` if this value is `TomlValue::Float`.
pub fn as_float(value : TomlValue) -> Option[Double] {
  match value {
    TomlValue::Float(v) => Some(v)
    _ => None
  }
}

///| Extract a `Bool` if this value is `TomlValue::Bool`.
pub fn as_bool(value : TomlValue) -> Option[Bool] {
  match value {
    TomlValue::Bool(v) => Some(v)
    _ => None
  }
}

///| Extract an offset date-time string if this value is `TomlValue::OffsetDateTime`.
pub fn as_datetime(value : TomlValue) -> Option[String] {
  match value {
    TomlValue::OffsetDateTime(s) => Some(s)
    _ => None
  }
}

///| Extract a local date-time string if this value is `TomlValue::LocalDateTime`.
pub fn as_local_datetime(value : TomlValue) -> Option[String] {
  match value {
    TomlValue::LocalDateTime(s) => Some(s)
    _ => None
  }
}

///| Extract a local date string if this value is `TomlValue::LocalDate`.
pub fn as_local_date(value : TomlValue) -> Option[String] {
  match value {
    TomlValue::LocalDate(s) => Some(s)
    _ => None
  }
}

///| Extract a local time string if this value is `TomlValue::LocalTime`.
pub fn as_local_time(value : TomlValue) -> Option[String] {
  match value {
    TomlValue::LocalTime(s) => Some(s)
    _ => None
  }
}

///| Extract the elements if this value is `TomlValue::Array`.
pub fn as_array(value : TomlValue) -> Option[Array[TomlValue]] {
  match value {
    TomlValue::Array(items) => Some(items)
    _ => None
  }
}

///| Extract the entries if this value is `TomlValue::Table`.
pub fn as_table(value : TomlValue) -> Option[Array[(String, TomlValue)]] {
  match value {
    TomlValue::Table(entries) => Some(entries)
    _ => None
  }
}

///| Return the length of an array, table, or string, or 0 for scalar values.
pub fn value_len(value : TomlValue) -> Int {
  match value {
    TomlValue::Array(items) => items.length()
    TomlValue::Table(entries) => entries.length()
    TomlValue::Str(s) => s.length()
    _ => 0
  }
}

///| Return whether an array, table, or string is empty.
pub fn is_empty(value : TomlValue) -> Bool {
  value_len(value) == 0
}
