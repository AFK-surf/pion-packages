///| Seeded open-addressing hash index for `ParseTable`, `stringify` duplicate
///| checks, and O(1) `toml::get` on large tables.
///|
///| Uses SplitMix64 + input/counter-derived 64-bit seed to defeat HashDoS attacks
///| targeting the unseeded runtime `Map[String, Int]`.

struct SeedState {
  mut counter : UInt64
}

let seed_state : SeedState = SeedState::{ counter: 0x9E3779B97F4A7C15UL }

fn splitmix64(x : UInt64) -> UInt64 {
  let mut z = x + 0x9E3779B97F4A7C15UL
  z = (z ^ (z >> 30UL)) * 0xBF58476D1CE4E5B9UL
  z = (z ^ (z >> 27UL)) * 0x94D049BB133111EBUL
  z ^ (z >> 31UL)
}

fn next_seed() -> UInt64 {
  seed_state.counter = seed_state.counter + 0x9E3779B97F4A7C15UL
  splitmix64(seed_state.counter)
}

fn derive_doc_seed(src : String) -> UInt64 {
  let n = src.length()
  let mut s = next_seed() ^ (n.to_int64().reinterpret_as_uint64() * 0xD6E8FEB86659FD93UL)
  if n > 0 {
    s = splitmix64(s ^ src.code_unit_at(0).to_int64().reinterpret_as_uint64())
    s = splitmix64(s ^ src.code_unit_at(n >> 1).to_int64().reinterpret_as_uint64())
    s = splitmix64(s ^ src.code_unit_at(n - 1).to_int64().reinterpret_as_uint64())
    let step = if n > 64 { n >> 4 } else { 1 }
    let mut i = 0
    let mut samples = 0
    while i < n && samples < 16 {
      s = splitmix64(s ^ (src.code_unit_at(i).to_int64().reinterpret_as_uint64() + (i.to_int64().reinterpret_as_uint64() << 8UL)))
      i = i + step
      samples = samples + 1
    }
  }
  s
}

///| Seeded 64-bit string hash (non-zero).
fn hash_str_seeded(s : String, seed : UInt64) -> UInt64 {
  let n = s.length()
  let mut h = seed ^ (n.to_int64().reinterpret_as_uint64() * 0x9E3779B97F4A7C15UL)
  let mut i = 0
  while i + 4 <= n {
    let w = s.code_unit_at(i).to_int64().reinterpret_as_uint64() |
    (s.code_unit_at(i + 1).to_int64().reinterpret_as_uint64() << 8UL) |
    (s.code_unit_at(i + 2).to_int64().reinterpret_as_uint64() << 16UL) |
    (s.code_unit_at(i + 3).to_int64().reinterpret_as_uint64() << 24UL)
    h = (h ^ w) * 0xBF58476D1CE4E5B9UL
    h = h ^ (h >> 27UL)
    i = i + 4
  }
  while i < n {
    h = (h ^ s.code_unit_at(i).to_int64().reinterpret_as_uint64()) * 0x94D049BB133111EBUL
    h = h ^ (h >> 31UL)
    i = i + 1
  }
  h = (h ^ (h >> 30UL)) * 0xBF58476D1CE4E5B9UL
  h = (h ^ (h >> 27UL)) * 0x94D049BB133111EBUL
  h = h ^ (h >> 31UL)
  if h == 0UL { 1UL } else { h }
}

struct HashIndex {
  seed : UInt64
  mut cap : Int
  mut len : Int
  mut keys : FixedArray[String]
  mut hashes : FixedArray[UInt64]
  ///| entry_idx + 1 (0 means empty slot)
  mut vals : FixedArray[Int]
  ///| subtable/AoT index in `ParseTable.subs` (-1 if scalar/plain array)
  mut subs : FixedArray[Int]
  ///| side-channel sub_idx from last `get_entry_and_sub_sc`
  mut last_sub : Int
  ///| side-channel hash & empty slot from last miss in `get_entry_and_sub_sc`
  mut last_hash : UInt64
  mut last_slot : Int
}

fn HashIndex::new(initial_cap : Int, seed : UInt64) -> HashIndex {
  let mut c = 32
  while c < initial_cap {
    c = c << 1
  }
  HashIndex::{
    seed: seed,
    cap: c,
    len: 0,
    keys: FixedArray::make(c, ""),
    hashes: FixedArray::make(c, 0UL),
    vals: FixedArray::make(c, 0),
    subs: FixedArray::make(c, -1),
    last_sub: -1,
    last_hash: 0UL,
    last_slot: -1,
  }
}

fn HashIndex::grow(self : HashIndex) -> Unit {
  let old_cap = self.cap
  let old_keys = self.keys
  let old_hashes = self.hashes
  let old_vals = self.vals
  let old_subs = self.subs
  let new_cap = old_cap << 1
  let new_mask_int = new_cap - 1
  let new_mask = new_mask_int.to_int64().reinterpret_as_uint64()
  let new_keys = FixedArray::make(new_cap, "")
  let new_hashes = FixedArray::make(new_cap, 0UL)
  let new_vals = FixedArray::make(new_cap, 0)
  let new_subs = FixedArray::make(new_cap, -1)
  let mut i = 0
  while i < old_cap {
    let v = old_vals[i]
    if v != 0 {
      let h = old_hashes[i]
      let mut slot = (h & new_mask).to_int()
      while new_vals[slot] != 0 {
        slot = (slot + 1) & new_mask_int
      }
      new_keys[slot] = old_keys[i]
      new_hashes[slot] = h
      new_vals[slot] = v
      new_subs[slot] = old_subs[i]
    }
    i = i + 1
  }
  self.cap = new_cap
  self.keys = new_keys
  self.hashes = new_hashes
  self.vals = new_vals
  self.subs = new_subs
}

///| Look up `key`; returns `entry_idx` or `-1` if absent.
fn HashIndex::get_entry(self : HashIndex, key : String) -> Int {
  let h = hash_str_seeded(key, self.seed)
  let mask = self.cap - 1
  let vals = self.vals
  let hashes = self.hashes
  let keys = self.keys
  let mut slot = (h & mask.to_int64().reinterpret_as_uint64()).to_int()
  while true {
    let v = vals[slot]
    if v == 0 {
      return -1
    }
    if hashes[slot] == h && keys[slot] == key {
      return v - 1
    }
    slot = (slot + 1) & mask
  }
  -1
}

///| Look up `key`; returns `entry_idx` or `-1` if absent, and writes `sub_idx` to `self.last_sub`.
///| Zero tuple allocation.
fn HashIndex::get_entry_and_sub_sc(self : HashIndex, key : String) -> Int {
  let h = hash_str_seeded(key, self.seed)
  let mask = self.cap - 1
  let vals = self.vals
  let hashes = self.hashes
  let keys = self.keys
  let mut slot = (h & mask.to_int64().reinterpret_as_uint64()).to_int()
  while true {
    let v = vals[slot]
    if v == 0 {
      self.last_sub = -1
      self.last_hash = h
      self.last_slot = slot
      return -1
    }
    if hashes[slot] == h && keys[slot] == key {
      self.last_sub = self.subs[slot]
      return v - 1
    }
    slot = (slot + 1) & mask
  }
  self.last_sub = -1
  self.last_slot = -1
  -1
}

///| Insert a new key right after a miss in `get_entry_and_sub_sc`, reusing the
///| already-computed hash and empty slot when no resize is needed.
fn HashIndex::insert_after_miss(
  self : HashIndex,
  key : String,
  entry_idx : Int,
  sub_idx : Int,
) -> Unit {
  if self.len * 8 >= self.cap * 5 || self.last_slot < 0 {
    self.insert(key, entry_idx, sub_idx)
    return
  }
  let slot = self.last_slot
  self.keys[slot] = key
  self.hashes[slot] = self.last_hash
  self.vals[slot] = entry_idx + 1
  self.subs[slot] = sub_idx
  self.len = self.len + 1
}

///| Insert a new key -> (entry_idx, sub_idx). Assumes key is not already present.
fn HashIndex::insert(self : HashIndex, key : String, entry_idx : Int, sub_idx : Int) -> Unit {
  if self.len * 8 >= self.cap * 5 {
    self.grow()
  }
  let h = hash_str_seeded(key, self.seed)
  let mask = self.cap - 1
  let vals = self.vals
  let mut slot = (h & mask.to_int64().reinterpret_as_uint64()).to_int()
  while vals[slot] != 0 {
    slot = (slot + 1) & mask
  }
  self.keys[slot] = key
  self.hashes[slot] = h
  vals[slot] = entry_idx + 1
  self.subs[slot] = sub_idx
  self.len = self.len + 1
}

///| Insert `key` -> `(entry_idx, sub_idx)` if absent in a single hash + probe.
///| Returns `false` if duplicate.
fn HashIndex::insert_unique_with_sub(
  self : HashIndex,
  key : String,
  entry_idx : Int,
  sub_idx : Int,
) -> Bool {
  if self.len * 8 >= self.cap * 5 {
    self.grow()
  }
  let h = hash_str_seeded(key, self.seed)
  let mask = self.cap - 1
  let vals = self.vals
  let hashes = self.hashes
  let keys = self.keys
  let mut slot = (h & mask.to_int64().reinterpret_as_uint64()).to_int()
  while true {
    let v = vals[slot]
    if v == 0 {
      keys[slot] = key
      hashes[slot] = h
      vals[slot] = entry_idx + 1
      self.subs[slot] = sub_idx
      self.len = self.len + 1
      return true
    }
    if hashes[slot] == h && keys[slot] == key {
      return false
    }
    slot = (slot + 1) & mask
  }
  false
}

///| Insert `key` -> `entry_idx` if absent; returns `false` if duplicate.
fn HashIndex::insert_unique(self : HashIndex, key : String, entry_idx : Int) -> Bool {
  self.insert_unique_with_sub(key, entry_idx, -1)
}
