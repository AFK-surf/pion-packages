///| Pure Pion TOML v1.0.0 parser, serializer, and toml-test JSON encoder.

///| Parse a TOML v1.0.0 document from a UTF-8 `String`.
pub fn parse(src : String) -> Result[TomlValue, TomlError] {
  let _ = src
  Err(TomlError::new(1, 1, 0, "not implemented"))
}

///| Parse a TOML v1.0.0 document from raw `Bytes` (strict UTF-8 validation).
pub fn parse_bytes(src : Bytes) -> Result[TomlValue, TomlError] {
  let _ = src
  Err(TomlError::new(1, 1, 0, "not implemented"))
}

///| Serialize a `TomlValue` (must be a `TomlValue::Table`) to a TOML v1.0.0 `String`.
pub fn stringify(value : TomlValue) -> Result[String, TomlError] {
  let _ = value
  Err(TomlError::new(1, 1, 0, "not implemented"))
}

///| Encode a `TomlValue` into the official `toml-test` tagged JSON format.
pub fn to_toml_test_json(value : TomlValue) -> String {
  let _ = value
  "{}"
}
