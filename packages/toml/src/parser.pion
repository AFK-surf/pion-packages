///| Byte-indexed TOML v1.0.0 recursive-descent parser with direct TomlValue
///| construction, lazy seeded HashIndex (HashDoS-resistant), explicit recursion
///| depth guards, zero-allocation hot paths, and full spec conflict detection.

let max_parse_depth : Int = 128
let small_table_limit : Int = 16

fn make_bare_key_lut() -> FixedArray[Byte] {
  let lut : FixedArray[Byte] = FixedArray::make(256, (0).to_byte())
  let mut i = 65
  while i <= 90 {
    lut[i] = (1).to_byte()
    i = i + 1
  }
  i = 97
  while i <= 122 {
    lut[i] = (1).to_byte()
    i = i + 1
  }
  i = 48
  while i <= 57 {
    lut[i] = (1).to_byte()
    i = i + 1
  }
  lut[95] = (1).to_byte()
  lut[45] = (1).to_byte()
  lut
}

fn make_basic_str_stop_lut() -> FixedArray[Byte] {
  let lut : FixedArray[Byte] = FixedArray::make(256, (0).to_byte())
  let mut i = 0
  while i <= 8 {
    lut[i] = (1).to_byte()
    i = i + 1
  }
  i = 10
  while i <= 31 {
    lut[i] = (1).to_byte()
    i = i + 1
  }
  lut[34] = (1).to_byte()
  lut[92] = (1).to_byte()
  lut[127] = (1).to_byte()
  lut
}

fn make_lit_str_stop_lut() -> FixedArray[Byte] {
  let lut : FixedArray[Byte] = FixedArray::make(256, (0).to_byte())
  let mut i = 0
  while i <= 8 {
    lut[i] = (1).to_byte()
    i = i + 1
  }
  i = 10
  while i <= 31 {
    lut[i] = (1).to_byte()
    i = i + 1
  }
  lut[39] = (1).to_byte()
  lut[127] = (1).to_byte()
  lut
}

fn make_value_delim_lut() -> FixedArray[Byte] {
  let lut : FixedArray[Byte] = FixedArray::make(256, (0).to_byte())
  lut[32] = (1).to_byte()
  lut[9] = (1).to_byte()
  lut[10] = (1).to_byte()
  lut[13] = (1).to_byte()
  lut[35] = (1).to_byte()
  lut[44] = (1).to_byte()
  lut[93] = (1).to_byte()
  lut[125] = (1).to_byte()
  lut
}

fn make_hex_val_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, -1)
  let mut i = 48
  while i <= 57 {
    lut[i] = i - 48
    i = i + 1
  }
  i = 65
  while i <= 70 {
    lut[i] = i - 55
    i = i + 1
  }
  i = 97
  while i <= 102 {
    lut[i] = i - 87
    i = i + 1
  }
  lut
}

fn make_pow10_table() -> FixedArray[Double] {
  let t : FixedArray[Double] = FixedArray::make(23, 1.0)
  t[0] = 1.0
  t[1] = 1e1
  t[2] = 1e2
  t[3] = 1e3
  t[4] = 1e4
  t[5] = 1e5
  t[6] = 1e6
  t[7] = 1e7
  t[8] = 1e8
  t[9] = 1e9
  t[10] = 1e10
  t[11] = 1e11
  t[12] = 1e12
  t[13] = 1e13
  t[14] = 1e14
  t[15] = 1e15
  t[16] = 1e16
  t[17] = 1e17
  t[18] = 1e18
  t[19] = 1e19
  t[20] = 1e20
  t[21] = 1e21
  t[22] = 1e22
  t
}

let bare_key_lut : FixedArray[Byte] = make_bare_key_lut()
let basic_str_stop_lut : FixedArray[Byte] = make_basic_str_stop_lut()
let lit_str_stop_lut : FixedArray[Byte] = make_lit_str_stop_lut()
let value_delim_lut : FixedArray[Byte] = make_value_delim_lut()
let hex_val_lut : FixedArray[Int] = make_hex_val_lut()
let pow10_table : FixedArray[Double] = make_pow10_table()
let val_true : TomlValue = TomlValue::Bool(true)
let val_false : TomlValue = TomlValue::Bool(false)
let val_empty_str : TomlValue = TomlValue::Str("")

enum TableKind {
  Root
  Standard
  Super
  Dotted
}

enum SubKind {
  Tbl(ParseTable)
  AoT(Array[TomlValue], ParseTable)
}

struct SubMeta {
  entry_idx : Int
  mut kind : SubKind
}

struct ParseTable {
  mut kind : TableKind
  depth : Int
  entries : Array[(String, TomlValue)]
  mut index : Option[HashIndex]
  mut subs : Option[Array[SubMeta]]
}

fn ParseTable::new(kind : TableKind, depth : Int) -> ParseTable {
  ParseTable::{ kind: kind, depth: depth, entries: [], index: None, subs: None }
}

fn ParseTable::new_cap(kind : TableKind, depth : Int, cap : Int) -> ParseTable {
  ParseTable::{
    kind: kind,
    depth: depth,
    entries: Array::with_capacity(cap),
    index: None,
    subs: None,
  }
}

///| Look up `key` in `self`. Returns `entry_idx` or `-1`, and writes `sub_idx` to `p.found_sub`.
fn ParseTable::find_sc(self : ParseTable, key : String, p : Parser) -> Int {
  match self.index {
    Some(hi) => {
      let eidx = hi.get_entry_and_sub_sc(key)
      p.found_sub = hi.last_sub
      eidx
    }
    None => {
      let entries = self.entries
      let n = entries.length()
      let mut i = 0
      while i < n {
        let (k, _) = entries[i]
        if k == key {
          let sub_idx = match self.subs {
            Some(subs) => {
              let mut s = 0
              let sn = subs.length()
              let mut found = -1
              while s < sn {
                if subs[s].entry_idx == i {
                  found = s
                  break
                }
                s = s + 1
              }
              found
            }
            None => -1
          }
          p.found_sub = sub_idx
          return i
        }
        i = i + 1
      }
      p.found_sub = -1
      -1
    }
  }
}

fn ParseTable::ensure_index(self : ParseTable, seed : UInt64) -> HashIndex {
  match self.index {
    Some(hi) => hi
    None => {
      let hi = HashIndex::new(32, seed)
      let entries = self.entries
      let n = entries.length()
      let mut i = 0
      while i < n {
        let (k, _) = entries[i]
        let sub_idx = match self.subs {
          Some(subs) => {
            let mut s = 0
            let sn = subs.length()
            let mut found = -1
            while s < sn {
              if subs[s].entry_idx == i {
                found = s
                break
              }
              s = s + 1
            }
            found
          }
          None => -1
        }
        hi.insert(k, i, sub_idx)
        i = i + 1
      }
      self.index = Some(hi)
      hi
    }
  }
}

fn ParseTable::add_entry_after_miss(
  self : ParseTable,
  key : String,
  value : TomlValue,
  sub_kind : Option[SubKind],
  seed : UInt64,
) -> Unit {
  let entry_idx = self.entries.length()
  self.entries.push((key, value))
  let sub_idx = match sub_kind {
    Some(sk) => {
      let subs = match self.subs {
        Some(arr) => arr
        None => {
          let arr : Array[SubMeta] = []
          self.subs = Some(arr)
          arr
        }
      }
      let sidx = subs.length()
      subs.push(SubMeta::{ entry_idx: entry_idx, kind: sk })
      sidx
    }
    None => -1
  }
  match self.index {
    Some(hi) => hi.insert_after_miss(key, entry_idx, sub_idx)
    None => {
      if self.entries.length() > small_table_limit {
        let _ = self.ensure_index(seed)
      }
    }
  }
}

///| Single-pass check-and-insert for a scalar/array/sealed-inline-table leaf key.
///| Returns `false` if `key` already exists in `self`.
fn ParseTable::insert_unique_leaf(
  self : ParseTable,
  key : String,
  value : TomlValue,
  seed : UInt64,
) -> Bool {
  match self.index {
    Some(hi) => {
      let entry_idx = self.entries.length()
      if !hi.insert_unique_with_sub(key, entry_idx, -1) {
        return false
      }
      self.entries.push((key, value))
      true
    }
    None => {
      let entries = self.entries
      let n = entries.length()
      let mut i = 0
      while i < n {
        let (k, _) = entries[i]
        if k == key {
          return false
        }
        i = i + 1
      }
      entries.push((key, value))
      if n + 1 > small_table_limit {
        let _ = self.ensure_index(seed)
      }
      true
    }
  }
}

struct Parser {
  src : String
  len : Int
  seed : UInt64
  bom_start : Int
  use_intern : Bool
  mut pos : Int
  mut depth : Int
  mut has_err : Bool
  mut err_off : Int
  mut err_msg : String
  key_buf : FixedArray[String]
  intern_keys : FixedArray[String]
  intern_s_raw : FixedArray[String]
  intern_s_val : FixedArray[TomlValue]
  mut found_sub : Int
}

fn Parser::new(src : String, bom_start : Int) -> Parser {
  let n = src.length()
  let use_intern = n >= 1024
  Parser::{
    src: src,
    len: n,
    seed: derive_doc_seed(src),
    bom_start: bom_start,
    use_intern: use_intern,
    pos: bom_start,
    depth: 0,
    has_err: false,
    err_off: 0,
    err_msg: "",
    key_buf: FixedArray::make(max_parse_depth, ""),
    intern_keys: if use_intern { FixedArray::make(256, "") } else { FixedArray::make(0, "") },
    intern_s_raw: if use_intern { FixedArray::make(256, "") } else { FixedArray::make(0, "") },
    intern_s_val: if use_intern { FixedArray::make(256, val_empty_str) } else { FixedArray::make(0, val_empty_str) },
    found_sub: -1,
  }
}

fn Parser::intern_key_span(self : Parser, start : Int, end : Int) -> String {
  let slen = end - start
  if slen == 0 {
    return ""
  }
  let src = self.src
  if !self.use_intern || slen > 24 {
    return src.slice(start, end)
  }
  let b0 = src.code_unit_at(start)
  let b1 = if slen > 1 { src.code_unit_at(start + 1) } else { 0 }
  let bm = src.code_unit_at(start + (slen >> 1))
  let bl = src.code_unit_at(end - 1)
  let slot = (b0 * 31 + b1 * 17 + bm * 131 + bl * 7 + slen * 13) & 255
  let cache = self.intern_keys
  let cached = cache[slot]
  if cached.length() == slen {
    let mut i = 0
    while i < slen {
      if cached.code_unit_at(i) != src.code_unit_at(start + i) {
        let fresh = src.slice(start, end)
        cache[slot] = fresh
        return fresh
      }
      i = i + 1
    }
    return cached
  }
  let fresh = src.slice(start, end)
  cache[slot] = fresh
  fresh
}

fn Parser::intern_str_val(self : Parser, start : Int, end : Int) -> TomlValue {
  let slen = end - start
  if slen == 0 {
    return val_empty_str
  }
  let src = self.src
  if !self.use_intern || slen > 24 {
    return TomlValue::Str(src.slice(start, end))
  }
  let b0 = src.code_unit_at(start)
  let b1 = if slen > 1 { src.code_unit_at(start + 1) } else { 0 }
  let bm = src.code_unit_at(start + (slen >> 1))
  let bl = src.code_unit_at(end - 1)
  let slot = (b0 * 31 + b1 * 17 + bm * 131 + bl * 7 + slen * 13) & 255
  let raw_cache = self.intern_s_raw
  let cached = raw_cache[slot]
  if cached.length() == slen {
    let mut i = 0
    while i < slen {
      if cached.code_unit_at(i) != src.code_unit_at(start + i) {
        let fresh = src.slice(start, end)
        let v = TomlValue::Str(fresh)
        raw_cache[slot] = fresh
        self.intern_s_val[slot] = v
        return v
      }
      i = i + 1
    }
    return self.intern_s_val[slot]
  }
  let fresh = src.slice(start, end)
  let v = TomlValue::Str(fresh)
  raw_cache[slot] = fresh
  self.intern_s_val[slot] = v
  v
}

fn Parser::fail(self : Parser, off : Int, msg : String) -> Unit {
  self.has_err = true
  self.err_off = off
  self.err_msg = msg
}

fn Parser::fail_here(self : Parser, msg : String) -> Unit {
  self.has_err = true
  self.err_off = self.pos
  self.err_msg = msg
}

fn Parser::to_err(self : Parser) -> TomlError {
  let (ln, cl) = line_col_at_from(self.src, self.bom_start, self.err_off)
  TomlError::new(ln, cl, self.err_off, self.err_msg)
}

fn is_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn Parser::skip_ws(self : Parser) -> Unit {
  let src = self.src
  let n = self.len
  let mut p = self.pos
  while p < n {
    let b = src.code_unit_at(p)
    if b == 32 || b == 9 {
      p = p + 1
    } else {
      break
    }
  }
  self.pos = p
}

fn Parser::skip_comment(self : Parser) -> Bool {
  // Assumes current byte is '#' (35)
  let src = self.src
  let n = self.len
  let mut p = self.pos + 1
  while p < n {
    let b = src.code_unit_at(p)
    if b == 10 {
      break
    }
    if b == 13 {
      if p + 1 < n && src.code_unit_at(p + 1) == 10 {
        break
      }
      self.fail(p, "bare carriage return in comment")
      return false
    }
    if (b >= 0 && b <= 8) || (b >= 11 && b <= 31) || b == 127 {
      self.fail(p, "control character in comment")
      return false
    }
    p = p + 1
  }
  self.pos = p
  true
}

fn Parser::skip_ws_and_newlines(self : Parser) -> Bool {
  let src = self.src
  let n = self.len
  let mut p = self.pos
  while p < n {
    let b = src.code_unit_at(p)
    if b == 32 || b == 9 || b == 10 {
      p = p + 1
    } else if b == 13 {
      if p + 1 < n && src.code_unit_at(p + 1) == 10 {
        p = p + 2
      } else {
        self.fail(p, "bare carriage return")
        return false
      }
    } else if b == 35 {
      self.pos = p
      if !self.skip_comment() {
        return false
      }
      p = self.pos
    } else {
      break
    }
  }
  self.pos = p
  true
}

fn Parser::expect_eol_or_eof(self : Parser) -> Bool {
  let src = self.src
  let n = self.len
  let mut p = self.pos
  // Fast path: immediate LF (most common case)
  if p < n && src.code_unit_at(p) == 10 {
    self.pos = p + 1
    return true
  }
  while p < n {
    let b = src.code_unit_at(p)
    if b == 32 || b == 9 {
      p = p + 1
    } else {
      break
    }
  }
  if p >= n {
    self.pos = p
    return true
  }
  let b = src.code_unit_at(p)
  if b == 10 {
    self.pos = p + 1
    return true
  }
  if b == 35 {
    self.pos = p
    if !self.skip_comment() {
      return false
    }
    p = self.pos
    if p >= n {
      return true
    }
    let b2 = src.code_unit_at(p)
    if b2 == 10 {
      self.pos = p + 1
      return true
    }
    if b2 == 13 {
      if p + 1 < n && src.code_unit_at(p + 1) == 10 {
        self.pos = p + 2
        return true
      }
      self.fail(p, "bare carriage return")
      return false
    }
    self.fail(p, "expected newline or end of file")
    return false
  }
  if b == 13 {
    if p + 1 < n && src.code_unit_at(p + 1) == 10 {
      self.pos = p + 2
      return true
    }
    self.fail(p, "bare carriage return")
    return false
  }
  self.fail(p, "expected newline or end of file")
  false
}

fn Parser::parse_unicode_escape(self : Parser, digits : Int) -> Int {
  let pos = self.pos
  let src = self.src
  if pos + digits > self.len {
    self.fail(pos, "incomplete unicode escape")
    return -1
  }
  let lut = hex_val_lut
  let mut cp : Int64 = 0L
  let mut i = 0
  while i < digits {
    let hv = lut[src.code_unit_at(pos + i)]
    if hv < 0 {
      self.fail(pos, "invalid hex digit in unicode escape")
      return -1
    }
    cp = (cp << 4L) | hv.to_int64()
    i = i + 1
  }
  self.pos = pos + digits
  if cp < 0L || cp > 0x10FFFFL || (cp >= 0xD800L && cp <= 0xDFFFL) {
    self.fail(self.pos, "invalid unicode scalar value in escape")
    return -1
  }
  cp.to_int()
}

fn Parser::parse_escape_seq(self : Parser, sb : StringBuilder) -> Bool {
  if self.pos >= self.len {
    self.fail_here("unterminated escape sequence")
    return false
  }
  let b = self.src.code_unit_at(self.pos)
  self.pos = self.pos + 1
  if b == 98 {
    sb.write_byte((8).to_byte())
  } else if b == 116 {
    sb.write_byte((9).to_byte())
  } else if b == 110 {
    sb.write_byte((10).to_byte())
  } else if b == 102 {
    sb.write_byte((12).to_byte())
  } else if b == 114 {
    sb.write_byte((13).to_byte())
  } else if b == 34 {
    sb.write_byte((34).to_byte())
  } else if b == 92 {
    sb.write_byte((92).to_byte())
  } else if b == 117 {
    let cp = self.parse_unicode_escape(4)
    if cp < 0 {
      return false
    }
    write_utf8(sb, cp)
  } else if b == 85 {
    let cp = self.parse_unicode_escape(8)
    if cp < 0 {
      return false
    }
    write_utf8(sb, cp)
  } else {
    self.fail_here("invalid escape sequence")
    return false
  }
  true
}

fn Parser::parse_basic_string(self : Parser) -> String {
  let src = self.src
  let n = self.len
  let start = self.pos + 1
  let lut = basic_str_stop_lut
  let mut scan = start
  while scan + 4 <= n {
    if lut[src.code_unit_at(scan)] != (0).to_byte() ||
    lut[src.code_unit_at(scan + 1)] != (0).to_byte() ||
    lut[src.code_unit_at(scan + 2)] != (0).to_byte() ||
    lut[src.code_unit_at(scan + 3)] != (0).to_byte() {
      break
    }
    scan = scan + 4
  }
  while scan < n && lut[src.code_unit_at(scan)] == (0).to_byte() {
    scan = scan + 1
  }
  if scan >= n {
    self.fail(scan, "unterminated basic string")
    return ""
  }
  let stop_b = src.code_unit_at(scan)
  if stop_b == 34 {
    self.pos = scan + 1
    return src.slice(start, scan)
  }
  if stop_b != 92 {
    self.fail(scan, "control character or newline in basic string")
    return ""
  }
  // Slow path: string contains escape sequences
  let sb = StringBuilder::with_capacity((scan - start) + 32)
  if scan > start {
    sb.write_string(src.slice(start, scan))
  }
  self.pos = scan
  while self.pos < n {
    let b = src.code_unit_at(self.pos)
    if b == 34 {
      self.pos = self.pos + 1
      return sb.to_string()
    }
    if b == 92 {
      self.pos = self.pos + 1
      if !self.parse_escape_seq(sb) {
        return ""
      }
    } else {
      self.fail(self.pos, "control character or newline in basic string")
      return ""
    }
    let chunk_start = self.pos
    let mut p = chunk_start
    while p + 4 <= n {
      if lut[src.code_unit_at(p)] != (0).to_byte() ||
      lut[src.code_unit_at(p + 1)] != (0).to_byte() ||
      lut[src.code_unit_at(p + 2)] != (0).to_byte() ||
      lut[src.code_unit_at(p + 3)] != (0).to_byte() {
        break
      }
      p = p + 4
    }
    while p < n && lut[src.code_unit_at(p)] == (0).to_byte() {
      p = p + 1
    }
    if p > chunk_start {
      sb.write_string(src.slice(chunk_start, p))
    }
    self.pos = p
  }
  self.fail(n, "unterminated basic string")
  ""
}

fn Parser::parse_multiline_basic_string(self : Parser) -> String {
  let src = self.src
  let n = self.len
  let mut p = self.pos + 3
  // Trim immediate first newline if present
  if p < n {
    let b = src.code_unit_at(p)
    if b == 10 {
      p = p + 1
    } else if b == 13 && p + 1 < n && src.code_unit_at(p + 1) == 10 {
      p = p + 2
    }
  }
  let start = p
  // Fast path: scan for closing """ with no escapes, no CR, no embedded quotes
  while p < n {
    let b = src.code_unit_at(p)
    if b == 34 || b == 92 || b == 13 || (b >= 0 && b <= 8) || b == 11 || b == 12 || (b >= 14 && b <= 31) || b == 127 {
      break
    }
    p = p + 1
  }
  if p + 2 < n && src.code_unit_at(p) == 34 && src.code_unit_at(p + 1) == 34 && src.code_unit_at(p + 2) == 34 {
    if p + 3 >= n || src.code_unit_at(p + 3) != 34 {
      self.pos = p + 3
      return src.slice(start, p)
    }
  }
  let sb = StringBuilder::with_capacity((p - start) + 64)
  if p > start {
    sb.write_string(src.slice(start, p))
  }
  self.pos = p
  while self.pos < n {
    let chunk_start = self.pos
    let mut scan = chunk_start
    while scan < n {
      let b = src.code_unit_at(scan)
      if b == 34 || b == 92 || b == 13 || (b >= 0 && b <= 8) || b == 11 || b == 12 || (b >= 14 && b <= 31) || b == 127 {
        break
      }
      scan = scan + 1
    }
    if scan > chunk_start {
      sb.write_string(src.slice(chunk_start, scan))
    }
    self.pos = scan
    if scan >= n {
      break
    }
    let b = src.code_unit_at(scan)
    if b == 34 {
      let mut qcount = 0
      while scan + qcount < n && src.code_unit_at(scan + qcount) == 34 {
        qcount = qcount + 1
      }
      if qcount >= 3 {
        if qcount > 5 {
          self.fail(scan, "too many consecutive quotes in multiline basic string")
          return ""
        }
        let extra = qcount - 3
        let mut k = 0
        while k < extra {
          sb.write_byte((34).to_byte())
          k = k + 1
        }
        self.pos = scan + qcount
        return sb.to_string()
      } else {
        let mut k = 0
        while k < qcount {
          sb.write_byte((34).to_byte())
          k = k + 1
        }
        self.pos = scan + qcount
      }
    } else if b == 92 {
      self.pos = scan + 1
      let save_pos = self.pos
      let mut q = save_pos
      let mut saw_nl = false
      while q < n {
        let c = src.code_unit_at(q)
        if c == 32 || c == 9 {
          q = q + 1
        } else if c == 10 {
          q = q + 1
          saw_nl = true
          break
        } else if c == 13 && q + 1 < n && src.code_unit_at(q + 1) == 10 {
          q = q + 2
          saw_nl = true
          break
        } else {
          break
        }
      }
      if saw_nl {
        while q < n {
          let c = src.code_unit_at(q)
          if c == 32 || c == 9 || c == 10 {
            q = q + 1
          } else if c == 13 && q + 1 < n && src.code_unit_at(q + 1) == 10 {
            q = q + 2
          } else {
            break
          }
        }
        self.pos = q
      } else {
        if q != save_pos {
          self.fail(q, "invalid whitespace after backslash in multiline string")
          return ""
        }
        self.pos = save_pos
        if !self.parse_escape_seq(sb) {
          return ""
        }
      }
    } else if b == 13 {
      if scan + 1 < n && src.code_unit_at(scan + 1) == 10 {
        sb.write_byte((10).to_byte())
        self.pos = scan + 2
      } else {
        self.fail(scan, "bare carriage return in multiline basic string")
        return ""
      }
    } else {
      self.fail(scan, "control character in multiline basic string")
      return ""
    }
  }
  self.fail(n, "unterminated multiline basic string")
  ""
}

fn Parser::parse_literal_string(self : Parser) -> String {
  let src = self.src
  let n = self.len
  let start = self.pos + 1
  let lut = lit_str_stop_lut
  let mut scan = start
  while scan + 4 <= n {
    if lut[src.code_unit_at(scan)] != (0).to_byte() ||
    lut[src.code_unit_at(scan + 1)] != (0).to_byte() ||
    lut[src.code_unit_at(scan + 2)] != (0).to_byte() ||
    lut[src.code_unit_at(scan + 3)] != (0).to_byte() {
      break
    }
    scan = scan + 4
  }
  while scan < n && lut[src.code_unit_at(scan)] == (0).to_byte() {
    scan = scan + 1
  }
  if scan >= n {
    self.fail(scan, "unterminated literal string")
    return ""
  }
  if src.code_unit_at(scan) == 39 {
    self.pos = scan + 1
    return src.slice(start, scan)
  }
  self.fail(scan, "control character or newline in literal string")
  ""
}

fn Parser::parse_multiline_literal_string(self : Parser) -> String {
  let src = self.src
  let n = self.len
  let mut p = self.pos + 3
  if p < n {
    let b = src.code_unit_at(p)
    if b == 10 {
      p = p + 1
    } else if b == 13 && p + 1 < n && src.code_unit_at(p + 1) == 10 {
      p = p + 2
    }
  }
  let start = p
  while p < n {
    let b = src.code_unit_at(p)
    if b == 39 || b == 13 || (b >= 0 && b <= 8) || b == 11 || b == 12 || (b >= 14 && b <= 31) || b == 127 {
      break
    }
    p = p + 1
  }
  if p + 2 < n && src.code_unit_at(p) == 39 && src.code_unit_at(p + 1) == 39 && src.code_unit_at(p + 2) == 39 {
    if p + 3 >= n || src.code_unit_at(p + 3) != 39 {
      self.pos = p + 3
      return src.slice(start, p)
    }
  }
  let sb = StringBuilder::with_capacity((p - start) + 64)
  if p > start {
    sb.write_string(src.slice(start, p))
  }
  self.pos = p
  while self.pos < n {
    let chunk_start = self.pos
    let mut scan = chunk_start
    while scan < n {
      let b = src.code_unit_at(scan)
      if b == 39 || b == 13 || (b >= 0 && b <= 8) || b == 11 || b == 12 || (b >= 14 && b <= 31) || b == 127 {
        break
      }
      scan = scan + 1
    }
    if scan > chunk_start {
      sb.write_string(src.slice(chunk_start, scan))
    }
    self.pos = scan
    if scan >= n {
      break
    }
    let b = src.code_unit_at(scan)
    if b == 39 {
      let mut qcount = 0
      while scan + qcount < n && src.code_unit_at(scan + qcount) == 39 {
        qcount = qcount + 1
      }
      if qcount >= 3 {
        if qcount > 5 {
          self.fail(scan, "too many consecutive quotes in multiline literal string")
          return ""
        }
        let extra = qcount - 3
        let mut k = 0
        while k < extra {
          sb.write_byte((39).to_byte())
          k = k + 1
        }
        self.pos = scan + qcount
        return sb.to_string()
      } else {
        let mut k = 0
        while k < qcount {
          sb.write_byte((39).to_byte())
          k = k + 1
        }
        self.pos = scan + qcount
      }
    } else if b == 13 {
      if scan + 1 < n && src.code_unit_at(scan + 1) == 10 {
        sb.write_byte((10).to_byte())
        self.pos = scan + 2
      } else {
        self.fail(scan, "bare carriage return in multiline literal string")
        return ""
      }
    } else {
      self.fail(scan, "control character in multiline literal string")
      return ""
    }
  }
  self.fail(n, "unterminated multiline literal string")
  ""
}

fn Parser::parse_simple_key(self : Parser) -> String {
  let n = self.len
  let pos = self.pos
  if pos >= n {
    self.fail(pos, "expected key")
    return ""
  }
  let src = self.src
  let b = src.code_unit_at(pos)
  let lut = bare_key_lut
  if lut[b] != (0).to_byte() {
    let mut p = pos + 1
    while p + 4 <= n {
      if lut[src.code_unit_at(p)] == (0).to_byte() ||
      lut[src.code_unit_at(p + 1)] == (0).to_byte() ||
      lut[src.code_unit_at(p + 2)] == (0).to_byte() ||
      lut[src.code_unit_at(p + 3)] == (0).to_byte() {
        break
      }
      p = p + 4
    }
    while p < n && lut[src.code_unit_at(p)] != (0).to_byte() {
      p = p + 1
    }
    self.pos = p
    return self.intern_key_span(pos, p)
  }
  if b == 34 {
    if pos + 2 < n && src.code_unit_at(pos + 1) == 34 && src.code_unit_at(pos + 2) == 34 {
      self.fail(pos, "multiline basic string not allowed as key")
      return ""
    }
    return self.parse_basic_string()
  }
  if b == 39 {
    if pos + 2 < n && src.code_unit_at(pos + 1) == 39 && src.code_unit_at(pos + 2) == 39 {
      self.fail(pos, "multiline literal string not allowed as key")
      return ""
    }
    return self.parse_literal_string()
  }
  self.fail(pos, "invalid key character")
  ""
}

///| Parse a dotted key path into `self.key_buf[0..count]`. Returns segment count, or 0 on error.
fn Parser::parse_key_path_into_buf(self : Parser) -> Int {
  self.skip_ws()
  let k0 = self.parse_simple_key()
  if self.has_err {
    return 0
  }
  let buf = self.key_buf
  buf[0] = k0
  let mut count = 1
  let src = self.src
  let n = self.len
  while true {
    self.skip_ws()
    if self.pos < n && src.code_unit_at(self.pos) == 46 {
      if count >= max_parse_depth {
        self.fail_here("recursion limit exceeded in dotted key")
        return 0
      }
      self.pos = self.pos + 1
      self.skip_ws()
      let ki = self.parse_simple_key()
      if self.has_err {
        return 0
      }
      buf[count] = ki
      count = count + 1
    } else {
      break
    }
  }
  count
}

fn is_leap_year_p(y : Int) -> Bool {
  (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)
}

fn days_in_month_p(y : Int, m : Int) -> Int {
  if m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12 {
    31
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else if m == 2 {
    if is_leap_year_p(y) { 29 } else { 28 }
  } else {
    0
  }
}

fn parse_fixed_digits_raw(s : String, pos : Int, count : Int) -> Int {
  if pos + count > s.length() {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < count {
    let b = s.code_unit_at(pos + i)
    if b < 48 || b > 57 {
      return -1
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn parse_time_part_raw(s : String, pos : Int, end : Int) -> Int {
  // HH:MM:SS(.frac)?
  if pos + 8 > end {
    return -1
  }
  if s.code_unit_at(pos + 2) != 58 || s.code_unit_at(pos + 5) != 58 {
    return -1
  }
  let h0 = s.code_unit_at(pos) - 48
  let h1 = s.code_unit_at(pos + 1) - 48
  let m0 = s.code_unit_at(pos + 3) - 48
  let m1 = s.code_unit_at(pos + 4) - 48
  let s0 = s.code_unit_at(pos + 6) - 48
  let s1 = s.code_unit_at(pos + 7) - 48
  if h0 < 0 || h0 > 9 || h1 < 0 || h1 > 9 || m0 < 0 || m0 > 9 || m1 < 0 || m1 > 9 || s0 < 0 || s0 > 9 || s1 < 0 || s1 > 9 {
    return -1
  }
  let hh = h0 * 10 + h1
  let mm = m0 * 10 + m1
  let ss = s0 * 10 + s1
  if hh > 23 || mm > 59 || ss > 59 {
    return -1
  }
  let mut p = pos + 8
  if p < end && s.code_unit_at(p) == 46 {
    p = p + 1
    let fstart = p
    while p < end && is_digit(s.code_unit_at(p)) {
      p = p + 1
    }
    if p == fstart {
      return -1
    }
  }
  p
}

fn normalize_datetime(s : String, start : Int, end : Int, sep : Int, lower_z : Bool) -> String {
  if sep == 84 && !lower_z {
    return s.slice(start, end)
  }
  let sb = StringBuilder::with_capacity(end - start)
  sb.write_string(s.slice(start, start + 10))
  sb.write_byte((84).to_byte())
  if lower_z {
    sb.write_string(s.slice(start + 11, end - 1))
    sb.write_byte((90).to_byte())
  } else {
    sb.write_string(s.slice(start + 11, end))
  }
  sb.to_string()
}

fn Parser::parse_local_time(self : Parser, start : Int) -> TomlValue {
  let s = self.src
  let n = self.len
  let dlim = value_delim_lut
  let mut end = start
  while end < n && dlim[s.code_unit_at(end)] == (0).to_byte() {
    end = end + 1
  }
  let p = parse_time_part_raw(s, start, end)
  if p == end {
    self.pos = end
    return TomlValue::LocalTime(s.slice(start, end))
  }
  self.fail(start, "invalid local time")
  TomlValue::Bool(false)
}

fn Parser::parse_date_or_datetime(self : Parser, start : Int) -> TomlValue {
  let s = self.src
  let n = self.len
  if start + 10 > n || s.code_unit_at(start + 7) != 45 {
    self.fail(start, "invalid date format")
    return TomlValue::Bool(false)
  }
  let y = parse_fixed_digits_raw(s, start, 4)
  if y < 0 {
    self.fail(start, "invalid year")
    return TomlValue::Bool(false)
  }
  let mo = parse_fixed_digits_raw(s, start + 5, 2)
  if mo < 1 || mo > 12 {
    self.fail(start, "month out of range")
    return TomlValue::Bool(false)
  }
  let d = parse_fixed_digits_raw(s, start + 8, 2)
  if d < 1 {
    self.fail(start, "invalid day")
    return TomlValue::Bool(false)
  }
  let dim = days_in_month_p(y, mo)
  if d > dim {
    self.fail(start, "day out of range")
    return TomlValue::Bool(false)
  }
  let dlim = value_delim_lut
  let mut p = start + 10
  if p >= n || dlim[s.code_unit_at(p)] != (0).to_byte() {
    let has_space_time = p + 3 < n &&
    s.code_unit_at(p) == 32 &&
    is_digit(s.code_unit_at(p + 1)) &&
    is_digit(s.code_unit_at(p + 2)) &&
    s.code_unit_at(p + 3) == 58
    if !has_space_time {
      self.pos = p
      return TomlValue::LocalDate(s.slice(start, p))
    }
  }
  let sep = s.code_unit_at(p)
  if sep != 84 && sep != 116 && sep != 32 {
    self.fail(start, "invalid date-time separator")
    return TomlValue::Bool(false)
  }
  p = p + 1
  let mut end = p
  while end < n && dlim[s.code_unit_at(end)] == (0).to_byte() {
    end = end + 1
  }
  let after_time = parse_time_part_raw(s, p, end)
  if after_time < 0 {
    self.fail(start, "invalid time in date-time")
    return TomlValue::Bool(false)
  }
  if after_time == end {
    let norm = normalize_datetime(s, start, end, sep, false)
    self.pos = end
    return TomlValue::LocalDateTime(norm)
  }
  let ob = s.code_unit_at(after_time)
  if ob == 90 || ob == 122 {
    if after_time + 1 != end {
      self.fail(start, "trailing characters after Z offset")
      return TomlValue::Bool(false)
    }
    let norm = normalize_datetime(s, start, end, sep, ob == 122)
    self.pos = end
    return TomlValue::OffsetDateTime(norm)
  }
  if ob == 43 || ob == 45 {
    if after_time + 6 != end || s.code_unit_at(after_time + 3) != 58 {
      self.fail(start, "invalid timezone offset")
      return TomlValue::Bool(false)
    }
    let oh = parse_fixed_digits_raw(s, after_time + 1, 2)
    let om = parse_fixed_digits_raw(s, after_time + 4, 2)
    if oh < 0 || oh > 23 || om < 0 || om > 59 {
      self.fail(start, "timezone offset out of range")
      return TomlValue::Bool(false)
    }
    let norm = normalize_datetime(s, start, end, sep, false)
    self.pos = end
    return TomlValue::OffsetDateTime(norm)
  }
  self.fail(start, "invalid timezone offset")
  TomlValue::Bool(false)
}

fn Parser::parse_radix_int_span(self : Parser, start : Int, dig_start : Int, end : Int, radix : UInt64) -> TomlValue {
  let s = self.src
  if dig_start >= end {
    self.fail(start, "invalid radix integer")
    return TomlValue::Bool(false)
  }
  let i64_max : UInt64 = 9223372036854775807UL
  let lut = hex_val_lut
  let mut acc : UInt64 = 0UL
  let mut i = dig_start
  let mut prev_us = false
  let mut digits = 0
  while i < end {
    let b = s.code_unit_at(i)
    if b == 95 {
      if digits == 0 || prev_us || i + 1 >= end {
        self.fail(start, "invalid radix integer")
        return TomlValue::Bool(false)
      }
      prev_us = true
      i = i + 1
    } else {
      let d = if radix == 16UL {
        lut[b]
      } else if radix == 8UL {
        if b >= 48 && b <= 55 { b - 48 } else { -1 }
      } else {
        if b == 48 || b == 49 { b - 48 } else { -1 }
      }
      if d < 0 {
        self.fail(start, "invalid radix integer")
        return TomlValue::Bool(false)
      }
      let du = d.to_int64().reinterpret_as_uint64()
      if acc > (i64_max - du) / radix {
        self.fail(start, "integer overflow")
        return TomlValue::Bool(false)
      }
      acc = acc * radix + du
      digits = digits + 1
      prev_us = false
      i = i + 1
    }
  }
  if digits == 0 || prev_us {
    self.fail(start, "invalid radix integer")
    return TomlValue::Bool(false)
  }
  self.pos = end
  TomlValue::Int(acc.reinterpret_as_int64())
}

fn Parser::parse_float_span(self : Parser, start : Int, end : Int) -> TomlValue {
  let s = self.src
  let mut i = start
  let mut neg = false
  let b0 = s.code_unit_at(i)
  if b0 == 43 {
    i = i + 1
  } else if b0 == 45 {
    neg = true
    i = i + 1
  }
  if i >= end || !is_digit(s.code_unit_at(i)) {
    self.fail(start, "invalid float literal")
    return TomlValue::Bool(false)
  }
  let int_first = s.code_unit_at(i)
  let mut int_digits = 0
  let mut prev_us = false
  let mut has_us = false
  let mut mant : UInt64 = 0UL
  let mut sig_digits = 0
  let mut trunc_int = false
  while i < end {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      int_digits = int_digits + 1
      prev_us = false
      let d = b - 48
      if sig_digits > 0 || d != 0 {
        if sig_digits < 16 {
          mant = mant * 10UL + d.to_int64().reinterpret_as_uint64()
          sig_digits = sig_digits + 1
        } else {
          trunc_int = true
        }
      }
      i = i + 1
    } else if b == 95 {
      if int_digits == 0 || prev_us {
        self.fail(start, "invalid float literal")
        return TomlValue::Bool(false)
      }
      has_us = true
      prev_us = true
      i = i + 1
    } else {
      break
    }
  }
  if prev_us || (int_first == 48 && int_digits > 1) {
    self.fail(start, "invalid float literal")
    return TomlValue::Bool(false)
  }
  let mut has_frac = false
  let mut has_exp = false
  let mut frac_digits = 0
  if i < end && s.code_unit_at(i) == 46 {
    has_frac = true
    i = i + 1
    let mut fdig = 0
    prev_us = false
    while i < end {
      let b = s.code_unit_at(i)
      if b >= 48 && b <= 57 {
        fdig = fdig + 1
        prev_us = false
        let d = b - 48
        if sig_digits > 0 || d != 0 {
          if sig_digits < 16 {
            mant = mant * 10UL + d.to_int64().reinterpret_as_uint64()
            sig_digits = sig_digits + 1
            frac_digits = frac_digits + 1
          } else {
            trunc_int = true
          }
        } else {
          frac_digits = frac_digits + 1
        }
        i = i + 1
      } else if b == 95 {
        if fdig == 0 || prev_us {
          self.fail(start, "invalid float literal")
          return TomlValue::Bool(false)
        }
        has_us = true
        prev_us = true
        i = i + 1
      } else {
        break
      }
    }
    if fdig == 0 || prev_us {
      self.fail(start, "invalid float literal")
      return TomlValue::Bool(false)
    }
  }
  let mut exp_val = 0
  let mut exp_overflow = false
  if i < end && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    has_exp = true
    i = i + 1
    let mut exp_neg = false
    if i < end {
      let eb = s.code_unit_at(i)
      if eb == 43 {
        i = i + 1
      } else if eb == 45 {
        exp_neg = true
        i = i + 1
      }
    }
    let mut edig = 0
    prev_us = false
    while i < end {
      let b = s.code_unit_at(i)
      if b >= 48 && b <= 57 {
        edig = edig + 1
        prev_us = false
        if exp_val < 100000 {
          exp_val = exp_val * 10 + (b - 48)
        } else {
          exp_overflow = true
        }
        i = i + 1
      } else if b == 95 {
        if edig == 0 || prev_us {
          self.fail(start, "invalid float literal")
          return TomlValue::Bool(false)
        }
        has_us = true
        prev_us = true
        i = i + 1
      } else {
        break
      }
    }
    if edig == 0 || prev_us {
      self.fail(start, "invalid float literal")
      return TomlValue::Bool(false)
    }
    if exp_neg {
      exp_val = -exp_val
    }
  }
  if i != end || (!has_frac && !has_exp) {
    self.fail(start, "invalid float literal")
    return TomlValue::Bool(false)
  }
  // Exact zero fast path (preserves -0.0 sign)
  if mant == 0UL {
    self.pos = end
    return TomlValue::Float(if neg { -0.0 } else { 0.0 })
  }
  // Clinger exact IEEE-754 fast path: mant <= 2^53 - 1 and -22 <= total_exp <= 22
  if !trunc_int && !exp_overflow && sig_digits <= 15 {
    let total_exp = exp_val - frac_digits
    if total_exp >= -22 && total_exp <= 22 {
      let f = mant.reinterpret_as_int64().to_double()
      let v = if total_exp == 0 {
        f
      } else if total_exp > 0 {
        f * pow10_table[total_exp]
      } else {
        f / pow10_table[-total_exp]
      }
      self.pos = end
      return TomlValue::Float(if neg { -v } else { v })
    }
  }
  // Fallback to runtime strtod
  let parsed = if !has_us {
    s.slice(start, end).to_double()
  } else {
    let sb = StringBuilder::with_capacity(end - start)
    let mut j = start
    while j < end {
      let b = s.code_unit_at(j)
      if b != 95 {
        sb.write_byte(b.to_byte())
      }
      j = j + 1
    }
    sb.to_string().to_double()
  }
  match parsed {
    Some(f) => {
      let bits = f.reinterpret_as_uint64()
      let exp = (bits >> 52UL) & 0x7FFUL
      if exp == 0x7FFUL {
        self.fail(start, "invalid float literal")
        return TomlValue::Bool(false)
      }
      self.pos = end
      TomlValue::Float(f)
    }
    None => {
      self.fail(start, "invalid float literal")
      TomlValue::Bool(false)
    }
  }
}

fn Parser::parse_scalar_token(self : Parser) -> TomlValue {
  let start = self.pos
  let s = self.src
  let n = self.len
  if start >= n {
    self.fail(start, "expected value")
    return TomlValue::Bool(false)
  }
  let dlim = value_delim_lut
  let b0 = s.code_unit_at(start)

  // Fast path: "true"
  if b0 == 116 {
    if start + 4 <= n &&
    s.code_unit_at(start + 1) == 114 &&
    s.code_unit_at(start + 2) == 117 &&
    s.code_unit_at(start + 3) == 101 &&
    (start + 4 == n || dlim[s.code_unit_at(start + 4)] != (0).to_byte()) {
      self.pos = start + 4
      return val_true
    }
    self.fail(start, "invalid value literal")
    return val_false
  }
  // Fast path: "false"
  if b0 == 102 {
    if start + 5 <= n &&
    s.code_unit_at(start + 1) == 97 &&
    s.code_unit_at(start + 2) == 108 &&
    s.code_unit_at(start + 3) == 115 &&
    s.code_unit_at(start + 4) == 101 &&
    (start + 5 == n || dlim[s.code_unit_at(start + 5)] != (0).to_byte()) {
      self.pos = start + 5
      return val_false
    }
    self.fail(start, "invalid value literal")
    return val_false
  }
  // Fast path: "inf" / "nan"
  if b0 == 105 {
    if start + 3 <= n &&
    s.code_unit_at(start + 1) == 110 &&
    s.code_unit_at(start + 2) == 102 &&
    (start + 3 == n || dlim[s.code_unit_at(start + 3)] != (0).to_byte()) {
      self.pos = start + 3
      return TomlValue::Float(1.0 / 0.0)
    }
    self.fail(start, "invalid value literal")
    return TomlValue::Bool(false)
  }
  if b0 == 110 {
    if start + 3 <= n &&
    s.code_unit_at(start + 1) == 97 &&
    s.code_unit_at(start + 2) == 110 &&
    (start + 3 == n || dlim[s.code_unit_at(start + 3)] != (0).to_byte()) {
      self.pos = start + 3
      return TomlValue::Float(0.0 / 0.0)
    }
    self.fail(start, "invalid value literal")
    return TomlValue::Bool(false)
  }

  // Digit: check datetime/time or radix int first
  if b0 >= 48 && b0 <= 57 {
    if start + 2 < n && s.code_unit_at(start + 2) == 58 && is_digit(s.code_unit_at(start + 1)) {
      return self.parse_local_time(start)
    }
    if start + 4 < n &&
    s.code_unit_at(start + 4) == 45 &&
    is_digit(s.code_unit_at(start + 1)) &&
    is_digit(s.code_unit_at(start + 2)) &&
    is_digit(s.code_unit_at(start + 3)) {
      return self.parse_date_or_datetime(start)
    }
    if b0 == 48 && start + 1 < n {
      let b1 = s.code_unit_at(start + 1)
      if b1 == 120 || b1 == 111 || b1 == 98 {
        let mut end = start + 2
        while end < n && dlim[s.code_unit_at(end)] == (0).to_byte() {
          end = end + 1
        }
        let radix = if b1 == 120 { 16UL } else if b1 == 111 { 8UL } else { 2UL }
        return self.parse_radix_int_span(start, start + 2, end, radix)
      }
    }
  } else if b0 == 43 || b0 == 45 {
    // Check +inf / -inf / +nan / -nan
    if start + 4 <= n && (start + 4 == n || dlim[s.code_unit_at(start + 4)] != (0).to_byte()) {
      let b1 = s.code_unit_at(start + 1)
      let b2 = s.code_unit_at(start + 2)
      let b3 = s.code_unit_at(start + 3)
      if b1 == 105 && b2 == 110 && b3 == 102 {
        self.pos = start + 4
        return TomlValue::Float(if b0 == 45 { -1.0 / 0.0 } else { 1.0 / 0.0 })
      }
      if b1 == 110 && b2 == 97 && b3 == 110 {
        self.pos = start + 4
        return TomlValue::Float(0.0 / 0.0)
      }
    }
  } else {
    self.fail(start, "invalid value literal")
    return TomlValue::Bool(false)
  }

  // In-place decimal integer fast path (falls through to float if '.' / 'e' / 'E' seen)
  let mut i = start
  let mut neg = false
  if b0 == 43 {
    i = i + 1
  } else if b0 == 45 {
    neg = true
    i = i + 1
  }
  if i >= n {
    self.fail(start, "invalid value literal")
    return TomlValue::Bool(false)
  }
  let first = s.code_unit_at(i)
  if first < 48 || first > 57 {
    self.fail(start, "invalid value literal")
    return TomlValue::Bool(false)
  }
  let mut acc : UInt64 = (first - 48).to_int64().reinterpret_as_uint64()
  let mut digits = 1
  let mut prev_us = false
  let mut overflow = false
  i = i + 1
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      if first == 48 && digits == 1 {
        // Leading zero followed by digit: invalid for both int and float
        self.fail(start, "invalid value literal")
        return TomlValue::Bool(false)
      }
      let d = b - 48
      if digits < 18 {
        acc = acc * 10UL + d.to_int64().reinterpret_as_uint64()
      } else if digits == 18 {
        let max_d = if neg { 8 } else { 7 }
        if acc < 922337203685477580UL || (acc == 922337203685477580UL && d <= max_d) {
          acc = acc * 10UL + d.to_int64().reinterpret_as_uint64()
        } else {
          overflow = true
        }
      } else {
        overflow = true
      }
      digits = digits + 1
      prev_us = false
      i = i + 1
    } else if dlim[b] != (0).to_byte() {
      break
    } else if b == 46 || b == 101 || b == 69 {
      // Float literal! Find token end and parse float in-place.
      let mut end = i + 1
      while end < n && dlim[s.code_unit_at(end)] == (0).to_byte() {
        end = end + 1
      }
      return self.parse_float_span(start, end)
    } else if b == 95 {
      if prev_us {
        self.fail(start, "invalid value literal")
        return TomlValue::Bool(false)
      }
      if first == 48 && digits == 1 {
        self.fail(start, "invalid value literal")
        return TomlValue::Bool(false)
      }
      prev_us = true
      i = i + 1
    } else {
      self.fail(start, "invalid value literal")
      return TomlValue::Bool(false)
    }
  }
  if prev_us || overflow {
    self.fail(start, "invalid value literal")
    return TomlValue::Bool(false)
  }
  self.pos = i
  if neg {
    TomlValue::Int((0UL - acc).reinterpret_as_int64())
  } else {
    TomlValue::Int(acc.reinterpret_as_int64())
  }
}

fn Parser::parse_basic_string_val(self : Parser) -> TomlValue {
  let src = self.src
  let n = self.len
  let start = self.pos + 1
  let lut = basic_str_stop_lut
  let mut scan = start
  while scan + 4 <= n {
    if lut[src.code_unit_at(scan)] != (0).to_byte() ||
    lut[src.code_unit_at(scan + 1)] != (0).to_byte() ||
    lut[src.code_unit_at(scan + 2)] != (0).to_byte() ||
    lut[src.code_unit_at(scan + 3)] != (0).to_byte() {
      break
    }
    scan = scan + 4
  }
  while scan < n && lut[src.code_unit_at(scan)] == (0).to_byte() {
    scan = scan + 1
  }
  if scan < n && src.code_unit_at(scan) == 34 {
    self.pos = scan + 1
    return self.intern_str_val(start, scan)
  }
  TomlValue::Str(self.parse_basic_string())
}

fn Parser::parse_value_no_skip(self : Parser) -> TomlValue {
  let pos = self.pos
  let n = self.len
  if pos >= n {
    self.fail(pos, "expected value")
    return val_false
  }
  let src = self.src
  let b = src.code_unit_at(pos)
  if b == 34 {
    if pos + 2 < n && src.code_unit_at(pos + 1) == 34 && src.code_unit_at(pos + 2) == 34 {
      return TomlValue::Str(self.parse_multiline_basic_string())
    }
    return self.parse_basic_string_val()
  }
  if b == 39 {
    if pos + 2 < n && src.code_unit_at(pos + 1) == 39 && src.code_unit_at(pos + 2) == 39 {
      return TomlValue::Str(self.parse_multiline_literal_string())
    }
    return TomlValue::Str(self.parse_literal_string())
  }
  if b == 91 {
    return self.parse_array()
  }
  if b == 123 {
    return self.parse_inline_table()
  }
  self.parse_scalar_token()
}

fn Parser::parse_array(self : Parser) -> TomlValue {
  if self.depth >= max_parse_depth {
    self.fail_here("recursion limit exceeded in array")
    return TomlValue::Bool(false)
  }
  self.depth = self.depth + 1
  self.pos = self.pos + 1
  let items : Array[TomlValue] = Array::with_capacity(4)
  let src = self.src
  let n = self.len
  let ep0 = self.pos
  if !self.skip_ws_and_newlines() {
    self.depth = self.depth - 1
    return TomlValue::Bool(false)
  }
  if self.pos >= n {
    self.depth = self.depth - 1
    self.fail(ep0, "unterminated array")
    return TomlValue::Bool(false)
  }
  if src.code_unit_at(self.pos) == 93 {
    self.pos = self.pos + 1
    self.depth = self.depth - 1
    return TomlValue::Array(items)
  }
  while true {
    let v = self.parse_value_no_skip()
    if self.has_err {
      self.depth = self.depth - 1
      return TomlValue::Bool(false)
    }
    items.push(v)
    // Fast path for inline array: immediate ',' or ']'
    let mut next = if self.pos < n { src.code_unit_at(self.pos) } else { -1 }
    if next != 44 && next != 93 {
      let ep2 = self.pos
      if !self.skip_ws_and_newlines() {
        self.depth = self.depth - 1
        return TomlValue::Bool(false)
      }
      if self.pos >= n {
        self.depth = self.depth - 1
        self.fail(ep2, "unterminated array")
        return TomlValue::Bool(false)
      }
      next = src.code_unit_at(self.pos)
    }
    if next == 44 {
      self.pos = self.pos + 1
      // Fast path for ", " followed by a value
      if self.pos + 1 < n && src.code_unit_at(self.pos) == 32 {
        let nb = src.code_unit_at(self.pos + 1)
        if nb != 32 && nb != 9 && nb != 10 && nb != 13 && nb != 35 {
          self.pos = self.pos + 1
          if nb == 93 {
            self.pos = self.pos + 1
            self.depth = self.depth - 1
            return TomlValue::Array(items)
          }
          continue
        }
      }
      let ep3 = self.pos
      if !self.skip_ws_and_newlines() {
        self.depth = self.depth - 1
        return TomlValue::Bool(false)
      }
      if self.pos >= n {
        self.depth = self.depth - 1
        self.fail(ep3, "unterminated array")
        return TomlValue::Bool(false)
      }
      if src.code_unit_at(self.pos) == 93 {
        self.pos = self.pos + 1
        self.depth = self.depth - 1
        return TomlValue::Array(items)
      }
    } else if next == 93 {
      self.pos = self.pos + 1
      self.depth = self.depth - 1
      return TomlValue::Array(items)
    } else {
      self.depth = self.depth - 1
      self.fail_here("expected ',' or ']' in array")
      return TomlValue::Bool(false)
    }
  }
  self.depth = self.depth - 1
  self.fail_here("unterminated array")
  TomlValue::Bool(false)
}

fn insert_single_key(
  self : Parser,
  tbl : ParseTable,
  key : String,
  value : TomlValue,
  err_pos : Int,
) -> Bool {
  if tbl.depth + 1 > max_parse_depth {
    self.fail(err_pos, "recursion limit exceeded")
    return false
  }
  if !tbl.insert_unique_leaf(key, value, self.seed) {
    self.fail(err_pos, "duplicate key")
    return false
  }
  true
}

fn insert_dotted_key(
  self : Parser,
  tbl : ParseTable,
  klen : Int,
  value : TomlValue,
  err_pos : Int,
) -> Bool {
  if tbl.depth + klen > max_parse_depth {
    self.fail(err_pos, "recursion limit exceeded")
    return false
  }
  let buf = self.key_buf
  let mut cur = tbl
  let mut i = 0
  while i < klen - 1 {
    let k = buf[i]
    let eidx = cur.find_sc(k, self)
    if eidx >= 0 {
      let sidx = self.found_sub
      if sidx >= 0 {
        match cur.subs {
          Some(subs) =>
          match subs[sidx].kind {
            SubKind::Tbl(sub) => {
              match sub.kind {
                TableKind::Dotted => cur = sub
                TableKind::Super => {
                  sub.kind = TableKind::Dotted
                  cur = sub
                }
                _ => {
                  self.fail(err_pos, "cannot extend table via dotted key")
                  return false
                }
              }
            }
            _ => {
              self.fail(err_pos, "key is not a table")
              return false
            }
          }
          None => {
            self.fail(err_pos, "key is not a table")
            return false
          }
        }
      } else {
        self.fail(err_pos, "key is not a table")
        return false
      }
    } else {
      let sub = ParseTable::new(TableKind::Dotted, cur.depth + 1)
      cur.add_entry_after_miss(k, TomlValue::Table(sub.entries), Some(SubKind::Tbl(sub)), self.seed)
      cur = sub
    }
    i = i + 1
  }
  let leaf = buf[klen - 1]
  if !cur.insert_unique_leaf(leaf, value, self.seed) {
    self.fail(err_pos, "duplicate key")
    return false
  }
  true
}

fn Parser::parse_inline_table(self : Parser) -> TomlValue {
  if self.depth >= max_parse_depth {
    self.fail_here("recursion limit exceeded in inline table")
    return TomlValue::Bool(false)
  }
  self.depth = self.depth + 1
  self.pos = self.pos + 1
  let entries : Array[(String, TomlValue)] = Array::with_capacity(4)
  let mut lazy_tbl : Option[ParseTable] = None
  let src = self.src
  let n = self.len
  self.skip_ws()
  if self.pos < n && src.code_unit_at(self.pos) == 125 {
    self.pos = self.pos + 1
    self.depth = self.depth - 1
    return TomlValue::Table(entries)
  }
  while true {
    let kp = self.pos
    let k0 = self.parse_simple_key()
    if self.has_err {
      self.depth = self.depth - 1
      return TomlValue::Bool(false)
    }
    if self.pos < n && src.code_unit_at(self.pos) == 32 {
      self.pos = self.pos + 1
    }
    if self.pos < n && (src.code_unit_at(self.pos) == 32 || src.code_unit_at(self.pos) == 9) {
      self.skip_ws()
    }
    if self.pos < n && src.code_unit_at(self.pos) == 61 {
      // Single-segment key fast path
      self.pos = self.pos + 1
      if self.pos < n && src.code_unit_at(self.pos) == 32 {
        self.pos = self.pos + 1
      }
      if self.pos < n && (src.code_unit_at(self.pos) == 32 || src.code_unit_at(self.pos) == 9) {
        self.skip_ws()
      }
      let v = self.parse_value_no_skip()
      if self.has_err {
        self.depth = self.depth - 1
        return TomlValue::Bool(false)
      }
      match lazy_tbl {
        Some(tbl) => {
          if !insert_single_key(self, tbl, k0, v, kp) {
            self.depth = self.depth - 1
            return TomlValue::Bool(false)
          }
        }
        None => {
          let en = entries.length()
          let mut dup = false
          let mut ei = 0
          while ei < en {
            let (ek, _) = entries[ei]
            if ek == k0 {
              dup = true
              break
            }
            ei = ei + 1
          }
          if dup {
            self.fail(kp, "duplicate key")
            self.depth = self.depth - 1
            return TomlValue::Bool(false)
          }
          entries.push((k0, v))
          if en + 1 > small_table_limit {
            let tbl = ParseTable::{
              kind: TableKind::Dotted,
              depth: self.depth,
              entries: entries,
              index: None,
              subs: None,
            }
            let _ = tbl.ensure_index(self.seed)
            lazy_tbl = Some(tbl)
          }
        }
      }
    } else if self.pos < n && src.code_unit_at(self.pos) == 46 {
      // Dotted key inside inline table: materialize ParseTable lazily
      let tbl = match lazy_tbl {
        Some(t) => t
        None => {
          let t = ParseTable::{
            kind: TableKind::Dotted,
            depth: self.depth,
            entries: entries,
            index: None,
            subs: None,
          }
          lazy_tbl = Some(t)
          t
        }
      }
      let keys : Array[String] = [k0]
      while self.pos < n && src.code_unit_at(self.pos) == 46 {
        if keys.length() >= max_parse_depth {
          self.depth = self.depth - 1
          self.fail_here("recursion limit exceeded in dotted key")
          return TomlValue::Bool(false)
        }
        self.pos = self.pos + 1
        self.skip_ws()
        let ki = self.parse_simple_key()
        if self.has_err {
          self.depth = self.depth - 1
          return TomlValue::Bool(false)
        }
        keys.push(ki)
        self.skip_ws()
      }
      if self.pos >= n || src.code_unit_at(self.pos) != 61 {
        self.depth = self.depth - 1
        self.fail_here("expected '=' in inline table")
        return TomlValue::Bool(false)
      }
      self.pos = self.pos + 1
      self.skip_ws()
      let v = self.parse_value_no_skip()
      if self.has_err {
        self.depth = self.depth - 1
        return TomlValue::Bool(false)
      }
      let klen = keys.length()
      let mut ki = 0
      while ki < klen {
        self.key_buf[ki] = keys[ki]
        ki = ki + 1
      }
      if !insert_dotted_key(self, tbl, klen, v, kp) {
        self.depth = self.depth - 1
        return TomlValue::Bool(false)
      }
    } else {
      self.depth = self.depth - 1
      self.fail_here("expected '=' in inline table")
      return TomlValue::Bool(false)
    }
    let mut next = if self.pos < n { src.code_unit_at(self.pos) } else { -1 }
    if next == 32 || next == 9 {
      self.skip_ws()
      next = if self.pos < n { src.code_unit_at(self.pos) } else { -1 }
    }
    if next == 44 {
      self.pos = self.pos + 1
      if self.pos < n && src.code_unit_at(self.pos) == 32 {
        self.pos = self.pos + 1
      }
      if self.pos < n && (src.code_unit_at(self.pos) == 32 || src.code_unit_at(self.pos) == 9) {
        self.skip_ws()
      }
      if self.pos < n && src.code_unit_at(self.pos) == 125 {
        self.depth = self.depth - 1
        self.fail_here("trailing comma not allowed in inline table")
        return TomlValue::Bool(false)
      }
    } else if next == 125 {
      self.pos = self.pos + 1
      self.depth = self.depth - 1
      return TomlValue::Table(entries)
    } else if next < 0 {
      self.depth = self.depth - 1
      self.fail_here("unterminated inline table")
      return TomlValue::Bool(false)
    } else {
      self.depth = self.depth - 1
      self.fail_here("expected ',' or '}' in inline table")
      return TomlValue::Bool(false)
    }
  }
  self.depth = self.depth - 1
  self.fail_here("unterminated inline table")
  TomlValue::Bool(false)
}

fn resolve_table_header(
  self : Parser,
  root : ParseTable,
  klen : Int,
  is_array : Bool,
  hdr_pos : Int,
) -> ParseTable {
  if klen > max_parse_depth {
    self.fail(hdr_pos, "recursion limit exceeded in table header")
    return root
  }
  let buf = self.key_buf
  let mut cur = root
  let mut i = 0
  while i < klen - 1 {
    let k = buf[i]
    let eidx = cur.find_sc(k, self)
    if eidx >= 0 {
      let sidx = self.found_sub
      if sidx >= 0 {
        match cur.subs {
          Some(subs) =>
          match subs[sidx].kind {
            SubKind::Tbl(sub) => {
              cur = sub
            }
            SubKind::AoT(_, last_tbl) => {
              cur = last_tbl
            }
          }
          None => {
            self.fail(hdr_pos, "key is not a table")
            return root
          }
        }
      } else {
        self.fail(hdr_pos, "key is not a table")
        return root
      }
    } else {
      let sub = ParseTable::new(TableKind::Super, cur.depth + 1)
      cur.add_entry_after_miss(k, TomlValue::Table(sub.entries), Some(SubKind::Tbl(sub)), self.seed)
      cur = sub
    }
    i = i + 1
  }
  let leaf = buf[klen - 1]
  let eidx = cur.find_sc(leaf, self)
  if is_array {
    if eidx >= 0 {
      let sidx = self.found_sub
      if sidx >= 0 {
        match cur.subs {
          Some(subs) =>
          match subs[sidx].kind {
            SubKind::AoT(arr, _) => {
              let next_tbl = ParseTable::new_cap(TableKind::Standard, cur.depth + 1, 4)
              arr.push(TomlValue::Table(next_tbl.entries))
              subs[sidx].kind = SubKind::AoT(arr, next_tbl)
              next_tbl
            }
            _ => {
              self.fail(hdr_pos, "cannot redefine key as array of tables")
              root
            }
          }
          None => {
            self.fail(hdr_pos, "cannot redefine key as array of tables")
            root
          }
        }
      } else {
        self.fail(hdr_pos, "cannot redefine key as array of tables")
        root
      }
    } else {
      let first = ParseTable::new_cap(TableKind::Standard, cur.depth + 1, 4)
      let arr : Array[TomlValue] = [TomlValue::Table(first.entries)]
      cur.add_entry_after_miss(leaf, TomlValue::Array(arr), Some(SubKind::AoT(arr, first)), self.seed)
      first
    }
  } else {
    if eidx >= 0 {
      let sidx = self.found_sub
      if sidx >= 0 {
        match cur.subs {
          Some(subs) =>
          match subs[sidx].kind {
            SubKind::Tbl(sub) => {
              match sub.kind {
                TableKind::Super => {
                  sub.kind = TableKind::Standard
                  sub
                }
                _ => {
                  self.fail(hdr_pos, "duplicate table definition")
                  root
                }
              }
            }
            _ => {
              self.fail(hdr_pos, "cannot redefine key as table")
              root
            }
          }
          None => {
            self.fail(hdr_pos, "cannot redefine key as table")
            root
          }
        }
      } else {
        self.fail(hdr_pos, "cannot redefine key as table")
        root
      }
    } else {
      let sub = ParseTable::new_cap(TableKind::Standard, cur.depth + 1, 4)
      cur.add_entry_after_miss(leaf, TomlValue::Table(sub.entries), Some(SubKind::Tbl(sub)), self.seed)
      sub
    }
  }
}

fn parse_validated(src : String) -> Result[TomlValue, TomlError] {
  let n = src.length()
  let bom_start = if n >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    3
  } else {
    0
  }
  let p = Parser::new(src, bom_start)
  let root = ParseTable::new_cap(TableKind::Root, 0, 8)
  let mut current = root
  while true {
    if p.pos < n {
      let b0 = src.code_unit_at(p.pos)
      if b0 == 32 || b0 == 9 || b0 == 10 || b0 == 13 || b0 == 35 {
        if !p.skip_ws_and_newlines() {
          return Err(p.to_err())
        }
      }
    }
    if p.pos >= n {
      break
    }
    let b = src.code_unit_at(p.pos)
    if b == 91 {
      // Table header [a.b] or Array of tables [[a.b]]
      p.pos = p.pos + 1
      let is_array = if p.pos < n && src.code_unit_at(p.pos) == 91 {
        p.pos = p.pos + 1
        true
      } else {
        false
      }
      if p.pos < n && (src.code_unit_at(p.pos) == 32 || src.code_unit_at(p.pos) == 9) {
        p.skip_ws()
      }
      let hdr_pos = p.pos
      let klen = p.parse_key_path_into_buf()
      if p.has_err {
        return Err(p.to_err())
      }
      if p.pos < n && (src.code_unit_at(p.pos) == 32 || src.code_unit_at(p.pos) == 9) {
        p.skip_ws()
      }
      if p.pos >= n || src.code_unit_at(p.pos) != 93 {
        p.fail_here("expected ']' to close table header")
        return Err(p.to_err())
      }
      p.pos = p.pos + 1
      if is_array {
        if p.pos >= n || src.code_unit_at(p.pos) != 93 {
          p.fail_here("expected ']]' to close array-of-tables header")
          return Err(p.to_err())
        }
        p.pos = p.pos + 1
      }
      if p.pos < n && src.code_unit_at(p.pos) == 10 {
        p.pos = p.pos + 1
      } else if !p.expect_eol_or_eof() {
        return Err(p.to_err())
      }
      current = resolve_table_header(p, root, klen, is_array, hdr_pos)
      if p.has_err {
        return Err(p.to_err())
      }
    } else {
      // Key-value pair
      let kp = p.pos
      let k0 = p.parse_simple_key()
      if p.has_err {
        return Err(p.to_err())
      }
      if p.pos < n && src.code_unit_at(p.pos) == 32 {
        p.pos = p.pos + 1
      }
      if p.pos < n && (src.code_unit_at(p.pos) == 32 || src.code_unit_at(p.pos) == 9) {
        p.skip_ws()
      }
      if p.pos < n && src.code_unit_at(p.pos) == 61 {
        // Single-segment key fast path (no key_buf, no Array!)
        p.pos = p.pos + 1
        if p.pos < n && src.code_unit_at(p.pos) == 32 {
          p.pos = p.pos + 1
        }
        if p.pos < n && (src.code_unit_at(p.pos) == 32 || src.code_unit_at(p.pos) == 9) {
          p.skip_ws()
        }
        let v = p.parse_value_no_skip()
        if p.has_err {
          return Err(p.to_err())
        }
        if !insert_single_key(p, current, k0, v, kp) {
          return Err(p.to_err())
        }
      } else if p.pos < n && src.code_unit_at(p.pos) == 46 {
        // Dotted key path: use local Array to stay re-entrant if RHS contains inline table
        let keys : Array[String] = [k0]
        while p.pos < n && src.code_unit_at(p.pos) == 46 {
          if keys.length() >= max_parse_depth {
            p.fail_here("recursion limit exceeded in dotted key")
            return Err(p.to_err())
          }
          p.pos = p.pos + 1
          p.skip_ws()
          let ki = p.parse_simple_key()
          if p.has_err {
            return Err(p.to_err())
          }
          keys.push(ki)
          p.skip_ws()
        }
        if p.pos >= n || src.code_unit_at(p.pos) != 61 {
          p.fail_here("expected '=' after key")
          return Err(p.to_err())
        }
        p.pos = p.pos + 1
        p.skip_ws()
        let v = p.parse_value_no_skip()
        if p.has_err {
          return Err(p.to_err())
        }
        let klen = keys.length()
        let mut ki = 0
        while ki < klen {
          p.key_buf[ki] = keys[ki]
          ki = ki + 1
        }
        if !insert_dotted_key(p, current, klen, v, kp) {
          return Err(p.to_err())
        }
      } else {
        p.fail_here("expected '=' after key")
        return Err(p.to_err())
      }
      if p.pos < n && src.code_unit_at(p.pos) == 10 {
        p.pos = p.pos + 1
      } else if !p.expect_eol_or_eof() {
        return Err(p.to_err())
      }
    }
  }
  Ok(TomlValue::Table(root.entries))
}
