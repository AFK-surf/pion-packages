///| Byte-indexed TOML v1.0.0 recursive-descent parser with O(1) table lookup
///| and full spec conflict detection.

enum TableKind {
  Root
  Standard
  Super
  Dotted
  Inline
}

struct ParseTable {
  mut kind : TableKind
  index : Map[String, Int]
  entries : Array[(String, ParseVal)]
}

enum ParseVal {
  Scalar(TomlValue)
  Arr(Array[ParseVal])
  AoT(Array[ParseTable])
  Tbl(ParseTable)
}

fn ParseTable::new(kind : TableKind) -> ParseTable {
  ParseTable::{ kind: kind, index: Map::new(), entries: [] }
}

fn seal_inline_table(tbl : ParseTable) -> Unit {
  tbl.kind = TableKind::Inline
  let n = tbl.entries.length()
  let mut i = 0
  while i < n {
    let (_, v) = tbl.entries[i]
    match v {
      ParseVal::Tbl(sub) => seal_inline_table(sub)
      _ => ()
    }
    i = i + 1
  }
}

fn freeze_val(v : ParseVal) -> TomlValue {
  match v {
    ParseVal::Scalar(tv) => tv
    ParseVal::Arr(items) => {
      let out : Array[TomlValue] = []
      let n = items.length()
      let mut i = 0
      while i < n {
        out.push(freeze_val(items[i]))
        i = i + 1
      }
      TomlValue::Array(out)
    }
    ParseVal::AoT(tables) => {
      let out : Array[TomlValue] = []
      let n = tables.length()
      let mut i = 0
      while i < n {
        out.push(freeze_table(tables[i]))
        i = i + 1
      }
      TomlValue::Array(out)
    }
    ParseVal::Tbl(tbl) => freeze_table(tbl)
  }
}

fn freeze_table(tbl : ParseTable) -> TomlValue {
  let out : Array[(String, TomlValue)] = []
  let n = tbl.entries.length()
  let mut i = 0
  while i < n {
    let (k, v) = tbl.entries[i]
    out.push((k, freeze_val(v)))
    i = i + 1
  }
  TomlValue::Table(out)
}

struct Parser {
  src : String
  len : Int
  mut pos : Int
  mut line : Int
  mut col : Int
}

fn Parser::new(src : String) -> Parser {
  Parser::{ src: src, len: src.length(), pos: 0, line: 1, col: 1 }
}

fn Parser::err(self : Parser, msg : String) -> TomlError {
  TomlError::new(self.line, self.col, self.pos, msg)
}

fn Parser::peek(self : Parser) -> Int {
  if self.pos < self.len {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

fn Parser::peek_at(self : Parser, offset : Int) -> Int {
  let idx = self.pos + offset
  if idx >= 0 && idx < self.len {
    self.src.code_unit_at(idx)
  } else {
    -1
  }
}

fn Parser::advance(self : Parser) -> Int {
  if self.pos >= self.len {
    return -1
  }
  let b = self.src.code_unit_at(self.pos)
  self.pos = self.pos + 1
  if b == 10 {
    self.line = self.line + 1
    self.col = 1
  } else {
    self.col = self.col + 1
  }
  b
}

fn is_ws(b : Int) -> Bool {
  b == 32 || b == 9
}

fn is_bare_key_byte(b : Int) -> Bool {
  (b >= 65 && b <= 90) ||
  (b >= 97 && b <= 122) ||
  (b >= 48 && b <= 57) ||
  b == 95 ||
  b == 45
}

fn is_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn Parser::skip_ws(self : Parser) -> Unit {
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 32 || b == 9 {
      self.pos = self.pos + 1
      self.col = self.col + 1
    } else {
      break
    }
  }
}

fn Parser::skip_comment(self : Parser) -> Result[Unit, TomlError] {
  // Assumes current byte is '#' (35)
  self.pos = self.pos + 1
  self.col = self.col + 1
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 10 {
      break
    }
    if b == 13 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
        break
      }
      return Err(self.err("bare carriage return in comment"))
    }
    if (b >= 0 && b <= 8) || (b >= 11 && b <= 31) || b == 127 {
      return Err(self.err("control character in comment"))
    }
    self.pos = self.pos + 1
    self.col = self.col + 1
  }
  Ok(())
}

fn Parser::skip_ws_and_newlines(self : Parser) -> Result[Unit, TomlError] {
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 32 || b == 9 {
      self.pos = self.pos + 1
      self.col = self.col + 1
    } else if b == 10 {
      self.pos = self.pos + 1
      self.line = self.line + 1
      self.col = 1
    } else if b == 13 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
        self.pos = self.pos + 2
        self.line = self.line + 1
        self.col = 1
      } else {
        return Err(self.err("bare carriage return"))
      }
    } else if b == 35 {
      match self.skip_comment() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      break
    }
  }
  Ok(())
}

fn Parser::expect_eol_or_eof(self : Parser) -> Result[Unit, TomlError] {
  self.skip_ws()
  if self.pos >= self.len {
    return Ok(())
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 35 {
    match self.skip_comment() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  if self.pos >= self.len {
    return Ok(())
  }
  let b2 = self.src.code_unit_at(self.pos)
  if b2 == 10 {
    self.pos = self.pos + 1
    self.line = self.line + 1
    self.col = 1
    Ok(())
  } else if b2 == 13 {
    if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
      self.pos = self.pos + 2
      self.line = self.line + 1
      self.col = 1
      Ok(())
    } else {
      Err(self.err("bare carriage return"))
    }
  } else {
    Err(self.err("expected newline or end of file"))
  }
}

fn Parser::parse_unicode_escape(self : Parser, digits : Int) -> Result[Int, TomlError] {
  if self.pos + digits > self.len {
    return Err(self.err("incomplete unicode escape"))
  }
  let mut cp : Int64 = 0L
  let mut i = 0
  while i < digits {
    let b = self.src.code_unit_at(self.pos + i)
    let hv = hex_val(b)
    if hv < 0 {
      return Err(self.err("invalid hex digit in unicode escape"))
    }
    cp = (cp << 4L) | hv.to_int64()
    i = i + 1
  }
  self.pos = self.pos + digits
  self.col = self.col + digits
  if cp < 0L || cp > 0x10FFFFL || (cp >= 0xD800L && cp <= 0xDFFFL) {
    return Err(self.err("invalid unicode scalar value in escape"))
  }
  Ok(cp.to_int())
}

fn Parser::parse_escape_seq(self : Parser, sb : StringBuilder) -> Result[Unit, TomlError] {
  if self.pos >= self.len {
    return Err(self.err("unterminated escape sequence"))
  }
  let b = self.advance()
  if b == 98 {
    sb.write_byte((8).to_byte())
  } else if b == 116 {
    sb.write_byte((9).to_byte())
  } else if b == 110 {
    sb.write_byte((10).to_byte())
  } else if b == 102 {
    sb.write_byte((12).to_byte())
  } else if b == 114 {
    sb.write_byte((13).to_byte())
  } else if b == 34 {
    sb.write_byte((34).to_byte())
  } else if b == 92 {
    sb.write_byte((92).to_byte())
  } else if b == 117 {
    match self.parse_unicode_escape(4) {
      Ok(cp) => write_utf8(sb, cp)
      Err(e) => return Err(e)
    }
  } else if b == 85 {
    match self.parse_unicode_escape(8) {
      Ok(cp) => write_utf8(sb, cp)
      Err(e) => return Err(e)
    }
  } else {
    return Err(self.err("invalid escape sequence"))
  }
  Ok(())
}

fn Parser::parse_basic_string(self : Parser) -> Result[String, TomlError] {
  // Opening '"'
  let _ = self.advance()
  let start = self.pos
  // Fast path: scan for closing '"' without escapes
  let mut has_escape = false
  let mut scan = start
  while scan < self.len {
    let b = self.src.code_unit_at(scan)
    if b == 34 {
      break
    }
    if b == 92 {
      has_escape = true
      break
    }
    if (b >= 0 && b <= 8) || (b >= 10 && b <= 31) || b == 127 {
      self.pos = scan
      return Err(self.err("control character or newline in basic string"))
    }
    scan = scan + 1
  }
  if !has_escape {
    if scan >= self.len {
      self.pos = scan
      return Err(self.err("unterminated basic string"))
    }
    let out = self.src.slice(start, scan)
    let consumed = scan - start + 1
    self.pos = scan + 1
    self.col = self.col + consumed
    return Ok(out)
  }
  let sb = StringBuilder::new()
  if scan > start {
    sb.write_string(self.src.slice(start, scan))
    self.col = self.col + (scan - start)
    self.pos = scan
  }
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 34 {
      let _ = self.advance()
      return Ok(sb.to_string())
    }
    if b == 92 {
      let _ = self.advance()
      match self.parse_escape_seq(sb) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if (b >= 0 && b <= 8) || (b >= 10 && b <= 31) || b == 127 {
      return Err(self.err("control character or newline in basic string"))
    } else {
      sb.write_byte(b.to_byte())
      let _ = self.advance()
    }
  }
  Err(self.err("unterminated basic string"))
}

fn Parser::parse_multiline_basic_string(self : Parser) -> Result[String, TomlError] {
  // Opening '"""'
  let _ = self.advance()
  let _ = self.advance()
  let _ = self.advance()
  // Trim immediate first newline if present
  if self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 10 {
      let _ = self.advance()
    } else if b == 13 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
      let _ = self.advance()
      let _ = self.advance()
    }
  }
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 34 {
      let mut qcount = 0
      while self.pos + qcount < self.len && self.src.code_unit_at(self.pos + qcount) == 34 {
        qcount = qcount + 1
      }
      if qcount >= 3 {
        if qcount > 5 {
          return Err(self.err("too many consecutive quotes in multiline basic string"))
        }
        let extra = qcount - 3
        let mut k = 0
        while k < extra {
          sb.write_byte((34).to_byte())
          k = k + 1
        }
        self.pos = self.pos + qcount
        self.col = self.col + qcount
        return Ok(sb.to_string())
      } else {
        let mut k = 0
        while k < qcount {
          sb.write_byte((34).to_byte())
          k = k + 1
        }
        self.pos = self.pos + qcount
        self.col = self.col + qcount
      }
    } else if b == 92 {
      let _ = self.advance()
      // Check for line-ending backslash: optional spaces/tabs then newline
      let save_pos = self.pos
      let save_line = self.line
      let save_col = self.col
      let mut saw_nl = false
      while self.pos < self.len {
        let c = self.src.code_unit_at(self.pos)
        if c == 32 || c == 9 {
          let _ = self.advance()
        } else if c == 10 {
          let _ = self.advance()
          saw_nl = true
          break
        } else if c == 13 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
          let _ = self.advance()
          let _ = self.advance()
          saw_nl = true
          break
        } else {
          break
        }
      }
      if saw_nl {
        // Trim all subsequent whitespace and newlines
        while self.pos < self.len {
          let c = self.src.code_unit_at(self.pos)
          if c == 32 || c == 9 || c == 10 {
            let _ = self.advance()
          } else if c == 13 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
            let _ = self.advance()
            let _ = self.advance()
          } else {
            break
          }
        }
      } else {
        if self.pos != save_pos {
          return Err(self.err("invalid whitespace after backslash in multiline string"))
        }
        self.pos = save_pos
        self.line = save_line
        self.col = save_col
        match self.parse_escape_seq(sb) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
    } else if b == 13 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
        sb.write_byte((10).to_byte())
        let _ = self.advance()
        let _ = self.advance()
      } else {
        return Err(self.err("bare carriage return in multiline basic string"))
      }
    } else if (b >= 0 && b <= 8) || b == 11 || b == 12 || (b >= 14 && b <= 31) || b == 127 {
      return Err(self.err("control character in multiline basic string"))
    } else {
      sb.write_byte(b.to_byte())
      let _ = self.advance()
    }
  }
  Err(self.err("unterminated multiline basic string"))
}

fn Parser::parse_literal_string(self : Parser) -> Result[String, TomlError] {
  // Opening '\''
  let _ = self.advance()
  let start = self.pos
  let mut scan = start
  while scan < self.len {
    let b = self.src.code_unit_at(scan)
    if b == 39 {
      let out = self.src.slice(start, scan)
      let consumed = scan - start + 1
      self.pos = scan + 1
      self.col = self.col + consumed
      return Ok(out)
    }
    if (b >= 0 && b <= 8) || (b >= 10 && b <= 31) || b == 127 {
      self.pos = scan
      return Err(self.err("control character or newline in literal string"))
    }
    scan = scan + 1
  }
  self.pos = scan
  Err(self.err("unterminated literal string"))
}

fn Parser::parse_multiline_literal_string(self : Parser) -> Result[String, TomlError] {
  // Opening "'''"
  let _ = self.advance()
  let _ = self.advance()
  let _ = self.advance()
  // Trim immediate first newline if present
  if self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 10 {
      let _ = self.advance()
    } else if b == 13 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
      let _ = self.advance()
      let _ = self.advance()
    }
  }
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 39 {
      let mut qcount = 0
      while self.pos + qcount < self.len && self.src.code_unit_at(self.pos + qcount) == 39 {
        qcount = qcount + 1
      }
      if qcount >= 3 {
        if qcount > 5 {
          return Err(self.err("too many consecutive quotes in multiline literal string"))
        }
        let extra = qcount - 3
        let mut k = 0
        while k < extra {
          sb.write_byte((39).to_byte())
          k = k + 1
        }
        self.pos = self.pos + qcount
        self.col = self.col + qcount
        return Ok(sb.to_string())
      } else {
        let mut k = 0
        while k < qcount {
          sb.write_byte((39).to_byte())
          k = k + 1
        }
        self.pos = self.pos + qcount
        self.col = self.col + qcount
      }
    } else if b == 13 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
        sb.write_byte((10).to_byte())
        let _ = self.advance()
        let _ = self.advance()
      } else {
        return Err(self.err("bare carriage return in multiline literal string"))
      }
    } else if (b >= 0 && b <= 8) || b == 11 || b == 12 || (b >= 14 && b <= 31) || b == 127 {
      return Err(self.err("control character in multiline literal string"))
    } else {
      sb.write_byte(b.to_byte())
      let _ = self.advance()
    }
  }
  Err(self.err("unterminated multiline literal string"))
}

fn Parser::parse_simple_key(self : Parser) -> Result[String, TomlError] {
  if self.pos >= self.len {
    return Err(self.err("expected key"))
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 34 {
    // Multiline strings are NOT allowed as keys
    if self.peek_at(1) == 34 && self.peek_at(2) == 34 {
      return Err(self.err("multiline basic string not allowed as key"))
    }
    self.parse_basic_string()
  } else if b == 39 {
    if self.peek_at(1) == 39 && self.peek_at(2) == 39 {
      return Err(self.err("multiline literal string not allowed as key"))
    }
    self.parse_literal_string()
  } else if is_bare_key_byte(b) {
    let start = self.pos
    while self.pos < self.len && is_bare_key_byte(self.src.code_unit_at(self.pos)) {
      self.pos = self.pos + 1
      self.col = self.col + 1
    }
    Ok(self.src.slice(start, self.pos))
  } else {
    Err(self.err("invalid key character"))
  }
}

fn Parser::parse_key_path(self : Parser) -> Result[Array[String], TomlError] {
  let keys : Array[String] = []
  self.skip_ws()
  match self.parse_simple_key() {
    Ok(k) => keys.push(k)
    Err(e) => return Err(e)
  }
  while true {
    self.skip_ws()
    if self.peek() == 46 {
      let _ = self.advance()
      self.skip_ws()
      match self.parse_simple_key() {
        Ok(k) => keys.push(k)
        Err(e) => return Err(e)
      }
    } else {
      break
    }
  }
  Ok(keys)
}

fn is_value_delim(b : Int) -> Bool {
  b == -1 || b == 32 || b == 9 || b == 10 || b == 13 || b == 35 || b == 44 || b == 93 || b == 125
}

fn is_leap_year_p(y : Int) -> Bool {
  (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)
}

fn days_in_month_p(y : Int, m : Int) -> Int {
  if m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12 {
    31
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else if m == 2 {
    if is_leap_year_p(y) { 29 } else { 28 }
  } else {
    0
  }
}

fn parse_fixed_digits(s : String, pos : Int, count : Int) -> Option[Int] {
  if pos + count > s.length() {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < count {
    let b = s.code_unit_at(pos + i)
    if b < 48 || b > 57 {
      return None
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  Some(acc)
}

fn parse_time_part(s : String, pos : Int, end : Int) -> Option[Int] {
  // HH:MM:SS(.frac)?
  if pos + 8 > end {
    return None
  }
  if s.code_unit_at(pos + 2) != 58 || s.code_unit_at(pos + 5) != 58 {
    return None
  }
  let hh = match parse_fixed_digits(s, pos, 2) {
    Some(v) => v
    None => return None
  }
  let mm = match parse_fixed_digits(s, pos + 3, 2) {
    Some(v) => v
    None => return None
  }
  let ss = match parse_fixed_digits(s, pos + 6, 2) {
    Some(v) => v
    None => return None
  }
  if hh > 23 || mm > 59 || ss > 59 {
    return None
  }
  let mut p = pos + 8
  if p < end && s.code_unit_at(p) == 46 {
    p = p + 1
    let fstart = p
    while p < end && is_digit(s.code_unit_at(p)) {
      p = p + 1
    }
    if p == fstart {
      return None
    }
  }
  Some(p)
}

fn Parser::try_parse_datetime_or_time(self : Parser) -> Option[Result[TomlValue, TomlError]] {
  let start = self.pos
  let s = self.src
  let n = self.len
  // Check local time: DD:DD:DD...
  if start + 2 < n &&
  is_digit(s.code_unit_at(start)) &&
  is_digit(s.code_unit_at(start + 1)) &&
  s.code_unit_at(start + 2) == 58 {
    // Scan until delimiter
    let mut end = start
    while end < n && !is_value_delim(s.code_unit_at(end)) {
      end = end + 1
    }
    match parse_time_part(s, start, end) {
      Some(p) => {
        if p == end {
          let raw = s.slice(start, end)
          self.col = self.col + (end - start)
          self.pos = end
          return Some(Ok(TomlValue::LocalTime(raw)))
        }
        return Some(Err(self.err("invalid local time")))
      }
      None => return Some(Err(self.err("invalid local time")))
    }
  }
  // Check date: DDDD-DD-DD...
  if start + 4 < n &&
  is_digit(s.code_unit_at(start)) &&
  is_digit(s.code_unit_at(start + 1)) &&
  is_digit(s.code_unit_at(start + 2)) &&
  is_digit(s.code_unit_at(start + 3)) &&
  s.code_unit_at(start + 4) == 45 {
    // Must be a date or datetime
    if start + 10 > n || s.code_unit_at(start + 7) != 45 {
      return Some(Err(self.err("invalid date format")))
    }
    let y = match parse_fixed_digits(s, start, 4) {
      Some(v) => v
      None => return Some(Err(self.err("invalid year")))
    }
    let mo = match parse_fixed_digits(s, start + 5, 2) {
      Some(v) => v
      None => return Some(Err(self.err("invalid month")))
    }
    let d = match parse_fixed_digits(s, start + 8, 2) {
      Some(v) => v
      None => return Some(Err(self.err("invalid day")))
    }
    if mo < 1 || mo > 12 {
      return Some(Err(self.err("month out of range")))
    }
    let dim = days_in_month_p(y, mo)
    if d < 1 || d > dim {
      return Some(Err(self.err("day out of range")))
    }
    let mut p = start + 10
    if p >= n || is_value_delim(s.code_unit_at(p)) {
      // Check if space followed by time (DD:...)
      let has_space_time = p + 3 < n &&
      s.code_unit_at(p) == 32 &&
      is_digit(s.code_unit_at(p + 1)) &&
      is_digit(s.code_unit_at(p + 2)) &&
      s.code_unit_at(p + 3) == 58
      if !has_space_time {
        let raw = s.slice(start, p)
        self.col = self.col + (p - start)
        self.pos = p
        return Some(Ok(TomlValue::LocalDate(raw)))
      }
    }
    // Date-time separator: T, t, or single space
    let sep = s.code_unit_at(p)
    if sep != 84 && sep != 116 && sep != 32 {
      return Some(Err(self.err("invalid date-time separator")))
    }
    p = p + 1
    let mut end = p
    while end < n && !is_value_delim(s.code_unit_at(end)) {
      end = end + 1
    }
    let after_time = match parse_time_part(s, p, end) {
      Some(pos2) => pos2
      None => return Some(Err(self.err("invalid time in date-time")))
    }
    if after_time == end {
      let raw = s.slice(start, end)
      self.col = self.col + (end - start)
      self.pos = end
      return Some(Ok(TomlValue::LocalDateTime(raw)))
    }
    // Offset: Z / z / [+-]HH:MM
    let ob = s.code_unit_at(after_time)
    if ob == 90 || ob == 122 {
      if after_time + 1 != end {
        return Some(Err(self.err("trailing characters after Z offset")))
      }
      let raw = s.slice(start, end)
      self.col = self.col + (end - start)
      self.pos = end
      return Some(Ok(TomlValue::OffsetDateTime(raw)))
    } else if ob == 43 || ob == 45 {
      if after_time + 6 != end || s.code_unit_at(after_time + 3) != 58 {
        return Some(Err(self.err("invalid timezone offset")))
      }
      let oh = match parse_fixed_digits(s, after_time + 1, 2) {
        Some(v) => v
        None => return Some(Err(self.err("invalid offset hour")))
      }
      let om = match parse_fixed_digits(s, after_time + 4, 2) {
        Some(v) => v
        None => return Some(Err(self.err("invalid offset minute")))
      }
      if oh > 23 || om > 59 {
        return Some(Err(self.err("timezone offset out of range")))
      }
      let raw = s.slice(start, end)
      self.col = self.col + (end - start)
      self.pos = end
      return Some(Ok(TomlValue::OffsetDateTime(raw)))
    } else {
      return Some(Err(self.err("invalid timezone offset")))
    }
  }
  None
}

fn parse_radix_int(token : String, start : Int, radix : Int64) -> Option[Int64] {
  let n = token.length()
  if start >= n {
    return None
  }
  let i64_max : Int64 = 9223372036854775807L
  let mut acc : Int64 = 0L
  let mut i = start
  let mut prev_us = false
  let mut digits = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 95 {
      if digits == 0 || prev_us || i + 1 >= n {
        return None
      }
      prev_us = true
      i = i + 1
    } else {
      let d = if radix == 16L {
        hex_val(b)
      } else if radix == 8L {
        if b >= 48 && b <= 55 { b - 48 } else { -1 }
      } else {
        if b == 48 || b == 49 { b - 48 } else { -1 }
      }
      if d < 0 {
        return None
      }
      let dl = d.to_int64()
      if acc > (i64_max - dl) / radix {
        return None
      }
      acc = acc * radix + dl
      digits = digits + 1
      prev_us = false
      i = i + 1
    }
  }
  if digits == 0 || prev_us {
    return None
  }
  Some(acc)
}

fn parse_decimal_int(token : String) -> Option[Int64] {
  let n = token.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  let b0 = token.code_unit_at(0)
  if b0 == 43 {
    i = 1
  } else if b0 == 45 {
    neg = true
    i = 1
  }
  if i >= n {
    return None
  }
  // Leading zero check
  let first = token.code_unit_at(i)
  if !is_digit(first) {
    return None
  }
  if first == 48 && i + 1 < n {
    return None
  }
  let i64_min : Int64 = -9223372036854775807L - 1L
  // Accumulate as negative Int64 so -9223372036854775808 works without overflow
  let mut acc : Int64 = 0L
  let mut prev_us = false
  let mut digits = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 95 {
      if digits == 0 || prev_us || i + 1 >= n {
        return None
      }
      prev_us = true
      i = i + 1
    } else if is_digit(b) {
      let dl = (b - 48).to_int64()
      if acc < (i64_min + dl) / 10L {
        return None
      }
      acc = acc * 10L - dl
      digits = digits + 1
      prev_us = false
      i = i + 1
    } else {
      return None
    }
  }
  if digits == 0 || prev_us {
    return None
  }
  if neg {
    Some(acc)
  } else {
    if acc == i64_min {
      return None
    }
    Some(-acc)
  }
}

fn parse_toml_float(token : String) -> Option[Double] {
  let n = token.length()
  if n == 0 {
    return None
  }
  if token == "inf" || token == "+inf" {
    return Some(1.0 / 0.0)
  }
  if token == "-inf" {
    return Some(-1.0 / 0.0)
  }
  if token == "nan" || token == "+nan" || token == "-nan" {
    return Some(0.0 / 0.0)
  }
  let sb = StringBuilder::new()
  let mut i = 0
  let b0 = token.code_unit_at(0)
  if b0 == 43 || b0 == 45 {
    sb.write_byte(b0.to_byte())
    i = 1
  }
  if i >= n || !is_digit(token.code_unit_at(i)) {
    return None
  }
  // Integer part: no leading zeros
  let int_first = token.code_unit_at(i)
  let mut int_digits = 0
  let mut prev_us = false
  while i < n {
    let b = token.code_unit_at(i)
    if is_digit(b) {
      sb.write_byte(b.to_byte())
      int_digits = int_digits + 1
      prev_us = false
      i = i + 1
    } else if b == 95 {
      if int_digits == 0 || prev_us {
        return None
      }
      prev_us = true
      i = i + 1
    } else {
      break
    }
  }
  if prev_us {
    return None
  }
  if int_first == 48 && int_digits > 1 {
    return None
  }
  let mut has_frac = false
  let mut has_exp = false
  // Fractional part
  if i < n && token.code_unit_at(i) == 46 {
    has_frac = true
    sb.write_byte((46).to_byte())
    i = i + 1
    let mut frac_digits = 0
    prev_us = false
    while i < n {
      let b = token.code_unit_at(i)
      if is_digit(b) {
        sb.write_byte(b.to_byte())
        frac_digits = frac_digits + 1
        prev_us = false
        i = i + 1
      } else if b == 95 {
        if frac_digits == 0 || prev_us {
          return None
        }
        prev_us = true
        i = i + 1
      } else {
        break
      }
    }
    if frac_digits == 0 || prev_us {
      return None
    }
  }
  // Exponent part
  if i < n && (token.code_unit_at(i) == 101 || token.code_unit_at(i) == 69) {
    has_exp = true
    sb.write_byte((101).to_byte())
    i = i + 1
    if i < n && (token.code_unit_at(i) == 43 || token.code_unit_at(i) == 45) {
      sb.write_byte(token.code_unit_at(i).to_byte())
      i = i + 1
    }
    let mut exp_digits = 0
    prev_us = false
    while i < n {
      let b = token.code_unit_at(i)
      if is_digit(b) {
        sb.write_byte(b.to_byte())
        exp_digits = exp_digits + 1
        prev_us = false
        i = i + 1
      } else if b == 95 {
        if exp_digits == 0 || prev_us {
          return None
        }
        prev_us = true
        i = i + 1
      } else {
        break
      }
    }
    if exp_digits == 0 || prev_us {
      return None
    }
  }
  if i != n || (!has_frac && !has_exp) {
    return None
  }
  sb.to_string().to_double()
}

fn Parser::parse_scalar_token(self : Parser) -> Result[TomlValue, TomlError] {
  match self.try_parse_datetime_or_time() {
    Some(res) => return res
    None => ()
  }
  let start = self.pos
  while self.pos < self.len && !is_value_delim(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
    self.col = self.col + 1
  }
  let tok = self.src.slice(start, self.pos)
  if tok.length() == 0 {
    return Err(self.err("expected value"))
  }
  if tok == "true" {
    return Ok(TomlValue::Bool(true))
  }
  if tok == "false" {
    return Ok(TomlValue::Bool(false))
  }
  if tok == "inf" || tok == "+inf" {
    return Ok(TomlValue::Float(1.0 / 0.0))
  }
  if tok == "-inf" {
    return Ok(TomlValue::Float(-1.0 / 0.0))
  }
  if tok == "nan" || tok == "+nan" || tok == "-nan" {
    return Ok(TomlValue::Float(0.0 / 0.0))
  }
  // Check radix integers: 0x, 0o, 0b (must be unsigned, lowercase prefix)
  if tok.length() >= 2 && tok.code_unit_at(0) == 48 {
    let b1 = tok.code_unit_at(1)
    if b1 == 120 {
      match parse_radix_int(tok, 2, 16L) {
        Some(v) => return Ok(TomlValue::Int(v))
        None => return Err(self.err("invalid hex integer"))
      }
    } else if b1 == 111 {
      match parse_radix_int(tok, 2, 8L) {
        Some(v) => return Ok(TomlValue::Int(v))
        None => return Err(self.err("invalid octal integer"))
      }
    } else if b1 == 98 {
      match parse_radix_int(tok, 2, 2L) {
        Some(v) => return Ok(TomlValue::Int(v))
        None => return Err(self.err("invalid binary integer"))
      }
    }
  }
  // Check if it looks like a float (contains '.', 'e', 'E')
  let mut has_float_char = false
  let mut j = 0
  while j < tok.length() {
    let b = tok.code_unit_at(j)
    if b == 46 || b == 101 || b == 69 {
      has_float_char = true
      break
    }
    j = j + 1
  }
  if has_float_char {
    match parse_toml_float(tok) {
      Some(f) => return Ok(TomlValue::Float(f))
      None => return Err(self.err("invalid float literal"))
    }
  }
  match parse_decimal_int(tok) {
    Some(v) => Ok(TomlValue::Int(v))
    None => Err(self.err("invalid value literal"))
  }
}

fn Parser::parse_value(self : Parser) -> Result[ParseVal, TomlError] {
  self.skip_ws()
  if self.pos >= self.len {
    return Err(self.err("expected value"))
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 34 {
    if self.peek_at(1) == 34 && self.peek_at(2) == 34 {
      match self.parse_multiline_basic_string() {
        Ok(s) => Ok(ParseVal::Scalar(TomlValue::Str(s)))
        Err(e) => Err(e)
      }
    } else {
      match self.parse_basic_string() {
        Ok(s) => Ok(ParseVal::Scalar(TomlValue::Str(s)))
        Err(e) => Err(e)
      }
    }
  } else if b == 39 {
    if self.peek_at(1) == 39 && self.peek_at(2) == 39 {
      match self.parse_multiline_literal_string() {
        Ok(s) => Ok(ParseVal::Scalar(TomlValue::Str(s)))
        Err(e) => Err(e)
      }
    } else {
      match self.parse_literal_string() {
        Ok(s) => Ok(ParseVal::Scalar(TomlValue::Str(s)))
        Err(e) => Err(e)
      }
    }
  } else if b == 91 {
    self.parse_array()
  } else if b == 123 {
    self.parse_inline_table()
  } else {
    match self.parse_scalar_token() {
      Ok(v) => Ok(ParseVal::Scalar(v))
      Err(e) => Err(e)
    }
  }
}

fn Parser::parse_array(self : Parser) -> Result[ParseVal, TomlError] {
  // Opening '['
  let _ = self.advance()
  let items : Array[ParseVal] = []
  match self.skip_ws_and_newlines() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.peek() == 93 {
    let _ = self.advance()
    return Ok(ParseVal::Arr(items))
  }
  while true {
    match self.skip_ws_and_newlines() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.peek() == 93 {
      let _ = self.advance()
      return Ok(ParseVal::Arr(items))
    }
    let v = match self.parse_value() {
      Ok(val_item) => val_item
      Err(e) => return Err(e)
    }
    items.push(v)
    match self.skip_ws_and_newlines() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let next = self.peek()
    if next == 44 {
      let _ = self.advance()
      match self.skip_ws_and_newlines() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if self.peek() == 93 {
        let _ = self.advance()
        return Ok(ParseVal::Arr(items))
      }
    } else if next == 93 {
      let _ = self.advance()
      return Ok(ParseVal::Arr(items))
    } else {
      return Err(self.err("expected ',' or ']' in array"))
    }
  }
  Err(self.err("unterminated array"))
}

fn insert_key_value(
  self : Parser,
  tbl : ParseTable,
  keys : Array[String],
  value : ParseVal,
) -> Result[Unit, TomlError] {
  let n = keys.length()
  let mut cur = tbl
  let mut i = 0
  while i < n - 1 {
    let k = keys[i]
    match cur.index.get(k) {
      Some(idx) => {
        let (_, existing) = cur.entries[idx]
        match existing {
          ParseVal::Tbl(sub) => {
            match sub.kind {
              TableKind::Dotted => {
                cur = sub
              }
              TableKind::Super => {
                // Dotted key defining into an implicit super-table is valid
                sub.kind = TableKind::Dotted
                cur = sub
              }
              _ => return Err(self.err("cannot extend table via dotted key"))
            }
          }
          _ => return Err(self.err("key is not a table"))
        }
      }
      None => {
        let sub = ParseTable::new(TableKind::Dotted)
        let idx = cur.entries.length()
        cur.index.set(k, idx)
        cur.entries.push((k, ParseVal::Tbl(sub)))
        cur = sub
      }
    }
    i = i + 1
  }
  let leaf = keys[n - 1]
  match cur.index.get(leaf) {
    Some(_) => return Err(self.err("duplicate key"))
    None => {
      let idx = cur.entries.length()
      cur.index.set(leaf, idx)
      cur.entries.push((leaf, value))
      Ok(())
    }
  }
}

fn Parser::parse_inline_table(self : Parser) -> Result[ParseVal, TomlError] {
  // Opening '{'
  let _ = self.advance()
  let tbl = ParseTable::new(TableKind::Dotted)
  self.skip_ws()
  if self.peek() == 125 {
    let _ = self.advance()
    seal_inline_table(tbl)
    return Ok(ParseVal::Tbl(tbl))
  }
  while true {
    self.skip_ws()
    let keys = match self.parse_key_path() {
      Ok(ks) => ks
      Err(e) => return Err(e)
    }
    self.skip_ws()
    if self.peek() != 61 {
      return Err(self.err("expected '=' in inline table"))
    }
    let _ = self.advance()
    self.skip_ws()
    let v = match self.parse_value() {
      Ok(val_item) => val_item
      Err(e) => return Err(e)
    }
    match insert_key_value(self, tbl, keys, v) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    self.skip_ws()
    let next = self.peek()
    if next == 44 {
      let _ = self.advance()
      // Trailing comma is forbidden in TOML v1.0.0 inline tables
      self.skip_ws()
      if self.peek() == 125 {
        return Err(self.err("trailing comma not allowed in inline table"))
      }
    } else if next == 125 {
      let _ = self.advance()
      seal_inline_table(tbl)
      return Ok(ParseVal::Tbl(tbl))
    } else {
      return Err(self.err("expected ',' or '}' in inline table"))
    }
  }
  Err(self.err("unterminated inline table"))
}

fn resolve_table_header(
  self : Parser,
  root : ParseTable,
  keys : Array[String],
  is_array : Bool,
) -> Result[ParseTable, TomlError] {
  let n = keys.length()
  let mut cur = root
  let mut i = 0
  while i < n - 1 {
    let k = keys[i]
    match cur.index.get(k) {
      Some(idx) => {
        let (_, existing) = cur.entries[idx]
        match existing {
          ParseVal::Tbl(sub) => {
            match sub.kind {
              TableKind::Inline =>
              return Err(self.err("cannot extend inline table"))
              _ => cur = sub
            }
          }
          ParseVal::AoT(arr) => {
            if arr.length() == 0 {
              return Err(self.err("empty array of tables"))
            }
            cur = arr[arr.length() - 1]
          }
          _ => return Err(self.err("key is not a table"))
        }
      }
      None => {
        let sub = ParseTable::new(TableKind::Super)
        let idx = cur.entries.length()
        cur.index.set(k, idx)
        cur.entries.push((k, ParseVal::Tbl(sub)))
        cur = sub
      }
    }
    i = i + 1
  }
  let leaf = keys[n - 1]
  if is_array {
    match cur.index.get(leaf) {
      Some(idx) => {
        let (_, existing) = cur.entries[idx]
        match existing {
          ParseVal::AoT(arr) => {
            let next_tbl = ParseTable::new(TableKind::Standard)
            arr.push(next_tbl)
            Ok(next_tbl)
          }
          _ => Err(self.err("cannot redefine key as array of tables"))
        }
      }
      None => {
        let first = ParseTable::new(TableKind::Standard)
        let arr : Array[ParseTable] = [first]
        let idx = cur.entries.length()
        cur.index.set(leaf, idx)
        cur.entries.push((leaf, ParseVal::AoT(arr)))
        Ok(first)
      }
    }
  } else {
    match cur.index.get(leaf) {
      Some(idx) => {
        let (_, existing) = cur.entries[idx]
        match existing {
          ParseVal::Tbl(sub) => {
            match sub.kind {
              TableKind::Super => {
                sub.kind = TableKind::Standard
                Ok(sub)
              }
              _ => Err(self.err("duplicate table definition"))
            }
          }
          _ => Err(self.err("cannot redefine key as table"))
        }
      }
      None => {
        let sub = ParseTable::new(TableKind::Standard)
        let idx = cur.entries.length()
        cur.index.set(leaf, idx)
        cur.entries.push((leaf, ParseVal::Tbl(sub)))
        Ok(sub)
      }
    }
  }
}

fn parse_validated(src : String) -> Result[TomlValue, TomlError] {
  let p = Parser::new(src)
  // Reject UTF-8 BOM (EF BB BF) per TOML v1.0.0
  if p.len >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    return Err(p.err("UTF-8 BOM is not allowed in TOML v1.0.0"))
  }
  let root = ParseTable::new(TableKind::Root)
  let mut current = root
  while true {
    match p.skip_ws_and_newlines() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if p.pos >= p.len {
      break
    }
    let b = p.peek()
    if b == 91 {
      // Table header [a.b] or Array of tables [[a.b]]
      let _ = p.advance()
      let is_array = if p.peek() == 91 {
        let _ = p.advance()
        true
      } else {
        false
      }
      p.skip_ws()
      let keys = match p.parse_key_path() {
        Ok(ks) => ks
        Err(e) => return Err(e)
      }
      p.skip_ws()
      if p.peek() != 93 {
        return Err(p.err("expected ']' to close table header"))
      }
      let _ = p.advance()
      if is_array {
        if p.peek() != 93 {
          return Err(p.err("expected ']]' to close array-of-tables header"))
        }
        let _ = p.advance()
      }
      match p.expect_eol_or_eof() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match resolve_table_header(p, root, keys, is_array) {
        Ok(next_tbl) => current = next_tbl
        Err(e) => return Err(e)
      }
    } else {
      // Key-value pair
      let keys = match p.parse_key_path() {
        Ok(ks) => ks
        Err(e) => return Err(e)
      }
      p.skip_ws()
      if p.peek() != 61 {
        return Err(p.err("expected '=' after key"))
      }
      let _ = p.advance()
      p.skip_ws()
      let v = match p.parse_value() {
        Ok(val_item) => val_item
        Err(e) => return Err(e)
      }
      match insert_key_value(p, current, keys, v) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match p.expect_eol_or_eof() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
  }
  Ok(freeze_table(root))
}
