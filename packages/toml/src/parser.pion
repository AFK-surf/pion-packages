///| Byte-indexed TOML v1.0.0 recursive-descent parser with direct TomlValue
///| construction, lazy seeded HashIndex (HashDoS-resistant), explicit recursion
///| depth guards, and full spec conflict detection.

let max_parse_depth : Int = 128
let small_table_limit : Int = 16

enum TableKind {
  Root
  Standard
  Super
  Dotted
  Inline
}

enum SubKind {
  Tbl(ParseTable)
  AoT(Array[TomlValue], ParseTable)
}

struct SubMeta {
  entry_idx : Int
  mut kind : SubKind
}

struct ParseTable {
  mut kind : TableKind
  depth : Int
  entries : Array[(String, TomlValue)]
  mut index : Option[HashIndex]
  mut subs : Option[Array[SubMeta]]
}

fn ParseTable::new(kind : TableKind, depth : Int) -> ParseTable {
  ParseTable::{ kind: kind, depth: depth, entries: [], index: None, subs: None }
}

///| Look up `key` in `self`. Returns `(entry_idx, sub_idx)` or `(-1, -1)`.
fn ParseTable::find(self : ParseTable, key : String) -> (Int, Int) {
  match self.index {
    Some(hi) => hi.get_entry_and_sub(key)
    None => {
      let n = self.entries.length()
      let mut i = 0
      while i < n {
        let (k, _) = self.entries[i]
        if k == key {
          let sub_idx = match self.subs {
            Some(subs) => {
              let mut s = 0
              let sn = subs.length()
              let mut found = -1
              while s < sn {
                if subs[s].entry_idx == i {
                  found = s
                  break
                }
                s = s + 1
              }
              found
            }
            None => -1
          }
          return (i, sub_idx)
        }
        i = i + 1
      }
      (-1, -1)
    }
  }
}

fn ParseTable::ensure_index(self : ParseTable, seed : UInt64) -> HashIndex {
  match self.index {
    Some(hi) => hi
    None => {
      let hi = HashIndex::new(32, seed)
      let n = self.entries.length()
      let mut i = 0
      while i < n {
        let (k, _) = self.entries[i]
        let sub_idx = match self.subs {
          Some(subs) => {
            let mut s = 0
            let sn = subs.length()
            let mut found = -1
            while s < sn {
              if subs[s].entry_idx == i {
                found = s
                break
              }
              s = s + 1
            }
            found
          }
          None => -1
        }
        hi.insert(k, i, sub_idx)
        i = i + 1
      }
      self.index = Some(hi)
      hi
    }
  }
}

fn ParseTable::add_entry(
  self : ParseTable,
  key : String,
  value : TomlValue,
  sub_kind : Option[SubKind],
  seed : UInt64,
) -> Unit {
  let entry_idx = self.entries.length()
  self.entries.push((key, value))
  let sub_idx = match sub_kind {
    Some(sk) => {
      let subs = match self.subs {
        Some(arr) => arr
        None => {
          let arr : Array[SubMeta] = []
          self.subs = Some(arr)
          arr
        }
      }
      let sidx = subs.length()
      subs.push(SubMeta::{ entry_idx: entry_idx, kind: sk })
      sidx
    }
    None => -1
  }
  match self.index {
    Some(hi) => hi.insert(key, entry_idx, sub_idx)
    None => {
      if self.entries.length() > small_table_limit {
        let _ = self.ensure_index(seed)
      }
    }
  }
}

///| Seal an inline table and any unsealed dotted subtables inside it.
///| Skips subtrees already marked `TableKind::Inline` (O(1) amortized).
fn seal_inline_table(tbl : ParseTable) -> Unit {
  match tbl.kind {
    TableKind::Inline => return
    _ => ()
  }
  tbl.kind = TableKind::Inline
  match tbl.subs {
    Some(subs) => {
      let n = subs.length()
      let mut i = 0
      while i < n {
        match subs[i].kind {
          SubKind::Tbl(sub) => seal_inline_table(sub)
          _ => ()
        }
        i = i + 1
      }
    }
    None => ()
  }
}

struct Parser {
  src : String
  len : Int
  seed : UInt64
  mut pos : Int
  mut line : Int
  mut col : Int
  mut depth : Int
}

fn Parser::new(src : String) -> Parser {
  Parser::{
    src: src,
    len: src.length(),
    seed: derive_doc_seed(src),
    pos: 0,
    line: 1,
    col: 1,
    depth: 0,
  }
}

fn Parser::err(self : Parser, msg : String) -> TomlError {
  TomlError::new(self.line, self.col, self.pos, msg)
}

fn Parser::peek(self : Parser) -> Int {
  if self.pos < self.len {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

fn Parser::peek_at(self : Parser, offset : Int) -> Int {
  let idx = self.pos + offset
  if idx >= 0 && idx < self.len {
    self.src.code_unit_at(idx)
  } else {
    -1
  }
}

fn Parser::advance(self : Parser) -> Int {
  if self.pos >= self.len {
    return -1
  }
  let b = self.src.code_unit_at(self.pos)
  self.pos = self.pos + 1
  if b == 10 {
    self.line = self.line + 1
    self.col = 1
  } else if (b & 0xC0) != 0x80 {
    self.col = self.col + 1
  }
  b
}

fn is_bare_key_byte(b : Int) -> Bool {
  (b >= 65 && b <= 90) ||
  (b >= 97 && b <= 122) ||
  (b >= 48 && b <= 57) ||
  b == 95 ||
  b == 45
}

fn is_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn Parser::skip_ws(self : Parser) -> Unit {
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 32 || b == 9 {
      self.pos = self.pos + 1
      self.col = self.col + 1
    } else {
      break
    }
  }
}

fn Parser::skip_comment(self : Parser) -> Result[Unit, TomlError] {
  // Assumes current byte is '#' (35)
  self.pos = self.pos + 1
  self.col = self.col + 1
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 10 {
      break
    }
    if b == 13 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
        break
      }
      return Err(self.err("bare carriage return in comment"))
    }
    if (b >= 0 && b <= 8) || (b >= 11 && b <= 31) || b == 127 {
      return Err(self.err("control character in comment"))
    }
    self.pos = self.pos + 1
    if (b & 0xC0) != 0x80 {
      self.col = self.col + 1
    }
  }
  Ok(())
}

fn Parser::skip_ws_and_newlines(self : Parser) -> Result[Unit, TomlError] {
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 32 || b == 9 {
      self.pos = self.pos + 1
      self.col = self.col + 1
    } else if b == 10 {
      self.pos = self.pos + 1
      self.line = self.line + 1
      self.col = 1
    } else if b == 13 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
        self.pos = self.pos + 2
        self.line = self.line + 1
        self.col = 1
      } else {
        return Err(self.err("bare carriage return"))
      }
    } else if b == 35 {
      match self.skip_comment() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      break
    }
  }
  Ok(())
}

fn Parser::expect_eol_or_eof(self : Parser) -> Result[Unit, TomlError] {
  self.skip_ws()
  if self.pos >= self.len {
    return Ok(())
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 35 {
    match self.skip_comment() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  if self.pos >= self.len {
    return Ok(())
  }
  let b2 = self.src.code_unit_at(self.pos)
  if b2 == 10 {
    self.pos = self.pos + 1
    self.line = self.line + 1
    self.col = 1
    Ok(())
  } else if b2 == 13 {
    if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
      self.pos = self.pos + 2
      self.line = self.line + 1
      self.col = 1
      Ok(())
    } else {
      Err(self.err("bare carriage return"))
    }
  } else {
    Err(self.err("expected newline or end of file"))
  }
}

fn Parser::parse_unicode_escape(self : Parser, digits : Int) -> Result[Int, TomlError] {
  if self.pos + digits > self.len {
    return Err(self.err("incomplete unicode escape"))
  }
  let mut cp : Int64 = 0L
  let mut i = 0
  while i < digits {
    let b = self.src.code_unit_at(self.pos + i)
    let hv = hex_val(b)
    if hv < 0 {
      return Err(self.err("invalid hex digit in unicode escape"))
    }
    cp = (cp << 4L) | hv.to_int64()
    i = i + 1
  }
  self.pos = self.pos + digits
  self.col = self.col + digits
  if cp < 0L || cp > 0x10FFFFL || (cp >= 0xD800L && cp <= 0xDFFFL) {
    return Err(self.err("invalid unicode scalar value in escape"))
  }
  Ok(cp.to_int())
}

fn Parser::parse_escape_seq(self : Parser, sb : StringBuilder) -> Result[Unit, TomlError] {
  if self.pos >= self.len {
    return Err(self.err("unterminated escape sequence"))
  }
  let b = self.advance()
  if b == 98 {
    sb.write_byte((8).to_byte())
  } else if b == 116 {
    sb.write_byte((9).to_byte())
  } else if b == 110 {
    sb.write_byte((10).to_byte())
  } else if b == 102 {
    sb.write_byte((12).to_byte())
  } else if b == 114 {
    sb.write_byte((13).to_byte())
  } else if b == 34 {
    sb.write_byte((34).to_byte())
  } else if b == 92 {
    sb.write_byte((92).to_byte())
  } else if b == 117 {
    match self.parse_unicode_escape(4) {
      Ok(cp) => write_utf8(sb, cp)
      Err(e) => return Err(e)
    }
  } else if b == 85 {
    match self.parse_unicode_escape(8) {
      Ok(cp) => write_utf8(sb, cp)
      Err(e) => return Err(e)
    }
  } else {
    return Err(self.err("invalid escape sequence"))
  }
  Ok(())
}

fn Parser::parse_basic_string(self : Parser) -> Result[String, TomlError] {
  // Opening '"'
  let _ = self.advance()
  let start = self.pos
  // Fast path: scan for closing '"' without escapes
  let mut has_escape = false
  let mut scan = start
  let mut chars = 0
  while scan < self.len {
    let b = self.src.code_unit_at(scan)
    if b == 34 {
      break
    }
    if b == 92 {
      has_escape = true
      break
    }
    if (b >= 0 && b <= 8) || (b >= 10 && b <= 31) || b == 127 {
      self.pos = scan
      self.col = self.col + chars
      return Err(self.err("control character or newline in basic string"))
    }
    if (b & 0xC0) != 0x80 {
      chars = chars + 1
    }
    scan = scan + 1
  }
  if !has_escape {
    if scan >= self.len {
      self.pos = scan
      self.col = self.col + chars
      return Err(self.err("unterminated basic string"))
    }
    let out = self.src.slice(start, scan)
    self.pos = scan + 1
    self.col = self.col + chars + 1
    return Ok(out)
  }
  let sb = StringBuilder::new()
  if scan > start {
    sb.write_string(self.src.slice(start, scan))
    self.col = self.col + chars
    self.pos = scan
  }
  while self.pos < self.len {
    let chunk_start = self.pos
    let mut chunk_chars = 0
    while self.pos < self.len {
      let b = self.src.code_unit_at(self.pos)
      if b == 34 || b == 92 || (b >= 0 && b <= 8) || (b >= 10 && b <= 31) || b == 127 {
        break
      }
      if (b & 0xC0) != 0x80 {
        chunk_chars = chunk_chars + 1
      }
      self.pos = self.pos + 1
    }
    if self.pos > chunk_start {
      sb.write_string(self.src.slice(chunk_start, self.pos))
      self.col = self.col + chunk_chars
    }
    if self.pos >= self.len {
      break
    }
    let b = self.src.code_unit_at(self.pos)
    if b == 34 {
      let _ = self.advance()
      return Ok(sb.to_string())
    }
    if b == 92 {
      let _ = self.advance()
      match self.parse_escape_seq(sb) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      return Err(self.err("control character or newline in basic string"))
    }
  }
  Err(self.err("unterminated basic string"))
}

fn Parser::parse_multiline_basic_string(self : Parser) -> Result[String, TomlError] {
  // Opening '"""'
  let _ = self.advance()
  let _ = self.advance()
  let _ = self.advance()
  // Trim immediate first newline if present
  if self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 10 {
      let _ = self.advance()
    } else if b == 13 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
      let _ = self.advance()
      let _ = self.advance()
    }
  }
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let chunk_start = self.pos
    while self.pos < self.len {
      let b = self.src.code_unit_at(self.pos)
      if b == 34 || b == 92 || b == 13 || (b >= 0 && b <= 8) || b == 11 || b == 12 || (b >= 14 && b <= 31) || b == 127 {
        break
      }
      if b == 10 {
        self.line = self.line + 1
        self.col = 1
      } else if (b & 0xC0) != 0x80 {
        self.col = self.col + 1
      }
      self.pos = self.pos + 1
    }
    if self.pos > chunk_start {
      sb.write_string(self.src.slice(chunk_start, self.pos))
    }
    if self.pos >= self.len {
      break
    }
    let b = self.src.code_unit_at(self.pos)
    if b == 34 {
      let mut qcount = 0
      while self.pos + qcount < self.len && self.src.code_unit_at(self.pos + qcount) == 34 {
        qcount = qcount + 1
      }
      if qcount >= 3 {
        if qcount > 5 {
          return Err(self.err("too many consecutive quotes in multiline basic string"))
        }
        let extra = qcount - 3
        let mut k = 0
        while k < extra {
          sb.write_byte((34).to_byte())
          k = k + 1
        }
        self.pos = self.pos + qcount
        self.col = self.col + qcount
        return Ok(sb.to_string())
      } else {
        let mut k = 0
        while k < qcount {
          sb.write_byte((34).to_byte())
          k = k + 1
        }
        self.pos = self.pos + qcount
        self.col = self.col + qcount
      }
    } else if b == 92 {
      let _ = self.advance()
      // Check for line-ending backslash: optional spaces/tabs then newline
      let save_pos = self.pos
      let save_line = self.line
      let save_col = self.col
      let mut saw_nl = false
      while self.pos < self.len {
        let c = self.src.code_unit_at(self.pos)
        if c == 32 || c == 9 {
          let _ = self.advance()
        } else if c == 10 {
          let _ = self.advance()
          saw_nl = true
          break
        } else if c == 13 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
          let _ = self.advance()
          let _ = self.advance()
          saw_nl = true
          break
        } else {
          break
        }
      }
      if saw_nl {
        // Trim all subsequent whitespace and newlines
        while self.pos < self.len {
          let c = self.src.code_unit_at(self.pos)
          if c == 32 || c == 9 || c == 10 {
            let _ = self.advance()
          } else if c == 13 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
            let _ = self.advance()
            let _ = self.advance()
          } else {
            break
          }
        }
      } else {
        if self.pos != save_pos {
          return Err(self.err("invalid whitespace after backslash in multiline string"))
        }
        self.pos = save_pos
        self.line = save_line
        self.col = save_col
        match self.parse_escape_seq(sb) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
    } else if b == 13 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
        sb.write_byte((10).to_byte())
        let _ = self.advance()
        let _ = self.advance()
      } else {
        return Err(self.err("bare carriage return in multiline basic string"))
      }
    } else {
      return Err(self.err("control character in multiline basic string"))
    }
  }
  Err(self.err("unterminated multiline basic string"))
}

fn Parser::parse_literal_string(self : Parser) -> Result[String, TomlError] {
  // Opening '\''
  let _ = self.advance()
  let start = self.pos
  let mut scan = start
  let mut chars = 0
  while scan < self.len {
    let b = self.src.code_unit_at(scan)
    if b == 39 {
      let out = self.src.slice(start, scan)
      self.pos = scan + 1
      self.col = self.col + chars + 1
      return Ok(out)
    }
    if (b >= 0 && b <= 8) || (b >= 10 && b <= 31) || b == 127 {
      self.pos = scan
      self.col = self.col + chars
      return Err(self.err("control character or newline in literal string"))
    }
    if (b & 0xC0) != 0x80 {
      chars = chars + 1
    }
    scan = scan + 1
  }
  self.pos = scan
  self.col = self.col + chars
  Err(self.err("unterminated literal string"))
}

fn Parser::parse_multiline_literal_string(self : Parser) -> Result[String, TomlError] {
  // Opening "'''"
  let _ = self.advance()
  let _ = self.advance()
  let _ = self.advance()
  // Trim immediate first newline if present
  if self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 10 {
      let _ = self.advance()
    } else if b == 13 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
      let _ = self.advance()
      let _ = self.advance()
    }
  }
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let chunk_start = self.pos
    while self.pos < self.len {
      let b = self.src.code_unit_at(self.pos)
      if b == 39 || b == 13 || (b >= 0 && b <= 8) || b == 11 || b == 12 || (b >= 14 && b <= 31) || b == 127 {
        break
      }
      if b == 10 {
        self.line = self.line + 1
        self.col = 1
      } else if (b & 0xC0) != 0x80 {
        self.col = self.col + 1
      }
      self.pos = self.pos + 1
    }
    if self.pos > chunk_start {
      sb.write_string(self.src.slice(chunk_start, self.pos))
    }
    if self.pos >= self.len {
      break
    }
    let b = self.src.code_unit_at(self.pos)
    if b == 39 {
      let mut qcount = 0
      while self.pos + qcount < self.len && self.src.code_unit_at(self.pos + qcount) == 39 {
        qcount = qcount + 1
      }
      if qcount >= 3 {
        if qcount > 5 {
          return Err(self.err("too many consecutive quotes in multiline literal string"))
        }
        let extra = qcount - 3
        let mut k = 0
        while k < extra {
          sb.write_byte((39).to_byte())
          k = k + 1
        }
        self.pos = self.pos + qcount
        self.col = self.col + qcount
        return Ok(sb.to_string())
      } else {
        let mut k = 0
        while k < qcount {
          sb.write_byte((39).to_byte())
          k = k + 1
        }
        self.pos = self.pos + qcount
        self.col = self.col + qcount
      }
    } else if b == 13 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 10 {
        sb.write_byte((10).to_byte())
        let _ = self.advance()
        let _ = self.advance()
      } else {
        return Err(self.err("bare carriage return in multiline literal string"))
      }
    } else {
      return Err(self.err("control character in multiline literal string"))
    }
  }
  Err(self.err("unterminated multiline literal string"))
}

fn Parser::parse_simple_key(self : Parser) -> Result[String, TomlError] {
  if self.pos >= self.len {
    return Err(self.err("expected key"))
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 34 {
    // Multiline strings are NOT allowed as keys
    if self.peek_at(1) == 34 && self.peek_at(2) == 34 {
      return Err(self.err("multiline basic string not allowed as key"))
    }
    self.parse_basic_string()
  } else if b == 39 {
    if self.peek_at(1) == 39 && self.peek_at(2) == 39 {
      return Err(self.err("multiline literal string not allowed as key"))
    }
    self.parse_literal_string()
  } else if is_bare_key_byte(b) {
    let start = self.pos
    while self.pos < self.len && is_bare_key_byte(self.src.code_unit_at(self.pos)) {
      self.pos = self.pos + 1
      self.col = self.col + 1
    }
    Ok(self.src.slice(start, self.pos))
  } else {
    Err(self.err("invalid key character"))
  }
}

fn Parser::parse_key_path(self : Parser) -> Result[Array[String], TomlError] {
  let keys : Array[String] = []
  self.skip_ws()
  match self.parse_simple_key() {
    Ok(k) => keys.push(k)
    Err(e) => return Err(e)
  }
  while true {
    self.skip_ws()
    if self.peek() == 46 {
      if keys.length() >= max_parse_depth {
        return Err(self.err("recursion limit exceeded in dotted key"))
      }
      let _ = self.advance()
      self.skip_ws()
      match self.parse_simple_key() {
        Ok(k) => keys.push(k)
        Err(e) => return Err(e)
      }
    } else {
      break
    }
  }
  Ok(keys)
}

fn is_value_delim(b : Int) -> Bool {
  b == -1 || b == 32 || b == 9 || b == 10 || b == 13 || b == 35 || b == 44 || b == 93 || b == 125
}

fn is_leap_year_p(y : Int) -> Bool {
  (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)
}

fn days_in_month_p(y : Int, m : Int) -> Int {
  if m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12 {
    31
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else if m == 2 {
    if is_leap_year_p(y) { 29 } else { 28 }
  } else {
    0
  }
}

fn parse_fixed_digits(s : String, pos : Int, count : Int) -> Option[Int] {
  if pos + count > s.length() {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < count {
    let b = s.code_unit_at(pos + i)
    if b < 48 || b > 57 {
      return None
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  Some(acc)
}

fn parse_time_part(s : String, pos : Int, end : Int) -> Option[Int] {
  // HH:MM:SS(.frac)?
  if pos + 8 > end {
    return None
  }
  if s.code_unit_at(pos + 2) != 58 || s.code_unit_at(pos + 5) != 58 {
    return None
  }
  let hh = match parse_fixed_digits(s, pos, 2) {
    Some(v) => v
    None => return None
  }
  let mm = match parse_fixed_digits(s, pos + 3, 2) {
    Some(v) => v
    None => return None
  }
  let ss = match parse_fixed_digits(s, pos + 6, 2) {
    Some(v) => v
    None => return None
  }
  if hh > 23 || mm > 59 || ss > 59 {
    return None
  }
  let mut p = pos + 8
  if p < end && s.code_unit_at(p) == 46 {
    p = p + 1
    let fstart = p
    while p < end && is_digit(s.code_unit_at(p)) {
      p = p + 1
    }
    if p == fstart {
      return None
    }
  }
  Some(p)
}

fn normalize_datetime(s : String, start : Int, end : Int, sep : Int, lower_z : Bool) -> String {
  if sep == 84 && !lower_z {
    return s.slice(start, end)
  }
  let sb = StringBuilder::new()
  sb.write_string(s.slice(start, start + 10))
  sb.write_byte((84).to_byte())
  if lower_z {
    sb.write_string(s.slice(start + 11, end - 1))
    sb.write_byte((90).to_byte())
  } else {
    sb.write_string(s.slice(start + 11, end))
  }
  sb.to_string()
}

fn Parser::try_parse_datetime_or_time(self : Parser) -> Option[Result[TomlValue, TomlError]] {
  let start = self.pos
  let s = self.src
  let n = self.len
  // Check local time: DD:DD:DD...
  if start + 2 < n &&
  is_digit(s.code_unit_at(start)) &&
  is_digit(s.code_unit_at(start + 1)) &&
  s.code_unit_at(start + 2) == 58 {
    let mut end = start
    while end < n && !is_value_delim(s.code_unit_at(end)) {
      end = end + 1
    }
    match parse_time_part(s, start, end) {
      Some(p) => {
        if p == end {
          let raw = s.slice(start, end)
          self.col = self.col + (end - start)
          self.pos = end
          return Some(Ok(TomlValue::LocalTime(raw)))
        }
        return Some(Err(self.err("invalid local time")))
      }
      None => return Some(Err(self.err("invalid local time")))
    }
  }
  // Check date: DDDD-DD-DD...
  if start + 4 < n &&
  is_digit(s.code_unit_at(start)) &&
  is_digit(s.code_unit_at(start + 1)) &&
  is_digit(s.code_unit_at(start + 2)) &&
  is_digit(s.code_unit_at(start + 3)) &&
  s.code_unit_at(start + 4) == 45 {
    if start + 10 > n || s.code_unit_at(start + 7) != 45 {
      return Some(Err(self.err("invalid date format")))
    }
    let y = match parse_fixed_digits(s, start, 4) {
      Some(v) => v
      None => return Some(Err(self.err("invalid year")))
    }
    let mo = match parse_fixed_digits(s, start + 5, 2) {
      Some(v) => v
      None => return Some(Err(self.err("invalid month")))
    }
    let d = match parse_fixed_digits(s, start + 8, 2) {
      Some(v) => v
      None => return Some(Err(self.err("invalid day")))
    }
    if mo < 1 || mo > 12 {
      return Some(Err(self.err("month out of range")))
    }
    let dim = days_in_month_p(y, mo)
    if d < 1 || d > dim {
      return Some(Err(self.err("day out of range")))
    }
    let mut p = start + 10
    if p >= n || is_value_delim(s.code_unit_at(p)) {
      let has_space_time = p + 3 < n &&
      s.code_unit_at(p) == 32 &&
      is_digit(s.code_unit_at(p + 1)) &&
      is_digit(s.code_unit_at(p + 2)) &&
      s.code_unit_at(p + 3) == 58
      if !has_space_time {
        let raw = s.slice(start, p)
        self.col = self.col + (p - start)
        self.pos = p
        return Some(Ok(TomlValue::LocalDate(raw)))
      }
    }
    let sep = s.code_unit_at(p)
    if sep != 84 && sep != 116 && sep != 32 {
      return Some(Err(self.err("invalid date-time separator")))
    }
    p = p + 1
    let mut end = p
    while end < n && !is_value_delim(s.code_unit_at(end)) {
      end = end + 1
    }
    let after_time = match parse_time_part(s, p, end) {
      Some(pos2) => pos2
      None => return Some(Err(self.err("invalid time in date-time")))
    }
    if after_time == end {
      let norm = normalize_datetime(s, start, end, sep, false)
      self.col = self.col + (end - start)
      self.pos = end
      return Some(Ok(TomlValue::LocalDateTime(norm)))
    }
    let ob = s.code_unit_at(after_time)
    if ob == 90 || ob == 122 {
      if after_time + 1 != end {
        return Some(Err(self.err("trailing characters after Z offset")))
      }
      let norm = normalize_datetime(s, start, end, sep, ob == 122)
      self.col = self.col + (end - start)
      self.pos = end
      return Some(Ok(TomlValue::OffsetDateTime(norm)))
    } else if ob == 43 || ob == 45 {
      if after_time + 6 != end || s.code_unit_at(after_time + 3) != 58 {
        return Some(Err(self.err("invalid timezone offset")))
      }
      let oh = match parse_fixed_digits(s, after_time + 1, 2) {
        Some(v) => v
        None => return Some(Err(self.err("invalid offset hour")))
      }
      let om = match parse_fixed_digits(s, after_time + 4, 2) {
        Some(v) => v
        None => return Some(Err(self.err("invalid offset minute")))
      }
      if oh > 23 || om > 59 {
        return Some(Err(self.err("timezone offset out of range")))
      }
      let norm = normalize_datetime(s, start, end, sep, false)
      self.col = self.col + (end - start)
      self.pos = end
      return Some(Ok(TomlValue::OffsetDateTime(norm)))
    } else {
      return Some(Err(self.err("invalid timezone offset")))
    }
  }
  None
}

fn parse_radix_int(token : String, start : Int, radix : Int64) -> Option[Int64] {
  let n = token.length()
  if start >= n {
    return None
  }
  let i64_max : Int64 = 9223372036854775807L
  let mut acc : Int64 = 0L
  let mut i = start
  let mut prev_us = false
  let mut digits = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 95 {
      if digits == 0 || prev_us || i + 1 >= n {
        return None
      }
      prev_us = true
      i = i + 1
    } else {
      let d = if radix == 16L {
        hex_val(b)
      } else if radix == 8L {
        if b >= 48 && b <= 55 { b - 48 } else { -1 }
      } else {
        if b == 48 || b == 49 { b - 48 } else { -1 }
      }
      if d < 0 {
        return None
      }
      let dl = d.to_int64()
      if acc > (i64_max - dl) / radix {
        return None
      }
      acc = acc * radix + dl
      digits = digits + 1
      prev_us = false
      i = i + 1
    }
  }
  if digits == 0 || prev_us {
    return None
  }
  Some(acc)
}

fn parse_decimal_int(token : String) -> Option[Int64] {
  let n = token.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  let b0 = token.code_unit_at(0)
  if b0 == 43 {
    i = 1
  } else if b0 == 45 {
    neg = true
    i = 1
  }
  if i >= n {
    return None
  }
  let first = token.code_unit_at(i)
  if !is_digit(first) {
    return None
  }
  if first == 48 && i + 1 < n {
    return None
  }
  let i64_min : Int64 = -9223372036854775807L - 1L
  let mut acc : Int64 = 0L
  let mut prev_us = false
  let mut digits = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 95 {
      if digits == 0 || prev_us || i + 1 >= n {
        return None
      }
      prev_us = true
      i = i + 1
    } else if is_digit(b) {
      let dl = (b - 48).to_int64()
      if acc < (i64_min + dl) / 10L {
        return None
      }
      acc = acc * 10L - dl
      digits = digits + 1
      prev_us = false
      i = i + 1
    } else {
      return None
    }
  }
  if digits == 0 || prev_us {
    return None
  }
  if neg {
    Some(acc)
  } else {
    if acc == i64_min {
      return None
    }
    Some(-acc)
  }
}

fn parse_toml_float(token : String) -> Option[Double] {
  let n = token.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let b0 = token.code_unit_at(0)
  if b0 == 43 || b0 == 45 {
    i = 1
  }
  if i >= n || !is_digit(token.code_unit_at(i)) {
    return None
  }
  let int_first = token.code_unit_at(i)
  let mut int_digits = 0
  let mut prev_us = false
  let mut has_us = false
  while i < n {
    let b = token.code_unit_at(i)
    if is_digit(b) {
      int_digits = int_digits + 1
      prev_us = false
      i = i + 1
    } else if b == 95 {
      if int_digits == 0 || prev_us {
        return None
      }
      has_us = true
      prev_us = true
      i = i + 1
    } else {
      break
    }
  }
  if prev_us || (int_first == 48 && int_digits > 1) {
    return None
  }
  let mut has_frac = false
  let mut has_exp = false
  if i < n && token.code_unit_at(i) == 46 {
    has_frac = true
    i = i + 1
    let mut frac_digits = 0
    prev_us = false
    while i < n {
      let b = token.code_unit_at(i)
      if is_digit(b) {
        frac_digits = frac_digits + 1
        prev_us = false
        i = i + 1
      } else if b == 95 {
        if frac_digits == 0 || prev_us {
          return None
        }
        has_us = true
        prev_us = true
        i = i + 1
      } else {
        break
      }
    }
    if frac_digits == 0 || prev_us {
      return None
    }
  }
  if i < n && (token.code_unit_at(i) == 101 || token.code_unit_at(i) == 69) {
    has_exp = true
    i = i + 1
    if i < n && (token.code_unit_at(i) == 43 || token.code_unit_at(i) == 45) {
      i = i + 1
    }
    let mut exp_digits = 0
    prev_us = false
    while i < n {
      let b = token.code_unit_at(i)
      if is_digit(b) {
        exp_digits = exp_digits + 1
        prev_us = false
        i = i + 1
      } else if b == 95 {
        if exp_digits == 0 || prev_us {
          return None
        }
        has_us = true
        prev_us = true
        i = i + 1
      } else {
        break
      }
    }
    if exp_digits == 0 || prev_us {
      return None
    }
  }
  if i != n || (!has_frac && !has_exp) {
    return None
  }
  let parsed = if !has_us {
    token.to_double()
  } else {
    let sb = StringBuilder::new()
    let mut j = 0
    while j < n {
      let b = token.code_unit_at(j)
      if b != 95 {
        sb.write_byte(b.to_byte())
      }
      j = j + 1
    }
    sb.to_string().to_double()
  }
  match parsed {
    Some(f) => {
      // Reject overflow to ±inf (F2: aligns with Rust toml 1.2 / 0.8 and Go BurntSushi)
      let bits = f.reinterpret_as_uint64()
      let exp = (bits >> 52UL) & 0x7FFUL
      if exp == 0x7FFUL {
        None
      } else {
        Some(f)
      }
    }
    None => None
  }
}

fn Parser::parse_scalar_token(self : Parser) -> Result[TomlValue, TomlError] {
  match self.try_parse_datetime_or_time() {
    Some(res) => return res
    None => ()
  }
  let start = self.pos
  let start_line = self.line
  let start_col = self.col
  while self.pos < self.len && !is_value_delim(self.src.code_unit_at(self.pos)) {
    let b = self.src.code_unit_at(self.pos)
    self.pos = self.pos + 1
    if (b & 0xC0) != 0x80 {
      self.col = self.col + 1
    }
  }
  let tok = self.src.slice(start, self.pos)
  if tok.length() == 0 {
    return Err(TomlError::new(start_line, start_col, start, "expected value"))
  }
  if tok == "true" {
    return Ok(TomlValue::Bool(true))
  }
  if tok == "false" {
    return Ok(TomlValue::Bool(false))
  }
  if tok == "inf" || tok == "+inf" {
    return Ok(TomlValue::Float(1.0 / 0.0))
  }
  if tok == "-inf" {
    return Ok(TomlValue::Float(-1.0 / 0.0))
  }
  if tok == "nan" || tok == "+nan" || tok == "-nan" {
    return Ok(TomlValue::Float(0.0 / 0.0))
  }
  if tok.length() >= 2 && tok.code_unit_at(0) == 48 {
    let b1 = tok.code_unit_at(1)
    if b1 == 120 {
      match parse_radix_int(tok, 2, 16L) {
        Some(v) => return Ok(TomlValue::Int(v))
        None => return Err(TomlError::new(start_line, start_col, start, "invalid hex integer"))
      }
    } else if b1 == 111 {
      match parse_radix_int(tok, 2, 8L) {
        Some(v) => return Ok(TomlValue::Int(v))
        None => return Err(TomlError::new(start_line, start_col, start, "invalid octal integer"))
      }
    } else if b1 == 98 {
      match parse_radix_int(tok, 2, 2L) {
        Some(v) => return Ok(TomlValue::Int(v))
        None => return Err(TomlError::new(start_line, start_col, start, "invalid binary integer"))
      }
    }
  }
  let mut has_float_char = false
  let mut j = 0
  while j < tok.length() {
    let b = tok.code_unit_at(j)
    if b == 46 || b == 101 || b == 69 {
      has_float_char = true
      break
    }
    j = j + 1
  }
  if has_float_char {
    match parse_toml_float(tok) {
      Some(f) => return Ok(TomlValue::Float(f))
      None => return Err(TomlError::new(start_line, start_col, start, "invalid float literal"))
    }
  }
  match parse_decimal_int(tok) {
    Some(v) => Ok(TomlValue::Int(v))
    None => Err(TomlError::new(start_line, start_col, start, "invalid value literal"))
  }
}

fn Parser::parse_value(self : Parser) -> Result[TomlValue, TomlError] {
  self.skip_ws()
  if self.pos >= self.len {
    return Err(self.err("expected value"))
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 34 {
    if self.peek_at(1) == 34 && self.peek_at(2) == 34 {
      match self.parse_multiline_basic_string() {
        Ok(s) => Ok(TomlValue::Str(s))
        Err(e) => Err(e)
      }
    } else {
      match self.parse_basic_string() {
        Ok(s) => Ok(TomlValue::Str(s))
        Err(e) => Err(e)
      }
    }
  } else if b == 39 {
    if self.peek_at(1) == 39 && self.peek_at(2) == 39 {
      match self.parse_multiline_literal_string() {
        Ok(s) => Ok(TomlValue::Str(s))
        Err(e) => Err(e)
      }
    } else {
      match self.parse_literal_string() {
        Ok(s) => Ok(TomlValue::Str(s))
        Err(e) => Err(e)
      }
    }
  } else if b == 91 {
    self.parse_array()
  } else if b == 123 {
    self.parse_inline_table()
  } else {
    self.parse_scalar_token()
  }
}

fn Parser::parse_array(self : Parser) -> Result[TomlValue, TomlError] {
  if self.depth >= max_parse_depth {
    return Err(self.err("recursion limit exceeded in array"))
  }
  self.depth = self.depth + 1
  // Opening '['
  let _ = self.advance()
  let items : Array[TomlValue] = []
  let eof_l0 = self.line
  let eof_c0 = self.col
  let eof_p0 = self.pos
  match self.skip_ws_and_newlines() {
    Ok(_) => ()
    Err(e) => {
      self.depth = self.depth - 1
      return Err(e)
    }
  }
  if self.pos >= self.len {
    self.depth = self.depth - 1
    return Err(TomlError::new(eof_l0, eof_c0, eof_p0, "unterminated array"))
  }
  if self.peek() == 93 {
    let _ = self.advance()
    self.depth = self.depth - 1
    return Ok(TomlValue::Array(items))
  }
  while true {
    let el1 = self.line
    let ec1 = self.col
    let ep1 = self.pos
    match self.skip_ws_and_newlines() {
      Ok(_) => ()
      Err(e) => {
        self.depth = self.depth - 1
        return Err(e)
      }
    }
    if self.pos >= self.len {
      self.depth = self.depth - 1
      return Err(TomlError::new(el1, ec1, ep1, "unterminated array"))
    }
    if self.peek() == 93 {
      let _ = self.advance()
      self.depth = self.depth - 1
      return Ok(TomlValue::Array(items))
    }
    let v = match self.parse_value() {
      Ok(val_item) => val_item
      Err(e) => {
        self.depth = self.depth - 1
        return Err(e)
      }
    }
    items.push(v)
    let el2 = self.line
    let ec2 = self.col
    let ep2 = self.pos
    match self.skip_ws_and_newlines() {
      Ok(_) => ()
      Err(e) => {
        self.depth = self.depth - 1
        return Err(e)
      }
    }
    if self.pos >= self.len {
      self.depth = self.depth - 1
      return Err(TomlError::new(el2, ec2, ep2, "unterminated array"))
    }
    let next = self.peek()
    if next == 44 {
      let _ = self.advance()
      let el3 = self.line
      let ec3 = self.col
      let ep3 = self.pos
      match self.skip_ws_and_newlines() {
        Ok(_) => ()
        Err(e) => {
          self.depth = self.depth - 1
          return Err(e)
        }
      }
      if self.pos >= self.len {
        self.depth = self.depth - 1
        return Err(TomlError::new(el3, ec3, ep3, "unterminated array"))
      }
      if self.peek() == 93 {
        let _ = self.advance()
        self.depth = self.depth - 1
        return Ok(TomlValue::Array(items))
      }
    } else if next == 93 {
      let _ = self.advance()
      self.depth = self.depth - 1
      return Ok(TomlValue::Array(items))
    } else {
      self.depth = self.depth - 1
      return Err(self.err("expected ',' or ']' in array"))
    }
  }
  self.depth = self.depth - 1
  Err(self.err("unterminated array"))
}

fn insert_key_value(
  self : Parser,
  tbl : ParseTable,
  keys : Array[String],
  value : TomlValue,
  val_sub : Option[SubKind],
  err_line : Int,
  err_col : Int,
  err_pos : Int,
) -> Result[Unit, TomlError] {
  let n = keys.length()
  if tbl.depth + n > max_parse_depth {
    return Err(TomlError::new(err_line, err_col, err_pos, "recursion limit exceeded"))
  }
  let mut cur = tbl
  let mut i = 0
  while i < n - 1 {
    let k = keys[i]
    let (eidx, sidx) = cur.find(k)
    if eidx >= 0 {
      if sidx >= 0 {
        match cur.subs {
          Some(subs) =>
          match subs[sidx].kind {
            SubKind::Tbl(sub) => {
              match sub.kind {
                TableKind::Dotted => cur = sub
                TableKind::Super => {
                  sub.kind = TableKind::Dotted
                  cur = sub
                }
                _ => return Err(TomlError::new(err_line, err_col, err_pos, "cannot extend table via dotted key"))
              }
            }
            _ => return Err(TomlError::new(err_line, err_col, err_pos, "key is not a table"))
          }
          None => return Err(TomlError::new(err_line, err_col, err_pos, "key is not a table"))
        }
      } else {
        return Err(TomlError::new(err_line, err_col, err_pos, "key is not a table"))
      }
    } else {
      let sub = ParseTable::new(TableKind::Dotted, cur.depth + 1)
      cur.add_entry(k, TomlValue::Table(sub.entries), Some(SubKind::Tbl(sub)), self.seed)
      cur = sub
    }
    i = i + 1
  }
  let leaf = keys[n - 1]
  let (existing, _) = cur.find(leaf)
  if existing >= 0 {
    return Err(TomlError::new(err_line, err_col, err_pos, "duplicate key"))
  }
  cur.add_entry(leaf, value, val_sub, self.seed)
  Ok(())
}

fn Parser::parse_inline_table_meta(self : Parser) -> Result[ParseTable, TomlError] {
  if self.depth >= max_parse_depth {
    return Err(self.err("recursion limit exceeded in inline table"))
  }
  self.depth = self.depth + 1
  // Opening '{'
  let _ = self.advance()
  let tbl = ParseTable::new(TableKind::Dotted, self.depth)
  self.skip_ws()
  if self.peek() == 125 {
    let _ = self.advance()
    seal_inline_table(tbl)
    self.depth = self.depth - 1
    return Ok(tbl)
  }
  while true {
    self.skip_ws()
    let kl = self.line
    let kc = self.col
    let kp = self.pos
    let keys = match self.parse_key_path() {
      Ok(ks) => ks
      Err(e) => {
        self.depth = self.depth - 1
        return Err(e)
      }
    }
    self.skip_ws()
    if self.peek() != 61 {
      self.depth = self.depth - 1
      return Err(self.err("expected '=' in inline table"))
    }
    let _ = self.advance()
    self.skip_ws()
    let (v, vsub) = if self.peek() == 123 {
      match self.parse_inline_table_meta() {
        Ok(sub_tbl) => (TomlValue::Table(sub_tbl.entries), Some(SubKind::Tbl(sub_tbl)))
        Err(e) => {
          self.depth = self.depth - 1
          return Err(e)
        }
      }
    } else {
      match self.parse_value() {
        Ok(val_item) => (val_item, None)
        Err(e) => {
          self.depth = self.depth - 1
          return Err(e)
        }
      }
    }
    match insert_key_value(self, tbl, keys, v, vsub, kl, kc, kp) {
      Ok(_) => ()
      Err(e) => {
        self.depth = self.depth - 1
        return Err(e)
      }
    }
    self.skip_ws()
    let next = self.peek()
    if next == 44 {
      let _ = self.advance()
      self.skip_ws()
      if self.peek() == 125 {
        self.depth = self.depth - 1
        return Err(self.err("trailing comma not allowed in inline table"))
      }
    } else if next == 125 {
      let _ = self.advance()
      seal_inline_table(tbl)
      self.depth = self.depth - 1
      return Ok(tbl)
    } else {
      self.depth = self.depth - 1
      return Err(self.err("expected ',' or '}' in inline table"))
    }
  }
  self.depth = self.depth - 1
  Err(self.err("unterminated inline table"))
}

fn Parser::parse_inline_table(self : Parser) -> Result[TomlValue, TomlError] {
  match self.parse_inline_table_meta() {
    Ok(tbl) => Ok(TomlValue::Table(tbl.entries))
    Err(e) => Err(e)
  }
}

fn resolve_table_header(
  self : Parser,
  root : ParseTable,
  keys : Array[String],
  is_array : Bool,
  hdr_line : Int,
  hdr_col : Int,
  hdr_pos : Int,
) -> Result[ParseTable, TomlError] {
  let n = keys.length()
  if n > max_parse_depth {
    return Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "recursion limit exceeded in table header"))
  }
  let mut cur = root
  let mut i = 0
  while i < n - 1 {
    let k = keys[i]
    let (eidx, sidx) = cur.find(k)
    if eidx >= 0 {
      if sidx >= 0 {
        match cur.subs {
          Some(subs) =>
          match subs[sidx].kind {
            SubKind::Tbl(sub) => {
              match sub.kind {
                TableKind::Inline =>
                return Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "cannot extend inline table"))
                _ => cur = sub
              }
            }
            SubKind::AoT(_, last_tbl) => {
              cur = last_tbl
            }
          }
          None => return Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "key is not a table"))
        }
      } else {
        return Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "key is not a table"))
      }
    } else {
      let sub = ParseTable::new(TableKind::Super, cur.depth + 1)
      cur.add_entry(k, TomlValue::Table(sub.entries), Some(SubKind::Tbl(sub)), self.seed)
      cur = sub
    }
    i = i + 1
  }
  let leaf = keys[n - 1]
  let (eidx, sidx) = cur.find(leaf)
  if is_array {
    if eidx >= 0 {
      if sidx >= 0 {
        match cur.subs {
          Some(subs) =>
          match subs[sidx].kind {
            SubKind::AoT(arr, _) => {
              let next_tbl = ParseTable::new(TableKind::Standard, cur.depth + 1)
              arr.push(TomlValue::Table(next_tbl.entries))
              subs[sidx].kind = SubKind::AoT(arr, next_tbl)
              Ok(next_tbl)
            }
            _ => Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "cannot redefine key as array of tables"))
          }
          None => Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "cannot redefine key as array of tables"))
        }
      } else {
        Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "cannot redefine key as array of tables"))
      }
    } else {
      let first = ParseTable::new(TableKind::Standard, cur.depth + 1)
      let arr : Array[TomlValue] = [TomlValue::Table(first.entries)]
      cur.add_entry(leaf, TomlValue::Array(arr), Some(SubKind::AoT(arr, first)), self.seed)
      Ok(first)
    }
  } else {
    if eidx >= 0 {
      if sidx >= 0 {
        match cur.subs {
          Some(subs) =>
          match subs[sidx].kind {
            SubKind::Tbl(sub) => {
              match sub.kind {
                TableKind::Super => {
                  sub.kind = TableKind::Standard
                  Ok(sub)
                }
                _ => Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "duplicate table definition"))
              }
            }
            _ => Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "cannot redefine key as table"))
          }
          None => Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "cannot redefine key as table"))
        }
      } else {
        Err(TomlError::new(hdr_line, hdr_col, hdr_pos, "cannot redefine key as table"))
      }
    } else {
      let sub = ParseTable::new(TableKind::Standard, cur.depth + 1)
      cur.add_entry(leaf, TomlValue::Table(sub.entries), Some(SubKind::Tbl(sub)), self.seed)
      Ok(sub)
    }
  }
}

fn parse_validated(src : String) -> Result[TomlValue, TomlError] {
  let p = Parser::new(src)
  // Accept and skip a single leading UTF-8 BOM (EF BB BF) (F4: aligns with Rust & Go)
  if p.len >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    p.pos = 3
    p.col = 1
  }
  let root = ParseTable::new(TableKind::Root, 0)
  let mut current = root
  while true {
    match p.skip_ws_and_newlines() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if p.pos >= p.len {
      break
    }
    let b = p.peek()
    if b == 91 {
      // Table header [a.b] or Array of tables [[a.b]]
      let _ = p.advance()
      let is_array = if p.peek() == 91 {
        let _ = p.advance()
        true
      } else {
        false
      }
      p.skip_ws()
      let hdr_line = p.line
      let hdr_col = p.col
      let hdr_pos = p.pos
      let keys = match p.parse_key_path() {
        Ok(ks) => ks
        Err(e) => return Err(e)
      }
      p.skip_ws()
      if p.peek() != 93 {
        return Err(p.err("expected ']' to close table header"))
      }
      let _ = p.advance()
      if is_array {
        if p.peek() != 93 {
          return Err(p.err("expected ']]' to close array-of-tables header"))
        }
        let _ = p.advance()
      }
      match p.expect_eol_or_eof() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match resolve_table_header(p, root, keys, is_array, hdr_line, hdr_col, hdr_pos) {
        Ok(next_tbl) => current = next_tbl
        Err(e) => return Err(e)
      }
    } else {
      // Key-value pair
      let kl = p.line
      let kc = p.col
      let kp = p.pos
      let keys = match p.parse_key_path() {
        Ok(ks) => ks
        Err(e) => return Err(e)
      }
      p.skip_ws()
      if p.peek() != 61 {
        return Err(p.err("expected '=' after key"))
      }
      let _ = p.advance()
      p.skip_ws()
      let (v, vsub) = if p.peek() == 123 {
        match p.parse_inline_table_meta() {
          Ok(sub_tbl) => (TomlValue::Table(sub_tbl.entries), Some(SubKind::Tbl(sub_tbl)))
          Err(e) => return Err(e)
        }
      } else {
        match p.parse_value() {
          Ok(val_item) => (val_item, None)
          Err(e) => return Err(e)
        }
      }
      match insert_key_value(p, current, keys, v, vsub, kl, kc, kp) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match p.expect_eol_or_eof() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
  }
  Ok(TomlValue::Table(root.entries))
}
