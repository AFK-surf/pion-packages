///| TOML v1.0.0 serializer (`stringify`) and `toml-test` tagged JSON encoder.

fn hex_nibble_upper(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (55 + n).to_byte()
  }
}

fn hex_nibble_lower(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (87 + n).to_byte()
  }
}

fn format_17_digits(neg : Bool, mantissa : Int64, exp10 : Int) -> String {
  let digits = mantissa.to_string()
  let mut end = digits.length()
  while end > 1 && digits.code_unit_at(end - 1) == 48 {
    end = end - 1
  }
  let trimmed = digits.slice(0, end)
  let sb = StringBuilder::new()
  if neg {
    sb.write_byte((45).to_byte())
  }
  let n = trimmed.length()
  let dot_pos = exp10 + 1
  if exp10 >= -4 && exp10 < 16 {
    if dot_pos <= 0 {
      sb.write_string("0.")
      let mut z = 0
      while z < -dot_pos {
        sb.write_byte((48).to_byte())
        z = z + 1
      }
      sb.write_string(trimmed)
    } else if dot_pos >= n {
      sb.write_string(trimmed)
      let mut z = 0
      while z < dot_pos - n {
        sb.write_byte((48).to_byte())
        z = z + 1
      }
    } else {
      sb.write_string(trimmed.slice(0, dot_pos))
      sb.write_byte((46).to_byte())
      sb.write_string(trimmed.slice(dot_pos, n))
    }
  } else {
    sb.write_byte(trimmed.code_unit_at(0).to_byte())
    if n > 1 {
      sb.write_byte((46).to_byte())
      sb.write_string(trimmed.slice(1, n))
    }
    sb.write_byte((101).to_byte())
    if exp10 >= 0 {
      sb.write_byte((43).to_byte())
    }
    sb.write_string(exp10.to_string())
  }
  sb.to_string()
}

fn format_exact_finite_float(v : Double) -> String {
  let fast = v.to_string()
  match fast.to_double() {
    Some(parsed) => {
      if parsed == v {
        return fast
      }
    }
    None => ()
  }
  let neg = v < 0.0
  let x = if neg { -v } else { v }
  // Exact integer fast path up to 2^53
  if x >= 1.0 && x <= 9007199254740992.0 {
    let ip = x.to_int64()
    if ip.to_double() == x {
      return if neg { "-" + ip.to_string() } else { ip.to_string() }
    }
  }
  // Scale x into [1.0, 10.0) to find base-10 exponent
  let mut scaled = x
  let mut exp10 = 0
  while scaled >= 1.0e16 {
    scaled = scaled * 1.0e-16
    exp10 = exp10 + 16
  }
  while scaled < 1.0e-16 {
    scaled = scaled * 1.0e16
    exp10 = exp10 - 16
  }
  while scaled >= 10.0 {
    scaled = scaled / 10.0
    exp10 = exp10 + 1
  }
  while scaled < 1.0 {
    scaled = scaled * 10.0
    exp10 = exp10 - 1
  }
  // Extract 17 significant digits and verify bit-exact roundtrip via strtod
  let mut mant = (scaled * 1.0e16 + 0.5).to_int64()
  if mant >= 100000000000000000L {
    mant = mant / 10L
    exp10 = exp10 + 1
  }
  let c0 = format_17_digits(neg, mant, exp10)
  match c0.to_double() {
    Some(p0) => {
      if p0 == v {
        return c0
      }
    }
    None => ()
  }
  let c_minus = format_17_digits(neg, mant - 1L, exp10)
  match c_minus.to_double() {
    Some(pm) => {
      if pm == v {
        return c_minus
      }
    }
    None => ()
  }
  let c_plus = format_17_digits(neg, mant + 1L, exp10)
  match c_plus.to_double() {
    Some(pp) => {
      if pp == v {
        return c_plus
      }
    }
    None => ()
  }
  c0
}

fn format_float_str(v : Double, for_toml : Bool) -> String {
  if v != v {
    return "nan"
  }
  let pos_inf = 1.0 / 0.0
  let neg_inf = -1.0 / 0.0
  if v == pos_inf {
    return "inf"
  }
  if v == neg_inf {
    return "-inf"
  }
  if v == 0.0 {
    if 1.0 / v < 0.0 {
      return "-0.0"
    }
    return "0.0"
  }
  let s = format_exact_finite_float(v)
  if !for_toml {
    return s
  }
  let n = s.length()
  let mut i = 0
  let mut has_dot_or_exp = false
  while i < n {
    let b = s.code_unit_at(i)
    if b == 46 || b == 101 || b == 69 {
      has_dot_or_exp = true
      break
    }
    i = i + 1
  }
  if has_dot_or_exp {
    s
  } else {
    s + ".0"
  }
}

fn write_json_escaped(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 8 {
      sb.write_string("\\b")
    } else if b == 12 {
      sb.write_string("\\f")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b < 0x20 || b == 0x7F {
      sb.write_string("\\u00")
      sb.write_byte(hex_nibble_lower((b >> 4) & 0xF))
      sb.write_byte(hex_nibble_lower(b & 0xF))
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

fn write_tagged_json(sb : StringBuilder, value : TomlValue) -> Unit {
  match value {
    TomlValue::Str(s) => {
      sb.write_string("{\"type\":\"string\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::Int(v) => {
      sb.write_string("{\"type\":\"integer\",\"value\":\"")
      sb.write_string(v.to_string())
      sb.write_string("\"}")
    }
    TomlValue::Float(v) => {
      sb.write_string("{\"type\":\"float\",\"value\":\"")
      sb.write_string(format_float_str(v, false))
      sb.write_string("\"}")
    }
    TomlValue::Bool(b) => {
      if b {
        sb.write_string("{\"type\":\"bool\",\"value\":\"true\"}")
      } else {
        sb.write_string("{\"type\":\"bool\",\"value\":\"false\"}")
      }
    }
    TomlValue::OffsetDateTime(s) => {
      sb.write_string("{\"type\":\"datetime\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::LocalDateTime(s) => {
      sb.write_string("{\"type\":\"datetime-local\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::LocalDate(s) => {
      sb.write_string("{\"type\":\"date-local\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::LocalTime(s) => {
      sb.write_string("{\"type\":\"time-local\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::Array(items) => {
      sb.write_byte((91).to_byte())
      let n = items.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        write_tagged_json(sb, items[i])
        i = i + 1
      }
      sb.write_byte((93).to_byte())
    }
    TomlValue::Table(entries) => {
      sb.write_byte((123).to_byte())
      let n = entries.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        let (k, v) = entries[i]
        write_json_escaped(sb, k)
        sb.write_byte((58).to_byte())
        write_tagged_json(sb, v)
        i = i + 1
      }
      sb.write_byte((125).to_byte())
    }
  }
}

fn is_bare_key_str(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    let ok = (b >= 65 && b <= 90) ||
    (b >= 97 && b <= 122) ||
    (b >= 48 && b <= 57) ||
    b == 95 ||
    b == 45
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

fn write_toml_basic_str(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 8 {
      sb.write_string("\\b")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 12 {
      sb.write_string("\\f")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b < 0x20 || b == 0x7F {
      sb.write_string("\\u00")
      sb.write_byte(hex_nibble_upper((b >> 4) & 0xF))
      sb.write_byte(hex_nibble_upper(b & 0xF))
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

fn write_toml_key(sb : StringBuilder, k : String) -> Unit {
  if is_bare_key_str(k) {
    sb.write_string(k)
  } else {
    write_toml_basic_str(sb, k)
  }
}

fn write_toml_path(sb : StringBuilder, path : Array[String]) -> Unit {
  let n = path.length()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_byte((46).to_byte())
    }
    write_toml_key(sb, path[i])
    i = i + 1
  }
}

fn is_array_of_tables(items : Array[TomlValue]) -> Bool {
  let n = items.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    match items[i] {
      TomlValue::Table(_) => ()
      _ => return false
    }
    i = i + 1
  }
  true
}

fn write_toml_inline_value(sb : StringBuilder, value : TomlValue) -> Unit {
  match value {
    TomlValue::Str(s) => write_toml_basic_str(sb, s)
    TomlValue::Int(v) => sb.write_string(v.to_string())
    TomlValue::Float(v) => sb.write_string(format_float_str(v, true))
    TomlValue::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    TomlValue::OffsetDateTime(s) => sb.write_string(s)
    TomlValue::LocalDateTime(s) => sb.write_string(s)
    TomlValue::LocalDate(s) => sb.write_string(s)
    TomlValue::LocalTime(s) => sb.write_string(s)
    TomlValue::Array(items) => {
      sb.write_byte((91).to_byte())
      let n = items.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_string(", ")
        }
        write_toml_inline_value(sb, items[i])
        i = i + 1
      }
      sb.write_byte((93).to_byte())
    }
    TomlValue::Table(entries) => {
      sb.write_byte((123).to_byte())
      let n = entries.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_string(", ")
        }
        let (k, v) = entries[i]
        write_toml_key(sb, k)
        sb.write_string(" = ")
        write_toml_inline_value(sb, v)
        i = i + 1
      }
      sb.write_byte((125).to_byte())
    }
  }
}

fn has_direct_values(entries : Array[(String, TomlValue)]) -> Bool {
  let n = entries.length()
  let mut i = 0
  while i < n {
    let (_, v) = entries[i]
    match v {
      TomlValue::Table(_) => ()
      TomlValue::Array(items) => {
        if !is_array_of_tables(items) {
          return true
        }
      }
      _ => return true
    }
    i = i + 1
  }
  false
}

struct TomlWriter {
  sb : StringBuilder
  mut has_output : Bool
}

fn write_toml_table_body(
  w : TomlWriter,
  entries : Array[(String, TomlValue)],
  path : Array[String],
  emit_header : Bool,
) -> Unit {
  let sb = w.sb
  let n = entries.length()
  if emit_header && (n == 0 || has_direct_values(entries)) {
    if w.has_output {
      sb.write_byte((10).to_byte())
    }
    sb.write_byte((91).to_byte())
    write_toml_path(sb, path)
    sb.write_string("]\n")
    w.has_output = true
  }
  // Pass 1: emit scalar and non-AoT array entries first
  let mut i = 0
  while i < n {
    let (k, v) = entries[i]
    match v {
      TomlValue::Table(_) => ()
      TomlValue::Array(items) => {
        if !is_array_of_tables(items) {
          write_toml_key(sb, k)
          sb.write_string(" = ")
          write_toml_inline_value(sb, v)
          sb.write_byte((10).to_byte())
          w.has_output = true
        }
      }
      _ => {
        write_toml_key(sb, k)
        sb.write_string(" = ")
        write_toml_inline_value(sb, v)
        sb.write_byte((10).to_byte())
        w.has_output = true
      }
    }
    i = i + 1
  }
  // Pass 2: emit subtables and arrays of tables
  let mut j = 0
  while j < n {
    let (k, v) = entries[j]
    match v {
      TomlValue::Table(sub_entries) => {
        let child_path = path.copy()
        child_path.push(k)
        write_toml_table_body(w, sub_entries, child_path, true)
      }
      TomlValue::Array(items) => {
        if is_array_of_tables(items) {
          let child_path = path.copy()
          child_path.push(k)
          let m = items.length()
          let mut idx = 0
          while idx < m {
            match items[idx] {
              TomlValue::Table(elem_entries) => {
                if w.has_output {
                  sb.write_byte((10).to_byte())
                }
                sb.write_string("[[")
                write_toml_path(sb, child_path)
                sb.write_string("]]\n")
                w.has_output = true
                write_toml_table_body(w, elem_entries, child_path, false)
              }
              _ => ()
            }
            idx = idx + 1
          }
        }
      }
      _ => ()
    }
    j = j + 1
  }
}

fn stringify_impl(value : TomlValue) -> Result[String, TomlError] {
  match value {
    TomlValue::Table(entries) => {
      let w = TomlWriter::{ sb: StringBuilder::new(), has_output: false }
      let path : Array[String] = []
      write_toml_table_body(w, entries, path, false)
      Ok(w.sb.to_string())
    }
    _ => Err(TomlError::new(1, 1, 0, "TOML root value must be a table"))
  }
}

fn to_toml_test_json_impl(value : TomlValue) -> String {
  let sb = StringBuilder::new()
  write_tagged_json(sb, value)
  sb.to_string()
}
