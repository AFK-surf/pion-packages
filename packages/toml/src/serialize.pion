///| TOML v1.0.0 serializer (`stringify`) and `toml-test` tagged JSON encoder.

let max_serialize_depth : Int = 128

fn make_esc_lut() -> FixedArray[Byte] {
  let lut : FixedArray[Byte] = FixedArray::make(256, (0).to_byte())
  let mut i = 0
  while i < 0x20 {
    lut[i] = (1).to_byte()
    i = i + 1
  }
  lut[34] = (1).to_byte()
  lut[92] = (1).to_byte()
  lut[0x7F] = (1).to_byte()
  lut
}

let esc_lut : FixedArray[Byte] = make_esc_lut()

fn hex_nibble_upper(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (55 + n).to_byte()
  }
}

fn hex_nibble_lower(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (87 + n).to_byte()
  }
}

fn write_i64(sb : StringBuilder, v : Int64) -> Unit {
  if v == 0L {
    sb.write_byte((48).to_byte())
    return
  }
  let mut u : UInt64 = if v < 0L {
    sb.write_byte((45).to_byte())
    (0UL - v.reinterpret_as_uint64())
  } else {
    v.reinterpret_as_uint64()
  }
  let buf : FixedArray[Byte] = FixedArray::make(24, (0).to_byte())
  let mut len = 0
  while u > 0UL {
    let q = u / 10UL
    let r = (u - q * 10UL).to_int()
    buf[len] = (48 + r).to_byte()
    len = len + 1
    u = q
  }
  while len > 0 {
    len = len - 1
    sb.write_byte(buf[len])
  }
}

fn write_json_escaped(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let lut = esc_lut
  let mut i = 0
  let mut chunk_start = 0
  while i < n {
    while i + 4 <= n {
      if lut[s.code_unit_at(i)] != (0).to_byte() ||
      lut[s.code_unit_at(i + 1)] != (0).to_byte() ||
      lut[s.code_unit_at(i + 2)] != (0).to_byte() ||
      lut[s.code_unit_at(i + 3)] != (0).to_byte() {
        break
      }
      i = i + 4
    }
    if i >= n {
      break
    }
    let b = s.code_unit_at(i)
    if lut[b] != (0).to_byte() {
      if i > chunk_start {
        sb.write_string(s.slice(chunk_start, i))
      }
      if b == 34 {
        sb.write_string("\\\"")
      } else if b == 92 {
        sb.write_string("\\\\")
      } else if b == 8 {
        sb.write_string("\\b")
      } else if b == 12 {
        sb.write_string("\\f")
      } else if b == 10 {
        sb.write_string("\\n")
      } else if b == 13 {
        sb.write_string("\\r")
      } else if b == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u00")
        sb.write_byte(hex_nibble_lower((b >> 4) & 0xF))
        sb.write_byte(hex_nibble_lower(b & 0xF))
      }
      chunk_start = i + 1
    }
    i = i + 1
  }
  if chunk_start == 0 {
    sb.write_string(s)
  } else if chunk_start < n {
    sb.write_string(s.slice(chunk_start, n))
  }
  sb.write_byte((34).to_byte())
}

fn write_tagged_json(sb : StringBuilder, value : TomlValue) -> Unit {
  match value {
    TomlValue::Str(s) => {
      sb.write_string("{\"type\":\"string\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::Int(v) => {
      sb.write_string("{\"type\":\"integer\",\"value\":\"")
      write_i64(sb, v)
      sb.write_string("\"}")
    }
    TomlValue::Float(v) => {
      sb.write_string("{\"type\":\"float\",\"value\":\"")
      write_float_exact(sb, v, false)
      sb.write_string("\"}")
    }
    TomlValue::Bool(b) => {
      if b {
        sb.write_string("{\"type\":\"bool\",\"value\":\"true\"}")
      } else {
        sb.write_string("{\"type\":\"bool\",\"value\":\"false\"}")
      }
    }
    TomlValue::OffsetDateTime(s) => {
      sb.write_string("{\"type\":\"datetime\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::LocalDateTime(s) => {
      sb.write_string("{\"type\":\"datetime-local\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::LocalDate(s) => {
      sb.write_string("{\"type\":\"date-local\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::LocalTime(s) => {
      sb.write_string("{\"type\":\"time-local\",\"value\":")
      write_json_escaped(sb, s)
      sb.write_byte((125).to_byte())
    }
    TomlValue::Array(items) => {
      sb.write_byte((91).to_byte())
      let n = items.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        write_tagged_json(sb, items[i])
        i = i + 1
      }
      sb.write_byte((93).to_byte())
    }
    TomlValue::Table(entries) => {
      sb.write_byte((123).to_byte())
      let n = entries.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        let (k, v) = entries[i]
        write_json_escaped(sb, k)
        sb.write_byte((58).to_byte())
        write_tagged_json(sb, v)
        i = i + 1
      }
      sb.write_byte((125).to_byte())
    }
  }
}

fn is_bare_key_str(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let lut = bare_key_lut
  let mut i = 0
  while i + 4 <= n {
    if lut[s.code_unit_at(i)] == (0).to_byte() ||
    lut[s.code_unit_at(i + 1)] == (0).to_byte() ||
    lut[s.code_unit_at(i + 2)] == (0).to_byte() ||
    lut[s.code_unit_at(i + 3)] == (0).to_byte() {
      return false
    }
    i = i + 4
  }
  while i < n {
    if lut[s.code_unit_at(i)] == (0).to_byte() {
      return false
    }
    i = i + 1
  }
  true
}

fn write_toml_basic_str(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let lut = esc_lut
  let mut i = 0
  let mut chunk_start = 0
  while i < n {
    while i + 4 <= n {
      if lut[s.code_unit_at(i)] != (0).to_byte() ||
      lut[s.code_unit_at(i + 1)] != (0).to_byte() ||
      lut[s.code_unit_at(i + 2)] != (0).to_byte() ||
      lut[s.code_unit_at(i + 3)] != (0).to_byte() {
        break
      }
      i = i + 4
    }
    if i >= n {
      break
    }
    let b = s.code_unit_at(i)
    if lut[b] != (0).to_byte() {
      if i > chunk_start {
        sb.write_string(s.slice(chunk_start, i))
      }
      if b == 34 {
        sb.write_string("\\\"")
      } else if b == 92 {
        sb.write_string("\\\\")
      } else if b == 8 {
        sb.write_string("\\b")
      } else if b == 9 {
        sb.write_string("\\t")
      } else if b == 10 {
        sb.write_string("\\n")
      } else if b == 12 {
        sb.write_string("\\f")
      } else if b == 13 {
        sb.write_string("\\r")
      } else {
        sb.write_string("\\u00")
        sb.write_byte(hex_nibble_upper((b >> 4) & 0xF))
        sb.write_byte(hex_nibble_upper(b & 0xF))
      }
      chunk_start = i + 1
    }
    i = i + 1
  }
  if chunk_start == 0 {
    sb.write_string(s)
  } else if chunk_start < n {
    sb.write_string(s.slice(chunk_start, n))
  }
  sb.write_byte((34).to_byte())
}

fn write_toml_key(sb : StringBuilder, k : String) -> Unit {
  if is_bare_key_str(k) {
    sb.write_string(k)
  } else {
    write_toml_basic_str(sb, k)
  }
}

fn write_toml_path(sb : StringBuilder, path : Array[String]) -> Unit {
  let n = path.length()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_byte((46).to_byte())
    }
    write_toml_key(sb, path[i])
    i = i + 1
  }
}

fn is_array_of_tables(items : Array[TomlValue]) -> Bool {
  let n = items.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    match items[i] {
      TomlValue::Table(_) => ()
      _ => return false
    }
    i = i + 1
  }
  true
}

fn validate_date_prefix(s : String) -> Bool {
  if s.length() < 10 || s.code_unit_at(4) != 45 || s.code_unit_at(7) != 45 {
    return false
  }
  let y = parse_fixed_digits_raw(s, 0, 4)
  if y < 0 {
    return false
  }
  let mo = parse_fixed_digits_raw(s, 5, 2)
  if mo < 1 || mo > 12 {
    return false
  }
  let d = parse_fixed_digits_raw(s, 8, 2)
  if d < 1 {
    return false
  }
  let dim = days_in_month_p(y, mo)
  d <= dim
}

fn validate_local_date(s : String) -> Bool {
  s.length() == 10 && validate_date_prefix(s)
}

fn validate_local_time(s : String) -> Bool {
  let n = s.length()
  if n < 8 {
    return false
  }
  parse_time_part_raw(s, 0, n) == n
}

fn validate_local_datetime(s : String) -> Bool {
  let n = s.length()
  if n < 19 || !validate_date_prefix(s) {
    return false
  }
  let sep = s.code_unit_at(10)
  if sep != 84 && sep != 116 && sep != 32 {
    return false
  }
  parse_time_part_raw(s, 11, n) == n
}

fn validate_offset_datetime(s : String) -> Bool {
  let n = s.length()
  if n < 20 || !validate_date_prefix(s) {
    return false
  }
  let sep = s.code_unit_at(10)
  if sep != 84 && sep != 116 && sep != 32 {
    return false
  }
  let after_time = parse_time_part_raw(s, 11, n)
  if after_time < 0 || after_time >= n {
    return false
  }
  let ob = s.code_unit_at(after_time)
  if ob == 90 || ob == 122 {
    return after_time + 1 == n
  }
  if ob == 43 || ob == 45 {
    if after_time + 6 != n || s.code_unit_at(after_time + 3) != 58 {
      return false
    }
    let oh = parse_fixed_digits_raw(s, after_time + 1, 2)
    let om = parse_fixed_digits_raw(s, after_time + 4, 2)
    return oh >= 0 && oh <= 23 && om >= 0 && om <= 59
  }
  false
}

fn check_unique_keys(entries : Array[(String, TomlValue)]) -> Result[Unit, TomlError] {
  let n = entries.length()
  if n <= 1 {
    return Ok(())
  }
  if n <= 16 {
    let mut i = 0
    while i < n {
      let (ki, _) = entries[i]
      let mut j = i + 1
      while j < n {
        let (kj, _) = entries[j]
        if ki == kj {
          return Err(TomlError::new(1, 1, 0, "duplicate key in table: " + ki))
        }
        j = j + 1
      }
      i = i + 1
    }
    return Ok(())
  }
  let idx = HashIndex::new(n * 2, next_seed())
  let mut i = 0
  while i < n {
    let (k, _) = entries[i]
    if !idx.insert_unique(k, i) {
      return Err(TomlError::new(1, 1, 0, "duplicate key in table: " + k))
    }
    i = i + 1
  }
  Ok(())
}

fn write_toml_inline_value(
  sb : StringBuilder,
  value : TomlValue,
  depth : Int,
) -> Result[Unit, TomlError] {
  if depth > max_serialize_depth {
    return Err(TomlError::new(1, 1, 0, "recursion limit exceeded while serializing TOML"))
  }
  match value {
    TomlValue::Str(s) => {
      write_toml_basic_str(sb, s)
      Ok(())
    }
    TomlValue::Int(v) => {
      write_i64(sb, v)
      Ok(())
    }
    TomlValue::Float(v) => {
      write_float_exact(sb, v, true)
      Ok(())
    }
    TomlValue::Bool(b) => {
      sb.write_string(if b { "true" } else { "false" })
      Ok(())
    }
    TomlValue::OffsetDateTime(s) => {
      if !validate_offset_datetime(s) {
        return Err(TomlError::new(1, 1, 0, "invalid offset datetime: " + s))
      }
      sb.write_string(s)
      Ok(())
    }
    TomlValue::LocalDateTime(s) => {
      if !validate_local_datetime(s) {
        return Err(TomlError::new(1, 1, 0, "invalid local datetime: " + s))
      }
      sb.write_string(s)
      Ok(())
    }
    TomlValue::LocalDate(s) => {
      if !validate_local_date(s) {
        return Err(TomlError::new(1, 1, 0, "invalid local date: " + s))
      }
      sb.write_string(s)
      Ok(())
    }
    TomlValue::LocalTime(s) => {
      if !validate_local_time(s) {
        return Err(TomlError::new(1, 1, 0, "invalid local time: " + s))
      }
      sb.write_string(s)
      Ok(())
    }
    TomlValue::Array(items) => {
      sb.write_byte((91).to_byte())
      let n = items.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_string(", ")
        }
        match write_toml_inline_value(sb, items[i], depth + 1) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      sb.write_byte((93).to_byte())
      Ok(())
    }
    TomlValue::Table(entries) => {
      match check_unique_keys(entries) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_byte((123).to_byte())
      let n = entries.length()
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_string(", ")
        }
        let (k, v) = entries[i]
        write_toml_key(sb, k)
        sb.write_string(" = ")
        match write_toml_inline_value(sb, v, depth + 1) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      sb.write_byte((125).to_byte())
      Ok(())
    }
  }
}

struct TomlWriter {
  sb : StringBuilder
  mut has_output : Bool
}

fn write_toml_table_body(
  w : TomlWriter,
  entries : Array[(String, TomlValue)],
  path : Array[String],
  emit_header : Bool,
  depth : Int,
) -> Result[Unit, TomlError] {
  if depth > max_serialize_depth {
    return Err(TomlError::new(1, 1, 0, "recursion limit exceeded while serializing TOML"))
  }
  match check_unique_keys(entries) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let sb = w.sb
  let n = entries.length()
  let mut header_emitted = false
  if emit_header && n == 0 {
    if w.has_output {
      sb.write_byte((10).to_byte())
    }
    sb.write_byte((91).to_byte())
    write_toml_path(sb, path)
    sb.write_string("]\n")
    w.has_output = true
    return Ok(())
  }
  // Pass 1: emit scalar and non-AoT array entries first; lazily emit header on first direct value.
  let mut has_sub = false
  let mut i = 0
  while i < n {
    let (k, v) = entries[i]
    match v {
      TomlValue::Table(_) => {
        has_sub = true
      }
      TomlValue::Array(items) => {
        if is_array_of_tables(items) {
          has_sub = true
        } else {
          if emit_header && !header_emitted {
            if w.has_output {
              sb.write_byte((10).to_byte())
            }
            sb.write_byte((91).to_byte())
            write_toml_path(sb, path)
            sb.write_string("]\n")
            w.has_output = true
            header_emitted = true
          }
          write_toml_key(sb, k)
          sb.write_string(" = ")
          match write_toml_inline_value(sb, v, depth + 1) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          sb.write_byte((10).to_byte())
          w.has_output = true
        }
      }
      _ => {
        if emit_header && !header_emitted {
          if w.has_output {
            sb.write_byte((10).to_byte())
          }
          sb.write_byte((91).to_byte())
          write_toml_path(sb, path)
          sb.write_string("]\n")
          w.has_output = true
          header_emitted = true
        }
        write_toml_key(sb, k)
        sb.write_string(" = ")
        match write_toml_inline_value(sb, v, depth + 1) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        sb.write_byte((10).to_byte())
        w.has_output = true
      }
    }
    i = i + 1
  }
  if !has_sub {
    return Ok(())
  }
  // Pass 2: emit subtables and arrays of tables
  let mut j = 0
  while j < n {
    let (k, v) = entries[j]
    match v {
      TomlValue::Table(sub_entries) => {
        path.push(k)
        match write_toml_table_body(w, sub_entries, path, true, depth + 1) {
          Ok(_) => ()
          Err(e) => {
            let _ = path.pop()
            return Err(e)
          }
        }
        let _ = path.pop()
      }
      TomlValue::Array(items) => {
        if is_array_of_tables(items) {
          path.push(k)
          let m = items.length()
          let mut idx = 0
          while idx < m {
            match items[idx] {
              TomlValue::Table(elem_entries) => {
                if w.has_output {
                  sb.write_byte((10).to_byte())
                }
                sb.write_string("[[")
                write_toml_path(sb, path)
                sb.write_string("]]\n")
                w.has_output = true
                match write_toml_table_body(w, elem_entries, path, false, depth + 1) {
                  Ok(_) => ()
                  Err(e) => {
                    let _ = path.pop()
                    return Err(e)
                  }
                }
              }
              _ => ()
            }
            idx = idx + 1
          }
          let _ = path.pop()
        }
      }
      _ => ()
    }
    j = j + 1
  }
  Ok(())
}

fn stringify_impl(value : TomlValue) -> Result[String, TomlError] {
  match value {
    TomlValue::Table(entries) => {
      let est = entries.length() * 64 + 256
      let init_cap = if est > 65536 { 65536 } else { est }
      let w = TomlWriter::{ sb: StringBuilder::with_capacity(init_cap), has_output: false }
      let path : Array[String] = Array::with_capacity(8)
      match write_toml_table_body(w, entries, path, false, 0) {
        Ok(_) => Ok(w.sb.to_string())
        Err(e) => Err(e)
      }
    }
    _ => Err(TomlError::new(1, 1, 0, "TOML root value must be a table"))
  }
}

fn to_toml_test_json_impl(value : TomlValue) -> String {
  let sb = StringBuilder::with_capacity(256)
  write_tagged_json(sb, value)
  sb.to_string()
}
