  assert_toml_invalid("invalid/spec-1.0.0/inline-table-2-0.toml", "[product]\ntype = { name = \"Nail\" }\ntype.edible = false  # INVALID\n")
}

///|
test "invalid__spec_1_0_0__inline_table_3_0" {
  assert_toml_invalid("invalid/spec-1.0.0/inline-table-3-0.toml", "[product]\ntype.name = \"Nail\"\ntype = { edible = false }  # INVALID\n")
}

///|
test "invalid__spec_1_0_0__key_value_pair_1" {
  assert_toml_invalid("invalid/spec-1.0.0/key-value-pair-1.toml", "key = # INVALID\n")
}

///|
test "invalid__spec_1_0_0__keys_2" {
  assert_toml_invalid("invalid/spec-1.0.0/keys-2.toml", "= \"no key name\"  # INVALID\n\"\" = \"blank\"     # VALID but discouraged\n'' = 'blank'     # VALID but discouraged\n")
}

///|
test "invalid__spec_1_0_0__string_4_0" {
  assert_toml_invalid("invalid/spec-1.0.0/string-4-0.toml", "str4 = \"\"\"Here are two quotation marks: \"\". Simple enough.\"\"\"\nstr5 = \"\"\"Here are three quotation marks: \"\"\".\"\"\"  # INVALID\nstr5 = \"\"\"Here are three quotation marks: \"\"\\\".\"\"\"\nstr6 = \"\"\"Here are fifteen quotation marks: \"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\".\"\"\"\n\n# \"This,\" she said, \"is just a pointless statement.\"\nstr7 = \"\"\"\"This,\" she said, \"is just a pointless statement.\"\"\"\"\n")
}

///|
test "invalid__spec_1_0_0__string_7_0" {
  assert_toml_invalid("invalid/spec-1.0.0/string-7-0.toml", "quot15 = '''Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\"'''\n\napos15 = '''Here are fifteen apostrophes: ''''''''''''''''''  # INVALID\napos15 = \"Here are fifteen apostrophes: '''''''''''''''\"\n\n# 'That,' she said, 'is still pointless.'\nstr = ''''That,' she said, 'is still pointless.''''\n")
}

///|
test "invalid__spec_1_0_0__table_9_0" {
  assert_toml_invalid("invalid/spec-1.0.0/table-9-0.toml", "[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n[fruit.apple]  # INVALID\n# [fruit.apple.taste]  # INVALID\n\n[fruit.apple.texture]  # you can add sub-tables\nsmooth = true\n")
}

///|
test "invalid__spec_1_0_0__table_9_1" {
  assert_toml_invalid("invalid/spec-1.0.0/table-9-1.toml", "[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n# [fruit.apple]  # INVALID\n[fruit.apple.taste]  # INVALID\n\n[fruit.apple.texture]  # you can add sub-tables\nsmooth = true\n")
}

