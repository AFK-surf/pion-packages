///| Official toml-test v1.0.0 invalid compliance suite (340..509 of 509).

///|
test "invalid__local_datetime__no_leads_with_milli" {
  assert_toml_invalid("invalid/local-datetime/no-leads-with-milli.toml", "# Day \"5\" instead of \"05\"; the leading zero is required.\nwith-milli = 1987-07-5T17:45:00.12\n")
}

///|
test "invalid__local_datetime__no_mins" {
  assert_toml_invalid("invalid/local-datetime/no-mins.toml", "# No seconds nor minutes in time.\nno-mins = 1987-07-05T17\n")
}

///|
test "invalid__local_datetime__no_secs" {
  assert_toml_invalid("invalid/local-datetime/no-secs.toml", "# No seconds in time.\nno-secs = 1987-07-05T17:45\n")
}

///|
test "invalid__local_datetime__no_t" {
  assert_toml_invalid("invalid/local-datetime/no-t.toml", "# No \"t\" or \"T\" between the date and time.\nno-t = 1987-07-0517:45:00\n")
}

///|
test "invalid__local_datetime__second_over" {
  assert_toml_invalid("invalid/local-datetime/second-over.toml", "# time-second     = 2DIGIT  ; 00-58, 00-59, 00-60 based on leap second\n#                           ; rules\nd = 2006-01-01T00:00:61\n")
}

///|
test "invalid__local_datetime__time_no_leads" {
  assert_toml_invalid("invalid/local-datetime/time-no-leads.toml", "# Leading 0 is always required.\nd = 2023-10-01T1:32:00Z\n")
}

///|
test "invalid__local_datetime__y10k" {
  assert_toml_invalid("invalid/local-datetime/y10k.toml", "# Maximum RFC3399 year is 9999.\nd = 10000-01-01 00:00:00\n")
}

///|
test "invalid__local_time__hour_over" {
  assert_toml_invalid("invalid/local-time/hour-over.toml", "# time-hour       = 2DIGIT  ; 00-23\nd = 24:00:00\n")
}

///|
test "invalid__local_time__minute_over" {
  assert_toml_invalid("invalid/local-time/minute-over.toml", "# time-minute     = 2DIGIT  ; 00-59\nd = 00:60:00\n")
}

///|
test "invalid__local_time__no_secs" {
  assert_toml_invalid("invalid/local-time/no-secs.toml", "# No seconds in time.\nno-secs = 17:45\n")
}

///|
test "invalid__local_time__second_over" {
  assert_toml_invalid("invalid/local-time/second-over.toml", "# time-second     = 2DIGIT  ; 00-58, 00-59, 00-60 based on leap second\n#                           ; rules\nd = 00:00:61\n")
}

///|
test "invalid__local_time__time_no_leads_01" {
  assert_toml_invalid("invalid/local-time/time-no-leads-01.toml", "# Leading 0 is always required.\nd = 1:32:00\n")
}

///|
test "invalid__local_time__time_no_leads_02" {
  assert_toml_invalid("invalid/local-time/time-no-leads-02.toml", "# Leading 0 is always required.\nd = 01:32:0\n")
}

///|
test "invalid__local_time__trailing_dot" {
  assert_toml_invalid("invalid/local-time/trailing-dot.toml", "t = 12:13:14.\n")
}

///|
test "invalid__local_time__trailing_dotdot" {
  assert_toml_invalid("invalid/local-time/trailing-dotdot.toml", "t = 12:13:14..\n")
}

///|
test "invalid__local_time__with_timezone_offset_01" {
  assert_toml_invalid("invalid/local-time/with-timezone-offset-01.toml", "# local-time can't have timezone\nfoo = 17:45:00+02:00\n")
}

///|
test "invalid__local_time__with_timezone_offset_02" {
  assert_toml_invalid("invalid/local-time/with-timezone-offset-02.toml", "# local-time can't have timezone\nfoo = 17:45:00Z\n")
}

