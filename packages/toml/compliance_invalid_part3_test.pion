///|
test "invalid__table__append_with_dotted_keys_01" {
  assert_toml_invalid("invalid/table/append-with-dotted-keys-01.toml", "# First a.b.c defines a table: a.b.c = {z=9}\n#\n# Then we define a.b.c.t = \"str\" to add a str to the above table, making it:\n#\n#   a.b.c = {z=9, t=\"...\"}\n#\n# While this makes sense, logically, it was decided this is not valid TOML as\n# it's too confusing/convoluted.\n# \n# See: https://github.com/toml-lang/toml/issues/846\n#      https://github.com/toml-lang/toml/pull/859\n\n[a.b.c]\n  z = 9\n\n[a]\n  b.c.t = \"Using dotted keys to add to [a.b.c] after explicitly defining it above is not allowed\"\n")
}

///|
test "invalid__table__append_with_dotted_keys_02" {
  assert_toml_invalid("invalid/table/append-with-dotted-keys-02.toml", "# This is the same issue as in injection-1.toml, except that nests one level\n# deeper. See that file for a more complete description.\n\n[a.b.c.d]\n  z = 9\n\n[a]\n  b.c.d.k.t = \"Using dotted keys to add to [a.b.c.d] after explicitly defining it above is not allowed\"\n")
}

///|
test "invalid__table__append_with_dotted_keys_03" {
  assert_toml_invalid("invalid/table/append-with-dotted-keys-03.toml", "[[a.b]]\n\n[a]\nb.y = 2\n")
}

///|
test "invalid__table__append_with_dotted_keys_04" {
  assert_toml_invalid("invalid/table/append-with-dotted-keys-04.toml", "[dependencies.foo]\nversion = \"0.16\"\n\n[dependencies]\nlibc = \"0.2\"\n\n[dependencies]\nrand = \"0.3.14\"\n")
}

///|
test "invalid__table__append_with_dotted_keys_05" {
  assert_toml_invalid("invalid/table/append-with-dotted-keys-05.toml", "a.b.c = 1\na.b = 2\n")
}

