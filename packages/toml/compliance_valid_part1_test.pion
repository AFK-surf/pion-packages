///| Official toml-test v1.0.0 valid compliance suite (1..104 of 208).

///|
test "valid__array__array" {
  assert_toml_valid("valid/array/array.toml", "ints = [1, 2, 3, ]\nfloats = [1.1, 2.1, 3.1]\nstrings = [\"a\", \"b\", \"c\"]\ndates = [\n\t1987-07-05T17:45:00Z,\n\t1979-05-27T07:32:00,\n\t2006-06-01,\n\t11:00:00,\n]\ncomments = [\n         1,\n         2, #this is ok\n]\n", "{\"comments\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}],\"dates\":[{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:00Z\"},{\"type\":\"datetime-local\",\"value\":\"1979-05-27T07:32:00\"},{\"type\":\"date-local\",\"value\":\"2006-06-01\"},{\"type\":\"time-local\",\"value\":\"11:00:00\"}],\"floats\":[{\"type\":\"float\",\"value\":\"1.1\"},{\"type\":\"float\",\"value\":\"2.1\"},{\"type\":\"float\",\"value\":\"3.1\"}],\"ints\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"},{\"type\":\"integer\",\"value\":\"3\"}],\"strings\":[{\"type\":\"string\",\"value\":\"a\"},{\"type\":\"string\",\"value\":\"b\"},{\"type\":\"string\",\"value\":\"c\"}]}")
}

///|
test "valid__array__array_subtables" {
  assert_toml_valid("valid/array/array-subtables.toml", "[[arr]]\n[arr.subtab]\nval=1\n\n[[arr]]\n[arr.subtab]\nval=2\n", "{\"arr\":[{\"subtab\":{\"val\":{\"type\":\"integer\",\"value\":\"1\"}}},{\"subtab\":{\"val\":{\"type\":\"integer\",\"value\":\"2\"}}}]}")
}

///|
test "valid__array__bool" {
  assert_toml_valid("valid/array/bool.toml", "a = [true, false]\n", "{\"a\":[{\"type\":\"bool\",\"value\":\"true\"},{\"type\":\"bool\",\"value\":\"false\"}]}")
}

///|
test "valid__array__empty" {
  assert_toml_valid("valid/array/empty.toml", "thevoid = [[[[[]]]]]\n", "{\"thevoid\":[[[[[]]]]]}")
}

///|
test "valid__array__hetergeneous" {
  assert_toml_valid("valid/array/hetergeneous.toml", "mixed = [[1, 2], [\"a\", \"b\"], [1.1, 2.1]]\n", "{\"mixed\":[[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}],[{\"type\":\"string\",\"value\":\"a\"},{\"type\":\"string\",\"value\":\"b\"}],[{\"type\":\"float\",\"value\":\"1.1\"},{\"type\":\"float\",\"value\":\"2.1\"}]]}")
}

///|
test "valid__array__mixed_int_array" {
  assert_toml_valid("valid/array/mixed-int-array.toml", "arrays-and-ints =  [1, [\"Arrays are not integers.\"]]\n", "{\"arrays-and-ints\":[{\"type\":\"integer\",\"value\":\"1\"},[{\"type\":\"string\",\"value\":\"Arrays are not integers.\"}]]}")
}

///|
test "valid__array__mixed_int_float" {
  assert_toml_valid("valid/array/mixed-int-float.toml", "ints-and-floats = [1, 1.1]\n", "{\"ints-and-floats\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"float\",\"value\":\"1.1\"}]}")
}

///|
test "valid__array__mixed_int_string" {
  assert_toml_valid("valid/array/mixed-int-string.toml", "strings-and-ints = [\"hi\", 42]\n", "{\"strings-and-ints\":[{\"type\":\"string\",\"value\":\"hi\"},{\"type\":\"integer\",\"value\":\"42\"}]}")
}

///|
test "valid__array__mixed_string_table" {
  assert_toml_valid("valid/array/mixed-string-table.toml", "contributors = [\n  \"Foo Bar <foo@example.com>\",\n  { name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" }\n]\n\n# Start with a table as the first element. This tests a case that some libraries\n# might have where they will check if the first entry is a table/map/hash/assoc\n# array and then encode it as a table array. This was a reasonable thing to do\n# before TOML 1.0 since arrays could only contain one type, but now it's no\n# longer.\nmixed = [{k=\"a\"}, \"b\", 1]\n", "{\"contributors\":[{\"type\":\"string\",\"value\":\"Foo Bar <foo@example.com>\"},{\"email\":{\"type\":\"string\",\"value\":\"bazqux@example.com\"},\"name\":{\"type\":\"string\",\"value\":\"Baz Qux\"},\"url\":{\"type\":\"string\",\"value\":\"https://example.com/bazqux\"}}],\"mixed\":[{\"k\":{\"type\":\"string\",\"value\":\"a\"}},{\"type\":\"string\",\"value\":\"b\"},{\"type\":\"integer\",\"value\":\"1\"}]}")
}

///|
test "valid__array__nested" {
  assert_toml_valid("valid/array/nested.toml", "nest = [[\"a\"], [\"b\"]]\n", "{\"nest\":[[{\"type\":\"string\",\"value\":\"a\"}],[{\"type\":\"string\",\"value\":\"b\"}]]}")
}

///|
test "valid__array__nested_double" {
  assert_toml_valid("valid/array/nested-double.toml", "nest = [\n\t[\n\t\t[\"a\"],\n\t\t[1, 2, [3]]\n\t]\n]\n", "{\"nest\":[[[{\"type\":\"string\",\"value\":\"a\"}],[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"},[{\"type\":\"integer\",\"value\":\"3\"}]]]]}")
}

///|
test "valid__array__nested_inline_table" {
  assert_toml_valid("valid/array/nested-inline-table.toml", "a = [ { b = {} } ]\n", "{\"a\":[{\"b\":{}}]}")
}

///|
test "valid__array__nospaces" {
  assert_toml_valid("valid/array/nospaces.toml", "ints = [1,2,3]\n", "{\"ints\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"},{\"type\":\"integer\",\"value\":\"3\"}]}")
}

///|
test "valid__array__open_parent_table" {
  assert_toml_valid("valid/array/open-parent-table.toml", "[[parent-table.arr]]\n[[parent-table.arr]]\n[parent-table]\nnot-arr = 1\n", "{\"parent-table\":{\"not-arr\":{\"type\":\"integer\",\"value\":\"1\"},\"arr\":[{},{}]}}")
}

///|
test "valid__array__string_quote_comma_01" {
  assert_toml_valid("valid/array/string-quote-comma-01.toml", "title = [\n\"Client: \\\"XXXX\\\", Job: XXXX\",\n\"Code: XXXX\"\n]\n", "{\"title\":[{\"type\":\"string\",\"value\":\"Client: \\\"XXXX\\\", Job: XXXX\"},{\"type\":\"string\",\"value\":\"Code: XXXX\"}]}")
}

///|
test "valid__array__string_quote_comma_02" {
  assert_toml_valid("valid/array/string-quote-comma-02.toml", "title = [ \" \\\", \",]\n", "{\"title\":[{\"type\":\"string\",\"value\":\" \\\", \"}]}")
}

///|
test "valid__array__string_with_comma_01" {
  assert_toml_valid("valid/array/string-with-comma-01.toml", "title = [\n\"Client: XXXX, Job: XXXX\",\n\"Code: XXXX\"\n]\n", "{\"title\":[{\"type\":\"string\",\"value\":\"Client: XXXX, Job: XXXX\"},{\"type\":\"string\",\"value\":\"Code: XXXX\"}]}")
}

///|
test "valid__array__string_with_comma_02" {
  assert_toml_valid("valid/array/string-with-comma-02.toml", "title = [\n\"\"\"Client: XXXX,\nJob: XXXX\"\"\",\n\"Code: XXXX\"\n]\n", "{\"title\":[{\"type\":\"string\",\"value\":\"Client: XXXX,\\nJob: XXXX\"},{\"type\":\"string\",\"value\":\"Code: XXXX\"}]}")
}

///|
test "valid__array__strings" {
  assert_toml_valid("valid/array/strings.toml", "string_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''']\n", "{\"string_array\":[{\"type\":\"string\",\"value\":\"all\"},{\"type\":\"string\",\"value\":\"strings\"},{\"type\":\"string\",\"value\":\"are the same\"},{\"type\":\"string\",\"value\":\"type\"}]}")
}

///|
test "valid__array__table_array_string_backslash" {
  assert_toml_valid("valid/array/table-array-string-backslash.toml", "foo = [ { bar=\"\\\"{{baz}}\\\"\"} ]\n", "{\"foo\":[{\"bar\":{\"type\":\"string\",\"value\":\"\\\"{{baz}}\\\"\"}}]}")
}

///|
test "valid__array__trailing_comma" {
  assert_toml_valid("valid/array/trailing-comma.toml", "arr-1 = [1,]\n\narr-2 = [2,3,]\n\narr-3 = [4,\n]\n\narr-4 = [\n\t5,\n\t6,\n]\n", "{\"arr-1\":[{\"type\":\"integer\",\"value\":\"1\"}],\"arr-3\":[{\"type\":\"integer\",\"value\":\"4\"}],\"arr-2\":[{\"type\":\"integer\",\"value\":\"2\"},{\"type\":\"integer\",\"value\":\"3\"}],\"arr-4\":[{\"type\":\"integer\",\"value\":\"5\"},{\"type\":\"integer\",\"value\":\"6\"}]}")
}

///|
test "valid__bool__bool" {
  assert_toml_valid("valid/bool/bool.toml", "t = true\nf = false\n", "{\"f\":{\"type\":\"bool\",\"value\":\"false\"},\"t\":{\"type\":\"bool\",\"value\":\"true\"}}")
}

///|
test "valid__comment__after_literal_no_ws" {
  assert_toml_valid("valid/comment/after-literal-no-ws.toml", "inf=inf#infinity\nnan=nan#not a number\ntrue=true#true\nfalse=false#false\n", "{\"false\":{\"type\":\"bool\",\"value\":\"false\"},\"inf\":{\"type\":\"float\",\"value\":\"inf\"},\"nan\":{\"type\":\"float\",\"value\":\"nan\"},\"true\":{\"type\":\"bool\",\"value\":\"true\"}}")
}

///|
test "valid__comment__at_eof" {
  assert_toml_valid("valid/comment/at-eof.toml", "# This is a full-line comment\nkey = \"value\" # This is a comment at the end of a line\n", "{\"key\":{\"type\":\"string\",\"value\":\"value\"}}")
}

///|
test "valid__comment__at_eof2" {
  assert_toml_valid("valid/comment/at-eof2.toml", "# This is a full-line comment\nkey = \"value\" # This is a comment at the end of a line\n", "{\"key\":{\"type\":\"string\",\"value\":\"value\"}}")
}

///|
test "valid__comment__everywhere" {
  assert_toml_valid("valid/comment/everywhere.toml", "# Top comment.\n  # Top comment.\n# Top comment.\n\n# [no-extraneous-groups-please]\n\n[group] # Comment\nanswer = 42 # Comment\n# no-extraneous-keys-please = 999\n# Inbetween comment.\nmore = [ # Comment\n  # What about multiple # comments?\n  # Can you handle it?\n  #\n          # Evil.\n# Evil.\n  42, 42, # Comments within arrays are fun.\n  # What about multiple # comments?\n  # Can you handle it?\n  #\n          # Evil.\n# Evil.\n# ] Did I fool you?\n] # Hopefully not.\n\n# Make sure the space between the datetime and \"#\" isn't lexed.\ndt = 1979-05-27T07:32:12-07:00  # c\nd = 1979-05-27 # Comment\n\n[[aot]] # Comment\nk = 98 # Comment\n[[aot]]# Comment\nk = 99# Comment\n", "{\"aot\":[{\"k\":{\"type\":\"integer\",\"value\":\"98\"}},{\"k\":{\"type\":\"integer\",\"value\":\"99\"}}],\"group\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"},\"d\":{\"type\":\"date-local\",\"value\":\"1979-05-27\"},\"dt\":{\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:12-07:00\"},\"more\":[{\"type\":\"integer\",\"value\":\"42\"},{\"type\":\"integer\",\"value\":\"42\"}]}}")
}

///|
test "valid__comment__noeol" {
  assert_toml_valid("valid/comment/noeol.toml", "# single comment without any eol characters", "{}")
}

///|
test "valid__comment__nonascii" {
  assert_toml_valid("valid/comment/nonascii.toml", "# ~  ÿ ퟿  ￿ 𐀀 􏿿\n", "{}")
}

///|
test "valid__comment__tricky" {
  assert_toml_valid("valid/comment/tricky.toml", "[section]#attached comment\n#[notsection]\none = \"11\"#cmt\ntwo = \"22#\"\nthree = '#'\n\nfour = \"\"\"# no comment\n# nor this\n#also not comment\"\"\"#is_comment\n\nfive = 5.5#66\nsix = 6#7\n8 = \"eight\"\n#nine = 99\nten = 10e2#1\neleven = 1.11e1#23\n\n[\"hash#tag\"]\n\"#!\" = \"hash bang\"\narr3 = [ \"#\", '#', \"\"\"###\"\"\" ]\narr4 = [ 1,# 9, 9,\n2#,9\n,#9\n3#]\n,4]\narr5 = [[[[#[\"#\"],\n[\"#\"]]]]#]\n]\ntbl1 = { \"#\" = '}#'}#}}\n\n\n", "{\"hash#tag\":{\"#!\":{\"type\":\"string\",\"value\":\"hash bang\"},\"arr5\":[[[[[{\"type\":\"string\",\"value\":\"#\"}]]]]],\"arr3\":[{\"type\":\"string\",\"value\":\"#\"},{\"type\":\"string\",\"value\":\"#\"},{\"type\":\"string\",\"value\":\"###\"}],\"arr4\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"},{\"type\":\"integer\",\"value\":\"3\"},{\"type\":\"integer\",\"value\":\"4\"}],\"tbl1\":{\"#\":{\"type\":\"string\",\"value\":\"}#\"}}},\"section\":{\"8\":{\"type\":\"string\",\"value\":\"eight\"},\"eleven\":{\"type\":\"float\",\"value\":\"11.1\"},\"five\":{\"type\":\"float\",\"value\":\"5.5\"},\"four\":{\"type\":\"string\",\"value\":\"# no comment\\n# nor this\\n#also not comment\"},\"one\":{\"type\":\"string\",\"value\":\"11\"},\"six\":{\"type\":\"integer\",\"value\":\"6\"},\"ten\":{\"type\":\"float\",\"value\":\"1000.0\"},\"three\":{\"type\":\"string\",\"value\":\"#\"},\"two\":{\"type\":\"string\",\"value\":\"22#\"}}}")
}

///|
test "valid__datetime__datetime" {
  assert_toml_valid("valid/datetime/datetime.toml", "space = 1987-07-05 17:45:00Z\n\n# ABNF is case-insensitive, both \"Z\" and \"z\" must be supported.\nlower = 1987-07-05t17:45:00z\n", "{\"lower\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:00Z\"},\"space\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:00Z\"}}")
}

///|
test "valid__datetime__edge" {
  assert_toml_valid("valid/datetime/edge.toml", "first-offset = 0001-01-01 00:00:00Z\nfirst-local  = 0001-01-01 00:00:00\nfirst-date   = 0001-01-01\n\nlast-offset = 9999-12-31 23:59:59Z\nlast-local  = 9999-12-31 23:59:59\nlast-date   = 9999-12-31\n", "{\"first-date\":{\"type\":\"date-local\",\"value\":\"0001-01-01\"},\"first-local\":{\"type\":\"datetime-local\",\"value\":\"0001-01-01T00:00:00\"},\"first-offset\":{\"type\":\"datetime\",\"value\":\"0001-01-01T00:00:00Z\"},\"last-date\":{\"type\":\"date-local\",\"value\":\"9999-12-31\"},\"last-local\":{\"type\":\"datetime-local\",\"value\":\"9999-12-31T23:59:59\"},\"last-offset\":{\"type\":\"datetime\",\"value\":\"9999-12-31T23:59:59Z\"}}")
}

///|
test "valid__datetime__invalid_date_in_string" {
  assert_toml_valid("valid/datetime/invalid-date-in-string.toml", "s = '2020-01-01x'\n", "{\"s\":{\"type\":\"string\",\"value\":\"2020-01-01x\"}}")
}

///|
test "valid__datetime__leap_year" {
  assert_toml_valid("valid/datetime/leap-year.toml", "2000-datetime       = 2000-02-29 15:15:15Z\n2000-datetime-local = 2000-02-29 15:15:15\n2000-date           = 2000-02-29\n\n2024-datetime       = 2024-02-29 15:15:15Z\n2024-datetime-local = 2024-02-29 15:15:15\n2024-date           = 2024-02-29\n", "{\"2000-date\":{\"type\":\"date-local\",\"value\":\"2000-02-29\"},\"2000-datetime\":{\"type\":\"datetime\",\"value\":\"2000-02-29T15:15:15Z\"},\"2000-datetime-local\":{\"type\":\"datetime-local\",\"value\":\"2000-02-29T15:15:15\"},\"2024-date\":{\"type\":\"date-local\",\"value\":\"2024-02-29\"},\"2024-datetime\":{\"type\":\"datetime\",\"value\":\"2024-02-29T15:15:15Z\"},\"2024-datetime-local\":{\"type\":\"datetime-local\",\"value\":\"2024-02-29T15:15:15\"}}")
}

///|
test "valid__datetime__local" {
  assert_toml_valid("valid/datetime/local.toml", "local = 1987-07-05T17:45:00\nmilli = 1977-12-21T10:32:00.555\nspace = 1987-07-05 17:45:00\n", "{\"local\":{\"type\":\"datetime-local\",\"value\":\"1987-07-05T17:45:00\"},\"milli\":{\"type\":\"datetime-local\",\"value\":\"1977-12-21T10:32:00.555\"},\"space\":{\"type\":\"datetime-local\",\"value\":\"1987-07-05T17:45:00\"}}")
}

///|
test "valid__datetime__local_date" {
  assert_toml_valid("valid/datetime/local-date.toml", "bestdayever = 1987-07-05\n", "{\"bestdayever\":{\"type\":\"date-local\",\"value\":\"1987-07-05\"}}")
}

///|
test "valid__datetime__local_time" {
  assert_toml_valid("valid/datetime/local-time.toml", "besttimeever = 17:45:00\nmilliseconds = 10:32:00.555\n", "{\"besttimeever\":{\"type\":\"time-local\",\"value\":\"17:45:00\"},\"milliseconds\":{\"type\":\"time-local\",\"value\":\"10:32:00.555\"}}")
}

///|
test "valid__datetime__milliseconds" {
  assert_toml_valid("valid/datetime/milliseconds.toml", "utc1  = 1987-07-05T17:45:56.123Z\nutc2  = 1987-07-05T17:45:56.6Z\nwita1 = 1987-07-05T17:45:56.123+08:00\nwita2 = 1987-07-05T17:45:56.6+08:00\n", "{\"utc1\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56.123Z\"},\"utc2\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56.600Z\"},\"wita1\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56.123+08:00\"},\"wita2\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56.600+08:00\"}}")
}

///|
test "valid__datetime__timezone" {
  assert_toml_valid("valid/datetime/timezone.toml", "utc  = 1987-07-05T17:45:56Z\npdt  = 1987-07-05T17:45:56-05:00\nnzst = 1987-07-05T17:45:56+12:00\nnzdt = 1987-07-05T17:45:56+13:00  # DST\n", "{\"nzdt\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56+13:00\"},\"nzst\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56+12:00\"},\"pdt\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56-05:00\"},\"utc\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56Z\"}}")
}

///|
test "valid__empty_crlf" {
  assert_toml_valid("valid/empty-crlf.toml", "\r\n", "{}")
}

///|
test "valid__empty_lf" {
  assert_toml_valid("valid/empty-lf.toml", "\n", "{}")
}

///|
test "valid__empty_nothing" {
  assert_toml_valid("valid/empty-nothing.toml", "", "{}")
}

///|
test "valid__empty_space" {
  assert_toml_valid("valid/empty-space.toml", " ", "{}")
}

///|
test "valid__empty_tab" {
  assert_toml_valid("valid/empty-tab.toml", "\t", "{}")
}

///|
test "valid__example" {
  assert_toml_valid("valid/example.toml", "best-day-ever = 1987-07-05T17:45:00Z\n\n[numtheory]\nboring = false\nperfection = [6, 28, 496]\n", "{\"best-day-ever\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:00Z\"},\"numtheory\":{\"boring\":{\"type\":\"bool\",\"value\":\"false\"},\"perfection\":[{\"type\":\"integer\",\"value\":\"6\"},{\"type\":\"integer\",\"value\":\"28\"},{\"type\":\"integer\",\"value\":\"496\"}]}}")
}

///|
test "valid__float__exponent" {
  assert_toml_valid("valid/float/exponent.toml", "# Please keep exponent-upper.toml in sync with this.\n\nexp       = 3e2\npos-exp   = 3e+2\nneg-exp   = 3e-2\nzero-exp  = 3e0\nfrac      = 3.1e2\nneg       = -1e-1\nzero      = 0e2\nzero-plus = +0e2\n", "{\"exp\":{\"type\":\"float\",\"value\":\"300\"},\"frac\":{\"type\":\"float\",\"value\":\"310\"},\"neg\":{\"type\":\"float\",\"value\":\"-0.1\"},\"neg-exp\":{\"type\":\"float\",\"value\":\"0.03\"},\"pos-exp\":{\"type\":\"float\",\"value\":\"300\"},\"zero\":{\"type\":\"float\",\"value\":\"0\"},\"zero-exp\":{\"type\":\"float\",\"value\":\"3\"},\"zero-plus\":{\"type\":\"float\",\"value\":\"0\"}}")
}

///|
test "valid__float__exponent_upper" {
  assert_toml_valid("valid/float/exponent-upper.toml", "# Both upper- and lower-case \"e\" is valid, so repeat the exponent.toml test with\n# upper-case.\nexp        = 3E2\npos-exp    = 3E+2\nneg-exp    = 3E-2\nzero-exp   = 3E0\nfrac       = 3.1E2\nneg        = -1E-1\nzero       = 0E2\nzero-plus = +0E2\n", "{\"exp\":{\"type\":\"float\",\"value\":\"300\"},\"frac\":{\"type\":\"float\",\"value\":\"310\"},\"neg\":{\"type\":\"float\",\"value\":\"-0.1\"},\"neg-exp\":{\"type\":\"float\",\"value\":\"0.03\"},\"pos-exp\":{\"type\":\"float\",\"value\":\"300\"},\"zero\":{\"type\":\"float\",\"value\":\"0\"},\"zero-exp\":{\"type\":\"float\",\"value\":\"3\"},\"zero-plus\":{\"type\":\"float\",\"value\":\"0\"}}")
}

///|
test "valid__float__float" {
  assert_toml_valid("valid/float/float.toml", "pi = 3.14\npospi = +3.14\nnegpi = -3.14\nzero-intpart = 0.123\nleading-zero-fractional = 0.0123\n", "{\"negpi\":{\"type\":\"float\",\"value\":\"-3.14\"},\"pi\":{\"type\":\"float\",\"value\":\"3.14\"},\"pospi\":{\"type\":\"float\",\"value\":\"3.14\"},\"zero-intpart\":{\"type\":\"float\",\"value\":\"0.123\"},\"leading-zero-fractional\":{\"type\":\"float\",\"value\":\"0.0123\"}}")
}

///|
test "valid__float__inf_and_nan" {
  assert_toml_valid("valid/float/inf-and-nan.toml", "# We don't encode +nan and -nan back with the signs; many languages don't\n# support a sign on NaN (it doesn't really make much sense).\nnan = nan\nnan_neg = -nan\nnan_plus = +nan\ninfinity = inf\ninfinity_neg = -inf\ninfinity_plus = +inf\n", "{\"infinity\":{\"type\":\"float\",\"value\":\"inf\"},\"infinity_neg\":{\"type\":\"float\",\"value\":\"-inf\"},\"infinity_plus\":{\"type\":\"float\",\"value\":\"inf\"},\"nan\":{\"type\":\"float\",\"value\":\"nan\"},\"nan_neg\":{\"type\":\"float\",\"value\":\"nan\"},\"nan_plus\":{\"type\":\"float\",\"value\":\"nan\"}}")
}

///|
test "valid__float__long" {
  assert_toml_valid("valid/float/long.toml", "longpi = 3.141592653589793\nneglongpi = -3.141592653589793\n", "{\"longpi\":{\"type\":\"float\",\"value\":\"3.141592653589793\"},\"neglongpi\":{\"type\":\"float\",\"value\":\"-3.141592653589793\"}}")
}

///|
test "valid__float__max_int" {
  assert_toml_valid("valid/float/max-int.toml", "# Maximum and minimum safe natural numbers.\nmax_float =  9_007_199_254_740_991.0\nmin_float = -9_007_199_254_740_991.0\n", "{\"max_float\":{\"type\":\"float\",\"value\":\"9007199254740991\"},\"min_float\":{\"type\":\"float\",\"value\":\"-9007199254740991\"}}")
}

///|
test "valid__float__underscore" {
  assert_toml_valid("valid/float/underscore.toml", "before = 3_141.5927\nafter = 3141.592_7\nexponent = 3e1_4\n", "{\"after\":{\"type\":\"float\",\"value\":\"3141.5927\"},\"before\":{\"type\":\"float\",\"value\":\"3141.5927\"},\"exponent\":{\"type\":\"float\",\"value\":\"3.0e14\"}}")
}

///|
test "valid__float__zero" {
  assert_toml_valid("valid/float/zero.toml", "zero = 0.0\nsigned-pos = +0.0\nsigned-neg = -0.0\nexponent = 0e0\nexponent-two-0 = 0e00\nexponent-signed-pos = +0e0\nexponent-signed-neg = -0e0\n", "{\"exponent\":{\"type\":\"float\",\"value\":\"0\"},\"exponent-signed-neg\":{\"type\":\"float\",\"value\":\"-0\"},\"exponent-signed-pos\":{\"type\":\"float\",\"value\":\"0\"},\"exponent-two-0\":{\"type\":\"float\",\"value\":\"0\"},\"signed-neg\":{\"type\":\"float\",\"value\":\"-0\"},\"signed-pos\":{\"type\":\"float\",\"value\":\"0\"},\"zero\":{\"type\":\"float\",\"value\":\"0\"}}")
}

///|
test "valid__implicit_and_explicit_after" {
  assert_toml_valid("valid/implicit-and-explicit-after.toml", "[a.b.c]\nanswer = 42\n\n[a]\nbetter = 43\n", "{\"a\":{\"better\":{\"type\":\"integer\",\"value\":\"43\"},\"b\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}")
}

///|
test "valid__implicit_and_explicit_before" {
  assert_toml_valid("valid/implicit-and-explicit-before.toml", "[a]\nbetter = 43\n\n[a.b.c]\nanswer = 42\n", "{\"a\":{\"better\":{\"type\":\"integer\",\"value\":\"43\"},\"b\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}")
}

///|
test "valid__implicit_groups" {
  assert_toml_valid("valid/implicit-groups.toml", "[a.b.c]\nanswer = 42\n", "{\"a\":{\"b\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}")
}

///|
test "valid__inline_table__array_01" {
  assert_toml_valid("valid/inline-table/array-01.toml", "arr = [ {'a'= 1}, {'a'= 2} ]\n\npeople = [{first_name = \"Bruce\", last_name = \"Springsteen\"},\n          {first_name = \"Eric\", last_name = \"Clapton\"},\n          {first_name = \"Bob\", last_name = \"Seger\"}]\n", "{\"arr\":[{\"a\":{\"type\":\"integer\",\"value\":\"1\"}},{\"a\":{\"type\":\"integer\",\"value\":\"2\"}}],\"people\":[{\"first_name\":{\"type\":\"string\",\"value\":\"Bruce\"},\"last_name\":{\"type\":\"string\",\"value\":\"Springsteen\"}},{\"first_name\":{\"type\":\"string\",\"value\":\"Eric\"},\"last_name\":{\"type\":\"string\",\"value\":\"Clapton\"}},{\"first_name\":{\"type\":\"string\",\"value\":\"Bob\"},\"last_name\":{\"type\":\"string\",\"value\":\"Seger\"}}]}")
}

///|
test "valid__inline_table__array_02" {
  assert_toml_valid("valid/inline-table/array-02.toml", "# \"No newlines are allowed between the curly braces unless they are valid within\n# a value\"\n\na = { a = [\n]}\n", "{\"a\":{\"a\":[]}}")
}

///|
test "valid__inline_table__array_03" {
  assert_toml_valid("valid/inline-table/array-03.toml", "b = { a = [\n\t\t1,\n\t\t2,\n\t], b = [\n\t\t3,\n\t\t4,\n\t]}\n", "{\"b\":{\"a\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}],\"b\":[{\"type\":\"integer\",\"value\":\"3\"},{\"type\":\"integer\",\"value\":\"4\"}]}}")
}

///|
test "valid__inline_table__bool" {
  assert_toml_valid("valid/inline-table/bool.toml", "a = {a = true, b = false}\n", "{\"a\":{\"a\":{\"type\":\"bool\",\"value\":\"true\"},\"b\":{\"type\":\"bool\",\"value\":\"false\"}}}")
}

///|
test "valid__inline_table__empty" {
  assert_toml_valid("valid/inline-table/empty.toml", "empty1 = {}\nempty2 = { }\nempty_in_array = [ { not_empty = 1 }, {} ]\nempty_in_array2 = [{},{not_empty=1}]\nmany_empty = [{},{},{}]\nnested_empty = {\"empty\"={}}\nwith_cmt ={            }#nothing here\n", "{\"empty1\":{},\"empty2\":{},\"with_cmt\":{},\"empty_in_array\":[{\"not_empty\":{\"type\":\"integer\",\"value\":\"1\"}},{}],\"empty_in_array2\":[{},{\"not_empty\":{\"type\":\"integer\",\"value\":\"1\"}}],\"many_empty\":[{},{},{}],\"nested_empty\":{\"empty\":{}}}")
}

///|
test "valid__inline_table__end_in_bool" {
  assert_toml_valid("valid/inline-table/end-in-bool.toml", "black = { python=\">3.6\", version=\">=18.9b0\", allow_prereleases=true }\n", "{\"black\":{\"allow_prereleases\":{\"type\":\"bool\",\"value\":\"true\"},\"python\":{\"type\":\"string\",\"value\":\">3.6\"},\"version\":{\"type\":\"string\",\"value\":\">=18.9b0\"}}}")
}

///|
test "valid__inline_table__inline_table" {
  assert_toml_valid("valid/inline-table/inline-table.toml", "name        = { first = \"Tom\", last = \"Preston-Werner\" }\npoint       = { x = 1, y = 2 }\nsimple      = { a = 1 }\nstr-key     = { \"a\" = 1 }\ntable-array = [{ \"a\" = 1 }, { \"b\" = 2 }]\n", "{\"name\":{\"first\":{\"type\":\"string\",\"value\":\"Tom\"},\"last\":{\"type\":\"string\",\"value\":\"Preston-Werner\"}},\"point\":{\"x\":{\"type\":\"integer\",\"value\":\"1\"},\"y\":{\"type\":\"integer\",\"value\":\"2\"}},\"simple\":{\"a\":{\"type\":\"integer\",\"value\":\"1\"}},\"str-key\":{\"a\":{\"type\":\"integer\",\"value\":\"1\"}},\"table-array\":[{\"a\":{\"type\":\"integer\",\"value\":\"1\"}},{\"b\":{\"type\":\"integer\",\"value\":\"2\"}}]}")
}

///|
test "valid__inline_table__key_dotted_01" {
  assert_toml_valid("valid/inline-table/key-dotted-01.toml", "a = {   a.b  =  1   }\nb = {   \"a\".\"b\"  =  1   }\nc = {   a   .   b  =  1   }\nd = {   'a'   .   \"b\"  =  1   }\ne = {a.b=1}\n", "{\"a\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"b\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"c\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"d\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"e\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}}}")
}

///|
test "valid__inline_table__key_dotted_02" {
  assert_toml_valid("valid/inline-table/key-dotted-02.toml", "many.dots.here.dot.dot.dot = {a.b.c = 1, a.b.d = 2}\n", "{\"many\":{\"dots\":{\"here\":{\"dot\":{\"dot\":{\"dot\":{\"a\":{\"b\":{\"c\":{\"type\":\"integer\",\"value\":\"1\"},\"d\":{\"type\":\"integer\",\"value\":\"2\"}}}}}}}}}}")
}

///|
test "valid__inline_table__key_dotted_03" {
  assert_toml_valid("valid/inline-table/key-dotted-03.toml", "[tbl]\na.b.c = {d.e=1}\n\n[tbl.x]\na.b.c = {d.e=1}\n", "{\"tbl\":{\"a\":{\"b\":{\"c\":{\"d\":{\"e\":{\"type\":\"integer\",\"value\":\"1\"}}}}},\"x\":{\"a\":{\"b\":{\"c\":{\"d\":{\"e\":{\"type\":\"integer\",\"value\":\"1\"}}}}}}}}")
}

///|
test "valid__inline_table__key_dotted_04" {
  assert_toml_valid("valid/inline-table/key-dotted-04.toml", "[[arr]]\nt = {a.b=1}\nT = {a.b=1}\n\n[[arr]]\nt = {a.b=2}\nT = {a.b=2}\n", "{\"arr\":[{\"T\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"t\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}}},{\"T\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"2\"}}},\"t\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"2\"}}}}]}")
}

///|
test "valid__inline_table__key_dotted_05" {
  assert_toml_valid("valid/inline-table/key-dotted-05.toml", "arr-1 = [{a.b = 1}]\narr-2 = [\"str\", {a.b = 1}]\n\narr-3 = [{a.b = 1}, {a.b = 2}]\narr-4 = [\"str\", {a.b = 1}, {a.b = 2}]\n", "{\"arr-1\":[{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}}],\"arr-2\":[{\"type\":\"string\",\"value\":\"str\"},{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}}],\"arr-3\":[{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"2\"}}}],\"arr-4\":[{\"type\":\"string\",\"value\":\"str\"},{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"2\"}}}]}")
}

///|
test "valid__inline_table__key_dotted_06" {
  assert_toml_valid("valid/inline-table/key-dotted-06.toml", "top.dot.dot = [\n\t{dot.dot.dot = 1},\n\t{dot.dot.dot = 2},\n]\n", "{\"top\":{\"dot\":{\"dot\":[{\"dot\":{\"dot\":{\"dot\":{\"type\":\"integer\",\"value\":\"1\"}}}},{\"dot\":{\"dot\":{\"dot\":{\"type\":\"integer\",\"value\":\"2\"}}}}]}}}")
}

///|
test "valid__inline_table__key_dotted_07" {
  assert_toml_valid("valid/inline-table/key-dotted-07.toml", "arr = [\n\t{a.b = [{c.d = 1}]}\n]\n", "{\"arr\":[{\"a\":{\"b\":[{\"c\":{\"d\":{\"type\":\"integer\",\"value\":\"1\"}}}]}}]}")
}

///|
test "valid__inline_table__multiline" {
  assert_toml_valid("valid/inline-table/multiline.toml", "tbl_multiline = { a = 1, b = \"\"\"\nmultiline\n\"\"\", c = \"\"\"and yet\nanother line\"\"\", d = 4 }\n", "{\"tbl_multiline\":{\"a\":{\"type\":\"integer\",\"value\":\"1\"},\"b\":{\"type\":\"string\",\"value\":\"multiline\\n\"},\"c\":{\"type\":\"string\",\"value\":\"and yet\\nanother line\"},\"d\":{\"type\":\"integer\",\"value\":\"4\"}}}")
}

///|
test "valid__inline_table__nest" {
  assert_toml_valid("valid/inline-table/nest.toml", "tbl_tbl_empty = { tbl_0 = {} }\ntbl_tbl_val   = { tbl_1 = { one = 1 } }\ntbl_arr_tbl   = { arr_tbl = [ { one = 1 } ] }\narr_tbl_tbl   = [ { tbl = { one = 1 } } ]\n\n# Array-of-array-of-table is interesting because it can only\n# be represented in inline form.\narr_arr_tbl_empty = [ [ {} ] ]\narr_arr_tbl_val = [ [ { one = 1 } ] ]\narr_arr_tbls  = [ [ { one = 1 }, { two = 2 } ] ]\n", "{\"arr_arr_tbl_empty\":[[{}]],\"arr_arr_tbl_val\":[[{\"one\":{\"type\":\"integer\",\"value\":\"1\"}}]],\"arr_arr_tbls\":[[{\"one\":{\"type\":\"integer\",\"value\":\"1\"}},{\"two\":{\"type\":\"integer\",\"value\":\"2\"}}]],\"arr_tbl_tbl\":[{\"tbl\":{\"one\":{\"type\":\"integer\",\"value\":\"1\"}}}],\"tbl_arr_tbl\":{\"arr_tbl\":[{\"one\":{\"type\":\"integer\",\"value\":\"1\"}}]},\"tbl_tbl_empty\":{\"tbl_0\":{}},\"tbl_tbl_val\":{\"tbl_1\":{\"one\":{\"type\":\"integer\",\"value\":\"1\"}}}}")
}

///|
test "valid__inline_table__spaces" {
  assert_toml_valid("valid/inline-table/spaces.toml", "# https://github.com/toml-lang/toml-test/issues/146\nclap-1 = { version = \"4\"  , features = [\"derive\", \"cargo\"] }\n\n# Contains some literal tabs!\nclap-2 = { version = \"4\"\t   \t,\t  \tfeatures = [   \"derive\" \t  ,  \t  \"cargo\"   ]   , nest   =   {  \t  \"a\"   =   'x'  , \t  'b'   = [ 1.5    ,   9.0  ]  }  }\n", "{\"clap-1\":{\"version\":{\"type\":\"string\",\"value\":\"4\"},\"features\":[{\"type\":\"string\",\"value\":\"derive\"},{\"type\":\"string\",\"value\":\"cargo\"}]},\"clap-2\":{\"version\":{\"type\":\"string\",\"value\":\"4\"},\"features\":[{\"type\":\"string\",\"value\":\"derive\"},{\"type\":\"string\",\"value\":\"cargo\"}],\"nest\":{\"a\":{\"type\":\"string\",\"value\":\"x\"},\"b\":[{\"type\":\"float\",\"value\":\"1.5\"},{\"type\":\"float\",\"value\":\"9\"}]}}}")
}

///|
test "valid__integer__float64_max" {
  assert_toml_valid("valid/integer/float64-max.toml", "# Maximum and minimum safe float64 natural numbers. Mainly here for\n# -int-as-float.\nmax_int =  9_007_199_254_740_991\nmin_int = -9_007_199_254_740_991\n", "{\"max_int\":{\"type\":\"integer\",\"value\":\"9007199254740991\"},\"min_int\":{\"type\":\"integer\",\"value\":\"-9007199254740991\"}}")
}

///|
test "valid__integer__integer" {
  assert_toml_valid("valid/integer/integer.toml", "answer = 42\nposanswer = +42\nneganswer = -42\nzero = 0\n", "{\"answer\":{\"type\":\"integer\",\"value\":\"42\"},\"neganswer\":{\"type\":\"integer\",\"value\":\"-42\"},\"posanswer\":{\"type\":\"integer\",\"value\":\"42\"},\"zero\":{\"type\":\"integer\",\"value\":\"0\"}}")
}

///|
test "valid__integer__literals" {
  assert_toml_valid("valid/integer/literals.toml", "bin1 = 0b11010110\nbin2 = 0b1_0_1\n\noct1 = 0o01234567\noct2 = 0o755\noct3 = 0o7_6_5\n\nhex1 = 0xDEADBEEF\nhex2 = 0xdeadbeef\nhex3 = 0xdead_beef\nhex4 = 0x00987\n", "{\"bin1\":{\"type\":\"integer\",\"value\":\"214\"},\"bin2\":{\"type\":\"integer\",\"value\":\"5\"},\"hex1\":{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex2\":{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex3\":{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex4\":{\"type\":\"integer\",\"value\":\"2439\"},\"oct1\":{\"type\":\"integer\",\"value\":\"342391\"},\"oct2\":{\"type\":\"integer\",\"value\":\"493\"},\"oct3\":{\"type\":\"integer\",\"value\":\"501\"}}")
}

///|
test "valid__integer__long" {
  assert_toml_valid("valid/integer/long.toml", "# int64 \"should\" be supported, but is not mandatory. It's fine to skip this\n# test.\nint64-max     = 9223372036854775807\nint64-max-neg = -9223372036854775808\n", "{\"int64-max\":{\"type\":\"integer\",\"value\":\"9223372036854775807\"},\"int64-max-neg\":{\"type\":\"integer\",\"value\":\"-9223372036854775808\"}}")
}

///|
test "valid__integer__underscore" {
  assert_toml_valid("valid/integer/underscore.toml", "kilo = 1_000\nx = 1_1_1_1\n", "{\"kilo\":{\"type\":\"integer\",\"value\":\"1000\"},\"x\":{\"type\":\"integer\",\"value\":\"1111\"}}")
}

///|
test "valid__integer__zero" {
  assert_toml_valid("valid/integer/zero.toml", "d1 = 0\nd2 = +0\nd3 = -0\n\nh1 = 0x0\nh2 = 0x00\nh3 = 0x00000\n\no1 = 0o0\na2 = 0o00\na3 = 0o00000\n\nb1 = 0b0\nb2 = 0b00\nb3 = 0b00000\n", "{\"a2\":{\"type\":\"integer\",\"value\":\"0\"},\"a3\":{\"type\":\"integer\",\"value\":\"0\"},\"b1\":{\"type\":\"integer\",\"value\":\"0\"},\"b2\":{\"type\":\"integer\",\"value\":\"0\"},\"b3\":{\"type\":\"integer\",\"value\":\"0\"},\"d1\":{\"type\":\"integer\",\"value\":\"0\"},\"d2\":{\"type\":\"integer\",\"value\":\"0\"},\"d3\":{\"type\":\"integer\",\"value\":\"0\"},\"h1\":{\"type\":\"integer\",\"value\":\"0\"},\"h2\":{\"type\":\"integer\",\"value\":\"0\"},\"h3\":{\"type\":\"integer\",\"value\":\"0\"},\"o1\":{\"type\":\"integer\",\"value\":\"0\"}}")
}

///|
test "valid__key__alphanum" {
  assert_toml_valid("valid/key/alphanum.toml", "alpha = \"a\"\n123 = \"num\"\n000111 = \"leading\"\n10e3 = \"false float\"\none1two2 = \"mixed\"\nwith-dash = \"dashed\"\nunder_score = \"___\"\n34-11 = 23\n\n[2018_10]\n001 = 1\n\n[a-a-a]\n_ = false\n", "{\"000111\":{\"type\":\"string\",\"value\":\"leading\"},\"10e3\":{\"type\":\"string\",\"value\":\"false float\"},\"123\":{\"type\":\"string\",\"value\":\"num\"},\"34-11\":{\"type\":\"integer\",\"value\":\"23\"},\"alpha\":{\"type\":\"string\",\"value\":\"a\"},\"one1two2\":{\"type\":\"string\",\"value\":\"mixed\"},\"under_score\":{\"type\":\"string\",\"value\":\"___\"},\"with-dash\":{\"type\":\"string\",\"value\":\"dashed\"},\"2018_10\":{\"001\":{\"type\":\"integer\",\"value\":\"1\"}},\"a-a-a\":{\"_\":{\"type\":\"bool\",\"value\":\"false\"}}}")
}

///|
test "valid__key__case_sensitive" {
  assert_toml_valid("valid/key/case-sensitive.toml", "sectioN = \"NN\"\n\n[section]\nname = \"lower\"\nNAME = \"upper\"\nName = \"capitalized\"\n\n[Section]\nname = \"different section!!\"\n\"μ\" = \"greek small letter mu\"\n\"Μ\" = \"greek capital letter MU\"\nM = \"latin letter M\"\n\n", "{\"sectioN\":{\"type\":\"string\",\"value\":\"NN\"},\"Section\":{\"M\":{\"type\":\"string\",\"value\":\"latin letter M\"},\"name\":{\"type\":\"string\",\"value\":\"different section!!\"},\"Μ\":{\"type\":\"string\",\"value\":\"greek capital letter MU\"},\"μ\":{\"type\":\"string\",\"value\":\"greek small letter mu\"}},\"section\":{\"NAME\":{\"type\":\"string\",\"value\":\"upper\"},\"Name\":{\"type\":\"string\",\"value\":\"capitalized\"},\"name\":{\"type\":\"string\",\"value\":\"lower\"}}}")
}

///|
test "valid__key__dotted_01" {
  assert_toml_valid("valid/key/dotted-01.toml", "name.first = \"Arthur\"\n\"name\".'last' = \"Dent\"\n\nmany.dots.dot.dot.dot = 42\n", "{\"many\":{\"dots\":{\"dot\":{\"dot\":{\"dot\":{\"type\":\"integer\",\"value\":\"42\"}}}}},\"name\":{\"first\":{\"type\":\"string\",\"value\":\"Arthur\"},\"last\":{\"type\":\"string\",\"value\":\"Dent\"}}}")
}

///|
test "valid__key__dotted_02" {
  assert_toml_valid("valid/key/dotted-02.toml", "# Note: this file contains literal tab characters.\n\n# Space are ignored, and key parts can be quoted.\ncount.a       = 1\ncount . b     = 2\n\"count\".\"c\"   = 3\n\"count\" . \"d\" = 4\n'count'.'e'   = 5\n'count' . 'f' = 6\n\"count\".'g'   = 7\n\"count\" . 'h' = 8\ncount.'i'     = 9\ncount \t.\t 'j'\t   = 10\n\"count\".k     = 11\n\"count\" . l   = 12\n", "{\"count\":{\"a\":{\"type\":\"integer\",\"value\":\"1\"},\"b\":{\"type\":\"integer\",\"value\":\"2\"},\"c\":{\"type\":\"integer\",\"value\":\"3\"},\"d\":{\"type\":\"integer\",\"value\":\"4\"},\"e\":{\"type\":\"integer\",\"value\":\"5\"},\"f\":{\"type\":\"integer\",\"value\":\"6\"},\"g\":{\"type\":\"integer\",\"value\":\"7\"},\"h\":{\"type\":\"integer\",\"value\":\"8\"},\"i\":{\"type\":\"integer\",\"value\":\"9\"},\"j\":{\"type\":\"integer\",\"value\":\"10\"},\"k\":{\"type\":\"integer\",\"value\":\"11\"},\"l\":{\"type\":\"integer\",\"value\":\"12\"}}}")
}

///|
test "valid__key__dotted_03" {
  assert_toml_valid("valid/key/dotted-03.toml", "top.key = 1\n\n[tbl]\na.b.c = 42.666\n\n[a.few.dots]\npolka.dot = \"again?\"\npolka.dance-with = \"Dot\"\n\n", "{\"a\":{\"few\":{\"dots\":{\"polka\":{\"dance-with\":{\"type\":\"string\",\"value\":\"Dot\"},\"dot\":{\"type\":\"string\",\"value\":\"again?\"}}}}},\"tbl\":{\"a\":{\"b\":{\"c\":{\"type\":\"float\",\"value\":\"42.666\"}}}},\"top\":{\"key\":{\"type\":\"integer\",\"value\":\"1\"}}}")
}

///|
test "valid__key__dotted_04" {
  assert_toml_valid("valid/key/dotted-04.toml", "top.key = 1\n\n[[arr]]\na.b.c=1\na.b.d=2\n\n[[arr]]\na.b.c=3\na.b.d=4\n\n", "{\"arr\":[{\"a\":{\"b\":{\"c\":{\"type\":\"integer\",\"value\":\"1\"},\"d\":{\"type\":\"integer\",\"value\":\"2\"}}}},{\"a\":{\"b\":{\"c\":{\"type\":\"integer\",\"value\":\"3\"},\"d\":{\"type\":\"integer\",\"value\":\"4\"}}}}],\"top\":{\"key\":{\"type\":\"integer\",\"value\":\"1\"}}}")
}

///|
test "valid__key__dotted_empty" {
  assert_toml_valid("valid/key/dotted-empty.toml", "''.x = \"empty.x\"\nx.\"\" = \"x.empty\"\n[a]\n\"\".'' = \"empty.empty\"\n", "{\"\":{\"x\":{\"type\":\"string\",\"value\":\"empty.x\"}},\"a\":{\"\":{\"\":{\"type\":\"string\",\"value\":\"empty.empty\"}}},\"x\":{\"\":{\"type\":\"string\",\"value\":\"x.empty\"}}}")
}

///|
test "valid__key__empty_01" {
  assert_toml_valid("valid/key/empty-01.toml", "\"\" = \"blank\"\n", "{\"\":{\"type\":\"string\",\"value\":\"blank\"}}")
}

///|
test "valid__key__empty_02" {
  assert_toml_valid("valid/key/empty-02.toml", "'' = \"blank\"\n", "{\"\":{\"type\":\"string\",\"value\":\"blank\"}}")
}

///|
test "valid__key__empty_03" {
  assert_toml_valid("valid/key/empty-03.toml", "''=0\n", "{\"\":{\"type\":\"integer\",\"value\":\"0\"}}")
}

///|
test "valid__key__empty_04" {
  assert_toml_valid("valid/key/empty-04.toml", "tbl-1     = {\"\" = 1}\ntbl-2     = {\"\" = {\"\" = 1}}\narr-tbl-1 = [{\"\" = 2}]\narr-tbl-2 = [[{\"\" = 2}]]\n", "{\"arr-tbl-1\":[{\"\":{\"type\":\"integer\",\"value\":\"2\"}}],\"arr-tbl-2\":[[{\"\":{\"type\":\"integer\",\"value\":\"2\"}}]],\"tbl-1\":{\"\":{\"type\":\"integer\",\"value\":\"1\"}},\"tbl-2\":{\"\":{\"\":{\"type\":\"integer\",\"value\":\"1\"}}}}")
}

///|
test "valid__key__equals_nospace" {
  assert_toml_valid("valid/key/equals-nospace.toml", "answer=42\n", "{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}")
}

///|
test "valid__key__escapes" {
  assert_toml_valid("valid/key/escapes.toml", "\"\\n\" = \"newline\"\n\"\\b\" = \"bell\"\n\"\\u00c0\" = \"latin capital letter A with grave\"\n\"\\\"\" = \"just a quote\"\n\n[\"backsp\\b\\b\"]\n\n[\"\\\"quoted\\\"\"]\nquote = true\n\n[\"a.b\".\"\\u00c0\"]\n", "{\"\\b\":{\"type\":\"string\",\"value\":\"bell\"},\"\\n\":{\"type\":\"string\",\"value\":\"newline\"},\"\\\"\":{\"type\":\"string\",\"value\":\"just a quote\"},\"backsp\\b\\b\":{},\"À\":{\"type\":\"string\",\"value\":\"latin capital letter A with grave\"},\"\\\"quoted\\\"\":{\"quote\":{\"type\":\"bool\",\"value\":\"true\"}},\"a.b\":{\"À\":{}}}")
}

///|
test "valid__key__like_date" {
  assert_toml_valid("valid/key/like-date.toml", "# '-' is a valid character in keys: make a key that looks like a date.\n2001-02-03   = 1\n\"2001-02-04\" = 2\n'2001-02-05' = 3\n\n# Also include datetime and time for good measure; these need to be quoted as\n# ':' isn't a valid bare key.\n\"2001-02-06T15:16:17+01:00\" = 4\n\"2001-02-07T15:16:17\"       = 5\n\"15:16:17\"                  = 6\n\n# Dotted keys\na.2001-02-08 = 7\na.2001-02-09.2001-02-10 = 8\n2001-02-11.a.2001-02-12 = 9\n\n# Table names\n[2002-01-02]\nk = 10\n\n[2002-01-02.2024-01-03]\nk = 11\n\n[[2002-01-04]]\nk = 12\n", "{\"15:16:17\":{\"type\":\"integer\",\"value\":\"6\"},\"2001-02-03\":{\"type\":\"integer\",\"value\":\"1\"},\"2001-02-04\":{\"type\":\"integer\",\"value\":\"2\"},\"2001-02-05\":{\"type\":\"integer\",\"value\":\"3\"},\"2001-02-06T15:16:17+01:00\":{\"type\":\"integer\",\"value\":\"4\"},\"2001-02-07T15:16:17\":{\"type\":\"integer\",\"value\":\"5\"},\"2002-01-04\":[{\"k\":{\"type\":\"integer\",\"value\":\"12\"}}],\"2001-02-11\":{\"a\":{\"2001-02-12\":{\"type\":\"integer\",\"value\":\"9\"}}},\"2002-01-02\":{\"k\":{\"type\":\"integer\",\"value\":\"10\"},\"2024-01-03\":{\"k\":{\"type\":\"integer\",\"value\":\"11\"}}},\"a\":{\"2001-02-08\":{\"type\":\"integer\",\"value\":\"7\"},\"2001-02-09\":{\"2001-02-10\":{\"type\":\"integer\",\"value\":\"8\"}}}}")
}

///|
test "valid__key__numeric_01" {
  assert_toml_valid("valid/key/numeric-01.toml", "1     = true\n", "{\"1\":{\"type\":\"bool\",\"value\":\"true\"}}")
}

///|
test "valid__key__numeric_02" {
  assert_toml_valid("valid/key/numeric-02.toml", "1.2   = true\n", "{\"1\":{\"2\":{\"type\":\"bool\",\"value\":\"true\"}}}")
}

///|
test "valid__key__numeric_03" {
  assert_toml_valid("valid/key/numeric-03.toml", "0123  = true\n", "{\"0123\":{\"type\":\"bool\",\"value\":\"true\"}}")
}

///|
test "valid__key__numeric_04" {
  assert_toml_valid("valid/key/numeric-04.toml", "01.23 = true\n", "{\"01\":{\"23\":{\"type\":\"bool\",\"value\":\"true\"}}}")
}

///|
test "valid__key__numeric_05" {
  assert_toml_valid("valid/key/numeric-05.toml", "23.01 = true\n", "{\"23\":{\"01\":{\"type\":\"bool\",\"value\":\"true\"}}}")
}

///|
test "valid__key__numeric_06" {
  assert_toml_valid("valid/key/numeric-06.toml", "-1    = true\n", "{\"-1\":{\"type\":\"bool\",\"value\":\"true\"}}")
}

///|
test "valid__key__numeric_07" {
  assert_toml_valid("valid/key/numeric-07.toml", "-01   = true\n", "{\"-01\":{\"type\":\"bool\",\"value\":\"true\"}}")
}

///|
test "valid__key__numeric_08" {
  assert_toml_valid("valid/key/numeric-08.toml", "1  = 'one'\n01 = 'zero one'\n", "{\"01\":{\"type\":\"string\",\"value\":\"zero one\"},\"1\":{\"type\":\"string\",\"value\":\"one\"}}")
}

///|
test "valid__key__quoted_dots" {
  assert_toml_valid("valid/key/quoted-dots.toml", "plain = 1\n\"with.dot\" = 2\n\n[plain_table]\nplain = 3\n\"with.dot\" = 4\n\n[table.withdot]\nplain = 5\n\"key.with.dots\" = 6\n\"escaped\\u002edot\" = 7\n", "{\"plain\":{\"type\":\"integer\",\"value\":\"1\"},\"with.dot\":{\"type\":\"integer\",\"value\":\"2\"},\"plain_table\":{\"plain\":{\"type\":\"integer\",\"value\":\"3\"},\"with.dot\":{\"type\":\"integer\",\"value\":\"4\"}},\"table\":{\"withdot\":{\"escaped.dot\":{\"type\":\"integer\",\"value\":\"7\"},\"key.with.dots\":{\"type\":\"integer\",\"value\":\"6\"},\"plain\":{\"type\":\"integer\",\"value\":\"5\"}}}}")
}

///|
test "valid__key__quoted_unicode" {
  assert_toml_valid("valid/key/quoted-unicode.toml", "\n\"\\u0000\" = \"null\"\n'\\u0000' = \"different key\"\n\"\\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\" = \"escaped key\"\n\n\"~  ÿ ퟿  ￿ 𐀀 􏿿\" = \"basic key\"\n'l ~  ÿ ퟿  ￿ 𐀀 􏿿' = \"literal key\"\n", str_from_bytes([123, 34, 92, 117, 48, 48, 48, 48, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 110, 117, 108, 108, 34, 125, 44, 34, 92, 98, 32, 92, 102, 32, 65, 32, 127, 32, 194, 128, 32, 195, 191, 32, 237, 159, 191, 32, 238, 128, 128, 32, 239, 191, 191, 32, 240, 144, 128, 128, 32, 244, 143, 191, 191, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 101, 115, 99, 97, 112, 101, 100, 32, 107, 101, 121, 34, 125, 44, 34, 92, 92, 117, 48, 48, 48, 48, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 100, 105, 102, 102, 101, 114, 101, 110, 116, 32, 107, 101, 121, 34, 125, 44, 34, 108, 32, 126, 32, 194, 128, 32, 195, 191, 32, 237, 159, 191, 32, 238, 128, 128, 32, 239, 191, 191, 32, 240, 144, 128, 128, 32, 244, 143, 191, 191, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 108, 105, 116, 101, 114, 97, 108, 32, 107, 101, 121, 34, 125, 44, 34, 126, 32, 194, 128, 32, 195, 191, 32, 237, 159, 191, 32, 238, 128, 128, 32, 239, 191, 191, 32, 240, 144, 128, 128, 32, 244, 143, 191, 191, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 98, 97, 115, 105, 99, 32, 107, 101, 121, 34, 125, 125]))
}

///|
test "valid__key__space" {
  assert_toml_valid("valid/key/space.toml", "# Keep whitespace inside quotes keys at all positions.\n\"a b\"   = 1\n\" c d \" = 2\n\"  much \t\t  whitespace  \t\\n  \\r\\n  \" = 3\n\n[ \" tbl \" ]\n\"\\ttab\\ttab\\t\" = \"tab\"\n", "{\"  much \\t\\t  whitespace  \\t\\n  \\r\\n  \":{\"type\":\"integer\",\"value\":\"3\"},\" c d \":{\"type\":\"integer\",\"value\":\"2\"},\"a b\":{\"type\":\"integer\",\"value\":\"1\"},\" tbl \":{\"\\ttab\\ttab\\t\":{\"type\":\"string\",\"value\":\"tab\"}}}")
}

///|
test "valid__key__special_chars" {
  assert_toml_valid("valid/key/special-chars.toml", "\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\" = 1\n", "{\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\":{\"type\":\"integer\",\"value\":\"1\"}}")
}
