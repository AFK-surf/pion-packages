///| Steady-state TOML v1.0.0 parsing benchmark (Pion Native).

import "toml"

struct Stats {
  mut tables : Int64
  mut arrays : Int64
  mut keys : Int64
  mut strings : Int64
  mut ints : Int64
  mut floats : Int64
  mut bools : Int64
  mut bool_true : Int64
  mut datetimes : Int64
  mut str_bytes : Int64
  mut int_sum : Int64
  mut key_hash : Int64
  mut str_hash : Int64
}

fn poly_hash(s : String) -> Int64 {
  let mut h : Int64 = 17L
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h * 131L + s.code_unit_at(i).to_int64()) % 1000000007L
    i = i + 1
  }
  h
}

fn walk_val(st : Stats, v : toml::TomlValue) -> Unit {
  match v {
    toml::TomlValue::Str(s) => {
      st.strings = st.strings + 1L
      st.str_bytes = st.str_bytes + s.length().to_int64()
      st.str_hash = (st.str_hash + poly_hash(s)) % 1000000007L
    }
    toml::TomlValue::Int(x) => {
      st.ints = st.ints + 1L
      let m = ((x % 1000000007L) + 1000000007L) % 1000000007L
      st.int_sum = (st.int_sum + m) % 1000000007L
    }
    toml::TomlValue::Float(_) => {
      st.floats = st.floats + 1L
    }
    toml::TomlValue::Bool(b) => {
      st.bools = st.bools + 1L
      if b {
        st.bool_true = st.bool_true + 1L
      }
    }
    toml::TomlValue::OffsetDateTime(_) => {
      st.datetimes = st.datetimes + 1L
    }
    toml::TomlValue::LocalDateTime(_) => {
      st.datetimes = st.datetimes + 1L
    }
    toml::TomlValue::LocalDate(_) => {
      st.datetimes = st.datetimes + 1L
    }
    toml::TomlValue::LocalTime(_) => {
      st.datetimes = st.datetimes + 1L
    }
    toml::TomlValue::Array(items) => {
      st.arrays = st.arrays + 1L
      let n = items.length()
      let mut i = 0
      while i < n {
        walk_val(st, items[i])
        i = i + 1
      }
    }
    toml::TomlValue::Table(entries) => {
      st.tables = st.tables + 1L
      let n = entries.length()
      st.keys = st.keys + n.to_int64()
      let mut i = 0
      while i < n {
        let (k, child) = entries[i]
        st.key_hash = (st.key_hash + poly_hash(k)) % 1000000007L
        walk_val(st, child)
        i = i + 1
      }
    }
  }
}

fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 { args[1] } else { "/tmp/pion-toml-bench/corpus.toml" }
  let iters = if args.length() > 2 { parse_pos_int(args[2]) } else { 40 }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let st = Stats::{
    tables: 0L,
    arrays: 0L,
    keys: 0L,
    strings: 0L,
    ints: 0L,
    floats: 0L,
    bools: 0L,
    bool_true: 0L,
    datetimes: 0L,
    str_bytes: 0L,
    int_sum: 0L,
    key_hash: 0L,
    str_hash: 0L,
  }
  let mut iter = 0
  while iter < iters {
    let parsed = match toml::parse(content) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "parse error: " + e.message)
        return 1
      }
    }
    walk_val(st, parsed)
    iter = iter + 1
  }
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "tables=" + st.tables.to_string())
  io_println(world, "arrays=" + st.arrays.to_string())
  io_println(world, "keys=" + st.keys.to_string())
  io_println(world, "strings=" + st.strings.to_string())
  io_println(world, "ints=" + st.ints.to_string())
  io_println(world, "floats=" + st.floats.to_string())
  io_println(world, "bools=" + st.bools.to_string())
  io_println(world, "bool_true=" + st.bool_true.to_string())
  io_println(world, "datetimes=" + st.datetimes.to_string())
  io_println(world, "str_bytes=" + st.str_bytes.to_string())
  io_println(world, "int_sum=" + st.int_sum.to_string())
  io_println(world, "key_hash=" + st.key_hash.to_string())
  io_println(world, "str_hash=" + st.str_hash.to_string())
  0
}
