///| Test harness for the official `toml-test` v1.0.0 compliance suite.
///| Implements a self-contained JSON parser and `toml-test` semantic deep-equality
///| comparator matching `toml-lang/toml-test/json.go`.

enum JsonVal {
  JNull
  JBool(Bool)
  JStr(String)
  JArr(Array[JsonVal])
  JObj(Array[(String, JsonVal)])
}

fn j_skip_ws(s : String, pos : Int) -> Int {
  let n = s.length()
  let mut i = pos
  while i < n {
    let b = s.code_unit_at(i)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      i = i + 1
    } else {
      break
    }
  }
  i
}

fn j_hex_digit(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn j_write_utf8(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn j_parse_u4(s : String, pos : Int) -> Option[Int] {
  if pos + 4 > s.length() {
    return None
  }
  let d0 = j_hex_digit(s.code_unit_at(pos))
  let d1 = j_hex_digit(s.code_unit_at(pos + 1))
  let d2 = j_hex_digit(s.code_unit_at(pos + 2))
  let d3 = j_hex_digit(s.code_unit_at(pos + 3))
  if d0 < 0 || d1 < 0 || d2 < 0 || d3 < 0 {
    return None
  }
  Some((d0 << 12) | (d1 << 8) | (d2 << 4) | d3)
}

fn j_parse_str(s : String, start : Int) -> Result[(String, Int), String] {
  let n = s.length()
  if start >= n || s.code_unit_at(start) != 34 {
    return Err("expected '\"'")
  }
  let sb = StringBuilder::new()
  let mut i = start + 1
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      return Ok((sb.to_string(), i + 1))
    }
    if b == 92 {
      i = i + 1
      if i >= n {
        return Err("unterminated escape")
      }
      let e = s.code_unit_at(i)
      if e == 34 {
        sb.write_byte((34).to_byte())
        i = i + 1
      } else if e == 92 {
        sb.write_byte((92).to_byte())
        i = i + 1
      } else if e == 47 {
        sb.write_byte((47).to_byte())
        i = i + 1
      } else if e == 98 {
        sb.write_byte((8).to_byte())
        i = i + 1
      } else if e == 102 {
        sb.write_byte((12).to_byte())
        i = i + 1
      } else if e == 110 {
        sb.write_byte((10).to_byte())
        i = i + 1
      } else if e == 114 {
        sb.write_byte((13).to_byte())
        i = i + 1
      } else if e == 116 {
        sb.write_byte((9).to_byte())
        i = i + 1
      } else if e == 117 {
        let cp = match j_parse_u4(s, i + 1) {
          Some(v) => v
          None => return Err("bad \\u escape")
        }
        i = i + 5
        if cp >= 0xD800 && cp <= 0xDBFF {
          if i + 6 <= n && s.code_unit_at(i) == 92 && s.code_unit_at(i + 1) == 117 {
            let lo = match j_parse_u4(s, i + 2) {
              Some(v) => v
              None => return Err("bad low surrogate")
            }
            if lo >= 0xDC00 && lo <= 0xDFFF {
              let full = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
              j_write_utf8(sb, full)
              i = i + 6
            } else {
              j_write_utf8(sb, cp)
            }
          } else {
            j_write_utf8(sb, cp)
          }
        } else {
          j_write_utf8(sb, cp)
        }
      } else {
        return Err("unknown json escape")
      }
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Err("unterminated json string")
}

fn j_parse_val(s : String, start : Int) -> Result[(JsonVal, Int), String] {
  let i = j_skip_ws(s, start)
  let n = s.length()
  if i >= n {
    return Err("unexpected eof in json")
  }
  let b = s.code_unit_at(i)
  if b == 34 {
    match j_parse_str(s, i) {
      Ok((st, nxt)) => Ok((JsonVal::JStr(st), nxt))
      Err(e) => Err(e)
    }
  } else if b == 123 {
    let entries : Array[(String, JsonVal)] = []
    let mut p = j_skip_ws(s, i + 1)
    if p < n && s.code_unit_at(p) == 125 {
      return Ok((JsonVal::JObj(entries), p + 1))
    }
    while true {
      p = j_skip_ws(s, p)
      let (k, p2) = match j_parse_str(s, p) {
        Ok(pair) => pair
        Err(e) => return Err(e)
      }
      p = j_skip_ws(s, p2)
      if p >= n || s.code_unit_at(p) != 58 {
        return Err("expected ':' in json object")
      }
      let (v, p3) = match j_parse_val(s, p + 1) {
        Ok(pair) => pair
        Err(e) => return Err(e)
      }
      entries.push((k, v))
      p = j_skip_ws(s, p3)
      if p < n && s.code_unit_at(p) == 44 {
        p = p + 1
      } else if p < n && s.code_unit_at(p) == 125 {
        return Ok((JsonVal::JObj(entries), p + 1))
      } else {
        return Err("expected ',' or '}' in json object")
      }
    }
    Err("unreachable")
  } else if b == 91 {
    let items : Array[JsonVal] = []
    let mut p = j_skip_ws(s, i + 1)
    if p < n && s.code_unit_at(p) == 93 {
      return Ok((JsonVal::JArr(items), p + 1))
    }
    while true {
      let (v, p2) = match j_parse_val(s, p) {
        Ok(pair) => pair
        Err(e) => return Err(e)
      }
      items.push(v)
      p = j_skip_ws(s, p2)
      if p < n && s.code_unit_at(p) == 44 {
        p = p + 1
      } else if p < n && s.code_unit_at(p) == 93 {
        return Ok((JsonVal::JArr(items), p + 1))
      } else {
        return Err("expected ',' or ']' in json array")
      }
    }
    Err("unreachable")
  } else if b == 116 && i + 4 <= n && s.slice(i, i + 4) == "true" {
    Ok((JsonVal::JBool(true), i + 4))
  } else if b == 102 && i + 5 <= n && s.slice(i, i + 5) == "false" {
    Ok((JsonVal::JBool(false), i + 5))
  } else if b == 110 && i + 4 <= n && s.slice(i, i + 4) == "null" {
    Ok((JsonVal::JNull, i + 4))
  } else {
    Err("unexpected token in json")
  }
}

fn j_parse(s : String) -> Result[JsonVal, String] {
  match j_parse_val(s, 0) {
    Ok((v, pos)) => {
      let end = j_skip_ws(s, pos)
      if end != s.length() {
        Err("trailing bytes in json")
      } else {
        Ok(v)
      }
    }
    Err(e) => Err(e)
  }
}

fn j_obj_get(entries : Array[(String, JsonVal)], key : String) -> Option[JsonVal] {
  let mut i = 0
  while i < entries.length() {
    let (k, v) = entries[i]
    if k == key {
      return Some(v)
    }
    i = i + 1
  }
  None
}

fn j_as_tagged(entries : Array[(String, JsonVal)]) -> Option[(String, String)] {
  if entries.length() != 2 {
    return None
  }
  let t = match j_obj_get(entries, "type") {
    Some(JsonVal::JStr(s)) => s
    _ => return None
  }
  let v = match j_obj_get(entries, "value") {
    Some(JsonVal::JStr(s)) => s
    _ => return None
  }
  Some((t, v))
}

fn ascii_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn cmp_float_str(want : String, have : String) -> Bool {
  let wl = ascii_lower(want)
  let hl = ascii_lower(have)
  let w_nan = wl == "nan" || wl == "+nan" || wl == "-nan"
  let h_nan = hl == "nan" || hl == "+nan" || hl == "-nan"
  if w_nan || h_nan {
    return w_nan && h_nan
  }
  let w_pinf = wl == "inf" || wl == "+inf"
  let h_pinf = hl == "inf" || hl == "+inf"
  if w_pinf || h_pinf {
    return w_pinf && h_pinf
  }
  if wl == "-inf" || hl == "-inf" {
    return wl == "-inf" && hl == "-inf"
  }
  match (wl.to_double(), hl.to_double()) {
    (Some(wf), Some(hf)) => wf == hf
    _ => false
  }
}

fn is_leap_year_t(y : Int) -> Bool {
  (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)
}

fn days_in_month_t(y : Int, m : Int) -> Int {
  if m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12 {
    31
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else if m == 2 {
    if is_leap_year_t(y) { 29 } else { 28 }
  } else {
    0
  }
}

fn days_from_civil_t(y : Int, m : Int, d : Int) -> Int64 {
  let mut days : Int64 = 0L
  let mut yr = 0
  while yr < y {
    days = days + (if is_leap_year_t(yr) { 366L } else { 365L })
    yr = yr + 1
  }
  let mut mo = 1
  while mo < m {
    days = days + days_in_month_t(y, mo).to_int64()
    mo = mo + 1
  }
  days + (d - 1).to_int64()
}

fn parse_dec_n(s : String, pos : Int, count : Int) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < count {
    acc = acc * 10 + (s.code_unit_at(pos + i) - 48)
    i = i + 1
  }
  acc
}

fn parse_frac_nanos(s : String, pos : Int) -> (Int, Int) {
  let n = s.length()
  if pos >= n || s.code_unit_at(pos) != 46 {
    return (0, pos)
  }
  let mut i = pos + 1
  let mut nanos = 0
  let mut digits = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      if digits < 9 {
        nanos = nanos * 10 + (b - 48)
        digits = digits + 1
      }
      i = i + 1
    } else {
      break
    }
  }
  while digits < 9 {
    nanos = nanos * 10
    digits = digits + 1
  }
  (nanos, i)
}

fn parse_offset_dt_instant(s : String) -> Option[(Int64, Int)] {
  if s.length() < 20 {
    return None
  }
  let y = parse_dec_n(s, 0, 4)
  let mo = parse_dec_n(s, 5, 2)
  let d = parse_dec_n(s, 8, 2)
  let hh = parse_dec_n(s, 11, 2)
  let mm = parse_dec_n(s, 14, 2)
  let ss = parse_dec_n(s, 17, 2)
  let (nanos, p) = parse_frac_nanos(s, 19)
  let mut off_secs : Int64 = 0L
  if p < s.length() {
    let ob = s.code_unit_at(p)
    if ob == 90 || ob == 122 {
      off_secs = 0L
    } else if ob == 43 || ob == 45 {
      let oh = parse_dec_n(s, p + 1, 2)
      let om = parse_dec_n(s, p + 4, 2)
      let mag = (oh * 3600 + om * 60).to_int64()
      off_secs = if ob == 45 { -mag } else { mag }
    } else {
      return None
    }
  } else {
    return None
  }
  let total_secs = days_from_civil_t(y, mo, d) * 86400L +
  (hh * 3600 + mm * 60 + ss).to_int64() -
  off_secs
  Some((total_secs, nanos))
}

fn parse_local_dt_parts(s : String) -> Option[(Int64, Int)] {
  if s.length() < 19 {
    return None
  }
  let y = parse_dec_n(s, 0, 4)
  let mo = parse_dec_n(s, 5, 2)
  let d = parse_dec_n(s, 8, 2)
  let hh = parse_dec_n(s, 11, 2)
  let mm = parse_dec_n(s, 14, 2)
  let ss = parse_dec_n(s, 17, 2)
  let (nanos, _) = parse_frac_nanos(s, 19)
  let total_secs = days_from_civil_t(y, mo, d) * 86400L +
  (hh * 3600 + mm * 60 + ss).to_int64()
  Some((total_secs, nanos))
}

fn parse_local_time_parts(s : String) -> Option[(Int, Int)] {
  if s.length() < 8 {
    return None
  }
  let hh = parse_dec_n(s, 0, 2)
  let mm = parse_dec_n(s, 3, 2)
  let ss = parse_dec_n(s, 6, 2)
  let (nanos, _) = parse_frac_nanos(s, 8)
  Some((hh * 3600 + mm * 60 + ss, nanos))
}

fn cmp_dt_str(kind : String, want : String, have : String) -> Bool {
  if kind == "date-local" {
    return want == have
  } else if kind == "time-local" {
    match (parse_local_time_parts(want), parse_local_time_parts(have)) {
      (Some((ws, wn)), Some((hs, hn))) => ws == hs && wn == hn
      _ => false
    }
  } else if kind == "datetime-local" {
    match (parse_local_dt_parts(want), parse_local_dt_parts(have)) {
      (Some((ws, wn)), Some((hs, hn))) => ws == hs && wn == hn
      _ => false
    }
  } else if kind == "datetime" {
    match (parse_offset_dt_instant(want), parse_offset_dt_instant(have)) {
      (Some((ws, wn)), Some((hs, hn))) => ws == hs && wn == hn
      _ => false
    }
  } else {
    want == have
  }
}

fn cmp_json(want : JsonVal, have : JsonVal, path : String) -> Option[String] {
  match (want, have) {
    (JsonVal::JObj(w_entries), JsonVal::JObj(h_entries)) => {
      let wt = j_as_tagged(w_entries)
      let ht = j_as_tagged(h_entries)
      match (wt, ht) {
        (Some((wtype, wval)), Some((htype, hval))) => {
          if wtype != htype {
            return Some(path + ": type mismatch want=" + wtype + " have=" + htype)
          }
          if wtype == "float" {
            if !cmp_float_str(wval, hval) {
              return Some(path + ": float mismatch want=" + wval + " have=" + hval)
            }
          } else if wtype == "datetime" ||
          wtype == "datetime-local" ||
          wtype == "date-local" ||
          wtype == "time-local" {
            if !cmp_dt_str(wtype, wval, hval) {
              return Some(path + ": dt mismatch want=" + wval + " have=" + hval)
            }
          } else if wtype == "bool" {
            if ascii_lower(wval) != ascii_lower(hval) {
              return Some(path + ": bool mismatch want=" + wval + " have=" + hval)
            }
          } else {
            if wval != hval {
              return Some(path + ": val mismatch want=" + wval + " have=" + hval)
            }
          }
          None
        }
        (Some(_), None) => Some(path + ": want tagged value, got table")
        (None, Some(_)) => Some(path + ": want table, got tagged value")
        (None, None) => {
          if w_entries.length() != h_entries.length() {
            return Some(
              path +
              ": table key count mismatch want=" +
              w_entries.length().to_string() +
              " have=" +
              h_entries.length().to_string(),
            )
          }
          let mut i = 0
          while i < w_entries.length() {
            let (k, wv) = w_entries[i]
            match j_obj_get(h_entries, k) {
              Some(hv) => {
                let child = if path.length() == 0 { k } else { path + "." + k }
                match cmp_json(wv, hv, child) {
                  Some(err) => return Some(err)
                  None => ()
                }
              }
              None => return Some(path + ": missing key '" + k + "'")
            }
            i = i + 1
          }
          None
        }
        _ => Some(path + ": unexpected tagged comparison state")
      }
    }
    (JsonVal::JArr(wa), JsonVal::JArr(ha)) => {
      if wa.length() != ha.length() {
        return Some(
          path +
          ": array length mismatch want=" +
          wa.length().to_string() +
          " have=" +
          ha.length().to_string(),
        )
      }
      let mut i = 0
      while i < wa.length() {
        let child = path + "[" + i.to_string() + "]"
        match cmp_json(wa[i], ha[i], child) {
          Some(err) => return Some(err)
          None => ()
        }
        i = i + 1
      }
      None
    }
    _ => Some(path + ": json structure mismatch")
  }
}

fn str_from_bytes(bs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bs.length() {
    sb.write_byte(bs[i].to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn bytes_from_ints(bs : Array[Int]) -> Bytes {
  let n = bs.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = bs[i].to_byte()
    i = i + 1
  }
  out
}

fn assert_toml_valid(name : String, toml_src : String, expected_json : String) -> Unit {
  let parsed = match parse(toml_src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(
        false,
        "[" + name + "] expected Ok, got Err(" + e.line.to_string() + ":" + e.col.to_string() + "): " + e.message,
      )
      return
    }
  }
  let actual_json = to_toml_test_json(parsed)
  let want = match j_parse(expected_json) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[" + name + "] bad expected json: " + e)
      return
    }
  }
  let have = match j_parse(actual_json) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[" + name + "] bad actual json: " + e + " => " + actual_json)
      return
    }
  }
  match cmp_json(want, have, "") {
    Some(msg) => debug_assert(false, "[" + name + "] " + msg)
    None => ()
  }
}

fn assert_toml_invalid(name : String, toml_src : String) -> Unit {
  match parse(toml_src) {
    Ok(v) => {
      debug_assert(
        false,
        "[" + name + "] expected Err, got Ok: " + to_toml_test_json(v),
      )
    }
    Err(_) => ()
  }
}

fn assert_toml_invalid_bytes(name : String, raw : Array[Int]) -> Unit {
  let b = bytes_from_ints(raw)
  match parse_bytes(b) {
    Ok(v) => {
      debug_assert(
        false,
        "[" + name + "] expected Err for invalid bytes, got Ok: " + to_toml_test_json(v),
      )
    }
    Err(_) => ()
  }
}
