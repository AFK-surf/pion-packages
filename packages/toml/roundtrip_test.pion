///| Roundtrip serialization (`stringify` -> `parse`) and `TomlValue` accessor tests.

fn assert_roundtrip(name : String, toml_src : String) -> Unit {
  let v1 = match parse(toml_src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[rt:" + name + "] parse1 failed: " + e.message)
      return
    }
  }
  let encoded = match stringify(v1) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "[rt:" + name + "] stringify failed: " + e.message)
      return
    }
  }
  let v2 = match parse(encoded) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[rt:" + name + "] parse2 failed: " + e.message + "\n--- encoded ---\n" + encoded)
      return
    }
  }
  let j1 = match j_parse(to_toml_test_json(v1)) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[rt:" + name + "] j1 failed: " + e)
      return
    }
  }
  let j2 = match j_parse(to_toml_test_json(v2)) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[rt:" + name + "] j2 failed: " + e)
      return
    }
  }
  match cmp_json(j1, j2, "") {
    Some(err) => debug_assert(false, "[rt:" + name + "] roundtrip mismatch: " + err + "\n--- encoded ---\n" + encoded)
    None => ()
  }
}

///|
test "roundtrip_scalars_and_tables" {
  let doc = "title = \"TOML Example\"\ncount = 42\nneg = -9223372036854775808\npi = 3.141592653589793\nflag = true\noff = false\ninf_v = inf\nninf_v = -inf\nnan_v = nan\n\n[owner]\nname = \"Tom Preston-Werner\"\ndob = 1979-05-27T07:32:00-08:00\nlocal_dt = 1979-05-27T07:32:00.123\nlocal_d = 1979-05-27\nlocal_t = 07:32:00.999\n\n[database]\nenabled = true\nports = [8000, 8001, 8002]\ndata = [[\"delta\", \"phi\"], [3.14]]\n"
  assert_roundtrip("scalars_and_tables", doc)
}

///|
test "roundtrip_array_of_tables_and_quoted_keys" {
  let doc = "\"a.b\" = \"dotted\"\n\"\" = \"empty key\"\n\"line\\nbreak\" = \"escaped\\t\\r\\n\\\"\\\\\"\n\n[[products]]\nname = \"Hammer\"\nsku = 738594937\n\n[[products]]\n\n[[products]]\nname = \"Nail\"\nsku = 284758393\ncolor = \"gray\"\n"
  assert_roundtrip("array_of_tables_and_quoted_keys", doc)
}

///|
test "roundtrip_nested_empty_tables" {
  let doc = "[a]\n[a.b]\n[a.b.c]\nempty_arr = []\n"
  assert_roundtrip("nested_empty_tables", doc)
}

///|
test "value_accessors" {
  let doc = "s = \"hello\"\ni = 123\nf = 2.5\nb = true\ndt = 2024-01-02T03:04:05Z\nldt = 2024-01-02T03:04:05\nld = 2024-01-02\nlt = 03:04:05\narr = [1, 2, 3]\n[sub]\nk = \"v\"\n"
  let root = match parse(doc) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      return
    }
  }
  match get(root, "s") {
    Some(v) =>
    match as_str(v) {
      Some(x) => debug_assert(x == "hello", "as_str")
      None => debug_assert(false, "as_str none")
    }
    None => debug_assert(false, "missing s")
  }
  match get(root, "i") {
    Some(v) =>
    match as_int(v) {
      Some(x) => debug_assert(x == 123L, "as_int")
      None => debug_assert(false, "as_int none")
    }
    None => debug_assert(false, "missing i")
  }
  match get(root, "f") {
    Some(v) =>
    match as_float(v) {
      Some(x) => debug_assert(x == 2.5, "as_float")
      None => debug_assert(false, "as_float none")
    }
    None => debug_assert(false, "missing f")
  }
  match get(root, "b") {
    Some(v) =>
    match as_bool(v) {
      Some(x) => debug_assert(x == true, "as_bool")
      None => debug_assert(false, "as_bool none")
    }
    None => debug_assert(false, "missing b")
  }
  match get(root, "dt") {
    Some(v) =>
    match as_datetime(v) {
      Some(x) => debug_assert(x == "2024-01-02T03:04:05Z", "as_datetime")
      None => debug_assert(false, "as_datetime none")
    }
    None => debug_assert(false, "missing dt")
  }
  match get(root, "ldt") {
    Some(v) =>
    match as_local_datetime(v) {
      Some(x) => debug_assert(x == "2024-01-02T03:04:05", "as_local_datetime")
      None => debug_assert(false, "as_local_datetime none")
    }
    None => debug_assert(false, "missing ldt")
  }
  match get(root, "ld") {
    Some(v) =>
    match as_local_date(v) {
      Some(x) => debug_assert(x == "2024-01-02", "as_local_date")
      None => debug_assert(false, "as_local_date none")
    }
    None => debug_assert(false, "missing ld")
  }
  match get(root, "lt") {
    Some(v) =>
    match as_local_time(v) {
      Some(x) => debug_assert(x == "03:04:05", "as_local_time")
      None => debug_assert(false, "as_local_time none")
    }
    None => debug_assert(false, "missing lt")
  }
  match get(root, "arr") {
    Some(v) => {
      debug_assert(value_len(v) == 3, "arr len")
      match get_index(v, 1) {
        Some(el) =>
        match as_int(el) {
          Some(x) => debug_assert(x == 2L, "arr[1]")
          None => debug_assert(false, "arr[1] none")
        }
        None => debug_assert(false, "missing arr[1]")
      }
    }
    None => debug_assert(false, "missing arr")
  }
  match get(root, "sub") {
    Some(sub) => {
      match get(sub, "k") {
        Some(v) =>
        match as_str(v) {
          Some(x) => debug_assert(x == "v", "sub.k")
          None => debug_assert(false, "sub.k none")
        }
        None => debug_assert(false, "missing sub.k")
      }
    }
    None => debug_assert(false, "missing sub")
  }
}

///|
test "stringify_non_table_returns_err" {
  match stringify(TomlValue::Int(1L)) {
    Ok(_) => debug_assert(false, "expected Err for non-table root")
    Err(_) => ()
  }
}
