///| Red-team prosecution tests for `packages/toml`.
///|
///| Every test asserts the behaviour of the upstream references (Rust `toml` 1.2.2 / 0.8.23 and
///| Go `BurntSushi/toml` v1.6.0), verified by `diff/diff_probe.py` and `run_audit.sh`.
///| A FAILING test here is the evidence. IDs (F1..F7) match `REPORT.md`.
///|
///| Crash-class evidence (stack overflow) lives in `crash/` because a SIGSEGV would take this
///| whole test binary down with it; timing-class evidence (HashDoS, O(n^2)) lives in run_audit.sh.

import "toml"

fn first_float(src : String) -> Option[Double] {
  match toml::parse(src) {
    Ok(root) =>
    match toml::get(root, "a") {
      Some(v) => toml::as_float(v)
      None => None
    }
    Err(_) => None
  }
}

///| parse -> stringify -> parse must give back the bit-identical double
///| (Rust toml / Go BurntSushi both use shortest-roundtrip float printing).
fn assert_float_roundtrip(id : String, literal : String) -> Unit {
  let src = "a = " + literal + "\n"
  let v1 = match first_float(src) {
    Some(x) => x
    None => {
      debug_assert(false, "[" + id + "] could not parse " + literal)
      return
    }
  }
  let out = match toml::parse(src) {
    Ok(root) =>
    match toml::stringify(root) {
      Ok(s) => s
      Err(e) => {
        debug_assert(false, "[" + id + "] stringify failed: " + e.message)
        return
      }
    }
    Err(e) => {
      debug_assert(false, "[" + id + "] parse failed: " + e.message)
      return
    }
  }
  match first_float(out) {
    Some(v2) =>
    debug_assert(
      v2 == v1,
      "[" + id + "] float changed by stringify: input " + literal + " re-emitted as " + out,
    )
    None => debug_assert(false, "[" + id + "] stringify output unparsable: " + out)
  }
}

///| to_toml_test_json must describe the same double that was parsed.
fn assert_json_float_exact(id : String, literal : String) -> Unit {
  let src = "a = " + literal + "\n"
  match toml::parse(src) {
    Ok(root) => {
      let j = toml::to_toml_test_json(root)
      // {"a":{"type":"float","value":"<text>"}}
      let marker = "\"value\":\""
      let mut i = 0
      let mut start = -1
      while i + marker.length() <= j.length() {
        if j.slice(i, i + marker.length()) == marker {
          start = i + marker.length()
          break
        }
        i = i + 1
      }
      let mut end = start
      while end >= 0 && end < j.length() && j.code_unit_at(end) != 34 {
        end = end + 1
      }
      let text = j.slice(start, end)
      let v1 = first_float(src)
      let v2 = first_float("a = " + text + "\n")
      match (v1, v2) {
        (Some(x), Some(y)) =>
        debug_assert(
          x == y,
          "[" + id + "] toml-test JSON value " + text + " is not the parsed double " + literal,
        )
        _ => debug_assert(false, "[" + id + "] unparsable JSON float text " + text)
      }
    }
    Err(e) => debug_assert(false, "[" + id + "] parse failed: " + e.message)
  }
}

///| F1 (P0) - silent float corruption on serialization -----------------------------------------

///|
test "F1_stringify_roundtrip_python_random_0_8311652289356479" {
  assert_float_roundtrip("F1a", "0.8311652289356479")
}

///|
test "F1_stringify_roundtrip_python_random_0_7985979778608974" {
  assert_float_roundtrip("F1b", "0.7985979778608974")
}

///|
test "F1_stringify_roundtrip_python_random_0_6533258370806696" {
  assert_float_roundtrip("F1c", "0.6533258370806696")
}

///|
test "F1_stringify_roundtrip_python_random_0_8481777226837237" {
  assert_float_roundtrip("F1d", "0.8481777226837237")
}

///|
test "F1_stringify_roundtrip_dbl_max" {
  assert_float_roundtrip("F1e", "1.7976931348623157e308")
}

///|
test "F1_stringify_roundtrip_large_exponent" {
  assert_float_roundtrip("F1f", "-1.989032661366619e+244")
}

///|
test "F1_stringify_roundtrip_small_exponent" {
  assert_float_roundtrip("F1g", "3.980498358697587e-249")
}

///|
test "F1_toml_test_json_dbl_max" {
  assert_json_float_exact("F1h", "1.7976931348623157e308")
}

///|
test "F1_toml_test_json_python_random" {
  assert_json_float_exact("F1i", "0.8311652289356479")
}

///| F2 (P1) - out-of-range float silently becomes inf -----------------------------------------
///| Rust toml 1.2 "floating-point number overflowed", toml 0.8 "invalid floating-point number",
///| Go "1e400 is out of range for float64".

///|
test "F2_float_overflow_must_be_rejected" {
  match toml::parse("a = 1e400\n") {
    Ok(v) =>
    debug_assert(false, "[F2] 1e400 accepted as " + toml::to_toml_test_json(v))
    Err(_) => ()
  }
}

///|
test "F2_negative_float_overflow_must_be_rejected" {
  match toml::parse("a = -1.5e309\n") {
    Ok(v) =>
    debug_assert(false, "[F2] -1.5e309 accepted as " + toml::to_toml_test_json(v))
    Err(_) => ()
  }
}

///| F3 (P1) - stringify emits invalid TOML instead of failing ---------------------------------
///| Rust: `toml::value::Datetime` is a validated type and `toml::Table` cannot hold duplicate keys,
///| so `toml::to_string` can never produce unparsable output. Pion accepts any String / any pairs.

fn assert_stringify_valid_or_err(id : String, v : toml::TomlValue) -> Unit {
  match toml::stringify(v) {
    Ok(out) =>
    match toml::parse(out) {
      Ok(_) => ()
      Err(e) =>
      debug_assert(
        false,
        "[" + id + "] stringify returned Ok but its output is invalid TOML (" + e.message + "):\n" + out,
      )
    }
    Err(_) => ()
  }
}

///|
test "F3_stringify_unvalidated_local_date" {
  assert_stringify_valid_or_err(
    "F3a",
    toml::TomlValue::Table([("d", toml::TomlValue::LocalDate("not a date"))]),
  )
}

///|
test "F3_stringify_empty_offset_datetime" {
  assert_stringify_valid_or_err(
    "F3b",
    toml::TomlValue::Table([("d", toml::TomlValue::OffsetDateTime(""))]),
  )
}

///|
test "F3_stringify_duplicate_keys" {
  assert_stringify_valid_or_err(
    "F3c",
    toml::TomlValue::Table([("a", toml::TomlValue::Int(1L)), ("a", toml::TomlValue::Int(2L))]),
  )
}

///|
test "F3_stringify_datetime_injection" {
  // A "datetime" string smuggles a second key into the document.
  let v = toml::TomlValue::Table(
    [("d", toml::TomlValue::LocalTime("07:32:00\nadmin = true"))],
  )
  match toml::stringify(v) {
    Ok(out) =>
    match toml::parse(out) {
      Ok(root) =>
      match toml::get(root, "admin") {
        Some(_) =>
        debug_assert(
          false,
          "[F3d] LocalTime payload injected a new key `admin` into the output:\n" + out,
        )
        None => ()
      }
      Err(_) => debug_assert(false, "[F3d] stringify produced invalid TOML:\n" + out)
    }
    Err(_) => ()
  }
}

///| F4 (P2) - UTF-8 BOM rejected; Rust toml 1.2, toml 0.8 and Go BurntSushi all accept it -----

///|
test "F4_utf8_bom_accepted_by_all_references" {
  let body = "a = 1\n"
  let b = Bytes::new(3 + body.length())
  b[0] = (0xEF).to_byte()
  b[1] = (0xBB).to_byte()
  b[2] = (0xBF).to_byte()
  let mut i = 0
  while i < body.length() {
    b[3 + i] = body.code_unit_at(i).to_byte()
    i = i + 1
  }
  match toml::parse_bytes(b) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "[F4] BOM file rejected: " + e.message)
  }
}

///| F5 (P2) - error locations (Rust toml 1.2 and Go BurntSushi agree on the line) -------------

fn err_of(src : String) -> Option[toml::TomlError] {
  match toml::parse(src) {
    Ok(_) => None
    Err(e) => Some(e)
  }
}

///|
test "F5_duplicate_key_points_at_key" {
  // rust 1.2: line 2 col 1 (span of the key); go: line 2
  match err_of("a = 1\na = 2\n") {
    Some(e) =>
    debug_assert(
      e.line == 2 && e.col == 1,
      "[F5a] dup key reported at " + e.line.to_string() + ":" + e.col.to_string() + ", want 2:1",
    )
    None => debug_assert(false, "[F5a] not rejected")
  }
}

///|
test "F5_duplicate_table_reported_on_its_header_line" {
  // rust 1.2: 2:2 ; go: 2:2 ; pion: 3:1 (the line AFTER the offending header)
  match err_of("[a]\n[a]\nx = 1\n") {
    Some(e) =>
    debug_assert(e.line == 2, "[F5b] dup table reported on line " + e.line.to_string() + ", want 2")
    None => debug_assert(false, "[F5b] not rejected")
  }
}

///|
test "F5_inline_table_extension_reported_on_header_line" {
  match err_of("a = {b=1}\n[a.c]\n") {
    Some(e) =>
    debug_assert(e.line == 2, "[F5c] reported on line " + e.line.to_string() + ", want 2")
    None => debug_assert(false, "[F5c] not rejected")
  }
}

///|
test "F5_unclosed_array_reported_where_input_ends" {
  // rust 1.2 / go: 2:4 (end of input on line 2); pion: 3:1 (a line that does not exist)
  match err_of("a = [1,\n  2\n") {
    Some(e) =>
    debug_assert(e.line == 2, "[F5d] reported on line " + e.line.to_string() + ", want 2")
    None => debug_assert(false, "[F5d] not rejected")
  }
}

///|
test "F5_column_counts_characters_not_bytes" {
  // `a = "é" x` : the stray `x` is the 9th character (rust 1.2: col 9, go: col 9); pion counts UTF-8 bytes.
  match err_of("a = \"é\" x\n") {
    Some(e) =>
    debug_assert(e.col == 9, "[F5e] col " + e.col.to_string() + ", want 9")
    None => debug_assert(false, "[F5e] not rejected")
  }
}

///| F6 (P2) - TOML 1.1.0 not supported (Rust toml >= 0.9 and Go BurntSushi v1.6 parse all of these)

fn assert_parses(id : String, src : String) -> Unit {
  match toml::parse(src) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "[" + id + "] TOML 1.1 input rejected: " + e.message)
  }
}

///|
test "F6_toml11_escape_e" {
  assert_parses("F6a", "a = \"\\e[0m\"\n")
}

///|
test "F6_toml11_escape_x" {
  assert_parses("F6b", "a = \"\\x41\"\n")
}

///|
test "F6_toml11_inline_table_newlines" {
  assert_parses("F6c", "a = {\n  b = 1,\n  c = 2\n}\n")
}

///|
test "F6_toml11_inline_table_trailing_comma" {
  assert_parses("F6d", "a = {b = 1,}\n")
}

///|
test "F6_toml11_time_without_seconds" {
  assert_parses("F6e", "a = 07:32\nb = 1979-05-27T07:32Z\n")
}

///| F7 (P2) - datetimes are handed back as raw unnormalised text ------------------------------
///| Rust `toml::value::Datetime` / Go `time.Time` give one canonical value; Pion's `as_datetime`
///| returns whatever spelling the file used, so equal instants compare unequal.

///|
test "F7_equal_datetimes_compare_equal" {
  match toml::parse("a = 1979-05-27T07:32:00Z\nb = 1979-05-27t07:32:00z\nc = 1979-05-27 07:32:00Z\n") {
    Ok(root) => {
      let dt = fn(k : String) -> String {
        match toml::get(root, k) {
          Some(v) =>
          match toml::as_datetime(v) {
            Some(s) => s
            None => ""
          }
          None => ""
        }
      }
      let a = dt("a")
      let b = dt("b")
      let c = dt("c")
      debug_assert(
        a == b && a == c,
        "[F7] identical instants differ as values: " + a + " / " + b + " / " + c,
      )
    }
    Err(e) => debug_assert(false, "[F7] parse failed: " + e.message)
  }
}
