///| Red-team crash evidence (F8, P0): unbounded recursion -> SIGSEGV (stack overflow).
///|
///| Each test only requires that `toml::parse` RETURNS (Ok or Err). Rust toml 1.2 / 0.8 return
///| Err("recursion limit") in < 1 ms for every input here; Go BurntSushi returns normally.
///| Pion kills the process (SIGSEGV; `tools/pion_cli` exits 139 on the same inputs). `pionc test`
///| runs each test in isolation, so the crash shows up as a FAILED test and the run continues.

import "toml"

fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

fn must_return(id : String, src : String) -> Unit {
  match toml::parse(src) {
    Ok(_) => ()
    Err(_) => ()
  }
  debug_assert(true, id)
}

///| 200 KB: `a = [[[[ ... ]]]]` with 100 000 levels.
test "F8a_deep_nested_arrays_100k" {
  must_return("F8a", "a = " + repeat("[", 100000) + repeat("]", 100000) + "\n")
}

///| 100 KB: one table header `[a.a.a. ... .a]` with 50 000 parts (no brackets nesting at all).
test "F8b_long_dotted_table_header_50k" {
  let parts = repeat("a.", 49999) + "a"
  must_return("F8b", "[" + parts + "]\nx = 1\n")
}

///| 100 KB: one dotted key `a.a.a. ... .a = 1` with 50 000 parts.
test "F8c_long_dotted_key_50k" {
  must_return("F8c", repeat("a.", 49999) + "a = 1\n")
}

///| 600 KB: `a = {a = {a = ... 1}}` with 100 000 levels.
test "F8d_deep_nested_inline_tables_100k" {
  must_return("F8d", "a = " + repeat("{a = ", 100000) + "1" + repeat("}", 100000) + "\n")
}

///| control: shallow input must obviously pass (proves the runner survives the crashes above)
test "F8_control_shallow" {
  must_return("ctrl", "a = [[[1]]]\n")
}
