///| Red-team audit CLI for `packages/toml` (Pion side of every differential / benchmark).
///|
///| Modes (all read a file path; use /dev/stdin for pipes):
///|   decode FILE            -> toml-test tagged JSON on stdout, exit 1 on parse error
///|   encode FILE            -> toml-test encoder: tagged JSON in, TOML out (via toml::stringify)
///|   errpos FILE            -> "OK" or "ERR <line> <col> <offset> <message>"
///|   roundtrip FILE         -> toml::stringify(toml::parse(FILE))
///|   bench-parse FILE N     -> parse N times, print walk statistics (same as packages/toml/bench)
///|   bench-parse-only FILE N -> parse N times, no tree walk (attribution of bench-parse cost)
///|   bench-stringify FILE N -> parse once, stringify N times, print output length/hash
///|   bench-lookup FILE N    -> parse once, look every root key up N times via toml::get
///|   bench-many LIST        -> parse every file listed (one path per line) once, print stats

import "toml"

struct Stats {
  mut tables : Int64
  mut arrays : Int64
  mut keys : Int64
  mut strings : Int64
  mut ints : Int64
  mut floats : Int64
  mut bools : Int64
  mut bool_true : Int64
  mut datetimes : Int64
  mut str_bytes : Int64
  mut int_sum : Int64
  mut key_hash : Int64
  mut str_hash : Int64
}

fn new_stats() -> Stats {
  Stats::{
    tables: 0L,
    arrays: 0L,
    keys: 0L,
    strings: 0L,
    ints: 0L,
    floats: 0L,
    bools: 0L,
    bool_true: 0L,
    datetimes: 0L,
    str_bytes: 0L,
    int_sum: 0L,
    key_hash: 0L,
    str_hash: 0L,
  }
}

fn poly_hash(s : String) -> Int64 {
  let mut h : Int64 = 17L
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h * 131L + s.code_unit_at(i).to_int64()) % 1000000007L
    i = i + 1
  }
  h
}

fn walk_val(st : Stats, v : toml::TomlValue) -> Unit {
  match v {
    toml::TomlValue::Str(s) => {
      st.strings = st.strings + 1L
      st.str_bytes = st.str_bytes + s.length().to_int64()
      st.str_hash = (st.str_hash + poly_hash(s)) % 1000000007L
    }
    toml::TomlValue::Int(x) => {
      st.ints = st.ints + 1L
      let m = ((x % 1000000007L) + 1000000007L) % 1000000007L
      st.int_sum = (st.int_sum + m) % 1000000007L
    }
    toml::TomlValue::Float(_) => st.floats = st.floats + 1L
    toml::TomlValue::Bool(b) => {
      st.bools = st.bools + 1L
      if b {
        st.bool_true = st.bool_true + 1L
      }
    }
    toml::TomlValue::OffsetDateTime(_) => st.datetimes = st.datetimes + 1L
    toml::TomlValue::LocalDateTime(_) => st.datetimes = st.datetimes + 1L
    toml::TomlValue::LocalDate(_) => st.datetimes = st.datetimes + 1L
    toml::TomlValue::LocalTime(_) => st.datetimes = st.datetimes + 1L
    toml::TomlValue::Array(items) => {
      st.arrays = st.arrays + 1L
      let n = items.length()
      let mut i = 0
      while i < n {
        walk_val(st, items[i])
        i = i + 1
      }
    }
    toml::TomlValue::Table(entries) => {
      st.tables = st.tables + 1L
      let n = entries.length()
      st.keys = st.keys + n.to_int64()
      let mut i = 0
      while i < n {
        let (k, child) = entries[i]
        st.key_hash = (st.key_hash + poly_hash(k)) % 1000000007L
        walk_val(st, child)
        i = i + 1
      }
    }
  }
}

fn print_stats(world : World, iters : Int, st : Stats) -> Unit {
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "tables=" + st.tables.to_string())
  io_println(world, "arrays=" + st.arrays.to_string())
  io_println(world, "keys=" + st.keys.to_string())
  io_println(world, "strings=" + st.strings.to_string())
  io_println(world, "ints=" + st.ints.to_string())
  io_println(world, "floats=" + st.floats.to_string())
  io_println(world, "bools=" + st.bools.to_string())
  io_println(world, "bool_true=" + st.bool_true.to_string())
  io_println(world, "datetimes=" + st.datetimes.to_string())
  io_println(world, "str_bytes=" + st.str_bytes.to_string())
  io_println(world, "int_sum=" + st.int_sum.to_string())
  io_println(world, "key_hash=" + st.key_hash.to_string())
  io_println(world, "str_hash=" + st.str_hash.to_string())
}

fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

fn err_line(e : toml::TomlError) -> String {
  "ERR " + e.line.to_string() + " " + e.col.to_string() + " " + e.offset.to_string() + " " + e.message
}

fn scalar_from_toml(src : String) -> Option[toml::TomlValue] {
  match toml::parse("v = " + src + "\n") {
    Ok(root) => toml::get(root, "v")
    Err(_) => None
  }
}

fn json_to_toml(j : JsonVal) -> Result[toml::TomlValue, String] {
  match j {
    JsonVal::JArr(items) => {
      let out : Array[toml::TomlValue] = []
      let mut i = 0
      while i < items.length() {
        match json_to_toml(items[i]) {
          Ok(v) => out.push(v)
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      Ok(toml::TomlValue::Array(out))
    }
    JsonVal::JObj(entries) => {
      match j_as_tagged(entries) {
        Some((t, v)) => {
          if t == "string" {
            Ok(toml::TomlValue::Str(v))
          } else if t == "datetime" {
            Ok(toml::TomlValue::OffsetDateTime(v))
          } else if t == "datetime-local" {
            Ok(toml::TomlValue::LocalDateTime(v))
          } else if t == "date-local" {
            Ok(toml::TomlValue::LocalDate(v))
          } else if t == "time-local" {
            Ok(toml::TomlValue::LocalTime(v))
          } else if t == "bool" {
            Ok(toml::TomlValue::Bool(v == "true"))
          } else if t == "integer" {
            match scalar_from_toml(v) {
              Some(toml::TomlValue::Int(x)) => Ok(toml::TomlValue::Int(x))
              _ => Err("bad integer " + v)
            }
          } else if t == "float" {
            match scalar_from_toml(v) {
              Some(toml::TomlValue::Float(x)) => Ok(toml::TomlValue::Float(x))
              Some(toml::TomlValue::Int(x)) => Ok(toml::TomlValue::Float(x.to_double()))
              _ => Err("bad float " + v)
            }
          } else {
            Err("unknown type " + t)
          }
        }
        None => {
          let out : Array[(String, toml::TomlValue)] = []
          let mut i = 0
          while i < entries.length() {
            let (k, cv) = entries[i]
            match json_to_toml(cv) {
              Ok(v) => out.push((k, v))
              Err(e) => return Err(e)
            }
            i = i + 1
          }
          Ok(toml::TomlValue::Table(out))
        }
      }
    }
    _ => Err("unexpected json value")
  }
}

fn read_text(world : World, path : String) -> Option[String] {
  match fs_read(world, path) {
    Ok(s) => Some(s)
    Err(_) => None
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: pion_cli <mode> <file> [iters]")
    return 2
  }
  let mode = args[1]
  let path = args[2]
  let iters = if args.length() > 3 { parse_pos_int(args[3]) } else { 1 }
  if mode == "decode" || mode == "errpos" {
    let data = match fs_read_bytes(world, path) {
      Ok(b) => b
      Err(_) => {
        io_eprintln(world, "error: cannot read " + path)
        return 2
      }
    }
    match toml::parse_bytes(data) {
      Ok(v) => {
        if mode == "decode" {
          io_println(world, toml::to_toml_test_json(v))
        } else {
          io_println(world, "OK")
        }
        0
      }
      Err(e) => {
        if mode == "decode" {
          io_eprintln(world, err_line(e))
          1
        } else {
          io_println(world, err_line(e))
          0
        }
      }
    }
  } else if mode == "encode" {
    let src = match read_text(world, path) {
      Some(s) => s
      None => return 2
    }
    let j = match j_parse(src) {
      Ok(v) => v
      Err(e) => {
        io_eprintln(world, "json: " + e)
        return 1
      }
    }
    let tv = match json_to_toml(j) {
      Ok(v) => v
      Err(e) => {
        io_eprintln(world, "json->toml: " + e)
        return 1
      }
    }
    match toml::stringify(tv) {
      Ok(s) => {
        io_print(world, s)
        0
      }
      Err(e) => {
        io_eprintln(world, err_line(e))
        1
      }
    }
  } else if mode == "roundtrip" {
    let src = match read_text(world, path) {
      Some(s) => s
      None => return 2
    }
    match toml::parse(src) {
      Ok(v) =>
      match toml::stringify(v) {
        Ok(s) => {
          io_print(world, s)
          0
        }
        Err(e) => {
          io_eprintln(world, err_line(e))
          1
        }
      }
      Err(e) => {
        io_eprintln(world, err_line(e))
        1
      }
    }
  } else if mode == "bench-parse" {
    let src = match read_text(world, path) {
      Some(s) => s
      None => return 2
    }
    let st = new_stats()
    let mut it = 0
    while it < iters {
      match toml::parse(src) {
        Ok(v) => walk_val(st, v)
        Err(e) => {
          io_println(world, "parse error: " + e.message)
          return 1
        }
      }
      it = it + 1
    }
    print_stats(world, iters, st)
    0
  } else if mode == "bench-parse-only" {
    let src = match read_text(world, path) {
      Some(s) => s
      None => return 2
    }
    let mut n : Int64 = 0L
    let mut it = 0
    while it < iters {
      match toml::parse(src) {
        Ok(v) => n = n + toml::value_len(v).to_int64()
        Err(_) => return 1
      }
      it = it + 1
    }
    io_println(world, "iters=" + iters.to_string())
    io_println(world, "root_keys=" + n.to_string())
    0
  } else if mode == "bench-stringify" {
    let src = match read_text(world, path) {
      Some(s) => s
      None => return 2
    }
    let v = match toml::parse(src) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "parse error: " + e.message)
        return 1
      }
    }
    let mut total : Int64 = 0L
    let mut it = 0
    while it < iters {
      match toml::stringify(v) {
        Ok(s) => total = total + s.length().to_int64()
        Err(_) => return 1
      }
      it = it + 1
    }
    io_println(world, "iters=" + iters.to_string())
    io_println(world, "ok=" + (total > 0L).to_string())
    0
  } else if mode == "bench-lookup" {
    let src = match read_text(world, path) {
      Some(s) => s
      None => return 2
    }
    let root = match toml::parse(src) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "parse error: " + e.message)
        return 1
      }
    }
    let keys : Array[String] = []
    match root {
      toml::TomlValue::Table(entries) => {
        let mut i = 0
        while i < entries.length() {
          let (k, _) = entries[i]
          keys.push(k)
          i = i + 1
        }
      }
      _ => ()
    }
    let mut found : Int64 = 0L
    let mut sum : Int64 = 0L
    let mut it = 0
    while it < iters {
      let mut i = 0
      while i < keys.length() {
        match toml::get(root, keys[i]) {
          Some(toml::TomlValue::Int(x)) => {
            found = found + 1L
            sum = (sum + x) % 1000000007L
          }
          Some(_) => found = found + 1L
          None => ()
        }
        i = i + 1
      }
      it = it + 1
    }
    io_println(world, "iters=" + iters.to_string())
    io_println(world, "found=" + found.to_string())
    io_println(world, "sum=" + sum.to_string())
    0
  } else if mode == "bench-many" {
    let list = match read_text(world, path) {
      Some(s) => s
      None => return 2
    }
    let st = new_stats()
    let mut files = 0
    let mut start = 0
    let n = list.length()
    let mut i = 0
    while i <= n {
      if i == n || list.code_unit_at(i) == 10 {
        if i > start {
          let p = list.slice(start, i)
          match read_text(world, p) {
            Some(src) =>
            match toml::parse(src) {
              Ok(v) => {
                walk_val(st, v)
                files = files + 1
              }
              Err(e) => {
                io_println(world, "parse error: " + p + ": " + e.message)
                return 1
              }
            }
            None => return 2
          }
        }
        start = i + 1
      }
      i = i + 1
    }
    print_stats(world, files, st)
    0
  } else {
    io_eprintln(world, "unknown mode " + mode)
    2
  }
}
