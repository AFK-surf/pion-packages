///|
test "invalid__key__start_bracket" {
  assert_toml_invalid("invalid/key/start-bracket.toml", "[a]\n[xyz = 5\n[b]\n")
}

///|
test "invalid__key__start_dot" {
  assert_toml_invalid("invalid/key/start-dot.toml", ".key = 1\n")
}

///|
test "invalid__key__tab" {
  assert_toml_invalid("invalid/key/tab.toml", "# Tab literal between a and b below.\na\tb = 1\n")
}

///|
test "invalid__key__tab_quoted" {
  assert_toml_invalid("invalid/key/tab-quoted.toml", "# Tab literal between a and b below.\n\"a\"\t\"b\" = 1\n")
}

///|
test "invalid__key__two_equals_01" {
  assert_toml_invalid("invalid/key/two-equals-01.toml", "key= = 1\n")
}

///|
test "invalid__key__two_equals_02" {
  assert_toml_invalid("invalid/key/two-equals-02.toml", "a==1\n")
}

///|
test "invalid__key__two_equals_03" {
  assert_toml_invalid("invalid/key/two-equals-03.toml", "a=b=1\n")
}

///|
test "invalid__key__without_value_01" {
  assert_toml_invalid("invalid/key/without-value-01.toml", "key\n")
}

///|
test "invalid__key__without_value_02" {
  assert_toml_invalid("invalid/key/without-value-02.toml", "key = \n")
}

///|
test "invalid__key__without_value_03" {
  assert_toml_invalid("invalid/key/without-value-03.toml", "\"key\"\n")
}

///|
test "invalid__key__without_value_04" {
  assert_toml_invalid("invalid/key/without-value-04.toml", "\"key\" = \n")
}

///|
test "invalid__key__without_value_05" {
  assert_toml_invalid("invalid/key/without-value-05.toml", "fs.fw\n")
}

///|
test "invalid__key__without_value_06" {
  assert_toml_invalid("invalid/key/without-value-06.toml", "fs.fw =\n")
}

///|
test "invalid__key__without_value_07" {
  assert_toml_invalid("invalid/key/without-value-07.toml", "fs.\n")
}

///|
test "invalid__local_date__day_1digit" {
  assert_toml_invalid("invalid/local-date/day-1digit.toml", "foo = 1997-09-9\n")
}

///|
test "invalid__local_date__feb_29" {
  assert_toml_invalid("invalid/local-date/feb-29.toml", "\"not a leap year\" = 2100-02-29\n")
}

///|
test "invalid__local_date__feb_30" {
  assert_toml_invalid("invalid/local-date/feb-30.toml", "\"only 28 or 29 days in february\" = 1988-02-30\n\n")
}

///|
test "invalid__local_date__mday_over" {
  assert_toml_invalid("invalid/local-date/mday-over.toml", "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-32\n")
}

///|
test "invalid__local_date__mday_under" {
  assert_toml_invalid("invalid/local-date/mday-under.toml", "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-00\n")
}

///|
test "invalid__local_date__month_over" {
  assert_toml_invalid("invalid/local-date/month-over.toml", "# date-month      = 2DIGIT  ; 01-12\nd = 2006-13-01\n")
}

///|
test "invalid__local_date__month_under" {
  assert_toml_invalid("invalid/local-date/month-under.toml", "# date-month      = 2DIGIT  ; 01-12\nd = 2007-00-01\n")
}

///|
test "invalid__local_date__no_leads" {
  assert_toml_invalid("invalid/local-date/no-leads.toml", "# Month \"7\" instead of \"07\"; the leading zero is required.\nno-leads = 1987-7-05\n")
}

///|
test "invalid__local_date__no_leads_with_milli" {
  assert_toml_invalid("invalid/local-date/no-leads-with-milli.toml", "# Day \"5\" instead of \"05\"; the leading zero is required.\nwith-milli = 1987-07-5\n")
}

///|
test "invalid__local_date__trailing_t" {
  assert_toml_invalid("invalid/local-date/trailing-t.toml", "# Date cannot end with trailing T\nd = 2006-01-30T\n")
}

///|
test "invalid__local_date__with_timezone_offset_01" {
  assert_toml_invalid("invalid/local-date/with-timezone-offset-01.toml", "# local-date can't have timezone\nfoo = 1987-07-05+02:00\n")
}

///|
test "invalid__local_date__with_timezone_offset_02" {
  assert_toml_invalid("invalid/local-date/with-timezone-offset-02.toml", "# local-date can't have timezone\nfoo = 1987-07-05Z\n")
}

///|
test "invalid__local_date__y10k" {
  assert_toml_invalid("invalid/local-date/y10k.toml", "# Maximum RFC3399 year is 9999.\nd = 10000-01-01\n")
}

///|
test "invalid__local_date__year_3digits" {
  assert_toml_invalid("invalid/local-date/year-3digits.toml", "foo = 199-09-09\n")
}

///|
test "invalid__local_datetime__feb_29" {
  assert_toml_invalid("invalid/local-datetime/feb-29.toml", "\"not a leap year\" = 2100-02-29T15:15:15\n")
}

///|
test "invalid__local_datetime__feb_30" {
  assert_toml_invalid("invalid/local-datetime/feb-30.toml", "\"only 28 or 29 days in february\" = 1988-02-30T15:15:15\n\n")
}

///|
test "invalid__local_datetime__hour_over" {
  assert_toml_invalid("invalid/local-datetime/hour-over.toml", "# time-hour       = 2DIGIT  ; 00-23\nd = 2006-01-01T24:00:00\n")
}

///|
test "invalid__local_datetime__mday_over" {
  assert_toml_invalid("invalid/local-datetime/mday-over.toml", "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-32T00:00:00\n")
}

///|
test "invalid__local_datetime__mday_under" {
  assert_toml_invalid("invalid/local-datetime/mday-under.toml", "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-00T00:00:00\n")
}

///|
test "invalid__local_datetime__minute_over" {
  assert_toml_invalid("invalid/local-datetime/minute-over.toml", "# time-minute     = 2DIGIT  ; 00-59\nd = 2006-01-01T00:60:00\n")
}

///|
test "invalid__local_datetime__month_over" {
  assert_toml_invalid("invalid/local-datetime/month-over.toml", "# date-month      = 2DIGIT  ; 01-12\nd = 2006-13-01T00:00:00\n")
}

///|
test "invalid__local_datetime__month_under" {
  assert_toml_invalid("invalid/local-datetime/month-under.toml", "# date-month      = 2DIGIT  ; 01-12\nd = 2007-00-01T00:00:00\n")
}

///|
test "invalid__local_datetime__no_leads" {
  assert_toml_invalid("invalid/local-datetime/no-leads.toml", "# Month \"7\" instead of \"07\"; the leading zero is required.\nno-leads = 1987-7-05T17:45:00\n")
}
