///|
test "invalid__inline_table__bad_key_syntax" {
  assert_toml_invalid("invalid/inline-table/bad-key-syntax.toml", "tbl = { a = 1, [b] }\n")
}

///|
test "invalid__inline_table__double_comma" {
  assert_toml_invalid("invalid/inline-table/double-comma.toml", "t = {x=3,,y=4}\n")
}

///|
test "invalid__inline_table__duplicate_key_01" {
  assert_toml_invalid("invalid/inline-table/duplicate-key-01.toml", "# Duplicate keys within an inline table are invalid\na={b=1, b=2}\n")
}

///|
test "invalid__inline_table__duplicate_key_02" {
  assert_toml_invalid("invalid/inline-table/duplicate-key-02.toml", "table1 = { table2.dupe = 1, table2.dupe = 2 }\n")
}

///|
test "invalid__inline_table__duplicate_key_03" {
  assert_toml_invalid("invalid/inline-table/duplicate-key-03.toml", "tbl = { fruit = { apple.color = \"red\" }, fruit.apple.texture = { smooth = true } }\n\n")
}

///|
test "invalid__inline_table__duplicate_key_04" {
  assert_toml_invalid("invalid/inline-table/duplicate-key-04.toml", "tbl = { a.b = \"a_b\", a.b.c = \"a_b_c\" }\n")
}

///|
test "invalid__inline_table__empty_01" {
  assert_toml_invalid("invalid/inline-table/empty-01.toml", "t = {,}\n")
}

///|
test "invalid__inline_table__empty_02" {
  assert_toml_invalid("invalid/inline-table/empty-02.toml", "t = {,\n}\n")
}

///|
test "invalid__inline_table__empty_03" {
  assert_toml_invalid("invalid/inline-table/empty-03.toml", "t = {\n,\n}\n")
}

///|
test "invalid__inline_table__linebreak_01" {
  assert_toml_invalid("invalid/inline-table/linebreak-01.toml", "# No newlines are allowed between the curly braces unless they are valid within\n# a value.\nsimple = { a = 1 \n}\n")
}

///|
test "invalid__inline_table__linebreak_02" {
  assert_toml_invalid("invalid/inline-table/linebreak-02.toml", "t = {a=1,\nb=2}\n")
}

///|
test "invalid__inline_table__linebreak_03" {
  assert_toml_invalid("invalid/inline-table/linebreak-03.toml", "t = {a=1\n,b=2}\n")
}

