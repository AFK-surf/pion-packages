///| Official toml-test v1.0.0 invalid compliance suite (170..339 of 509).

///|
test "invalid__float__trailing_dot_01" {
  assert_toml_invalid("invalid/float/trailing-dot-01.toml", "trailing-point = 1.\n")
}

///|
test "invalid__float__trailing_dot_02" {
  assert_toml_invalid("invalid/float/trailing-dot-02.toml", "a = 1.\nb = 2\n")
}

