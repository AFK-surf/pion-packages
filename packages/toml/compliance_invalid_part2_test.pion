test "invalid__inline_table__no_close_01" {
  assert_toml_invalid("invalid/inline-table/no-close-01.toml", "a={\n")
}

///|
test "invalid__inline_table__no_close_02" {
  assert_toml_invalid("invalid/inline-table/no-close-02.toml", "a={b=1\n")
}

