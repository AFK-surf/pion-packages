test "invalid__inline_table__no_comma_01" {
  assert_toml_invalid("invalid/inline-table/no-comma-01.toml", "t = {x = 3 y = 4}\n")
}

///|
test "invalid__inline_table__no_comma_02" {
  assert_toml_invalid("invalid/inline-table/no-comma-02.toml", "arrr = { comma-missing = true valid-toml = false }\n")
}

///|
test "invalid__inline_table__overwrite_01" {
  assert_toml_invalid("invalid/inline-table/overwrite-01.toml", "a.b=0\n# Since table \"a\" is already defined, it can't be replaced by an inline table.\na={}\n")
}

///|
test "invalid__inline_table__overwrite_02" {
  assert_toml_invalid("invalid/inline-table/overwrite-02.toml", "a={}\n# Inline tables are immutable and can't be extended\n[a.b]\n")
}

///|
test "invalid__inline_table__overwrite_03" {
  assert_toml_invalid("invalid/inline-table/overwrite-03.toml", "a = { b = 1 }\na.b = 2\n")
}

///|
test "invalid__inline_table__overwrite_04" {
  assert_toml_invalid("invalid/inline-table/overwrite-04.toml", "inline-t = { nest = {} }\n\n[[inline-t.nest]]\n")
}

///|
test "invalid__inline_table__overwrite_05" {
  assert_toml_invalid("invalid/inline-table/overwrite-05.toml", "inline-t = { nest = {} }\n\n[inline-t.nest]\n")
}

///|
test "invalid__inline_table__overwrite_06" {
  assert_toml_invalid("invalid/inline-table/overwrite-06.toml", "a = { b = 1, b.c = 2 }\n")
}

///|
test "invalid__inline_table__overwrite_07" {
  assert_toml_invalid("invalid/inline-table/overwrite-07.toml", "tab = { inner.table = [{}], inner.table.val = \"bad\" }")
}

///|
test "invalid__inline_table__overwrite_08" {
  assert_toml_invalid("invalid/inline-table/overwrite-08.toml", "tab = { inner = { dog = \"best\" }, inner.cat = \"worst\" }")
}

///|
test "invalid__inline_table__overwrite_09" {
  assert_toml_invalid("invalid/inline-table/overwrite-09.toml", "[tab.nested]\ninline-t = { nest = {} }\n\n[tab]\nnested.inline-t.nest = 2\n")
}

///|
test "invalid__inline_table__overwrite_10" {
  assert_toml_invalid("invalid/inline-table/overwrite-10.toml", "# Set implicit \"b\", overwrite \"b\" (illegal!) and then set another implicit.\n#\n# Caused panic: https://github.com/BurntSushi/toml/issues/403\na = {b.a = 1, b = 2, b.c = 3}\n")
}

///|
test "invalid__inline_table__trailing_comma" {
  assert_toml_invalid("invalid/inline-table/trailing-comma.toml", "# A terminating comma (also called trailing comma) is not permitted after the\n# last key/value pair in an inline table\nabc = { abc = 123, }\n")
}

